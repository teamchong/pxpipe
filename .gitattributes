# Normalize end-of-line handling across the repository.
# Without this file, cloning on Windows with core.autocrlf=true rewrites the
# shell scripts with CRLF and bash fails with: "$'\r': command not found".
* text=auto

# Files that MUST stay LF even on Windows (executed by bash/sh).
*.sh text eol=lf
*.bash text eol=lf

# Binary files: no conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
